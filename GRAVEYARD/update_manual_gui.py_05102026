#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Small Tkinter interface for editing handbook pages and rebuilding the manual."""

import os
import queue
import subprocess
import sys
import threading
import tkinter as tk
from tkinter import messagebox, ttk
from pathlib import Path

import update_manual as manual


class ManualGUI:
    def __init__(self, root):
        self.root = root
        root.title("Bernese BPE Manual")
        root.geometry("920x700")
        self.events = queue.Queue()
        self.process_thread = None
        self.current_path = None

        top = ttk.Frame(root, padding=12)
        top.pack(fill="both", expand=True)

        ttk.Label(top, text="Handbook-Eintrag", font=("TkDefaultFont", 14, "bold")).pack(anchor="w")
        form = ttk.Frame(top)
        form.pack(fill="x", pady=(10, 6))

        ttk.Label(form, text="Aktion").grid(row=0, column=0, sticky="w")
        self.action = tk.StringVar(value="Neu")
        self.action_box = ttk.Combobox(form, textvariable=self.action, values=("Neu", "Bearbeiten", "Entfernen"), state="readonly", width=16)
        self.action_box.grid(row=1, column=0, padx=(0, 12), sticky="ew")
        self.action_box.bind("<<ComboboxSelected>>", self.on_action_changed)

        ttk.Label(form, text="Vorhandener Eintrag (für Bearbeiten/Entfernen)").grid(row=0, column=1, sticky="w")
        self.entry_var = tk.StringVar()
        self.entry_box = ttk.Combobox(form, textvariable=self.entry_var, state="readonly")
        self.entry_box.grid(row=1, column=1, padx=(0, 12), sticky="ew")
        self.entry_box.bind("<<ComboboxSelected>>", self.load_selected)

        ttk.Label(form, text="Kategorie").grid(row=0, column=2, sticky="w")
        self.category = tk.StringVar()
        self.category_box = ttk.Combobox(form, textvariable=self.category, values=manual.handbook_category_choices())
        self.category_box.grid(row=1, column=2, padx=(0, 12), sticky="ew")

        ttk.Label(form, text="Titel").grid(row=0, column=3, sticky="w")
        self.title = tk.StringVar()
        ttk.Entry(form, textvariable=self.title).grid(row=1, column=3, sticky="ew")
        for column in range(4):
            form.columnconfigure(column, weight=1)

        ttk.Label(top, text="Verlauf-Zusammenfassung").pack(anchor="w", pady=(6, 0))
        self.summary = tk.StringVar()
        ttk.Entry(top, textvariable=self.summary).pack(fill="x", pady=(3, 8))

        ttk.Label(top, text="Inhalt (Markdown)").pack(anchor="w")
        editor_frame = ttk.Frame(top)
        editor_frame.pack(fill="both", expand=True, pady=(4, 8))
        self.editor = tk.Text(editor_frame, wrap="word", undo=True)
        scroll = ttk.Scrollbar(editor_frame, orient="vertical", command=self.editor.yview)
        self.editor.configure(yscrollcommand=scroll.set)
        self.editor.pack(side="left", fill="both", expand=True)
        scroll.pack(side="right", fill="y")

        controls = ttk.Frame(top)
        controls.pack(fill="x", pady=(0, 8))
        self.save_button = ttk.Button(controls, text="Eintrag speichern und Manual aufbauen", command=self.apply_entry)
        self.save_button.pack(side="left")
        ttk.Button(controls, text="Nur Manual neu aufbauen", command=self.start_build).pack(side="left", padx=8)
        ttk.Button(controls, text="Handbook-Liste aktualisieren", command=self.refresh_entries).pack(side="left")
        self.publish_after_build = tk.BooleanVar(value=True)
        ttk.Checkbutton(top, text="Nach erfolgreichem Aufbau site/ zu GitHub pushen", variable=self.publish_after_build).pack(anchor="w", pady=(0, 6))

        self.status = tk.StringVar(value="Bereit")
        ttk.Label(top, textvariable=self.status).pack(anchor="w")
        self.progress = ttk.Progressbar(top, mode="indeterminate")
        self.progress.pack(fill="x", pady=(4, 6))
        ttk.Label(top, text="Ausgabe").pack(anchor="w")
        self.log = tk.Text(top, height=8, state="disabled", wrap="word")
        self.log.pack(fill="x", pady=(4, 0))

        self.refresh_entries()
        self.on_action_changed()
        root.after(100, self.poll_events)

    def entries(self):
        return manual.gather_handbook_files(manual.HANDBOOK_DIR)

    def refresh_entries(self):
        self.paths = self.entries()
        self.labels = [path.relative_to(manual.HANDBOOK_DIR).as_posix() for path in self.paths]
        self.entry_box["values"] = self.labels
        if self.entry_var.get() not in self.labels:
            self.entry_var.set("")

    def on_action_changed(self, _event=None):
        action = self.action.get()
        selecting = action in ("Bearbeiten", "Entfernen")
        self.entry_box.configure(state="readonly" if selecting else "disabled")
        editing = action != "Entfernen"
        self.category_box.configure(state="normal" if action == "Neu" else "disabled")
        self.title_entry_state(editing)
        self.editor.configure(state="normal" if editing else "disabled")
        self.summary_entry_state(editing)
        self.save_button.configure(text="Eintrag speichern und Manual aufbauen" if action != "Entfernen" else "Eintrag entfernen und Manual aufbauen")
        if action == "Neu":
            self.current_path = None
            self.entry_var.set("")
            self.category.set("")
            self.title.set("")
            self.summary.set("")
            self.editor.configure(state="normal")
            self.editor.delete("1.0", "end")

    def title_entry_state(self, enabled):
        # The title widget is the only Entry in the final form column.
        for widget in self.root.winfo_children()[0].winfo_children():
            if isinstance(widget, ttk.Frame):
                for child in widget.winfo_children():
                    if isinstance(child, ttk.Entry) and str(child.cget("textvariable")) == str(self.title):
                        child.configure(state="normal" if enabled else "disabled")

    def summary_entry_state(self, enabled):
        for widget in self.root.winfo_children()[0].winfo_children():
            if isinstance(widget, ttk.Entry) and str(widget.cget("textvariable")) == str(self.summary):
                widget.configure(state="normal" if enabled else "disabled")

    def load_selected(self, _event=None):
        label = self.entry_var.get()
        if label not in self.labels:
            return
        path = self.paths[self.labels.index(label)]
        self.current_path = path
        self.category.set(path.relative_to(manual.HANDBOOK_DIR).parts[0])
        text = manual.read_text(path)
        lines = text.splitlines()
        title = path.stem
        if lines and lines[0].startswith("# "):
            title = lines[0][2:].strip()
        self.title.set(title)
        self.summary.set("Updated handbook entry " + path.stem)
        self.editor.configure(state="normal")
        self.editor.delete("1.0", "end")
        self.editor.insert("1.0", text)
        if self.action.get() == "Entfernen":
            self.editor.configure(state="disabled")

    def apply_entry(self):
        action = self.action.get()
        if action == "Entfernen":
            path = self.current_path
            if path is None:
                messagebox.showinfo("Eintrag auswählen", "Bitte zuerst einen Handbook-Eintrag auswählen.")
                return
            if not messagebox.askyesno("Eintrag entfernen", "Soll dieser Eintrag wirklich gelöscht werden?\n\n" + str(path)):
                return
            rel = manual.handbook_entry_relpath(path)
            path.unlink()
            manual.append_handbook_history("deleted", rel, self.summary.get().strip() or "Removed handbook entry " + path.stem, rel)
            self.refresh_entries()
            self.start_build()
            return

        title = self.title.get().strip()
        category = self.category.get().strip()
        if not title or not category:
            messagebox.showerror("Fehlende Angaben", "Bitte Kategorie und Titel angeben.")
            return
        target = manual.HANDBOOK_DIR / category / (manual.safe_handbook_filename(title) + ".md")
        if action == "Neu" and target.exists():
            messagebox.showerror("Eintrag vorhanden", "Dieser Handbook-Eintrag existiert bereits:\n" + str(target))
            return
        if action == "Bearbeiten" and self.current_path is not None:
            target = self.current_path
        body = self.editor.get("1.0", "end-1c")
        if not body.lstrip().startswith("# "):
            body = "# " + title + "\n\n" + body
        manual.write_text(target, body.rstrip() + "\n")
        rel = manual.handbook_entry_relpath(target)
        action_name = "added" if action == "Neu" else "updated"
        default_summary = ("Created" if action == "Neu" else "Updated") + " handbook entry " + title
        manual.append_handbook_history(action_name, rel, self.summary.get().strip() or default_summary, rel)
        self.refresh_entries()
        self.current_path = target
        self.start_build()

    def append_log(self, text):
        self.log.configure(state="normal")
        self.log.insert("end", text)
        self.log.see("end")
        self.log.configure(state="disabled")

    def start_build(self):
        if self.process_thread and self.process_thread.is_alive():
            return
        self._publish_requested = self.publish_after_build.get()
        self.save_button.configure(state="disabled")
        self.status.set("Manual wird aufgebaut; Fortschritt und Meldungen erscheinen hier …")
        self.progress.start(12)
        self.append_log("\n--- Aufbau gestartet ---\n")
        self.process_thread = threading.Thread(target=self.build_worker, daemon=True)
        self.process_thread.start()

    def build_worker(self):
        env = os.environ.copy()
        user = os.environ.get("USER") or os.environ.get("USERNAME") or "unknown"
        env["DOCBUILDER_USER"] = user
        env["PYTHONUNBUFFERED"] = "1"
        command = [sys.executable, "-u", str(Path(manual.__file__).resolve()), "--no-prompts"]
        try:
            code = self.run_process(command, env)
            if code == 0 and self._publish_requested:
                publish_script = manual.ROOT / "publish_manual.sh"
                if not publish_script.is_file():
                    self.events.put(("error", "publish_manual.sh fehlt neben update_manual.py."))
                    return
                self.events.put(("status", "Manual fertig. GitHub-Veröffentlichung läuft …"))
                self.events.put(("line", "\n--- GitHub-Veröffentlichung gestartet ---\n"))
                code = self.run_process(["bash", str(publish_script)], env)
            self.events.put(("done", code))
        except Exception as exc:
            self.events.put(("error", str(exc)))

    def run_process(self, command, env):
        process = subprocess.Popen(command, cwd=str(manual.ROOT), env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
        for line in process.stdout:
            self.events.put(("line", line))
        return process.wait()

    def poll_events(self):
        try:
            while True:
                kind, value = self.events.get_nowait()
                if kind == "line":
                    self.append_log(value)
                    if value.strip() in ("Publishing source files...", "Scanning PCF, SCRIPT, OPT and handbook files...", "Rendering manual pages...", "Writing overview and final index..."):
                        self.status.set(value.strip())
                elif kind == "done":
                    self.progress.stop()
                    self.save_button.configure(state="normal")
                    if value == 0:
                        self.status.set("Manual aufgebaut und Veröffentlichung abgeschlossen." if self._publish_requested else "Manual erfolgreich aufgebaut.")
                    else:
                        self.status.set("Aufbau oder Veröffentlichung mit Fehler beendet (Code {}).".format(value))
                elif kind == "status":
                    self.status.set(value)
                elif kind == "error":
                    self.progress.stop()
                    self.save_button.configure(state="normal")
                    self.status.set("Aufbau konnte nicht gestartet werden.")
                    self.append_log(value + "\n")
        except queue.Empty:
            pass
        self.root.after(100, self.poll_events)


if __name__ == "__main__":
    app_root = tk.Tk()
    ManualGUI(app_root)
    app_root.mainloop()
