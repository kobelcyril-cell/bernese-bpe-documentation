
! Environment Variables
! ---------------------
ENVIRONMENT 1  "" "${}"
  ## widget = initmenu; pointer = ENVIR_LIST

! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 1  "./DUMMY"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${PAN}/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "1980"
  ## widget = comment
  # $Y+0

SES_INFO 1  "0060"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show general configuration"

! Coordinate File Names (input)
! -----------------------------
CRDINP 1  "./DUMMY/STA/$(MAPCRD).CRD"
  ## widget = selwin; path = DIR_CRD; ext = EXT_CRD; maxfiles = 1
  # $(MAPCRD)

DESCR_CRDINP 1  "Input coordinate file"

VELINP 0
  ## widget = selwin; path = DIR_VEL; ext = EXT_VEL; maxfiles = 1

DESCR_VELINP 1  "Input velocity file"

! Filename for resulting plotz (output)
! -------------------------------------
FIGSHOW 1  "0"
  ## widget = checkbox

MSG_FIGSHOW 1  "Show resulting firgure on the screen"

FIGOUT 1  "./DUMMY/FIG/$(FIG)mapCRD.eps"
  ## widget = lineedit; path = DIR_FIG; ext = NO_EXT; maxfiles = 1
  # $(FIG)mapCRD.eps

DESCR_FIGOUT 1  "Output file for figure"

FIGRES 1  "600"
  ## widget = lineedit; check_type = integer; check_min = 50

DESCR_FIGRES 1  "Resolution of the figure"

! Title: new entry
! ----------------
TITLE 0
  ## widget = lineedit

MSG_TITLE 1  "Title line"

TIT_FONTSIZE 1  "x-small"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_TIT_FONTSIZE 1  "Font size in the title"

BGCOLOR 1  "white"
  ## widget = combobox; editable = true
  ## cards = white red green blue yellow orange magenta cyan grey

MSG_BGCOLOR 1  "Plot background color"

! Size of the plot
! ----------------
SIZEX 1  "8"
  ## widget = lineedit; check_type = real

MSG_SIZEX 1  "Width of the plot"

SIZEY 1  "6"
  ## widget = lineedit; check_type = real

MSG_SIZEY 1  "Height of the plot"

! Get boundaries of the plot
! --------------------------
XYAUTO 1  "1"
  ## widget = checkbox

MSG_XYAUTO 1  "Auto scale to a global map"

XMIN 0
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_XMIN 1  "Latitude of the lower left corner"

YMIN 0
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_YMIN 1  "Longitude of the lower left corner"

XMAX 0
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_XMAX 1  "Latitude of the upper right corner"

YMAX 0
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_YMAX 1  "Longitude of the upper right corner"

! Layout of the map
! -----------------
MAPSTYLE 1  "Relief"
  ## widget = combobox; cards = Simple Relief Topo Picture

MSG_MAPSTYLE 1  "Style of the map"

MAPRESOL 1  "low"
  ## widget = combobox; cards = crude low intermediate high full

MSG_MAPRESOL 1  "Resolution of the map"

MAPCOCN 1  "#99ffff"
  ## widget = combobox; editable = true; activeif = MAPSTYPE = Simple
  ## cards = aqua red green blue yellow orange magenta cyan grey

MSG_MAPCOCN 1  "Color of the ocean in the simple mode"

MAPCLAND 1  "#cc9966"
  ## widget = combobox; editable = true; activeif = MAPSTYPE = Simple
  ## cards = coral red green blue yellow orange magenta cyan grey

MSG_MAPCLAND 1  "Color of the land in the simple mode"

! Map projection
! --------------
MAPPROJ 1  "Robinson"
  ## widget = combobox
  ## cards = Cylindrical_Equal_Area McBryde-Thomas_Flat-Polar_Quartic Azimuthal_Equidistant Sinusoidal Polyconic Gnomonic Mollweide Transverse_Mercator Gall_Stereographic_Cylindrical Miller_Cylindrical Rotated_Pole Cylindrical_Equidistant Hammer Geostatio

MSG_MAPPROJ 1  "Map projection"

MAPPLAT 1  "0.0"
  ## widget = lineedit; check_type = real

MSG_MAPLAT 1  "Latitude for projection point"

MAPPLON 1  "0.0"
  ## widget = lineedit; check_type = real

MSG_MAPLON 1  "Longitude for projection point"

! Plotting options for GPS
! ------------------------
USE_G 1  "1"
  ## widget = checkbox

MSG_USE_G 1  "Include stations tracked GPS"

ORDER_G 1  "6"
  ## widget = spinbox; range = 1 10 1; activeif = USE_G = 1

MSG_ORDER_G 1  "Order number for GPS"

COLOR_G 1  "purple"
  ## widget = combobox; editable = true; activeif = USE_G = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_COLOR_G 1  "Color for GPS"

SSIZE_G 1  "2"
  ## widget = spinbox; range = 1 30 1; activeif = USE_G = 1

MSG_SSIZE_G 1  "Symbol size for GPS"

LABEL_G 1  "GPS"
  ## widget = lineedit; activeif = USE_G = 1

MSG_LABEL_G 1  "Legend entry for GPS"

! Plotting options for GLONASS
! ----------------------------
USE_R 1  "1"
  ## widget = checkbox

MSG_USE_R 1  "Include stations tracked GLONASS"

ORDER_R 1  "5"
  ## widget = spinbox; range = 1 10 1; activeif = USE_R = 1

MSG_ORDER_R 1  "Order number for GLONASS"

COLOR_R 1  "orange"
  ## widget = combobox; editable = true; activeif = USE_R = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_COLOR_R 1  "Color for GLONASS"

SSIZE_R 1  "4"
  ## widget = spinbox; range = 1 30 1; activeif = USE_R = 1

MSG_SSIZE_R 1  "Symbol size for GLONASS"

LABEL_R 1  "GLONASS"
  ## widget = lineedit; activeif = USE_R = 1

MSG_LABEL_R 1  "Legend entry for GLONASS"

! Plotting options for Galileo
! ----------------------------
USE_E 1  "1"
  ## widget = checkbox

MSG_USE_E 1  "Include stations tracked Galileo"

ORDER_E 1  "4"
  ## widget = spinbox; range = 1 10 1; activeif = USE_E = 1

MSG_ORDER_E 1  "Order number for Galileo"

COLOR_E 1  "green"
  ## widget = combobox; editable = true; activeif = USE_E = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_COLOR_E 1  "Color for Galileo"

SSIZE_E 1  "6"
  ## widget = spinbox; range = 1 30 1; activeif = USE_E = 1

MSG_SSIZE_E 1  "Symbol size for Galileo"

LABEL_E 1  "Galileo"
  ## widget = lineedit; activeif = USE_E = 1

MSG_LABEL_E 1  "Legend entry for Galileo"

! Plotting options for SBAS
! -------------------------
USE_S 1  "0"
  ## widget = checkbox

MSG_USE_S 1  "Include stations tracked SBAS"

ORDER_S 1  "3"
  ## widget = spinbox; range = 1 10 1; activeif = USE_S = 1

MSG_ORDER_S 1  "Order number for SBAS"

COLOR_S 1  "yellow"
  ## widget = combobox; editable = true; activeif = USE_S = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_COLOR_S 1  "Color for SBAS"

SSIZE_S 1  "6"
  ## widget = spinbox; range = 1 30 1; activeif = USE_S = 1

MSG_SSIZE_S 1  "Symbol size for SBAS"

LABEL_S 1  "SBAS"
  ## widget = lineedit; activeif = USE_S = 1

MSG_LABEL_S 1  "Legend entry for SBAS"

! Plotting options for BeiDou
! ---------------------------
USE_C 1  "0"
  ## widget = checkbox

MSG_USE_C 1  "Include stations tracked BeiDou"

ORDER_C 1  "2"
  ## widget = spinbox; range = 1 10 1; activeif = USE_C = 1

MSG_ORDER_C 1  "Order number for BeiDou"

COLOR_C 1  "blue"
  ## widget = combobox; editable = true; activeif = USE_C = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_COLOR_C 1  "Color for BeiDou"

SSIZE_C 1  "8"
  ## widget = spinbox; range = 1 30 1; activeif = USE_C = 1

MSG_SSIZE_C 1  "Symbol size for BeiDou"

LABEL_C 1  "BeiDou"
  ## widget = lineedit; activeif = USE_C = 1

MSG_LABEL_C 1  "Legend entry for BeiDou"

! Plotting options for QZSS
! -------------------------
USE_J 1  "0"
  ## widget = checkbox

MSG_USE_J 1  "Include stations tracked QZSS"

ORDER_J 1  "1"
  ## widget = spinbox; range = 1 10 1; activeif = USE_J = 1

MSG_ORDER_J 1  "Order number for QZSS"

COLOR_J 1  "red"
  ## widget = combobox; editable = true; activeif = USE_J = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_COLOR_J 1  "Color for QZSS"

SSIZE_J 1  "10"
  ## widget = spinbox; range = 1 30 1; activeif = USE_J = 1

MSG_SSIZE_J 1  "Symbol size for QZSS"

LABEL_J 1  "QZSS"
  ## widget = lineedit; activeif = USE_J = 1

MSG_LABEL_J 1  "Legend entry for QZSS"

! SPecify the legned characteristics
! ----------------------------------
LEGEND 1  "1"
  ## widget = checkbox

MSG_LEGEND 1  "Plot a legend"

LEG_POS 1  "lower/center"
  ## widget = combobox; activeif = LEGEND = 1
  ## cards = right center/left upper/right lower/right best center lower/left center/right upper/left upper/center lower/center

MSG_LEG_POS 1  "Position of the legend"

LEG_ANCHOR_X 1  "0.5"
  ## widget = lineedit; activeif = LEGEND = 1; check_type = real

MSG_LEG_ANCHOR_X 1  "Anchor point for legend position"

LEG_ANCHOR_Y 1  "-0.2"
  ## widget = lineedit; activeif = LEGEND = 1; check_type = real

MSG_LEG_ANCHOR_Y 1  "Anchor point for legend position"

LEG_NCOLS 1  "3"
  ## widget = spinbox; activeif = LEGEND = 1; range = 1 10 1

MSG_LEG_NCOLS 1  "Position of the legend"

LEG_FRAME 1  "1"
  ## widget = checkbox; activeif = LEGEND = 1

MSG_LEG_FRAME 1  "Plot a legend with a frame"

LEG_TITLE 0
  ## widget = lineedit; activeif = LEGEND = 1

MSG_LEG_TITLE 1  "Title of the legend"

LEG_FONTSIZE 1  "x-large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_LEG_FONTSIZE 1  "Font size in the legend"


# BEGIN_PANEL NO_CONDITION #####################################################
# MAP WITH STATIONS FROM A COORDINATE FILE - plotCRDmap 1: Input/output files  #
#                                                                              #
# GENERAL CONFIGURATION                                                        #
#   Show general configuration        > % <                                    # SHOWGEN
#                                                                              #
# INPUT FILES                                                                  #
#   Input coordinate file             > %%%%%%%% <                             # CRDINP
#   Input velocity@@ file             > %%%%%%%% <    (to plot vectors)        # VELINP
#                                                                              #
# RESULT FILE                                                                  #
#   Show figure on the screen         > % <                                    # FIGSHOW
#   Name of the output file           > %%%%%%%%%%%%%%%%%%%%%%%% <             # FIGOUT
#                                       (extension defines the format)         #
#   Resolution of the figure          > %%%% < dpi                             # FIGRES
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# plotCRDmap 1.1: General Configuration                                        #
#                                                                              #
# FONT DEFITIONS                                                               #
#   Title                       > %%%%%%%%%%%% <                               # TIT_FONTSIZE
#   Legend                      > %%%%%%%%%%%% <                               # LEG_FONTSIZE
#                                                                              #
# COLOR DEFITIONS                                                              #
#   Background color of the plot> %%%%%%%%%%%% <                               # BGCOLOR
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotCRDmap 2: Data for plotting                                              #
#                                                                              #
# CONTENT OF THE MAP                                                           #
#   Title > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#                                                                              #
#   Include               order     color             size       label         #
#      > % <  GPS       > %% <    > %%%%%%%% <      > %%% <    > %%%%%%%% <    # USE_G ORDER_G COLOR_G SSIZE_G LABEL_G
#      > % <  GLONASS   > %% <    > %%%%%%%% <      > %%% <    > %%%%%%%% <    # USE_R ORDER_R COLOR_R SSIZE_R LABEL_R
#      > % <  Galileo   > %% <    > %%%%%%%% <      > %%% <    > %%%%%%%% <    # USE_E ORDER_E COLOR_E SSIZE_E LABEL_E
#      > % <  SBAS      > %% <    > %%%%%%%% <      > %%% <    > %%%%%%%% <    # USE_S ORDER_S COLOR_S SSIZE_S LABEL_S
#      > % <  BeiDou    > %% <    > %%%%%%%% <      > %%% <    > %%%%%%%% <    # USE_C ORDER_C COLOR_C SSIZE_C LABEL_C
#      > % <  QZSS      > %% <    > %%%%%%%% <      > %%% <    > %%%%%%%% <    # USE_J ORDER_J COLOR_J SSIZE_J LABEL_J
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotCRDmap 3: Map layout                                                     #
#                                                                              #
# MAP LAYOUT SPECIFICATION                                                     #
#   Size of the plot:   width   > %%%%%%%%%% <    height     > %%%%%%%%%% <    # SIZEX SIZEY
#                                                                              #
#   Topography style:           > %%%%%%%%%% <    resolution > %%%%%%%%%% <    # MAPSTYLE MAPRESOL
#       colors for      ocean   > %%%%%%%%%% <    land       > %%%%%%%%%% <    # MAPCOCN MAPCLAND
#                                                                              #
#   Projection:                 > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <    # MAPPROJ
#        projection point  lat. > %%%%%%%%%% <    longitude  > %%%%%%%%%% <    # MAPPLAT MAPPLON
#                                                                              #
#   Boundaries: > % < auto or             latitude              longitude      # XYAUTO
#                          lower left   > %%%%%%%% <          > %%%%%%%% <     # XMIN YMIN
#                          upper right  > %%%%%%%% <          > %%%%%%%% <     # XMAX YMAX
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotCRDmap 4: Legend layout                                                  #
#                                                                              #
# LEGEND LAYOUT SPECIFICATION                                                  #
# > % <  Legend:                                                               # LEGEND
#        Position  > %%%%%%%%%%%% <  X-off > %%%%% <  Y-off > %%%%% <          # LEG_POS LEG_ANCHOR_X LEG_ANCHOR_Y
#        Frame     > % <             Num. Columns   > % <                      # LEG_FRAME LEG_NCOLS
#        Title     > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <          # LEG_TITLE
#                                                                              #
# END_PANEL ####################################################################
