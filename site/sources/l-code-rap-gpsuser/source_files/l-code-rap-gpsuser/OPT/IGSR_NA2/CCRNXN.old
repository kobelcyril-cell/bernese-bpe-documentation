# BEGIN_PANEL NO_CONDITION #####################################################
# CONCATENATE RINEX NAVIGATION FILES - CCRNXN 1: Filenames                     #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files  > % <                                              # SHOWGEN
#                                                                              #
# RINEX INPUT FILES                                                            #
#   RINEX navigation files                                                     #
#     Bernese internal naming       > %%%%%%%%%%%%%%%%%%%% <                   # FILELIST_BSW
#     RINEX-3-style naming          > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # FILELIST_LONG
#     RINEX-2-style naming  GPS@@@@ > %%%%%%%% <                               # FILELIST_GPS
#     RINEX-2-style naming  GLONASS > %%%%%%%% <                               # FILELIST_GLO
#     RINEX-2-style naming  Galileo > %%%%%%%% <                               # FILELIST_GAL
#     Any naming convention         > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # FILELIST
#                                                                              #
# OUTPUT RINEX FILE                                                            #
#   Bernese internal output name    > %%%%%%%%%%%%%%%%%%%% <                   # BSWOUT
#   Others than default     > % < (RINEX 3 format, BSW-internal naming)        # SPEC_RNX_OUT
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output        > % < use CCRNXN.Lnn            or  > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages        > % < merged to program output  or  > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# TITLE > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# CCRNXN 1.1: General Files                                                    #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants       > %%%%%%%%%%%% <                                   # CONST
#   GPS-UTC time difference > %%%%%%%%%%%% <                                   # GPSUTC
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SPEC_RNX_OUT = 1 #################################################
# CCRNXN 1.2: Output RINEX file                                                #
#                                                                              #
# AUTOMATED OUTPUT RINEX FILE NAMING (if result file is blank)                 #
#   > % < BSW internal file naming                                             # RADIO_BSW_FN
#   > % < RINEX-2- or RINEX-3-style file name (depending on output version)    # RADIO_RNX_FN
#                                                                              #
#   > % < Normalize start epoch in RINEX-3-style output file name to midnight  # NRM_EPO_FN
#                                                                              #
#     First nine characters   > %%%%%%%%% < (for BSW and RINEX 3 file naming)  # CHAR9
#     First four characters   > %%%% <      (for RINEX 2-style file naming)    # CHAR4
#                                                                              #
# OUTPUT RINEX VERSION                                                         #
#   > % < Take highest input RINEX version as output RINEX version             # RADIO_MRH
#   > % < On mixed input RINEX main versions, choose lower one                 # RADIO_MRL
#         On same input RINEX main versions, choose higher sub-version         #
#   > % < Force output RINEX version to > %%%% <                               # RADIO_FR RNXOUTVERS
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 2.1: Input Options                                                    #
#                                                                              #
# SATELLITE SYSTEMS                                                            #
#            Use the GNSS    Minimal number of broadcast messages              #
#   GPS      > % <           > %%% <                                           # USE_G MINMSG_G
#   GLONASS  > % <           > %%% <                                           # USE_R MINMSG_R
#   Galileo  > % <           > %%% <                                           # USE_E MINMSG_E
#   SBAS     > % <           > %%% <                                           # USE_S MINMSG_S
#   BeiDou   > % <           > %%% <                                           # USE_C MINMSG_C
#   QZSS     > % <           > %%% <                                           # USE_J MINMSG_J
#   IRNSS    > % <           > %%% <                                           # USE_I MINMSG_I
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 2.2: Options                                                          #
#                                                                              #
# OPTIONS                                                                      #
#   Use time window                            > % <                           # USEWIN
#   Change hdr strings to upper case on read   > % <                           # RDRXHDUC
#                                                                              #
# COMMENTS                                                                     #
#   Agency running program      > %%%%%%%%%%%%%%%%%%% <                        # AGENCY
#                                                                              #
# > Comments____________________________________________________      <        # COMMENTS
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
# > Digital_Object_Identifier_(DOI)_____________________________      <        # RX_DOI
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
# > License_of_use______________________________________________      <        # RX_LICENSE
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
# > Station_information_________________________________________      <        # RX_STAINF
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL USEWIN = 1 #######################################################
# CCRNXN 2.3: Observation Window                                               #
#                                                                              #
# OBSERVATION WINDOW                                                           #
#                                                                              #
#   > % < Defined by Year and Session identifier                               # RADIO_1
#         Year  > %%%% <   Session > %%%% <                                    # SESSION_YEAR SESSION_STRG
#                                                                              #
#                                                                              #
#   > % < Defined by Start and End time                                        # RADIO_2
#                 yyyy mm dd     hh mm ss           yyyy mm dd     hh mm ss    #
#         Start > %%%%%%%%%% < > %%%%%%%% <   End > %%%%%%%%%% < > %%%%%%%% <  # STADAT STATIM ENDDAT ENDTIM
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 3: Check Content of RINEX Header                                      #
#                                                                              #
# ACTIONS IN CASE OF MISSING MANDATORY HEADER RECORDS                          #
#   Missing mandatory records            > %%%%%%%%% <                         # AOM_GENERAL
#                                                                              #
# ACTIONS IN CASE OF INCONSISTENCIES BETWEEN HEADERS                           #
# (also between multiple headers in the same RINEX file)                       #
#   Ionospheric correction parameters    > %%%%%%%%% <                         # AOI_IONCORRPARS
#   Leap seconds                         > %%%%%%%%% <                         # AOI_LEAP_SEC
#   Service provider                     > %%%%%%%%% < (RINEX vers ge 3.00)    # AOI_SERVICE_PROV
#   Time system correction parameters    > %%%%%%%%% <                         # AOI_A0_A1
#   UTC ID                               > %%%%%%%%% < (RINEX vers ge 3.00)    # AOI_UTC_ID
#                                                                              #
#     NONE@@@@: No check is done            (keep contents of the first one)   #
#     WARNING@: Write warning and continue  (keep contents of the first one)   #
#     SKIP@@@@: Skip file and continue with next file                          #
#     ERROR@@@: Write error message and stop processing                        #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.1: Definition of valid epochs                                       #
#                                                                              #
# Definition of valid epochs                                                   #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Sampling interval [s], 0 means no sampling                       #
#   Column 4: List of offsets to full minute [s], empty list means offset 0    #
#   Column 5: Sampling tolerance [s]                                           #
# > GNSS Block___ interval offsets_______________ tolerance      <             # EPOCHS_DEF
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.2: Limits for the norm of the satellite velocity                    #
#                                                                              #
# Satellite velocity [m/s] (Meaningful for GLONASS and SBAS only)              #
#   Column 1: GNSS (1 character), use 'R' or 'S'                               #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal satellite velocity [m/s]                                 #
#   Column 4: Maximal satellite velocity [m/s]                                 #
# > GNSS Block___ from_____ to_______      <                                   # LIM_VEL_NORM
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.3: Limits for the semi major axis                                   #
#                                                                              #
# Semi major axis [m]                                                          #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal semi major axis [m]                                      #
#   Column 4: Maximal semi major axis [m]                                      #
# > GNSS Block___ from_____ to_______      <                                   # LIM_SEMI_MAJ_AXIS
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.4: Limits for the node                                              #
#                                                                              #
# Node [deg]                                                                   #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal node [deg]                                               #
#   Column 4: Maximal node [deg]                                               #
# > GNSS Block___ from_____ to_______      <                                   # LIM_NODE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.5: Limits for the rate of the node                                  #
#                                                                              #
# Rate of node [deg/s] (Doesn't apply for GLONASS or SBAS)                     #
#   Column 1: GNSS (1 character)                                               #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal rate of node [deg/s]                                     #
#   Column 4: Maximal rate of node [deg/s]                                     #
# > GNSS Block___ from_____ to_______      <                                   # LIM_NODE_DOT
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.6: Limits for the mean anomaly                                      #
#                                                                              #
# Mean anomaly [deg]                                                           #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal mean anomaly [deg]                                       #
#   Column 4: Maximal mean anomaly [deg]                                       #
# > GNSS Block___ from_____ to_______      <                                   # LIM_MEAN_ANOMALY
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.7: Limits for the eccentricity                                      #
#                                                                              #
# Eccentricity                                                                 #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal eccentricity                                             #
#   Column 4: Maximal eccentricity                                             #
# > GNSS Block___ from_____ to_______      <                                   # LIM_ECCENTRICITY
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.8: Limits for the inclination                                       #
#                                                                              #
# Inclination [deg]                                                            #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal inclination [deg]                                        #
#   Column 4: Maximal inclination [deg]                                        #
# > GNSS Block___ from_____ to_______      <                                   # LIM_INCLINATION
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.9: Limits for the perigee                                           #
#                                                                              #
# Perigee [deg] (Meaningful for QZSS only)                                     #
#   Column 1: GNSS (1 character), use 'J'                                      #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal perigee [deg]                                            #
#   Column 4: Maximal perigee [deg]                                            #
# > GNSS Block___ from_____ to_______      <                                   # LIM_PERIGEE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.10: Limits for the correction to the mean motion                    #
#                                                                              #
# Correction to mean motion [deg/s] (Doesn't apply for GLONASS or SBAS)        #
#   Column 1: GNSS (1 character)                                               #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal correction to mean motion [deg/s]                        #
#   Column 4: Maximal correction to mean motion [deg/s]                        #
# > GNSS Block___ from_____ to_______      <                                   # LIM_DELTA_N
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 4.11: Additional configurations to detect bad navigation messages     #
#                                                                              #
# Column 1: GNSS (1 character), empty means all GNSS                           #
# Column 2: Block name for one GNSS (one of the names has to be empty)         #
# Column 3: Restrict block to given list of PRNs, no restrictions on empty list#
# > GNSS Block___ Restr_to_PRNs______________      <                           # GEN_BLK_CONF
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXN 5: Broadcast data source priority list                                #
#                                                                              #
# Bit-wise priorization of GPS L2 broadcast data sources,                      #
#  empty means no priorization at all                                          #
#  > %%%%% <                                                                   # GPS_DAT_SRC_PRIO
#                                                                              #
# Bit-wise priorization of Galileo broadcast data sources,                     #
#  empty means no priorization at all,                                         #
#  e.g. '4 1 2' means I/NAV E5b-I (3) have highest prioriy,                    #
#  '1' corresponds to I/NAV E1-B navigation messages                           #
#  '2' corresponds to F/NAV E5a-I navigation messages                          #
#  '4' corresponds to I/NAV E5b-I navigation messages                          #
#  > %%%%% <                                                                   # GAL_DAT_SRC_PRIO
#                                                                              #
# END_PANEL ####################################################################
