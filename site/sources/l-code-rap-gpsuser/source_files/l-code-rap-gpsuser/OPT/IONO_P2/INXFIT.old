
! Environment Variables
! ---------------------
ENVIRONMENT 12
  "P" "/storage/research/aiub_code"
  "Q" "/storage/research/aiub_code"
  "K" "/storage/research/aiub_u_camp"
  "X" "/storage/research/aiub_data/BSWsoftware/BERN/GPS"
  "U" "/storage/homefs/l_code/GPSUSER"
  "S" "/storage/research/aiub_data/PRODUCTS"
  "G" "/storage/research/aiub_u_camp"
  "USER" "l_code"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  ## widget = initmenu; pointer = ENVIR_LIST

! SOME KEYWORDS FOR AUTOMATIC OUTPUT
! ----------------------------------
CAMPAIGN 1  "${P}/EXAMPLE"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${P}/EXAMPLE/GEN/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2022"
  ## widget = comment
  # $Y+0

SES_INFO 1  "3010"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! General Constants
! -----------------
CONST 1  "${MODEL}/CONST.BSW"
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1
  ## emptyallowed = false
  # CONST

DESCR_CONST 1  "General constants"

! IONEX Control File
! ------------------
IONEXCF 1  "${P}/EXAMPLE/GEN/IONEX_CGIM.SKL"
  ## widget = selwin; path = PTH_IONEXCF; ext = EXT_IONEXCF; maxfiles = 1
  ## emptyallowed = false
  # IONEX_CGIM

DESCR_IONEXCF 1  "IONEX control file"

! IONEX file(s)
! -------------
INXINP 1  "${P}/EXAMPLE/ATM/$F22303.INX"
  ## widget = selwin; path =DIR_INX; ext =EXT_INX
  # $F$YD+2

MSG_INXINP 1  "IONEX files"

INXINP_TXT_COL_1 1  "IONEX files"

INXINP_PTH_COL_2 1  "${P}/EXAMPLE/ORX/"
  ## widget = initmenu; pointer = DIR_OXN

INXINP_EXT_COL_2 1  "22N"
  ## widget = initmenu; pointer = EXT_RXN

INXINP_TXT_COL_2 1  "A priori BIM information"

INXINP_PTH_COL_3 1  "${P}/EXAMPLE/RAW/"
  ## widget = initmenu; pointer = DIR_RXN

INXINP_EXT_COL_3 1  "22N"
  ## widget = initmenu; pointer = EXT_RXN

INXINP_TXT_COL_3 1  "Navigation files"

! Include a priori information
! ----------------------------
USENAV 1  "1"
  ## widget = checkbox

MSG_USENAV 1  "Include a priori BIM information"

! Navigation file(s)
! ------------------
NAVINP 1  "${P}/EXAMPLE/ORX/LAST.22N"
  ## widget = selwin; path =DIR_OXN; ext =EXT_RXN; activeif = USENAV = 1
  ## emptyallowed = true
  # LAST

MSG_NAVINP 1  "Navigation files"

! Navigation file (output)
! ------------------------
NAVOUT 1  "${P}/EXAMPLE/RAW/$F_3030.22N"
  ## widget = lineedit; path =DIR_RXN; ext =EXT_RXN
  # $F_$S+2

MSG_NAVOUT 1  "Navigation files"

! Program Output File
! -------------------
SYSODEF 1  "0"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "${P}/EXAMPLE/OUT/INXFIT_P2.OUT"
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false
  # INXFIT_P2

DESCR_SYSOUT 1  "Program output"

! Error Message File
! ------------------
ERRMRG 1  "0"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 1  "${U}/WORK/ERROR.MSG"
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false
  # ERROR

DESCR_SYSERR 1  "Error message"

! Subroutine/function debug output
! --------------------------------
DEBUG_STKLOG 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_STKLOG 1  "Debug stack log output"

DEBUG_SUMMARY 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_SUMMARY 1  "Debug summary output"

DEBUG_INTERVAL 1  "00 01 00"
  ## widget = lineedit; check_type = time

MSG_DEBUG_INTERVAL 1  "Interval for intermediate debug summary"

! Title
! -----
TITLE 1  "?"
  ## widget = lineedit

MSG_TITLE 1  "Title line"

! Determine BIM parameters for N TEC maps each
! --------------------------------------------
NUMTEC 0
  ## widget = lineedit

MSG_NUMTEC 1  "Determine BIM parameters for N TEC maps each"

! Ignore TEC data at polar caps
! -----------------------------
NOPOL 1  "0"
  ## widget = checkbox

MSG_NOPOL 1  "Ignore TEC data at polar caps"

! Consider RMS maps
! -----------------
RMSMAP 1  "0"
  ## widget = checkbox

MSG_RMSMAP 1  "Consider RMS maps"

! Use adjusted BIM parameters as a priori info
! --------------------------------------------
APRBIM 1  "0"
  ## widget = checkbox

MSG_APRBIM 1  "Use adjusted BIM parameters as a priori info"

! Maximum number of iterations
! ---------------------
MAXITER 1  "30"
  ## widget = lineedit

MSG_MAXITER 1  "number of iterations"

! Reduce TEC data with factor
! ---------------------------
REDTEC 1  "1"
  ## widget = lineedit

MSG_REDTEC 1  "Reduce TEC data with factor"

! Add constant
! ------------
ADDTEC 1  "0"
  ## widget = lineedit

MSG_ADDTEC 1  "Add constant"

! Find best fitting set of Klobuchar constants
! --------------------------------------------
KLOBUCH 1  "0"
  ## widget = checkbox

MSG_KLOBUCH 1  "Find best fitting set of Klobuchar constants"

! Restrict analysis to pre-defined area
! -------------------------------------
AREA 1  "0"
  ## widget = checkbox

MSG_AREA 1  "Restrict analysis to pre-defined area"

! Latitude from
! -------------
LATFROM 0
  ## widget = lineedit; activeif = AREA = 1

MSG_LATFROM 1  "Latitude from"

! Latitude to
! -----------
LATTO 0
  ## widget = lineedit; activeif = AREA = 1

MSG_LATTO 1  "Latitude to"

! Longitude from
! --------------
LONFROM 0
  ## widget = lineedit; activeif = AREA = 1

MSG_LONFROM 1  "Longitude from"

! Longitude to
! ------------
LONTO 0
  ## widget = lineedit; activeif = AREA = 1

MSG_LONTO 1  "Longitude to"


# BEGIN_PANEL NO_CONDITION #####################################################
# DETERMINE BIM PARAMETERS BEST FITTING IONEX TEC MAPS - INXFIT 1: Filenames   #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants         > %%%%%%%%%%%% <                                 # CONST
#   IONEX control file        > %%%%%%%%%%%% <                                 # IONEXCF
#                                                                              #
# INPUT FILES                                                                  #
#   IONEX files               > %%%%%%%%%%%% <                                 # INXINP
#   A priori BIM information  > %%%%%%%%%%%% < > % <                           # NAVINP USENAV
#                                                                              #
# RESULT FILES                                                                 #
#   Navigation file           > %%%%%%%%%%%% <                                 # NAVOUT
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output  > % < use INXFIT.Lnn            or > %%%%%%%%%%%% <        # SYSODEF SYSOUT
#   Error message   > % < merged to program output  or > %%%%%%%%%%%% <        # ERRMRG SYSERR
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# INXFIT 2: General Options                                                    #
#                                                                              #
# TITLE > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE
#                                                                              #
# GENERAL OPTIONS                                                              #
#   Determine BIM parameters for N TEC maps each > %%%%% <                     # NUMTEC
#   Consider RMS maps                            > % <                         # RMSMAP
#   Ignore TEC data at polar caps                > % <                         # NOPOL
#   Find best fitting set of Klobuchar constants > % <                         # KLOBUCH
#   Use adjusted BIM parameters as a priori info > % <                         # APRBIM
#   Maximum number of iterations                 > %%%%% <                     # MAXITER
#                                                                              #
# RESCALING OF INPUT TEC DATA                                                  #
#   Scale TEC values using factor                > %%%%% <                     # REDTEC
#   Add constant                                 > %%%%% < TECU                # ADDTEC
#                                                                              #
# AREA TO BE CONSIDERED                                                        #
#   Restrict analysis to pre-defined area        > % <                         # AREA
#   Latitude                                from > %%%%%%% < to > %%%%%%% < deg# LATFROM LATTO
#   Longitude                               from > %%%%%%% < to > %%%%%%% < deg# LONFROM LONTO
#                                                                              #
# END_PANEL ####################################################################
