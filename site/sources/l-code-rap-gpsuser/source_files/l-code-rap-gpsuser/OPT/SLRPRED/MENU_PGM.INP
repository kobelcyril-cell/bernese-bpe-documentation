# BEGIN_PANEL NO_CONDITION #####################################################
# MENU_PGM 3 Menu - Plots  (Test, based on python3)                            #
#                                                                              #
# PLOT GENERAL STATISTICS                                                      #
#   plotStanum    > %%%%%%%% <    : Number of stations from coordinate files   # PLOT_STANUM_INP
#   plotSatnum    > %%%%%%%% <    : Number of satellites from precise files    # PLOT_SATNUM_INP
#                                                                              #
# PLOT PROGRAM OUTPUT EXTRACTION                                               #
#   plotGPSXTR    > %%%%%%%% <    : Statistic plots from GPSXTR                # PLOT_GPSXTR_INP
#   plotAMBXTR    > %%%%%%%% <    : Ambiguity resolution statistics            # PLOT_AMBXTR_INP
#   plotCCRNXC    > %%%%%%%% <    : Solution statistic from CCRNXC             # PLOT_CCRNXC_INP
#                                                                              #
# STATION RELATED PLOTS                                                        #
#   plotCRDmaps   > %%%%%%%% <    : Map with location of stations              # PLOT_CRDMAPS_INP
#   plotHELMR1    > %%%%%%%% <    : Plot Helmert parameters                    # PLOT_HELMR1_INP
#   plotHLMmap    > %%%%%%%% <    : Plot a map with residuals from HELMR1      # PLOT_HLMMAPS_INP
#   plotVisibility> %%%%%%%% <    : Satellite visibility/PDOP for a station    # PLOT_PDOP_INP
#                                                                              #
# ORBIT RELATED PLOTS                                                          #
#   plotPREmap    > %%%%%%%% <    : Plot ground tracks of satellites           # PLOT_PREMAPS_INP
#   plotSTDELE    > %%%%%%%% <    : Plot orbit misclosures from STDELE         # PLOT_STDELE_INP
#   plotORBCMPmap > %%%%%%%% <    : Plot a map with residuals from ORBCMP      # PLOT_OMPMAPS_INP
#   plotOGNresi   > %%%%%%%% <    : Plot residuals from an orbit fit by ORBGEN # PLOT_OGNRESI_INP
#   plotELE       > %%%%%%%% <    : Plot dynamical orbit param. from ELE-files # PLOT_ELE_INP
#                                                                              #
# BIAS RELATED PLOTS                                                           #
#   plotGTRA      > %%%%%%%% <    : Plot estimated GTRA parameters             # PLOT_GTRA_INP
#                                                                              #
# CLOCK RELATED PLOTS                                                          #
#   plotGTRA      > %%%%%%%% <    : Plot clock values from clock RINEX files   # PLOT_CLKRNX_INP
#                                                                              #
# OTHER PLOTS                                                                  #
#   plotPole      > %%%%%%%% <    : Plot ERP results                           # PLOT_POLE_INP
#   plotGCC       > %%%%%%%% <    : Plot Geocenter results                     # PLOT_GCC_INP
#                                                                              #
# END_PANEL ####################################################################


