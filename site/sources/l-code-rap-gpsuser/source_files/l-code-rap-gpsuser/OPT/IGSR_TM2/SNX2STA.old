
! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 1  "${P}/EXAMPLE"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${P}/EXAMPLE/GEN/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2022"
  ## widget = comment
  # $Y+0

SES_INFO 1  "3010"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Environment variables
! ---------------------
ENVIRONMENT 12
  "P" "/storage/research/aiub_code"
  "Q" "/storage/research/aiub_code"
  "K" "/storage/research/aiub_u_camp"
  "X" "/storage/research/aiub_data/BSWsoftware/BERN/GPS"
  "U" "/storage/homefs/l_code/GPSUSER"
  "S" "/storage/research/aiub_data/PRODUCTS"
  "G" "/storage/research/aiub_u_camp"
  "USER" "l_code"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  ## widget = initmenu; pointer = ENVIR_LIST

!---------------------------------------------------------------------
! INPUTFILES                                                         |
!---------------------------------------------------------------------
! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

! General Constants
! -----------------
CONST 1  "${MODEL}/CONST.BSW"
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1
  # CONST

DESCR_CONST 1  "General constants"

! Header files for which amb should be checked
! --------------------------------------------
SNXFILE 1  "${P}/EXAMPLE/SOL/EUREF.SNX"
  ## widget = selwin; path = DIR_SNX; ext = EXT_SNX; maxfiles = 1
  # EUREF

DESCR_SNXFILE 1  "SINEX file"

SELFILE 0
  ## widget = selwin; path = DIR_FIX; ext = EXT_FIX; maxfiles = 1
  ## emptyallowed = true

DESCR_SELFILE 1  "Selection file"

!---------------------------------------------------------------------
! OUTPUTFILES                                                        |
!---------------------------------------------------------------------
! Station information file
! ------------------------
STAFILE 1  "${P}/EXAMPLE/STA/EUREF.STA"
  ## widget = lineedit; path = DIR_STA; ext = EXT_STA
  # EUREF

DESCR_STAFILE 1  "Station information file"

! Program Output File
! -------------------
SYSODEF 1  "0"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "${P}/EXAMPLE/OUT/SNX2STA_EUR.OUT"
  ## widget = lineedit; activeif = SYSODEF == 0; path = DIR_OUT
  ## ext = EXT_OUT
  # SNX2STA_EUR

DESCR_SYSOUT 1  "Program output"

! Error Message File
! ------------------
ERRMRG 1  "0"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 1  "${U}/WORK/ERROR.MSG"
  ## widget = lineedit; activeif = ERRMRG == 0; path = PTH_ERR
  ## ext = EXT_ERR
  # ERROR

DESCR_SYSERR 1  "Error message"

! Subroutine/function debug output
! --------------------------------
DEBUG_STKLOG 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_STKLOG 1  "Debug stack log output"

DEBUG_SUMMARY 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_SUMMARY 1  "Debug summary output"

DEBUG_INTERVAL 1  "00 01 00"
  ## widget = lineedit; check_type = time

MSG_DEBUG_INTERVAL 1  "Interval for intermediate debug summary"

! Title line
! ----------
TITLE 1  "EUREF.SNX"
  ## widget = lineedit

MSG_TITLE 1  "Title line"

FLG1 1  "001"
  ## widget = lineedit; check_strlen = 3

MSG_FLG1 1  "TYPE 001: Renaming of stations"

FLG2 1  "001"
  ## widget = lineedit; check_strlen = 3

MSG_FLG2 1  "TYPE 002: Station information"

REDRSN 1  "0"
  ## widget = checkbox

MSG_REDRSN 1  "Disregard receiver serial numbers"

REDASN 1  "0"
  ## widget = checkbox

MSG_REDASN 1  "Disregard antenna serial numbers"

REDARC 1  "0"
  ## widget = checkbox

MSG_REDARC 1  "Disregard antenna radome codes"

! Technique specific output for Type 002
! --------------------------------------
TYP2TECH 1  "GNSS"
  ## widget = combobox; editable = false; cards = GNSS SLR

MSG_TYP2TECH 1  "Technique-specific Type 002"


# BEGIN_PANEL NO_CONDITION #####################################################
# EXTRACT STATION INFORMATION FROM SINEX FILE - SNX2STA 1: Filenames           #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files         > % <                                       # SHOWGEN
#                                                                              #
# INPUT FILES                                                                  #
#   SINEX file                     > %%%%%%%%%%%% <                            # SNXFILE
#   Selection file                 > %%%%%%%%%%%% <                            # SELFILE
#                                                                              #
# RESULT FILE                                                                  #
#   Station information file       > %%%%%%%%%%%% <                            # STAFILE
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output        > % < use SNX2STA.Lnn           or  > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages        > % < merged to program output  or  > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# SNX2STA 1.1: General Files                                                   #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants           > %%%%%%%%%%%% <                               # CONST
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <# CAMPAIGN
#   Selected session              year> %%%% <  session> %%%% <                # YR4_INFO SES_INFO
#   Session table               > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <# SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# SNX2STA 2: Settings                                                          #
#                                                                              #
# TITLE > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE
#                                                                              #
# FLAGS IN STATION INFORMATION FILE                                            #
#   TYPE 001: Renaming of stations       > %%% <                               # FLG1
#   TYPE 002: Station information        > %%% <                               # FLG2
#                                                                              #
# INFORMATION REDUCTION                                                        #
#   Disregard receiver serial numbers    > % <                                 # REDRSN
#   Disregard antenna serial numbers     > % <                                 # REDASN
#   Disregard antenna radome codes       > % <                                 # REDARC
#                                                                              #
# TECHNIQUE-SPECIFIC OUTPUT                                                    #
#   Write TYPE 002 for technique         > %%%% <                              # TYP2TECH
#                                                                              #
# END_PANEL ####################################################################
