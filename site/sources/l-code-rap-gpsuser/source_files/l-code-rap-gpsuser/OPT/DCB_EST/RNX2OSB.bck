
COORD 1  "This panel option has to be present because of a bug in the library"

! Environment Variables
! ---------------------
ENVIRONMENT 1  "" "${}"
  ## widget = initmenu; pointer = ENVIR_LIST

! SOME KEYWORDS FOR AUTOMATIC OUTPUT
! ----------------------------------
CAMPAIGN 1  "./DUMMY"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${PAN}/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "1980"
  ## widget = comment
  # $Y+0

SES_INFO 1  "0060"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Rinex input file
! ----------------
RNXFIL_BSW 0
  ## widget = selwin; path = DIR_RBO; ext = EXT_RBO; emptyallowed = true
  ## maxfiles = 999
  # *_$YYYSS+0

RNXFIL_BSW_TXT_COL_1 1  "RINEX input files"

MSG_RNXFIL_BSW 1  "RINEX files, Bernese internal naming"

RNXFIL_LONG 0
  ## widget = selwin; path = DIR_RXO; ext = EXT_RNX; emptyallowed = true
  ## maxfiles = 999
  # 

RNXFIL_LONG_TXT_COL_1 1  "RINEX input files"

MSG_RNXFIL_LONG 1  "RINEX files, RINEX-3-style naming"

RNXFIL_SHORT 0
  ## widget = selwin; path = DIR_RXO; ext = EXT_RXO; emptyallowed = true
  ## maxfiles = 999
  # 

RNXFIL_SHORT_TXT_COL_1 1  "RINEX input files"

MSG_RNXFIL_SHORT 1  "RINEX files, RINEX-2-style naming"

RNXFIL 0
  ## widget = selwin; path = DIR_RXO; emptyallowed = true; maxfiles = 999
  # 

RNXFIL_TXT_COL_1 1  "RINEX input files"

MSG_RNXFIL 1  "RINEX files, any naming scheme"

! -------------------------------------------------------------------------
! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

! Observation selection by new RECEIVER file
! ------------------------------------------
