# BEGIN_PANEL NO_CONDITION #####################################################
# CODE OBS SYSTEM BIASES FROM RINEX - RNX2OSB 1: Filenames                     #
#                                                                              #
# INPUT FILES                                                                  #
#   RINEX observation files                                                    #
#     Bernese internal naming          > %%%%%%%%%%%%%%%%%% <                  # RNXFIL_BSW
#     RINEX-3-style naming             > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <  # RNXFIL_LONG
#     RINEX-2-style naming             > %%%%%%%% <                            # RNXFIL_SHORT
#     Any naming convention            > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <  # RNXFIL
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files             > % <                                   # SHOWGEN
#   Observation selection              > %%%%%%%%%%%% <  Print selection > % < # OBSSEL PRTOSTAT
#     Caution: - might be necessairy when processing RINEX 2,                  #
#              - eliminates frequencies when processing RINEX 3                #
#                                                                              #
# OUTPUT FILES                                                                 #
#   Normal equation                    > %%%%%%%%%%%% <                        # NEQOUT
#   Observable-specific biases         > %%%%%%%%%%%% <                        # OSBOUT
#   Observable-specific biases (SINEX) > %%%%%%%%%%%% <                        # BIASSNX
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output          > % < use RNX2OSB.Lnn          or > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages          > % < merged to program output or > %%%%%%%%%%%% < # ERRMRG SYSERR
#   Print extended warnings > % <                                              # EXTOUT
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# RNX2OSB 1.1: General Files                                                   #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants          > %%%%%%%%%%%% <                                # CONST
#   Satellite information      > %%%%%%%%%%%% <                                # SATELL
#   Satellite problems         > %%%%%%%%%%%% <                                # SATCRUX
#   SINEX header file          > %%%%%%%%%%%% <                                # SINEXIN
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNX2OSB 2: Processing Options Part I                                         #
#                                                                              #
# TITLE > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE
#                                                                              #
# SATELLITE SYSTEMS                                                            #
#   GPS          > % <      GLONASS     > % <     Galileo      > % <           # USE_G USE_R USE_E
#   SBAS         > % <      BeiDou      > % <     QZSS         > % <           # USE_S USE_C USE_J
#                                                                              #
# STATION NAME TRANSLATION                                                     #
#   Gather station names from           > %%%%%%%%%%%%% <                      # STANAM
#   Station information                 > %%%%%%%%%%%% <                       # STAINFO
#                                                                              #
# PROGRAM OUTPUT OPTIONS                                                       #
#   Show observation type statistics of each satellite         > % <           # SHW_OBSTYPE_STAT
#   Show obs. difference statistics of each station/satellite  > % <           # SHW_OBSDIFF_STAT
#   Show parameters with local constraints                     > % <           # SHW_PARAMS
#   Show zero-mean condition clusters on satellites            > % <           # SHW_SAT_CLUS
#   Show NEQ diagonal and parameter LOCQs                      > % <           # SHW_NEQDIAG_LOCQ
#   Show residuals                                             > % <           # SHW_RESIDUALS
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNX2OSB 3: Processing Options Part II                                        #
#                                                                              #
# OPTIONS                                                                      #
#   Use observation window                    > % <                            # USEWIN
#   Remove sats not defined in sat info file  > % <                            # RM_UNDEF_SATS
#   Minimum nb. of observations (per type)    > %%%%% <                        # MINOBSNB
#   Minimum nb. of stations (per type)        > %%%%% <                        # MINSTNNB
#   A priori sigma of unit weight             > %%%%%%%%% < m                  # SIGMA_0
#   Observation difference weighting          > %%%%%%%%%%%%%%%%%%%%%% <       # OBS_DIFF_WGT
#   Parameter constraining                    > %%%%%%%%% < ns                 # CONSTRAINING
#   Maximal absolute relative residual        > %%%%%%%%% <                    # MAXABSRELRES
#   Nb. outliers removed per iteration        > %%%%% <                        # NBOUTLREM
#   Nb. rel. res. iterations per adj.         > %%%%% <                        # NBRELRESIT
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL USEWIN = 1 #######################################################
# RNX2OSB 3.1: Observation Window                                              #
#                                                                              #
# OBSERVATION WINDOW                                                           #
#                                                                              #
#   > % < Defined by Year and Session identifier                               # RADIO_1
#         Year  > %%%% <   Session > %%%% <                                    # SESSION_YEAR SESSION_STRG
#                                                                              #
#                                                                              #
#   > % < Defined by Start and End times                                       # RADIO_2
#                 yyyy mm dd     hh mm ss           yyyy mm dd     hh mm ss    #
#         Start > %%%%%%%%%% < > %%%%%%%% <   End > %%%%%%%%%% < > %%%%%%%% <  # STADAT STATIM ENDDAT ENDTIM
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNX2OSB 4: Processing Options Part III                                       #
#                                                                              #
# OBSERVATION TYPE HANDLING                                                    #
#   Observation types to be ignored ('x' defines any freq. or type attr.)      #
#   > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # IGNORE_TYPS
#   > % < Still add ignored types to observation type statistics               # ADD_IGNORED_STAT
#   > % < Warn if code and phase observation type appearance mismatch          # WARN_CP_MISMATCH
#                                                                              #
# LOCAL PARAMETER CONSTRAINING (for OSB file only)                             #
#   > % < Use zero-mean conditions                                             # RADIO_ZMC
#   > % < Constrain nominal reference observation types to zero                # RADIO_RTZ
#   Will be applied per system, per station or satellite, per frequency.       #
#                                                                              #
#   Nominal reference observation types ('x' defines any freq. or type attr.)  #
#   > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # NOM_REF_TYPS
#                                                                              #
# INDIVIDUAL RECEIVER OR RECEIVER GROUP ESTIMATIONS                            #
#   > % < Estimate individual receiver groups                                  # EN_EST_RCG
#         > % < Reuse overall screening for receiver groups                    # CPSCR_RCG
#   > % < Estimate individual receivers                                        # EN_EST_RCV
#         > % < Reuse overall screening for receivers                          # CPSCR_RCV
#   > % < Estimate individual stations                                         # EN_EST_STN
#         > % < Reuse overall screening for stations                           # CPSCR_STN
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNX2OSB 5: RINEX options                                                     #
#                                                                              #
# GENERAL RINEX OPTIONS                                                        #
#   Change hdr strings to upper case on read   > % <                           # RDRXHDUC
#   Only GPS/GLO and freq. 1 or 2 for RINEX 2  > % <                           # RX2_RESTR
#   Output errors from input headers           > % <                           # ERRFROMRXHDR
#                                                                              #
# SAMPLING                                                                     #
#   Sampling interval           > %%%%%% < seconds   (0: use all observations) # SAMPLING
#   Offset to full minute       > %%%%%% < seconds                             # OFFSET
#   Sampling tolerance          > %%%%%% < seconds                             # SAMPLTOL
#                                                                              #
# REJECTION OF FAKE OBSERVATIONS                                               #
#   Maximal freq. considered    > %%%%%% <           (0: no rejection)         # REJFAKEOBSMAXFRQ
#   Tolerance                   > %%%%%% <                                     # REJFAKEOBSTOL
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNX2OSB 6: Check Content of RINEX Header                                     #
#                                                                              #
# ACTIONS IN CASE OF INCONSISTENCIES                                           #
#   Station name             > %%%%%%%%% <     Try also filename      > % <    # TSTANAM TRYFILE
#                                                                              #
# ADDITIONAL VERIFICATION                                                      #
#   Verify station name/number using             > % <  > %%%%%%%%%%%%%% <     # DOSTAVER STAVER
#   Verify station name using RINEX filename     > % <                         # RNXVER
#                                                                              #
# Action if marker name doesn't match file name  > %%%%%%%%% <                 # AOF_ANT_MRK_NAM
#                                                                              #
# ACTIONS IN CASE OF MISSING MANDATORY HEADER RECORDS                          #
#   Missing record: GLONASS SLOT / FRQ # > %%%%%%%%% <  (RINEX vers ge 3.01)   # AOM_GLO_FRQ_NBR
#   Missing record: GLONASS COD/PHS/BIS  > %%%%%%%%% <  (RINEX vers ge 3.02)   # AOM_GLO_PHS_BIS
#   Missing record: SYS / PHASE SHIFT    > %%%%%%%%% <  (RINEX vers ge 2.12)   # AOM_SYS_PHS
#   Other missing mandatory records      > %%%%%%%%% <                         # AOM_GENERAL
#                                                                              #
# ACTIONS IN SPECIAL SITUATIONS BETWEEN OBSERVATIONS                           #
#   On epoch events                      > %%%%%%%%% <                         # EPOFLAG
#   On inconsistent header modifications > %%%%%%%%% <                         # AOI_HDRMOD
#                                                                              #
#     NONE@@@@: Just continue                                                  #
#     WARNING@: Write warning and continue                                     #
#     SKIP@@@@: Skip file and continue with next file                          #
#     ERROR@@@: Write error message and stop processing                        #
#                                                                              #
# END_PANEL ####################################################################
