NEQOUT 1  "./DUMMY/SOL/$H800060.NQ0"
  ## widget = lineedit; path = DIR_NEQ; ext = EXT_NEQ; emptyallowed = true
  # $H$YSS+0

DESCR_NEQOUT 1  "NEQ output file"

! Observable-specific bias output file
! ------------------------------------
OSBOUT 1  "./DUMMY/ORB/$H800060.OSB"
  ## widget = lineedit; path = DIR_OSB; ext = EXT_OSB; emptyallowed = true
  # $H$YSS+0

DESCR_OSBOUT 1  "OSB output file"

! Observable-specific bias SINEX output file
! ------------------------------------------
BIASSNX 1  "./DUMMY/ORB/$H800060.BIA"
  ## widget = lineedit; path = DIR_BIA; ext = EXT_BIA
  # $H$YSS+0

DESCR_BIASSNX 1  "OSB SINEX output file"

! Program Output File
! -------------------
SYSODEF 1  "0"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "./DUMMY/OUT/RNX2OSB_0060.OUT"
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false
  # RNX2OSB_$S+0

DESCR_SYSOUT 1  "Program output"

NOMSGDATE 0

MSG_NOMSGDATE 1  "Suppress writing of message timestamp"

! Error Message File
! ------------------
ERRMRG 1  "1"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 0
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false
  # ERROR

DESCR_SYSERR 1  "Error message"

! Print extended OBSSEL warnings (debugging)
