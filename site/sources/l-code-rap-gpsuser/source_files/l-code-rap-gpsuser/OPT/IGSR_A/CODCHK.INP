CAMPAIGN 1  "${P}/EXAMPLE"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${P}/EXAMPLE/GEN/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2022"
  ## widget = comment
  # $Y+0

SES_INFO 1  "3010"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Environment variables
! ---------------------
ENVIRONMENT 12
  "P" "/storage/research/aiub_code"
  "Q" "/storage/research/aiub_code"
  "K" "/storage/research/aiub_u_camp"
  "X" "/storage/research/aiub_data/BSWsoftware/BERN/GPS"
  "U" "/storage/homefs/l_code/GPSUSER"
  "S" "/storage/research/aiub_data/PRODUCTS"
  "G" "/storage/research/aiub_u_camp"
  "USER" "l_code"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  ## widget = initmenu; pointer = ENVIR_LIST

! --------------------------------------------------------------------
! INPUTFILES                                                         |
! --------------------------------------------------------------------
! General constants
! -----------------
SHOWGEN 1  "0"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

CONST 1  "CONST."
  ## widget = selwin; path = PTH_GEN; ext = NO_EXT; maxfiles = 1

DESCR_CONST 1  "General constants"

! Input files
! ------------
OBSFIL 0
  ## widget = selwin; path = DIR_CZH; ext = EXT_CZH
  # ????$S+0

MSG_OBSFIL 1  "Code files"

OBSFIL_EXT_COL_2 1  "CZO"
  ## widget = initmenu; pointer = EXT_CZO

OBSFIL_PTH_COL_2 1  "${P}/EXAMPLE/OBS/"
  ## widget = initmenu; pointer = DIR_CZO

OBSFIL_TXT_COL_1 1  "Code header files"

OBSFIL_TXT_COL_2 1  "Code observation files"

! Program output file
! -------------------
SYSODEF 1  "0"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "${P}/EXAMPLE/OUT/CODCHK.OUT"
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false
  # CODCHK

DESCR_SYSOUT 1  "Program output"

! Error message file
! ------------------
ERRMRG 1  "0"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 1  "${U}/WORK/ERROR.MSG"
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false
  # ERROR

DESCR_SYSERR 1  "Error message"

! Title
! -----
TITLE 1  "Specify a title for the CODCHK program run"
  ## widget = lineedit

MSG_TITLE 1  "Title line"

! Observation flags
! -----------------
USEFLG 1  "0"
  ## widget = checkbox

MSG_USEFLG 1  "Use flags in files"

SAVFLG 1  "0"
  ## widget = checkbox

MSG_SAVFLG 1  "Save flags in files"

! Polynomial Screening
! --------------------
EXTINF 1  "0"
  ## widget = checkbox

MSG_EXTINF 1  "Print extended info"

POLDEG 1  "2"
  ## widget = spinbox; range = 1 10 1; check_type = integer; check_min = 1

MSG_POLDEG 1  "Polynomial degree"

FITINT 1  "3"
  ## widget = lineedit; emptyallowed = false; check_type = integer
  ## check_min = 1

MSG_FITINT 1  "Maximum fit interval"

! Rms of code observation
! -----------------------
OBSRMS 1  "20.000"
  ## widget = lineedit; emptyallowed = false; check_type = real

MSG_OBSRMS 1  "Rms of code observations"


# BEGIN_PANEL NO_CONDITION #####################################################
# CODCHK 1: Code Check                                                         #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files  > % <                                              # SHOWGEN
#                                                                              #
# INPUT FILENAMES                                                              #
#   Code files              > %%%%%%%% <                                       # OBSFIL
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output          > % < use CODCHK.Lnn            or  > %%%%%%%% <   # SYSODEF SYSOUT
#   Error messages          > % < merged to program output  or  > %%%%%%%% <   # ERRMRG SYSERR
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# CODCHK 1.1: General files                                                    #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants       > %%%%%%%%%%%% <                                   # CONST
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CODCHK 2: Processing Options                                                 #
#                                                                              #
# TITLE  > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <  # TITLE
#                                                                              #
# OBSERVATION FLAGS                                                            #
#   Use flags in files         > % <                                           # USEFLG
#   Save flags in files        > % <                                           # SAVFLG
#                                                                              #
# POLYNOMIAL SCREENING                                                         #
#   Print extended info        > % <                                           # EXTINF
#   Polynomial degree          > %% <                                          # POLDEG
#   Maximum fit interval       > %% <       minutes                            # FITINT
#                                                                              #
# RMS OF CODE OBSERVATION                                                      #
#   Rms of code observations   > %%%%%% <   meters                             # OBSRMS
# END_PANEL ####################################################################
