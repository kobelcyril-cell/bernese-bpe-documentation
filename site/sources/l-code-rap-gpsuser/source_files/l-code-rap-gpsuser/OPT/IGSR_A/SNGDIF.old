! ----------------------------------
AMBMRG 1  "0"
  ## widget = checkbox

MSG_AMBMRG 1  "Merge ambiguities from input files"

! New ambiguity after a gap
! ---------------------------
AMBDT 1  "20"
  ## widget = lineedit; check_type = integer; check_min = 0
  ## activeif = AMBMRG = 0

MSG_AMBDT 1  "After a gap in the observations larger than"

