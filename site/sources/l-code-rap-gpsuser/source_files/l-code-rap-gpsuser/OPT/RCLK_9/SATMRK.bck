DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2023"
  ## widget = comment
  # $Y+0

SES_INFO 1  "3640"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

! General Constants
! -----------------
CONST 1  "${MODEL}/CONST.BSW"
