
! Environment Variables
! ---------------------
ENVIRONMENT     1  "" ""
  ## widget = initmenu; pointer = ENVIR_LIST

! Some keywords for automatic output
! ----------------------------------
CAMPAIGN     0
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE     1  "SESSIONS"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO     1  "$Y+0"
  ## widget = comment

SES_INFO     1  "$S+0"
  ## widget = comment

USR_INFO     1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN     1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show general configuration"

! Filename for resulting plots (output)
! -------------------------------------
FIGSHOW     1  "0"
  ## widget = checkbox

MSG_FIGSHOW 1  "Show resulting firgure on the screen"

FIGOUT     1  "meantec.eps"
  ## widget = lineedit; path = DIR_FIG; ext = NO_EXT; maxfiles = 1

DESCR_FIGOUT 1  "Output file for plot of number of epochs"

FIGRES     1  "300"
  ## widget = lineedit; check_type = integer; check_min = 50

DESCR_FIGRES 1  "Resolution of the figure"

! Input data: MENTEC plot/summary files
! -------------------------------------
MEANTEC 1 "MEANTEC.SUM"
  ## widget = selwin; path = DIR_SUM; extList = EXT_SUM
  # SELECTED

MSG_MEANTEC 1  "MEANTEC plot file"

! Options for the MEANTEC curve
! -----------------------------
COLOR     1  "red"
  ## widget = combobox; editable = true
  ## cards = red green blue yellow orange magenta cyan grey

MSG_COLOR 1  "Color for the MEANTEC line"

WIDTH     1  "1"
  ## widget = spinbox; range = 1 20 1

MSG_WIDTH 1  "Line width for the plot"

! Title: new entry
! ----------------
TITLE     0
  ## widget = lineedit

MSG_TITLE 1  "Title line"

TIT_FONTSIZE     1  "large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_TIT_FONTSIZE 1  "Font size in the title"

! Size of the plot
! ----------------
SIZEX     1  "8"
  ## widget = lineedit; check_type = real

MSG_SIZEX 1  "Width of the plot"

SIZEY     1  "4.5"
  ## widget = lineedit; check_type = real

MSG_SIZEY 1  "Height of the plot"

! Get boundaries of the plot
! --------------------------
XYAUTO     1  "1"
  ## widget = checkbox

MSG_XYAUTO 1  "Auto scale to a global map"

TMIN     0
  ## widget = lineedit; check_type = date; activeif = XYAUTO / 1

MSG_TMIN 1  "Latitude of the lower left corner"

YMIN     0
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_YMIN 1  "Longitude of the lower left corner"

TMAX     0
  ## widget = lineedit; check_type = date; activeif = XYAUTO / 1

MSG_TMAX 1  "Latitude of the upper right corner"

YMAX     0
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_YMAX 1  "Longitude of the upper right corner"

LABEL_X     1  "Epoch"
  ## widget = lineedit

MSG_LABEL_X 1  "Label for the time axis"

LABEL_Y     1  "Mean TEC (TECU)"
  ## widget = lineedit

MSG_LABEL_Y 1  "Label for the data axis"

LABEL_FONTSIZE     1  "large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_LABEL_FONTSIZE 1  "Font size in the labels"

BGCOLOR     1  "white"
  ## widget = combobox; editable = true
  ## cards = white red green blue yellow orange magenta cyan grey

MSG_BGCOLOR 1  "Plot background color"



! Program Output File
! -------------------
SYSODEF     1  "1"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT     1  ""
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false

DESCR_SYSOUT 1  "Program output"

! Error Message File
! ------------------
ERRMRG     1  "0"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR     1  "ERROR"
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false

DESCR_SYSERR 1  "Error message"


# BEGIN_PANEL NO_CONDITION #####################################################
# PLOT MEANTEC FROM IONANA SUMMARY FILE - plotMeantec 1: Input/output files    #
#                                                                              #
# GENERAL CONFIGURATION                                                        #
#   Show general configuration        > % <                                    # SHOWGEN
#                                                                              #
# INPUT FILES                                                                  #
#   Meantec plot file                 > %%%%%%%%%%%% <    (Summary from IONANA)# MEANTEC
#                                                                              #
# RESULT FILE                                                                  #
#   Show figure on the screen         > % <                                    # FIGSHOW
#   Name of the output file           > %%%%%%%%%%%%%%%%%%%%%%%% <             # FIGOUT
#                                       (extension defines the format)         #
#   Resolution of the figure          > %%%% < dpi                             # FIGRES
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# plotMeantec 1.1: General Configuration                                       #
#                                                                              #
# FONT DEFITIONS                                                               #
#   Title                   > %%%%%%%%%%%% <                                   # TIT_FONTSIZE
#   Labels                  > %%%%%%%%%%%% <                                   # LABEL_FONTSIZE
#                                                                              #
# COLOR DEFITIONS                                                              #
#   Background color of the plot> %%%%%%%%%%%% <                               # BGCOLOR
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotMeantec 2: Plot layout                                                   #
#                                                                              #
# PLOT LAYOUT SPECIFICATION                                                    #
#   Size of the plot:   width   > %%%%%%%%%% <    height     > %%%%%%%%%% <    # SIZEX SIZEY
#                                                                              #
#   Boundaries: > % < auto or            epoch axis             data axis      # XYAUTO
#                          lower bound  > %%%%%%%%%% <        > %%%%%%%% <     # TMIN YMIN
#                          upper bound  > %%%%%%%%%% <        > %%%%%%%% <     # TMAX YMAX
#                                        (yyyy mm dd)                          #
#                                                                              #
#   Labels at  epoch axis  > %%%%%%%%%%%%%%%%%%%%% <                           # LABEL_X
#              data  axis  > %%%%%%%%%%%%%%%%%%%%% <                           # LABEL_Y
#                                                                              #
# CONTENT OF THE PLOT                                                          #
#   Title > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#                                                                              #
#   Color > %%%%%%%% <          Line width > %%% <                             # COLOR WIDTH
#                                                                              #
# END_PANEL ####################################################################
