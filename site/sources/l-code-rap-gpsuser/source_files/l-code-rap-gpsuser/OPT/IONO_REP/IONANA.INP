# BEGIN_PANEL NO_CONDITION #####################################################
# ANALYZE GLOBAL IONOSPHERE MODELS - IONANA 1: Filenames                       #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants      > %%%%%%%%%%%% <                                    # CONST
#   IONEX control file     > %%%%%%%%%%%% <                                    # IONEXCF
#                                                                              #
# INPUT FILES                                                                  #
#   Ionosphere maps        > %%%%%%%%%%%% <                                    # IONINP
#                                                                              #
# RESULT FILES                                                                 #
#   Ionosphere map         > %%%%%%%%%%%% <                                    # IONOUT
#   TEC data               > %%%%%%%%%%%% <                                    # DATOUT
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output  > % < use IONANA.Lnn            or > %%%%%%%%%%%% <        # SYSODEF SYSOUT
#   Error message   > % < merged to program output  or > %%%%%%%%%%%% <        # ERRMRG SYSERR
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# IONANA 2: General Options                                                    #
#                                                                              #
# TITLE > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE
#                                                                              #
# GENERAL PROCESSING OPTIONS                                                   #
#   Processing mode                     > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # PRCMOD
#   File-specific averaging of ION data > % <                                  # FILAVG
#                                                                              #
# GRAPHIC OUTPUT                        > % <                                  # GRAOUT
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL PRCMOD = COEFFICIENT-SPECIFIC_ANALYSIS ###########################
# IONANA 3: Coefficient-specific Analysis                                      #
#                                                                              #
# COEFFICIENT SELECTION                                                        #
#   Degree of coefficient                 > %%% <                              # DEGCOE
#   Order@@of coefficient                 > %%% <                              # ORDCOE
#   Analyse selected coefficient only     > % <                                # ONECOE
#                                                                              #
# ADDITIONAL TASKS                                                             #
#   Find maximum TEC                      > % <                                # MAXTEC
#   Find minimum TEC                      > % <                                # MINTEC
#   Analyze estimated single-layer heights> % <                                # SLHGT
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL PRCMOD / TEC_PROFILES ############################################
# IONANA 4: Ionosphere Prediciton                                              #
#                                                                              #
# OPTIONS FOR IONOSPHERE PREDICTION                                            #
#   Model number for predicted information      > %%%% <                       # MODNUM
#   Prediction length                           > %%%%%%%%% < days             # PRDLEN
#   Time interval used for actual prediction    > %%%%%%%%% < days             # PRDINT
#   Factor for noise component                  > %%%%%%%%% <                  # FACNOI
#   Parameter smoothing length                  > %%%%%%%%% < days             # SMTPAR
#   Smoothed auto-correlation function (ACF)    > % <                          # ACFSMT
#   Drift parameter to be set up                > % <                          # DRIFT
#   Amplitudes varying as solar cycle           > % <                          # SOLCYC
#                                                                              #
# > Periods_to_be_considered_(days)       <                                    # PERIOD
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL GRAOUT = 1 AND PRCMOD / IONOSPHERE_PREDICTION ####################
# IONANA 5.1: Graphic Options                                                  #
#                                                                              #
# GRAPHICS OF                                                                  #
#   Smoothed@@time series  > %%%%%%%%%%%% <   Original ACF > %%%%%%%%%%%% <    # SMTSER SMTACF
#   Predicted time series  > %%%%%%%%%%%% <   Smoothed ACF > %%%%%%%%%%%% <    # PRESER PREACF
#   TEC profiles           > %%%%%%%%%%%% <                                    # TECPLT
#                                                                              #
# GENERAL OPTIONS                                                              #
#   Factor for confidence bands       > %%%%%%%%% <                            # FACBND
#                                                                              #
# GRAPHICS LAYOUT                                                              #
#   Automatic numeric labels          > % <                                    # AUTOLBL
#   Print username/date/time          > % <                                    # PRINAM
#   Create flat graphics              > % <                                    # FLTGRA
#   White background (for gif files)  > % <                                    # WHITEBG
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL GRAOUT = 1 AND PRCMOD = COEFFICIENT-SPECIFIC_ANALYSIS ############
# IONANA 5.2: Graphic Options for Coefficient-specific Analysis                #
#                                                                              #
# GENERAL OPTIONS                                                              #
#   Confidence band for deterministic component      > % <                     # CONFDET
#   Confidence band for stochastic @@@component      > % <                     # CONFSTO
#   No data points plotted                           > % <                     # NODATA
#   Time argument in years                           > % <                     # TIMEYR
#                                                                              #
# RANGE DEFINITONS                                                             #
#   Prediction of deterministic component plotted for> %%%%%%%%% < days        # DETLEN
#   Maximum lag for ACF plot                         > %%%%%%%%% < days        # ACFLAG
# END_PANEL ####################################################################


# BEGIN_PANEL GRAOUT = 1 AND PRCMOD = TEC_PROFILES #############################
# IONANA 5.3: Graphic Options for TEC Profiles                                 #
#                                                                              #
# TEC PROFILE DEFINITION                                                       #
#   Latitude                                    > %%%%%%%%% < deg              # LATIT
#   Longitude                                   > %%%%%%%%% < deg              # LONGI
#   Universal time                              > %%%%%%%%% < hours            # UTIME
#                                                                              #
# GENERAL OPTIONS                                                              #
#   Averaged TEC profile                        > % <                          # AVGTEC
#   Day-to-day scattering                       > % <                          # SCATTER
#   Daily TEC samples                           > % <                          # DAYTEC
#   Universal time instead of local time        > % <                          # NOLOCTIM
#   Local time monitored for maximum/minimum TEC> % <                          # LOCAL
#   Percentage line separated                   > % <                          # PRCLINE
#   Percentage line every X %                   > %%%% < %                     # LINDIST
#                                                                              #
# RANGE DEFINITON                                                              #
#   Maximum TEC for graphic output              > %%%%%%%%% < TECU             # MAXPLT
#                                                                              #
# END_PANEL ####################################################################
