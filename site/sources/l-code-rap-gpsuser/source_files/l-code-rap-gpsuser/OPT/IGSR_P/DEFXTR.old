
! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 1  "${P}/EPNFINAL"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${P}/EPNFINAL/GEN/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2025"
  ## widget = comment
  # $Y+0

SES_INFO 1  "2350"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Environment variables!
! ---------------------
ENVIRONMENT 13
  "P" "/storage/research/aiub_code"
  "Q" "/storage/research/aiub_code"
  "K" "/storage/research/aiub_u_camp"
  "X" "/storage/research/aiub_data/BSWsoftware/BERN/GPS"
  "U" "/storage/homefs/l_code/GPSUSER"
  "S" "/storage/research/aiub_data/PRODUCTS"
  "G" "/storage/research/aiub_u_camp"
  "R" "/storage/scratch/aiub/camp"
  "USER" "l_code"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  ## widget = initmenu; pointer = ENVIR_LIST

! General Constants
! -----------------
SHOWGEN 1  "0"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

CONST 1  "${MODEL}/CONST.BSW"
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1
  # CONST

DESCR_CONST 1  "General constants"

! Satellite Problems
! ------------------
SATCRUX 1  "${CONFIG}/SAT_2025.CRX"
  ## widget = selwin; path = PTH_SATCRUX; ext = EXT_SATCRUX; maxfiles = 1
  # SAT_$Y+0

DESCR_SATCRUX 1  "Satellite problems"

! Input Files
! ------------
RADIO_1 1  "1"
  ## widget = radiobutton; group = DUMMY; radiokeys = JOBOUT

MSG_RADIO_1 1  "Input files"

RADIO_2 1  "0"
  ## widget = radiobutton; group = DUMMY; radiokeys = OUTPUT

MSG_RADIO_2 1  "Input files"

OUTPUT 0
  ## widget = selwin; path = DIR_OUT; ext = EXT_OUT; maxfiles = 1
  ## emptyallowed = true

DESCR_OUTPUT 1  "Input Filenames (OUT)"

JOBOUT 1  "${P}/EPNFINAL/OUT/ORBGEN.L02"
  ## widget = selwin; path = DIR_OUT; ext = NO_EXT; maxfiles = 1
  ## emptyallowed = true
  # ORBGEN.L02

DESCR_JOBOUT 1  "Input Filenames (JOB)"

! Output Summary
! --------------
OUTFIL 1  "${P}/EPNFINAL/OUT/DEFXTR.SUM"
  ## widget = lineedit; path = DIR_SUM; ext = EXT_SUM
  # DEFXTR

DESCR_OUTFIL 1  "Output summary"

! Weekly Summ. Form
! -----------------
WEEKFM 1  "${P}/EPNFINAL/OUT/DEFWKS.SUM"
  ## widget = lineedit; path = DIR_SUM; ext = EXT_SUM
  # DEFWKS

DESCR_WEEKFM 1  "Weekly summary form"

! Split Arc Info
! --------------
ASPLIT 0
  ## widget = lineedit; path = DIR_SUM; ext = EXT_SUM

DESCR_ASPLIT 1  "Split arc info"

! Program Output File
! -------------------
SYSODEF 1  "1"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "${P}/EPNFINAL/OUT/DEFXTR.L21"
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false
  # ${P}/IGSRAPID/OUT/DEFXTR

DESCR_SYSOUT 1  "Program output"

! Error Message File
! ------------------
ERRMRG 1  "0"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 1  "${U}/WORK/ERROR.MSG"
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false
  # ERROR

DESCR_SYSERR 1  "Error message"

! Subroutine/function debug output
! --------------------------------
DEBUG_STKLOG 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_STKLOG 1  "Debug stack log output"

DEBUG_SUMMARY 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_SUMMARY 1  "Debug summary output"

DEBUG_INTERVAL 1  "00 01 00"
  ## widget = lineedit; check_type = time

MSG_DEBUG_INTERVAL 1  "Interval for intermediate debug summary"

! Title
! -----
TITLE 1  "Extraction of ORBGEN output file"
  ## widget = lineedit

MSG_TITLE 1  "Title line"

! Quality of orbit fitting
! ------------------------
TOL_RMS 0
  ## widget = lineedit; check_type = real; check_min = 0.0

MSG_TOL_RMS 1  "Maximally tolerated RMS"

! Threshold values for RMS
! ------------------------
USE_G 1  "1"
  ## widget = checkbox

MSG_USE_G 1  "Use GPS"

USE_R 1  "1"
  ## widget = checkbox

MSG_USE_R 1  "Use GLONASS"

USE_E 1  "0"
  ## widget = checkbox

MSG_USE_E 1  "Use Galileo"

USE_S 1  "0"
  ## widget = checkbox

MSG_USE_S 1  "Use SBAS"

USE_C 1  "0"
  ## widget = checkbox

MSG_USE_C 1  "Use BeiDou"

USE_J 1  "0"
  ## widget = checkbox

MSG_USE_J 1  "Use QZSS"

FAC_G 1  "4"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_G = 1

MSG_FAC_G 1  "Factor w.r.t. mean RMS (GPS)"

FAC_R 1  "4"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_R = 1

MSG_FAC_R 1  "Factor w.r.t. mean RMS (GLONASS)"

FAC_E 1  "4"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_E = 1

MSG_FAC_E 1  "Factor w.r.t. mean RMS (Galileo)"

FAC_S 1  "4"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_S = 1

MSG_FAC_S 1  "Factor w.r.t. mean RMS (SBAS)"

FAC_C 1  "4"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_C = 1

MSG_FAC_C 1  "Factor w.r.t. mean RMS (BDS)"

FAC_J 1  "4"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_J = 1

MSG_FAC_J 1  "Factor w.r.t. mean RMS (QZSS)"

LIM_G 1  "0.05"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_G = 1

MSG_LIM_G 1  "Lower limit for RMS (GPS)"

LIM_R 1  "0.10"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_R = 1

MSG_LIM_R 1  "Lower limit for RMS (GLONASS)"

LIM_E 1  "0.10"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_E = 1

MSG_LIM_E 1  "Lower limit for RMS (Galileo)"

LIM_S 1  "1.00"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_S = 1

MSG_LIM_S 1  "Lower limit for RMS (SBAS)"

LIM_C 1  "0.20"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_C = 1

MSG_LIM_C 1  "Lower limit for RMS (BDS)"

LIM_J 1  "0.50"
  ## widget = lineedit; check_type = real; check_min = 0.0
  ## activeif = USE_J = 1

MSG_LIM_J 1  "Lower limit for RMS (QZSS)"


# BEGIN_PANEL NO_CONDITION #####################################################
# EXTRACT ORBGEN PROGRAM OUTPUT - DEFXTR 1: Extractions                        #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files  > % <                                              # SHOWGEN
#                                                                              #
# INPUT FILENAMES                                                              #
#   > % <                   > %%%%%%%%%%%% <                                   # RADIO_1 JOBOUT
#   > % <                   > %%%%%%%%%%%% <                                   # RADIO_2 OUTPUT
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output        > % < use DEFXTR.Lnn            or  > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages        > % < merged to program output  or  > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# TITLE  > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <  # TITLE
#                                                                              #
# OUTPUT FILES                                                                 #
#   Output summary          > %%%%%%%%%%%% <                                   # OUTFIL
#   Weekly summary form     > %%%%%%%%%%%% <                                   # WEEKFM
#   Split arc info          > %%%%%%%%%%%% <  (blank,if no automatic arc split)# ASPLIT
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1  #####################################################
# DEFXTR 1.1: General Files                                                    #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants       > %%%%%%%%%%%% <                                   # CONST
#   Satellite problems      > %%%%%%%%%%%% <                                   # SATCRUX
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL ASPLIT = _   #####################################################
# DEFXTR 2.1: Quality check                                                    #
#                                                                              #
# QUALITY OF ORBIT FITTING                                                     #
#   Maximally tolerated RMS value  > %%%% < meters                             # TOL_RMS
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL ASPLIT / _   #####################################################
# DEFXTR 2.2: Arc split options                                                #
#                                                                              #
# THRESHOLD VALUES FOR RMS (per GNSS):                                         #
#   GNSS       Apply       Factor w.r.t. mean RMS         Lower limit for RMS  #
#   GPS        > % <             > %%%% <                 > %%%% <             # USE_G FAC_G LIM_G
#   GLONASS    > % <             > %%%% <                 > %%%% <             # USE_R FAC_R LIM_R
#   Galileo    > % <             > %%%% <                 > %%%% <             # USE_E FAC_E LIM_E
#   SBAS       > % <             > %%%% <                 > %%%% <             # USE_S FAC_S LIM_S
#   BeiDou     > % <             > %%%% <                 > %%%% <             # USE_C FAC_C LIM_C
#   QZSS       > % <             > %%%% <                 > %%%% <             # USE_J FAC_J LIM_J
#                                                                              #
# END_PANEL ####################################################################
