package IGSR_COP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  IGSR_COP
#
# Purpose :  Copy required files for IGSRPAID
#            Based on BSD script IGSR_COP
#
# Author  :  A. Villiger
# Created :  22-Apr-2020
#
# Changes :  08-Jun-2020 ST: Exclude CCJ2 DoY 160, RINEX header is corrupt.
#            15-Jun-2020 AV: Copy predicted orit if not availalbe in campaign
#            13-Aug-2021 RD: Start using BSW-style filenameing in the campaign area
#            16-Aug-2021 AV: Remove BSW-named RINEX files before copy new data
#            13-Dec-2021 AV: RINEX deletions made in CODE_STA.DEL
#            31-Jan-2022 RD: Extent the deletion of existing RINEX files
#            02-Feb-2022 LP: Extended emergency file list (and added print)
#            09-Feb-2022 ST: Change emergency deletions of ANKR into comments
#                            since CODE_STA.DEL seems to work now.
#            08-Mar-2022 AV: Save disk: yearly subdirectory
#            29-Mar-2022 AV: Use copySkl
#            11-Jan-2024 SS: Remove RXGRssss.SMC
#
# ============================================================================
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ( $yyssss   , $yyddd , $yy, $yyyy, $yyyym3,
       $ddd , $dddm1 , $dddm2 ,
       $ssss, $ssssm1, $ssssm2, $ssssm3, $ssssm4,
       $crdInf, $psdInf, $savDsk,
       $a, $b, $e, $o,
       $extBsl, $extClb, $extClk, $extCrd, $extErp, $extFix, $extIon, $extOsb, $extOut,
       $extPre, $extPsd, $extPsh, $extRxn, $extRxo, $extSmt, $extStd, $extSum, $extSmc,
       $dirBsl, $dirClb, $dirClk, $dirCrd, $dirErp, $dirFix, $dirIon, $dirOsb, $dirOut,
       $dirPre, $dirPsd, $dirPsh, $dirRxn, $dirRxo, $dirSmt, $dirStd, $dirSum, $dirSmc,
       $pthSkl
      ) =
  $bpe->getKeys(
       '$YSS+0'  , '$YD+0', '$Y','$Y+0','$Y-3',
       '$+0', '$-1', '$-2',
       '$S+0','$S-1','$S-2','$S-3','$S-4',
       'V_CRDINF','V_PSDINF','V_SAVDSK',
       'V_A','V_B','V_E','V_O',
       'EXT_BSL', 'EXT_CLB', 'EXT_CLK', 'EXT_CRD', 'EXT_ERP', 'EXT_FIX', 'EXT_ION', 'EXT_OSB', 'EXT_OUT',
       'EXT_PRE', 'EXT_PSD', 'EXT_PSH', 'EXT_RXN', 'EXT_RXO', 'EXT_SMT', 'EXT_STD', 'EXT_SUM', 'EXT_SMC',
       'DIR_BSL', 'DIR_CLB', 'DIR_CLK', 'DIR_CRD', 'DIR_ERP', 'DIR_FIX', 'DIR_ION', 'DIR_OSB', 'DIR_OUT',
       'DIR_PRE', 'DIR_PSD', 'DIR_PSH', 'DIR_RXN', 'DIR_RXO', 'DIR_SMT', 'DIR_STD', 'DIR_SUM', 'DIR_SMC',
       'PTH_SINEXIN'
      );

# Check unusual directories
# -------------------------
  my $mscdir = "$dirOut/../MSC/";
  my $or2dir = "$dirOut/../ORX2/";
  my $ra2dir = "$dirOut/../RAW2/";
  check_dir($mscdir);
  check_dir($or2dir);
  check_dir($ra2dir);

# Prepare reference files
# -----------------------
  my $psdFil = $psdInf eq ""? "":"${psdInf}.${extPsd}";
  system("$ENV{AUTO}/copyRef.pl ${dirCrd}/.. $crdInf $psdFil REF$yyssss");
  print "Execute $ENV{AUTO}/copySkl.pl IGSRAPID $pthSkl\n";
  system("$ENV{AUTO}/copySkl.pl IGSRAPID $pthSkl");

# Prepare troposphere files
# -------------------------
  my $sav_trpFix = "$ENV{REF}/VLBI_TROPO.FIX";
  my $trg_trpFix = "${dirFix}/VLBI_TROPO.${extFix}";
  copyfile($sav_trpFix,$trg_trpFix);

# Prepare OSB file
# ----------------
  my $sav_osbFil = "${dirOsb}/CODE.${extOsb}";
  my $trg_osbFil = "${dirOsb}/APR${yyddd}.${extOsb}";
  copyfile($sav_osbFil, $trg_osbFil);

# Prepair ERP file
# ----------------
  my $sav_rapErp = "${dirErp}/RAP_${yyyy}.${extErp}";
  my $trg_rapErp = "${dirErp}/RAP${yyddd}.${extErp}";
  copyfile($sav_rapErp, $trg_rapErp);

  # Prepair predicted orbit
  # -----------------------
  my $rapSav = "${PATH_SAV}${CAMP_SAVRAP}/${yyyy}/";
  my $orbSav = "${rapSav}ORB/";

  my $sav_prdPre = "$orbSav/RP_${yyddd}.${extPre}.Z";
  my $trg_prdErp = "${dirErp}/${o}_${yyddd}.${extErp}";
  my $trg_prdPre = "${dirPre}/${o}_${yyddd}.${extPre}";
  print "$sav_prdPre trg_prdErp $trg_prdPre\n";
  if( ! -e $trg_prdPre){
    copyfile($sav_prdPre, "${trg_prdPre}.Z");
    system("gzip -df ${trg_prdPre}.Z");
    copyfile($trg_rapErp, $trg_prdErp);
  }

# Copy from savedisk if indicated
# -------------------------------
  if($savDsk eq "Y"){
    my $sav_ionFil = "$PATH_SAV/$CAMP_SAVRAP/${yyyy}/ATM/RA_${yyddd}.ION";
    my $trg_ionFil = "${dirIon}/RA_${yyddd}.${extIon}";
    copyfile($sav_ionFil,$trg_ionFil);
    my $sav_preFil = "$PATH_SAV/$CAMP_SAVRAP/${yyyy}/ORB/RQ_${yyddd}.PRE.Z";
    my $trg_preFil = "${dirPre}/RP_${yyddd}.${extPre}.Z";
    copyfile($sav_preFil,$trg_preFil);
    system("gzip -df $trg_preFil");
    my $sav_erpFil = "$PATH_SAV/$CAMP_SAVRAP/{$yyyy}/ORB/RQ_${yyddd}.ERP";
    my $trg_erpFil = "${dirErp}/RP_${yyddd}.${extErp}";
    copyfile($sav_erpFil,$trg_erpFil);
    my $sav_bulErp = "$ENV{REF}/BULLET_A.ERP";
    my $trg_bulErp = "${dirErp}/CODE${ssss}.${extErp}";
    copyfile($sav_bulErp,$trg_bulErp);
  }

# Ultra file
# ----------
  my $ultFil = "${dirPre}/../MSC/ULT${yyddd}.FLG";
  unlink $ultFil;

# Clear campaign
# --------------
  unlink glob "${dirPsh}/????${ddd}?.???*";
  unlink glob "${dirRxo}/????${ddd}?.???*";
  unlink glob "${dirRxo}/?????????_${yyyy}${ddd}?.RXO*";

  my $dirOrx  = "${dirRxo}/../ORX/";
  unlink glob "${dirOrx}/????${ddd}?.???*";                      # Nav./obs. RINEX2
  unlink glob "${dirOrx}/?????????_?_${yyyy}${ddd}????_*.rnx";   # Nav./obs. RINEX3
  unlink glob "${dirOrx}/?????????_${yyyy}${ddd}?.RXO*";         # Obs. BSW-naming
  unlink glob "${dirOrx}/?????????_${yyyy}${ddd}?.RXN*";         # Nav. BSW-naming

  my $dirOrx2 = "${dirRxo}/../ORX2/";
  unlink glob "${dirOrx2}/????${ddd}?.???*";                     # Nav./obs. RINEX2
  unlink glob "${dirOrx2}/?????????_?_${yyyy}${ddd}????_*.rnx";  # Nav./obs. RINEX3
  unlink glob "${dirOrx2}/?????????_${yyyy}${ddd}?.RXO*";        # Obs. BSW-naming
  unlink glob "${dirOrx2}/?????????_${yyyy}${ddd}?.RXN*";        # Nav. BSW-naming

# Copy RINEX data into campaign
# -----------------------------
  system("$ENV{AUTO}/put_igsdata.com $yy $ddd -o $dirRxo RAP 120 -c=80 -r --bsw");
  system("$ENV{AUTO}/put_igsdata.com $yy $ddd -n $dirRxo");
  system("$ENV{AUTO}/put_igsdata.com $yy $ddd -m $dirOrx2 -r -s --bsw");
  my @navFil = glob "${dirRxo}????${ssss}.{$yy}N";
  map {copyfile($_, "$dirOrx/")} @navFil;

# Clear files from previous runs
# ------------------------------
# Remove lock files
  unlink glob "$dirOut/*.J_lk";
# Remove old RINEX data
  unlink glob "$dirRxo/????$ssssm3.*";
  unlink glob "$dirRxo/????$ssssm2.*";
  unlink glob "$dirSmt/????$ssss.$extSmt";
# Remove stuff in ORX
  unlink glob "${dirOrx}/????${ssssm3}.*";
  unlink glob "${dirOrx}/?????????_${yyyym3}${ssssm3}.*";
# Remove bernese observation files
  unlink glob "${dirPsh}/????${ssss}.*";
####  unlink glob "${dirPsh}/????${ssssm4}.*";
# Remove old orbits
  unlink glob "${dirPre}/${a}0${yyddd}.$extPre";
  unlink glob "${dirClk}/${a}0${yyddd}.$extClk";
# Remove clock rapid
  unlink glob "${dirStd}/${b}_${yyddd}.$extStd";
  unlink glob "${dirStd}/${e}_${yyddd}.$extStd";
# Remove other files
  unlink glob "${dirOut}/RAP${yyddd}.PRC";
  unlink glob "${dirOut}/*${ddd}{W,N,Q,0}.$extOut";
  unlink glob "${dirOut}/*.${ddd}";
  unlink glob "${dirOut}/RESCHK.${yy}_${ssss}";
  unlink glob "${dirOut}/RESRMS.${yy}_${ssss}";
  unlink glob "${dirOut}/RNXERR.${yy}_${ssss}";
  unlink glob "${dirOut}/FTP${yy}${ddd}.${extSum}";
  unlink glob "${dirClb}/${yyddd}*.$extClb";
  unlink glob "${dirOut}/CODXTR.${yy}_${ssss}";
  unlink glob "${dirOut}/MPRXTR.${yy}_${ssss}";
  unlink glob "${dirOut}/MPRDEL.${ddd}";
  unlink glob "${dirSum}/{MWW,MWN,QIF}${yyddd}.$extSum";
  unlink glob "${dirBsl}/APR${yyddd}.${extBsl}";
  unlink glob "${dirBsl}/../MSC/${yyddd}.CHK";
  unlink glob "${dirSmc}/RXGR${ssss}.${extSmc}";
# General files
  unlink glob "${dirOut}/MAUPRP.L*";
# Minus 1
  unlink glob "${dirOut}/${yy}${dddm1}?.$dirOut";
  unlink glob "${dirOut}/*.${dddm1}";
# Minus 2
  unlink glob "${dirOut}/*${dddm2}?*.$dirOut";

################################################################################
# RINEX exclusions (for emergency reasons only, if CODE_STA.DEL fails)                                                            #
################################################################################

  my   @delFils;
#  push(@delFils,  glob "${dirOrx}ANKR3[23]??.21O");
#  push(@delFils,  glob "${dirOrx}ANKR?????_20213[23]??.RXO");
#  push(@delFils,  glob "${dirOrx}ANKR????.22O");
#  push(@delFils,  glob "${dirOrx}ANKR?????_2022????.RXO");
#  push(@delFils,  glob "${dirOrx2}ANKR3[23]??.21O");
#  push(@delFils,  glob "${dirOrx2}ANKR?????_20213[23]??.RXO");
#  push(@delFils,  glob "${dirOrx2}ANKR????.22O");
#  push(@delFils,  glob "${dirOrx2}ANKR?????_2022????.RXO");
#  push(@delFils,  glob "${dirRxo}ANKR3[23]??.21O");
#  push(@delFils,  glob "${dirRxo}ANKR?????_20213[23]??.RXO");
#  push(@delFils,  glob "${dirRxo}ANKR????.22O");
#  push(@delFils,  glob "${dirRxo}ANKR?????_2022????.RXO");
  foreach my $delFile (@delFils){
      unlink $delFile;
      print "### Emergency delete file $delFile \n";
  }

  if ($yyddd eq "26246" || $yyddd eq "26247") {
    `echo 'G19' > ${dirOut}/../MSC/REPOSITIONING.FLG`;
  }

}

__END__
