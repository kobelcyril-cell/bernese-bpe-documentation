package GPSXTR;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GPSXTR
#
# Purpose :  Generate summary of the paralel GPSEST runs
#
# Programs:  GPSXTR
#
# Author  :  M. Meindl
# Created :  03-Aug-2003               Last modified: 10-Feb-2005
#
# Changes :  10-Feb-2005 mm: Old date variables removed
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($ddd,$sumDir,$outDir) = $bpe->getKeys('$+0',"DIR_SUM","DIR_OUT");


# Delete old output files
# -----------------------
  unlink("${sumDir}GPSXTR.SUM");
  unlink("${sumDir}GPSCMP.SUM");
  unlink("${sumDir}GPSWKS.SUM");


# Run program
# -----------
  my $PGMNAM = "GPSXTR";
  $bpe->RUN_PGMS($PGMNAM);


# Summary of program run for protocol
# -----------------------------------
  appFile("",0,"${sumDir}GPSXTR.SUM","${outDir}GPSXTR.${ddd}",0);
  appFile("",0,"${sumDir}GPSCMP.SUM","${outDir}GPSCMP.${ddd}",0);
  appFile("",0,"${sumDir}GPSWKS.SUM","${outDir}GPSWKS.${ddd}",0);


}
