package VERI_ERP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  VERI_ERP
#
# Purpose :  Verification of RAPyyddd.ERP (i.e. RAP_yyyy.ERP)
#
# Programs:
#
# Author  :  S. Schaer
# Created :  10-Mar-2015
#
# Changes :  08-Aug-2019 AV: Adapted time sring for ERP V1.00
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use igs_device;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd,
      $pcfFil, $taskId,
      $dirOut, $dirErp, $extErp) =
    $bpe->getKeys('$YD+0',
                  'PCFFIL', 'TASKID',
                  'DIR_OUT', 'DIR_ERP', 'EXT_ERP');

# Set variables
# -------------
  $pcfFil = (split('\.',$pcfFil))[0];
  my $ultFil = "${dirOut}../MSC/ULT${yyddd}.FLG";
  $pcfFil = "IGSULTRA" if -e $ultFil;

# Verify whether RAPyyddd.ERP complete
# ------------------------------------
  my $fil = "${dirErp}RAP${yyddd}.${extErp}";
  my $linlst = `tail -1 $fil`;
  chomp($linlst);
  my $epolst = substr($linlst,0,10);

# Define required last date (relative to yyddd)
  my $dmax = +13;
  my $dmin = $dmax;
  my $n=0;
  my ($i,$epo,$ok,$lin);
  for ($i=0;$i<=$dmax;$i++) {
    $epo = gps_date("-yd $yyddd -d $i -o %Y %m %d");
    $ok = `grep '^$epo' $fil | wc -l`+0;
    unless ($ok) {
      $n++;
      print "$fil: $epo ($i) not OK\n";
      $dmin = $i if $dmin == $dmax;
      $lin = $epo.substr($linlst,10,);
      `echo '$lin' >> $fil`;
    }
  }
  print "$fil: $n lines added\n" if $n > 0;
  msg2key("NEW","VERI_ERP: $pcfFil $taskId${yyddd}0: $n lines added to RAP${yyddd}.ERP") if $n > 0;
  die "$fil not accepted\n" if $n > 7;

}

