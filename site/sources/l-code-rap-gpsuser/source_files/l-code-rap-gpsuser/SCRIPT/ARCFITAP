package ARCFITAP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ARCFITAP
#
# Purpose :
#
# Programs:  Prepare parallel ORBGEN runs for 1 to $V_ARCFIT days
#
# Author  :  M. Meindl
#
# Created :  31-Jul-2003
#
# Changes :  01-Sep-2003 mm: Some new solutions (1.5, 2.5, 3.5)
#            08-Sep-2003 ss: 3.5 solution removed
#            26-Jan-2005 mm: new initPar call (w/o tmpFil)
#            09-Dec-2023 SS: Handle constellation change (switch between R25 and R26)
#            24-Jan-2025 SS: Handle constellation change (from R26 to R06)
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use lib $ENV{AUTO};
use gpsutil;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($mjd, $dirOut, $dirPre) =
    $bpe->getKeys('$JD+0', 'DIR_OUT', 'DIR_PRE');

  my $V_ARCFIT = $$bpe{V_ARCFIT};

# Handle constellation change (switch between R25 and R26)
# --------------------------------------------------------
  if ($mjd>=60286 && $mjd<60289) {
    replace("${dirPre}PRD23340.PRE","R2[56]","R00");
    replace("${dirPre}PRD23341.PRE","R2[56]","R00");
    replace("${dirPre}PRD23342.PRE","R2[56]","R00");
    replace("${dirPre}PRD23343.PRE","R2[56]","R00");
    replace("${dirPre}PRD23344.PRE","R2[56]","R00");
  }
  if ($mjd>=60285 && $mjd<60296) {
    replace("${dirPre}PRD23338.PRE","R2[56]","R00");
    replace("${dirPre}PRD23339.PRE","R2[56]","R00");
    replace("${dirPre}PRD23340.PRE","R2[56]","R00");
    replace("${dirPre}PRD23341.PRE","R2[56]","R00");
    replace("${dirPre}PRD23342.PRE","R2[56]","R00");
    replace("${dirPre}PRD23343.PRE","R2[56]","R00");
    replace("${dirPre}PRD23344.PRE","R2[56]","R00");
    replace("${dirPre}PRD23345.PRE","R2[56]","R00");
    replace("${dirPre}PRD23346.PRE","R2[56]","R00");
    replace("${dirPre}PRD23347.PRE","R2[56]","R00");
    replace("${dirPre}PRD23348.PRE","R2[56]","R00");
    replace("${dirPre}PRD23349.PRE","R2[56]","R00");
    replace("${dirPre}PRD23350.PRE","R2[56]","R00");
    replace("${dirPre}PRD23351.PRE","R2[56]","R00");
    replace("${dirPre}PRD23352.PRE","R2[56]","R00");
    replace("${dirPre}PRD23353.PRE","R2[56]","R00");
  }
  if ($mjd>=60349 && $mjd<60351) {
    replace("${dirPre}PRD24037.PRE","G02","G00");
    replace("${dirPre}PRD24038.PRE","G02","G00");
    replace("${dirPre}PRD24039.PRE","G02","G00");
    replace("${dirPre}PRD24040.PRE","G02","G00");
    replace("${dirPre}PRD24041.PRE","G02","G00");
    replace("${dirPre}PRD24042.PRE","G02","G00");
    replace("${dirPre}PRD24043.PRE","G02","G00");
  }
  if ($mjd>=60695 && $mjd<60699) {
    replace("${dirPre}PRD25019.PRE","R06","R00");
    replace("${dirPre}PRD25020.PRE","R06","R00");
    replace("${dirPre}PRD25021.PRE","R06","R00");
    replace("${dirPre}PRD25022.PRE","R06","R00");
    replace("${dirPre}PRD25023.PRE","R06","R00");
  }
  if ($mjd>=60812 && $mjd<60816) {
    replace("${dirPre}PRD25136.PRE","R19","R00");
    replace("${dirPre}PRD25137.PRE","R19","R00");
    replace("${dirPre}PRD25138.PRE","R19","R00");
    replace("${dirPre}PRD25139.PRE","R19","R00");
    replace("${dirPre}PRD25140.PRE","R19","R00");
  }
  if ($mjd>=60964 && $mjd<60967) {
    replace("${dirPre}PRD25288.PRE","R28","R00");
  }
  if ($mjd>=60966 && $mjd<60967) {
    replace("${dirPre}PRD25288.PRE","R20","R00");
    replace("${dirPre}PRD25291.PRE","R20","R00");
    replace("${dirPre}PRD25292.PRE","R20","R00");
  }
  if ($mjd>=61033 && $mjd<61036) {
    replace("${dirPre}PRD25358.PRE","R27","R00");
    replace("${dirPre}PRD25358.PRE","R06","R00");
    replace("${dirPre}PRD25359.PRE","R06","R00");
    replace("${dirPre}PRD25360.PRE","R06","R00");
  }
  if ($mjd>=61333 && $mjd<61335) {
    replace("${dirPre}PRD26293.PRE","R10","R00");
    replace("${dirPre}PRD26294.PRE","R10","R00");
    replace("${dirPre}PRD26295.PRE","R10","R00");
  }

# Create list of arc lengths to process
# -------------------------------------
  my (@arcLen,$i);
  for ($i=1;$i<=$V_ARCFIT;$i++) {
    push(@arcLen,$i);
    if ($i==1) { push(@arcLen,$i+0.25) }
    if ($i==1 || $i==2) { push(@arcLen,$i+0.5) }
    if ($i==1) { push(@arcLen,$i+0.75) }}

  @arcLen = reverse(@arcLen);

# Initialize parallel run
# -----------------------
  initPar_Bl($bpe,@arcLen);

}
