package BPE_BYE;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  BPE_BYE
#
# Purpose :  Create BPE-specific BYE file for extra process watcher
#
# PARAMs  :  PARAM1 - number of hours between BPE runs (default: 24)
#            PARAM2 - keyword for alerting (default: BPE)
#            PARAM3 - SES, DOW, EOW to flag session, day of week, or end of
#                     week (default: blank)
#
# Author  :  S. Schaer
# Created :  04-Apr-2005
#
# Changes :  07-Apr-2005/ss: Consider PARAM3
#            22-Jul-2008 PS/RD: prepare for reprocesing
#            17-Jan-2022 RD/AV: Relocate $X/MSC->$MSC (${C}/AIUB/MSC)
#
# ============================================================================
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($pcfFil, $taskId, $yyssss, $wwwwd,
      $param1, $param2, $param3, $camp_pth, $campaign) =
    $bpe->getKeys('PCFFIL', 'TASKID', '$YSS+0', '$WD+0',
                  'PARAM1', 'PARAM2', 'PARAM3','CAMP_PTH','CAMPAIGN');

  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");

# Set variables
# -------------
  $pcfFil = (split('\.',$pcfFil))[0];

  $param1 = "24"  if $param1 eq "";
  $param1 = $param1*3600;

  $param2 = "BPE" if $param2 eq "";

  if    ($param3 eq "EOW") {
    if (substr($wwwwd,4,1) eq "6") { $param3 = ""} else { return } }
  elsif ($param3 eq "SES") { $param3 = "_".substr($yyssss,5,1) }
  elsif ($param3 eq "DOW") { $param3 = "_".substr($wwwwd,4,1) }
  else                     { $param3 = "" }

# Create BYE file
# ---------------
  unless ($repro) {
    my $str = gps_date("-t -o %U / $param1 / %z / ${pcfFil}${param3} / ${taskId}${yyssss}%n");

    my $txtFil = "$ENV{MSC}/BYE_${pcfFil}${param3}.${param2}";
    my $tmpFil = "${txtFil}_$$";
    open (FIL,"> $tmpFil");
    print FIL "$str";
    close FIL;
    move ($tmpFil,$txtFil);

    print     "$str";
  }

}
