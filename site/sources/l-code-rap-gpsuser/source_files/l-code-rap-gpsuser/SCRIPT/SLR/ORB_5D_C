package ORB_5D_C;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name:      ORB_5D_C
#
# Purpose:   Get 5-day orbit predictions and ERPs
#
# PARAMs  :  PARAM1 - NEXTJOB
#            PARAM2 - Jump forward to PID xxx if orbit not available
#
# Authors:   C. Urschl
#
# Created:   10-Nov-2005
# Last mod.: 01-Mar-2012
#
# Changes:   17-Dec-2007 rd: adapt for use at ubelix
#            01-Mar-2012 DT: Check whether Orbit available, jump forward if not
#            18-Jul-2013 CB: print statements added
#            26-Sep-2019 RD: No e-mail in case of a NO_DIS.FLG
#            19-Oct-2026 UM: Adapt orbit and ERP file names
#
# ----------------------------------------------------------------------------
use strict;

use lib "$ENV{AUTO}";
use lib "$ENV{EXE}";
use lib "$ENV{BPE}";
use igs_device;
use gpsutil;
use bpe_util;
use Gps_Date;
use File::Copy;

# overloaded 'run' method.
sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($CAMP_PTH,$CAMPAIGN,$wwwwd,$yyyyddd) = 
    $bpe->getKeys ('CAMP_PTH','CAMPAIGN','$WD+0','$YYYD-1');

  my $dirEph = "$PATH_AFTP/CODE/";
  my $dirOrb = "${CAMP_PTH}${CAMPAIGN}/ORB/";


# Check for NO_DIS.FLG
# --------------------
my $disFlg = "$ENV{HOME}/../l_code/MSC/NO_DIS.FLG";


# GoTo if 5-day orbit prediction not yet available
# ------------------------------------------------
  my $goto = $$bpe{PARAM2};


# Copy 5-day prediction
# ---------------------
#  my $INP = "${dirEph}COD$wwwwd.EPH_5D";
  my $INP = "${dirEph}COD0OPSPRD_${yyyyddd}0000_05D_05M_ORB.SP3";
  my $OUT = "${dirOrb}COD_5D.PRE";

#  my $INPerp = "${dirEph}COD$wwwwd.ERP_5D";
  my $INPerp = "${dirEph}COD0OPSPRD_${yyyyddd}0000_21D_06H_ERP.ERP";
  my $OUTerp = "${dirOrb}COD_5D.IEP";

  if (-s $INP) {
    copy($INP,$OUT) or die "${INP} not found";
    print "${INP} copied\n";
    copy($INPerp,$OUTerp) or die "${INPerp} not found";
    print "${INPerp} copied\n";
  }

  else {
    print "\n Orbit prediction not yet available: ${INP} \n";
    prtGoto($bpe,$goto);

    unless (-e $disFlg) {
      my $slrWarn = "code_slr\@aiub.unibe.ch";
#      my $subject = "WARNING: Orbit prediction for ${wwwwd} not yet available";
      my $subject = "WARNING: Orbit prediction for ${yyyyddd} not yet available";
      send_mail($slrWarn, s=>$subject)
    }
  }

}

