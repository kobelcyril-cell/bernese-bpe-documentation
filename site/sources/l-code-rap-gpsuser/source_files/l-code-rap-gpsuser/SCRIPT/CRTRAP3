package CRTRAP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  CRTRAP
#
# Purpose :  Create rapid orbit submission
#
# Programs:  STDPRE, PREWEI
#
# Author  :  S. Schaer
# Created :  28-Jun-2004
#
# Changes :  10-Aug-2005 RD: No broadcast switch if CLKRAPID.PCF
#            06-Nov-2006 SS/AG: Set CLKINFO in case of broadcast info
#            06-Jun-2014 SS: Considered MIDyyddd.FLG
#            07-Feb-2018 SS: Use V_SAV (not V_DIS) for copyaftp
#            22-Apr-2020 ST: Change 'RB_' to '$A_'
#            04-Apr-2023 RD: Compress->gzip
#            24-Nov-2025 SS: Specify TITPRE using replaceSelLst to force SP3d
#            27-Nov-2025 SS: Add the DOI comment line to force SP3d
#
# ----------------------------------------------------------------------------
use strict;

use lib "$ENV{AUTO}";
use gpsutil;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $gnss, $doi, $dirOut, $dirClk, $dirPre, $extPre,
      $pcfFil, $v_sav, $savdsk) =
     $bpe->getKeys('$YD+0', 'V_GNSS', 'V_DOI', 'DIR_OUT', 'DIR_CLK', 'DIR_PRE', 'EXT_PRE',
      'PCFFIL', 'V_SAV', 'V_SAVDSK');

  my $yyyyddd = "20".substr($yyddd,0,2)."-".substr($yyddd,2,);

#               12345678901234567890123456789012345678901234567890123456c8901234567890123456d
  my $cenLin = "Center for Orbit Determination in Europe (CODE)";
  my $titLin = "Rapid GNSS orbits and GPS clocks for year-day $yyyyddd";
  my $remLin = "Last day of a 3-day long-arc $gnss solution";
  my $doiLin = "Product reference - DOI $doi";

  my $midFil = "${dirOut}../MSC/MID${yyddd}.FLG";
  if (-e $midFil) {
##    $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","STDORB",'MID$YD+0');
##    $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","IMPELE",'MID$YD+0');
##    $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","POLE",'MID$YD+0');
####    $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","TITLE3","Note: Last day of a 3-day arc GPS/GLONASS solution");
##    $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","TITLE3","Note: Middle day of a 3-day arc GPS/GLONASS solution");
  }

  my $clkFil = "$dirClk/HR_$yyddd.CLK";
  print "clkFil: $clkFil\n";
  if (-e $clkFil || $pcfFil eq "RCLKGNSS.PCF") {
    if($savdsk eq "Y"){
      prtMess($bpe,"SKIPPED");
      return;
    }else{
      prtMess($bpe,"PRECISE CLOCKS INCLUDED");
    }
  }
  else {
    $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","SATCLK",'$A_$YD+0');
    $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","CLKINFO",'BRD');
    prtMess($bpe,"BROADCAST CLOCKS INCLUDED") }

  my @lines = ($cenLin,$titLin,$remLin);
# Add the DOI comment line to force SP3d
  push(@lines,$doiLin);
  replaceSelLst($bpe,"STDPRE","TITPRE",@lines);

# Run programs
# ------------
  my $PGMNAM = "STDPRE";
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "PREWEI";
  $bpe->RUN_PGMS($PGMNAM);

# Not allowed to distribute files
# -------------------------------
  if ($v_sav ne "Y"){
      prtMess($bpe,"FILES_NOT_DISTRIBUTED");
  }
  else  {
      my $inpFil="$dirPre/RT_WCLK.$extPre";
      my $outFil="$PATH_AFTP/CODE/BKG/COD_IP_wCLK.EPH";
      check_dir("$PATH_AFTP/CODE/BKG");
      unlink("$inpFil.gz");
      compress("-z gzip","$inpFil");
      copyfile("$inpFil.gz","$outFil.gz");
  }

}
