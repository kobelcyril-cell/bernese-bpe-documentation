package CPF_DEL;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name:      CPF_DEL
#
# Purpose:   Delete old files concerning SLRPRED.PCF
#
# Authors:   C. Urschl
# Created:   12-Dec-2003
#
# Changes:   18-Jul-2013 CB: added files to delete; cpf deletion is obsolete
#                            due to CPF_AFTP script
#                            
#
# ============================================================================

sub run {
  my $bpe = shift;

# Get variables
# -------------

  my ($ssssm10, $yydddm30, $ssssm30, $yyyym30) =
    $bpe->getKeys('$S-(10)','$YD-(30)','$S-(30)','$Y-(30)'); 
  my $yym30 = substr($yyyym30,2,2);

  my $CAMP_PTH  = $$bpe{CAMP_PTH};                                               
  my $CAMPAIGN  = $$bpe{CAMPAIGN};
#  my $dirOrb    = "${CAMP_PTH}${CAMPAIGN}/ORB/";
  my $dirOut    = "${CAMP_PTH}${CAMPAIGN}/OUT/";

# Create list of files to be deleted
# ----------------------------------
#  my $num = $ssssm10 + 5001;

  my @delLst  = (
#                 "${dirOrb}glonass??_cpf_??????_${num}.cod",   #obsolete, due to CPF_AFTP
#                 "${dirOrb}glonass???_cpf_??????_${num}.cod",  #obsolete, due to CPF_AFTP
#		  "${dirOrb}gps??_cpf_??????_${num}.cod",       #obsolete, due to CPF_AFTP
		 "${dirOut}S2C${yydddm30}.OUT",
		 "${dirOut}ERROR_SP.${yym30}_${ssssm30}");

  foreach (@delLst) { 
    print "$_ : \t", unlink(glob($_)), " files deleted\n";
  }

}
