package INIT_HOI;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  INIT_HOI
#
# Purpose :  Initialization concerning HOI setup
#
# Programs:
#
# Author  :  S. Schaer
# Created :  17-Jan-2012
#
# Changes :  26-Feb-2010 ss: Generalization
#            01-Mar-2010 ss: CLKRAPID case added
#            07-Oct-2010 ss/rd: Allow a certain delay for start of iono BPE
#            17-Jan-2012 lp/sl: Look for RA...ION file in ${PATH_RAP}${CAMP_RAP}
#                               instead of ${PATH_SAV}${CAMP_SAVRAP};
#                               wait for ..999..PRT file of RAPIONO
#            04-Aug-2015 ss: CLKRAPID replaced by RCLKGNSS
#            05-Jun-2018 ss: REPROCESSING.FLG considered
#            07-Aug-2018 ss: Extended @ionLst for RCLKGNSS
#            11-Jun-2019 ss: Do not accept any null model
#            16-Sep-2019 av: Use regex for PCFFIL check (IGSRAPID and RCLKGNSS)
#            21-Apr-2020 ST: Add 'use igs_device;'
#            25-Jun-2020 AV: Look for RA..ION in savedisk  (IGSRAPID)
#            08-Mar-2022 AV: Save disk: yearly subdirectory
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use igs_device;
use File::Copy;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yyyy, $dirOut, $dirIon, $extIon,$savdsk,
      $pcfFil, $hoi) =
    $bpe->getKeys('$YD+0', '$Y+0', 'DIR_OUT', 'DIR_ION', 'EXT_ION','V_SAVDSK',
                  'PCFFIL', 'V_HOI');

# Set variables
# -------------
  $pcfFil = (split('\.',$pcfFil))[0];

  my $repro = (-e "${dirOut}../MSC/REPROCESSING.FLG");

  my $ultFil = "${dirOut}../MSC/ULT${yyddd}.FLG";
  my $hoiFil = "${dirIon}HOI${yyddd}.${extIon}";

  unlink($hoiFil);

# Define priority list of possible ION files
# ------------------------------------------
  my @ionLst = (
                "${PATH_RAP}${CAMP_RAP}/ATM/RHN${yyddd}.ION",
                "${PATH_SAV}${CAMP_SAVRAP}/${yyyy}/ATM/Z12${yyddd}.ION",
                "${PATH_SAV}${CAMP_SAVRAP}/${yyyy}/ATM/Z11${yyddd}.ION",
##                "${PATH_RAP}${CAMP_RAP}/ATM/RHN${yyddd}.ION",
                "${PATH_RAP}${CAMP_RAP}/ATM/RZ_${yyddd}.ION",
                "${PATH_RAP}${CAMP_RAP}/ATM/RA_${yyddd}.ION",
                "${PATH_RAP}${CAMP_RAP}/ATM/RM_${yyddd}.ION",
                "${PATH_SAV}${CAMP_SAVRAP}/${yyyy}/ATM/RZ_${yyddd}.ION",
                "${PATH_SAV}${CAMP_SAVRAP}/${yyyy}/ATM/RA_${yyddd}.ION",
                "${PATH_SAV}${CAMP_SAVRAP}/${yyyy}/ATM/RM_${yyddd}.ION",
                "${PATH_GIM}${CAMP_GIM}/ATM/Z1_${yyddd}.ION",
                "${PATH_GIM}${CAMP_GIM}/ATM/Z3_${yyddd}.ION",
                "${PATH_SAV}${CAMP_SAVIGS}/${yyyy}/ATM/Z1_${yyddd}.ION",
                "${PATH_SAV}${CAMP_SAVIGS}/${yyyy}/ATM/Z3_${yyddd}.ION",
                );

  @ionLst = ("${PATH_RAP}${CAMP_RAP}/ATM/RZ_${yyddd}.ION",
             "${PATH_RAP}${CAMP_RAP}/ATM/RA_${yyddd}.ION",
             "${PATH_RAP}${CAMP_RAP}/ATM/RM_${yyddd}.ION",
             "${PATH_RAP}${CAMP_RAP}/ATM/HOI${yyddd}.ION") if $pcfFil =~ /RCLKGNSS/ && !$repro && $savdsk ne "Y";

# Perform waiting loop
# --------------------
  my $ionFil = "";
  my $prtFil = "";
  my @prtLst = ("DUMMY");
  my $timLim = 3600;
  if ($pcfFil =~ /IGSRAPID/ && !-e $ultFil) {
#    $ionFil = "${PATH_SAV}${CAMP_SAVRAP}/${yyyy}/ATM/RA_${yyddd}.ION";
    $ionFil = "${PATH_RAP}${CAMP_RAP}/ATM/RA_${yyddd}.ION";
#    $prtFil = "${PATH_RAP}${CAMP_RAP}/BPE/RI${yyddd}0_???_???.PRT";
    $prtFil = "${PATH_RAP}${CAMP_RAP}/BPE/RI${yyddd}0_999_000.PRT";
    my $ionSav = "${PATH_SAV}${CAMP_SAVRAP}/${yyyy}/ATM/RA_${yyddd}.ION";
    $ionFil = $ionSav if ! -s $ionFil && -s $ionSav;
    if (!-s $ionFil) { prtMess($bpe,"Waiting"); sleep(300+180) }
  }

  my $start = 0;
  my $time0 = time;
  while ($start==0 && $ionFil ne "") {
    if (-s $ionFil) { prtMess($bpe,"$ionFil found"); $start++ }
    else            { prtMess($bpe,"Waiting for $ionFil"); sleep(60) }

    @prtLst = glob($prtFil) unless $prtFil eq "";
    if (@prtLst==0)                  { prtMess($bpe,"Waiting loop exit due to inactive subsidary BPE process"); $start++ }
    if (time-$time0>=$timLim)        { prtMess($bpe,"Waiting loop exit due to exceeded time limit"); $start++ }
  }

# Check availability of ION data
# ------------------------------
  $ionFil = "";
  foreach (@ionLst) {
##    if (-s $_) {
    if (-s $_ && `grep '0.00000000' $_ | wc -l`+0 <= 1) {
      print "$_ available\n";
      $ionFil = $_;
    } else {
      print "$_ not available\n";
    }
  }

# Copy selected ION file
# ----------------------
  if ($ionFil ne "") {
    prtMess($bpe,"HOI setup: ION data available: $ionFil");
    sleep(60);
    copy($ionFil,$hoiFil);
  } else {
    prtMess($bpe,"HOI setup: ION data not available");
  }

}
