package INIT_FIX;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  INIT_FIX
#
# Purpose :  Create a priori FIX file
#
# PARAMs  :  PARAM1 - Optional solution identifier
#            PARAM2 - Optional solution identifier (of reference solution)
#            PARAM3 - Optional filename extension (default: _ALL)
#            PARAM4 - WEEK option for file naming
#
# Author  :  S. Schaer
# Created :  26-Sep-2012
#
# Changes :  26-Sep-2012/ss: Consider optional PARAM1
#            27-Sep-2012/ss: Consider optional PARAM2 and PARAM3
#            02-Oct-2012/ss: WEEK option for file naming
#
# ============================================================================
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use File::Copy;

sub run {

  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $wwww, $param1, $param2, $param3, $param4, $crdInf,
      $dirFix, $extFix) =
    $bpe->getKeys('$YD+0', '$W+0', 'PARAM1', 'PARAM2', 'PARAM3', 'PARAM4', 'V_CRDINF',
                  'DIR_FIX', 'EXT_FIX');
  $param1 = $$bpe{"V_$param1"} if $param1 ne "";
  $param2 = $$bpe{"V_$param2"} if $param2 ne "";

  $param1 = $param1."_" if length($param1) == 2;
  $param2 = $param2."_" if length($param2) == 2;
  $param3 = "_ALL" if $param3 eq "";

  $yyddd = $wwww."7" if $param4 eq "WEEK";

##  my $inp = "$ENV{REF}/${crdInf}.${extFix}";
  my $inp = "${dirFix}${crdInf}.${extFix}";
  $inp = "${dirFix}${param2}${yyddd}.${extFix}" if $param2 ne "";
  my $out = "${dirFix}${crdInf}${param3}.${extFix}";
  my $tmp = $out."_TMP";
  copy($inp,$tmp) or die "copy failed with $inp to $tmp\n";
  replace($tmp,"_"," ");
  move($tmp,$out) or die "move failed with $tmp to $out\n";
  prtMess($bpe,"FIX file initialization: $inp copied to $out");

  if ($param1 ne "") {
    $out = "${dirFix}${param1}${yyddd}.${extFix}";
    $tmp = $out."_TMP";
    copy($inp,$tmp) or die "copy failed with $inp to $tmp\n";
    replace($tmp,"_"," ");
    move($tmp,$out) or die "move failed with $tmp to $out\n";
    prtMess($bpe,"FIX file initialization: $inp copied to $out");
  }

}
