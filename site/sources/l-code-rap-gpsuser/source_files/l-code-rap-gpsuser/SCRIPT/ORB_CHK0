package ORB_CHK0;
@ISA = ("RUNBPE");
# ==============================================================================
#
# Name:       ORB_CHK0
#
# Purpose:    7- AND 2-DAY ORBIT OVERLAPS (ORBGEN)
#             2-DAY OVERLAP WITH ARC-SPLITTING CHECK
#
# Author:     S.Schaer
#
# Created:    01-Nov-2012
#
# Changes:    17-Nov-2015 SS: Considered V_UPD
#             15-Jun-2020 AV: Skip if 3-day solution is skipped
#
# ==============================================================================

use strict;
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ymdm6,$ymdm1,$ymdp0,$yy,$ddd,$ssss,$wwwwd,
      $CAMP_PTH,$CAMPAIGN,$dirOut,$v_h, $skip_sol) =
    $bpe->getKeys('$YMD_STR-6','$YMD_STR-1','$YMD_STR+0','$Y','$+0','$S+0','$WD+0',
                  'CAMP_PTH','CAMPAIGN','DIR_OUT','V_H', 'V_SKIP3D');

  return if $skip_sol eq "Y";

# Check if this is an ULTRA:
# -------------------------
  my $ultFil = "$CAMP_PTH${CAMPAIGN}/MSC/ULT$yy$ddd.FLG";  # ultra-flag
  my($h_end,$h_tro,$h_rnx,$h_chr) = rdUltFlg($ultFil);
  unless(-e $ultFil) {
    $h_end=24;
  }

  my $skpFil = "$CAMP_PTH${CAMPAIGN}/MSC/NO_LONGARCFIT.FLG";  # ultra-flag

# PlusMinus-Variable
# ------------------
  setMinusPlus($bpe,-6,0);

  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","RADIO_1",'0');
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","RADIO_2",'1');
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","STADAT","$ymdm6");
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","ENDDAT","$ymdp0");

# Run program
# -----------
  my $PGMNAM = "ORBGEN";
##  unless(-e $ultFil || -e $skpFil) {
##    $bpe->RUN_PGMS($PGMNAM);
##  }

# PlusMinus-Variable
# ------------------
  setMinusPlus($bpe,-1,0);

  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","RADIO_1",'0');
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","RADIO_2",'1');
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","STADAT","$ymdm1");
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","ENDDAT","$ymdp0");
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","SUMFIL","");

  if($h_end < 24){
    my $endTim = sprintf("%02d%6s",$h_end,' 00 00');
    $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","ENDTIM","$endTim");
  }

# Run ORBGEN
# ----------
  $bpe->RUN_PGMS($PGMNAM);

# Put the name of the sysout to the extraction program
# ----------------------------------------------------
  $bpe->putKey("$$bpe{U}/PAN/DEFXTR.INP","JOBOUT","$$bpe{SYSOUT}");

# Unlink some files
# -----------------
  unlink("$dirOut/DEFXTR.SUM");
  unlink("$dirOut/DEFWKS.SUM");
  unlink("$dirOut/ASPLIT.SUM");

# Deactivate ASPLIT option if necessary
# -------------------------------------
  unless ($$bpe{V_UPD} eq "Y") {
    $bpe->putKey("$$bpe{U}/PAN/DEFXTR.INP","ASPLIT",'');
    prtMess($bpe,"ASPLIT_NOT_PERFORMED");
  }
  if($h_end < 11){
    $bpe->putKey("$$bpe{U}/PAN/DEFXTR.INP","ASPLIT",'');
    prtMess($bpe,"ASPLIT_DEACTIVATED");  }
  else {
    prtMess($bpe,"ASPLIT_ACTIVATED");
  }

  $PGMNAM = "DEFXTR";
  $bpe->RUN_PGMS($PGMNAM);

# Summary of program run for Protocol
# -----------------------------------
  my $xtrSum="$dirOut/ORBCHK0.${yy}_${ssss}";
  if(-e $xtrSum){
    appFile ("",0,"$dirOut/DEFWKS.SUM","$xtrSum");
    appFile ("",0,"$dirOut/DEFXTR.SUM","$xtrSum"); }
  else {
    copyfile("$dirOut/DEFWKS.SUM","$xtrSum");
    appFile("",0,"$dirOut/DEFXTR.SUM","$xtrSum");
  }

  my $xtrLst="$dirOut/${v_h}X${wwwwd}.LST";
  if(-e $xtrLst){
    appFile("",0,"$dirOut/DEFWKS.SUM","$xtrLst");
  } else {
    copyfile("$dirOut/DEFWKS.SUM","$xtrSum");
  }

  my $arcSum="$dirOut/ASPLIT.${yy}_${ssss}";
#  if(-e $arcSum){
  if(-e "$dirOut/ASPLIT.SUM"){
    appFile("",0,"$dirOut/ASPLIT.SUM","$arcSum");
#  } else {
#    copyfile("$dirOut/ASPLIT.SUM","$arcSum");
  }
  unlink("$dirOut/ASPLIT.SUM");

# Undo ASPLIT in case of poorly observed satellites
# -------------------------------------------------
  system("$ENV{AUTO}/undo_asplit.com $ddd $CAMP_PTH${CAMPAIGN}");
  system("$ENV{AUTO}/crx_alarm.com $ddd $CAMP_PTH${CAMPAIGN} -asplit");

}

# ==============================================================================

__END__
