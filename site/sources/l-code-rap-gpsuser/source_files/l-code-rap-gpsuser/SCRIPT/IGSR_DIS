use strict;

# External packages
use File::Copy qw(copy);
use File::Basename;

# Local packages
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use lib_erp;
use gpsutil;
use newFTP;
use cddis_curl;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yy,$yyyy,$yym1,$yyp1,$yyp2,$ddd,$dm1,$dp1,$dp2,$yyddd,$yyssss,
    $yydp1,$yydp2,$wwwwd,$wwwwdp1,$wwwwdp2,$wwwwdm1,$wwwwdm2,$wwwwdm3,
    $v_sav,$v_dis,$savdsk,
    $dirOut,
    $dirTrp,$extTrp,
    $dirPre,$extPre,
    $dirErp,$extErp,
    $dirRxc,$extRxc,
    $dirTro,$extTro,
    $dirIep,$extIep,
    $dirSnx,$extSnx,
            $extOut,
    $dirStd,$extStd,
  ) =
  $bpe->getKeys(
    '$Y','$Y+0','$Y-1','$Y+1','$Y+2','$+0','$-1','$+1','$+2','$YD+0','$YSS+0',
    '$YD+1','$YD+2','$WD+0','$WD+1','$WD+2','$WD-1','$WD-2','$WD-3',
    'V_SAV','V_DIS','V_SAVDSK',
    'DIR_OUT',
    'DIR_TRP','EXT_TRP',
    'DIR_PRE','EXT_PRE',
    'DIR_ERP','EXT_ERP',
    'DIR_RXC','EXT_RXC',
    'DIR_TRO','EXT_TRO',
    'DIR_IEP','EXT_IEP',
    'DIR_SNX','EXT_SNX',
              'EXT_OUT',
    'DIR_STD','EXT_STD',
  );

# Return if V_SAVDSK == Y
# -----------------------
  if($savdsk eq "Y"){
    print "SAVDSK activated, skipped\n";
    return(1);
  }

# Set flags
# ---------
  my $midFil    = "${dirOut}../MSC/MID${yyddd}.FLG";
  my $ultFil    = "$$bpe{CAMP_PTH}$$bpe{CAMPAIGN}/MSC/ULT${yyddd}.FLG";
  my $nxtUltFil = "$$bpe{CAMP_PTH}$$bpe{CAMPAIGN}/MSC/ULT${yydp1}.FLG";

# Some variables
# --------------
  my $xa       = "$ENV{AUTO}";
  my $ftpCod   = "${PATH_AFTP}${CAMP_CODE}/";
  my $ftpCod_M = "${PATH_AFTP}${CAMP_CODE}/${yyyy}_M/";
  my $ftpCod_I = "${PATH_AFTP}${CAMP_CODE}/IERS/${yyyy}/";
  my $clkInc   = "NO";
  my $savDir = "$PATH_SAV/RCLKGNSS/$yyyy/ORB/";

  check_dir($ftpCod);
#_M  check_dir($ftpCod_M);
  check_dir($ftpCod_I);
  check_dir($savDir);

# Set day
# -------
  my $accDay = $ddd;
  my $accYr  = $yyyy;
  my $hour   = "99";


# Read ultra flag file
# --------------------
  my($h_end,$h_tro,$h_rnx,$h_chr) = &rdUltFlg($ultFil);
  my $T  = &gtUltVrs($h_end,$h_chr);

  my $sess_fin = "${ddd}${h_chr}";
  if(-e $ultFil) {
    ($accDay,$accYr,$hour) = $h_end < 15 ? ($ddd,$yyyy,"12")
                                         : ($dp1,$yyp1,"00");
  }


# Copy SATINFO, PCV, RECEIVER, SAT-CRX files to BSWUSER
# -----------------------------------------------------
  if(1==2){
    print "gen2bswuser: $ENV{CONFIG} ${yyyy} ${yyp1}\n";
    system("$ENV{AUTO}/gen2bswuser.com IGSR_FTP ${yyyy} ${yyp1}");
    system("$ENV{AUTO}/gen2bswuser54.com IGSR_FTP ${yyyy} ${yyp1}");
  }

# Prepair files to submit to archive and ftp
# ------------------------------------------
  my $isMid   = -e $midFil                 ? 1: 0;
  my $isUlt   = -e $ultFil                 ? 1: 0;
  my $isNxtUlt= -e $nxtUltFil              ? 1: 0;
  my $isUlt24 = -e $ultFil && $h_end == 24 ? 1: 0;

# Set file names
# --------------
  my $outFil_rap = "RA_$yyddd";
  my $outFil_ult = "RQ_$yyddd";
  my $dayOrb     = "${dirPre}RAC${yyddd}.${extPre}";
  my $dayErp     = "${dirErp}COD${wwwwd}.${extErp}";
  my $ultErp     = "${dirErp}U$T${wwwwd}.${extErp}";
  my $dayClk     = "${CDIR_RCLK}/../RCLKGNSS/OUT/HR_${yyddd}0.${extRxc}";
  my $dayClk52   = "${CDIR_RCLK}/../RCLKGNSS/OUT/XR_${yyddd}0.${extRxc}";
  my $dayBia     = "${savDir}IAR${yyssss}_V01.BIA.gz";
  my $dayOsb     = "${savDir}IAR${yyssss}_V01.OSB.Z";
  my $dayTro     = "${dirTro}U$T${yyddd}.${extTro}";
  my $daySnx     = "${dirSnx}RA_${yyddd}.${extSnx}";
  my $daySnxTro  = "${dirSnx}RAT${yyddd}.${extSnx}";
  if(-e $midFil){
    $outFil_rap = "MID$yyddd";
    $dayOrb     = "${dirPre}RAM${yyddd}.${extPre}";
    $dayErp     = "${dirErp}MID${wwwwd}.${extErp}";
    $dayTro     = "${dirTro}MID${yyddd}.${extTro}";
  }

  my $isClk   = -e $dayClk                 ? 1: 0;
  my $isDaySnxTro = `grep TROTOT $daySnxTro | wc -l`+0;
  if($isDaySnxTro==0){
    prtMess($bpe,"TROTOT RECORDS UNAVAILABLE IN $daySnxTro");
  }

  # Predictions
  my $dayOrb1    = "${dirPre}RP_${yydp1}.${extPre}";
  my $dayOrb2    = "${dirPre}RP2${yydp2}.${extPre}";
  my $dayOrb3    = "${dirPre}RP3${yydp1}.${extPre}";
  my $dayErp1    = "${dirIep}U$T${wwwwd}.${extIep}";

# Create ACC summary file
# -----------------------
  system("$xa/make_accsum.com $accDay $accYr $hour $dirOut $outFil_rap");
  my $ftpAcc = "${dirOut}${outFil_rap}.ACC";

# Copy SATINFO, PCV, RECEIVER, SAT-CRX files to BSWUSER
# -----------------------------------------------------
  if(1==2){
    print "gen2bswuser: $ENV{CONFIG} ${yyyy} ${yyp1}\n";
    system("$ENV{AUTO}/gen2bswuser.com IGSR_FTP ${yyyy} ${yyp1}");
  }


# Submit ot archive files
# -----------------------
  my %ultra_fil;
  my %rapid_fil;
  my %rapid_mid_fil;
  my %prediction;
  my %ultra_24_fil;

# Upload ULTRA
# ------------
  if($isUlt){
    $ultra_fil{$dayTro}{"${ftpCod}COD.TRO_U"}               = " ";
    $ultra_fil{$daySnx}{"${ftpCod}COD.${extSnx}_U"} = "c";
    if($isDaySnxTro){
      $ultra_fil{$daySnxTro}{"${ftpCod}COD_TRO.${extSnx}_U"} = "c";
    };
  }else{
    $rapid_fil{$dayTro}{"${ftpCod}COD${wwwwd}.${extTro}_R"} = " ";
    $rapid_fil{$daySnx}{"${ftpCod}COD${wwwwd}.${extSnx}_R"} = "c";
    $rapid_fil{$daySnx}{"${ftpCod_I}COD${wwwwd}.${extSnx}_R"} = "c";
    if($isDaySnxTro){
      $rapid_fil{$daySnxTro}{"${ftpCod}COD${wwwwd}_TRO.${extSnx}_R"} = "c";
      $rapid_fil{$daySnxTro}{"${ftpCod_I}COD${wwwwd}_TRO.${extSnx}_R"} = "c";
    }
    if(! $isNxtUlt){
        $ultra_fil{$dayTro}{"${ftpCod}COD_TRO.${extSnx}_U"};
    }
  }

# Upload ULTRA as RAPID
  if($isUlt24){
    $ultra_24_fil{$dayOrb}{"${ftpCod}COD${wwwwd}.EPH_U"      } = " ";
    $ultra_24_fil{$dayErp}{"${ftpCod}COD${wwwwd}.${extErp}_U"} = " ";
  }

# Upload RAPID
  $rapid_fil{$ultErp}{"${dirErp}IGSULTRA.${extErp}"}      = " ";
  $rapid_fil{$ultErp}{"${dirErp}ULT${wwwwd}.${extErp}"}   = "";
  if(! $isUlt){
    $rapid_fil{$dayOrb}{"${ftpCod}COD${wwwwd}.EPH_R"}       = " ";
    $rapid_fil{$dayErp}{"${ftpCod}COD${wwwwd}.${extErp}_R"} = " ";
  }

  if($isClk == 1){
    $rapid_fil{$dayClk}{"${ftpCod}COD${wwwwd}.${extRxc}_R"} = " ";
    $rapid_fil{$dayBia}{"${ftpCod}COD${wwwwd}.BIA_R.gz"}    = " ";
  }

# Upload RAPID_M
# --------------
  if($isMid == 1){
#_M    $rapid_mid_fil{$dayOrb}{"${ftpCod_M}COD${wwwwd}.EPH_M"}       = "c";
    $rapid_mid_fil{$dayOrb}{"${ftpCod}COD${wwwwd}.EPH_M"}         = " ";
    $rapid_mid_fil{$dayOrb}{"${savDir}TP_${yyssss}.${extPre}"}    = "c";

#_M    $rapid_mid_fil{$dayErp}{"${ftpCod_M}COD${wwwwd}.${extErp}_M"} = "c";
    $rapid_mid_fil{$dayErp}{"${ftpCod}COD${wwwwd}.${extErp}_M"}   = " ";
    $rapid_mid_fil{$dayErp}{"${savDir}TP_${yyssss}.${extIep}"}    = "c";

#_M    $rapid_mid_fil{$dayClk}{"${ftpCod_M}COD${wwwwd}.${extRxc}_M"} = "c";
    $rapid_mid_fil{$dayClk}{"${ftpCod}COD${wwwwd}.${extRxc}_M"}   = " ";

#_M    $rapid_mid_fil{$dayBia}{"${ftpCod_M}COD${wwwwd}.BIA_M.gz"}    = " ";
    $rapid_mid_fil{$dayBia}{"${ftpCod}COD${wwwwd}.BIA_M.gz"}      = " ";
#_M    my $ftpBia = "${ftpCod_M}COD${wwwwd}.BIA_M.gz";
#_M    $rapid_mid_fil{$dayBia}{$ftpBia}                              = " " if -e $ftpBia;
#_M    $rapid_mid_fil{$dayBia}{"${ftpCod_M}COD${wwwwd}.BIA_M.gz"}    = " " unless -e $ftpBia;
#_M    $rapid_mid_fil{$dayBia}{"${ftpCod}COD${wwwwd}.BIA_M.gz"}      = " " unless -e $ftpBia;
  }

# Upload predictions
# ------------------
  $prediction{$dayOrb1}{"${ftpCod}COD${wwwwdp1}.EPH_P"}  = " ";
  $prediction{$dayOrb2}{"${ftpCod}COD${wwwwdp2}.EPH_P2"} = " ";
  $prediction{$dayOrb3}{"${ftpCod}COD${wwwwdp1}.EPH_5D"} = " ";
  $prediction{$dayErp1}{"${ftpCod}COD${wwwwdp1}.ERP_P"}  = " ";
  $prediction{$dayErp1}{"${ftpCod}COD${wwwwdp2}.ERP_P2"} = " ";
  $prediction{$dayErp1}{"${ftpCod}COD${wwwwdp1}.ERP_5D"} = " ";
  if(! $isUlt){
    $prediction{$dayOrb3}{"${ftpCod}COD.EPH_5D"} = " ";
  }


# Upload to archive
# -----------------
  sendToArchive(\%ultra_fil);
  sendToArchive(\%ultra_24_fil);
  sendToArchive(\%rapid_fil);
  sendToArchive(\%rapid_mid_fil);
  sendToArchive(\%prediction);

##  uncompress glob("${ftpCod}COD${wwwwd}.BIA_?.Z");
##  map { system("uncompress -f $_") } (glob("${ftpCod}COD${wwwwd}.BIA_?.Z"));
  map { system("gunzip -f $_") } (glob("${ftpCod}COD${wwwwd}.BIA_?.gz"));

# Upload BSW52
# ------------
  if(1==2){
  if($isUlt){
    # Convert ERP file
    my $src52 = "${dirErp}U$T${wwwwd}.${extErp}_V52";
    erp2bsw52($ultErp,$src52);
    my $trg52 = "$CAMP_BSW52/ORB/COU.${extErp}";
    copyaftp($src52,$trg52);
    unlink $src52;
  }elsif(! $isNxtUlt){
    my $src   = "${dirErp}U$T${wwwwd}.${extErp}";
    my $src52 = "${dirErp}U$T${wwwwd}.${extErp}_V52";
    erp2bsw52($src,$src52);
    my $trg52 = "$CAMP_BSW52/ORB/COU.${extErp}";
    copyaftp($src52,$trg52);
  }
  }
# Return if v_dis not activated
# -----------------------------
  if($v_dis ne "Y" || -e "$ENV{HOME}/../l_code/MSC/NO_DIS.FLG") {
    prtMess($bpe,"FILES_NOT_DISTRIBUTED");
    return;
  }

# Create short protocol file (2nd time)
# -------------------------------------
  my $prcFilshort = "${dirOut}IGSRAPID_SHORT.TXT";
  my $prcFilsat = "${dirOut}IGSRAPID_SAT.TXT";
  my $call_ultra = "";
  if (-e $ultFil) {
    $prcFilshort = "${dirOut}IGSULTRA_SHORT.TXT";
    $prcFilsat = "${dirOut}IGSULTRA_SAT.TXT";
    $call_ultra = "-u";
  }
  system("perl $ENV{AUTO}/typ_rap.pl ${ddd} -q ${call_ultra} > $prcFilshort");
  system("perl $ENV{AUTO}/comp_obs_pre.pl -d ${ddd} -t RAP -p PRE -s GRE -v -oh 7 > $prcFilsat");

  if(-e $ultFil) {
    &copy2archive($prcFilshort,"$PATH_WWW/code/igsultra_short.txt");
    &copy2archive($prcFilsat,"$PATH_WWW/code/igsultra_sat.txt");
  }
  else {
    &copy2archive($prcFilshort,"$PATH_WWW/code/igsrapid_short.txt");
    &copy2archive($prcFilsat,"$PATH_WWW/code/igsrapid_sat.txt");
  }

# Submit to external repositories
# -------------------------------

  return;
# File selection
# --------------
  my %disIGS;
  my %disIEP;
  my %disCDDIS;
  my %disCDDIS_long;

 # Upload Rapid
  my $long_r = "COD0IGSRAP_${yyyy}${ddd}0000_01D";
  my $codOrbLong = "${long_r}_15M_ORB.sp3";
  my $codErpLong = "${long_r}_01D_ERP.erp";
  my $codAccLong = "${long_r}_01D_SUM.txt";
  my $codClkLong = "${long_r}_30S_CLK.clk";

  if($h_end == 24){
    $disIGS{"cod${wwwwd}.sp3"}     = $dayOrb;
    $disIGS{"cod${wwwwd}.erp"}     = $dayErp;
    $disIGS{"igr_cod${wwwwd}.sum"} = $ftpAcc;
    $disCDDIS{$dayOrb} = "r_cod${wwwwd}.sp3";
    $disCDDIS{$dayErp} = "r_cod${wwwwd}.erp";
    $disCDDIS{$ftpAcc} = "r_igr_cod${wwwwd}.sum";
    $disCDDIS_long{$dayOrb} = $codOrbLong;
    $disCDDIS_long{$dayErp} = $codErpLong ;
    $disCDDIS_long{$ftpAcc} = $codAccLong;
  }

  unless(-e $ultFil){
    $disIEP{"cod${wwwwd}.erp"}   =  "${ftpCod}COD${wwwwd}.${extErp}_R";
  }
  $disIEP{"cod${wwwwdm1}.erp"} = "${ftpCod}COD${wwwwdm1}.ERP_R";
  $disIEP{"cod${wwwwdm2}.erp"} = "${ftpCod}COD${wwwwdm2}.ERP_R";
  $disIEP{"cod${wwwwdm3}.erp"} = "${ftpCod}COD${wwwwdm3}.ERP_R";

  # Upload CLK
  if($isClk){
    $disIGS{"cod${wwwwd}.clk"} = $dayClk;
    $disCDDIS{$dayClk} = "r_cod${wwwwd}.clk";
    $disCDDIS_long{$dayClk} = "$codClkLong";
  }


  # Upload ULTRA
  if($isUlt){
  # Ultra 06
    my $ultOrb = "${dirPre}US2${wwwwd}.${extPre}";
    my $ultErp = "${dirIep}US2${wwwwd}.${extIep}";
    my $ultAcc = "${dirOut}ULTRA_30.ACC";
    my $long_u = "COD0IGSULT_${yym1}${dm1}0600_02D";
    system("$xa/make_accsum.com $ddd $yyyy 06 $dirOut $outFil_ult ULTRA_30");

    $disIGS{"cou${wwwwd}_06.sp3"}     = $ultOrb;
    $disIGS{"cou${wwwwd}_06.erp"}     = $ultErp;
    $disIGS{"igu_cod${wwwwd}_06.sum"} = $ultAcc;
    $disCDDIS{$ultOrb} = "cou${wwwwd}_06.sp3";
    $disCDDIS{$ultErp} = "cou${wwwwd}_06.erp";
    $disCDDIS{$ultAcc} = "igu_cod${wwwwd}_06.sum";
#    $disCDDIS_long{$ultOrb} = "${long_u}_15M_ORB.sp3";
#    $disCDDIS_long{$ultErp} = "${long_u}_01D_ERP.erp",
#    $disCDDIS_long{$ultAcc} = "${long_u}_02D_SUM.txt";

  # Ultra 12
    $ultOrb = "${dirPre}US1${wwwwd}.${extPre}";
    $ultErp = "${dirIep}US1${wwwwd}.${extIep}";
    $ultAcc = "${dirOut}ULTRA_12.ACC";
    $long_u = "COD0IGSULT_${yym1}${dm1}1200_02D";
    system("$xa/make_accsum.com $ddd $yyyy 12 $dirOut $outFil_ult ULTRA_12");

    $disIGS{"cou${wwwwd}_12.sp3"}     = $ultOrb;
    $disIGS{"cou${wwwwd}_12.erp"}     = $ultErp;
    $disIGS{"igu_cod${wwwwd}_12.sum"} = $ultAcc;
    $disCDDIS{$ultOrb} = "cou${wwwwd}_12.sp3";
    $disCDDIS{$ultErp} = "cou${wwwwd}_12.erp";
    $disCDDIS{$ultAcc} = "igu_cod${wwwwd}_12.sum";
#    $disCDDIS_long{$ultOrb} = "${long_u}_15M_ORB.sp3";
#    $disCDDIS_long{$ultErp} = "${long_u}_01D_ERP.erp",
#    $disCDDIS_long{$ultAcc} = "${long_u}_02D_SUM.txt";

    # Ultra 18
    $ultOrb = "${dirPre}US3${wwwwd}.${extPre}";
    $ultErp = "${dirIep}US3${wwwwd}.${extIep}";
    $ultAcc = "${dirOut}ULTRA_18.ACC";
    $long_u = "COD0IGSULT_${yym1}${dm1}1800_02D";
    system("$xa/make_accsum.com $ddd $yyyy 18 $dirOut $outFil_ult ULTRA_18");

    if($h_end >= 12) {
      $disIGS{"cou${wwwwd}_18.sp3"}     = $ultOrb;
      $disIGS{"cou${wwwwd}_18.erp"}     = $ultErp;
      $disIGS{"igu_cod${wwwwd}_18.sum"} = $ultAcc;
      $disCDDIS{$ultOrb} = "cou${wwwwd}_18.sp3";
      $disCDDIS{$ultErp} = "cou${wwwwd}_18.erp";
      $disCDDIS{$ultAcc} = "igu_cod${wwwwd}_18.sum";
#      $disCDDIS_long{$ultOrb} = "${long_u}_15M_ORB.sp3";
#      $disCDDIS_long{$ultErp} = "${long_u}_01D_ERP.erp",
#      $disCDDIS_long{$ultAcc} = "${long_u}_02D_SUM.txt";
   };

     # Ultra 00
    $ultOrb = "${dirPre}US0${wwwwdp1}.${extPre}";
    $ultErp = "${dirIep}US0${wwwwdp1}.${extIep}";
    $ultAcc = "${dirOut}ULTRA_24.ACC";
    $long_u = "COD0IGSULT_${yyyy}${ddd}0000_02D";
    system("$xa/make_accsum.com $dp1 $yyp1 00 $dirOut $outFil_ult ULTRA_24");

    if($h_end >= 18) {
      $disIGS{"cou${wwwwdp1}_00.sp3"}     = $ultOrb;
      $disIGS{"cou${wwwwdp1}_00.erp"}     = $ultErp;
      $disIGS{"igu_cod${wwwwdp1}_00.sum"} = $ultAcc;
      $disCDDIS{$ultOrb} = "cou${wwwwdp1}_00.sp3";
      $disCDDIS{$ultErp} = "cou${wwwwdp1}_00.erp";
      $disCDDIS{$ultAcc} = "igu_cod${wwwwdp1}_00.sum";
#      $disCDDIS_long{$ultOrb} = "${long_u}_15M_ORB.sp3";
#      $disCDDIS_long{$ultErp} = "${long_u}_01D_ERP.erp",
#      $disCDDIS_long{$ultAcc} = "${long_u}_02D_SUM.txt";
    };
  };

  # Submit files to data centers
  my $err=0;
#  my $logIERS = "${dirOut}/IERS.FTP";
#  my $retIERS = ftpUploadIERS(\%disIEP, $logIERS, ${yyyy}, ${ddd});
#  if($retIERS){
#    prtMess($bpe,"FTP_TO_IERS_FINISHED");
#  }else{
#    prtMess($bpe,"FTP_TO_IERS_FAILED");
#    msg2key("RAP","IGSRAPID $yyddd: IERS upload failed");
##    $err++;
#  }
#  my $logROB = "${dirOut}/ROB.FTP";
#  my $retROB  = ftpUploadROB(\%disIGS, $logROB, ${yyyy}, ${ddd});
#  if($retROB){
#    prtMess($bpe,"FTP_TO_ROB_FINISHED");
#  }else{
#    prtMess($bpe,"FTP_TO_ROB_FAILED");
#    $err++;
#  }
  my $logBKG = "${dirOut}/BKG.FTP";
  my $retBKG  = ftpUploadBKG(\%disIGS,$logBKG);
  if($retBKG){
    prtMess($bpe,"FTP_TO_BKG_FINISHED");
  }else{
    prtMess($bpe,"FTP_TO_BKG_FAILED");
    $err++;
  }

  map {print "CDDIS: $_ -> $disCDDIS{$_}\n";} (keys %disCDDIS);
  my $retCDDIS = upload_cddis_hash(\%disCDDIS);
#  my $retCDDISlong = upload_cddis_hash(\%disCDDIS_long);
  if($err>0){
    print "Could not submit solutions\n!";
    die;
  }

# Create short protocol file (2nd time)
# -------------------------------------
  my $prcFilshort = "${dirOut}IGSRAPID_SHORT.TXT";
  if (-e $ultFil) {
    $prcFilshort = "${dirOut}IGSULTRA_SHORT.TXT";
  }
  system("perl $ENV{AUTO}/typ_rap.pl  ${ddd} -q > $prcFilshort");

# Copy protocols to archive
# -------------------------
  if(1==1){
    my $ftpSum = "${dirOut}FTP${yyddd}.SUM";
#    &copy2archive($logIERS,$ftpSum);
    &copy2archive($logBKG,$ftpSum);
    #appFile("",0,$logROB,$ftpSum,1);

    my $savOut = "$PATH_SAV$CAMP_SAVRAP/${yyyy}/OUT";
    check_dir($savOut);

    my $prcFil = "${dirOut}IGSRAPID.PRC";
    appFile("",0,$ftpSum,$prcFil,1);
    &copy2archive($prcFil,$savOut);

    if(-e $ultFil) {
      my $sumFil = "${dirOut}IGSULTRA_${h_end}.${yy}_${ddd}";
      appFile("",0,$ftpSum,$sumFil);
      &copy2archive($sumFil,$savOut);
      &copy2archive($sumFil,"$PATH_WWW/code/igsultra.txt");
      &copy2archive($prcFilshort,"$PATH_WWW/code/igsultra_short.txt");
    }
    else {
      $prcFil = "${dirOut}IGSRAPID.${yy}_${ddd}";
      appFile("",0,$ftpSum,$prcFil,1);
      &copy2archive($prcFil,$savOut);
      &copy2archive($prcFil,"$PATH_WWW/code/igsrapid.txt");
      &copy2archive($prcFilshort,"$PATH_WWW/code/igsrapid_short.txt");
    }
  }
}

sub ftpUploadBKG{
  my %cont = %{(shift)};
  my $log  = shift;
  my $err  = "${log}_ERR";

  my $ret  = 1;

  my $host_bkg = "141.74.17.25";
  my $user_bkg = "code-put";
  my $port_bkg = "20022";

  unlink "${log}";
  unlink "${log}2";
  unlink "${err}";

  foreach my $file (keys %cont){
    print "BKG: $cont{$file} -> $file\n";
    system("scp -v -i $ENV{HOME}/.ssh/id_rsa_bkg -P $port_bkg  $cont{$file} ${user_bkg}\@${host_bkg}:IGSac/$file > ${err} 2>>${log}2");
  }
  if(-s $err){
    $ret = 0;
  }

  open LOG, "< ${log}2";
  open OUT, "> ${log}";
  print OUT "LOG BKG:\n";
  map {print OUT $_ unless /debug/} (<LOG>);
  close OUT;
  close LOG;

  print "Upload to BKG failed: $log\n";

  return $ret;
}

sub ftpUploadIERS{
  my %cont = %{(shift)};
  my $log  = shift;
  my $yyyy  = shift;
  my $ddd  = shift;
  open my $LOG, ">$log";

  my $host = "hpiers.obspm.fr";
  my $ret = 0;

  my $ftpCon;
  if($ftpCon = newFTP->new($host,t=>60,v=>2,o=>$LOG)){
    $ret = $ftpCon->login();
    if($ret == 1){
      $ftpCon->cwd("/pub/rotation/code");
      $ftpCon->ascii();
      foreach my $file (keys %cont){
        print "IERS: $cont{$file} -> $file\n";
        $ftpCon->put($cont{$file},$file);
      }
      $ftpCon->dir("*${yyyy}${ddd}*");
      $ftpCon->quit();
    }
  };
  close $LOG;
  print "RETURN IERS $ret\n";
  return $ret;
}

sub ftpUploadROB{
  my %cont = %{(shift)};
  my $log = shift;
  my $yyyy  = shift;
  my $ddd  = shift;
  open my $LOG, ">$log";

  my $host = "igs.oma.be";
  my $user = "cou";
  my $pass = "2sCLoYqU";
  my $ret = 0;
  my $ftpCon;
  if($ftpCon = newFTP->new($host,t=>60,v=>2,o=>$LOG)){
    $ret = $ftpCon->login($user,$pass);
    if($ret == 1){
      $ftpCon->ascii();
      foreach my $file (keys %cont){
        print "ROB: $cont{$file} -> $file\n";
        $ftpCon->put($cont{$file},$file);
      }
      $ftpCon->dir("*${yyyy}${ddd}*");
      $ftpCon->quit();
    }
  };
  close $LOG;
  print "RETURN ROB $ret\n";
  return $ret;
}

sub sendToArchive{
  my %cont = %{(shift)};
  foreach my $src (keys %cont){
    foreach my $trg (keys %{$cont{$src}}){
      print "TOARCH: $src -> $trg with $cont{$src}{$trg}\n";
      if($cont{$src}{$trg} eq "c"){
        &copy2archive($src,$trg,"c");
      }else{
        &copy2archive($src,$trg,);
      }
    }
  };
  return;
}
