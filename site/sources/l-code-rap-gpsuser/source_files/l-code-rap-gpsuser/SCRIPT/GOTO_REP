package GOTO_REP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  GOTO_REP
#
# Purpose :  Execute a GOTO statement with the target depending from flag files
#              goto PARAM2: in case of reprocessing
#              goto PARAM3: no flag file
#              goto PARAM4: if all GLONASS data are processed in one cluster
#
# Author  :  R. Dach
# Created :  22-Jul-2008
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($param2, $param3, $param4, $camp_pth, $campaign) =
    $bpe->getKeys(
      'PARAM2', 'PARAM3','PARAM4','CAMP_PTH','CAMPAIGN');

  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");
  my $glo1clu = (-e "$camp_pth$campaign/MSC/GLO_ONE_CLUST.FLG");


# Write the "next jobs" statement
# -------------------------------
  my $target = $repro ? $param2 : $param3;
  $target = $param4 if $glo1clu;
  prtGoto($bpe,$target);

}
