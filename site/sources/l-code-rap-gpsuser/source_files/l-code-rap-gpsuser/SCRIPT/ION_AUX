use File::Compare qw(compare);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yydddp1, $yydddp2,
      $wwwwd, $wwwwdp1, $wwwwdp2,
      $mjd, $e, $f, $sav, $dis, $upd,
      $dirDcb, $dirIon, $dirOut) =
    $bpe->getKeys('$YD+0', '$YD+1', '$YD+2',
                  '$WD+0', '$WD+1', '$WD+2',
                  '$JD+0', 'V_E', 'V_F', 'V_SAV', 'V_DIS', 'V_UPD',
                  'DIR_DCB', 'DIR_ION', 'DIR_OUT');


}
