use strict;
use warnings;
use lib $ENV{BPE};

sub run {
  my ($bpe) = @_;

  # Run SATCLK2
  # -----------
  my $PGMNAM = "SATCLK2";
  $bpe->RUN_PGMS($PGMNAM);
}
