package CLKP_CHK;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name:      CLKP_CHK
#
# Purpose:   Checks the existence of the clock prediction TPPyyddd for day -2
#
# Programs:
#
# PARAMx:
#
# Author  :  R. Dach
# Created :  17-Nov-2005               Last modified: __-___-____
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------

use strict;
use lib "$ENV{BPE}";
use bpe_util;


sub run
{
  my $bpe = shift;


# Get variables
# -------------
  my ($yydm2,
      $param2,$V_U,
      $dirClk,$extClk) =
      $bpe->getKeys(
      '$YD-2',
      'PARAM2','V_U',
      'DIR_CLK','EXT_CLK');


# Set the name of the clock predition file
# ----------------------------------------
  my $filclk = "${dirClk}${V_U}P${yydm2}.${extClk}";


# Test existence of file
# ----------------------
  if (-s $filclk) {
    prtMess($bpe,"Clock prediction file $filclk found");

  } else {
    prtMess($bpe,"Clock prediction file $filclk not found");
    prtMess($bpe,"skipping CODSPP");

    prtGoto($bpe,"$param2");
  }

}
