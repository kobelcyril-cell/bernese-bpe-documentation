package GPSCLUAP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GPSCLUAP
#
# Purpose :  Prepare parallel GPSEST run (cluster solution)
#
# Programs:
#
# Author  :  M. Meindl
# Created :  30-Jul-2003               Last modified: 10-Feb-2005
#
# Changes :  26-Jan-2006 mm: New initPar call (w/o tmpFil)
#            10-Feb-2005 mm: Old date variables removed
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yyddd,$ssss,$outDir,$solDir,$clbDir) =
       $bpe->getKeys('$YD+0','$S+0',"DIR_OUT","DIR_NEQ","DIR_CLB");


# Define directories and file names
# ---------------------------------
  my @cluFil = glob("${clbDir}${yyddd}_??.CLB");


# Remove residual files, output files, NQ0's
# ------------------------------------------
  unlink glob("${outDir}EST${ssss}???.OUT");
  unlink glob("${outDir}EST${ssss}???.RES");
  unlink glob("${solDir}EST${ssss}???.NQ0");


# Initialize parallel run
# -----------------------
  initPar_Fl($bpe,@cluFil);

#  system("echo GMF > ${outDir}/../MSC/TRP_12343.FLG");
#  system("echo GMF > ${outDir}/../MSC/TRP_12344.FLG");

}
