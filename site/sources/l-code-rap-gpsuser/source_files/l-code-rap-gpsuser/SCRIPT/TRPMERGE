package TRPMERGE;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name:      TRPMERGE
#
# Purpose:   Merges TRP files
#
# Programs:
#
# PARAMx:    PARAM1: filename of the merged TRP file
#            PARAM2: filename of the "master" TRP file where to start from
#                    (may be empty)
#            PARAM3: filename(s) of the TRP file(s) to be merged in
#            (e.g., "TP_$YD+0" or even "????$S+0"; wildcards only for PARAM3)
#
# Author  :  R. Dach
# Created :  17-Nov-2005
#
# Changes :  23-Jun-2009 rd: Extension for session instead of day
#            07-Jun-2016 RD: Add version with compatible attitude modelling
#            07-Jun-2016 AV: Handle V_XX variables in param
#            15-May-2020 LP: Allow for individual header size determined by &getTropHeadInf
#            18-Jan-2022 AV: modify location of filmerge.pl
#
# ----------------------------------------------------------------------------

use strict;   # Required to have no variable mismatch with the external in
              # perl program 'do ("${AUTO}/filmerge.pl");'
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use statistics_util;


sub run
{
  my $bpe = shift;


# Get variables
# -------------
  my $parat1 = "$$bpe{PARAM1}0";
  my $parat2 = "$$bpe{PARAM2}0";
  my $parat3 = "$$bpe{PARAM3}0";

  $parat1 =~ s/^([A-Z][A-Z])_/\$($1)_/;
  $parat2 =~ s/^([A-Z][A-Z])_/\$($1)_/;
  $parat3 =~ s/^([A-Z][A-Z])_/\$($1)_/;

  my ($param1, $param2 ,$param3 ,$u,$x,
      $param1a,$param2a,$param3a,
      $param1b,$param2b,$param3b,
      $param1c,$param2c,$param3c,
      $dirTrp,$extTrp) =
      $bpe->getKeys(
       'PARAM1',        'PARAM2',        'PARAM3',       'U','X',
       $$bpe{PARAM1},   $$bpe{PARAM2},   $$bpe{PARAM3},
      "$$bpe{PARAM1}0","$$bpe{PARAM2}0","$$bpe{PARAM3}0",
      "${parat1}","${parat2}","${parat3}",
      'DIR_TRP','EXT_TRP');

  $param1 = ( substr($param1, 0,1) eq '$' ) ?
            ( substr($param1,-1) eq '+' ) ? $param1b : $param1a : $param1c;
  $param2 = ( substr($param2, 0,1) eq '$' ) ?
            ( substr($param2,-1) eq '+' ) ? $param2b : $param2a : $param2c;
  $param3 = ( substr($param3, 0,1) eq '$' ) ?
            ( substr($param3,-1) eq '+' ) ? $param3b : $param3a : $param3c;

  # Put all TRP files into a list for merging
  # -----------------------------------------
  if ( ${param1} ne "") {
    my $outFile = (glob("${dirTrp}${param1}.${extTrp}"))[0];
    prtMess($bpe,"Result file: $outFile");

    my  @trpList = ();
    push @trpList, glob("${dirTrp}${param2}.${extTrp}") unless ${param2} eq "";
    push @trpList, glob("${dirTrp}${param3}.${extTrp}") unless ${param3} eq "";

    # Merge the TRP files
    # -------------------
    if (scalar @trpList) {
      my $tmp = "$u/WORK/trpmerge.$$";

      my $trp = shift @trpList;
      prtMess($bpe,"Master file: $trp");
      copyfile($trp,$outFile);

      my @ARGV_save = @ARGV; # Save the current @ARGV-list
      while (scalar @trpList) {
        copyfile($outFile,$tmp);
        $trp = shift @trpList;
        prtMess($bpe,"Added  file: $trp");

        my ($ERR_STATE1,$tropFileVers1,$nHeadLines1,$numEpoTrop1) = &getTropHeadInf($tmp);
        my ($ERR_STATE2,$tropFileVers2,$nHeadLines2,$numEpoTrop2) = &getTropHeadInf($trp);

        @ARGV=("$tmp","$trp","$outFile","$nHeadLines1","1","$nHeadLines2");
        do ("$ENV{AUTO}/filmerge.pl");
      }
      @ARGV = @ARGV_save; # Save the current @ARGV-list
    }
  }
}
