package CRD_CHK;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  CRD_CHK
#
# Purpose :  Check all station coordinate corrections/improvements in order
#            to remove the corresponding station in case of significant
#            deviations or to initiate a BPE stop.
#
# Programs:  HELMR1
#
# Remark  :
#
# PARAMs  :  PARAM2 - goto PID to continue processing
#                     (after removing faulty station)
#
# Author  :  S. Schaer
#
# Created :  13-Sep-2023
#
# Changes :  14-Sep-2023 SS: Extract and report detected position deviations
#            19-Sep-2023 SS: Report detected anomalies in separate LST file
#            17-Oct-2023 SS: Save disputed CRD file in TMP subdirectory
#
# ============================================================================

use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,$yyssss,$yyyyssss,$ssss,$wwwwd,$mjd,
    $param2,
    $pcfFil,$startcount,
    $dirOut,$extOut,$dirFix,$extFix,$dirObs,
  ) =
  $bpe->getKeys(
    '$YD+0','$YSS+0','$YYYSS+0','$S+0','$WD+0','$JD+0',
    'PARAM2',
    'PCFFIL','STARTCOUNT',
    'DIR_OUT','EXT_OUT','DIR_FIX','EXT_FIX','DIR_PZH',
  );

  $pcfFil = (split('\.',$pcfFil))[0];

# Delete CRD_CHK FIX file
# -----------------------
  my $d = substr($wwwwd,4,1);
  my $nam = "CRD_CHK_DOW${d}";
  my $fixFil = "${dirFix}${nam}.${extFix}";
  unlink($fixFil);

  if      ($pcfFil eq "IGSULTRA") {
    $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","NLIMIT","600");
    $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","ELIMIT","600");
    $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","ULIMIT","1200");
  } elsif ($pcfFil eq "IGSRAPID") {
    $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","NLIMIT","400");
    $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","ELIMIT","400");
    $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","ULIMIT","800");
  } else {
##    $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","NLIMIT","400");
##    $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","ELIMIT","400");
##    $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","ULIMIT","800");
    prtMess($bpe,"N/E/ULIMIT taken from HELMER1.INP");
  }

# Run program
# -----------
  $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","SYSOUT",$nam)  if $param2 ne "";
  $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","LISTFIL",$nam) if $param2 ne "";
  $bpe->putKey("$ENV{U}/PAN/MENU_EXT.INP","EXT_OUT","LST");

  my $PGMNAM = "HELMR1";
  $bpe->RUN_PGMS($PGMNAM);

# Check whether faulty station detected
# -------------------------------------
  my $outFil = $bpe->getKey("$ENV{U}/INP/HELMR1.INP","SYSOUT");
  $fixFil = $bpe->getKey("$ENV{U}/INP/HELMR1.INP","LISTFIL");
  if (-e $fixFil) {
    if ($param2 ne "") {
      copy($outFil,"${dirOut}CRD_CHK_${yyyyssss}.LST");
      copy($outFil,"${outFil}_${startcount}");
      my $crdFil = $bpe->getKey("$ENV{U}/INP/HELMR1.INP","COORD2");
      my $tmpFil = $crdFil;
      $tmpFil =~ s/\/STA\//\/TMP\//g;
      check_dir("${dirOut}../TMP/");
      copy($crdFil,$tmpFil);

      open(FIL,"<$fixFil");
      my $ok = 0;
      while ($lin=<FIL>) {
        chomp($lin);
        if ($lin ne "" && $ok) {
          my $sta4 = substr($lin,0,4);
          my $res  = `grep '$lin' $outFil | tail -1`;
          chomp($res);
          $res = substr($res,1,);
          prtMess($bpe,"Faulty station detected: $res");
          my $neu = join("/",split(" ",substr($res,16,)));
          my $msg = "${pcfFil}_${yyssss}: Faulty station ${sta4} excluded due to big N/E/U corrections: ${neu} mm";
          msg2key("BPE",$msg);
          print "$msg\n";
          my @filObs = glob("${dirObs}${sta4}${ssss}.?Z?");
          map { print "DEL: $_\n"; unlink($_) } @filObs;
          my $lstFil = "${dirOut}${pcfFil}_CRD_CHK.LST";
          `echo '$yyyyssss $mjd $res' >> $lstFil`;
        }
        $ok = 1 if substr($lin,0,1) eq "\*";
      }
      close(FIL);
      prtGoto($bpe,$param2);
    } else {
      prtMess($bpe,"BPE stopped due to faulty station(s)");
      die "BPE stopped due to faulty station(s)\n";
    }
  } else {
    prtMess($bpe,"Everything OKAY");
  }

}
