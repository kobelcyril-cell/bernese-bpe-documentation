package CRTPRE;
@ISA = ("RUNBPE");
# =============================================================================
#
# Name    :  CRTPRE
#
# Purpose :  Create PRE file
#
# Programs:  STDPRE, PREWEI
#
# Author  :  S. Schaer
#
# Created :  28-Jun-2004
#
# Changes :  03-Dec-2013 SL: New ULTRA products (U$T)
#
# =============================================================================

use strict;
use warnings;

# Local packages
use lib "$ENV{BPE}";
use bpe_util qw(rdUltFlg gtUltVrs setUserVar);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,
    $CAMP_PTH,$CAMPAIGN,
  ) =
  $bpe->getKeys(
    '$YD+0',
    'CAMP_PTH','CAMPAIGN',
  );
  my $PGMNAM;

# Prepare necessary info
# ----------------------
  my $ultFil = "${CAMP_PTH}${CAMPAIGN}/MSC/ULT$yyddd.FLG";
  my($h_end,$h_tro,$h_rnx,$h_chr) = &rdUltFlg($ultFil);
  my($T) = &gtUltVrs($h_end,$h_chr);
  &setUserVar($bpe,"T",$T);

# Run programs
# ------------
  $PGMNAM = "STDPRE";
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "PREWEI";
  $bpe->RUN_PGMS($PGMNAM);
}

# =============================================================================

__END__
