package DNI_COP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  DNI_COP
#
# Purpose :  Copy reference files for DCBIONO BPE process
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  21-Dec-2011
#
# Changes :  22-Dec-2011/ss: Use $camp_pth$campaign
#            28-Feb-2012/hb: Correct typo
#            29-Mar-2022 AV: Use copySkl
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $crdInf, $psdInf, $dirOut,$pthSkl) =
    $bpe->getKeys('$YSS+0', 'V_CRDINF', 'V_PSDINF', 'DIR_OUT',
    'PTH_SINEXIN');

# Copy reference files
# --------------------
  my $psdFil = $psdInf eq ""? "" : "${psdInf}.PSD";
  system("$ENV{AUTO}/copyRef.pl ${dirOut}.. $crdInf $psdFil");

  print "Execute $ENV{AUTO}/copySkl.pl DCBIONO $pthSkl\n";
  system("$ENV{AUTO}/copySkl.pl DCBIONO $pthSkl");

# Delete PRC file
# ---------------
  unlink("${dirOut}DNI${yyssss}.PRC");

}
