package AMBVER_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  AMBVER_P
#
# Purpose :  Perform ambiguity verification
#
# PARAMs  :  PARAM1 - 4-character baseline name
#
# Author  :  S. Schaer
# Created :  20-Sep-2010
#
# Changes :  22-Sep-2010/ss: Adapted from EPNFINAL to IGSFINAL/IGSRAPID
#            24-Sep-2010/ss: Error prevention in case of $rms==0.0000
#            01-Mar-2011/ss: Maximum ratio form 1.5 to 1.7
#            07-May-2012/ss: Send message just in case of very serious problem
#            30-Sep-2014 lp: New GNSS selection using setGNSS, remove $v_gnssar
#            11-Nov-2019 av: Use sub to extract RMS
#            12-Nov-2020 av: Thread baselines with <10 GLO ambiguities as bad RMS
#            08-Aug-2023 eb: re-init ambiguities in case of big rms
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($param1, $ddd, $yyddd, $dirOut, $extOut, $pcfFil, $mjd) =
    $bpe->getKeys('PARAM1', '$+0', '$YD+0', 'DIR_OUT', 'EXT_OUT', 'PCFFIL', '$JD+0');

# Set filename variable
# ---------------------
  setUserVar($bpe,"FFFF",$param1);


# Run program
# -----------
  my $verFil = "${dirOut}VER${yyddd}.PRC";
  my ($rms1,$rms1a,$rms1b,$rms2,$rms2a,$rms2b,$rms20,$rms2a0,$rms2b0,$rmsqif,$str);
  my ($gloamb,$act,$rat,$rat0,$ratmax,$rmsmax,$rmsmin) = (0,0,1,1,1.7,0.003,0.001);

  &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","ALL");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MINEL","3");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SAMPLE","180");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT","\$(FFFF)\$S+0V");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FREQUENCY","L3");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DIFFION","0");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSTRAT","NONE");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","APRL1L2","0");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSAVE","0");

  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

  $rms1 = getPosteriori($$bpe{SYSOUT})+0.000001;
  $gloamb = `grep '^....[0-9]    1  1[0-9][0-9] ' $$bpe{SYSOUT} | wc -l`+0;
  $gloamb = -$gloamb if $gloamb < 10;
  print "TEST: $yyddd $param1 : ".$yyddd eq "20339" . " and ".$param1 =~ /HRSL/."\n";
  $gloamb = -1 if $yyddd eq "20339" && $param1 =~ /HRSL/;

  $ratmax = $ratmax*$rmsmin/$rms1 if $rms1 < $rmsmin;
  copyfile("$$bpe{SYSOUT}","$$bpe{SYSOUT}_");
  if ($gloamb > 0) {
    &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","G");
    $PGMNAM = "GPSEST";
    $bpe->RUN_PGMS($PGMNAM);
    $rms1a = getPosteriori($$bpe{SYSOUT})+0.000001;

    &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","R");
    $PGMNAM = "GPSEST";
    $bpe->RUN_PGMS($PGMNAM);
    $rms1b = getPosteriori($$bpe{SYSOUT})+0.000001;
  }

  &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","ALL");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","APRL1L2","1");
  $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

  $rms2  = getPosteriori($$bpe{SYSOUT})+0.000001;
  $rms20 = $rms2;

  if ($gloamb > 0) {
    &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","G");
    $PGMNAM = "GPSEST";
    $bpe->RUN_PGMS($PGMNAM);
    $rms2a = getPosteriori($$bpe{SYSOUT})+0.000001;
    $rms2a0 = $rms2a;

    &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","R");
    $PGMNAM = "GPSEST";
    $bpe->RUN_PGMS($PGMNAM);
    $rms2b  = getPosteriori($$bpe{SYSOUT})+0.000001;
    $rms2b0 = $rms2b;

    if ($rms2/$rms1 > $ratmax || $rms2a/$rms1a > $ratmax || $rms2b/$rms1b > $ratmax) {
      prtMess($bpe,"Action: Extra QIF ambiguity resolution (specific to GNSS)");
      $act = 1;

      $PGMNAM = "SATMRK";
      $bpe->RUN_PGMS($PGMNAM);

      &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","ALL");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MINEL","10");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SAMPLE","30");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT","\$(FFFF)\$S+0Q");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FREQUENCY","L1\&L2");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DIFFION","1");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSTRAT","QIF");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","APRL1L2","0");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSAVE","1");

      $PGMNAM = "GPSEST";
      $bpe->RUN_PGMS($PGMNAM);

      $rmsqif = getPosteriori($$bpe{SYSOUT})+0;

      &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","ALL");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MINEL","3");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SAMPLE","180");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT","\$(FFFF)\$S+0V");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FREQUENCY","L3");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DIFFION","0");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSTRAT","NONE");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","APRL1L2","1");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSAVE","0");

      $PGMNAM = "GPSEST";
      $bpe->RUN_PGMS($PGMNAM);

      $rms2 = getPosteriori($$bpe{SYSOUT})+0.000001;

      &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","G");
      $PGMNAM = "GPSEST";
      $bpe->RUN_PGMS($PGMNAM);
      $rms2a = getPosteriori($$bpe{SYSOUT})+0.000001;

      &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","R");
      $PGMNAM = "GPSEST";
      $bpe->RUN_PGMS($PGMNAM);
      $rms2b = getPosteriori($$bpe{SYSOUT})+0.000001;
    }

    if ($rms2/$rms1 > $ratmax || $rms2a/$rms1a > $ratmax || $rms2b/$rms1b > $ratmax) {
      prtMess($bpe,"Action: Extra QIF ambiguity resolution (specific to GPS)");
      $act = 2;

      $PGMNAM = "SATMRK";
      $bpe->RUN_PGMS($PGMNAM);

      &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","G");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MINEL","10");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SAMPLE","30");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT","\$(FFFF)\$S+0Q");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FREQUENCY","L1\&L2");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DIFFION","1");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSTRAT","QIF");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","APRL1L2","0");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSAVE","1");

      $PGMNAM = "GPSEST";
      $bpe->RUN_PGMS($PGMNAM);

      $rmsqif = getPosteriori($$bpe{SYSOUT})+0;

      &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","G");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MINEL","3");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SAMPLE","180");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT","\$(FFFF)\$S+0V");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FREQUENCY","L3");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DIFFION","0");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSTRAT","NONE");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","APRL1L2","1");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSAVE","0");

      $PGMNAM = "GPSEST";
      $bpe->RUN_PGMS($PGMNAM);

      $rms2 = getPosteriori($$bpe{SYSOUT})+0.000001;
      $rms2a = $rms2;
      $rms2b = $rms1b;
    }

    if ($rms2/$rms1 > $ratmax) {
      prtMess($bpe,"Action: Ambiguity initialization");
      $act = 3;

      $PGMNAM = "SATMRK";
      $bpe->RUN_PGMS($PGMNAM);

      $rms2 = $rms1;
    }

  } else {

    if ($rms2/$rms1 > $ratmax) {
      prtMess($bpe,"Action: Extra QIF ambiguity resolution");
      $act = 1;

      $PGMNAM = "SATMRK";
      $bpe->RUN_PGMS($PGMNAM);

      &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","ALL");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MINEL","10");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SAMPLE","30");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT","\$(FFFF)\$S+0Q");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FREQUENCY","L1\&L2");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DIFFION","1");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSTRAT","QIF");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","APRL1L2","0");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSAVE","1");

      $PGMNAM = "GPSEST";
      $bpe->RUN_PGMS($PGMNAM);

      $rmsqif = getPosteriori($$bpe{SYSOUT})+0;

      &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","ALL");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MINEL","3");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SAMPLE","180");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT","\$(FFFF)\$S+0V");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FREQUENCY","L3");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DIFFION","0");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSTRAT","NONE");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","APRL1L2","1");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSAVE","0");

      $PGMNAM = "GPSEST";
      $bpe->RUN_PGMS($PGMNAM);

      $rms2 = getPosteriori($$bpe{SYSOUT})+0.000001;
    }

    if ($rms2/$rms1 > $ratmax) {
      prtMess($bpe,"Action: Ambiguity initialization and removal of QIF OUT file");
      $act = 3;

      $PGMNAM = "SATMRK";
      $bpe->RUN_PGMS($PGMNAM);

      $rms2 = $rms1;

##      unlink("${dirOut}${param1}${ddd}Q.${extOut}");
      unlink glob("${dirOut}${param1}${ddd}?.${extOut}");
    }

  }
  if($gloamb<0){
      print "Only ".-$gloamb." GLONASS ambiguties available\n";
      $PGMNAM = "SATMRK";
      $bpe->RUN_PGMS($PGMNAM);
  }

  if ($rms2 > $rmsmax || $rms2a > $rmsmax || $rms2b > $rmsmax) {
    prtMess($bpe,"Warning: Big RMS caused ambiguity initialization");
    $act = -1;
# no better idea as to try re-initialization of ambiguities
    $PGMNAM = "SATMRK";
    $bpe->RUN_PGMS($PGMNAM);
  }

# Print one summary line per baseline
# -----------------------------------
# Legend:
# - ACT:-1: Big RMS
# - ACT:0: OK
# - ACT:1: Extra QIF step
# - ACT:2: Extra QIF step (restricted to GPS)
# - ACT:3: Ambiguity initialization
  if ($act >= -1) {
    $rat = $rms2/$rms1;
    $rat0 = $rms20/$rms1;
    $str = sprintf("%4s%3s0(%5s): ACT:%1d %3d %7.3f %7.3f %6.4f %6.4f %6.4f %6.4f %6.4f %6.4f %6.4f %6.4f %6.4f %6.4f",$param1,$ddd,$yyddd,$act,$gloamb,$rat,$rat0,$rms1,$rms2,$rms1a,$rms2a,$rms1b,$rms2b,$rms20,$rms2a0,$rms2b0,$rmsqif);

    prtMess($bpe,$str);
    `echo '$str' >> $verFil`;
  }
##  if ($act != 0) {
  if ($act >= 3) {
    $pcfFil = (split('\.',$pcfFil))[0];
    msg2key("BPE","AMBVER($pcfFil): $str");
  }

  unlink("${dirOut}${param1}${ddd}V.${extOut}");

}

sub getPosteriori{
  my $file = shift;
  my $ret  = 0;
  open INP, "< $file";
  foreach (<INP>){
    if(/POSTERIORI/){
        $ret = substr($_,38,10);
    }
    if(/posteriori/){
        $ret = substr($_,38,14);
    }
  }
  close INP;
  return $ret;
}
