package ORB_V3M;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ORB_V3M
#
# Purpose :  ORBIT QUALITY CHECKS:
#            3-DAY ORBIT OVERLAPS (ORBGEN)
#
# Programs:
#
# Author  :  S. Schaer
# Created :  22-Feb-2011
#
# Changes :  23-Feb-2011/ss: Execute orb_ver.com
#            24-Feb-2011/ss: Make use of new options concerning orb_ver.com
