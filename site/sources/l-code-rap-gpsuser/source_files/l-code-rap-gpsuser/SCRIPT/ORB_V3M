use strict;
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd,$yydddm1,$yydddm2,$ddd,$dddm1,$dddm2,$wwww,$wd,$wd0,$CAMP_PTH,$CAMPAIGN) =
    $bpe->getKeys('$YD+0','$YD-1','$YD-2','$-1','$-2','$-3','$W-2','$WD-2','$WD-1','CAMP_PTH','CAMPAIGN');

# Check if this is an ULTRA:
# -------------------------
##  my $ultFil = "$CAMP_PTH${CAMPAIGN}/MSC/ULT$yyddd.FLG";  # ultra-flag
##  my ($h_end,$h_tro,$h_rnx,$h_chr) = rdUltFlg($ultFil);
##  if (-e $ultFil){
##      my $endTim =sprintf("%02d%6s",$h_end,' 00 00');
##      $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","ENDTIM","$endTim");}

# PlusMinus-Variable
# ------------------
  setMinusPlus($bpe,-3,-1);

# Copy ERP files
# --------------
  copy("$CAMP_PTH${CAMPAIGN}/ORB/RA_${yyddd}.ERP","$CAMP_PTH${CAMPAIGN}/ORB/RAM1${ddd}.ERP");
  copy("$CAMP_PTH${CAMPAIGN}/ORB/RA_${yydddm1}.ERP","$CAMP_PTH${CAMPAIGN}/ORB/RAM1${dddm1}.ERP");
  copy("$CAMP_PTH${CAMPAIGN}/ORB/RA_${yydddm2}.ERP","$CAMP_PTH${CAMPAIGN}/ORB/RAM1${dddm2}.ERP");

# Run program
# -----------
  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);

# Remove ERP files
# ----------------
  unlink("$CAMP_PTH${CAMPAIGN}/ORB/RAM1${ddd}.ERP");
  unlink("$CAMP_PTH${CAMPAIGN}/ORB/RAM1${dddm1}.ERP");
  unlink("$CAMP_PTH${CAMPAIGN}/ORB/RAM1${dddm2}.ERP");

# Create LST file for PREWEI
# --------------------------
##  system("$ENV{AUTO}/orb_lst_rap.com $ddd $CAMP_PTH${CAMPAIGN}") && die;

  system("$ENV{AUTO}/orb_ver.com $wd $CAMP_PTH${CAMPAIGN} V3M 7 $wwww") if substr($wd,4,1) eq "6";
  system("$ENV{AUTO}/orb_ver.com $wd0 $CAMP_PTH${CAMPAIGN} V3M 7 $wwww") if substr($wd0,4,1) eq "6";
  system("$ENV{AUTO}/orb_ver.com $wd0 $CAMP_PTH${CAMPAIGN} V3M -32");
}
