package COMPAR2;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  COMPAR2
#
# Purpose :  Compare bernese coordinate files of last 7 days
#
# Programs:  COMPAR2
#
# Author  :  M. Meindl
# Created :  03-Aug-2003               Last modified: 30-Mar-2006
#
# Changes :  30-Mar-2006 mm: setPlusMinus replaced by setMinusPlus
#            15-Jun-2020 av: Skip if 3-day solution is skipped
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;

  my ($skip_sol) =  $bpe->getKeys('V_SKIP3D');
# Set 7-day overlap
# -----------------
##  setPlusMinus($bpe,0,-6);
  setMinusPlus($bpe,-6,0);


# Run program
# -----------
  my $PGMNAM = "COMPAR2";
  if($skip_sol ne 'Y'){
    $bpe->RUN_PGMS($PGMNAM);
  }
}
