package RNX2FRQ;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RNX2FRQ
#
# Purpose :  Perform GLONASS frequency channel search using RNXSMT for data
#            verification purposes
#
# PARAMs  :  PARAM1 - Optional minus parameter
#
# Author  :  S. Schaer
# Created :  27-Jan-2022
#
# Changes :  27-Jan-2022 SS: Derived from RNX2DCB script
#            31-Jan-2022 SS: Some refinements
#            12-Jul-2022 SS: Correctly deleted SMT files
#            13-May-2025 SS: SATCRUX changed from SAT_$Y+0 to SAT_0000
#                            (in order to consider all GLONASS data)
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;
use File::Compare qw(compare);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $mjd, $b, $sav, $dirRxo, $dirSmt, $dirDcb, $dirOut, $param1) =
    $bpe->getKeys('$YSS+0', '$JD+0', 'V_B', 'V_SAV', 'DIR_RXO', 'DIR_SMT', 'DIR_DCB', 'DIR_OUT', 'PARAM1');

# Set variables
# -------------
  my ($yyyy,$ssss,$yy,$ddd,$yyddd, $mm, $dd, $mjd1) = gps_date("-mjd $mjd            -o %Y %j0 %y %j %y%j %m %d %IJ");
     ($yyyy,$ssss,$yy,$ddd,$yyddd, $mm, $dd, $mjd1) = gps_date("-mjd $mjd -d $param1 -o %Y %j0 %y %j %y%j %m %d %IJ") unless $param1 eq "";

# Count RINEX files and return in case of no file
# -----------------------------------------------
  @staLst = glob("${dirRxo}?????????_${yyyy}${ssss}.RXO");
  $numLst = @staLst;
  prtMess($bpe,"$numLst RXO files found");
  die "No RXO files found" if $numLst==0;
  return if $numLst==0;

# Check all available RINEX observation files
# -------------------------------------------
  my @useLst = ();
  foreach my $filRxo (@staLst) {
    $nam = (split('\.',basename($filRxo)))[0];
# Add stations to be excluded here:
    next if substr($nam,0,4) eq "____" && $mjd1==99999;
    $sta = substr($nam,0,9);
    print "RXO: $sta $nam $filRxo\n";

    my $gloNum = `grep '^R[0-9][0-9] ' $filRxo | wc -l`+0;
    if ($gloNum>=2880) {
      prtMess($bpe,"GLONASS data available for station $nam");
      push(@useLst,$nam);
    } else {
      prtMess($bpe,"GLONASS data unavailable for station $nam");
    }
  }

# Run program
# -----------
##  $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","RNXFIL_SHORT","????${ssss}");
##  $bpe->putKey("$ENV{U}/PAN/MENU_EXT.INP","EXT_RXO","${yy}O");
##  $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","RNXFIL_BSW","?????????_${yyyy}${ssss}");
  replaceSelLst($bpe,"RNXSMT","RNXFIL_BSW",@useLst);
  map { print "LST: $_\n" } @useLst;
##  $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","SYSOUT","RNXSMT_${ddd}");
  $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","SYSOUT","RNXSMT_${ssss}");
  $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","SESSION_YEAR","$yyyy");
  $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","SESSION_STRG","$ssss");
  $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","STADAT","$yyyy $mm $dd");
  $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","ENDDAT","$yyyy $mm $dd");
  $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","SATCRUX","SAT_0000");

##  $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/storage/homefs/l_code_rap/GENTEST/EXE_GNU");

  my $PGMNAM = "RNXSMT";
  $bpe->RUN_PGMS($PGMNAM);

##  system("grep 'FREQ-NUM' ${dirOut}RNXSMT_${ddd}.OUT > ${dirOut}GLOFRQ_${ddd}.LST");
  system("grep 'FREQ-NUM' ${dirOut}RNXSMT_${ssss}.OUT > ${dirOut}FRQ${yyddd}.LST");
  my @smtLst = glob("${dirSmt}????${ssss}.SMT");
  my $smtFil;
  foreach (@staLst) {
    $sta = substr(basename($_),0,4);
    $fil = "${dirSmt}${sta}${ssss}.SMT";
    unless (-s $fil) {
      prtMess($bpe,"UNUSABLE OBSERVATION DATA: $_");
      print "SMT: $fil not found\n";
      `echo '$_' >> ${dirOut}RINEX_BAD.LST`;
    }
  }
  unlink(glob("${dirSmt}?????????_${yyyy}${ssss}.SMT"));

}
