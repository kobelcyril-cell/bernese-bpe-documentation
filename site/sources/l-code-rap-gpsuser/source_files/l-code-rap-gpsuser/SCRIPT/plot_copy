package plot_copy;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  plot_copy
#
# Purpose :  Copy files for plotting to  campaign $P/PLOTS/
#
# Programs:  plot_copy
#
# Author  :  R. Dach   
# Created :  23-Jan-2024
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------

use strict;

use File::Basename;
use lib $ENV{EXE};
use Gps_Date;
use lib $ENV{AUTO};
use igs_device;
use gpsutil;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ( $myDate, $numDays, $satConst, $mapCrd, $mapHlm, 
       $satNum, $satNumDays, $staNum, $staNumDays, 
       $ambXtr, $ambXtrDays, $gpsXtr, $gpsXtrDays, $obsXtr, $obsXtrDays,
       $ccrnxc, $ccrnxcDays, $stdele, $stdeleDays, $helmr1, $helmr1Days, 
       $dirEle, $dirPre, $dirCrd, $dirSum, $dirLst,
       $extEle, $extPre, $extCrd, $extSum, $extLst ) = 
      $bpe->getKeys(
      'V_DATE','V_NUMDAYS','V_SATCONST','V_MAPCRD','V_MAPHLM',
      'V_SATNUM','V_SATNUMDAYS','V_STANUM','V_STANUMDAYS',
      'V_AMBXTR','V_AMBXTRDAYS','V_GPSXTR','V_GPSXTRDAYS','V_OBSXTR','V_OBSXTRDAYS',
      'V_CCRNXC','V_CCRNXCDAYS','V_STDELE','V_STDELEDAYS','V_HELMR1','V_HELMR1DAYS',
      'DIR_ELE','DIR_PRE','DIR_CRD','DIR_SUM','DIR_LST',
      'EXT_ELE','EXT_PRE','EXT_CRD','EXT_SUM','EXT_LST');

  print "myDate = \"$myDate\"\n";
  $myDate = "*" if "$myDate" eq "";
  print "myDate = \"$myDate\"\n";

  $Set_Verify=1;

# Copy latest ELE-file from IGSRAPID to plot the constellation
# ------------------------------------------------------------
  if ( "$satConst" ne "" ) {
    my $eleFil = $satConst;
    unlink("${dirEle}${eleFil}.${extEle}");
    my $inpEle = (glob("${PATH_SAV}${CAMP_SAVRAP}/20??/ORB/RQ_${myDate}.ELE"))[-1];
    copyfile($inpEle,"${dirEle}${eleFil}.${extEle}");
  }


# Copy latest CRD-file from IGSRAPID to plot the network map
# ----------------------------------------------------------
  if ( "$mapCrd" ne "" ) {
    unlink("${dirCrd}${mapCrd}.${extCrd}");
    my $inpCrd = (glob("${PATH_SAV}${CAMP_SAVRAP}/20??/STA/RA_${myDate}.CRD"))[-1];
    copyfile($inpCrd,"${dirCrd}${mapCrd}.${extCrd}");
  }


# Copy latest HELMR-file from IGSRAPID to plot the map with residuals
# -------------------------------------------------------------------
  if ( "$mapHlm" ne "" ) {
    unlink("${dirCrd}${mapCrd}.${mapHlm}");
    my $inpCrd = (glob("${PATH_SAV}${CAMP_SAVRAP}/20??/STA/RA_${myDate}.CRD"))[-1];
    copyfile($inpCrd,"${dirCrd}${mapHlm}.${extCrd}");

    copyFiles4plotting("HELMR1", 1, $myDate,  0, $mapHlm."_3d", $dirLst, $extLst, "IGSRAPID");
  }


# Copy the CRD-files from IGSRAPID to plot the number of stations per system
# --------------------------------------------------------------------------
  if ( "$staNum" ne "" ) {
    if ( $staNumDays eq "" ) { $staNumDays = $numDays }
    if ( $staNumDays !~ /^\d+$/) {
      die("BPE variable V_STANUMDAYS = \"$staNumDays\" is not an integer\n");
    }
    unlink glob("${dirCrd}${staNum}_*.${extCrd}");
    my $lastCrd = (glob("${PATH_SAV}${CAMP_SAVRAP}/20??/STA/RA_${myDate}.CRD"))[-1];
    my $lastDate = substr(basename($lastCrd),-9,5);

    foreach (my $thisDay = 0; $thisDay >= -$staNumDays; $thisDay--) {
      my ($thisYear,$thisDate) = gps_date("-yd $lastDate","-d $thisDay","-o %Y %y%j");
      next if ${thisDate} <= 23276;
      my $thisCrd = "${PATH_SAV}${CAMP_SAVRAP}/${thisYear}/STA/RA_${thisDate}.CRD";
      copyfile($thisCrd,"${dirCrd}${staNum}_${thisDate}.${extCrd}");
    }
  }


# Copy the PRE-files from IGSRAPID to plot the number of satellites per system
# ----------------------------------------------------------------------------
  if ( "$satNum" ne "" ) {
    if ( $satNumDays eq "" ) { $satNumDays = $numDays }
    if ( $satNumDays !~ /^\d+$/) {
      die("BPE variable V_SATNUMDAYS = \"$satNumDays\" is not an integer\n");
    }
    unlink glob("${dirPre}${satNum}_*.${extPre}");
    my $lastPre = (glob("${PATH_SAV}${CAMP_SAVRAP}/20??/ORB/RM_${myDate}.PRE.Z"))[-1];
    my $lastDate = substr(basename($lastPre),-11,5);

    foreach (my $thisDay = 0; $thisDay >= -$satNumDays; $thisDay--) {
      my ($thisYear,$thisDate) = gps_date("-yd $lastDate","-d $thisDay","-o %Y %y%j");
      my $thisPre = "${PATH_SAV}${CAMP_SAVRAP}/${thisYear}/ORB/RA_${thisDate}.PRE.Z";
      copyfile($thisPre,"${dirPre}${satNum}_${thisDate}.${extPre}.Z");
      uncompress("${dirPre}${satNum}_${thisDate}.${extPre}.Z");
    }
  }


# Copy the PRC-files from IGSRAPID to plot the AMBRES statistics
# --------------------------------------------------------------
  if ( "$ambXtr" ne "" ) {
    if ( $ambXtrDays eq "" ) { $ambXtrDays = $numDays }
    if ( $ambXtrDays !~ /^\d+$/) {
      die("BPE variable V_AMBXTRDAYS = \"$ambXtrDays\" is not an integer\n");
    }
    copyFiles4plotting("OBSXTR", 1, $myDate,  $ambXtrDays, $ambXtr, $dirSum, $extSum, "IGSRAPID");
    copyFiles4plotting("OBSXTR", 2, $myDate."0",  $ambXtrDays, ${ambXtr}."_clk", $dirSum, $extSum, "RCLKGNSS");
  }

# Copy the PRC-files from IGSRAPID to plot the GPSXTR statistics
# --------------------------------------------------------------
  if ( "$gpsXtr" ne "" ) {
    if ( $gpsXtrDays eq "" ) { $gpsXtrDays = $numDays }
    if ( $gpsXtrDays !~ /^\d+$/) {
      die("BPE variable V_GPSXTRDAYS = \"$gpsXtrDays\" is not an integer\n");
    }
    copyFiles4plotting("", 0, $myDate,  $gpsXtrDays, "${gpsXtr}", $dirSum, $extSum, "IGSRAPID");
    copyFiles4plotting("", 0, $myDate."0",  $gpsXtrDays, "${gpsXtr}_clk", $dirSum, $extSum, "RCLKGNSS");
    # Filter the sub-cluster solutions from GPSXTR
    foreach my $gpsxtr ( glob("$dirSum/${gpsXtr}_clk*.$extSum") ) {
      my $date = substr(basename($gpsxtr),-10,5);
      my @xtr = ();
      open(INP,"<$gpsxtr");
      while (<INP>) {
        next unless /Rms/;
        next unless /$date/;
        push @xtr, $_;
      }
      close INP;
      open(OUT,">$gpsxtr");
      print OUT @xtr;
      close(OUT);
    }
  }

# Copy the PRC-files from IGSRAPID to plot the OBSXTR statistics
# --------------------------------------------------------------
  if ( "$obsXtr" ne "" ) {
    if ( $obsXtrDays eq "" ) { $obsXtrDays = $numDays }
    if ( $obsXtrDays !~ /^\d+$/) {
      die("BPE variable V_OBSXTRDAYS = \"$gpsXtrDays\" is not an integer\n");
    }
    copyFiles4plotting("", 0, $myDate,  $obsXtrDays, $obsXtr, $dirSum, $extSum, "IGSRAPID");
    copyFiles4plotting("", 1, $myDate."0",  $obsXtrDays, ${obsXtr}."_clk", $dirSum, $extSum, "RCLKGNSS");
  }

# Copy the PRC-files from RCLKGNSS to plot the number of satellites per system
# ----------------------------------------------------------------------------
  if ( "$ccrnxc" ne "" ) {
    if ( $ccrnxcDays eq "" ) { $ccrnxcDays = $numDays }
    if ( $ccrnxcDays !~ /^\d+$/) {
      die("BPE variable V_CCRNXCDAYS = \"$ccrnxcDays\" is not an integer\n");
    }
    copyFiles4plotting("CCRNXC", 1, $myDate."0",  $ccrnxcDays, $ccrnxc, $dirSum, $extSum, "RCLKGNSS");
  }

# Copy the PRC-files from IGSRAPID to plot orbit misclosures per system
# ---------------------------------------------------------------------
  if ( "$stdele" ne "" ) {
    if ( $stdeleDays eq "" ) { $stdeleDays = $numDays }
    if ( $stdeleDays !~ /^\d+$/) {
      die("BPE variable V_STDELEDAYS = \"$stdeleDays\" is not an integer\n");
    }
    copyFiles4plotting("STDELE", 1, $myDate,  $stdeleDays, "${stdele}", $dirSum, $extSum, "IGSRAPID");
  }

# Copy the PRC-files from IGSRAPID to plot HELMR1-parameters
# ----------------------------------------------------------
  if ( "$helmr1" ne "" ) {
    if ( $helmr1Days eq "" ) { $helmr1Days = $numDays }
    if ( $helmr1Days !~ /^\d+$/) {
      die("BPE variable V_HELMR1DAYS = \"$helmr1Days\" is not an integer\n");
    }
    copyFiles4plotting("HELMR1", 1, $myDate,  $helmr1Days, "${helmr1}", $dirLst, $extLst, "IGSRAPID");
  }

  $On_Error_Cont = 1;
  err_print() || die();
  
}


sub copyFiles4plotting {
    my $pgmnam   = $_[0];    # Name of the program for which the output is extracted
    my $nPgm     = $_[1];    # Number of occurance
    my $myDate   = $_[2];    # Start date (latest epoch)
    my $daysPast = $_[3];    # Number of days into the past
    my $sumFil   = $_[4];    # V_xxx variable with the name of the files to be plotted
    my $dirSum   = $_[5];    # target directory
    my $extSum   = $_[6];    # Extension of target file
    my $source   = $_[7];    # Source of the files on the SAVEDISK

    my $saveDisk = $source =~ /RCLK/ ? "${PATH_SAV}${CAMP_SAVRAPCLK}" : "${PATH_SAV}${CAMP_SAVRAP}";

    unlink glob("${dirSum}${sumFil}*.${extSum}");
    my $myDateSum = length($myDate) == 5 ? substr($myDate,0,2)."_".substr($myDate,2) :
                    length($myDate) == 6 ? substr($myDate,0,2)."_".substr($myDate,2) :
                    length($myDate) >= 7 ? substr($myDate,2,2)."_".substr($myDate,4) :
                    $myDate;
    $myDateSum = "??_*[0-9]" if $myDateSum eq '*';
    print "${saveDisk}/20??/OUT/${source}.${myDateSum}\n";
    my $lastSum = (glob("${saveDisk}/20??/OUT/${source}.${myDateSum}"))[-1];
    my $lastDate = length($myDate) == 6 ?
                   substr(basename($lastSum),-7,6) : 
                   length($myDate) == 2 ?
                   substr(basename($lastSum),-7,6) : 
                   substr(basename($lastSum),-6);
    $lastDate =~ s/_//;

    foreach (my $thisDay = 0; $thisDay >= -$daysPast; $thisDay--) {
      my ($thisYear,$thisDate) = gps_date("-yd $lastDate","-d $thisDay","-o %Y %y_%j");
      $thisDate .= "0" if ( length($myDate) == 2 );
      $thisDate .= "0" if ( length($myDate) == 6 );
      my $thisFil = "${saveDisk}/${thisYear}/OUT/${source}.${thisDate}";
      print( "$thisFil\n");
      $thisDate =~ s/_//;
      if ( $pgmnam eq "" ) {
        copyfile($thisFil,"${dirSum}${sumFil}_${thisDate}.${extSum}")
      } else {
        my $out = "${dirSum}${sumFil}_${thisDate}.${extSum}";
        open(OUT,"> $out");
        open(PRC, $thisFil);
        my $iPgm = 0;
        my $doWrite = 0;
        while (<PRC>) {
          if ( / Program        : ${pgmnam}/ ) {
            $iPgm++;
            $doWrite = 1;
          }
          $doWrite = 0 if ( /CPU\/Real time for pgm "${pgmnam}"/ );
          print OUT $_ if ( $doWrite && $iPgm == $nPgm );
        }
        close PRC;
        close OUT;
        unlink $out unless -s $out; # Remove an empty file
      }
      movefile("${dirSum}${sumFil}_${thisDate}.${extSum}",
               "${dirSum}${sumFil}.${extSum}") if ($daysPast == 0);
    }
}
