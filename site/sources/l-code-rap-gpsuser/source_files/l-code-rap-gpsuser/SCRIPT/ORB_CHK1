package ORB_CHK1;
@ISA = ("RUNBPE");
# ==============================================================================
#
# Name    :  ORB_CHK1
#
# Purpose :  CHECK 2-DAY ORBIT OVERLAP FOR ARC SPLITTING
#
# Author  :  H.Bock
# Created :  05-Dec-2007
#
# Changes :  26-May-2009 rd: ASPLIT/ORBCHK1: YY_DDD -> YY_SSSS
#            13-Sep-2011 SL: do not append blank line to ASPLIT.SUM
#            17-Nov-2015 SS: Considered V_UPD
#            28-Sep-2021 RD: Remove depreciated program PRETAB
#
# ==============================================================================

use strict;
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ymdm1,$ymdp0,$yy,$ddd,$ssss,
      $CAMP_PTH,$CAMPAIGN,$dirOut) =
    $bpe->getKeys('$YMD_STR-1','$YMD_STR+0','$Y','$+0','$S+0',
                  'CAMP_PTH','CAMPAIGN','DIR_OUT');

# Check if this is an ULTRA:
# -------------------------
  my $ultFil = "$CAMP_PTH${CAMPAIGN}/MSC/ULT$yy$ddd.FLG";  # ultra-flag
  my($h_end,$h_tro,$h_rnx,$h_chr) = rdUltFlg($ultFil);
  unless (-e $ultFil) {
    $h_end=24;
  }

# PlusMinus-Variable
# ------------------
  setMinusPlus($bpe,-1,0);

  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","RADIO_1",'0');
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","RADIO_2",'1');
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","STADAT","$ymdm1");
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","ENDDAT","$ymdp0");
  $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","SUMFIL",'');

  if ($h_end < 24){
    my $endTim =sprintf("%02d%6s",$h_end,' 00 00');
    $bpe->putKey("$$bpe{U}/PAN/ORBGEN.INP","ENDTIM","$endTim");
  }

# Run program
# -----------
  my $PGMNAM = "STDPRE";
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);

# Put the name of the sysout to the extraction program
# ----------------------------------------------------
  $bpe->putKey("$$bpe{U}/PAN/DEFXTR.INP","JOBOUT","$$bpe{SYSOUT}");

# Unlink some files
# -----------------
  unlink("$dirOut/DEFXTR.SUM");
  unlink("$dirOut/DEFWKS.SUM");
  unlink("$dirOut/ASPLIT.SUM");

# Deactivate ASPLIT option if necessary
# -------------------------------------
  unless ($$bpe{V_UPD} eq "Y") {
    $bpe->putKey("$$bpe{U}/PAN/DEFXTR.INP","ASPLIT",'');
    prtMess($bpe,"ASPLIT_NOT_PERFORMED");
  }
  if($h_end <= 24){
    $bpe->putKey("$$bpe{U}/PAN/DEFXTR.INP","ASPLIT",'');
    prtMess($bpe,"ASPLIT_DEACTIVATED");
  } else {
    prtMess($bpe,"ASPLIT_ACTIVATED");
  }

  $PGMNAM = "DEFXTR";
  $bpe->RUN_PGMS($PGMNAM);

# Summary of program run for Protocol
# -----------------------------------
  my $xtrSum="$dirOut/ORBCHK1.${yy}_${ssss}";
  if(-e $xtrSum){
    appFile("",0,"$dirOut/DEFWKS.SUM","$xtrSum");
    appFile("",0,"$dirOut/DEFXTR.SUM","$xtrSum");
  } else {
    copyfile("$dirOut/DEFWKS.SUM","$xtrSum");
    appFile("",0,"$dirOut/DEFXTR.SUM","$xtrSum");
  }

  my $arcSum="$dirOut/ASPLIT.${yy}_${ssss}";
#  if (-e $arcSum){
  if(-e "$dirOut/ASPLIT.SUM"){
    appFile("",0,"$dirOut/ASPLIT.SUM","$arcSum");
#  } else {
#    copyfile("$dirOut/ASPLIT.SUM","$arcSum");
  }
  unlink("$dirOut/ASPLIT.SUM");
}

# ==============================================================================

__END__
