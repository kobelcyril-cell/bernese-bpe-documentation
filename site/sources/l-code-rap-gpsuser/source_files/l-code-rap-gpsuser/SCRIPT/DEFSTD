package DEFSTD;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  DEFSTD
#
# Purpose :  Generate standard orbit with orbgen
#            (from tabular or precise orbits)
#
# Programs:  ORBGEN, DEFXTR
#
# Author  :  M. Meindl
# Created :  03-Aug-2003
#
# Changes :  09-Feb-2005 mm: Old date variables removed
#            10-Mar-2021 ss: Handle R23 orbit anomaly (210690)
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($ddd,$mjd,$outDir,$preDir) = $bpe->getKeys('$+0','$JD+0','DIR_OUT','DIR_PRE');

  replace("${preDir}CODE${ddd}0.PRE","R23","R00") if $mjd eq "59283";

# Run program
# -----------
  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);

  my $SYSOUT = $$bpe{SYSOUT};


# Check program run
# -----------------
  $bpe->putKey("$ENV{U}/PAN/DEFXTR.INP","JOBOUT",$SYSOUT);
  $PGMNAM = "DEFXTR";
  $bpe->RUN_PGMS($PGMNAM);


# Summary of program run for protocol
# -----------------------------------
  appFile("",0,"${outDir}DEFXTR.SUM","${outDir}DEFXTR.$ddd",0);
  appFile("",0,"${outDir}DEFWKS.SUM","${outDir}DEFWKS.$ddd",0);


}
