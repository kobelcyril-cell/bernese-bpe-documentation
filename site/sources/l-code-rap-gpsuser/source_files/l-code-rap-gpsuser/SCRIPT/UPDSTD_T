package UPDSTD_T;
@ISA = ("RUNBPE");
# =============================================================================
#
# Name:       UPDSTD_T
#
# Purpose:    Generate standard orbit from ele-file.
#
# Author:     S. Lutz
#
# Created:    16-Oct-2013
#
# Changes:    24-JUL-2019 DS: call updMacMod to update BOXWING.MAC with $param1
#             14-Jul-2020 RD/PF: change $X/GEN -> PTH_PLATDEF
#
# =============================================================================

use strict;
use warnings;

# Local packages
use lib "$ENV{BPE}";
use bpe_util qw(rdUltFlg gtUltVrs setUserVar);
use lib "$ENV{AUTO}";
use fileUpdate;

sub run {
  my $bpe = shift;
  my $PGMNAM;

# Get variables
# -------------
  my(
    $yyddd,
    $CAMP_PTH,$CAMPAIGN,$dirPlatdef,
    $param1
  ) =
  $bpe->getKeys(
    '$YD+0',
    'CAMP_PTH','CAMPAIGN','PTH_PLATDEF',
    'PARAM1',
  );

  my $ultFil = "${CAMP_PTH}${CAMPAIGN}/MSC/ULT${yyddd}.FLG";
  my($h_end,$h_tro,$h_rnx,$h_chr) = &rdUltFlg($ultFil);
  my $T = &gtUltVrs($h_end,$h_chr);
  &setUserVar($bpe,"T",$T);

# Run programs
# ------------
  $PGMNAM = "STDPRE";
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "ORBGEN";
  my $ERR_STATE = &updMacMod($bpe,"$ENV{U}/PAN/$PGMNAM.INP","${dirPlatdef}/BOXWING.MAC",$param1);
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "STDDIF";
  $bpe->RUN_PGMS($PGMNAM);
}

# =============================================================================

__END__
