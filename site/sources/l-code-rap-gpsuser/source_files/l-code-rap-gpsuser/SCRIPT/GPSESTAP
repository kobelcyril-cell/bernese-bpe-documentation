package GPSESTAP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GPSESTAP
#
# Purpose :  Prepare parallel GPSEST run
#
# Programs:
#
# Author  :  M. Meindl
# Created :  30-Jul-2003               Last modified: 19-May-2009
#
# Changes :  26-Jan-2005 mm: New initPar call (w/o tmpFil)
#            10-Feb-2005 mm: Old date variables removed
#            19-May-2009 rd: Session dependent parallelization filenames
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($ssss    , $ddd     , $param2  , $numFil  , $numClu  ,
      $dirRes  , $dirNeq  , $dirEdt  , $dirOut  , $dirPsh  , $dirBpe,
      $extRes  , $extNeq  , $extEdt  , $extOut  , $extPsh            ) =
  $bpe->getKeys
     ('$S+0'   , '$+0'    , 'PARAM2',  'V_CLU'  , 'V_NCLU' ,
      'DIR_RES', 'DIR_NEQ', 'DIR_EDT', 'DIR_OUT', 'DIR_PSH', 'DIR_BPEPRT',
      'EXT_RES', 'EXT_NEQ', 'EXT_EDT', 'EXT_OUT', 'EXT_PSH'               );

# Delete old files (OUT)
# ---------------------------
  my $est = $param2 || "EST";
  if ($numFil ne "" || $numClu ne "") {
    unlink glob("${dirOut}${est}${ssss}???.${extOut}");
    unlink glob("${dirRes}${est}${ssss}???.${extRes}");
    unlink glob("${dirNeq}${est}${ssss}???.${extNeq}") }
  else {
    unlink glob("${dirOut}${est}${ddd}????.${extOut}");
    unlink glob("${dirRes}${est}${ddd}????.${extRes}");
    unlink glob("${dirNeq}${est}${ddd}????.${extNeq}") }

# Initialize parallel run
# -----------------------
  my $bpeFil = "${dirBpe}EST${ssss}";
  unlink(glob("${bpeFil}???.BPE"));

  my @pshFil = glob("${dirPsh}????${ssss}.${extPsh}");

  if ($numFil ne "") {
    initPar_Cl($bpe,$bpeFil,@pshFil,0,$numFil,0) }
  elsif ($numClu ne "") {
    initPar_Cl($bpe,$bpeFil,@pshFil,$numClu,0,0) }
  else {
    @pshFil = map { substr(basename($_),0,4) } @pshFil;
    initPar_Bl($bpe,@pshFil) }

}
