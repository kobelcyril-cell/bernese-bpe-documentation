package ADDNEQ2N;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ADDNEQ2N
#
# Purpose :  Combine NQ0 files to generate a n-day solution
#
# Programs:  ADDNEQ2, GPSXTR
#
# PARAMs  :  PARAM1 - Solution variable name
#            PARAM2 - Third character of solution name (optionally)
#            PARAM3 - Minus day for TRP FLG check (optionally)
#            PARAM4 - Plus  day for TRP FLG check (optionally)
#            PARAM5 - Extra day to be saved (e.g. -1 for rapid analysis)
#            PARAM6 - Plus  day for day range to be saved (default: PARAM5)
#
# Remark  :  ELE file of current (+0) day saved automatically
#
# Author  :  M. Meindl, S. Schaer
# Created :  30-Jul-2003
#
# Changes :  07-Oct-2010/ss: Adapted for final processing
#            07-Oct-2010/ss: Consider TRP FLG files of three days
#            03-Oct-2012/ss: Several generalizations
#            04-Oct-2012/ss: Further developed and activated for FIN/RAP/ULT
#            28-Jul-2016 av: Add IGSULTRA pcf name
#            17-Sep-2019 av: Use regex for IGSULTRA
#            07-Dec-2020 RD: transition from VMF->GMF for IGSRAPID on 20-341
#            07-Jul-2021 LP: transition from GMF->GPT3 for IGSRAPID on 21-192
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $dayWeek, $xtr, $pcfFil,
      $param1 ,$param2, $param3, $param4, $param5, $param6,
      $dirOut, $dirEle, $extEle) =
    $bpe->getKeys('$YD+0', 'DAYWEEK', 'V_XTR', 'PCFFIL',
                  'PARAM1', 'PARAM2', 'PARAM3', 'PARAM4', 'PARAM5', 'PARAM6',
                  'DIR_OUT', 'DIR_ELE', 'EXT_ELE');

  $param1 = $$bpe{"V_$param1"};
  $pcfFil = (split('\.',$pcfFil))[0];

  die "Unexpected length of PARAM1 ($param1)\n" unless length($param1) == 2;
  die "Unexpected length of PARAM2 ($param2)\n" if     length($param2) >  1;
  die "Undefined PARAM3\n" if $param3 eq "" && $param4 ne "";
  die "Undefined PARAM4\n" if $param3 ne "" && $param4 eq "";

##  $param3 = -1 if $param3 eq "";
##  $param4 = +1 if $param4 eq "";
  $param6 = $param5 if $param6 eq "";

  my $sol2 = $param1;
  my $sol3 = $param1."_";
  $sol2 = "_".$param2     if $param2 ne "";
  $sol3 = $param1.$param2 if $param2 ne "";

# Delete old ELE files
# --------------------
  unlink(glob("${dirEle}${sol2}${dayWeek}*.${extEle}"));

  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","ELEFILE","${sol2}${dayWeek}?????");

# Consider ULT FLG file
# ---------------------
  if ($pcfFil eq "IGSRAPID_" || $pcfFil eq "IGSULTRA_") {
    my $ultFil = "${dirOut}../MSC/ULT${yyddd}.FLG";
    if (-s $ultFil) {
      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","RADIO2_2","1");
      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","RADIO2_3","0");
      prtMess($bpe,"CONSTRAINED NETWORK SOLUTION IN ULT MODE");
    } else {
##      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","RADIO2_3","1");
##      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","RADIO2_2","0");
##      prtMess($bpe,"MINIMUM-CONSTRAINT NETWORK SOLUTION IN RAP MODE");
      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","RADIO2_2","1");
      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","RADIO2_3","0");
      prtMess($bpe,"CONSTRAINED NETWORK SOLUTION IN RAP MODE");
    }
  }

# Consider TRP FLG files
# ----------------------
  my ($i,$yyddd0,$flgFil,$num,$str,$yyddd1);
  my $numFlg = 0;
  if ($param3 ne "") {
    for ($i=$param3;$i<=$param4;$i++) {
      $yyddd0 = gps_date("-yd $yyddd -d $i -o %y%j");
      $flgFil = "${dirOut}../MSC/TRP_${yyddd0}.FLG";
      if (-s $flgFil) {
        prtMess($bpe,"TRP FLG file found: $flgFil");
        $numFlg++;
      }
    }
    $num = $param4-$param3+1;
    print "NUM: $num\n";
    if ($numFlg>0 && $numFlg<$num) {
      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","TRP_ELIM","BEFORE_STACKING");
      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","GRD_ELIM","BEFORE_STACKING");
      prtMess($bpe,"TRP model change detected: # of FLG: $numFlg");
      prtMess($bpe,"TRP parameter pre-elimination set to BEFORE_STACKING");
##      msg2key("BPE","${pcfFil}_${yyddd}: ADDNEQ2N: TRP parameter pre-elimination set to BEFORE_STACKING: # of FLG: $numFlg");
      msg2key("MSC","${pcfFil}_${yyddd}: ADDNEQ2N: TRP parameter pre-elimination set to BEFORE_STACKING: # of FLG: $numFlg");
    } else {
      if (( $yyddd >= 20341 && $yyddd <= 20342 )||( $yyddd >= 21192 && $yyddd <= 21193 )) {
        $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","TRP_ELIM","BEFORE_STACKING");
        $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","GRD_ELIM","BEFORE_STACKING");
      } else {
        $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","TRP_ELIM","EXCEPT_FOR_BOUNDARIES");
        $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","GRD_ELIM","EXCEPT_FOR_BOUNDARIES");
        prtMess($bpe,"No TRP model change detected: # of FLG: $numFlg");
      }
    }
  }

# Run programs
# ------------
  my $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

  if ($xtr ne "") {
    $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",$$bpe{SYSOUT});

    $PGMNAM = "GPSXTR";
    $bpe->RUN_PGMS($PGMNAM);
  }

# Save requested ELE files
# ------------------------
# Current day:
  copy("${dirEle}${sol2}${dayWeek}${yyddd}.${extEle}",
       "${dirEle}${sol3}${yyddd}.${extEle}") or die "ELE file of current day not found\n";

# Extra days to be saved:
  if ($param5 ne "") {
    for ($i=$param5;$i<=$param6;$i++) {
      $yyddd0 = gps_date("-yd $yyddd -d $i -o %y%j");
      $yyddd1 = $yyddd0;
      $yyddd1 = substr($yyddd1,2,3) if ( ($pcfFil =~ /IGSRAPID/ || $pcfFil =~ /IGSULTRA/ ) && $i!=0);
      if    ($i==0) { $str = "" }
      elsif ($i< 0) { $str = "M".abs($i) }
      else          { $str = "P".$i }
      $sol3 = $sol2 if $param2 eq "";
      move("${dirEle}${sol2}${dayWeek}${yyddd0}.${extEle}",
           "${dirEle}${sol3}${str}${yyddd1}.${extEle}")
        or die "ELE file of day $i not found\n";
      prtMess($bpe,"Saved ELE file: ${sol3}${str}${yyddd1}.${extEle}");
    }
  }

# Delete remaining new ELE files
# ------------------------------
  unlink(glob("${dirEle}${sol2}${dayWeek}*.${extEle}"));

}

