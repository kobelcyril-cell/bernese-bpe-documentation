package CPF_AFTP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name:      CPF_AFTP
#
# Purpose:   Copy actual CPF to anonymous FTP, delete CPFs
#
# Authors:   D. Thaller
# Created:   31-May-2011
#
#
# Changes:   18-Jul-2013 CB: print statements added, loop over m3 to m7 for del
#
# ============================================================================
use lib "$ENV{EXE}";
use lib "$ENV{BPE}";
use lib "$ENV{AUTO}";
use gpsutil;
use Gps_Date;
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my $mjd      = $$bpe{MJD};

  my $CAMP_PTH = $$bpe{CAMP_PTH};                                               
  my $CAMPAIGN = $$bpe{CAMPAIGN};
  my $dirOrb   = "${CAMP_PTH}${CAMPAIGN}/ORB/";


  my $yymmdd   = gps_date("-mjd $mjd -o %y%m%d");

#  my $mjd_3    = $mjd - 3;
#  my $yymmdd_3 = gps_date("-mjd $mjd_3 -o %y%m%d");
   
  my ($fil, @cpfLst, $mjd_mi, $yymmdd_mi, $i);

  my ($VCPF) = $bpe->getKeys ('V_VCPF');


# Create list of files to be copied
# ---------------------------------

  if ($VCPF == 1) {
    @cpfLst = glob("${dirOrb}g*_cpf_${yymmdd}_????.cod");

    foreach $fil (@cpfLst) {
      print " Copy ${fil} to aftp.\n";
      copyaftp ("${fil}","slr/cpf/") || err_print();
    }
  }
  elsif ($VCPF == 2) {
    @cpfLst = glob("${dirOrb}g*_cpf_${yymmdd}_?????.cod");

    foreach $fil (@cpfLst) {
      print " Copy ${fil} to aftp.\n";
      copyaftp ("${fil}","slr/cpfv2/") || err_print();
    }
  }
  else {
    prtMess($bpe,"CPF version $VCPF not implemented!");
    die("CPF version $VCPF not implemented!\n" .
        "Please check the script CPF_AFTP\n");
  }


  print "\n\nDeleting cpf in campaign and on aftp \n";

  for ($i=3; $i<=7; $i++) {  # clean from minus3 to minus7

    $mjd_mi    = $mjd - $i;
    $yymmdd_mi = gps_date("-mjd $mjd_mi -o %y%m%d");
    print " Deleting for YYMMDD $yymmdd_mi \n";  

# Create list of files to be deleted: Campaign Directory
# -------------------------------------------------------
    if ($VCPF == 1) {
      @cpfLst = glob("${dirOrb}g*_cpf_${yymmdd_mi}_????.cod");
    }
    elsif ($VCPF == 2) {
      @cpfLst = glob("${dirOrb}g*_cpf_${yymmdd_mi}_?????.cod");
    }

    foreach (@cpfLst) {
      print "  Delete: $_ \n";
      unlink($_);
    }

# Create list of files to be deleted: aftp
# ----------------------------------------
    my $aftp = "$ENV{'PATH_AFTP'}slr/cpf/";

    if ($VCPF == 1) {
      $aftp = "$ENV{'PATH_AFTP'}slr/cpf/";
      @cpfLst = glob("${aftp}g*_cpf_${yymmdd_mi}_????.cod");
    }
    elsif ($VCPF == 2) {
      $aftp = "$ENV{'PATH_AFTP'}slr/cpfv2/";
      @cpfLst = glob("${aftp}g*_cpf_${yymmdd_mi}_?????.cod");
    }

    foreach (@cpfLst) {
      print "  Delete: $_ \n";
      unlink($_);
    }
  }


# Create list of files to be deleted: Campaign Directory
# -------------------------------------------------------
#  @cpfLst = glob("${dirOrb}g*_cpf_${yymmdd_3}_????.cod");

#  foreach (@cpfLst) { unlink($_) }

# Create list of files to be deleted: aftp
# ----------------------------------------
#  my $aftp = "$ENV{'PATH_AFTP'}slr/cpf/";

#  @cpfLst = glob("${aftp}g*_cpf_${yymmdd_3}_????.cod");

#  foreach (@cpfLst) {
#    print " Delete: $_ \n";
#    unlink($_);
#  }

} #end sub run
