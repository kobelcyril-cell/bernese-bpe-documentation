package JUMP_BIA;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  JUMP_BIA
#
# Purpose :  Delete specific monthly bias NEWs in case if added bias jump
#            events.
#
# PARAMs  :  PARAM1 - Optional minus parameter
#
# Author  :  S. Schaer
# Created :  29-Jun-2017
#
# Changes :  19-Jul-2017 SS: Skip ' 01 00 00 00 ' entries
#            14-Jul-2020 RD/PF: change $X/GEN -> PTH_SATCRUX
#            07-Apr-2022 ST/SS: Corrected misspelled PTH_SATRUX
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;
use File::Compare qw(compare);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $mjd_last, $b,
      $dirOut, $dirNeq, $extNeq, $dirSatcrx, $extSatcrx,
      $biaCrx, $param1) =
    $bpe->getKeys('$YSS+0', '$JD+0', 'V_B',
      'DIR_OUT', 'DIR_NEQ', 'EXT_NEQ', 'PTH_SATCRUX', 'EXT_SATCRUX',
      'V_BIACRX', 'PARAM1');

# Set input data range
# --------------------
  setMinusPlus($bpe,$param1,0) if $param1 ne "";

# Create yymm list of affected monthly bias NEQ files
# ---------------------------------------------------
  my $flgFil = "${dirOut}../MSC/ADDED_JUMPS.FLG";
  if (-e $flgFil) {
    my $crxFil = "${dirSatcrx}/SAT_BIA.CRX";
    $crxFil = "${dirSatcrx}/${biaCrx}.CRX";
##    my @yymm = `grep '         5         0       ' $crxFil | cut -c35-36,38-39`;
    my @yymm = `grep '         5         0       ' $crxFil | grep -v ' 01 00 00 00 ' | cut -c35-36,38-39`;
##    my @yymm = `grep '         5         0       201[789]' $crxFil | grep -v ' 01 00 00 00 ' | cut -c35-36,38-39`;
##    my @yymm = `grep '         5         0       2017 11' $crxFil | grep -v ' 01 00 00 00 ' | cut -c35-36,38-39`;
    chomp(@yymm);
    @yymm = sort(@yymm);
    foreach my $yymm (@yymm) {
       prtMess($bpe,"DELETION REQUEST FOR YYMM ${yymm}");
       my @neqFil = glob("${dirNeq}[A-Z]??_${yymm}.${extNeq}");
       foreach my $neqFil (@neqFil) {
         prtMess($bpe,"${neqFil} DELETED");
         unlink($neqFil);
       }
    }
    unlink($flgFil);
  } else {
    prtMess($bpe,"NO DELETION REQUESTED");
  }

}
