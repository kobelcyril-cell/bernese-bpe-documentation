package INIT_VMF;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  INIT_VMF
#
# Purpose :  Initialization concerning VMF setup
#
# Programs:
#
# Author  :  S. Schaer
# Created :  07-Oct-2010
#
# Changes :  08-Oct-2010/ss: msg2key statement added
#            08-Oct-2010/ss: Consider ULT FLG file
#            15-Oct-2010/ss: Take over VMF information if indicated
#            18-Oct-2010/ss: Do not execute get_vmf.com in ULT mode
#            25-Jul-2013/ss: Suppress warning messages in ULT mode
#            04-Aug-2015/ss: CLKRAPID raplaced by RCLKGNSS
#            07-Dec-2020 RD: Add PCF variable V_TRPMOD
#            09-Jul-2021 LP: More generalized handling of TROPO model
#            12-Aug-2021 LP: If used by RCLKGNSS: copy VMF*.GRD from orbit campaign
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use igs_device;
use File::Copy;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd , $ddd   , $yyyy,
      $pcfFil, $taskId, $trpModel,
      $dirOut, $dirGrd, $extGrd) =
    $bpe->getKeys('$YD+0'  , '$+0'    , '$Y+0',
                  'PCFFIL' , 'TASKID' , 'V_TRPMOD',
                  'DIR_OUT', 'DIR_GRD', 'EXT_GRD');

# Set variables
# -------------
  $pcfFil = (split('\.',$pcfFil))[0];
  my $grdFil = "${dirGrd}VMF${yyddd}.${extGrd}";
  my $flgFil = "${dirOut}../MSC/TRP_${yyddd}.FLG";
  my $ultFil = "${dirOut}../MSC/ULT${yyddd}.FLG";

# Remove GRD/FLG file
# -------------------
  unlink($grdFil);
  unlink($flgFil);

# Get latest VMF grid files
# -------------------------
  unless (-e $ultFil) {
    if ( $trpModel =~ /VMF/ ) {
      system("$ENV{AUTO}/get_vmf.com") unless $pcfFil eq "RCLKGNSS";
    }
  }

# Copy daily VMF GRD file into campaign
# -------------------------------------
  if ( $trpModel =~ /VMF/ ) {
    system("$ENV{AUTO}/copyGrid.pl $dirOut/../ $ddd $yyyy $trpModel -oneFile");
  }

# Check whether the VMF GRD file is available
# -------------------------------------------
  if ( $trpModel =~ /VMF/ ) {
    if (-s $grdFil) {
      prtMess($bpe,"VMF initialization: $grdFil created");
    } else {
      prtMess($bpe,"VMF initialization: $grdFil not created");
    }
  }
  my $flgLin = -e $flgFil ? `cat $flgFil` : $trpModel;
  chomp($flgLin);
  prtMess($bpe,"Tropo initialization: ${flgLin}");
  if ($flgLin ne "$trpModel") {
    prtMess($bpe,"Tropo initialization: $flgFil found (${flgLin})");
##    msg2key("BPE","INIT_VMF: $pcfFil $taskId${yyddd}0: $flgFil found (${flgLin}): VMF info unavailable?");
    msg2key("BPE","INIT_VMF: $pcfFil $taskId${yyddd}0: $flgFil found (${flgLin}): VMF info unavailable?") unless -e $ultFil;
##    exit 0 if $pcfFil eq "IGSFIN1D";
  }
##  `echo 'GMF' > $flgFil` if $yyddd eq "10274";
##  `echo 'GMF' > $flgFil` if $yyddd eq "10275";
##  `echo 'GMF' > $flgFil` if $pcfFil eq "IGSRAPID";


# Take over VMF information if indicated
# --------------------------------------
  my $grdInp = "";
  my $flgInp = "";
  my $numDif = 0;

  if ($pcfFil eq "RCLKGNSS") {
    $grdInp = "$CDIR_RAP/GRD/VMF${yyddd}.${extGrd}";
    $flgInp = "$CDIR_RAP/MSC/TRP_${yyddd}.FLG";
    
    if (-s $grdInp) { copy($grdInp,$grdFil); }
    
    $numDif = `diff $grdInp $grdFil | wc -l`+0 if -s $grdInp;
##    copy($grdInp,"${grdInp}_OLD");
##    copy($grdFil,"${grdFil}_OLD");
    print "DIFF: $numDif $grdInp $grdFil\n";
    if (-e $flgInp) { unlink($grdFil); copy($flgInp,$flgFil) }
    else            { copy($grdInp,$grdFil); unlink($flgFil) }
  }

  if ($pcfFil eq "CLKFINAL") {
    $grdInp = "$CDIR_FIN/GRD/VMF${yyddd}.${extGrd}";
    $flgInp = "$CDIR_FIN/MSC/TRP_${yyddd}.FLG";
    $numDif = `diff $grdInp $grdFil | wc -l`+0 if -s $grdInp;
    if (-e $flgInp) { unlink($grdFil); copy($flgInp,$flgFil) }
    else            { copy($grdInp,$grdFil); unlink($flgFil) }
  }

##msg2key("BPE","INIT_VMF: $pcfFil $taskId${yyddd}0: Used VMF info different from latest VMF info.") if $numDif>1;

}

