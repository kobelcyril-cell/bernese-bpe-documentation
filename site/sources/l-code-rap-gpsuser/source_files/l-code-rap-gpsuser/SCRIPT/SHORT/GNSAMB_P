package GNSAMB_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  GNSAMB_P
#
# Purpose :  Execute GPSEST for WL/NL ambiguity resolution
#
# PARAMs  :  PARAM1 - 4-character baseline name
#
# Author  :  M. Meindl
# Created :  20-Oct-2003
#
# Changes :  25-Apr-2007/ss: Derived from GPSQIF_P
#            30-Sep-2014 lp: New GNSS selection using setGNSS, remove $v_gnss
#            15-Jun-2017/ss: WL/NL AR extended to GECJ (for test purposes)
#            12-Sep-2019 av: Activate Galileo & use V_GNSSAR
#            13-Jan-2021 ss: Harmonized GNSAMB_P among IGSRAPID and MGEXORB
#            13-Jan-2021 ss: Implemented GNSS-specific code data screening
#            28-Apr-2021 lp: Correct a variable name in die statement ($ogsFil -> $obsFil)
#            05-Jan-2023 rd: Skip files when more than 60% of the obser. are indicated as bad in OBX_EDT
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ssss, $param1, $gnssar, $dirCsh, $extCsh) =
    $bpe->getKeys('$S+0', 'PARAM1', 'V_GNSSAR', 'DIR_CSH', 'EXT_CSH');

  my ($ddd, $yyddd, $dirOut, $extOut) =
    $bpe->getKeys('$+0', '$YD+0', 'DIR_OUT', 'EXT_OUT');

# Set filename variable
# ---------------------
  setUserVar($bpe,"FFFF",$param1);

# Check whether PSH file available
# --------------------------------
  my $cshFil = "${dirCsh}${param1}${ssss}.${extCsh}";
  my $obsFil = "${dirOut}OBX_EDT_${yyddd}.${extOut}";
  die "$obsFil not found\n" unless -e $obsFil;
  my $logFil = "${dirOut}GNSAMB.LST";

  my $v_chk = "GESCJI";
  my $v_usear = $gnssar;
  $v_usear = $v_chk if $v_usear eq "ALL";
  my $v_usemw = "";

  if (-s $cshFil) {

    my ($PGMNAM,$str);
    for (my $i=length($v_chk);$i>0;$i--) {
      my $sys = substr($v_chk,$i-1,1);
      my $ok  = rindex($v_usear,$sys)==-1 ? 0 : 1;
      $str = "GPS" if $sys eq "G";
      $str = "GLO" if $sys eq "R";
      $str = "GAL" if $sys eq "E";
      $str = "GEO" if $sys eq "S";
      $str = "BEI" if $sys eq "C";
      $str = "QZS" if $sys eq "J";
      $str = "IRN" if $sys eq "I";
#      my $obs = `grep '\#EDT' $obsFil | grep $param1$ssss | grep ' $str ' | grep -v ' 100\.0\% ' | wc -l`+0;
      my $obs = `grep '\#EDT' $obsFil | grep $param1$ssss | grep ' $str ' |  cut -c 83-87 | awk '{ if ( \$1 < 60 ){ print "1"} else{ print "0"}}'`+0;

      if ($ok==1 && $obs==1) {
        $v_usemw = $sys.$v_usemw;
##        $ok = 0 if $sys eq "C";
        $ok = 0 if $sys eq "J";
      }

      if ($ok==1 && $obs==1) {

        &prtMess($bpe,"$param1$ssss: Code data screening for: $sys");

# - Code data screening
        &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_",$sys);
        $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","TITLE","Code data screening ($sys) wrt \$(FFFF)\$S+0");
        $PGMNAM = "GPSEST"; $bpe->RUN_PGMS($PGMNAM);

# - Residual data screening
        $PGMNAM = "RESRMS"; $bpe->RUN_PGMS($PGMNAM);

# - Remove bad observations
        $PGMNAM = "SATMRK"; $bpe->RUN_PGMS($PGMNAM);
        my $badObs = `grep ' C :' $$bpe{SYSOUT} | cut -c54-61`+0;
        $badObs = $badObs/2;
        $badObs = sprintf("%6d",$badObs);

        unlink("${dirOut}${param1}${ddd}C.RES");

        if ($badObs>0) {
          &prtMess($bpe,"$param1$ssss: Bad code data ($badObs) for: $sys");
          `echo '${yyddd}0 $param1$ssss $sys $badObs' >> $logFil`;
        }
      }
    }
    my $obs = `grep '\#EDT' $obsFil | grep $param1$ssss | grep tot |  cut -c 83-87 | awk '{ if ( \$1 < 60 ){ print "1"} else{ print "0"}}'`+0;
   if ($obs) {

      &prtMess($bpe,"$param1$ssss MW AR requested for: $v_usemw");

# - First GPSEST for WL ambiguity resolution
      &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_",$v_usemw);
      &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USEAR_",$gnssar);
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","TITLE","WL AR wrt \$(FFFF)\$S+0");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PSFILES","\$(FFFF)\$S+0");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","RESIDRS","");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT","\$(FFFF)\$+0W");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FREQUENCY","MELWUEBB");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSTRAT","SIGMA");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","AMBSAVE","1");

      $PGMNAM = "GPSEST";
      $bpe->RUN_PGMS($PGMNAM);

# - Second GPSEST for NL ambiguity resolution
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","TITLE","NL AR wrt \$(FFFF)\$S+0");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","CSFILES","");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBINP","");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT","\$(FFFF)\$+0N");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FREQUENCY","L3");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FIXSTA","FIRST");
      $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","APRWIDE","1");

      $PGMNAM = "GPSEST";
      $bpe->RUN_PGMS($PGMNAM);
   } else {

      &prtMess($bpe,"$param1$ssss MW AR skipped because of data quality: $v_usemw");

   }

  } else {

    prtMess($bpe,"$cshFil not found");

  }

}
