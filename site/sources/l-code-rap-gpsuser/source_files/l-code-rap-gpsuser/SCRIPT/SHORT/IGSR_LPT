package IGSR_LPT;
@ISA = ("RUNBPE");
# =============================================================================
#
# Name    :  IGSR_LPT
#
# Purpose :  Post COD.EPH_U to AFTP for swisstopo (LPT)
#
# Programs:
#
# Author  :  S. Schaer
#
# Created :  07-Mar-2007
#
# Changes :  08-Mar-2007/ss: Week-specific subdirectories
#            02-Aug-2007/mm: V_DIS activated
#            16-Nov-2013 SL: New ULTRA files
#            07-Feb-2018 SS: Use V_SAV (not V_DIS) for copyaftp
#            03-Feb-2023 SS: SAT_yyyy.CRX updated each time
#            06-Jul-2026 SS: GEN replaced by CONFIG
#            06-Jul-2026 SS: Introduced $oosFlg="_out_of_service"
#            07-Jul-2026 SS: Used IGSULTRA.CRX; added CODE*.OSB files
#            13-Jul-2026 SS: Paused SAT_yyyy.CRX
#
# =============================================================================

use warnings;

# Local packages
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,$wwwwd,$wwwwdp1,$wwwwdm8,$wwww,$wwwwp1,$wwwwm8,
    $yyyy,$yyyyp1,$dirOut,
    $dirPre,$extPre,$dirSatcrx,$extSatcrx,
  ) =
  $bpe->getKeys(
    '$YD+0','$WD+0','$WD+1','$WD-8','$W+0','$W+1','$W-8',
    '$Y+0','$Y+1','DIR_OUT',
    'DIR_PRE','EXT_PRE','PTH_SATCRUX','EXT_SATCRUX',
  );

# BPE not allowed to distribute files
# -----------------------------------
  unless($$bpe{V_SAV} eq "Y") {
    prtMess($bpe,"FILES NOT DISTRIBUTED");
    return;
  }

# Remove old sp3 files
# --------------------
  my $lptPth = "$ENV{PATH_AFTP}/CODE/LPT/";
  my $oosFlg = "_out_of_service";
##  unlink(glob("${lptPth}${wwwwm8}${oosFlg}/igu${wwwwdm8}_??.sp3.Z"));

# Manage week-specific subdirectories
# -----------------------------------
  my $dir = "${lptPth}${wwww}${oosFlg}/";
##  system("mkdir $dir") unless(-e $dir);
  $dir = "${lptPth}${wwwwp1}${oosFlg}/";
##  system("mkdir $dir") unless(-e $dir);
  $dir = "${lptPth}${wwwwm8}${oosFlg}/";
##  system("rm -r $dir") if(-e $dir);

# Define update cycle
# -------------------
  my $ultFil = "$dirOut/../MSC/ULT$yyddd.FLG";
  my($h_end,$h_tro,$h_rnx,$h_chr) = &rdUltFlg($ultFil);
  my $T  = &gtUltVrs($h_end,$h_chr);

  my $ultLin   = -e $ultFil ? `cat $ultFil` : "24 23 23 0";
  my $hour_end = substr($ultLin,0,2);

  my($inpFil,$outFil);

##  $inpFil = "${dirSatcrx}IGSULTRA.${extSatcrx}";
##  $outFil = "CODE/LPT/CONFIG/SAT_${yyyy}.${extSatcrx}";
##  copyaftp($inpFil,$outFil) || die "copyaftp failed re $outFil\n";
##  $outFil = "CODE/LPT/CONFIG/SAT_${yyyyp1}.${extSatcrx}";
##  copyaftp($inpFil,$outFil) || die "copyaftp failed re $outFil\n";

  $inpFil = "$ENV{CONFIG}/OBSERV_COD.SEL";
  $outFil = "CODE/LPT/CONFIG/OBSERV_COD.SEL";
  copyaftp($inpFil,$outFil) || die "copyaftp failed re $outFil\n";

  $inpFil = "$ENV{REF}/CODE.OSB";
  $outFil = "CODE/LPT/REF/CODE.OSB";
  copyaftp($inpFil,$outFil) || die "copyaftp failed re $outFil\n";

  $inpFil = "$ENV{REF}/CODE_Y1994_EXT.OSB";
  $outFil = "CODE/LPT/REF/CODE_Y1994.OSB";
  copyaftp($inpFil,$outFil) || die "copyaftp failed re $outFil\n";

  $inpFil = "$ENV{REF}/CODE_MGEX.OSB";
  $outFil = "CODE/LPT/REF/CODE_MGEX.OSB";
  copyaftp($inpFil,$outFil) || die "copyaftp failed re $outFil\n";

  $inpFil = "$ENV{REF}/CODE_MGEX_W1934_EXT.OSB";
  $outFil = "CODE/LPT/REF/CODE_MGEX_W1934.OSB";
  copyaftp($inpFil,$outFil) || die "copyaftp failed re $outFil\n";

  if($hour_end >=  3) {
    $inpFil = "${dirPre}US2${wwwwd}.${extPre}";
    $outFil = "CODE/LPT/${wwww}${oosFlg}/igu${wwwwd}_06.sp3";
##    copyaftp("-c",$inpFil,$outFil) || die "copyaftp failed re $outFil\n";
  }
  if($hour_end >=  9) {
    $inpFil = "${dirPre}US1${wwwwd}.${extPre}";
    $outFil = "CODE/LPT/${wwww}${oosFlg}/igu${wwwwd}_12.sp3";
##    copyaftp("-c",$inpFil,$outFil) || die "copyaftp failed re $outFil\n";
  }
  if($hour_end >= 15) {
    $inpFil = "${dirPre}US3${wwwwd}.${extPre}";
    $outFil = "CODE/LPT/${wwww}${oosFlg}/igu${wwwwd}_18.sp3";
##    copyaftp("-c",$inpFil,$outFil) || die "copyaftp failed re $outFil\n";
  }
  if($hour_end >= 21) {
    $inpFil = "${dirPre}US0${wwwwdp1}.${extPre}";
    $outFil = "CODE/LPT/${wwwwp1}${oosFlg}/igu${wwwwdp1}_00.sp3";
##    copyaftp("-c",$inpFil,$outFil) || die "copyaftp failed re $outFil\n";
  }
  if($hour_end >= 23) {
    $inpFil = "${dirPre}US2${wwwwdp1}.${extPre}";
    $outFil = "CODE/LPT/${wwwwp1}${oosFlg}/igu${wwwwdp1}_06.sp3";
##    copyaftp("-c",$inpFil,$outFil) || die "copyaftp failed re $outFil\n";
  }
}

# =============================================================================

__END__
