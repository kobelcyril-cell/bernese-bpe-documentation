package DIST_ION;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  DIST_ION
#
# Purpose :  Distribute predicted ionosphere information
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  28-Aug-2012
#
# Changes :  10-Sep-2012/ss: Consider 5-day predicted information
#            10-Sep-2012/ss: Upload predicted IONEX
#            12-Sep-2012/ss: Save and distribute predicted CGIM RINEX results
#            01-Dec-2016 SS: Upload to cddis https
#            07-Feb-2018 SS: Use V_SAV (not V_DIS) for copyaftp
#            08-Mar-2022 AV: Save disk: yearly subdirectory
#            03-Nov-2022 AV: Submit to CODE_TEST (new maing scheme)
#            08-Nov-2022 SS: Corrected typo (CODETEST)
#            28-Nov-2022 AV: Change upload from CODE_TEST to CODE
#            10-Jan-2023 SS: Renamed ION.??? to GIM.???;
#                            renamed COD0OPSRAP to COD0OPSPRD
#            11-Jan-2023 SS: Renamed 01D_01H_GIM.RNX to 01D_01D_GIM.RNX;
#                            revised in terms of 4-digit year and check_dir
#            08-Jul-2026 SS: Saved Z15 INX (after bug fixing)
#            15-Jul-2026 SS: Used latest long filename convention (COD0OPDPnD)
#            19-Oct-2026 SS: Removed short filename stuff 
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use newFTP;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;
use File::Compare qw(compare);
use cddis_curl;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yydddp1, $yydddp2, $yydddp5,
      $wwwwd, $wwwwdp1, $wwwwdp2, $wwwwdp5,
      $yyyy, $yyp1, $yyp2, $yyp5,
      $ddd,  $dp1 , $dp2 , $dp5,
      $mjd, $e, $f, $g, $sav, $dis,
      $dirIon, $dirRxn, $dirOut) =
    $bpe->getKeys('$YD+0', '$YD+1', '$YD+2', '$YD+5',
                  '$WD+0', '$WD+1', '$WD+2', '$WD+5',
                  '$Y+0','$Y+1','$Y+2','$Y+5',
                  '$+0','$+1','$+2','$+5',
                  '$JD+0', 'V_E', 'V_F', 'V_G', 'V_SAV', 'V_DIS',
                  'DIR_ION', 'DIR_RXN', 'DIR_OUT');

# Save predicted ionosphere files
# -------------------------------
  my $yy  = substr($yyddd,0,2);
  my $ddd = substr($yyddd,2,3);
  if ($sav eq "Y") {
    check_dir("$PATH_SAV$CAMP_SAVRAP/${yyyy}/ATM/");
    check_dir("$PATH_SAV$CAMP_SAVRAP/${yyp5}/ATM/");

    copy("${dirIon}${e}${yydddp1}.ION","$PATH_SAV$CAMP_SAVRAP/${yyp1}/ATM/");

    copy("${dirIon}${e}${yydddp1}.INX","$PATH_SAV$CAMP_SAVRAP/${yyp1}/ATM/");
    compress("$PATH_SAV$CAMP_SAVRAP/${yyp1}/ATM/${e}${yydddp1}.INX");

    $yy  = substr($yydddp1,0,2);
    $ddd = substr($yydddp1,2,3);
    copy("${dirRxn}${e}_${ddd}0.${yy}N","$PATH_SAV$CAMP_SAVRAP/${yyp1}/ATM/");

    copy("${dirIon}${f}${yydddp2}.ION","$PATH_SAV$CAMP_SAVRAP/${yyp2}/ATM/");

    copy("${dirIon}${f}${yydddp2}.INX","$PATH_SAV$CAMP_SAVRAP/${yyp2}/ATM/");
    compress("$PATH_SAV$CAMP_SAVRAP/${yyp2}/ATM/${f}${yydddp2}.INX");

    $yy  = substr($yydddp2,0,2);
    $ddd = substr($yydddp2,2,3);
    copy("${dirRxn}${f}_${ddd}0.${yy}N","$PATH_SAV$CAMP_SAVRAP/${yyp2}/ATM/");

    copy("${dirIon}${g}${yydddp5}.ION","$PATH_SAV$CAMP_SAVRAP/${yyp5}/ATM/");

    copy("${dirIon}${g}${yydddp5}.INX","$PATH_SAV$CAMP_SAVRAP/${yyp5}/ATM/");
    compress("$PATH_SAV$CAMP_SAVRAP/${yyp5}/ATM/${g}${yydddp5}.INX");

    $yy  = substr($yydddp5,0,2);
    $ddd = substr($yydddp5,2,3);
    copy("${dirRxn}${g}_${ddd}0.${yy}N","$PATH_SAV$CAMP_SAVRAP/${yyp5}/ATM/");

    prtMess($bpe,"SAVED");
  } else {
    prtMess($bpe,"NOTHING SAVED");
  }

# Set today's MJD
# ---------------
  my $mjd0 = gps_date("-doy 0 -o %IJ");

# Distribute predicted ionosphere files
# -------------------------------------
  my $ddd = substr($yyddd,2,3);
  my $yy  = substr($yyddd,0,2);
  if ($sav eq "Y") {
    check_dir("$PATH_AFTP/CODE/IONO/$yyyy/");
    check_dir("$PATH_AFTP/CODE/IONO/$yyp5/");
    check_dir("$PATH_AFTP/CODE/IONO/PRD/");

    my $ionNamP1 = "COD0OPSP0D";
    my $ionNamP2 = "COD0OPSP1D";
    my $ionNamP5 = "COD0OPSP4D";
    copyaftp("${dirIon}${e}${yydddp1}.ION","CODE/COD${wwwwdp1}.ION_P") if $mjd-$mjd0>=-2;
    copyaftp("${dirIon}${e}${yydddp1}.ION","CODE/${ionNamP1}_${yyp1}${dp1}0000_01D_01H_GIM.ION") if $mjd-$mjd0>=-2;

    $ddd = substr($yydddp1,2,3);
    $yy  = substr($yydddp1,0,2);
    copyaftp("-c","${dirIon}${e}${yydddp1}.INX","CODE/COPG${ddd}0.${yy}I") if $mjd-$mjd0>=-2;
    copyaftp("-g","${dirIon}${e}${yydddp1}.INX","CODE/${ionNamP1}_${yyp1}${dp1}0000_01D_01H_GIM.INX") if $mjd-$mjd0>=-2;

    copyaftp("-g","${dirIon}${e}${yydddp1}.INX","CODE/IONO/PRD/${ionNamP1}_${yyp1}${dp1}0000_01D_01H_GIM.INX");

    copyaftp("${dirRxn}${e}_${ddd}0.${yy}N","CODE/CGIM${ddd}0.${yy}N_P") if $mjd-$mjd0>=-2;
    copyaftp("${dirRxn}${e}_${ddd}0.${yy}N","CODE/${ionNamP1}_${yyp1}${dp1}0000_01D_01D_GIM.RNX") if $mjd-$mjd0>=-2;

    copyaftp("${dirIon}${f}${yydddp2}.ION","CODE/COD${wwwwdp2}.ION_P2") if $mjd-$mjd0>=-2;
    copyaftp("${dirIon}${f}${yydddp2}.ION","CODE/${ionNamP2}_${yyp2}${dp2}0000_01D_01H_GIM.ION") if $mjd-$mjd0>=-2;

    $ddd = substr($yydddp2,2,3);
    $yy  = substr($yydddp2,0,2);
    copyaftp("-c","${dirIon}${f}${yydddp2}.INX","CODE/COPG${ddd}0.${yy}I") if $mjd-$mjd0>=-2;
    copyaftp("-g","${dirIon}${f}${yydddp2}.INX","CODE/${ionNamP2}_${yyp2}${dp2}0000_01D_01H_GIM.INX") if $mjd-$mjd0>=-2;
    copyaftp("-g","${dirIon}${f}${yydddp2}.INX","CODE/IONO/PRD/${ionNamP2}_${yyp2}${dp2}0000_01D_01H_GIM.INX");

    copyaftp("${dirRxn}${f}_${ddd}0.${yy}N","CODE/CGIM${ddd}0.${yy}N_P2") if $mjd-$mjd0>=-2;
    copyaftp("${dirRxn}${f}_${ddd}0.${yy}N","CODE/${ionNamP2}_${yyp2}${dp2}0000_01D_01D_GIM.RNX") if $mjd-$mjd0>=-2;

    copyaftp("${dirIon}${g}${yydddp5}.ION","CODE/COD${wwwwdp5}.ION_P5") if $mjd-$mjd0>=-2;
    copyaftp("${dirIon}${g}${yydddp5}.ION","CODE/${ionNamP5}_${yyp5}${dp5}0000_01D_01H_GIM.ION") if $mjd-$mjd0>=-2;

    $ddd = substr($yydddp5,2,3);
    $yy  = substr($yydddp5,0,2);
    copyaftp("-c","${dirIon}${g}${yydddp5}.INX","CODE/COPG${ddd}0.${yy}I") if $mjd-$mjd0>=-2;
    copyaftp("-g","${dirIon}${g}${yydddp5}.INX","CODE/${ionNamP5}_${yyp5}${dp5}0000_01D_01H_GIM.INX") if $mjd-$mjd0>=-2;
    copyaftp("-g","${dirIon}${g}${yydddp5}.INX","CODE/IONO/PRD/${ionNamP5}_${yyp5}${dp5}0000_01D_01H_GIM.INX");

    copyaftp("${dirRxn}${g}_${ddd}0.${yy}N","CODE/CGIM${ddd}0.${yy}N_P5") if $mjd-$mjd0>=-2;
    copyaftp("${dirRxn}${g}_${ddd}0.${yy}N","CODE/${ionNamP5}_${yyp5}${dp5}0000_01D_01D_GIM.RNX") if $mjd-$mjd0>=-2;

    ($ssss,$yyyyddd) = gps_date("-yd $yyddd -d -120 -o %j0 %Y%j");
    @fil = glob("$PATH_AFTP/CODE/IONO/P?/2026/*${ssss}*.*");
    map { print "DEL: $_\n" } @fil;
    @fil = glob("$PATH_AFTP/CODE/IONO/PRD/*${yyyyddd}*.*");
    map { print "DEL: $_\n" } @fil;

    ($ssss,$yyyyddd) = gps_date("-yd $yyddd -d -90 -o %j0 %Y%j");
    @fil = glob("$PATH_AFTP/CODE/IONO/P?*/2026/*${ssss}*.*");
    map { print "DEL: $_\n" } @fil;
    @fil = glob("$PATH_AFTP/CODE/IONO/PRD/*${yyyyddd}*.*");
    map { print "DEL: $_\n" } @fil;

    prtMess($bpe,"DISTRIBUTED");
  } else {
    prtMess($bpe,"NOTHING DISTRIBUTED");
  }

# Upload predicted IONEX to CDDIS
# -------------------------------
  if ($dis eq "Y") {
    $sec0 = gps_date("-t -o %U");
    @fil = ();
    for ($i=6;$i>=-10;$i--) {
      ($yyyyddd) = gps_date("-doy 0 -d $i -o %Y%j");
      @fil = (@fil,glob("$PATH_AFTP/CODE/IONO/PRD/COD0OPSP[014]D_${yyyyddd}0000_01D_01H_GIM.INX.gz"));
    }
    foreach $fil (@fil) {
      $nam = basename($fil);
      $new = $nam;

      $dif = (stat($fil))[9]-$sec0;
##      print "$nam $new $dif\n";
      next if $dif<-3600000;
      print "$nam $new $dif UPLOADED\n";
##      next;

      $iRun = 0;
      $nRun = 3;
      $ftpSum = "${dirOut}CDDIS_PRD.FTP";
      unlink $ftpSum;

      for ($iRun=1;$iRun<=$nRun;$iRun++) {
        $err = "OK";
        my %cddis_upload = ("$fil" => "$new");
        my $irc = upload_cddis_hash(\%cddis_upload);
        $err = "ERR" if $irc!=0;
        if ($err eq "OK") { last }
        sleep (30);
      }
    }
  }

}
