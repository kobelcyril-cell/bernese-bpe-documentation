package DEFCLU;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  DEFCLU
#
# Purpose :  Define "V_DEFCLU" clusters
#
# Programs:
#
# Author  :  M. Meindl
# Created :  03-Aug-2003               Last modified: 09-Feb-2005
#
# Changes :  05-Sep-2003/ss: Reduce cluster size in ULTRA mode
#            08-Sep-2003/mm: Use number of clusters instead of
#                            number of baselines
#            26-Jan-2005/mm: new initPar call (w/o tmpFil)
#            09-Feb-2005 mm: Old date variables removed
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use File::Copy;

sub run {
  my $bpe = shift;


# Get variables
# -------------
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};
  my $V_DEFCLU = $$bpe{V_DEFCLU};
  my ($yyddd,$clbDir) = $bpe->getKeys('$YD+0',"DIR_CLB");


# Concatenate all cluster files
# -----------------------------
  my @clusters = glob("${clbDir}${yyddd}_0[1-9].CLB");
  unlink("${clbDir}${yyddd}.CLB");
  foreach (@clusters) { appFile("",0,$_,"${clbDir}${yyddd}.CLB",0) }
  unlink(@clusters);
  @clusters = ();


# Crerate $V_DEFCLU new clusters
# ------------------------------
  my (@allBl,$i,@bpeFil);
  open (ALL,"${clbDir}${yyddd}.CLB");
  push (@allBl,<ALL>);
  close ALL;

  initPar_Cl($bpe,"${clbDir}${yyddd}_",@allBl,$V_DEFCLU,0,0);

# rename *.BPE files to *.CLB
  for ($i=1;$i<=$V_DEFCLU;$i++) {
    $clusters[$i-1] = sprintf("${clbDir}${yyddd}_%02d.CLB",$i) }

  @bpeFil = glob("${clbDir}${yyddd}_???.BPE");

  for ($i=0;$i<@clusters;$i++) {
    move($bpeFil[$i],$clusters[$i]) }

}
