package SLEEP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  SLEEP
#
# Purpose :  Wait n sec
#
# PARAMs  :  PARAM1 - Optional waiting time (default: 60 sec)
#
# Author  :  S. Schaer
# Created :  08-May-2008
#
# Changes :
#
# ---------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;

  my ($param1) = $bpe->getKeys('PARAM1');

# Set default waiting time
# ------------------------
  $param1 = 60 if $param1 eq "";

# Perform waiting sequence
# ------------------------
  prtMess($bpe,"WAITING $param1 SEC");
  sleep($param1);

}

