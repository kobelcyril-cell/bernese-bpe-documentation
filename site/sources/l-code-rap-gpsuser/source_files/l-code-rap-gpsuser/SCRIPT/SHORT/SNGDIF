use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Define variables
# ----------------
  my ($ssss,$yyddd,$obsDir,$clbDir) =
         $bpe->getKeys('$S+0','$YD+0',"DIR_PSH","DIR_CLB");


# Delete single difference files
# ------------------------------
  unlink(glob("${obsDir}????${ssss}.?S?"));
  unlink(glob("${clbDir}${yyddd}_??.CLB"));


# Run program
# -----------
  my $PGMNAM = "SNGDIF";
  $bpe->RUN_PGMS($PGMNAM);


}
