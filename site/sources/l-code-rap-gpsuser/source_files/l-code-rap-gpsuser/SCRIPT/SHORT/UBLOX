sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,$yydd1,$yydm30,$wwww,$wwww1,$wwwm30,$yyyy,$mjd,
    $dirPre,$extPre,
    $dirPlt,$extPlt,
    $dirLog,$dirPrt,
    $dirSatcrx,$extSatcrx,
    $CAMP_PTH,$CAMPAIGN,
    $v_s,
  ) =
  $bpe->getKeys(
    '$YD+0','$YD+1','$YD-(30)','$WD+0','$WD+1','$WD-(30)','$Y+0','$JD-2',
    'DIR_PRE','EXT_PRE',
    'DIR_PLT','EXT_PLT',
    'DIR_BPELOG','DIR_BPEPRT',
    'PTH_SATCRUX','EXT_SATCRUX',
    'CAMP_PTH','CAMPAIGN',
    'V_S',
  );

# Init some more variables and filenames
# --------------------------------------
  my $OK = 1;                          # Processing status flag
  my $ubxName = "AIUB_${wwww}_00";     # Filename for UBLOX
  my @dayList = (4,9,14);              # Sessions for verification ($S+4,$S+9,..)
  my $maxStd  = 200;                   # Max. allowed std-dev. in ORBCMP
  my $badsat  = "";                    # List of bad satellites
                                       # to be removed from PRE-file because of
                                       # $maxStd exceeded.

# Check if this is an ULTRA:
# -------------------------
  my $ultFil = "$CAMP_PTH${CAMPAIGN}/MSC/ULT${yyddd}.FLG";  # ultra-flag
  my($h_end,$h_tro,$h_rnx,$h_chr) = &rdUltFlg($ultFil);
  my $T = &gtUltVrs($h_end,$h_chr);
  &setUserVar($bpe,"T",$T);

  $ubxName = "AIUB_${wwww}_${h_end}";       # Filename for UBLOX

  my $stadat = '$YMD_STR+0';
  my $statim = "${h_end} 00 00";
  my $enddat = '$YMD_STR+(15)';
  my $endtim = "${h_end} 00 00";

  my $mm     = 0;

  setMinusPlus($bpe,-1,0);                  # Selection for ORBCMP

  # IGSRAPID: "ultra06"
  unless(-e $ultFil) {

    $h_end   = "06";
    $ubxName = "AIUB_${wwww1}_${h_end}";

    $stadat = '$YMD_STR+1';
    $statim = "${h_end} 00 00";
    $enddat = '$YMD_STR+(16)';
    $endtim = "${h_end} 00 00";

    @dayList = (5,10,15);
    $mm      = 1;            # Necessary for the correction of the protocol
                             # @dayList = (5,10,15) -> (4,9,14)

    setMinusPlus($bpe,0,1);                  # Selection for ORBCMP
    $bpe->putKey("$$bpe{U}/PAN/STDPRE.INP","PREOUT",'$S_$YD+1');
    $bpe->putKey("$$bpe{U}/PAN/PREWEI.INP","PREFIL",'$S_$YD+1');
  }

# Define some more filenames
# --------------------------
  my $byeFil = "$ENV{MSC}/BYE_UBLOX.BPE";   # The system-checker's BYE-file

  my $dirUbx = "$ENV{S}/UBLOX/$yyyy/";      # Archive for UBLOX submissions
  mkpath($dirUbx) unless -d $dirUbx;

  my $prtFil = "${dirPrt}${ubxName}.PRT";   # protocol file
  my $logFil = "${dirLog}${ubxName}.LOG";   # FTP-log file

# Check if the curent filename is earlier than the latest one in the archive:
# no resubmissions to ublox in the date of a repeated run of IGSRAPID
# ---------------------------------------------------------------------------
  my $archive = (sort glob "${dirUbx}AIUB*.${extPre}*")[-1];
  if("$archive" ne "" &&
      (sort(basename($archive),"$ubxName"))[0] eq $ubxName) {
    $bpe->prtErr("Submission to UBLOX skipped: reprocessing");

# Check if the ULTRA-flag-file is older than 900 seconds
# (otherwise the next ultra is already running)
# ------------------------------------------------------
  } elsif(-e $ultFil && time-(stat $ultFil)[9] < 900) {
    $bpe->prtErr("Submission to UBLOX skipped: new ultra-flag");

# Normal schedule, start preparation of the submission
# ----------------------------------------------------
  } else {

# Update and merge NANU and ULTRA SATCRUX files
# ---------------------------------------------
    my $ultcrx = "${dirSatcrx}/ULT${yyddd}.${extSatcrx}";
    my $nancrx = "${dirSatcrx}/NANU${yyyy}.${extSatcrx}";
    my $outcrx = "${dirSatcrx}/${v_s}_${yyddd}.${extSatcrx}";

    my $nanu = updateCrux($mjd,$ultcrx,$nancrx,$outcrx);

    # Report the recent NANUs
    print "Recent NANUs (considered for this extrapolation):\n",
          "================================================\n";
    print "$nanu\n";

# Run programs
# ------------
    $bpe->putKey("$$bpe{U}/PAN/STDPRE.INP","STADAT","$stadat");
    $bpe->putKey("$$bpe{U}/PAN/STDPRE.INP","STATIM","$statim");
    $bpe->putKey("$$bpe{U}/PAN/STDPRE.INP","ENDDAT","$enddat");
    $bpe->putKey("$$bpe{U}/PAN/STDPRE.INP","ENDTIM","$endtim");

    my $PGMNAM = "STDPRE";
    $bpe->RUN_PGMS($PGMNAM);

    $PGMNAM = "PREWEI";
    $bpe->RUN_PGMS($PGMNAM);

    # Check the content of the PRE-file
    my $prefil = $bpe->getKey("$$bpe{U}/INP/STDPRE.INP","PREOUT");
    my %preEpo = checkPrefil($prefil);

    # Check for an error
    $OK = $OK && -s $prefil;
    $bpe->prtErr("no orbit file created ($prefil)") unless $OK;

    # Report the content of the pre-files
    print "Content of the submitted PRE-file:\n",
          "=================================\n";

    print "                Number of epochs             \n";
    print " Sat   orb+clk  only orb  no pred.     total \n";

    # Loop all satellites
    foreach my $sat (sort keys %preEpo) {
      printf " %s %8d  %8d  %8d  %8d  \n",
             $sat, $preEpo{$sat}{OK}, $preEpo{$sat}{CLK}, $preEpo{$sat}{BAD},
             $preEpo{$sat}{OK} + $preEpo{$sat}{CLK} + $preEpo{$sat}{BAD};
    }
    print "\n";

# Compare with the last UBLOX-prediction
# --------------------------------------
    # Get the name of the predicted file
    my $prefi0 = $prefil;
    $prefi0 =~ s/${yydd1}.${extPre}/${yyddd}.${extPre}/;

    my %preDif = ();
    map { %{$preDif{$_}} = checkORBCMP('init', keys %preEpo) } @dayList;

    if($OK && -s $prefi0) {
      foreach my $day (@dayList) {

        my $day0 = $day-1;

        $bpe->putKey("$$bpe{U}/PAN/ORBCMP.INP","STADAT","\$YMD_STR+($day0)");
        $bpe->putKey("$$bpe{U}/PAN/ORBCMP.INP","STATIM","$statim");
        $bpe->putKey("$$bpe{U}/PAN/ORBCMP.INP","ENDDAT","\$YMD_STR+($day)");
        $bpe->putKey("$$bpe{U}/PAN/ORBCMP.INP","ENDTIM","$endtim");

        $PGMNAM = "ORBCMP";
        $bpe->RUN_PGMS($PGMNAM);

        %{$preDif{$day}} = checkORBCMP($bpe->getKey("$$bpe{U}/INP/ORBCMP.INP","OUTPUT"),
                              keys %preEpo);
      }

      # Report the quality of the predicted orbits
      print "Statistics of the submitted PRE-file:\n",
            "====================================\n";

      my $lin1 = "      ";
      my $lin2 = " Sat  ";
      foreach my $day (@dayList) {
        $lin1 .= sprintf "|     Statistics on prediction for day %-2d ", $day-$mm;
        $lin2 .= "|  num     mean      max      std   huge  ";
      }
      print "$lin1\n$lin2\n";

      # Loop all satellites
      foreach my $sat (sort keys %preEpo) {

        # Content of PRE file
        my $line = sprintf " %s  ",$sat;

        # Prediction statistics
        foreach my $day (@dayList) {
          $line .= sprintf "| %4d %8.1f %8.1f %8.1f %6d  ",
               $preDif{$day}{$sat}{NUM},$preDif{$day}{$sat}{MEAN},
               $preDif{$day}{$sat}{MAX},$preDif{$day}{$sat}{STDW},
               $preDif{$day}{$sat}{HUGE};
        }
        print "$line\n";

      }
      print "\n";
    }

# Prepare the protocol submitted to ublox
# ---------------------------------------
    if($OK) {
      open(PRT,"> $prtFil");

      # Report the recent NANUs
      print PRT "Recent NANUs (considered for this extrapolation):\n",
                "================================================\n";
      print PRT "$nanu\n";

      # Write the header
      print PRT "Content and Statistics of the submitted PRE-file:\n",
                "================================================\n";

      print PRT "                Number of epochs             " .
                "|  Statistics on prediction (std in m) after \n";

      my $line = " Sat   orb+clk  only orb  no pred.     total ";
      map { $line .= sprintf "|  num   %3d days ", $_-$mm } @dayList;
      print PRT "$line\n";

      # Loop all satellites
      foreach my $sat (sort keys %preEpo) {

        # Content of PRE file
        $line = sprintf " %s %8d  %8d  %8d  %8d  ",
                $sat, $preEpo{$sat}{OK}, $preEpo{$sat}{CLK}, $preEpo{$sat}{BAD},
                $preEpo{$sat}{OK} + $preEpo{$sat}{CLK} + $preEpo{$sat}{BAD};

        # Prediction statistics
        foreach my $day (@dayList) {
          $line .= sprintf "| %4d %8.1f   ",
               $preDif{$day}{$sat}{NUM},
               $preDif{$day}{$sat}{STDW};

          $badsat .= " $sat " if ($preDif{$day}{$sat}{STDW} > $maxStd &&
                                  $badsat !~ / $sat / );
        }
        print PRT "$line\n";

      }
      print PRT "\n";

      print PRT "List of Satellites Removed Because of Uncertain Prediction:\n";
      print PRT "==========================================================\n";
      if($badsat eq "") {
        print PRT "none\n\n";
      } else {
        print PRT "$badsat\n\n";
      }
      close PRT;

      # report bad satellites
      print "List of Satellites Removed Because of Uncertain Prediction:\n";
      print "==========================================================\n";
      if ( $badsat eq "" ) {
        print "none\n\n";
      } else {
        print "$badsat\n\n";
      }

      # Remove bad satellites from PRE-file
      cleanPre($prefil,$badsat) if ($OK);
      $OK = $OK && -s $prefil;
      $bpe->prtErr("update of orbit file failed ($prefil)") unless $OK;

    } # endif OK

    # Check for the completness of the protocol file
    if ( $OK ) {
      $OK = $OK && -s $prtFil;
      $bpe->prtErr("no protocol created ($prtFil)") unless $OK;
    } # endif OK
    my $passTest = $OK;
# Submit the results (if allowed)
# -------------------------------
    if($$bpe{V_DIS} eq "Y" && !-e "$ENV{HOME}/../l_code/MSC/NO_DIS.FLG") {

      if($OK) {
#        $OK = $OK && ftp2ublox($prefil,"${ubxName}.${extPre}",$logFil);
        $OK = $OK && sftp2ublox($prefil,"${ubxName}.${extPre}",$logFil);
# Temporarily removed, it will be discussed at the next GNSS-group meeting.
        $bpe->prtErr("ftp to ublox failed") unless $OK;
      }

# Report the sucessful submission or an error
# -------------------------------------------
      if ( $OK ) {
        msg2key("UBX","-f $prtFil",
                "FTP of ${ubxName} to ublox finished");

        open (BYE,"> $byeFil");
        print BYE scalar gps_date("-t","-o %U / 21600 / %z / UBLOX / ${ubxName}");
        close BYE;

      } else {
        msg2key("UBX","-f $$bpe{PRT_FILE}",
                "Generation of the orbit for UBLOX failed");
      }

    } else {
      prtMess($bpe,"FILES NOT DISTRIBUTED");
    }

# Copy submitted files to an archive (if allowed)
# -----------------------------------------------
    if ($$bpe{V_SAV} eq "Y") {
      if ( $OK ) {
        to_archiv($prefil,"${dirUbx}${ubxName}.${extPre}");
        to_archiv($logFil,"${dirUbx}${ubxName}.LOG");
        to_archiv($prtFil,"${dirUbx}${ubxName}.PRT");
      }elsif( $passTest ){
        to_archiv($prefil,"${dirUbx}${ubxName}.${extPre}");
        to_archiv($logFil,"${dirUbx}${ubxName}.LOG");
        to_archiv($prtFil,"${dirUbx}${ubxName}.PRT");
      }
    } else {
      prtMess($bpe,"FILES NOT SAVED");
    }

    die() unless $OK;

  } # end of skip submission for any reason

# ---------------------------------------------------------------------------
# Update and merge NANU and ULTRA SATCRUX files
# ---------------------------------------------------------------------------
sub updateCrux {
    my $mjd    = shift;
    my $ultcrx = shift;
    my $nancrx = shift;
    my $outcrx = shift;

# Update the NANU-CRUX files
# --------------------------
    my $nanu = "";
    open (NANU, "$ENV{AUTO}/nanu_crx.com --report=$mjd |");
    while (<NANU>) {
      $nanu .= $_
    }
    close NANU;

# Merge NANU and ULTRA SATCRUX files
# ---------------------------------------------
    open(OUT,"> $outcrx");
    open(ULT,"< $ultcrx");
    my $ii = 1;
    while (my $ult = <ULT>) {
      print OUT $ult;
      if ($ii == 6) {
        open(NANU,"< $nancrx");
        while( my $nanu = <NANU> ) {
          if ( $nanu =~ /^[ \d]{5}         3         2       [\d]{4} \d\d \d\d \d\d \d\d \d\d  ([\d]{4}) (\d\d) (\d\d) (\d\d) (\d\d) (\d\d)/) {
            my ($year,$month,$day) = ($1,$2,$3);
            my ($std,$min,$sec) = ($4,$5,$6);

            print OUT $nanu
              if ($year eq "2099" ||
                  $mjd <= gps_date("-ymd $year $month $day ",
                                   "-hms $std $min $sec",
                                   "-o %J") )
          }
        }
        close NANU;
      }
      $ii++;
    }
    close ULT;
    close OUT;

    return $nanu;
}

# ---------------------------------------------------------------------------
# Check the PRE-file
# ---------------------------------------------------------------------------
  sub checkPrefil {
      my $prefil = shift;

      my %preEpo = ();
      open (PRE,$prefil);
      while (<PRE>) {
        next unless /^P/;
        my ($sat,$xx,$yy,$zz,$cc) = split();

        $sat =~ s/^P//;

        # A new satellite
        unless ( defined $preEpo{$sat} ) {
          $preEpo{$sat}{BAD} = 0;
          $preEpo{$sat}{CLK} = 0;
          $preEpo{$sat}{OK}  = 0;
        }

        # neither orbit nor clock
        if (abs($xx)+abs($yy)+abs($zz) == 0) {

          $preEpo{$sat}{BAD}++

        # orbit but no clock
        } elsif ($cc == 999999.999999) {
          $preEpo{$sat}{CLK}++

        # complete record
        } else {
          $preEpo{$sat}{OK}++
        }
      }
      close PRE;

      return %preEpo;
    }

# ---------------------------------------------------------------------------
# Check the ORBCMP-output
# ---------------------------------------------------------------------------
  sub checkORBCMP{
      my $pltfil = shift;

      # Init the hash variables
      my %epoDif = ();

      foreach my $sat (@_) {
        $epoDif{$sat}{NUM}  = 0;
        $epoDif{$sat}{MEAN} = 0;
        $epoDif{$sat}{STDW} = 0;
        $epoDif{$sat}{HUGE} = 0;
        $epoDif{$sat}{MAX}  = 0;
      }

      # Read the ORBCMP PLT-file
      unless (lc $pltfil eq "init") {
        open (DIF,$pltfil);
        while (my $lin = <DIF>) {
          next unless $lin =~ / \| P P \| /;

          my $sat = sprintf "G%2d", substr($lin,3,3);
          $sat =~ s/G /G0/;

          my $rrr = substr($lin,34,10);
          my $sss = substr($lin,44,10);
          my $www = substr($lin,54,10);

          # Huge (e.g., because of maneuver)
          if ($rrr =~ /\*/ || $sss =~ /\*/ || $www =~ /\*/ ) {
            $epoDif{$sat}{HUGE}++;

          # Normal record
          } else {

            my $tot = sqrt($rrr**2 + $sss**2 + $www**2);

            $epoDif{$sat}{NUM}++;
            $epoDif{$sat}{MEAN} += $tot;
            $epoDif{$sat}{STDW} += $tot**2;

            $epoDif{$sat}{MAX} = $tot if ($epoDif{$sat}{MAX} == 0 ||
                                          $epoDif{$sat}{MAX} < $tot);

          }
        }
        close DIF;

        foreach my $sat (keys %epoDif) {
          if ($epoDif{$sat}{NUM} > 1) {
            $epoDif{$sat}{MEAN} /= $epoDif{$sat}{NUM};
            $epoDif{$sat}{STDW} /= $epoDif{$sat}{NUM}-1;
            $epoDif{$sat}{STDW}  = sqrt $epoDif{$sat}{STDW};
          }
        }
      }
      return %epoDif;
    }

# ---------------------------------------------------------------------------
# Remove bad satellites from PRE-file
# ---------------------------------------------------------------------------
  sub cleanPre {
      my $prefil = shift;
      my $badsat = shift;

      # There are bad satellites?
      if ( $badsat ne "" ) {

        # Read the file into a buffer
        my $pre = "";
        open (PRE,"< $prefil");
        while (my $line = <PRE>) {

          # Empty records for bad satellites
          if ( $line =~ /^P([GRE]\d\d) / ) {
            my $sat = $1;
            if ( $badsat =~ / $sat / ) {
              $pre .= sprintf "P%s%14.6f%14.6f%14.6f%14.6f%s",
                              $sat,0,0,0,999999.999999,substr($line,60);
              next
            }
          }

          # Buffer the remaining records
          $pre .= $line
        }
        close PRE;

        # Write the new file
        open (PRE,"> ${prefil}");
        print PRE $pre;
        close PRE;
      }
  }

