# Last mod.: 10-Feb-2005
#
# Changes:   16-Mar-2004 HB: Replace V_W by V_Q
#                           (Integration of high-rate clocks in CLKRAPID.PCF)
#            10-Feb-2005 MM: $s replaced by $bpe
#            07-Jun-2016 RD: Add version with compatible attitude modelling
#            16-Sep-2019 AV: PCFFIL check: test for RCLKGNSS*
#
# ----------------------------------------------------------------------------
use strict;
use lib "$ENV{BPE}";
use bpe_util;
use File::Copy;


sub run
{
  my $bpe = shift;


# Define variables
# ----------------
  my          ($yyddd, $yyssss, $U ,$V_Q ,$V_U ,$pcf,$CAMP_PTH, $CAMPAIGN) =
  $bpe->getKeys('$YD+0','$YSS+0','U',"$$bpe{PARAM1}","$$bpe{PARAM2}",'PCFFIL','CAMP_PTH','CAMPAIGN');

  my @clkLst = $pcf =~ /RCLKGNSS.*PCF/ ?
               ( "${V_Q}N${yyssss}","${V_U}_${yyssss}" ) :
               ( "${V_Q}N${yyddd}","${V_U}_${yyddd}" );

  replaceSelLst($bpe,"CCRNXC","RCLKINP",@clkLst);

# Run program CCRNXC
# --------------------
  my $PGMNAM = "CCRNXC";
  $bpe->RUN_PGMS($PGMNAM);

}
