#!/bin/sh
# SCRIPT-NAME
# sh script file written by bds
# -----------------------------
# functions used by shell
do_rm( ) {
    if [ "$1" ]
    then
        if [ -f `echo $1 | tr ' ' '\012' | head -1` ]
        then
            eval rm $1
        fi
    fi
}
#
toupper( ) {
    eval $1=`echo $2 | ${UPPERC}`
    eval export $1
}
#
seterr( ) {
    if [ $? = 0 ]
    then
        ERRSTAT=OK
    else
        ERRSTAT=ERR
    fi
}
#
# -----------------------------
# SHELL STARTS HERE
# -----------------------------
#
# GIMEDTAP
# ========
#
# 06-Jan-2003/hu: Pole files in ORB instead of X/GEN
# 13-Mar-2003/mm: Remove *.J_lk lock files
# 28-Jul-2003/rd: Adapt to the new BPE (no links anymore, remove CLEAN_UP)
# 29-Jul-2003 rd: Replace "{]}" by "]" in path names
#
# A PRIORI SCRIPT TO PREPARE PARALLEL RUNNING OF GPSEST WITH RESIDUAL EDITING
# (using V_H pole file)
#
# SHELL VARIABLES:
# ----------------
#
# YEAR    :  Year of the session to be processed (2 digit)
# SESSION :  Session number (4 characters)
# CAMPAIGN:  Campaign name
# CAMP_PTH:  Campaign path
# CAMP_DRV:  Drive letter for campain (i.e. P)
# OPT_DIR :  Directory for panels
# PID     :  Process identification number (3 digits)
# SUB_PID :  Subprocess id (3 digits)
# PRT_FILE:  Protocol file name including path
# SCRIPT  :  Name of script
# TASKID  :  Task id of script, usually 00
# PRIORITY:  Priority of the script
# CPU     :  CPU the script is running on
# DAYYEAR :  Julian day of the year
# DAY     :  Day of the Month
# MONTH   :  Month, 1=JAN, 12=DEC
# GPSWEEK :  GPS week
# DAYWEEK :  Day of the week, 0=SUN, 6=SAT
# V_X     :  X Variable in DAT151__.PAN
# V_O     :  O Variable in DAT151__.PAN
# V_Z     :  Z Variable in DAT151__.PAN
# V_PLUS  :  Plus variable in DAT151__.PAN
# V_MINUS :  Minus variable in DAT151__.PAN
# V_x     :  User variable
# PARAMx  :  Script specific parameter, x is 1 thru 9
# U       :  Directory path to U:
#
# See if this shell is being run from the PCS
# script, or directly for testing.  If testing,
# no the header script is not passed in as %1%
#
if [ "$1" = "" ]
then
#
#   set variables for testing here
#
    TEST_START_DIR=`pwd`
    cd $U/WORK
    TESTING="YES"
    export TESTING
else
    TESTING="NO"
    export TESTING
    . "$1"
    seterr
fi
#
# START THE MENU SYSTEM IN NON-INTERACTIVE MODE
# ---------------------------------------------
. $X/SCRIPT/BEG_MENU
seterr
#
# SET VARIABLES IN DAT151__.PAN
# -----------------------------
. $X/SCRIPT/SET_SESS
seterr
#
# SHELL BODY
# ----------
#
# GPSEST - remove all residual files
# ----------------------------------
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/????"$SESSION".RES
#
# Copy pole file
# --------------
cp "$CAMP_PTH""$CAMPAIGN"/ORB/"$V_H"_"$YEAR""$DAYYEAR".ERP "$CAMP_PTH""$CAMPAIGN"/ORB/GIR"$YEAR""$DAYYEAR".ERP
#
# Delete old output files
# -----------------------
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/*.J_lk
#
PGMNAM="GPSEST"
export PGMNAM
TMPFLG="GIR"
export TMPFLG
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/"$TMPFLG"*.BPE
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/"$TMPFLG"???.EDT
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/"$TMPFLG"???.OUT
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/"$TMPFLG"???_?.RES
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/"$TMPFLG"???.SUM
#
# Define some temporary files
# ---------------------------
tmp_id=$$
export tmp_id
TMPFIL1="B_"$tmp_id".TM1"
export TMPFIL1
TMPFIL2="B_"$tmp_id".TM2"
export TMPFIL2
rm -f "$TMPFIL1"
rm -f "$TMPFIL2"
#
# Set the parallel file
# ---------------------
FILE="$T/AUTO_TMP/"$PARAM1""
export FILE
rm -f "$FILE"
#
# Loop over all Baselines
# -----------------------
MAXFIL="10"
export MAXFIL
COUNT="1"
export COUNT
CLUST="1"
export CLUST
CZHFIL=""$CAMP_PTH""$CAMPAIGN"/OBS/????"$SESSION".CZH"
export CZHFIL
for F in  $CZHFIL
do
    if [ "$COUNT" -eq 1 ]
    then
        echo "$CAMP_PTH""$CAMPAIGN"/OUT/"$TMPFLG""$CLUST".BPE >> "$FILE"
    fi
#
#   Get the filename without path for "SEL" file
#   --------------------------------------------
    echo "$F" > "$TMPFIL1"
    ${EXE}/RBPE PRSLIN "$TMPFIL1" "$TMPFIL2"
    seterr
    FILNAM=`cat "$TMPFIL2"`
    export FILNAM
    echo "$FILNAM" >> "$CAMP_PTH""$CAMPAIGN"/OUT/"$TMPFLG""$CLUST".BPE
    if [ "$COUNT" -ge "$MAXFIL" ]
    then
        CLUST=`expr "$CLUST" + 1`
        export CLUST
        COUNT="1"
        export COUNT
    else
        COUNT=`expr "$COUNT" + 1`
        export COUNT
    fi
done
#
# --------------
# end the script
# --------------
. $X/SCRIPT/END_MENU
seterr
if [ "$TESTING" = "YES" ]
then
    cd "$TEST_START_DIR"
else
    . $X/SCRIPT/DO_TAIL
    seterr
fi
