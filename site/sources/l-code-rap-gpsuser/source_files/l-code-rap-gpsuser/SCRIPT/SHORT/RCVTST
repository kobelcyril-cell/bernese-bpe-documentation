use lib $ENV{BPE};
use bpe_util;
use File::Copy;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yy,$ddd,$dirOut) = $bpe->getKeys('$Y','$+0','DIR_OUT');


# Delete old output files
# -----------------------
  my $filOut = "${dirOut}RCVTST.OUT";
  unlink($filOut);


# Run program
# -----------
  my $PGMNAM = "RCVTST";
  $bpe->RUN_PGMS($PGMNAM);


# Save output
# -----------
  copy ($filOut,"${dirOut}RCVTST.${yy}_${ddd}") or
      prtErr($bpe,"$filOut not found") and die;


# Run program
# -----------
  $bpe->putKey("$ENV{U}/PAN/RCVTST.INP","ARSUM","MWW?????");
  $bpe->RUN_PGMS($PGMNAM);


}
