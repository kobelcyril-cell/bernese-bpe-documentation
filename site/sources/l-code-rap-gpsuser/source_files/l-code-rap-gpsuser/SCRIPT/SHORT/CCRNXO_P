package CCRNXO_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  CCRNXO_P
#
# Purpose :  Parallel CCRNXO
#
# Programs:  CCRNXO
#
# Author  :  A. Villiger
# Created :  16-Apr-2018
#
# Changes :  13-Aug-2021 RD: Use individual SYSOUT names instead of the generic one
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

  my ($ddd,$yy,$yyyy,$outRnx, $subPid) =
  $bpe->getKeys(
      '$+0','$Y','$Y+0','DIR_RXO','SUB_PID');

# Define variables
# ----------------
  my $PARAM1  = $$bpe{PARAM1};
  if ($PARAM1 ne "PARALLEL") {

# Replace selected with station list
# ----------------------------------
    replaceSel($bpe,"CCRNXO","CONCAT",$PARAM1);

  # Set cluster number and input files
  # ----------------------------------
  setUserVar($bpe, "FFF", $subPid);

# Run program
# -----------
    my $PGMNAM = "CCRNXO";
    $bpe->RUN_PGMS($PGMNAM);

# Print processed stations BPE file
# ---------------------------------
    my %sites;
    open (BPE,$PARAM1);
    print "\n\n","-"x75,"\n";
    print "Contents of BPE file $PARAM1\n";
    print "-"x75,"\n";
    foreach (<BPE>) {
      chomp;
      print "$_\n";
      unlink ("$_");
      $sites{$1} = 1 if /\/(\w\w\w\w)(....._._|\d\d\d.\.)/;
    }
    print "-"x75,"\n";
    close BPE;
    unlink ("$PARAM1");

# Long to short filenames
# -----------------------
    foreach my $sta (sort keys %sites){
     print "GLOB: $outRnx/${sta}?????_?_${yyyy}${ddd}????_*?O.RNX\n";
     my @file = glob "$outRnx/${sta}?????_?_${yyyy}${ddd}????_*?O.RNX";
     next unless -s $file[0];
     copyfile($file[0],"$outRnx/$sta${ddd}0.${yy}O");
     print "FILE $file[0] $outRnx/$sta${ddd}0.${yy}O\n";
     unlink $file[0];
    }
  }
}
