package LSC_INI;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  LSC_INI
#
# Purpose :  Linearity of satellite clocks (LSC) for CLKEST clock alignment:
#            Remove satellites included in MSC/LSC_INI.LST from BRD CLK file.
#
# Programs:
#
# Author  :  S. Schaer
# Created :  06-Oct-2020
#
# Changes :  06-Oct-2020 ss: Considered optional validity periods (MJD1-MJD2)
#            06-Oct-2020 ss: Considered OUT/LSCyyssss.LST (if existing)
#            04-Mar-2021 av: Create LSC_INI.FLG if not existing
#            07-Sep-2021 ss: Corrected $mjd (using $JD+0)
#
# ----------------------------------------------------------------------------
use strict;
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $mjd, $v_a, $pcfFil, $CAMP_PTH, $CAMPAIGN, $dirOut, $dirClk) =
    $bpe->getKeys('$YSS+0','$JD+0','V_A','PCFFIL','CAMP_PTH','CAMPAIGN','DIR_OUT','DIR_CLK');

  $pcfFil = (split('\.',$pcfFil))[0];

  my $lstFil = "$dirOut/../MSC/LSC_INI.LST";
  my $clkFil = "$dirClk/${v_a}_${yyssss}.CLK";
##  copy($clkFil,"${clkFil}_OLD");

# Consider MSC/LSC_INI.LST
# ------------------------
  my @iniLst = ();
  if (-e $lstFil) {
    @iniLst = `grep '^[A-Z][0-9][0-9]' $lstFil`;
    chomp(@iniLst);
  } else {
    prtMess($bpe,"$lstFil not found");
    system("touch $lstFil");
#    die "$lstFil not found\n";
  }

# Consider OUT/LSCyyssss.LST (if existing)
# ----------------------------------------
  $lstFil = "$dirOut/LSC${yyssss}.LST";
  if (-e $lstFil) {
    @iniLst = `grep '^[A-Z][0-9][0-9]' $lstFil | cut -c1-3`;
    chomp(@iniLst);
  }

# Remove corresponding satellite clock entries from BRD_yyssss.CLK
# ----------------------------------------------------------------
  foreach (@iniLst) {
    my $prn = substr($_,0,3);
    my $mjd1 = (split(" ",$_))[1];
    my $mjd2 = (split(" ",$_))[2];
    $mjd1 =     0 if $mjd1 eq "";
    $mjd2 = 99999 if $mjd2 eq "";
    next if $mjd < $mjd1;
    next if $mjd > $mjd2;
    my $prnTmp = $prn;
    $prnTmp =~ s/^G/ /;
    $prnTmp =~ s/^R/1/;
    $prnTmp =~ s/^E/2/;
    $prnTmp =~ s/^S/3/;
    $prnTmp =~ s/^C/4/;
    $prnTmp =~ s/^J/5/;
    substr($prnTmp,0,2) = "  " if substr($prnTmp,0,2) eq " 0";

    my $num = `grep '^$prnTmp' $clkFil | wc -l`+0;
    if ($num >0 ) {
      `grep -v '^$prnTmp' $clkFil > ${clkFil}_TMP`;
      move("${clkFil}_TMP",$clkFil);

      prtMess($bpe,"$pcfFil LSC_INI $yyssss $prn removed from ${v_a}_${yyssss}.CLK");
    }
  }
}
