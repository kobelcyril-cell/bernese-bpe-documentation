package VERI_BIA;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  VERI_BIA
#
# Purpose :  Verificate CODE.OSB (and CODE.BIA) used at CODE
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  28-Jan-2021
#
# Changes :  28-Jan-2021 SS: Added CODE_30D.OSB
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use newFTP;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;
use File::Compare qw(compare);
use cddis_curl;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $mjd,
      $sav, $dis,
      $dirBia, $dirOut) =
    $bpe->getKeys('$YSS+0', '$JD+0',
                  'V_SAV', 'V_DIS',
                  'DIR_BIA', 'DIR_OUT');

# Set today's MJD
# ---------------
  my $mjd0 = gps_date("-doy  0 -o %IJ");
  my $mjd_ = gps_date("-doy -1 -o %IJ");

# Return if not nominal DCBIONO BPE processing day
# ------------------------------------------------
  if ($mjd != $mjd_) { prtMess($bpe,"NO VERIFICATION"); return }

  my ($inp,$mjd1,$mjd2,$yyyymmdd1,$yyyymmdd2,$yyyyddd1,$yyyyddd2,$win,$val);

# Verificate CODE.OSB used at CODE
# --------------------------------
  $inp  = "$ENV{REF}/CODE.OSB";
  $mjd1 = 99999;
  $mjd2 =     0;
  open(INP,"< $inp");
  foreach (<INP>) {
    if (substr($_,0,5) eq "OSB  ") {
      $yyyymmdd1 = substr($_,44,10);
      $yyyymmdd2 = substr($_,65,10);
      $mjd  = gps_date("-ymd $yyyymmdd1 -o %IJ");
      $mjd1 = $mjd if $mjd<$mjd1;
      $mjd  = gps_date("-ymd $yyyymmdd2 -o %IJ");
      $mjd2 = $mjd if $mjd>$mjd2;
    }
  }
  close INP;

  $win = $mjd2-$mjd1;
  $val = $mjd2-$mjd0;
  print "$mjd1/$mjd2 $mjd0 win=$win val=$val\n";
  if ($win != 37) {
    prtMess($bpe,"$inp with unexpected validity interval ($win instead of 37 days)");
    die         ("$inp with unexpected validity interval ($win instead of 37 days)");
  }
  if ($val <= 5) {
    prtMess($bpe,"$inp with shortened validity ($val instead of 7 days)");
    warn        ("$inp with shortened validity ($val instead of 7 days)");
    msg2key("BPE","DCBIONO_${yyssss}: $inp with shortened validity ($val instead of 7 days)");
    die if $val <= 3;
  }

# Verificate CODE_30D.OSB
# -----------------------
  $inp  = "$ENV{REF}/CODE_30D.OSB";
  $mjd1 = 99999;
  $mjd2 =     0;
  open(INP,"< $inp");
  foreach (<INP>) {
    if (substr($_,0,5) eq "OSB  ") {
      $yyyymmdd1 = substr($_,44,10);
      $yyyymmdd2 = substr($_,65,10);
      $mjd  = gps_date("-ymd $yyyymmdd1 -o %IJ");
      $mjd1 = $mjd if $mjd<$mjd1;
      $mjd  = gps_date("-ymd $yyyymmdd2 -o %IJ");
      $mjd2 = $mjd if $mjd>$mjd2;
    }
  }
  close INP;

  $win = $mjd2-$mjd1;
  $val = $mjd2-$mjd0;
  print "$mjd1/$mjd2 $mjd0 win=$win val=$val\n";
  if ($win != 37) {
    prtMess($bpe,"$inp with unexpected validity interval ($win instead of 37 days)");
    die         ("$inp with unexpected validity interval ($win instead of 37 days)");
  }
  if ($val <= 3) {
    prtMess($bpe,"$inp with shortened validity ($val instead of 7 days)");
    warn        ("$inp with shortened validity ($val instead of 7 days)");
    msg2key("BPE","DCBIONO_${yyssss}: $inp with shortened validity ($val instead of 7 days)");
    die if $val <= 1;
  }

# Verificate CODE.BIA
# -------------------
  $inp  = "$ENV{REF}/CODE.BIA";
  $mjd1 = 99999;
  $mjd2 =     0;
  open(INP,"< $inp");
  foreach (<INP>) {
    if (substr($_,0,5) eq " OSB ") {
      $yyyyddd1 = substr($_,35,8);
      $yyyyddd1 =~ s/:/ /g;
      $yyyyddd2 = substr($_,50,8);
      $yyyyddd2 =~ s/:/ /g;
      $mjd  = gps_date("-yd $yyyyddd1 -o %IJ");
      $mjd1 = $mjd if $mjd<$mjd1;
      $mjd  = gps_date("-yd $yyyyddd2 -o %IJ");
      $mjd2 = $mjd if $mjd>$mjd2;
    }
  }
  close INP;

  $win = $mjd2-$mjd1;
  $val = $mjd2-$mjd0;
  print "$mjd1/$mjd2 $mjd0 win=$win val=$val\n";
  if ($win != 30) {
    prtMess($bpe,"$inp with unexpected validity interval ($win instead of 30 days)");
    die         ("$inp with unexpected validity interval ($win instead of 30 days)");
  }
  if ($val <= -3) {
    prtMess($bpe,"$inp information expired or not updated");
    warn        ("$inp information expired or not updated");
    msg2key("BPE","DCBIONO_${yyssss}: $inp information expired or not updated");
    die if $val <= -5;
  }

}
