sub ftpUploadBKG{
  my %cont = %{(shift)};
  my $log  = shift;
  my $err  = "${log}_ERR";

  my $ret  = 1;

  my $host_bkg = "141.74.17.25";
  my $user_bkg = "code-put";
  my $port_bkg = "20022";

  unlink "${log}";
  unlink "${log}2";
  unlink "${err}";

  foreach my $file (keys %cont){
    print "BKG: $cont{$file} -> $file\n";
# gzip if requested
    if($file =~ /\.gz$/ && $cont{$file} !~ /\.gz$/){
      my $tmpFil = "$ENV{T}/bkg_upload/$file";
      print "gzip -nc $cont{$file} > $tmpFil\n";
      system("gzip -nc $cont{$file} > $tmpFil");
      system("scp -v -i $ENV{HOME}/.ssh/id_rsa_bkg -P $port_bkg  $tmpFil ${user_bkg}\@${host_bkg}:IGSac/$file > ${err} 2>>${log}2");
      unlink $tmpFil;
    }
    else {
      system("scp -v -i $ENV{HOME}/.ssh/id_rsa_bkg -P $port_bkg  $cont{$file} ${user_bkg}\@${host_bkg}:IGSac/$file > ${err} 2>>${log}2");
    }
  }
  if(-s $err){
    $ret = 0;
  }

  open LOG, "< ${log}2";
  open OUT, "> ${log}";
  print OUT "LOG BKG:\n";
  map {print OUT $_ unless /debug/} (<LOG>);
  close OUT;
  close LOG;

  print "Upload to BKG log: $log\n";
  print "RETURN BKG $ret\n";

  return $ret;
}

sub ftpUploadIERS{
  my %cont = %{(shift)};
  my $log  = shift;
  my $yyyy  = shift;
  my $ddd  = shift;
  open my $LOG, ">$log";

  my $host = "hpiers.obspm.fr";
  my $ret = 0;

  my $ftpCon;
  if($ftpCon = newFTP->new($host,t=>60,v=>2,o=>$LOG)){
    $ret = $ftpCon->login();
    if($ret == 1){
      $ftpCon->cwd("/pub/rotation/code");
      $ftpCon->ascii();
      foreach my $file (keys %cont){
        print "IERS: $cont{$file} -> $file\n";
        $ftpCon->put($cont{$file},$file);
      }
      $ftpCon->dir("*${yyyy}${ddd}*");
      $ftpCon->quit();
    }
  };
  close $LOG;
  print "RETURN IERS $ret\n";
  return $ret;
}

