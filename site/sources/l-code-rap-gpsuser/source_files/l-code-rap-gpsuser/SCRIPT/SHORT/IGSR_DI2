use strict;

# External packages
use File::Copy qw(copy);
use File::Basename;

# Local packages
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use lib_erp;
use gpsutil;
use newFTP;
use cddis_curl;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yy,$yyyy,$yym1,$yyp1,$yyp2,$ddd,$dm1,$dp1,$dp2,$yyddd,$yyssss,
    $yydp1,$yydp2,$wwwwd,$wwwwdp1,$wwwwdp2,$wwwwdm1,$wwwwdm2,$wwwwdm3,
    $v_sav,$v_dis,$savdsk,$crdinf,
    $dirOut,
    $dirTrp,$extTrp,
    $dirPre,$extPre,
    $dirErp,$extErp,
    $dirRxc,$extRxc,
    $dirTro,$extTro,
    $dirIep,$extIep,
    $dirSnx,$extSnx,
            $extOut,
    $dirStd,$extStd,
    $dirObx,$extObx,
  ) =
  $bpe->getKeys(
    '$Y','$Y+0','$Y-1','$Y+1','$Y+2','$+0','$-1','$+1','$+2','$YD+0','$YSS+0',
    '$YD+1','$YD+2','$WD+0','$WD+1','$WD+2','$WD-1','$WD-2','$WD-3',
    'V_SAV','V_DIS','V_SAVDSK','V_CRDINF',
    'DIR_OUT',
    'DIR_TRP','EXT_TRP',
    'DIR_PRE','EXT_PRE',
    'DIR_ERP','EXT_ERP',
    'DIR_RXC','EXT_RXC',
    'DIR_TRO','EXT_TRO',
    'DIR_IEP','EXT_IEP',
    'DIR_SNX','EXT_SNX',
              'EXT_OUT',
    'DIR_STD','EXT_STD',
    'DIR_OBX','EXT_OBX',
  );

# Return if V_SAVDSK == Y
# -----------------------
  if($savdsk eq "Y"){
    print "SAVDSK activated, skipped\n";
    return(1);
  }

# Set flags
# ---------
  my $midFil    = "${dirOut}../MSC/MID${yyddd}.FLG";
  my $ultFil    = "$$bpe{CAMP_PTH}$$bpe{CAMPAIGN}/MSC/ULT${yyddd}.FLG";
  my $nxtUltFil = "$$bpe{CAMP_PTH}$$bpe{CAMPAIGN}/MSC/ULT${yydp1}.FLG";

# Some variables
# --------------
  my $xa       = "$ENV{AUTO}";
  my $ftpCod   = "${PATH_AFTP}${CAMP_CODE}/";
  my $ftpCod_M = "${PATH_AFTP}${CAMP_CODE}/${yyyy}_M/";
  my $ftpCod_I = "${PATH_AFTP}${CAMP_CODE}/IERS/${yyyy}/";
  my $clkInc   = "NO";
  my $savDir = "$PATH_SAV/RCLKGNSS/$yyyy/ORB/";

  check_dir($ftpCod);
#_M  check_dir($ftpCod_M);
  check_dir($ftpCod_I);
  check_dir($savDir);
  check_dir("$ENV{T}/rob_upload");
  check_dir("$ENV{T}/bkg_upload");

#??  my $uldNam = "COD0OPSULT";
#??  my $rapNam = "COD0OPSRAP";

# Set day
# -------
  my $accDay = $ddd;
  my $accYr  = $yyyy;
  my $hour   = "99";


# Read ultra flag file
# --------------------
  my($h_end,$h_tro,$h_rnx,$h_chr) = &rdUltFlg($ultFil);
  my $T  = &gtUltVrs($h_end,$h_chr);

  my $sess_fin = "${ddd}${h_chr}";
  if(-e $ultFil) {
    ($accDay,$accYr,$hour) = $h_end < 15 ? ($ddd,$yyyy,"12")
                                         : ($dp1,$yyp1,"00");
  }

# Copy SATINFO, PCV, RECEIVER, SAT-CRX files to BSWUSER
# -----------------------------------------------------
  print "gen2bswuser: $ENV{CONFIG} ${yyyy} ${yyp1}\n";
  system("$ENV{AUTO}/gen2bswuser.com IGSR_FTP ${yyyy} ${yyp1}");
  system("$ENV{AUTO}/gen2bswuser54.com IGSR_FTP ${yyyy} ${yyp1}");

# Execute pcv2week.com to create/update week-specific PCV file set
# ----------------------------------------------------------------
  print "pcv2week.com: $ENV{AUTO}/pcv2week.com -auto -w\n";
  system("$ENV{AUTO}/pcv2week.com -auto -w");

# Prepair files to submit to archive and ftp
# ------------------------------------------
  my $isMid   = -e $midFil                 ? 1: 0;
  my $isUlt   = -e $ultFil                 ? 1: 0;
  my $isNxtUlt= -e $nxtUltFil              ? 1: 0;
  my $isUlt24 = -e $ultFil && $h_end == 24 ? 1: 0;

# Set file names
# --------------
  my $outFil_rap = "RA_$yyddd";
  my $outFil_ult = "RQ_$yyddd";
  my $dayOrb     = "${dirPre}RAC${yyddd}.${extPre}";
  my $dayErp     = "${dirErp}COD${wwwwd}.${extErp}";
  my $ultErp     = "${dirErp}U$T${wwwwd}.${extErp}";
  my $dayClk     = "${CDIR_RCLK}/../RCLKGNSS/OUT/HR_${yyddd}0.${extRxc}";
  my $dayClk52   = "${CDIR_RCLK}/../RCLKGNSS/OUT/XR_${yyddd}0.${extRxc}";
  my $dayClk3    = "${CDIR_RCLK}/../RCLKGNSS/OUT/HR_${yyyy}${ddd}0.${extRxc}";
  my $dayBia     = "${savDir}IAR${yyssss}_V01.BIA.gz";
  my $dayOsb     = "${savDir}IAR${yyssss}_V01.OSB.gz";
  my $dayTro     = "${dirTro}U$T${yyddd}.${extTro}";
  my $daySnx     = "${dirSnx}RA_${yyddd}.${extSnx}";
  my $daySnxTro  = "${dirSnx}RAT${yyddd}.${extSnx}";
  my $dayAtt     = "${dirObx}RQ_${yyddd}.${extObx}";
  if(-e $midFil){
    $outFil_rap = "MID$yyddd";
    $dayOrb     = "${dirPre}RAM${yyddd}.${extPre}";
    $dayErp     = "${dirErp}MID${wwwwd}.${extErp}";
    $dayTro     = "${dirTro}MID${yyddd}.${extTro}";
  }

  my $isClk   = -e $dayClk                 ? 1: 0;
  my $isDaySnxTro = `grep TROTOT $daySnxTro | wc -l`+0;
  if($isDaySnxTro==0){
    prtMess($bpe,"TROTOT RECORDS UNAVAILABLE IN $daySnxTro");
  }

  # Predictions
  my $dayOrb1    = "${dirPre}RP_${yydp1}.${extPre}";
  my $dayOrb2    = "${dirPre}RP2${yydp2}.${extPre}";
  my $dayOrb3    = "${dirPre}RP3${yydp1}.${extPre}";
  my $dayErp1    = "${dirIep}U$T${wwwwd}.${extIep}";

# Create ACC summary file
# -----------------------
  system("$xa/make_accsum.com $accDay $accYr $hour $dirOut $outFil_rap");
  my $ftpAcc = "${dirOut}${outFil_rap}.ACC";

# Copy SATINFO, PCV, RECEIVER, SAT-CRX files to BSWUSER
# -----------------------------------------------------
  print "gen2bswuser: $ENV{CONFIG} ${yyyy} ${yyp1}\n";
  system("$ENV{AUTO}/gen2bswuser.com IGSR_FTP ${yyyy} ${yyp1}");


# Submit ot archive files
# -----------------------
  my %ultra_fil;
  my %rapid_fil;
  my %rapid_mid_fil;
  my %prediction;
  my %ultra_24_fil;

# NamingScheme
# ------------
  my $rapName = "COD0OPSRAP";
  my $midName = "CODMOPSRAP";
  my $ultName = "COD0OPSULT";
  my $prdName = "COD0OPSPRD";

  my %uplUltNam;
  $uplUltNam{dayTro}    = "${ultName}.TRO";                               # "COD.TRO_U";
  $uplUltNam{daySnx}    = "${ultName}.${extSnx}";                         # "COD.${extSnx}_U";
  $uplUltNam{daySnxTro} = "${ultName}_TRO.${extSnx}";                     # "COD_TRO.${extSnx}_U";
  $uplUltNam{dayAtt}    = "${ultName}.OBX";
  $uplUltNam{ultErp}    = "IGSULTRA.${extErp}";
  $uplUltNam{dayErp}    = "${ultName}_${yyyy}${ddd}0000_01D_01D_ERP.ERP"; # "COD${wwwwd}.${extErp}_U";
  $uplUltNam{dayOrb}    = "${ultName}_${yyyy}${ddd}0000_01D_05M_ORB.SP3"; # "COD${wwwwd}.EPH_U";

  my %uplRapNam;
  $uplRapNam{dayTro}    = "${rapName}_${yyyy}${ddd}0000_01D_01H_TRO.TRO"; # "COD${wwwwd}.${extTro}_R";
  $uplRapNam{daySnx}    = "${rapName}_${yyyy}${ddd}0000_01D_01D_SOL.SNX"; # "COD${wwwwd}.${extSnx}_R";
  $uplRapNam{daySnxTro} = "${rapName}_${yyyy}${ddd}0000_01D_02H_TRO.SNX"; # "${ftpCod}COD${wwwwd}_TRO.${extSnx}_R";
  $uplRapNam{ultErp}    = "IGSULTRA.${extErp}";
  $uplRapNam{ultErp1}   = "ULT${wwwwd}.${extErp}";
  $uplRapNam{dayOrb}    = "${rapName}_${yyyy}${ddd}0000_01D_05M_ORB.SP3"; # "COD${wwwwd}.EPH_R";
  $uplRapNam{dayErp}    = "${rapName}_${yyyy}${ddd}0000_01D_01D_ERP.ERP"; # "COD${wwwwd}.${extErp}_R";
  $uplRapNam{dayClk}    = "${rapName}_${yyyy}${ddd}0000_01D_30S_CLK.CLK_V2"; # "COD${wwwwd}.${extRxc}_R";
  $uplRapNam{dayClk3}   = "${rapName}_${yyyy}${ddd}0000_01D_30S_CLK.CLK"; # "COD${wwwwd}.${extRxc}_R";
  $uplRapNam{dayBia}    = "${rapName}_${yyyy}${ddd}0000_01D_01D_OSB.BIA.gz"; # "COD${wwwwd}.BIA_R.Z";
  $uplRapNam{dayAtt}    = "${rapName}_${yyyy}${ddd}0000_01D_30S_ATT.OBX";

  my %uplRapMidNam;
  $uplRapMidNam{dayOrb}    = "${midName}_${yyyy}${ddd}0000_01D_05M_ORB.SP3";    # "COD${wwwwd}.EPH_M";
  $uplRapMidNam{dayErp}    = "${midName}_${yyyy}${ddd}0000_01D_01D_ERP.ERP";    # "COD${wwwwd}.${extErp}_M";
  $uplRapMidNam{dayClk}    = "${midName}_${yyyy}${ddd}0000_01D_30S_CLK.CLK_V2"; # "COD${wwwwd}.${extRxc}_M";
  $uplRapMidNam{dayClk3}   = "${midName}_${yyyy}${ddd}0000_01D_30S_CLK.CLK";    # "COD${wwwwd}.${extRxc}_M";
  $uplRapMidNam{dayBia}    = "${midName}_${yyyy}${ddd}0000_01D_01D_OSB.BIA.gz";  # "COD${wwwwd}.BIA_M.Z";


  my %uplPrdNam;
  $uplPrdNam{dayOrb1} = "obsolete";                                         ; # "COD${wwwwdp1}.EPH_P";
  $uplPrdNam{dayOrb2} = "obsolete";                                         ; # "COD${wwwwdp2}.EPH_P2";
  $uplPrdNam{dayOrb3} = "${prdName}_${yyyy}${ddd}0000_05D_05M_ORB.SP3"      ; # "COD${wwwwdp1}.EPH_5D";
  $uplPrdNam{dayErp1} = "obsolete";                                         ; # "COD${wwwwdp1}.ERP_P";
  $uplPrdNam{dayErp2} = "obsolete";                                         ; # "COD${wwwwdp2}.ERP_P2";
  $uplPrdNam{dayErp3} = "${prdName}_${yyyy}${ddd}0000_21D_06H_ERP.ERP"      ; # "COD${wwwwdp1}.ERP_5D";
  $uplPrdNam{dayOrb3_nU} = "${prdName}_05D.SP3";
  $uplPrdNam{dayErp3_nU} = "${prdName}_21D.ERP";

# Upload ULTRA
# ------------
  if($isUlt){
    $ultra_fil{$dayTro}{"${ftpCod}$uplUltNam{dayTro}"} = " ";
    $ultra_fil{$daySnx}{"${ftpCod}$uplUltNam{daySnx}"} = "c";
    if($isDaySnxTro){
      $ultra_fil{$daySnxTro}{"${ftpCod}$uplUltNam{daySnxTro}"} = "c";
    };
  }else{
    $rapid_fil{$dayTro}{"${ftpCod}$uplRapNam{dayTro}"} = " ";
    $rapid_fil{$daySnx}{"${ftpCod}$uplRapNam{daySnx}"} = "c";
    $rapid_fil{$daySnx}{"${ftpCod_I}$uplRapNam{daySnx}"} = "c";
    $rapid_fil{$dayAtt}{"${ftpCod}$uplRapNam{dayAtt}"} = "c";
    if($isDaySnxTro){
      $rapid_fil{$daySnxTro}{"${ftpCod}$uplRapNam{daySnxTro}"} = "c";
      $rapid_fil{$daySnxTro}{"${ftpCod_I}$uplRapNam{daySnxTro}"} = "c";
    }
    if(! $isNxtUlt){
        $ultra_fil{$dayTro}{"${ftpCod}$uplUltNam{daySnxTro}"};
    }
  }

# Upload ULTRA as RAPID
  if($isUlt24){
    $ultra_24_fil{$dayOrb}{"${ftpCod}$uplUltNam{dayOrb}"} = " ";
    $ultra_24_fil{$dayErp}{"${ftpCod}$uplUltNam{dayErp}"} = " ";
  }

# Upload RAPID
  $rapid_fil{$ultErp}{"${dirErp}$uplRapNam{ultErp}"}  = " ";
  $rapid_fil{$ultErp}{"${dirErp}$uplRapNam{ultErp1}"} = " ";
  if(! $isUlt){
    $rapid_fil{$dayOrb}{"${ftpCod}$uplRapNam{dayOrb}"} = " ";
    $rapid_fil{$dayErp}{"${ftpCod}$uplRapNam{dayErp}"} = " ";
  }

  if($isClk == 1){
    $rapid_fil{$dayClk}{"${ftpCod}$uplRapNam{dayClk}"}   = " ";
    $rapid_fil{$dayClk3}{"${ftpCod}$uplRapNam{dayClk3}"} = " ";
    $rapid_fil{$dayBia}{"${ftpCod}$uplRapNam{dayBia}"}   = " ";
  }

# Upload RAPID_M
# --------------
  print "MY MID: $isMid\n";
  if($isMid == 1){
    $rapid_mid_fil{$dayOrb}{"${ftpCod}$uplRapMidNam{dayOrb}"}   = " ";
    $rapid_mid_fil{$dayOrb}{"${savDir}TP_${yyssss}.${extPre}"}  = "z";

    $rapid_mid_fil{$dayErp}{"${ftpCod}$uplRapMidNam{dayErp}"}   = " ";
    $rapid_mid_fil{$dayErp}{"${savDir}TP_${yyssss}.${extIep}"}  = "z";

    $rapid_mid_fil{$dayClk}{"${ftpCod}$uplRapMidNam{dayClk}"}   = " ";
    $rapid_mid_fil{$dayClk3}{"${ftpCod}$uplRapMidNam{dayClk3}"} = " ";

#_M    $rapid_mid_fil{$dayBia}{"${ftpCod_M}COD${wwwwd}.BIA_M.Z"}     = " ";
    $rapid_mid_fil{$dayBia}{"${ftpCod}$uplRapMidNam{dayBia}"}   = " ";
#_M    my $ftpBia = "${ftpCod_M}$uplRapMidNam{dayBia}";
#_M    $rapid_mid_fil{$dayBia}{$ftpBia}                             = " " if -e $ftpBia;
#_M    $rapid_mid_fil{$dayBia}{"${ftpCod_M}$uplRapMidNam{dayBia}"}  = " " unless -e $ftpBia;
#_M    $rapid_mid_fil{$dayBia}{"${ftpCod}$uplRapMidNam{dayBia}"}    = " " unless -e $ftpBia;
  }

# Upload predictions
# ------------------
  # $prediction{$dayOrb1}{"${ftpCod}$uplPrdNam{dayOrb1}"} = " ";
  # $prediction{$dayOrb2}{"${ftpCod}$uplPrdNam{dayOrb2}"} = " ";
  $prediction{$dayOrb3}{"${ftpCod}$uplPrdNam{dayOrb3}"} = " ";
  # $prediction{$dayErp1}{"${ftpCod}$uplPrdNam{dayErp1}"} = " ";
  # $prediction{$dayErp1}{"${ftpCod}$uplPrdNam{dayErp2}"} = " ";
  $prediction{$dayErp1}{"${ftpCod}$uplPrdNam{dayErp3}"} = " ";
  if(! $isUlt){
    $prediction{$dayOrb3}{"${ftpCod}$uplPrdNam{dayOrb3_nU}"} = " ";
    $prediction{$dayErp1}{"${ftpCod}$uplPrdNam{dayErp3_nU}"} = " ";
  }


# Upload to archive
# -----------------
  sendToArchive(\%ultra_fil);
  sendToArchive(\%ultra_24_fil);
  sendToArchive(\%rapid_fil);
  sendToArchive(\%rapid_mid_fil);
  sendToArchive(\%prediction);

##  uncompress glob("${ftpCod}COD${wwwwd}.BIA_?.Z");
##  map { system("uncompress -f $_") } (glob("${ftpCod}COD${wwwwd}.BIA_?.Z"));
  map { system("gunzip -f $_") } (glob("${ftpCod}COD?OPSRAP_${yyyy}${ddd}0000_01D_01D_OSB.BIA.gz"));

# Upload BSW52
# ------------
  if($isUlt){
    # Convert ERP file
    my $src52 = "${dirErp}U$T${wwwwd}.${extErp}_V52";
    erp2bsw52($ultErp,$src52);
    my $trg52 = "$CAMP_BSW52/ORB/COU.${extErp}";
    print "copyaftp: $src52 -> $trg52\n";
    copyaftp($src52,$trg52);
    unlink $src52;
  }elsif(! $isNxtUlt){
    my $src   = "${dirErp}U$T${wwwwd}.${extErp}";
    my $src52 = "${dirErp}U$T${wwwwd}.${extErp}_V52";
    erp2bsw52($src,$src52);
    my $trg52 = "$CAMP_BSW52/ORB/COU.${extErp}";
    print "copyaftp: $src52 -> $trg52\n";
    copyaftp($src52,$trg52);
  }

# Return if v_dis not activated
# -----------------------------
  if($v_dis ne "Y" || -e "$ENV{HOME}/../l_code/MSC/NO_DIS.FLG") {
    prtMess($bpe,"FILES_NOT_DISTRIBUTED");
    return;
  }

# Submit to external repositories
# -------------------------------

# File selection
# --------------
  my %disIGS;
  my %disIEP;
