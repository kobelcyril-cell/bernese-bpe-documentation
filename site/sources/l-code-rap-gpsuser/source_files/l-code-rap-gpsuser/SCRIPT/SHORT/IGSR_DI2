sub sendToArchive{
  my %cont = %{(shift)};
  foreach my $src (keys %cont){
    foreach my $trg (keys %{$cont{$src}}){
      print "TOARCH: $src -> $trg with $cont{$src}{$trg} cont\n";
      if($cont{$src}{$trg} eq "z"){
        &copy2archive($src,$trg,"z");
      }else{
        &copy2archive($src,$trg);
      }
    }
  };
  return;
}

sub sendToArchiveDry{
  my %cont = %{(shift)};
  my $DRY = shift;
  foreach my $src (keys %cont){
    foreach my $trg (keys %{$cont{$src}}){
      print $DRY "TOARCH: $src -> $trg with $cont{$src}{$trg} cont\n";
    }
  };
  return;
}

