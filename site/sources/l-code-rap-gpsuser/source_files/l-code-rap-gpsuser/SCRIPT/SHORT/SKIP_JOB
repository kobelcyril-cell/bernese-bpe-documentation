package SKIP_JOB;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  SKIP_JOB
#
# Purpose :  Skip jobs if "SKIP_JOB.FLG" exists
#            (used for script: skip_jobs.com)
#
# Programs:
#
# Author  :  M. Meindl
# Created :  30-Jul-2003               Last modified: __-___-____
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Define variables
# ----------------
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};
  my $PARAM2   = $$bpe{PARAM2};
  my $PARAM3   = $$bpe{PARAM3};

  my $flgFil = "$CAMP_PTH${CAMPAIGN}/MSC/SKIP_JOB.FLG";


# Decide where to continue
# ------------------------
  -e $flgFil ? prtGoto($bpe,$PARAM2) : prtGoto($bpe,$PARAM3);

}
