package PHABIA;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  PHABIA
#
# Purpose :  Execute PHABIA
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  26-Jul-2017
#
# Changes :  19-Sep-2017 AV: Modified OSB generation(replace L.X)
#            22-May-2018 SS: Translation of PARAMs
#            20-Jun-2018 SS: Added ECJ
#            24-Sep-2018 SS: Corrected WL_/WLB OSB in case of WLB
#            26-Sep-2023 SS: Added E:L5I
#            28-Sep-2023 SS: Commented E:L5I
#            30-Apr-2024 SS: Considered C:L6X
#            02-May-2024 SS: Inserted comprehensive list of GNSS observables
#            03-May-2024 SS: Added G:L1L, G:L1X, R:L3Q, R:L3X
#            11-Mar-2026 SS: Reviewed OBS table: +R:L4X, +R:L6X
#                                                +E:L6B, -E:L8I
#                                                -C:L5D
#                                                +J:L1E, -J:L1Z, +J:L5P
#                                                +S:L1C, +S_L5I
#
# ============================================================================

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my   ($yyssss,
        $inposb,$outosb,$camp,
        $extOsb,$dirOsb) =
 $bpe->getKeys(
      '$YSS+0',
      'PARAM1','PARAM2','CAMPAIGN',
      'EXT_OSB','DIR_OSB'
      );

  $inposb = $$bpe{"V_$inposb"} if length($inposb) == 1;
  $outosb = $$bpe{"V_$outosb"} if length($outosb) == 1;

# Change executable for FCLK_REP
# ------------------------------
  if ($camp eq "FCLK_REP") {
    $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/gpfs/homefs/aiub/villiger/PHABIA_PRO/EXE_G95/");
    print "Change executable path to /gpfs/homefs/aiub/villiger/PHABIA_PRO/EXE_G95/\n";
  }

# Run program
# -----------
  my $PGMNAM = "PHABIA";
  $bpe->RUN_PGMS($PGMNAM);

# Create combined OSB file
# ------------------------
  print "inposb $inposb outosb $outosb\n";
  if($inposb ne '' && $outosb ne ''){
      my $iOsbFil = "${dirOsb}/${inposb}${yyssss}.${extOsb}";
      my $oOsbFil = "${dirOsb}/${outosb}${yyssss}.${extOsb}";
      my $estOsb  = "";
      $estOsb  = "${dirOsb}/WL_${yyssss}.${extOsb}" if($outosb=~/WLB/);
      $estOsb  = "${dirOsb}/NL_${yyssss}.${extOsb}" if($outosb=~/NLB/);

##      if ($outosb=~/WLB/ && ($camp eq "FCLKGNSS" || $camp eq "FCLK_REP")) {
##        system("perl $ENV{AUTO}/cor_phabia.com $estOsb $iOsbFil $estOsb");
##        print "Executed $ENV{AUTO}/cor_phabia.com $estOsb $iOsbFil $estOsb\n";
##      } else {
##        print "Ignored $ENV{AUTO}/cor_phabia.com\n";
##      }

      my %osb;
# G: C1C/L1C C1L/L1L C1W/L1W C1X/L1X C2L/L2L C2S/L2S C2W/L2W C2X/L2X C5Q/L5Q C5X/L5X
      $osb{G}{L1X}{L1C} = 1;
      $osb{G}{L1X}{L1L} = 1;
      $osb{G}{L1X}{L1W} = 1;
      $osb{G}{L1X}{L1X} = 1;
      $osb{G}{L2X}{L2C} = 1;
      $osb{G}{L2X}{L2L} = 1;
      $osb{G}{L2X}{L2S} = 1;
      $osb{G}{L2X}{L2W} = 1;
      $osb{G}{L2X}{L2X} = 1;
      $osb{G}{L5X}{L5Q} = 1;
      $osb{G}{L5X}{L5X} = 1;
# R: C1C/L1C C1P/L1P C2C/L2C C2P/L2P C3Q/L3Q C3X/L3X C4X/L4X C6X/L6X
      $osb{R}{L1X}{L1C} = 1;
      $osb{R}{L1X}{L1P} = 1;
      $osb{R}{L2X}{L2C} = 1;
      $osb{R}{L2X}{L2P} = 1;
      $osb{R}{L3X}{L3Q} = 1;
      $osb{R}{L3X}{L3X} = 1;
      $osb{R}{L4X}{L4X} = 1;
      $osb{R}{L6X}{L6X} = 1;
# E: C1C/L1C C1X/L1X C5Q/L5Q C5X/L5X C6B/L6B C6C/L6C C6X/L6X C7Q/L7Q C7X/L7X C8Q/L8Q C8X/L8X
      $osb{E}{L1X}{L1C} = 1;
      $osb{E}{L1X}{L1X} = 1;
      $osb{E}{L5X}{L5Q} = 1;
      $osb{E}{L5X}{L5X} = 1;
      $osb{E}{L6X}{L6B} = 1;
      $osb{E}{L6X}{L6C} = 1;
      $osb{E}{L6X}{L6X} = 1;
      $osb{E}{L7X}{L7Q} = 1;
      $osb{E}{L7X}{L7X} = 1;
      $osb{E}{L8X}{L8Q} = 1;
      $osb{E}{L8X}{L8X} = 1;
# C: C1D/L1D C1P/L1P C1X/L1X C2I/L2I C2X/L2X C5P/L5P C5X/L5X C6I/L6I C6X/L6X C7D/L7D C7I/L7I C7X/L7X C7Z/L7Z C8X/L8X
      $osb{C}{L1X}{L1D} = 1;
      $osb{C}{L1X}{L1P} = 1;
      $osb{C}{L1X}{L1X} = 1;
      $osb{C}{L2X}{L2I} = 1;
      $osb{C}{L2X}{L2X} = 1;
      $osb{C}{L5X}{L5P} = 1;
      $osb{C}{L5X}{L5X} = 1;
      $osb{C}{L6X}{L6I} = 1;
      $osb{C}{L6X}{L6X} = 1;
      $osb{C}{L7X}{L7D} = 1;
      $osb{C}{L7X}{L7I} = 1;
      $osb{C}{L7X}{L7X} = 1;
      $osb{C}{L7X}{L7Z} = 1;
      $osb{C}{L8X}{L8X} = 1;
# J: C1C/L1C C1E/L1E C1L/L1L C1X/L1X C1Z/L1Z C2L/L2L C2S/L2S C2X/L2X C5P/L5P C5Q/L5Q C5X/L5X C6L/L6L C6S
      $osb{J}{L1X}{L1C} = 1;
      $osb{J}{L1X}{L1E} = 1;
      $osb{J}{L1X}{L1L} = 1;
      $osb{J}{L1X}{L1X} = 1;
      $osb{J}{L2X}{L2L} = 1;
      $osb{J}{L2X}{L2S} = 1;
      $osb{J}{L2X}{L2X} = 1;
      $osb{J}{L5X}{L5P} = 1;
      $osb{J}{L5X}{L5Q} = 1;
      $osb{J}{L5X}{L5X} = 1;
# S: C1C/L1C C5I/L5I
      $osb{S}{L1X}{L1C} = 1;
      $osb{S}{L5X}{L5I} = 1;

      open OUT, "> $oOsbFil";
      open INP, "< $iOsbFil";
      map {print OUT $_} (<INP>);
      close INP;
      open INP, "< $estOsb";
      foreach (<INP>){
        if(/OSB  (\w)\d\d\d .* (L\d\w) /){
          my $otyp = $2;
          chomp;
          foreach my $obstyp (sort keys %{$osb{$1}{$otyp}}){
            my $line = $_;
            $line =~ s/$otyp/$obstyp/;
            print OUT "$line\n";
          }
        }
      }
      map {print OUT $_ if / L\d\w /} (<INP>);
      close INP;
      close OUT;
  }
}
