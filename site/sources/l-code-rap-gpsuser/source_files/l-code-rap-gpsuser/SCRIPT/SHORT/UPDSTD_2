package UPDSTD_2;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  UPDSTD_2
#
# Purpose :  Update standard orbits and find repositioning time
#
# Programs:  ORBGEN, STDDIF
#
# Author  :  S. Schaer
# Created :  20-Jan-2004               Last modified: __-___-____
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------


sub run {
  my $bpe = shift;

  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};

  my ($outDir) = $bpe->getKeys("DIR_OUT");

  my $manFil = "$CAMP_PTH$CAMPAIGN/MSC/REPOSITIONING.FLG";


# Run programs
# ------------
  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);


  if (-e $manFil) {

    $PGMNAM = "STDDIF";
    $bpe->RUN_PGMS($PGMNAM);

    $SYSOUT = $$bpe{SYSOUT};
    system("grep Maneuver $SYSOUT >> ${outDir}REPOSITIONING.LST");

  }

}
