package SKIP_WL;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  SKIP_WL
#
# Purpose :  Skip WL AR if indicated
#
# Programs:  SATMRK
#
# PARAMs  :  PARAM2 - goto PID to continue with NL AR
#
# Author  :  S. Schaer
# Created :  22-May-2018
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# Define variables
# ----------------
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};
  my $PARAM2   = $$bpe{PARAM2};
  my $PARAM3   = $$bpe{PARAM3};

# Get variables
# -------------
  my ($yyssss) = $bpe->getKeys('$YSS+0');

  my $iarFlg = "$CAMP_PTH$CAMPAIGN/MSC/IAR${yyssss}.FLG";

# Decide whether WL AR shall be skipped
# -------------------------------------
  if (-e $iarFlg && $CAMPAIGN ne "PPPFIN") {
    my $PGMNAM = "SATMRK";
    $bpe->RUN_PGMS($PGMNAM);
    prtMess($bpe,"NL INTEGERS INITIALIZED");
    prtMess($bpe,"WL AR SKIPPED");
    prtGoto($bpe,$PARAM2);
  } else {
    prtMess($bpe,"WL AR NOT SKIPPED");
  }

}
