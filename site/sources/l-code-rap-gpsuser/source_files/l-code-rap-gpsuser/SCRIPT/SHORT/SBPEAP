package SBPEAP;
@ISA = ("RUNBPE");

sub run
{
  my $bpe = shift;

# Get variable values
# -------------------
  my $T       = $$bpe{T};
  my $PARAM1  = $$bpe{PARAM1};
  my $SBPEOPT = $$bpe{SBPE_OPTIONS};

# Define the temp. file name
# --------------------------
  my $tmpFil = "$T/AUTO_TMP/$PARAM1";

# Write SuperBPE options into the temp. file
# ------------------------------------------
  open (INP, "> $tmpFil");
  print INP $SBPEOPT."\n";
  close INP;

}
