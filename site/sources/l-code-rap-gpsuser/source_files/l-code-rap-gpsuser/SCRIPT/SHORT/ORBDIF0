package ORBDIF;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ORBDIF
#
# Purpose :  Execute ORBGEN and STDDIF for determination of time and velocity
#            change of satellite repositionings.
#
# Programs:  ORBGEN, STDDIF
#
# Author  :  S. Schaer
#
# Created :  15-Dec-2003
#
# Changes :  29-Dec-2003/ss: Perform second STDDIF run for 2-day interval
#            06-Jan-2004/ss: Perform STDDIF run wrt "+50" satellites
#            13-Jan-2004/ss: Consider REPOSITIONING.FLG
#            19-Jan-2004/ss: Remove REPOSITIONING.FLG in RAPID mode
#            30-Jul-2004/ss: Create automatically RAP APR PRE file for GPS
#                            repositionings
#            09-Dec-2004/ss: Handle case with two repositionings
#            10-Feb-2005/mm: Old date variables removed
#            24-Oct-2006/ss: Changed call of merge_pre.com
#            30-Jul-2008/ss: ORBDIF.FLG no longer considered
#            20-Jun-2023/ss: merge_pre.com reactivated in -auto mode
#            21-Jun-2023/ss: ORBDIF0/ORBDIF synchronized with each other
#            03-Jul-2023/ss: Introduced $iniflg
#            07-Jul-2023/ss: Try merge_pre.com not only for m1 day but also
#                            for current day
#            13-Jul-2023/ss: No attempt for current day if REPOSITIONING.FLG
#            12-Jan-2024/ss: Do not release an SMS message if unnecessary
#
# ----------------------------------------------------------------------------
use warnings;

use lib $ENV{AUTO};
use gpsutil;
use lib $ENV{BPE};
use bpe_util;
use lib $ENV{EXE};
use Gps_Date;
use File::Copy;

sub run {
  my $bpe = shift;

# Define variables
# ----------------
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};
  my $V_E      = $$bpe{V_E};

  my ($yyddd,$yydddm1,$preDir,$erpDir,$outDir) = $bpe->getKeys(
      '$YD+0','$YD-1','DIR_PRE','DIR_ERP','DIR_OUT');

# Run programs
# ------------
  my $ultfil = "$CAMP_PTH$CAMPAIGN/MSC/ULT${yyddd}.FLG";
  my $manfil = "$CAMP_PTH$CAMPAIGN/MSC/REPOSITIONING.FLG";
##  my $runfil = "$CAMP_PTH$CAMPAIGN/MSC/ORBDIF.FLG";
##  if (!-s $ultfil || -s $manfil || -s $runfil) {
##  if (-s $runfil) {

    copy("${preDir}${V_E}_${yyddd}.PRE",
         "${preDir}ORBDIF.PRE");

    copy("${erpDir}RAP${yyddd}.ERP",
         "${erpDir}ORBDIF.ERP");

    my $PGMNAM = "ORBGEN";
    $bpe->RUN_PGMS($PGMNAM);

    $PGMNAM = "STDPRE";
    $bpe->RUN_PGMS($PGMNAM);

    $PGMNAM = "STDDIF";
    $bpe->RUN_PGMS($PGMNAM);

    my $SYSOUT = $$bpe{SYSOUT};
    system("grep Maneuver $SYSOUT >> ${outDir}REPOSITIONING.LST");

    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDORB",'PM_$YD-1');
    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","ENDDAT",'$YMD_STR+0');

    $PGMNAM = "STDDIF";
    $bpe->RUN_PGMS($PGMNAM);

    $SYSOUT = $$bpe{SYSOUT};
    system("grep Maneuver $SYSOUT >> ${outDir}REPOSITIONING.LST");

    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDORB",'$E_$YD-1');
    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDOR1",'PM_$YD+0');
    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STADAT",'$YMD_STR-1');
    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","ENDDAT",'$YMD_STR-1');

    $PGMNAM = "STDDIF";
    $bpe->RUN_PGMS($PGMNAM);

    $SYSOUT = $$bpe{SYSOUT};
    system("grep Maneuver $SYSOUT >> ${outDir}REPOSITIONING.LST");

    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDORB",'$E_$YD+0');
    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDOR1",'$E_$YD+0');
    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STADAT",'$YMD_STR+0');
    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","ENDDAT",'$YMD_STR+0');

    $PGMNAM = "STDDIF";
    $bpe->RUN_PGMS($PGMNAM);

    $SYSOUT = $$bpe{SYSOUT};
    system("grep Maneuver $SYSOUT >> ${outDir}REPOSITIONING.LST");

    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDORB",'$E_$YD-1');
    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDOR1",'$E_$YD-1');
    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STADAT",'$YMD_STR-1');
    $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","ENDDAT",'$YMD_STR-1');

    $PGMNAM = "STDDIF";
    $bpe->RUN_PGMS($PGMNAM);

    $SYSOUT = $$bpe{SYSOUT};
    system("grep Maneuver $SYSOUT >> ${outDir}REPOSITIONING.LST");

# Create automatically RAP APR PRE file for GPS repositionings
# ------------------------------------------------------------
# Try it for m1 day:
    my $dddm1 = substr($yydddm1,2,3);
    my $inifil = "${preDir}INI${yydddm1}.PRE";
    my $aprfil = "${preDir}APR${yydddm1}.PRE";
    my $iniflg = -e $inifil;
##    unlink($inifil);
    system("$ENV{AUTO}/merge_pre.com $preDir RH_${yydddm1}.PRE PM_${yydddm1}.PRE INI${yydddm1}.PRE -auto $dddm1");
    system("$ENV{AUTO}/merge_pre.com $preDir RQ_${yydddm1}.PRE PM_${yydddm1}.PRE INI${yydddm1}.PRE -auto $dddm1");
    system("$ENV{AUTO}/merge_pre.com $preDir RA_${yydddm1}.PRE PM_${yydddm1}.PRE INI${yydddm1}.PRE -auto $dddm1");
    if (-e $inifil) {
      my ($ymdstrm1,$yyyym1) = gps_date("-yd $yydddm1 -o %X %Y");
      $ymdstrm1 =~ s/-/ /g;
      my $numrepm1 = `grep '   [ 1-9][0-9]         0         0       ' $ENV{CONFIG}/SAT_${yyyym1}.CRX | grep '$ymdstrm1' | wc -l`+0;
      if (-e $aprfil) {
        msg2key("BPE","ORBDIF0: $CAMPAIGN/ORB/INI${yydddm1}.PRE automatically prepared (is to be copied to APR${yydddm1}.PRE if desired)") if !$iniflg && $numrepm1==0;
      } else {
        msg2key("BPE","ORBDIF0: $CAMPAIGN/ORB/APR${yydddm1}.PRE automatically created");
        copy($inifil,$aprfil);
      }
    }

# Try it for current day:
    my $ddd = substr($yyddd,2,3);
    $inifil = "${preDir}INI${yyddd}.PRE";
    $aprfil = "${preDir}APR${yyddd}.PRE";
    $iniflg = -e $inifil;
##    unlink($inifil);
    system("$ENV{AUTO}/merge_pre.com $preDir RP2${yyddd}.PRE RH_${yyddd}.PRE INI${yyddd}.PRE -auto $ddd") if !-e $manfil;
    if (-e $inifil) {
      my ($ymdstr,$yyyy) = gps_date("-yd $yyddd -o %X %Y");
      $ymdstr =~ s/-/ /g;
      my $numrep = `grep '   [ 1-9][0-9]         0         0       ' $ENV{CONFIG}/SAT_${yyyy}.CRX | grep '$ymdstr' | wc -l`+0;
      if (-e $aprfil) {
        msg2key("BPE","ORBDIF0: $CAMPAIGN/ORB/INI${yyddd}.PRE automatically prepared (is to be copied to APR${yyddd}.PRE if desired)") if !$iniflg && $numrep==0;
      } else {
        msg2key("BPE","ORBDIF0: $CAMPAIGN/ORB/APR${yyddd}.PRE automatically created");
        copy($inifil,$aprfil);
      }
    }

##  }

##  if (!-s $ultfil) { unlink($manfil) }
##  unlink($runfil);

}

