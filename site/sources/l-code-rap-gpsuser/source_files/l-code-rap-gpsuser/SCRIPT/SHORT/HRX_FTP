use strict;
use warnings;

# Lcoal packages
use lib "$ENV{BPE}";
use bpe_util qw(prtMess);

sub run {
  my $bpe = shift;

  # Get variables
# -------------
  my ($campaign) = $bpe->getKeys('CAMPAIGN');

# Skip download if not IGSRAPID campaing is used
# ----------------------------------------------
  return unless $campaign =~ /IGSRAPID/;

# Run script
# ----------
  &prtMess($bpe,"DOWNLOAD OF HOURLY OBSERVATION DATA STARTED");
#  system("$ENV{AUTO}/get_nrtdata.com -wait -nostat -f");
  system("$ENV{AUTO}/get_obsdata.com -1 -t=hourly -m=IGS -fast -min=5 -nt=8 -nostat");
}

# =============================================================================

__END__
