package ION_LSTR;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  ION_LSTR
#
# Purpose :  Create LIS/SEL file of complete ION file time series
#            (for REPRO_ION series)
#
# PARAMs  :  PARAM1 - Optional minus parameter
#
# Author  :  S. Schaer
# Created :  21-Dec-2011
#
# Changes :  22-Dec-2011/ss: Stop if no ION file found
#            23-Dec-2011/ss: Make use of setMinusPlus
#            22-Jun-2017/ss: Derived from ION_LST
#            25-Jul-2017/ss: Change $mjd_first if indicated (for antlia)
#            20-May-2021 SS: Removed extra entries for REPRO_ION Z3/Z1 ION
#            08-Mar-2022 AV: Save disk: yearly subdirectory
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;
use File::Compare qw(compare);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $mjd_last, $b, $dirIon, $dirOut, $param1) =
    $bpe->getKeys('$YSS+0', '$JD+0', 'V_B', 'DIR_ION', 'DIR_OUT', 'PARAM1');

# Set input data range
# --------------------
  setMinusPlus($bpe,$param1,0) if $param1 ne "";

# Create LIS/SEL file of complete ION file time series
# ----------------------------------------------------
  my $ionLst = "${dirOut}IONR.LST";
  my $ionSel = "${dirOut}IONR.SEL";
  open(IONLST,"> $ionLst");
  open(IONSEL,"> $ionSel");

  my @ionFil;
  my @ionLst;
  my $numLst = 0;

  my $mjd_first = gps_date("-doy 001 1994 -o %IJ");
  $mjd_first = gps_date("-doy 001 1995 -o %IJ") unless -s "$PATH_SAV/REPRO_ION/1994/ATM/Z3_94001.ION";
##  my $mjd_first = gps_date("-doy 001 2000 -o %IJ");
  for ($mjd=$mjd_first;$mjd<=$mjd_last;$mjd++) {
    ($yyyy,$yyddd) = gps_date("-mjd $mjd -o %Y %y%j");

    @ionFil = ("$PATH_SAV/REPRO_ION/$yyyy/ATM/Z3_${yyddd}.ION",
               "$PATH_SAV/REPRO_ION/$yyyy/ATM/Z1_${yyddd}.ION",
               "$PATH_SAV$CAMP_SAVIGS/$yyyy/ATM/Z3_${yyddd}.ION",
               "$PATH_SAV$CAMP_SAVIGS/$yyyy/ATM/Z1_${yyddd}.ION",
               "$PATH_SAV$CAMP_SAVIGS/$yyyy/ATM/G1_${yyddd}.ION",
               "$PATH_SAV$CAMP_SAVRAP/${yyyy}/ATM/RM_${yyddd}.ION",
               "$PATH_SAV$CAMP_SAVRAP/${yyyy}/ATM/RA_${yyddd}.ION",
               "$PATH_SAV$CAMP_SAVRAP/${yyyy}/ATM/RZ_${yyddd}.ION",
               );

    my $ok = 0;
    foreach $fil (@ionFil) {
      if (-s $fil) {
         print "$fil\n";
         print IONLST "$fil\n";
         print IONSEL basename($fil)."\n";
         if ($param1 ne "") { push(@ionLst,$fil) if $mjd-$mjd_last>=$param1 }
         else               { push(@ionLst,$fil) }
         $numLst++;
         $ok++;
         last;
      }
    }
    die "No ION file $yyddd found\n" if $ok==0;
  }

  close(IONLST);
  close(IONSEL);

  prtMess($bpe,"ION.LST CONSISTING OF $numLst FILES CREATED");
  prtMess($bpe,"ION.SEL CONSISTING OF $numLst FILES CREATED");

# Copy ION files if indicated
# ---------------------------
  my $ionFil;
  foreach $fil (@ionLst) {
##    $ionFil = "${dirIon}${b}".substr(basename($fil),3,);
    $ionFil = "${dirIon}_${b}".substr(basename($fil),3,);
    if (compare($fil,$ionFil)) {
      copy($fil,$ionFil);
      print "$fil copied to $ionFil\n";
      prtMess($bpe,basename($ionFil)." UPDATED");
    } else {
      print "$ionFil up-to-date\n";
    }
  }

}
