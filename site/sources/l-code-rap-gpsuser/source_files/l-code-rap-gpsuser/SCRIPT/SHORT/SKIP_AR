package SKIP_AR;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  SKIP_AR
#
# Purpose :  Skip QIF AR (LIMEST, GPSQIFAP, GPSQIF_P) if max. baseline length
#            (V_BL_QIF) is 0 or if SKIP_AR flag exists
#
# Programs:
#
# Author  :  M. Meindl
# Created :  30-Jul-2003               Last modified: __-___-____
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Define variables
# ----------------
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};
  my $V_BL_QIF = $$bpe{V_BL_QIF};
  my $PARAM2   = $$bpe{PARAM2};
  my $PARAM3   = $$bpe{PARAM3};

  my $flgFil = "$CAMP_PTH${CAMPAIGN}/MSC/SKIP_QIF.FLG";


# Decide where to continue
# ------------------------
  -e $flgFil || !$V_BL_QIF ? prtGoto($bpe,$PARAM2) : prtGoto($bpe,$PARAM3);

}
