package RAP_BIA;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  RAP_BIA
#
# Purpose :  Perform clock-iono bias combination runs using ADDNEQ2
#
# Programs:  ADDNEQ2
#
# Remarks :  This script must be executed in RCLKGNSS process/campaign.
#
# Author  :  S. Schaer
# Created :  14-Sep-2016
#
# Changes :  15-Sep-2016 SS: Save results
#            07-Feb-2018 SS: Use V_SAV (not V_DIS) for copyaftp
#            30-Jul-2019 SS: Changed key from NEW to BPE
#            30-Jul-2020 ST: Add use igs_device.
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use File::Copy;
use File::Basename;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yyssss, $yyssssm1, $yyyy,
      $pcfFil, $upd, $sav, $dis,
      $dirOut, $extOut, $dirNeq, $extNeq, $dirOsb, $extOsb, $dirBia, $extBia) =
    $bpe->getKeys('$YD+0', '$YSS+0', '$YSS-1', '$Y+0',
                  'PCFFIL', 'V_UPD', 'V_SAV', 'V_DIS',
                  'DIR_OUT', 'EXT_OUT', 'DIR_NEQ', 'EXT_NEQ', 'DIR_OSB', 'EXT_OSB', 'DIR_BIA', 'EXT_BIA');

# Set variables
# -------------
  $pcfFil = (split('\.',$pcfFil))[0];

  my $aprFil = "${dirOsb}APR${yyddd}.${extOsb}";
##  if ($pcfFil eq "????????") {
##    $aprFil = "${dirOsb}APR${yyssss}.${extOsb}";
##  }
##  unless (-s $aprFil) {
##    prtMess($bpe,"$aprFil to be updated not found");
##    die          "$aprFil to be updated not found";
##  }

##  my $flgFil = "${dirOut}../MSC/BIA${yyddd}.FLG";
  my $flgFil = "${dirOut}../MSC/BIA${yyssss}.FLG";
  unlink($flgFil);

# Define list of clock bias NEQ files
# -----------------------------------
  my @lst1 = (
              "${dirNeq}CB_${yyssss}.${extNeq}",
              "${dirNeq}CBG${yyssss}.${extNeq}",
              "${dirNeq}CBR${yyssss}.${extNeq}",
              );

  my ($inp,$out);

  foreach $inp (@lst1) {
    unless (-s $inp) {
      prtMess($bpe,"$inp not found");
      die          "$inp not found";
    }
  }

# Define list of iono bias NEQ files
# ----------------------------------
  my @lst2 = (
              "${PATH_RAP}${CAMP_RAP}/SOL/RZB${yyddd}.${extNeq}",
              "${PATH_RAP}${CAMP_RAP}/SOL/RZG${yyddd}.${extNeq}",
              "${PATH_RAP}${CAMP_RAP}/SOL/RZR${yyddd}.${extNeq}",
              );

  my $ok = 0;
  foreach $inp (@lst2) {
    if (-s $inp) {
      prtMess($bpe,"$inp found");
      $ok++;
    } else {
      prtMess($bpe,"$inp not found");
    }
  }

  if ($ok == 3) {
    my $sec = 3;
    prtMess($bpe,"WAITING $sec SECONDS");
    sleep($sec);
    prtMess($bpe,"BIAS COMBINATION PROCEDURE STARTED");

# Copy NEQ files
    foreach $inp (@lst2) {
      $out = ${dirNeq}.basename($inp);
      copy($inp,$out);
    }

    my @lst;
    my $PGMNAM = "ADDNEQ2";

# A1S NEQ generation step:
    @lst = (basename($lst1[0]),basename($lst2[0]));
    replaceSelLst($bpe,"ADDNEQ2","INPFILE",@lst);
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'A1A$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'A1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT","");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX","");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","AS_IS");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NOINV","1");
    $bpe->RUN_PGMS($PGMNAM);

    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NOINV","0");

# A1S (using combined input NEQ):
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","INPFILE",'A1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'A1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT","");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT",'A1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX",'A1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","AS_IS");
    $bpe->RUN_PGMS($PGMNAM);

# A1S (using clock/iono input NEQs):
    @lst = (basename($lst1[0]),basename($lst2[0]));
    replaceSelLst($bpe,"ADDNEQ2","INPFILE",@lst);
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'_1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT","");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT",'_1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX",'_1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","AS_IS");
##    $bpe->RUN_PGMS($PGMNAM);

# A1F (using combined input NEQ):
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","INPFILE",'A1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'A1F$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT","");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT",'A1F$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX",'A1F$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","FREQUENCY");
    $bpe->RUN_PGMS($PGMNAM);

# A1F (using clock/iono input NEQs):
    @lst = (basename($lst1[0]),basename($lst2[0]));
    replaceSelLst($bpe,"ADDNEQ2","INPFILE",@lst);
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'_1F$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT","");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT",'_1F$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX",'_1F$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","FREQUENCY");
##    $bpe->RUN_PGMS($PGMNAM);

# A1R (using combined input NEQ):
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","INPFILE",'A1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'A1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'A1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT",'A1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX",'A1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","SYSTEM");
    $bpe->RUN_PGMS($PGMNAM);

# A1R (using clock/iono input NEQs):
    @lst = (basename($lst1[0]),basename($lst2[0]));
    replaceSelLst($bpe,"ADDNEQ2","INPFILE",@lst);
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'_1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'_1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT",'_1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX",'_1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","SYSTEM");
##    $bpe->RUN_PGMS($PGMNAM);

# A1G (using combined input NEQ):
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","INPFILE",'A1S$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'A1G$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'A1G$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT",'A1G$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX",'A1G$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","PRE-ELIMINATE");
    $bpe->RUN_PGMS($PGMNAM);

# B1G (using G-reduced clock/iono input NEQs):
    @lst = (basename($lst1[1]),basename($lst2[1]));
    replaceSelLst($bpe,"ADDNEQ2","INPFILE",@lst);
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'B1G$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'B1G$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT",'B1G$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX",'B1G$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","AS_IS");
    $bpe->RUN_PGMS($PGMNAM);

# B1R (using R-reduced clock/iono input NEQs):
    @lst = (basename($lst1[2]),basename($lst2[2]));
    replaceSelLst($bpe,"ADDNEQ2","INPFILE",@lst);
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'B1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'B1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT",'B1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX",'B1R$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","AS_IS");
    $bpe->RUN_PGMS($PGMNAM);

# Check ADDNEQ2 results
    my @out = ("A1S${yyssss}","A1F${yyssss}","A1R${yyssss}","A1G${yyssss}",
               "B1G${yyssss}","_B1R${yyssss}");

    my $tol = 30;
    $tol = sprintf("%4.1f",$tol) if $tol < 100;

    my $err = 0;
    for my $nam (@out) {
      next if substr($nam,0,1) eq "_";
      my $fil = "${dirOut}$nam.${extOut}";
      getstring("-a 40 -b 51",$fil,"A posteriori RMS of unit weight");
      my $rms = $StrList[0];
      my $film1 = $fil;
      $film1 =~ s/${yyssss}/${yyssssm1}/;
      getstring("-a 40 -b 51",$film1,"A posteriori RMS of unit weight");
      my $rmsm1 = $StrList[0];
      $rmsm1 = $rms unless -s $film1;
      my $fac = 2;
      $fac = $rms/$rmsm1 if $rmsm1 > 0;
      $fac = sprintf("%10.3f",$fac);
      my $dev = ($fac-1)*100;
      $dev = sprintf("%8.1f",$dev);
      print "$fil: RMS: $rms $rmsm1 $fac $dev\n";
      $err++ if abs($dev) > $tol;
    }
    if ($err > 0) {
      prtMess($bpe,"COMBINED BIAS RESULTS NOT ACCEPTED ($err ERRORS)");
      if ($sav eq "Y") {
        prtMess($bpe,"V_SAV TEMPORARILY SET TO N");
        $sav = "N";
      }
      if ($dis eq "Y") {
        prtMess($bpe,"V_DIS TEMPORARILY SET TO N");
        $dis = "N";
      }
      msg2key("BPE","$pcfFil RAP_BIA $yyssss: Combined bias results not accepted ($err errors)"); 
    }

# Save relevant results
    if ($sav eq "Y") {
      my @lst = ("A1G","A1R","B1G","B1R");
      my $dirSav = "${PATH_SAV}${CAMP_SAVRAPCLK}/${yyyy}/SOL/";
      check_dir($dirSav);
      for (@lst) {
        $inp = "${dirNeq}$_${yyssss}.${extNeq}";
        $out = "${dirSav}$_${yyssss}.${extNeq}";
        copy($inp,$out);
        system("gzip -f $out");
        $out = $out.".gz";
        die "$out not saved" unless -s $out;
      }

      @lst = ("A1S","A1F","A1R","A1G","B1G","B1R");
      $dirSav = "${PATH_SAV}${CAMP_SAVRAPCLK}/${yyyy}/ORB/";
      check_dir($dirSav);
      for (@lst) {
        $inp = "${dirOsb}$_${yyssss}.${extOsb}";
        $out = "${dirSav}$_${yyssss}.${extOsb}";
        copy($inp,$out);
        die "$out not saved" unless -s $out;
        $inp = "${dirBia}$_${yyssss}.${extBia}";
        $out = "${dirSav}$_${yyssss}.${extBia}";
        copy($inp,$out);
        die "$out not saved" unless -s $out;
      }

      prtMess($bpe,"BIAS RESULTS SAVED");
    } else {

      prtMess($bpe,"BIAS RESULTS NOT SAVED");
    }

# Distribute relevant results
##    if ($dis eq "Y") {
    if ($sav eq "Y") {

      prtMess($bpe,"BIAS RESULTS DISTRIBUTED");
    } else {
      prtMess($bpe,"BIAS RESULTS NOT DISTRIBUTED");
    }

# Delete NEQ files
    foreach $inp (@lst2) {
      $out = ${dirNeq}.basename($inp);
      unlink($out);
    }
    my $fil = "${dirNeq}A1S${yyssss}.${extNeq}";
##    unlink($fil);

    prtMess($bpe,"BIAS COMBINATION PROCEDURE FINISHED");
  } else {
    prtMess($bpe,"BIAS COMBINATION PROCEDURE SKIPPED");
  }

}
