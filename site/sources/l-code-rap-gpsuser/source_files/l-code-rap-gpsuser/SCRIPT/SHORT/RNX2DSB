package RNX2DSB;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RNX2DCB
#
# Purpose :  Generate intra-frequency GNSS OSB results using RNX2OSB
#
# PARAMs  :  PARAM1 - Optional minus parameter
#
# Author  :  S. Schaer
# Created :  04-Nov-2021
#
# Changes :  04-Nov-2021 SS: Developed starting from RNX2DCB
#            28-Jan-2022 SS: Used in operational mode (for DCBREPRO)
#            31-Jan-2022 SS: Saved gzipped D1?yyssss.NQ0.gz
#            02-Mar-2022 SS: Some essential updates
#            28-Mar-2022 SS: New kind of problem for PENC, HERT
#            07-Apr-2022 SS: Considered black list for test purposes
#            08-Apr-2022 SS: Ignored suspicious CHOF RXO data (20220550)
#            11-Jul-2022 SS: Used considerably updated RNX2OSB executable
#            12-Jul-2022 SS: Switched IGN_SOLY_TYPS (for QZSS)
#            12-Jul-2022 SS: Reported satellites with missing SVN
#            11-May-2023 SS: Major update of RNX2OSB;
#                            changed end time from '23 59 30' to '24 00 00';
#                            re-activated SVN checking (see RM_UNDEF_SATS)
#            26-May-2023 SS: Checked availability of DSB results (for
#                            covered GRJ and non-covered ECS systems);
#                            monitored OBS in DSB results (using D1?.OBS)
#            30-May-2023 SS: $numObs supplied in messages
#            21-Jun-2023 SS: Improved filtering for OBS.LST file generation
#            01-May-2024 SS/ST: Tested/activated revised version of RNX2OSB
#            02-May-2024 SS: Suppressed notification in reprocessing mode
#            19-Feb-2026 SS: Now expecting DSB results for C:C2I/C2X (D1C260190.OSB)
#            08-Jun-2026 SS: No SYOG-based DSB results for C:C2I/C2X (D1C261550.OSB)
#            10-Jun-2026 SS: SYOG again available
#            17-Jun-2026 SS: Strange failure due to missing D1C261670.OSB
#                            (due to TLSE C:C7I/C7D data issue)
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;
use File::Compare qw(compare);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $mjd, $h, $sav, $dirRxo, $dirOsb, $dirBia, $dirNeq, $dirOut, $param1) =
    $bpe->getKeys('$YSS+0', '$JD+0', 'V_H', 'V_SAV', 'DIR_RXO', 'DIR_OSB', 'DIR_BIA', 'DIR_NEQ', 'DIR_OUT', 'PARAM1');

# Set variables
# -------------
  my ($yyyy,$ssss,$yyssss,$yyddd,$yy,$ddd,$mm,$dd,$d,$mjd1) = gps_date("-mjd $mjd            -o %Y %j0 %y%j0 %y%j %y %j %m %d %w %IJ");
     ($yyyy,$ssss,$yyssss,$yyddd,$yy,$ddd,$mm,$dd,$d,$mjd1) = gps_date("-mjd $mjd -d $param1 -o %Y %j0 %y%j0 %y%j %y %j %m %d %w %IJ") unless $param1 eq "";

  my $mjd0 = gps_date("-doy 0 -o %IJ");

# Extra command lines for DCBREPRO:
##  my $chkOsb = "${dirOsb}${h}${yyssss}.OSB";
##  return if -e $chkOsb && $yyyy<2022;

# Consider RNX2DSB FLG file
# -------------------------
  my $flgFil = "${dirOut}../MSC/RNX2DSB.FLG";
  my $flgLin = -e $flgFil ? `cat $flgFil` : "ALL";
  chomp($flgLin);
  prtMess($bpe,"RINEX DATA SELECTION: ${flgLin}");

# Download RINEX data
# -------------------
  if ($mjd-$mjd0>=-32) {
    prtMess($bpe,"RINEX DOWNLOAD STARTED");
#    system("$ENV{AUTO}/get_obsdata.com -d=$ddd -y=$yyyy");
    prtMess($bpe,"RINEX DOWNLOAD ENDED");
  } else {
    prtMess($bpe,"RINEX DOWNLOAD SKIPPED");
  }

  unlink(glob("${dirRxo}?????????_${yyyy}${ssss}.RXO"));
  system("$ENV{AUTO}/put_igsdata.com $yy $ssss -o $dirRxo \"-or %FIN %CLK %ION %HRD %MGEX\" -r=3 -c=50 --bsw");
##  system("$ENV{AUTO}/put_igsdata.com $yy $ssss -o $dirRxo \"-or %OBS %FIN %CLK %ION %HRD %MGEX\" -r=3 -c=50 --bsw");
##  return;
##  unlink(glob("${dirRxo}SYOG?????_20261670.RXO"));
##  unlink(glob("${dirRxo}TLSE?????_20261680.RXO"));

# Count RINEX files and return in case of no file
# -----------------------------------------------
  @staLst = glob("${dirRxo}?????????_${yyyy}${ssss}.RXO");
  $numLst = @staLst;
  prtMess($bpe,"$numLst RXO files found");
  die "No RXO files found" if $numLst==0;
  return if $numLst==0;

# Execute rinex.com
# -----------------
#  system("$ENV{AUTO}/rinex.com $dirRxo $ddd $yy");
##  `cp ${dirRxo}?????????_${yyyy}${ssss}.RXO ${dirRxo}../TMP/OLD/`;
##  replace("${dirRxo}?????????_${yyyy}${ssss}.RXO","^G[ 0]1","G51");
##  replace("${dirRxo}?????????_${yyyy}${ssss}.RXO","^G[ 0]3","G53");
##  replace("${dirRxo}?????????_${yyyy}${ssss}.RXO","^G51","G03");
##  replace("${dirRxo}?????????_${yyyy}${ssss}.RXO","^G53","G01");
##  `cp ${dirRxo}?????????_${yyyy}${ssss}.RXO ${dirRxo}../TMP/NEW/`;
##  return;

# Run program
# -----------
  my ($sol,$nam,$sta,$sys,$num,$tmpOsb,$filOsb,$filBia,$filDcb,$filNeq,$filObs);
  unlink(glob("${dirOsb}${h}${yyssss}_*.OSB"));
  unlink(glob("${dirBia}${h}${yyssss}_*.BIA"));

##  $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/storage/homefs/l_code_rap/RNX2OSB/EXE_GNU/");
##  $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/storage/research/aiub_data/BSWsoftware/BERN/SOURCE/PGM/ARCHIVE/EXE_GNU_20260610/EXE_GNU/");
##  $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/storage/research/aiub_data/BSWsoftware/TEST_/EXE_GNU_/");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","RM_UNDEF_SATS","0");

  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SHW_OBSTYPE_STAT","1");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SHW_OBSDIFF_STAT","1");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SHW_PARAMS","1");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SHW_SAT_CLUS","1");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SHW_NEQDIAG_LOCQ","1");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SHW_RESIDUALS","1");

  setGNSS($bpe,"$ENV{U}/PAN/RNX2OSB.INP","USE_","GRECJS");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","NEQOUT"," ");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","BIASSNX"," ");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SESSION_YEAR","$yyyy");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SESSION_STRG","$ssss");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","STADAT","$yyyy $mm $dd");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","ENDDAT","$yyyy $mm $dd");

##  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","MINOBSNB","1");
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","MINSTNNB","1");

# (A) Station-wise GNSS DSB determination
# ---------------------------------------
  my @useLst = ();
  foreach my $filRxo (@staLst) {
    $nam = (split('\.',basename($filRxo)))[0];
##    next if substr($nam,0,1) ne "A";
##    next if substr($nam,0,1) ne "Z";
# Consider black list for test purposes:
# Debub list:
##    my @badLst = ("ASCG","BNDY","CAS1","CHPG","CPVG",              "JFNG","KIR8","KRGG","MAR7","MAYG","NYA1","NYAL","ONS1","PARC","RGDG","STR2","TRO1","ZIMM");
# List 2021/2022:
##    my @badLst = ("ASCG","BNDY","CAS1","CHPG","CPVG","DAEJ","INEG","JFNG","KIR8","KRGG","MAR7","MAYG","NYA1","NYAL","ONS1","PARC","RGDG","STR2","TRO1");
# List 2022:
##    my @badLst = ("ASCG","BNDY","CAS1","CHPG","CPVG",              "JFNG","KIR8","KRGG","MAR7","MAYG","NYA1","NYAL","ONS1","PARC","RGDG","STR2","TRO1");
    my @badLst = ();
    next if lindex(substr($nam,0,4),@badLst) != -1;
# Add stations to be generally excluded here:
    next if substr($nam,0,4) eq "____" && $mjd1==99999;
##    next if substr($nam,0,4) eq "CHOF" && $mjd1==59634;
##    next if substr($nam,0,4) eq "PENC" && $mjd1==59662;
##    next if substr($nam,0,4) eq "HERT" && $mjd1>=59663;
##    next if substr($nam,0,4) eq "ABMF" && $mjd1>=60402;
##    next if substr($nam,0,4) eq "IMPZ" && $mjd1>=60402;
    $sta = substr($nam,0,9);
    $sol = "${h}${yyssss}_${sta}";
    print "RXO: $sta $nam $filRxo\n";

    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","TITLE","Direct GNSS OSB determination for $nam");
    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","RNXFIL_BSW",$nam);
##    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","NEQOUT",$sol);
    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","OSBOUT",$sol);
##    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","BIASSNX",$sol);
    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SYSOUT",$sol);

    prtMess($bpe,"Processing station $nam");

    my $PGMNAM = "RNX2OSB";
    $bpe->RUN_PGMS($PGMNAM);

    $filOsb = "${dirOsb}${sol}.OSB";
    if (-e $filOsb) {
      prtMess($bpe,"DSB results for station $nam: Y");
# Add stations to be excluded for system-wise RNX2OSB analysis here:
      $nam = "" if substr($nam,0,4) eq "____" && $mjd1==99999;
      push(@useLst,$nam) if $nam ne "";
    } else {
      prtMess($bpe,"DSB results for station $nam: N");
# Use other (non-contributing) stations for observation data monitoring:
      push(@useLst,$nam);
    }
  }

# (B) System-wise GNSS DSB determination
# --------------------------------------
  $numLst = @useLst;
  prtMess($bpe,"$numLst RXO files selected");
  die "No RXO files selected" if $numLst==0;

##  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","RNXFIL_BSW",'?????????_$YYYSS+0');
##  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","RNXFIL_BSW","?????????_\$YYYSS($param1)");
##  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","RNXFIL_BSW","?????????_$yyyy$ssss");
#?  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","RNXFIL_BSW","?????????_${yyyy}${ssss}");
  replaceSelLst($bpe,"RNX2OSB","RNXFIL_BSW",@useLst);
  map { print "LST: $_\n" } @useLst;
  $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","EN_EST_RCG","1");

  my @sys = ("G","R","E","C","J","S");
##  my @sys = ("S","J","C","E","R","G");
##  my @sys = ("J");
  foreach $sys (@sys) {
    $sol = substr($h,0,2).$sys.$yyssss;

    setGNSS($bpe,"$ENV{U}/PAN/RNX2OSB.INP","USE_",$sys);
    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","TITLE","Direct $sys OSB determination for session $yyssss");
    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","NEQOUT",$sol);
    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","OSBOUT",$sol);
    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","BIASSNX",$sol);
    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SYSOUT",$sol);
##    $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","SYSOUT",substr($h,0,2).$sys." ".$ssss);

    if ($sys eq "G") {
      $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","MINSTNNB","1");
##      $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","MINSTNNB","2");
    } else {
      $bpe->putKey("$ENV{U}/PAN/RNX2OSB.INP","MINSTNNB","1");
    }

    prtMess($bpe,"Processing system $sys");

    $PGMNAM = "RNX2OSB";
    $bpe->RUN_PGMS($PGMNAM);

    $filOsb = "${dirOsb}${sol}.OSB";
##    $filBia = "${dirBia}${sol}.BIA";
    $filNeq = "${dirNeq}${sol}.NQ0";
    my (@obs,$numObs,$lstObs,$lstObs0,@obs0,@oldObs,@newObs,$oldObs,$newObs);
    if (-e $filOsb) {
      @obs = `grep 'OSB' $filOsb | grep ' ${sys}[0-9][0-9] ' | cut -c39-41 | sort -u`;
      chomp(@obs);
      $numObs = sprintf("%2i",$#obs+1);
      $lstObs = join(" ",@obs);
      prtMess($bpe,"DSB results for system $sys: Y $numObs $lstObs");
      die "NEQ not found for system $sys\n" if !-e $filNeq;
    } else {
      $lstObs = "";
      prtMess($bpe,"DSB results for system $sys: N");
##      warn "No OSB and empty NEQ file found for system $sys\n" if -e $filNeq;
      die "No OSB and empty NEQ file found for system $sys\n" if -e $filNeq;
##      unlink($filNeq);
    }
# Specify here for which GNSS systems DSB results are expected:
    if ($sys eq "G" || $sys eq "R" || $sys eq "C" || $sys eq "J") {
      if (!-e $filOsb) {
        prtMess($bpe,"No DSB results for system $sys");
        msg2key("BPE","RNX2DSB_${yyssss}: No DSB results for system $sys") if ($param1 == 0 && $mjd1-$mjd0>=-32);
      }
    } else {
      if (-e $filOsb) {
        prtMess($bpe,"DSB results for system $sys: $numObs $lstObs");
        msg2key("BPE","RNX2DSB_${yyssss}: DSB results for system $sys: $numObs $lstObs") if ($param1 == 0 && $mjd1-$mjd0>=-32);
      }
    }
    if ($param1 == 0) {
      $filObs = "${dirOut}../MSC/D1${sys}.OBS";
      if (-e $filObs) { $lstObs0 = `cat $filObs`; chomp($lstObs0) }
      else            { $lstObs0 = "" }
      @obs0 = split(" ",$lstObs0);
      $newObs = ();
      foreach (@obs) { push(@newObs,$_) if lindex($_,@obs0)==-1 }
      $newObs = join(" ",@newObs);
      $newObs = "+".$newObs if $newObs ne "";
      @oldObs = ();
      foreach (@obs0) { push(@oldObs,$_) if lindex($_,@obs)==-1 }
      $oldObs = join(" ",@oldObs);
      $oldObs = "-".$oldObs if $oldObs ne "";
      if ($lstObs ne $lstObs0 && $mjd1-$mjd0>=-32) {
##        prtMess($bpe,"Changed OBS in DSB results for system $sys: $numObs $lstObs");
##        msg2key("NEW","RNX2DSB_${yyssss}: Changed OBS in DSB results for system $sys: $numObs $lstObs");
        prtMess($bpe,"Changed OBS in DSB results for system $sys: $numObs $newObs $oldObs");
        msg2key("NEW","RNX2DSB_${yyssss}: Changed OBS in DSB results for system $sys: $numObs $newObs $oldObs");

        `echo '$lstObs' > $filObs` if $numObs>0 || -e $filObs;
##        if ($numObs>0) { `echo '$lstObs' > $filObs` }
##        else           { unlink($filObs) }
      }
    }
  }

# Create D1_ yyssss OSB file (including all determined GNSS)
# ----------------------------------------------------------
  $filOsb = "${dirOsb}${h}${yyssss}.OSB";
  $tmpOsb = "${dirOsb}TMP${yyssss}.OSB";
  copy("${dirOsb}D1G${yyssss}.OSB",$tmpOsb);
  @sys = ("R","E","C","J","S");
##  @sys = ("R","C","J");
  foreach $sys (@sys) {
    my $addOsb = "${dirOsb}D1${sys}${yyssss}.OSB";
    if (-e $addOsb) {
      system("$ENV{AUTO}/filmerge.pl $tmpOsb $addOsb $filOsb 11");
      copy($filOsb,$tmpOsb);
      prtMess($bpe,"$addOsb available and added");
    } else {
      prtMess($bpe,"$addOsb unavailable");
    }
  }

# Reported satellites with missing SVN
# ------------------------------------
  my @errSat = `grep 'OSB        [A-Z][0-9][0-9] ' $filOsb | cut -c12-14 | sort -u`;
  chomp(@errSat);
  my $errSat = join(" ",@errSat);
  if ($errSat eq "") {
    prtMess($bpe,"Missing SVN: NO");
  } else {
    prtMess($bpe,"Missing SVN: $errSat");
##    if ($param1 == 0 && $d == 0) {
    if ($param1 == 0) {
      $nam = basename($filOsb);
      msg2key("BPE","RNX2DSB_${yyssss}: Missing SVN for PRN: $errSat (see ${nam})") if $mjd1-$mjd0>=-32;
    }
  }
  my $errOsb = `grep 'OSB            ' $filOsb | wc -l`+0;
  if ($errOsb > 0) {
    prtMess($bpe,"Missing SVN and PRN ($errOsb lines)");
    if ($param1 == 0) {
      $nam = basename($filOsb);
      msg2key("BPE","RNX2DSB_${yyssss}: Missing SVN and PRN ($errOsb lines, see ${nam})") if $mjd1-$mjd0>=-32;
    }
  }

# Derive D11 and D12 yyssss DCB files
# -----------------------------------
##  $tmpOsb = "${dirOsb}TMP${yyssss}.OSB";
##  `cat ${dirOsb}D1[GR]${yyssss}.OSB > $tmpOsb`;
  copy($filOsb,$tmpOsb);
  $filDcb = "${dirOsb}D11${yyssss}.DCB";
  system("$ENV{AUTO}/osb2dcb.com $tmpOsb $filDcb P1-C1");
##  system("$ENV{AUTO}/osb2dcb.com $tmpOsb $filDcb P1-C1 -rec");
  $filDcb = "${dirOsb}D12${yyssss}.DCB";
  system("$ENV{AUTO}/osb2dcb.com $tmpOsb $filDcb P2-C2");
##  system("$ENV{AUTO}/osb2dcb.com $tmpOsb $filDcb P2-C2 -rec");
  unlink($tmpOsb);

# Create observation statistics
# -----------------------------
  `grep '^ [A-Z][0-9][0-9], ' ${dirOut}${h}${yyssss}_*.OUT | grep '=' > ${dirOut}OBS_${yyyy}${ssss}_STA.LST`;
  $sol = substr($h,0,2);
##  `grep '^ [A-Z][0-9][0-9], ' ${dirOut}${sol}?${yyssss}.OUT > ${dirOut}OBS_${yyyy}${ssss}.LST`;
  `cat ${dirOut}${sol}?${yyssss}.OUT | grep '^ [A-Z][0-9][0-9], ' | grep '=' > ${dirOut}OBS_${yyyy}${ssss}.LST`;

# Save OSB and DCB results
# ------------------------
  if ($sav eq "Y") {
    prtMess($bpe,"DCB SAVING STARTED");
    my $dirSav = "$PATH_SAV$CAMP_SAVIGS/$yyyy/ORB/";
    check_dir($dirSav);
    $sol = substr($h,0,2);
    map { copy($_,$dirSav) or die "copy failed with $_\n" } glob("${dirOsb}${sol}?${yyssss}.OSB");
    map { copy($_,$dirSav) or die "copy failed with $_\n" } glob("${dirBia}${sol}?${yyssss}.BIA");
    map { copy($_,$dirSav) or die "copy failed with $_\n" } glob("${dirOsb}${sol}?${yyssss}.DCB");
    $dirSav = "$PATH_SAV$CAMP_SAVIGS/$yyyy/SOL/";
    check_dir($dirSav);
    $sol = substr($h,0,2);
    map { copy($_,$dirSav) or die "copy failed with $_\n" } glob("${dirNeq}${sol}?${yyssss}.NQ0");
    map { system("gzip -f $_"); warn "gzip failed with $_\n" unless -s $_.".gz" } glob("${dirSav}${sol}?${yyssss}.NQ0");
    $dirSav = "$PATH_SAV$CAMP_SAVIGS/$yyyy/DCB/";
    check_dir($dirSav);
    map { copy($_,$dirSav) or die "copy failed with $_\n" } glob("${dirOsb}${h}${yyssss}_*.OSB");
    map { copy($_,$dirSav) or die "copy failed with $_\n" } glob("${dirBia}${h}${yyssss}_*.BIA");
    $sol = substr($h,0,2);
    map { copy($_,$dirSav) or die "copy failed with $_\n" } glob("${dirOsb}${sol}?${yyssss}.OSB_*");
    $dirSav = "$PATH_SAV$CAMP_SAVIGS/$yyyy/OUT/";
    check_dir($dirSav);
    map { copy($_,$dirSav) or die "copy failed with $_\n" } glob("${dirOut}OBS_${yyyy}${ssss}.LST");
    map { copy($_,$dirSav) or die "copy failed with $_\n" } glob("${dirOut}OBS_${yyyy}${ssss}_STA.LST");
    prtMess($bpe,"DCB SAVING ENDED");
  } else {
    prtMess($bpe,"DCB SAVING SKIPPED");
  }

# Delete files
# ------------
  unlink(glob("${dirOut}${h}${yyssss}_*.OUT"));
  unlink(glob("${dirNeq}${h}${yyssss}_*.NQ0"));
  unlink(glob("${dirOsb}${h}${yyssss}_*.OSB"));
  unlink(glob("${dirBia}${h}${yyssss}_*.BIA"));
  $sol = substr($h,0,2);
  unlink(glob("${dirOsb}${sol}?${yyssss}_*.OSB_*"));

##  unlink(glob("${dirRxo}?????????_${yyyy}${ssss}.RXO"));
  unlink(glob("${dirRxo}?????????_${yyyy}${ssss}.RXO")) if $mjd1-$mjd0<-8;
  unlink(glob("${dirRxo}?????????_${yyyy}${ssss}.RXO")) if $yyyy<2022;

}
