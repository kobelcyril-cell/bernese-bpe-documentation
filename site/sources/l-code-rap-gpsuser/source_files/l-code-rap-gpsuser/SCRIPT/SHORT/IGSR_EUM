package IGSR_EUM;
@ISA = ("RUNBPE");
# =============================================================================
#
# Name    :  IGSR_EUM
#
# Purpose :  Copy GEN files for EUMETSAT to SFTP server, remove LEOs from
#            sat. info. file
#
# Programs:
#
# Author  :  D. Arnold
#
# Created :  02-Dec-2021
#
# Changes :  20-Jan-2022 DA: Copy I14.ATX from AFTP
#            29-Mar-2022 AV: GEN path splitted to MODEL/CONFIG
#            17-Oct-2022 DA: Updated pw
#            09-Nov-2022 DA: Use Net::SFTP instead of lftp
#            04-Jan-2023 DA: Use newFTP instead of Net::SFTP
#
# =============================================================================
use strict;
use warnings;

# Local packages
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{EXE}";
use lib "$ENV{AUTO}";
use newFTP;
use gpsutil qw(msg2key);
use Gps_Date;

# External packages
use File::Copy qw(copy);
#use Net::SFTP;
use File::Basename qw(basename);

sub run {
  my $bpe = shift;

  # Source directories
  my $srcDir = "$ENV{B}/BERN/GLOBAL/CONFIG";
  my $srcDirAFTP = "$ENV{PATH_AFTP}/BSWUSER52/GEN";

  # Host
  my $host = "sftp.eumetsat.int";
  my $user = "FLO-SciSrvPOD-user";
  my $pw = "zwFQcqUr2sL72v8";

  # Remote directory
  my $remDir = "/SD-128496/GEN";

  # Debug?
  my $debug = 0;

  print "Upload GEN files to ${host}:${remDir}\n";

  my $err = '';

  # Check if source directories exists
  unless (-d $srcDir) {
      $err .= " *** Source directory $srcDir not found\n";
      goto FINISH;
  }
  unless (-d $srcDirAFTP) {
      $err .= " *** Source directory $srcDirAFTP not found\n";
      goto FINISH;
  }

  # Establish SFTP connection (using Net::SFTP)
  # my %args = (ssh_args => []);
  # $args{debug} = $debug;
  # $args{user} = $user;
  # $args{password} = $pw;
  # print "Connecting to $host... ";
  # my $sftp = '';
  # eval {$sftp = Net::SFTP->new($host, %args)};
  # unless ($sftp) {
  #     $err .= " *** Unable to connect to $host\n";
  #     goto FINISH;
  # }
  # print "OK\n";

  # Establish SFTP connection (using newFTP)
  print "Connecting to $host...\n";
  my $sftp = '';
  eval {$sftp = newFTP->new($host,t=>30,v=>1,s=>1,user=>$user,pass=>$pw)};
  unless ($sftp) {
      $err .= " *** Unable to connect to $host\n";
      goto FINISH;
  }
  print "OK\n";

  # Get yyyy (for SAT_yyyy.CRX)
  my $yyyy = &gps_date("-t -o %Y");

  # Copy BOXWING.MAC
  $err .= &putFile($sftp,"${srcDir}/BOXWING.MAC",$remDir);

  # Copy I14.ATX (use the one on the AFTP)
  $err .= &putFile($sftp,"${srcDirAFTP}/I14.ATX",$remDir);

  # Copy SAT_yyyy.CRX
  $err .= &putFile($sftp,"${srcDir}/SAT_${yyyy}.CRX",$remDir);

  # Copy SATELLIT_I14.SAT to $T
  my $tmpDir = "$ENV{T}/IGSR_EUM_".time;
  check_dir($tmpDir);
  my $satInfTmp = "${tmpDir}/SATELLIT_I14.SAT_orig";
  print "Copy ${srcDir}/SATELLIT_I14.SAT to $satInfTmp\n";
  copy("${srcDir}/SATELLIT_I14.SAT",$satInfTmp);

  if (-e $satInfTmp) {
      # Remove all LEO entries from temp. sat. info file
      print "Remove all LEO entries from $satInfTmp\n";
      my $satInf = "${tmpDir}/SATELLIT_I14.SAT";
      open INP, '<', $satInfTmp;
      open OUT, '>', $satInf;
      while (my $line = <INP>) {
          print OUT $line unless ($line =~ /\A9\d\d /);
      }
      close INP;
      close OUT;
      if (-e $satInf) {
          print "Created $satInf\n";

          # Copy modified sat. info file to SFTP server
          $err .= &putFile($sftp,$satInf,$remDir);

          # Remove temp. directory
          system("rm -r $tmpDir");
          print "Deleted $tmpDir\n";
      } else {
          $err .= " *** Could not remove LEOs from sat. info file\n";
      }
  } else {
      $err .= " *** Could not copy ${srcDir}/SATELLIT_I14.SAT to $satInfTmp\n";
  }

 FINISH:
  # Check for errors
  if ($err) {
      print " *** Errors occurred:\n";
      print $err;
      prtMess($bpe,"Errors occurred");
#ss:      msg2key("BPE","IGSR_EUM: Errors occurred");
      msg2key("MSC","IGSR_EUM: Errors occurred");
  } else {
      print "No errors occurred. Done.\n";
  }
}

sub putFile {
    my $sftp = $_[0];
    my $srcFil = $_[1];
    my $tgtDir = $_[2];

    my $srcFilB = &basename($srcFil);
    my $tgtFil = "$tgtDir/$srcFilB";

    my $err_putFile = '';

    print "Uploading $srcFil --> ${tgtFil}: ";

    # Check if source file exists
    unless (-e $srcFil) {
        $err_putFile .= " *** $srcFil not found\n";
        return $err_putFile;
    }

    # Execute put
    if ($sftp->put($srcFil,$tgtFil)) {
        print "Done\n";
    } else {
        $err_putFile .= " *** Upload failed\n";
    }

    return $err_putFile;
}

# =============================================================================

__END__
