use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yyssss, $yyyy, $mjd,
      $dirPhasecc,$satInf, $pcv,
      $pcfFil, $upd, $sav, $dis, $param1,
      $dirOut, $extOut, $dirNeq, $extNeq, $dirOsb, $extOsb, $dirBia, $extBia, $extSat) =
    $bpe->getKeys('$YD+0', '$YSS+0', '$Y+0', '$JD+0',
                  'PTH_PHASECC','V_SATINF', 'V_PCV',
                  'PCFFIL', 'V_UPD', 'V_SAV', 'V_DIS', 'PARAM1',
                  'DIR_OUT', 'EXT_OUT', 'DIR_NEQ', 'EXT_NEQ', 'DIR_OSB', 'EXT_OSB', 'DIR_BIA', 'EXT_BIA', 'EXT_SATELL');

# Set variables
# -------------
##  $upd = "N";
##  $sav = "N";
##  $dis = "N";

  my $host = "$ENV{HOST}";
  print "Host: $host\n";

  $pcfFil = (split('\.',$pcfFil))[0];

  my $aprFil = "${dirOsb}APR${yyddd}.${extOsb}";

# Compute full solution using all 1-day NEQs?
  my $allFlg = "${dirOut}../MSC/ALL.FLG";
# Re-generate all monthly NEQs?
  my $setFlg = "${dirOut}../MSC/RESET.FLG";

  die "PARAM1 undefined" if $param1 eq "";
  my $sol = $param1;
  prtMess($bpe,"BIAS COMBINATION PROCEDURE FOR SOLUTION: $sol");

# Create extra satellite information file
# ---------------------------------------
  my $satInf2 = "SAT_BIA_${pcv}.$extSat";
  if ($sol eq "A1G") {
    my $fil1 = "${dirPhasecc}/${satInf}_${pcv}.${extSat}";
##    my $fil1 = "${dirPhasecc}/${satInf}_I14.${extSat}";
    my $fil2 = "${dirPhasecc}/$satInf2";
    die "$fil1 not found" unless -s $fil1;
    copy($fil1,$fil2);
    replace($fil2,"23 59 5[89]  ","24 00 00  ");

    replace($fil2,"2008 04 27","2008 04 30"); # R06
    replace($fil2,"2010 07 18","2010 08 01"); # R11
    replace($fil2,"2010 09 07","2010 09 08"); # R01
    replace($fil2,"2011 11 06","2011 11 01"); # R21
    replace($fil2,"2018 03 18","2018 04 01"); # R01
    replace($fil2,"2015 01 31","2015 02 01"); # R05
    replace($fil2,"2013 12 08","2013 12 01"); # R09
    replace($fil2,"2013 12 07","2013 12 01"); # R12
    replace($fil2,"2015 03 08","2015 03 01"); # R09
    replace($fil2,"2015 12 2[67]","2015 10 05"); # R12
    replace($fil2,"2017 10 06","2017 10 10"); # R14 (SVN)

    my $inp = $fil2;
    my $out = $fil2."_TMP";
    open(INP,"$inp");
    open(OUT,"> $out");
    my @pos1 = (35,41,5);
    my $epo2_125 = substr(`grep '^125 ' $inp | grep '   2023 12 15 ' | head -1`,56,19);
    my $epo2_126 = substr(`grep '^126 ' $inp | grep '   2023 12 15 ' | head -1`,56,19);
    while (my $lin0=<INP>) {
      my $lin = $lin0;
      my $prn = substr($lin,0,3);
      foreach my $pos1 (@pos1) {
        my $pos2 = $pos1+21;
        my $epo1 = substr($lin,$pos1,19);
        my $epo2 = substr($lin,$pos2,19);
        if ($epo2 eq "2023 12 08 00 00 00" && $prn == 125) {
          substr($lin,$pos2,19) = $epo2_125 }
        if ($epo2 eq "2023 12 08 00 00 00" && $prn == 126) {
          substr($lin,$pos2,19) = $epo2_126 }
        if ($epo1 eq "2023 12 08 00 00 00" && $epo2 eq "2023 12 15 00 00 00") {
          $lin = "" }
        if ($epo1 eq "2023 12 15 00 00 00") {
          $lin = "" }
      }
      if ($lin ne "") {
        print OUT $lin;
        print "CHANGED: $lin0" if $lin ne $lin0;
      } else {
        print "SKIPPED: $lin0";
      }
    }
    close(INP);
    close(OUT);
    move($out,$inp);
  }

# Are there unremoved bad monhtly NEQs?
# ------------------------------------
  my $errFlg = "${dirOut}../MSC/ERROR_${sol}.FLG";
  my $fil;
  if (-s $errFlg) {
    open(INP,$errFlg);
    while ($fil=<INP>) {
      chomp($fil);
      prtMess($bpe,"BAD NEQ FILE REMOVED: ".basename($fil));
      unlink($fil);
    }
    close(INP);
    unlink($errFlg);
  }

# First day 16136:
##  my $mjd0 = gps_date("-yd 16136 -o %IJ");
# First day 94001:
  my $mjd0 = gps_date("-yd 94001 -o %IJ");
##  my $mjd0 = gps_date("-yd 00001 -o %IJ");
##  my $mjd0 = gps_date("-yd 17001 -o %IJ");
  my $nam0 = "_Y1994";
  $nam0 = "_W1897" if $mjd0 eq "57523";
# Last day 16366 (REPRO_ION)
  my $mjdS = gps_date("-yd 16366 -o %IJ");
  $mjdS = gps_date("-yd 16135 -o %IJ");
  $mjdS = gps_date("-yd 16135 -o %IJ") if $mjd0 eq "57523";
  my $mjdF;
  my $mjdR = $mjd0;
  my $mjdM;
  my $mjdL = gps_date("-yd $yyddd -o %IJ");
#  my $mjdR0 = 99999;
#  my $mjdR0 = gps_date("-yd 19262 -o %IJ");
  my $mjdR0 = gps_date("-yd 19265 -o %IJ");
  my $mjdF0 = gps_date("-yd 22331 -o %IJ");
#  my $mjdF0 = 99999;

  my $yyddd0  = gps_date("-mjd $mjd0 -o %y%j");
  my $yyssss0 = gps_date("-mjd $mjd0 -o %y%j0");

  my $msg = 0;
  my $key = "NEW";

  my @finDay = ();
  my @rapDay = ();
  my @allDay = ();

  my @oldSet = ();
  my @newSet = ();
  my @allSet = ();
  my @badSet = ();

  my ($inp,$out,$set,$nam,$str,$inpR,$outR);

  my ($yymm,$yy,$mm,$ddp1,$yydddm1);
  my $yydddF = "";
  for ($mjd=$mjd0;$mjd<=$mjdL;$mjd++ ) {
    ($yyddd,$yyssss,$yyyy,$yymm,$yy,$mm) = gps_date("-mjd $mjd -o %y%j %y%j0 %Y %y%m %y %m %d");
    $ddp1 = gps_date("-mjd $mjd -d +1 -o %d");
    $yydddm1 = gps_date("-mjd $mjd -d -1 -o %y%j");

# FIN:
    $inp = "$PATH_SAV$CAMP_SAVIGS/$yyyy/SOL/${sol}${yyddd}.${extNeq}.gz";
    $inp = "$PATH_SAV/REPRO_ION/$yyyy/SOL/${sol}${yyddd}.${extNeq}.gz" if $mjd<=$mjdS;
    $inp = "$PATH_SAV/REPRO_ION/$yyyy/SOL/${sol}${yyddd}.${extNeq}.gz" if $mjd<=$mjdS;
    $out = "${dirNeq}${sol}${yyddd}.${extNeq}";
    $set = "${dirNeq}${sol}_${yymm}.${extNeq}";
# RAP:
    $inpR = "$PATH_SAV$CAMP_SAVRAPCLK/$yyyy/SOL/${sol}${yyssss}.${extNeq}.gz";
    $inpR = "" if $mjd< $mjdR0 || !-s $inpR;
    $inpR = "" if $mjd>=$mjdF0 &&  -s $inp;
    print "RAPTEST: $yyddd $inpR $mjd $mjdR0 $mjdF0\n" if $inpR ne "";
    $outR = "${dirNeq}${sol}${yyssss}.${extNeq}";

# Remove all monthly NEQs in case of reset
    if (-s $set) {
      unlink($set) if -e $setFlg }
# Remove monthly NEQ if older than a daily NEQ
    if (-s $set && -s $inp) {
      unlink($set) if (stat($set))[9]<(stat($inp))[9] }

    if (-s $inp) {
      print "FIN: $yyddd $mjd $yymm $yy $mm $ddp1\n";
      if ($yydddF ne "" && $yydddF ne $yydddm1) {
        prtMess($bpe,"MISSING $sol FINAL BIAS NEQ INFORMATION FOR $yydddm1");
##        die          "MISSING $sol FINAL BIAS NEQ INFORMATION FOR $yydddm1";
        warn         "MISSING $sol FINAL BIAS NEQ INFORMATION FOR $yydddm1";
        $msg++;
        $key = $msg <= 2 ? "NEW" : "MSC";
        msg2key($key,"$pcfFil COMB_BIA $yyssss0: Missing $sol final bias NEQ for $yydddm1");
      }
      $yydddF = $yyddd;
      $mjdF = $mjd;
#      push(@finDay,$yyddd);
# Ignore bad solutions
      if ($yyddd eq "19365" ||
          $yyddd eq "20343" ||
          $yyddd eq "_21062") {
        print "Day $yyddd ignored\n";
      } else {
        push(@finDay,$yyddd);
      }
      if ($ddp1 eq "01") {
        if (!-s $set) {
          push(@newSet,$yymm);
          $mjdM = $mjd;
        } else {
          push(@oldSet,$yymm);
          $mjdM = $mjd;
        }
      }
      if (!-s $set || -e $allFlg || $mjd-$mjdL > -60) {
        copy($inp,$dirNeq);
        system("gzip -d -f $out.gz");
# Consider GRE RCLK daily NQ0
        if ($inpR ne "") {
          push(@finDay,$yyssss);
          copy($inpR,$dirNeq);
          system("gzip -d -f $outR.gz");
        }
      }
# Remove rapid 1-day NEQ
##      unlink($outR) if -s $outR;
    } else {
# RAP:
      if (-s $inpR) {
        print "RAP: $yyddd $mjd $yymm $yy $mm $ddp1\n";
        $mjdR = $mjd;
        push(@rapDay,$yyssss);
        copy($inpR,$dirNeq);
        system("gzip -d -f $outR.gz");
      }
    }
  }
  if ($mjdL-$mjdF > 7) {
    prtMess($bpe,"LATEST $sol FINAL BIAS NEQ INFORMATION NOT FOUND");
##    die          "LATEST $sol FINAL BIAS NEQ INFORMATION NOT FOUND";
    warn         "LATEST $sol FINAL BIAS NEQ INFORMATION NOT FOUND";
    $msg++;
    $key = $msg <= 2 ? "NEW" : "MSC";
    msg2key($key,"$pcfFil COMB_BIA $yyssss0: Latest $sol final bias NEQs not found");
  }
  if ($mjdF-$mjdM > 32) {
    prtMess($bpe,"LATEST $sol FINAL BIAS NEQ INFORMATION NOT FOUND");
##    die          "LATEST $sol FINAL BIAS NEQ INFORMATION NOT FOUND";
    warn         "LATEST $sol FINAL BIAS NEQ INFORMATION NOT FOUND";
    $msg++;
    $key = $msg <= 2 ? "NEW" : "MSC";
    msg2key($key,"$pcfFil COMB_BIA $yyssss0: Latest $sol final bias NEQs not found");
  }
  $mjdL = $mjdR>$mjdF ? $mjdR : $mjdF;
  my $yydddL = gps_date("-mjd $mjdL -o %y%j");
  print "LAST: $mjdF $mjdR $mjdL $yydddL\n";
  @allDay = (@finDay,@rapDay);
  @allSet = (@oldSet,@newSet);
  print "finDay: @finDay\n\n";
  print "rapDay: @rapDay\n\n";
  print "oldSet: @oldSet\n\n";
  print "newSet: @newSet\n\n";
# Ignore bad input NEQs
  if ($sol eq "A1R") {
##    copy("${dirNeq}A1R17281.NQ0","${dirNeq}A1R17282.NQ0");
##    copy("${dirNeq}A1R17281.NQ0","${dirNeq}A1R17283.NQ0");
  }

  my @lst;
  my $PGMNAM = "ADDNEQ2";
  my ($str1,$str2);

# Set special options for test purposes
##  $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/storage/homefs/villiger/ADDOSB/EXE_G95/");
##  $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/storage/homefs/villiger/DCBS/EXE_G95/");
##  $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/storage/research/aiub_data/BSWsoftware/BERN_BIA/SOURCE/PGM/EXE_GNU/");
##  $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/storage/homefs/l_code_rap/PRN2SVN/EXE_GNU/");
##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SATELL","DCBIONO.I08");
##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SATCRUX","DCBIONO");
##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBSVN","1");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SATELL","$satInf2");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","PRT_SIG","1");

# Define list of calibrated stations and station problems
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OCB_EXST","1");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OCB_EXFIL","STA_BIA");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","STAINFO","STA_BIA");

##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OCB_ELIM","BEFORE_STACKING");

##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SINEXIN",'$(BIAINF)');

# Full solution based on final 1-day NEQs (for verification purposes)
# -------------------------------------------------------------------
  if (-e $allFlg) {
    $str1 = gps_date("-yd $yyddd0 -o %Y-%j");
    $str2 = gps_date("-yd $yydddL -o %Y-%j");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","TITLE","CODE'S ACCUMULATED BIAS SOLUTION (FROM $str1 TO $str2)");
    @lst = map { $sol.$_ } (@finDay);
    replaceSelLst($bpe,"ADDNEQ2","INPFILE",@lst);
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT","${sol}_ALL");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT","${sol}_ALL");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT","${sol}_ALL");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX","${sol}_ALL");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","AS_IS");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SINEXIN","SINEX_BIA_COD_FULL");
    $bpe->RUN_PGMS($PGMNAM);
  }

# Sliding 30-day solution based final (and rapid) on 1-day NEQs
# -------------------------------------------------------------
##  $str = substr($yydddL,0,2)."-".substr($yydddL,2,3);
##  $str = gps_date("-yd $yydddL -o %Y-%j");
  $str = gps_date("-yd $yydddL -d +1 -o %Y:%j:00000");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","TITLE","CODE'S 30-DAY BIAS SOLUTION (OBSERVED UNTIL $str)");
#  @lst = @allDay;
#  @lst = splice(@lst,-30);
  @lst = ();
  foreach $yyddd (@allDay) {
# List of problematic daily solutions to be skipped:
##    next if $sol.$yyddd eq "A1G22150";
##    next if $sol.$yyddd eq "A1R22150";
##    next if $sol.$yyddd eq "A1G22153";
##    next if $sol.$yyddd eq "A1R22153";
    push(@lst,$yyddd) if gps_date("-yd $yyddd -o %IJ") > $mjdL-30;
  }
  @lst = map { $sol.$_ } (@lst);
  replaceSelLst($bpe,"ADDNEQ2","INPFILE",@lst);

  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OCB_ELIM","NO");

  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT","${sol}_LAST_STA");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT","${sol}_LAST_STA");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT","${sol}_LAST_STA");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX","${sol}_LAST_STA");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","AS_IS");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SINEXIN","SINEX_BIA_COD_30D");
  $bpe->RUN_PGMS($PGMNAM);

  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OCB_ELIM","BEFORE_STACKING");

##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBVAL","168 00 00");

# Create new test solution (G:C1C/C2W):
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OBSSEL",'$(OBSSEL_C1C)');
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT","${sol}_LAST_C1C");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT","${sol}_LAST_C1C");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT","${sol}_LAST_C1C");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX","${sol}_LAST_C1C");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","AS_IS");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SINEXIN","SINEX_BIA_COD_30D");
  $bpe->RUN_PGMS($PGMNAM);

# Create standard solution (G:C1W/C2W):
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OBSSEL",'$(OBSSEL)');
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT","${sol}_LAST");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT","${sol}_LAST");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT","${sol}_LAST");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX","${sol}_LAST");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","AS_IS");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SINEXIN","SINEX_BIA_COD_30D");
  $bpe->RUN_PGMS($PGMNAM);

##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBVAL","00 00 00");

##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT","${sol}_LAST_");
##  $bpe->RUN_PGMS($PGMNAM);

# Time window extension of +7 days
  $fil  = $bpe->getKey("$ENV{U}/INP/ADDNEQ2.INP","DCBOUT");
  $str1 = gps_date("-mjd $mjdL -d  +1 -o 00  %Y %m %d 00 00 00");
  $str2 = gps_date("-mjd $mjdL -d  +8 -o 00  %Y %m %d 00 00 00");
  print "-$str1-$str2-\n";
  replace($fil,$str1,$str2);
  $str1 = gps_date("-mjd $mjdF -d  +1 -o 00  %Y %m %d 00 00 00");
  print "-$str1-$str2-\n";
  replace($fil,$str1,$str2);
##  $fil  = $bpe->getKey("$ENV{U}/INP/ADDNEQ2.INP","BIASSNX");
##  $str1 = gps_date("-mjd $mjdL -d  +1 -o %Y:%j:00000");
##  $str2 = gps_date("-mjd $mjdL -d  +8 -o %Y:%j:00000");
##  replace($fil,$str1,$str2);
##  $str1 = gps_date("-mjd $mjdF -d  +1 -o %Y:%j:00000");
##  replace($fil,$str1,$str2);

# Verify solution
  my ($rms,$fac,$dev,$film1,$rmsm1,$namm1);
  my $tol = 30;
  $tol = 1000;
  $tol = sprintf("%4.1f",$tol) if $tol < 100;
  my $err = 0;
  $fil = $bpe->getKey("$ENV{U}/INP/ADDNEQ2.INP","SYSOUT");
  $nam = basename($fil);
