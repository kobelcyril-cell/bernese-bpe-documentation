    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX","${sol}_REST");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","AS_IS");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SINEXIN","SINEX_BIA_COD_MONTHLY");
