package POLXTR_T;
@ISA = ("RUNBPE");
# =============================================================================
#
# Name    :  POLXTR_T
#
# Purpose :  Execute POLXTR with one input file.
#
# Author  :  S. Lutz
#
# Created :  09-Aug-2013
#
# Changes :  29-Oct-2013 SL: Use getKey for input/output file names
#            07-Aug-2019 AV: Adapted header numbers (9-->11 in pol)
#
# =============================================================================

use strict;
use warnings;

# External packages
use File::Copy qw(copy);

# Local packages
use lib "$ENV{BPE}";
use bpe_util qw(rdUltFlg gtUltVrs setUserVar);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,
    $CAMP_PTH,$CAMPAIGN,
    $dirErp,$extErp,
    $dirIep,$extIep,
    $dirLst,$extLst,
  ) =
  $bpe->getKeys(
    '$YD+0',
    'CAMP_PTH','CAMPAIGN',
    'DIR_ERP','EXT_ERP',
    'DIR_IEP','EXT_IEP',
    'DIR_LST','EXT_LST',
  );

# Set T
# -----
  my $ultFil = "${CAMP_PTH}${CAMPAIGN}/MSC/ULT${yyddd}.FLG";
  my($h_end,$h_tro,$h_rnx,$h_chr) = &rdUltFlg($ultFil);
  my $T = &gtUltVrs($h_end,$h_chr);
  &setUserVar($bpe,"T",$T);

# Run programs
# ------------
  my $PGMNAM = "POLINT";
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "POLXTR";
  $bpe->RUN_PGMS($PGMNAM);

# Merge IEP/ERP files
# -------------------
  my $inp = $bpe->getKey("$ENV{U}/INP/$PGMNAM.INP","EPFIL");
  my $rec = $bpe->getKey("$ENV{U}/INP/$PGMNAM.INP","RECORD3");
  my($add,$pol,$tmp);
  for my $typ(${extIep},${extErp}) {
    $add = substr($inp,0,length($inp)-3).$typ;
    if($typ eq ${extIep}) {
      $pol = $bpe->getKey("$ENV{U}/INP/$PGMNAM.INP","IERSPOL");
    }
    if($typ eq ${extErp}) {
      $pol = $bpe->getKey("$ENV{U}/INP/$PGMNAM.INP","POLERS");
    }
    $tmp = "$pol.tmp";
    &copy($pol,$tmp);
    my(@add,@pol) = ();
    open(IN,"<$add");
    push(@add,$_) while(<IN>);
    close(IN);
    open(IN,"<$tmp");
    push(@pol,$_) while(<IN>);
    close(IN);
    unlink($tmp);
    open(OUT,">$pol");
    print OUT $add[$_] foreach(0..$rec+6);
    print OUT $pol[$_] foreach(11..$#pol);
    close(OUT);
  }
}

# =============================================================================

__END__
