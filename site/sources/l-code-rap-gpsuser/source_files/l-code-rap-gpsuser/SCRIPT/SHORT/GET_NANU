package GET_NANU;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GET_NANU
#
# Purpose :  Download NANU files and create extra SAT CRX file
#
# Programs:
#
# Author  :  S. Schaer
# Created :  23-Sep-2003
#
# Changes :  09-Feb-2005 mm: Old date variables removed
#            11-Nov-2019 av: Skip if v_savdsk == Y
#            14-Jul-2020 RD/PF: change $X/GEN -> PTH_SATCRUX
#            25-Aug-2020 SS: Use PTH_SATCRUX and set $dirSatcrx
#                            (SAT_2020.CRX for external users not updated
#                            due to this bug!)
#            04-Nov-2021 SS: Considered NO_GET_NANU.FLG
#            18-Mar-2022 RD/AV: add strict; filter maneuver from GPSNANU.CRX
#
# ----------------------------------------------------------------------------

use strict;

sub run {
  my $bpe = shift;


# Define variables
# ----------------
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};
  my ($yyddd,$yyyy,$savdsk,$dirSatcrx) = $bpe->getKeys('$YD+0','$Y+0','V_SAVDSK','PTH_SATCRUX');

  if( $savdsk ne "Y"){
# Start get_nanu.com script
# -------------------------
    my $ultfil = "$CAMP_PTH$CAMPAIGN/MSC/ULT${yyddd}.FLG";
    my $flgfil = "$CAMP_PTH$CAMPAIGN/MSC/NO_GET_NANU.FLG";
    unless (-e $flgfil) {
      if (-s $ultfil) { system ("$ENV{AUTO}/get_nanu.com -silent") }
      else            { system ("$ENV{AUTO}/get_nanu.com") }
    } else {
      warn "$ENV{AUTO}/get_nanu.com not executed\n";
    }

# Filter manuevers from GPSNANU out
# ---------------------------------
    my $CRXINP1 = "${dirSatcrx}/GPSNANU.CRX";
    open(CRX,"<$CRXINP1");
    my @crx = ();
    while(<CRX>) {
      next if /    0         0   /;
      push @crx,$_;
    }
    close CRX;
    open(CRX,">${CRXINP1}_tmp");
    print CRX @crx;
    close CRX;


# Create IGSULTRA CRX file
# ------------------------
    my $CRXINP2 = "${dirSatcrx}/SAT_${yyyy}.CRX";
    my $CRXOUT  = "${dirSatcrx}/IGSULTRA.CRX";
    system ("$ENV{AUTO}/filmerge.pl ${CRXINP1}_tmp $CRXINP2 $CRXOUT 6");
    unlink("${CRXINP1}_tmp");

  }
}
