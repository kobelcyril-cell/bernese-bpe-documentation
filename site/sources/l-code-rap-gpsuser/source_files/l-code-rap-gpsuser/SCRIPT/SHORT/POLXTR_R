use File::Copy;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($wwwwd,$iepDir) = $bpe->getKeys('$WD+0',"DIR_IEP");


# Run program
# -----------
  my $PGMNAM = "POLXTR";
  $bpe->RUN_PGMS($PGMNAM);


# Rename resulting ERP file
# -------------------------
  my $polFil = "${iepDir}COD$wwwwd";
  move("${polFil}.IEP","${polFil}.ERP");


}
