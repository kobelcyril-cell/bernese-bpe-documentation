package FRQ_LST;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  FRQ_LST
#
# Purpose :  Create FRQ.LST and notify potential GLONASS frequency channel
#            search anomalies
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  04-Mar-2013
#
# Changes :  05-Mar-2013/ss: Shortened $lin
#            07-Mar-2013/ss: Collected RINEX reading errors
#            08-Mar-2013/ss: Send alarm in case of RINEX reading errors
#            12-Jun-2014/ss: Create FRQ.DAT for gnuplot
#            16-Jun-2014/da: Plot content of FRQ.DAT
#            28-May-2020/av: Change key for RINEX errors from STA to SYS
#            12-Dec-2023/ss: Send again alarm in case of any FRQ anomalies
#            15-Dec-2023/ss: Set $ddd
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use newFTP;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;
use File::Compare qw(compare);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yyyyssss,
      $mjd, $e, $f, $sav, $dis, $upd, $taskId,
      $dirDcb, $dirIon, $dirOut) =
    $bpe->getKeys('$YD+0', '$YYYSS+0',
                  '$JD+0', 'V_E', 'V_F', 'V_SAV', 'V_DIS', 'V_UPD', 'TASKID',
                  'DIR_DCB', 'DIR_ION', 'DIR_OUT');

# Maintain FRQ.LST
# ----------------
  if ($upd eq "Y") {
    $lst = "$PATH_DCB$CAMP_DCB/OUT/FRQ.LST";
    open(LST,">$lst");
    @lin = `cat $PATH_DCB$CAMP_DCB/OUT/FRQ[0-9][0-9][0-9][0-9][0-9].LST* | grep 'FREQ-NUM'`;
    chomp(@lin);
##    @ref = `cat $PATH_DCB$CAMP_DCB/OUT/FRQ[0-9][0-9][0-9][0-9][0-9].LST_REF | grep 'FREQ-NUM'`;
##    chomp(@ref);
##    @lin = (@ref,@lin);
    foreach $lin (@lin) {
      @ele = split(" ",$lin);
      next if $ele[3] eq "--";
      if ($ele[3] != $ele[5]) {
        $nam = basename($ele[7]);
        $nam = substr($nam,0,11)."D.Z";
        $fil = "$PATH_DATA$CAMP_DATA/ORX/$nam";
        $rec = `zcat $fil | grep 'REC '` if -s $fil;
        $rec = substr($rec,20,40);
        print LST "$lin   $rec\n";
        print     "$lin   $rec\n";
      }
    }
    close(LST);
    prtMess($bpe,"FRQ.LST UPDATED");
##    $yy = substr($yyddd,0,2);
##    $ddd = substr($yyddd,2,3);
##    $nam = "${ddd}0.${yy}O";
    $nam = "${yyyyssss}.RXO";
    $numsta = `grep $nam $lst | wc -l `+0;
##    @lin = `grep $nam $lst | cut -c2-8,20-36 | sort -u`;
    @lin = `grep $nam $lst | cut -c1-36 | sort -u`;
    chomp(@lin);
    $numano = @lin;
    print "NUM: $numano $numsta\n";
    $lin = join("/",@lin);
    $lin = join(" ",split(" ",$lin));
    print "LIN: $lin\n";
    $ddd = substr($yyddd,2,3);
    msg2key("SYS","DCBIONO: $numano GLONASS frequency channel search anomalies on day $ddd (for $numsta stations): $lin (see \$outd/FRQ.LST)") if $numano>0;
  } else {
    prtMess($bpe,"FRQ.LST NOT UPDATED");
  }

# Create FRQ.DAT for gnuplot
# --------------------------
  $dat = "$PATH_DCB$CAMP_DCB/OUT/FRQ.DAT";
  @fil = `cut -c62-73 $lst | sort -u`;
  chomp(@fil);
  open(DAT,">$dat");
  foreach $fil (@fil) {
    @lin = `grep $fil $lst | sort -u`;
    $num = @lin;
    $num = sprintf("%2d",$num);
    $prn = substr($lin[0],6,2);
    $sta = substr($lin[0],61,4);
    $rec = substr($lin[0],76,40);
    $prn = "-2" if $num > 1;
    print DAT "$fil  $prn  $num  $sta  $rec\n";
  }
  close(DAT);

# Plot FRQ.DAT
# ------------
  my %val = ();
  my $sec = 0;
  my @sec = ();
  my $inp = "$PATH_DCB$CAMP_DCB/OUT/FRQ.DAT";
  my @slotNr = ();
  my $eps = "$PATH_DCB$CAMP_DCB/OUT/FRQ.eps";
  my $broad = 2; # Number of days to broaden daily color boxes into past and future

  open DAT, '<', $inp;
  while (my $line = <DAT>) {
      $line =~ s/\A\s+//; # Remove leading whitespace
      if ($line =~ /(\w\w\w\w)(\d\d\d)0\.(\d\d)O/) {
          $sec = &gps_date("-yd $3 $2 -o %U"); # UNIX timestamp of the begining of the day
          push @sec, $sec unless (grep {$_ eq $sec} @sec);
          my @line = split(/\s+/, $line);
          $val{$1}{$sec} = $line[1];
          push @slotNr, $line[1] unless (grep {$_ eq $line[1]} @slotNr);
      }
  }
  close DAT;

  my $slotNr = join(',',sort @slotNr);

  # Write tmp file
  my $now = time;
  my $tmpFil = "$ENV{T}/plot_${now}.tmp";
  open TMP, '>', $tmpFil;
  my @stations = keys %val;
  @stations = sort @stations;
  @sec = sort {$a <=> $b} @sec;

  # Add to @sec days that show up for no station
  my @tmpSec = ();
  for (my $s=$sec[0]; $s<=$sec[-1]; $s=$s+86400) {
      push @tmpSec, $s;
  }
  @sec = @tmpSec;

  my $plotVal;

  foreach my $station (@stations) {
      my $index = (grep { $stations[$_] eq $station } 0..$#stations)[0]; # Station number
      foreach my $s (@sec) {
          $plotVal = exists ${$val{$station}}{$s} ? $val{$station}{$s} : -1;

          # Broaden daily box?
          if ($broad) {
              if ($plotVal == -1) {
                  for (my $j = 1; $j <= $broad; $j++) {
                      if (exists ${$val{$station}}{$s+$j*86400} && ${$val{$station}}{$s+$j*86400} != -1) {
                          $plotVal = ${$val{$station}}{$s+$j*86400};
                      } elsif (exists ${$val{$station}}{$s-$j*86400} && ${$val{$station}}{$s-$j*86400} != -1) {
                          $plotVal = ${$val{$station}}{$s-$j*86400};
                      }
                  }
              }
          }

          printf TMP ("%4s %3d %11d %8s\n", $station, $index, $s, $plotVal);
      }
  }
  close TMP;

  my $numSta = keys %val; # Number of stations

  # Calculate time range for gnuplot (need seconds since 2000)
  my $rStart = $sec[0] - 946684800 - 0.5*86400;
  my $rEnd = $sec[-1] - 946684800 + 0.5*86400;

  # Call gnuplot
  open my $GP, '|-', "gnuplot";
  print {$GP} <<__GNUPLOT__;

  # Plot settings
  set term postscript portrait enhanced color 8;
  set view map;
  set lmargin at screen 0.08;
  set rmargin at screen 0.85;
  set xdata time;
  set timefmt "%s";
  set format x "%Y\\n%j";
  set timestamp "Compiled: %Y-%m-%dT%H:%M:%S" 0,2;
  set grid mxtics;
  set grid xtics;
  set grid mytics;
  set grid ytics;
  set tics out;
  set cbtics in;
  set ytics font "Courier,5";
  set ytics offset 1;
  set ytics nomirror;
  set ytic scale 0;
  unset cbtics;
  set cbtics ($slotNr, "Multiple" -2, "None" -1);
  set title font "Arial Bold,16";
  set cbrange [-2:26];
  set palette defined (-2 "black",\\
                       -1.5 "black",\\
                       -1.4 "white",\\
                       -0.5 "white",\\
                       2 0 0.6 0,\\
                       8 "blue",\\
                       14 "red",\\
                       20 "gray",\\
                       26 "orange");
  set xrange [$rStart-86400:$rEnd];
  set yrange [-0.5:$numSta-0.5] reverse;
  set title "GLONASS frequency channel anomalies";
  set cblabel "GLONASS slot number";
  set cblabel offset -3;

  # Plot
  set output \"$eps\";
  splot \"$tmpFil\" u 3:2:4:yticlabel(1) w image t "";

__GNUPLOT__

  close $GP;
  unlink($tmpFil);

# Report RINEX reading errors
# ---------------------------
  my $numerr = `cat ${dirOut}../BPE/${taskId}${yyddd}?_???_???.PRT | grep 'ERROR READING RINEX' | wc -l`+0;
  if ($numerr > 0) {
    `cat ${dirOut}../BPE/${taskId}${yyddd}?_???_???.PRT | grep -A 2 'ERROR READING RINEX' >> ${dirOut}RINEX_ERR.LST`;
##    @lin = `cat $bp${dirOut}../BPE/${taskId}${yyddd}?_???_???.PRT | grep -A 2 'ERROR READING RINEX' | grep STOP | cut -c40-`;
    @lin = `cat $bp${dirOut}../BPE/${taskId}${yyddd}?_???_???.PRT | grep -A 2 'ERROR READING RINEX' | grep -v HEADER | grep : | cut -c39-`;
    chomp(@lin);
    map { $_ = basename($_) } @lin;
    $lin = join(" ",@lin);
    $lin = join(" ",split(" ",$lin));
    msg2key("STA","DCBIONO: $numerr RINEX reading errors (see \$outd/RINEX_ERR.LST): $lin") if $numerr>0;
  }

}
