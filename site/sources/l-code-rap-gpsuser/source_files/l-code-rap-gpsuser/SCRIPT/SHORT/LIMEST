#!/bin/sh
# SCRIPT-NAME
# sh script file written by bds
# -----------------------------
# functions used by shell
do_rm( ) {
    if [ "$1" ]
    then
        if [ -f `echo $1 | tr ' ' '\012' | head -1` ]
        then
            eval rm $1
        fi
    fi
}
#
toupper( ) {
    eval $1=`echo $2 | ${UPPERC}`
    eval export $1
}
#
seterr( ) {
    if [ $? = 0 ]
    then
        ERRSTAT=OK
    else
        ERRSTAT=ERR
    fi
}
#
# -----------------------------
# SHELL STARTS HERE
# -----------------------------
#
# Changes:
# 22-Aug-2001 rd: GPSEST runs new menu
# 19-Sep-2002 ss: Use predicted ionosphere information, if available
# 06-Jan-2003 hu: Pole files in ORB instead of X/GEN
# 23-Jul-2003 ss: Consider SKIP_QIF.FLG
# 08-Sep-2005/ss: Make use of geomagnetic_pole.com
# 26-May-2009 rd: LIMXTR: YY_DDD -> YY_SSSS
# 23-Oct-2014 SS: Changed path for Z11 and Z12 ION files
#
# LIMEST
# ======
#
# ESTIMATE LOCAL IONOSPHERE MAP (using V_K pole file)
# ---------------------------------------------------
#
# SHELL VARIABLES:
# ----------------
#
# YEAR    :  Year of the session to be processed (2 digit)
# SESSION :  Session number (4 characters)
# CAMPAIGN:  Campaign name
# CAMP_PTH:  Campaign path
# CAMP_DRV:  Drive letter for campain (i.e. P)
# OPT_DIR :  Directory for panels
# PID     :  Process identification number (3 digits)
# SUB_PID :  Subprocess id (3 digits)
# PRT_FILE:  Protocol file name including path
# SCRIPT  :  Name of script
# TASKID  :  Task id of script, usually 00
# PRIORITY:  Priority of the script
# CPU     :  CPU the script is running on
# DAYYEAR :  Julian day of the year
# DAY     :  Day of the Month
# MONTH   :  Month, 1=JAN, 12=DEC
# GPSWEEK :  GPS week
# DAYWEEK :  Day of the week, 0=SUN, 6=SAT
# V_X     :  X Variable in DAT151__.PAN
# V_O     :  O Variable in DAT151__.PAN
# V_Z     :  Z Variable in DAT151__.PAN
# V_PLUS  :  Plus variable in DAT151__.PAN
# V_MINUS :  Minus variable in DAT151__.PAN
# V_x     :  User variable
# PARAMx  :  Script specific parameter, x is 1 thru 9
# U       :  Directory path to U:
#
# Use the new menu
TSTMENU="TRUE"
export TSTMENU
#
# See if this shell is being run from the PCS
# script, or directly for testing.  If testing,
# no the header script is not passed in as %1%
#
if [ "$1" = "" ]
then
#
#   set variables for testing here
#
    TEST_START_DIR=`pwd`
    cd $U/WORK
    TESTING="YES"
    export TESTING
else
    TESTING="NO"
    export TESTING
    . "$1"
    seterr
fi
#
# START THE MENU SYSTEM IN NON-INTERACTIVE MODE
# ---------------------------------------------
. $X/SCRIPT/BEG_MENU
seterr
#
# SET VARIABLES IN DAT151__.PAN
# -----------------------------
. $X/SCRIPT/SET_SESS
seterr
#
# SHELL BODY
# ----------
FLGFIL=""$CAMP_PTH""$CAMPAIGN"/MSC/SKIP_QIF.FLG"
export FLGFIL
SKIP="NO"
export SKIP
if [ -f `echo $FLGFIL | tr ' ' '\012' | head -1` ]
then
    SKIP="YES"
    export SKIP
fi
if [ "$V_BL_QIF" = "0" ]
then
    SKIP="YES"
    export SKIP
fi
#
if [ "$SKIP" = "YES" ]
then
    $X/SCRIPT/PRT_MESS "$PRT_FILE" MSG "$SCRIPT" QIF_SKIPPED
    seterr
else
#
#   Check whether predicted ionosphere information available
#   --------------------------------------------------------
    INPION1=""$CAMP_PTH""$CAMPAIGN"/ATM/RM_"$YEAR""$DAYYEAR".ION"
    export INPION1
    INPION2=""$CAMP_PTH""$CAMPAIGN"/ATM/RA_"$YEAR""$DAYYEAR".ION"
    export INPION2
    INPION3=""$CAMP_PTH""$CAMPAIGN"/ATM/RZ_"$YEAR""$DAYYEAR".ION"
    export INPION3
    INPION4=""$PATH_DCB""$CAMP_DCB"/ATM/Z11"$YEAR""$DAYYEAR".ION_"
    export INPION4
    INPION5=""$PATH_DCB""$CAMP_DCB"/ATM/Z12"$YEAR""$DAYYEAR".ION_"
    export INPION5
    OUTION=""$CAMP_PTH""$CAMPAIGN"/ATM/"$V_K"N"$YEAR""$DAYYEAR".ION"
    export OUTION
#
    INPION=""NO""
    export INPION
    if [ -f `echo $INPION5 | tr ' ' '\012' | head -1` ]
    then
        INPION=""$INPION5""
        export INPION
    fi
    if [ -f `echo $INPION4 | tr ' ' '\012' | head -1` ]
    then
        INPION=""$INPION4""
        export INPION
    fi
    if [ -f `echo $INPION3 | tr ' ' '\012' | head -1` ]
    then
        INPION=""$INPION3""
        export INPION
    fi
    if [ -f `echo $INPION2 | tr ' ' '\012' | head -1` ]
    then
        INPION=""$INPION2""
        export INPION
    fi
    if [ -f `echo $INPION1 | tr ' ' '\012' | head -1` ]
    then
        INPION=""$INPION1""
        export INPION
    fi
#
    if [ "$INPION" != "NO" ]
    then
        $X/SCRIPT/PRT_MESS "$PRT_FILE" MSG "$SCRIPT" "$INPION"_USED
        seterr
#
        cp "$INPION" "$OUTION"
    else
        $X/SCRIPT/PRT_MESS "$PRT_FILE" MSG "$SCRIPT" PREDICTED_ION_INFO_UNAVAILABLE
        seterr
#
#       Copy pole file
#       --------------
        cp "$CAMP_PTH""$CAMPAIGN"/ORB/"$V_K"_"$YEAR""$DAYYEAR".ERP "$CAMP_PTH""$CAMPAIGN"/ORB/GIR"$YEAR""$DAYYEAR".ERP
#
#       Set lat and lon of geomagnetic pole
#       -----------------------------------
        ${AUTO}/geomagnetic_pole.com "$YEAR" -lat > POLE.TMP
        seterr
        LATPOL=`cat POLE.TMP`
        export LATPOL
        ${AUTO}/geomagnetic_pole.com "$YEAR" -lon > POLE.TMP
        seterr
        LONPOL=`cat POLE.TMP`
        export LONPOL
#
        ${EXE}/NPUTKEY $U/PAN/GPSEST.INP LATPOL "$LATPOL"
        seterr
        ${EXE}/NPUTKEY $U/PAN/GPSEST.INP LONPOL "$LONPOL"
        seterr
#
#       Run the program
#       ---------------
        PGMNAM="GPSEST"
        export PGMNAM
        . $X/SCRIPT/RUN_PGMS
        seterr
#
#       Check the program
#       -----------------
        PGMNAM="GPSXTR"
        export PGMNAM
        . $X/SCRIPT/RUN_PGMS
        seterr
#
#       Summary of program run for Protocol
#       -----------------------------------
        XTRSUM=""$CAMP_PTH""$CAMPAIGN"/OUT/LIMXTR."$YEAR"_"$SESSION""
        export XTRSUM
        cp "$CAMP_PTH""$CAMPAIGN"/OUT/LIMXTR.SUM "$XTRSUM"
#
    fi
#
fi
#
# --------------
# end the script
# --------------
. $X/SCRIPT/END_MENU
seterr
if [ "$TESTING" = "YES" ]
then
    cd "$TEST_START_DIR"
else
    . $X/SCRIPT/DO_TAIL
    seterr
fi
