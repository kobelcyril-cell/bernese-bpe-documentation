package WAIT_ION;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  WAIT_BIA
#
# Purpose :  Wait for rapid BIA file (from RCLKGNSS RAP_BIA process)
#
# PARAMs  :  PARAM1 - Optional waiting time (default: 60 sec)
#
# Author  :  S. Schaer
# Created :  01-Oct-2019
#
# Changes :  01-Oct-2019/ss: Derived from WAIT_ION
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yyyy, $param1) = $bpe->getKeys('$YD+0', '$Y+0', 'PARAM1');

# Set default waiting time
# ------------------------
  $param1 = 60 if $param1 eq "";

# Perform waiting loop
# --------------------
  my $biaFil = "$PATH_SAV$CAMP_SAVRAPCLK/$yyyy/SOL/A1R${yyddd}0.NQ0.gz";
  my $addFil = "$PATH_SAV$CAMP_SAVRAPCLK/$yyyy/SOL/A1G${yyddd}0.NQ0.gz";
  print "$biaFil\n$addFil\n";

  $wait = 0;
  $cont = 0;
  while ($cont==0) {
    if (-s $biaFil && -s $addFil) {
      prtMess($bpe,"CONTINUING") unless $wait==0;
      $cont++ }
    else {
      prtMess($bpe,"WAITING FOR ".basename($biaFil));
      sleep($param1);
      $wait++ }
    if ($wait>=21600/$param1) {
      prtMess($bpe,"WAITING LOOP EXITED DUE TO UNAVAILABILITY OF ".basename($biaFil));
      warn "WAITING LOOP EXITED DUE TO UNAVAILABILITY OF ".basename($biaFil)."\n";
      $cont++;
    }
  }

}
