package GPSEST_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GPSEST_P
#
# Purpose :  Parallel run for parameter estimation and NEQ-file generation
#
# Programs:  GPSEST
#
# Author  :  M. Meindl
# Created :  30-Jul-2003               Last modified: 10-Feb-2005
#
# Changes :  10-Feb-2005 mm: Old date variables removed
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use File::Copy;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($ssss , $ddd , $param1 , $subPid ,  $pid, $numFil, $numClu,
      $dirOut, $extOut ) =
  $bpe->getKeys
     ('$S+0', '$+0', 'PARAM1', 'SUB_PID', 'PID', 'V_CLU', 'V_NCLU',
     'DIR_OUT','EXT_OUT');

# Set cluster number and input files
# ----------------------------------
  my $cluster = $numFil eq "" && $numClu eq "" ? "$ddd$param1" : "$ssss$subPid";
  my $ffff    = $numFil eq "" && $numClu eq "" ? $param1       : "____";

  print "EXECUTABLE: $ENV{XG}\n";
  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$ffff,"CCC",$subPid);

  if ($numClu eq "" && $numFil eq "") {
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PSFILES","$param1$ssss") }
  else {
    replaceSel($bpe,"GPSEST","PSFILES",$param1) }

# Run program
# -----------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);


# Copy output to scratch disk
# ---------------------------
  copy("${dirOut}EST${cluster}.${extOut}",
       "$ENV{T}/EST${ssss}${subPid}.$pid");


# Delete BPE file
# ---------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;
  unlink($param1);

}
