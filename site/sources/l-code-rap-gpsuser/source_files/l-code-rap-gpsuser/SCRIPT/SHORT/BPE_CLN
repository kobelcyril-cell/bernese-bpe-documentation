package BPE_CLN;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  BPE_CLN
#
# Purpose :  Clean BPE subdirectory
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  16-Feb-2004
#
# Changes :  08-Jul-2005/ss: m90 variables added
#
# ============================================================================

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssssm15, $yyssssm90, $ssssm15, $ssssm90, $taskId,
      $dirBpePrt, $extBpePrt,
      $dirBpeLog, $extBpeLog) =
    $bpe->getKeys('$YSS-(15)', '$YSS-(90)', '$S-(15)', '$S-(90)', 'TASKID',
                  'DIR_BPEPRT', 'EXT_BPEPRT',
                  'DIR_BPELOG', 'EXT_BPELOG');

# Delete PRT/LOG and BPE files
# ----------------------------
  $taskId = "??";
  my @delLst = ("${dirBpePrt}${taskId}${yyssssm15}_???_???.${extBpePrt}",
                "${dirBpePrt}${taskId}${yyssssm90}_???_???.${extBpePrt}",
                "${dirBpeLog}${taskId}${yyssssm15}_???_???.${extBpeLog}",
                "${dirBpeLog}${taskId}${yyssssm90}_???_???.${extBpeLog}",
                "${dirBpePrt}???${ssssm15}???.BPE",
                "${dirBpePrt}???${ssssm90}???.BPE");

  foreach (@delLst) { unlink(glob($_)) }

}
