package RCLK_COP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RCLK_COP
#
# Purpose :  Copy required files for CLKRAPID.PCF
#
# PARAMs  :
#
# Author  :  R. Dach
# Created :  13-May-2009
#
# Changes :  26-May-2009 rd: Introduce reprocessing mode
#            31-May-2012 RD: No datapool statistics
#            02-Sep-2012 SL: Get CRX2RNX from $PATH
#            09-Oct-2012 SS: Get STAINF variable
#            30-Sep-2014 LP: Change GPS=>G for $gnss
#            17-Mar-2015 AV: Add -min option to get_obsdata.com
#            07-Apr-2016 AV: Remove LPGS until further notice
#            13-Apr-2016 AS: Removed exlcusion of LPGS station
#            22-Apr-2016 AV: Remove LPGS until further notice
#            18-May-2016 SS/AV: Create APRyyssss.OSB
#            15-Jul-2016 AV: Delete IFB summary file
#            21-Sep-2016 AV: Use V_PSDINF in copyRef statement
#            05-Jun-2018 SS: Use A1R_yymm.OSB in REPRO mode
#            15-Jun-2018 SS: Remove UNTR until further notice
#            27-Jun-2018 SS: Remove GLSV until further notice
#            16-Sep-2019 AV: Replace put_data.com with put_igsdata.com
#                            Use RINEX3 data
#            07-Jun-2020 ST: Remove CEDU1580.20O
#            14-Jul-2020 RD/PF: change $X/GEN -> PTH_SATCRUX, PTH_OBSSEL
#            21-Oct-2020 AV: Remove MDO12940.20O
#            05-Nov-2020 AV: Copy CODE.OSB to REF$YSS+01.OSB without GLONASS
#                            satellite OSBs
#            13-Aug-2021 RD: Start using BSW-style filenameing in the campaign area
#            29-Mar-2022 AV: Use copySkl
#            24-Aug-2023 SS: Excluded G28 for MJD=60179;
#                            re-used _CLKyyssss.CRX, if available
#
# ============================================================================
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use sta_util;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yy, $ssss, $ddd, $mjd, $yyyy, $yyssss, $yyddd, $yymm,
      $crdInf, $psdInf, $staInf, $gnss,  $camp_pth,$campaign,$param1,$v_c,
      $dirCrd, $dirRxo, $dirRxn, $dirOsb, $dirOut, $dirSum, $dirSatcrx, $dirObssel,
      $extCrd, $extRxo, $extRxn, $extOsb,          $extSum, $extSatcrx,
      $pthSkl
      ) =
    $bpe->getKeys(
      '$Y','$S+0','$+0','$JD+0','$Y+0','$YSS+0','$YD+0','$M+0',
      'V_CRDINF','V_PSDINF','V_STAINF','V_GNSS','CAMP_PTH','CAMPAIGN','PARAM1','V_C',
      'DIR_CRD','DIR_RXO','DIR_RXN','DIR_OSB','DIR_OUT','DIR_SUM','PTH_SATCRUX','PTH_OBSSEL',
      'EXT_CRD','EXT_RXO','EXT_RXN','EXT_OSB',          'EXT_SUM','EXT_SATCRUX',
      'PTH_SINEXIN'
      );

# Reprocessing?
# -------------
  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");

# Prepare reference files
# -----------------------
  my $psdFil = $psdInf eq ""? "" : "${psdInf}.PSD";
  system("$ENV{AUTO}/copyRef.pl ${dirCrd}.. $crdInf $psdFil");

  print "Execute $ENV{AUTO}/copySkl.pl RCKGNSS $pthSkl\n";
  system("$ENV{AUTO}/copySkl.pl RCLKGNSS $pthSkl");

  my $inpFil = "${dirSatcrx}/SAT_${yyyy}.${extSatcrx}";
  my $outFil = "${dirSatcrx}/CLK${yyssss}.${extSatcrx}";
  copyfile($inpFil,$outFil);
  replace($outFil,'   28         3         2       2023 08 22 00 00 00  2023 08 22 23 59 59',
                  '   28         3         2       2023 08 22 00 00 00  2023 08 23 23 59 59') if $mjd==60179;
  $inpFil = "${dirSatcrx}/_CLK${yyssss}.${extSatcrx}";
  copyfile($inpFil,$outFil) if -e $inpFil;

  copyfile("${dirOsb}CODE.${extOsb}","${dirOsb}APR${yyssss}.${extOsb}");
  if ($repro) {
##   my $dcb_arch = "$ENV{PATH_SAV}$ENV{CAMP_SAVIGS}/$yyyy/ORB/P1C1$yymm.DCB";
##    print "$dcb_arch\n";
##    copyfile($dcb_arch,"${dirOsb}P1C1.DCB") if (-e $dcb_arch);
    my $dcb_arch = "$ENV{PATH_DCB}$ENV{CAMP_DCB}/ORB/A1R_$yymm.OSB";
    print "$dcb_arch\n";
    copyfile($dcb_arch,"${dirOsb}APR${yyssss}.${extOsb}") if (-e $dcb_arch);
  }

# Remove GLONASS satellite OSBs from APR OSBs
# -------------------------------------------
  my $refosb = "${dirOsb}REF${yyssss}.${extOsb}";
  my $aprosb = "${dirOsb}APR${yyssss}.${extOsb}";
  open INP, "< $aprosb";
  open OUT, "> $refosb";
  foreach (<INP>){
    next if(/^OSB  R...  R..    /);
    print OUT $_;
  }
  close INP;
  close OUT;


# Check for daily RINEX archives
# ------------------------------
  my $tarFil = "$ENV{PATH_DATA}/$ENV{CAMP_DATA}/ORX/${yyyy}/RIN${yyddd}.tar";
  my $tmpOrx = "$camp_pth$campaign/TMP${yyddd}/ORX";
  if (-s $tarFil) {
    File::Path::mkpath $tmpOrx;
    system ("cd $tmpOrx; tar -xvf $tarFil");
    $ENV{PATH_DATA} = "$camp_pth$campaign/";
    $ENV{CAMP_DATA} = "TMP${yyddd}/";
  } else {
    $tarFil = "";
  }

# Prepare daily RINEX data
# ------------------------
  unlink glob "${dirOut}*.${yy}_${ssss}";
  unlink glob "${dirRxo}????${ssss}.${extRxo}";
  unlink glob "${dirRxn}????${ssss}.${extRxn}";
  unlink "${dirSum}${v_c}S${yyssss}_.${extSum}";

#  system("$ENV{AUTO}/get_obsdata.com -d=$ddd -nostat") unless $repro;  # Repeat FTP
#  system("$ENV{AUTO}/get_obsdata.com $ddd -t=daily -m=IGS -nt=4 -min=5 -nostat") unless $repro;  # Repeat FTP
#  system("$ENV{AUTO}/put_data.com $yy $ssss %CLK $dirRxo -r");
  system("$ENV{AUTO}/put_igsdata.com $yy $ssss -o $dirRxo \"-or %CLK %MGEX\" -r --bsw");
  if ($gnss ne "G" && uc $param1 eq "DENSIFY") {
    my $orxDir = "$ENV{PATH_DATA}/$ENV{CAMP_DATA}/ORX/";
    my $crdFil = "$ENV{REF}/${crdInf}.CRD";
    my $abbFil = "$ENV{REF}/CODE.ABB";
    my $staFil = "$ENV{REF}/${staInf}.STA";
    my $recFil = "${dirObssel}/RECEIVER.";
    my $selFil = "$ENV{REF}/CODE_STA.SEL";
    initStaLst(crd=>$crdFil, abb=>$abbFil, sta=>$staFil, rec=>$recFil);
    my @staList = selSta("$selFil","%002");
    push @staList,selSta("$selFil","%003");
    foreach my $sta ( @staList ) {
      my @xyz = getXYZ( $sta );
      next if ( $xyz[0] == -1 && $xyz[1] == -1 && $xyz[2] == -1);
      if ( uc getSYS( $sta,$mjd ) =~ /R/ ) {
        my $crxFil = "$orxDir/${sta}${ssss}.${yy}D.Z";
        my $rnxFil = "$dirRxo/${sta}${ssss}.${yy}O";
        if ( -s "$crxFil" && ! -s $rnxFil ) {
          system "zcat $crxFil | CRX2RNX > $rnxFil";
        }
      }
    }
    unlink "$dirRxo/VESL${ssss}.${yy}O";
    unlink "$dirRxo/SPT0${ssss}.${yy}O";
    unlink "$dirRxo/BAKO${ssss}.${yy}O";
    unlink "$dirRxo/ADIS${ssss}.${yy}O";
    unlink "$dirRxo/UNTR${ssss}.${yy}O";
    unlink "$dirRxo/GLSV${ssss}.${yy}O";
    unlink "$dirRxo/LHAZ0990.10O";
    unlink "$dirRxo/LHAZ1000.10O";
    unlink "$dirRxo/LHAZ1010.10O";
    unlink "$dirRxo/LHAZ1020.10O";
    unlink "$dirRxo/LHAZ1110.10O";
    unlink "$dirRxo/MTKA0260.10O";
  }
  system("$ENV{AUTO}/put_igsdata.com $yy $ddd -n $dirRxo");

  system("$ENV{AUTO}/rinex.com $dirRxo $ddd $yy");

# Do not use AMUN
# ---------------
  unlink glob "${dirRxo}AMU?${ssss}.${extRxo}";
  unlink glob "${dirRxo}HYDE${ssss}.${extRxo}";
  unlink "$dirRxo/ANKR1810.15O";
  unlink "$dirRxo/GODE1810.15O";
  unlink "$dirRxo/RBAY1810.15O";
  unlink "$dirRxo/MEDI2510.15O";
  unlink "$dirRxo/MAL22920.15O";  # Wrong epochs (RCLKGNSS bigfail CLKEST)
  unlink "$dirRxo/MIZU0190.16O";
  unlink "$dirRxo/PRDS0640.16O";
  unlink "$dirRxo/PRDS0680.16O";
  unlink "$dirRxo/KIT30820.16O";
  unlink "$dirRxo/BOGT0820.16O";
  unlink "$dirRxo/BOGT0830.16O";
  unlink "$dirRxo/KIT30830.16O";
  unlink "$dirRxo/LPGS${ssss}.16O";
  unlink "$dirRxo/ALGO1200.16O";
  unlink "$dirRxo/PRDS1200.16O";
  unlink "$dirRxo/ALGO1210.16O";
  unlink "$dirRxo/PRDS1210.16O";
  unlink "$dirRxo/JOZE1600.16O";
  unlink "$dirRxo/MEDI1600.16O";
  unlink "$dirRxo/NOT11600.16O";
  unlink "$dirRxo/JOZE1610.16O";
  unlink "$dirRxo/MEDI1610.16O";
  unlink "$dirRxo/NOT11610.16O";
  unlink "$dirRxo/PENC1610.16O";
  unlink "$dirRxo/HYDE1620.16O";
  unlink "$dirRxo/JOZE1620.16O";
  unlink "$dirRxo/MEDI1620.16O";
  unlink "$dirRxo/NOT11620.16O";
  unlink "$dirRxo/JOZE1630.16O";
  unlink "$dirRxo/MEDI1630.16O";
  unlink "$dirRxo/NOT11630.16O";
  unlink "$dirRxo/JOZE1640.16O";
  unlink "$dirRxo/MEDI1640.16O";
  unlink "$dirRxo/NOT11640.16O";
  unlink "$dirRxo/HYDE1650.16O";
  unlink "$dirRxo/JOZE1650.16O";
  unlink "$dirRxo/MEDI1650.16O";
  unlink "$dirRxo/NOT11650.16O";
  unlink "$dirRxo/JOZE1660.16O";
  unlink "$dirRxo/MEDI1660.16O";
  unlink "$dirRxo/NOT11660.16O";
  unlink "$dirRxo/JOZE1670.16O";
  unlink "$dirRxo/MEDI1670.16O";
  unlink "$dirRxo/NOT11670.16O";
  unlink "$dirRxo/JOZE1680.16O";
  unlink "$dirRxo/MEDI1680.16O";
  unlink "$dirRxo/NOT11680.16O";
  unlink "$dirRxo/OHI21690.16O";
  unlink "$dirRxo/ALGO1700.16O";
  unlink "$dirRxo/HYDE3110.16O";
  unlink "$dirRxo/HYDE3120.16O";
  unlink "$dirRxo/MDVJ0580.17O";
  unlink "$dirRxo/POTS0580.17O";
  unlink "$dirRxo/BRAZ1020.17O";
  unlink "$dirRxo/SCH20020.18O";
  unlink "$dirRxo/LAMA2520.18O";
  unlink "$dirRxo/LAMA2530.18O";
  unlink "$dirRxo/TID12530.18O";
  unlink "$dirRxo/TIDB2530.18O";
  unlink "$dirRxo/LAMA2540.18O";
  unlink "$dirRxo/LAMA2550.18O";
  unlink "$dirRxo/LAMA2560.18O";
  unlink "$dirRxo/LAMA0090.19O";
  unlink "$dirRxo/LAMA0100.19O";
  unlink "$dirRxo/LAMA0110.19O";
  unlink "$dirRxo/LAMA0120.19O";
  unlink "$dirRxo/COCO2920.19O";
  unlink "$dirRxo/SGOC1350.20O";
  unlink "$dirRxo/STJO1350.20O";
  unlink "$dirRxo/CEDU1580.20O";
  unlink "$dirRxo/HERS2640.20O";
  unlink "$dirRxo/SYOG2640.20O";
  unlink "$dirRxo/MDO12940.20O"; # Unknown reason (vTPv neg)
  unlink "$dirRxo/CEDU2580.21O";
  unlink "$dirRxo/CEDU00AUS_20212580.RXO";
##  unlink "$dirRxo/DYNG00GRC_20233630.RXO";
##  unlink "$dirRxo/CEDU00AUS_20220460.RXO";

# Unlink the temporary database in case of a tar archive
# ------------------------------------------------------
  if ($tarFil ne "") {
    unlink glob("$tmpOrx/*");
    chdir $ENV{PATH_DATA};
    rmdir "TMP${yyddd}";
  }
}
