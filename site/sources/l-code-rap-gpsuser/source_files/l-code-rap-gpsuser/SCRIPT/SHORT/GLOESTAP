package GLOESTAP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GLOESTAP
#
# Purpose :  Prepare parallel GPSEST run using MKCLUS for clustering
#
# Programs:  MKCLUS
#
# Author  :  R. Dach
# Created :  17-Nov-2005
#
# Changes :  19-May-2009 rd: Session dependent parallelization filenames
#            26-May-2009 rd: RESCHK: YY_DDD -> YY_SSSS
#            03-Oct-2014 lp: New GNSS selection using setGNSS
#            07-Jun-2016 RD: Add version with compatible attitude modelling
#
# ----------------------------------------------------------------------------

use strict;
use lib "$ENV{AUTO}";
use gpsutil;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yy,$ddd,$ssss,$yyssss,
      $sol, $param2, $param3, $nSta, $camp_pth,$campaign,
      $dirNeq,  $dirOut,  $dirRes,  $dirClk,  $dirClb, $dirDel,
      $extNeq,  $extOut,  $extRes,  $extClk,  $extClb, $extDel ) =
     $bpe->getKeys(
      '$Y','$+0','$S+0','$YD+0',
      "$$bpe{PARAM2}",'PARAM2','PARAM3','V_NSTA','CAMP_PTH','CAMPAIGN',
      'DIR_NEQ','DIR_OUT','DIR_RES','DIR_RXC','DIR_CLB','DIR_DEL',
      'EXT_NEQ','EXT_OUT','EXT_RES','EXT_RXC','EXT_CLB','EXT_DEL');

  my $clbnam = "${yyssss}";

# Put all GLONASS in one cluster?
# -------------------------------
  my $glo1clu = (-e "$camp_pth$campaign/MSC/GLO_ONE_CLUST.FLG");

# Remove old solution files
# -------------------------
  if ( $sol ne "" && $param2 =~ /^V_/ ) {
    unlink glob("${dirNeq}${sol}${ssss}*.${extNeq}");
    unlink glob("${dirOut}${sol}${ssss}*.${extOut}");
    unlink glob("${dirRes}${sol}${ssss}*.${extRes}");
    unlink glob("${dirClk}${sol}${ssss}*.${extClk}");

    $clbnam = "${sol}${ssss}";
  }

  unlink glob("${dirClb}${clbnam}*.${extClb}");


# Use MKCLUS to built the clusters
# --------------------------------
  $bpe->putKey("$ENV{U}/PAN/MKCLUS.INP","MAXSTA_ZG","$nSta");
  my $satsys = $glo1clu ? "G" : "ALL";
  &setGNSS($bpe,"$ENV{U}/PAN/MKCLUS.INP","USE_",$satsys);
  $bpe->putKey("$ENV{U}/PAN/MKCLUS.INP","SELBSL","${clbnam}");

  if ($param3 eq "DELETE") {
    $bpe->putKey("$ENV{U}/PAN/MKCLUS.INP","NOTUSE","DEL$yyssss");
    unlink("${dirDel}DEL${yyssss}.{extDel}");
  }

  my $PGMNAM = "MKCLUS";
  $bpe->RUN_PGMS($PGMNAM);


# Add SYSOUT to summary
# ---------------------
  if ( $param3 eq "PROTOCOL" ) {
    my $xtrsum = "${dirOut}RESCHK.${yy}_${ssss}";
    appFile("",0,$$bpe{SYSOUT},$xtrsum);
  }


# Remove bad stations
# -------------------
  if ( $param3 eq "DELETE" ) {
    my $del = $bpe->getKey("$ENV{U}/INP/MKCLUS.INP","NOTUSE");
    open (DEL,"< $del");
    while (<DEL>) {
      chomp;
      while ( /^ / ) { s/^ // }  # Remove leading blanks
      unlink ($_);
      prtMess($bpe,"$_ deleted")
    }
    close(DEL);
    unlink($del);

  }


# Built the GLONASS cluster
# -------------------------
  if ($glo1clu) {
    $bpe->putKey("$ENV{U}/PAN/MKCLUS.INP","NUMCLU_ZG","1");
    &setGNSS($bpe,"$ENV{U}/PAN/MKCLUS.INP","USE_","R");
    my $clbglo = "GLO${ssss}";
    $bpe->putKey("$ENV{U}/PAN/MKCLUS.INP","SELBSL","${clbglo}");
    $bpe->putKey("$ENV{U}/PAN/MKCLUS.INP","CORESITE","");

    my $PGMNAM = "MKCLUS";
    $bpe->RUN_PGMS($PGMNAM);

    movefile("${dirClb}${clbglo}01.${extClb}",
             "${dirClb}${clbnam}00.${extClb}");
  }


# Put the BPE cluster files into the list
# ---------------------------------------
  initPar_Fl($bpe,glob("${dirClb}${clbnam}*.${extClb}"));


}
