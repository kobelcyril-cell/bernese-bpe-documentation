package IGSR_INI;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  IGSR_INI
#
# Purpose :  Perform extra initialization procedures
#
# Programs:
#
# Author  :  S. Schaer
# Created :  03-Oct-2014
#
# Changes :  02-Sep-2015 SS: Call repositioning.com w/o -auto
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Define variables
# ----------------
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};
  my ($yyddd)  = $bpe->getKeys('$YD+0');

  my $ultFlg = "$CAMP_PTH${CAMPAIGN}/MSC/ULT$yyddd.FLG";

# Prepare SAT_INI if indicated (in RAP mode only)
# -----------------------------------------------
  system("$ENV{AUTO}/repositioning.com") unless -e $ultFlg;

}
