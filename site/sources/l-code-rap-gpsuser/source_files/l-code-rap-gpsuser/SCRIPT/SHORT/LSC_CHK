package LSC_CHK;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  LSC_CHK
#
# Purpose :  Linearity of satellite clocks (LSC) for CLKEST clock alignment:
#            Check satellite clock characteristics and decide whether poorly
#            behaving satellite shall be excluded from a priori information.
#
# Programs:
#
# Author  :  S. Schaer
# Created :  02-Oct-2020
#
# Changes :  06-Oct-2020 ss: Considerably refined
#            07-Oct-2020 ss: Create GNSS statistics
#            07-Oct-2020 ss: Update MSC/LSC_CHK.LST
#            08-Sep-2021 ss: Check number of conspicuous satellites
#            22-Feb-2022 ss: Force panic mode if necessary
#            22-Feb-2024 ss: Dealing with format overflow concerning $sig
#
# ----------------------------------------------------------------------------
use strict;
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $v_a, $pcfFil, $CAMP_PTH, $CAMPAIGN, $param2, $dirOut, $dirSig, $dirClk) =
    $bpe->getKeys('$YSS+0','V_A','PCFFIL','CAMP_PTH','CAMPAIGN','PARAM2','DIR_OUT','DIR_SIG','DIR_CLK');

  $pcfFil = (split('\.',$pcfFil))[0];

# Run program
# -----------
  my $PGMNAM = "CCRNXC";
  $bpe->RUN_PGMS($PGMNAM);

  my $SYSOUT = $$bpe{SYSOUT};

# Check resulting sigma values
# ----------------------------
  my $sigFil = "$dirSig/LSC${yyssss}.SIG";
  my $clkFil = "$dirClk/${v_a}_${yyssss}.CLK";
  my $lstFil = "$dirOut/LSC${yyssss}.LST";
  unlink($lstFil);
  my $chkFil = "$dirOut/../MSC/LSC_CHK.LST";

  my @clkInf = `grep '^[A-Z][0-9][0-9] ' $sigFil`;
  chomp(@clkInf);

# Set tolerance in units of us
# ----------------------------
  my $sigTol = 0.01;

# Check number of conspicuous satellites and stop if indicated
# ------------------------------------------------------------
  my $numBad = 0;
  my $numTol = 0;
  my $badGuy = "";
  foreach (@clkInf) {
    if ((split(" ",$_))[1] > $sigTol || substr((split(" ",$_))[1],0,1) eq "*") {
      prtMess($bpe,"Declined PRN: $_");
      print "Declined PRN: $_\n";
      $numBad++;
    } else {
      prtMess($bpe,"Accepted PRN: $_");
      print "Accepted PRN: $_\n";
      $numTol++;
    }
  }
  if ($numTol == 1) {
    prtMess($bpe,"Bad guy? $badGuy");
    print        "Bad guy? $badGuy\n";
  }
  if ($numBad > 5) {
    prtMess($bpe,"Number of conspicuous satellites too big: $numBad");
    die          "Number of conspicuous satellites too big: $numBad\n";
  }

# Remove satellites with insufficient clock linearity from a priori information
# -----------------------------------------------------------------------------
  my $prnMin = "   ";
  my $sigMin = 9999;
  my $prnMax = "   ";
  my $sigMax = 0;
  my $chkLst = "";
  my $prnLst = "";
  foreach (@clkInf) {
    my $prn = (split(" ",$_))[0];
    my $sig = (split(" ",$_))[1];
    my $prnTmp = $prn;
    $prnTmp =~ s/^G/ /;
    $prnTmp =~ s/^R/1/;
    $prnTmp =~ s/^E/2/;
    $prnTmp =~ s/^S/3/;
    $prnTmp =~ s/^C/4/;
    $prnTmp =~ s/^J/5/;
    substr($prnTmp,0,2) = "  " if substr($prnTmp,0,2) eq " 0";
    my $num = `grep '^$prnTmp' $clkFil | wc -l`+0;
    print "Checked $prn $sig $prnTmp $num\n";
    if ($sig > $sigTol || substr($sig,0,1) eq "*") {
      if ($num > 0) {
        $chkLst .= " ".$prn." (".$sig." us)";
        `grep -v '^$prnTmp' $clkFil > ${clkFil}_TMP`;
        move("${clkFil}_TMP",$clkFil);
        prtMess($bpe,"Removed satellite $prn with $sig us");
      } else {
        prtMess($bpe,"Checked satellite $prn with $sig us");
      }
# Update OUT/LSCyyssss.LST
      `echo '$_' >> $lstFil`;
# Update MSC/LSC_CHK.LST
      my $msg = "$yyssss: $_";
      `echo '$msg' >> $chkFil`;
    } else {
      if ($sig < $sigMin) {
        $prnMin = $prn;
        $sigMin = $sig;
      }
      if ($sig > $sigMax) {
        $prnMax = $prn;
        $sigMax = $sig;
      }
    }
    $prnLst .= " ".$prn;
  }
# Provide some statistics
  prtMess($bpe,"Minimal sigma $sigMin us for satellite $prnMin");
  prtMess($bpe,"Maximal sigma $sigMax us for satellite $prnMax");

# Force panic mode if necessary
  if ($yyssss eq "999990") {
##  if ($yyssss eq "220460") {
##  if ($yyssss eq "240520") {
    `grep -v '^[12]' $clkFil > ${clkFil}_TMP`;
    move("${clkFil}_TMP",$clkFil);
    prtMess($bpe,"Removed RE satellite clock information from BRD_${yyssss}.CLK");
  }

# Check whether CLKEST repetition needed
# --------------------------------------
  if ($chkLst ne "" && $param2) {
    prtMess($bpe,"$pcfFil LSC_CHK $yyssss$chkLst removed from ${v_a}_${yyssss}.CLK for CLKEST repetition");
    msg2key("BPE","$pcfFil LSC_CHK $yyssss$chkLst removed from ${v_a}_${yyssss}.CLK for CLKEST repetition");
    $bpe->prtGoto($param2);
  } else {

# Count involved satellites and create GNSS statistics
# ----------------------------------------------------
    my @sys = ("G","R","E","C","J");
    my %numSat;
    map { $numSat{$_} = 0 } @sys;
    map { $numSat{substr($_,0,1)}++ } @clkInf;

    my $strTot = "";
    my $numTot = 0;
    foreach (@sys) {
      if ($numSat{$_} > 0) {
        $strTot .= sprintf("%2i",$numSat{$_}).$_;
        $numTot += $numSat{$_};
      }
    }
    $numTot = sprintf("%3i",$numTot);
    prtMess($bpe,"GNSS: $strTot ($numTot)");

    my $totFil = "$dirOut/../MSC/GNSS.LST";
    $strTot = "$yyssss: $strTot ($numTot) $prnLst";
    `echo '$strTot' >> $totFil`;
  }
}
