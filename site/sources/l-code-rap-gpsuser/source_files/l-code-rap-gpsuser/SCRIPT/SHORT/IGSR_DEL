  if($del eq "Y") {
    foreach(@delLst) {
      my @f = glob("$_");
      print "\n$_: ".scalar(@f)."\n";
      foreach my $f(@f) {
        next unless(-e $f);
        unlink($f);
        print "  $f deleted\n";
      }
    }
  } else {
    &prtMess($bpe,"FILES NOT DELETED");
    print  "\n *** FILES NOT DELETED\n";
  }
