use strict;
use lib "$ENV{BPE}";
use bpe_util;


sub run
{
  my $bpe = shift;

# Define variables
# ----------------
  my ($camp_pth,$campaign) =
      $bpe->getKeys
     ('CAMP_PTH','CAMPAIGN' );

# Reprocessing?
# -------------
  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");

# Set the range
# -------------
  setMinusPlus($bpe,-1,0);

# Run program CCRNXC
# --------------------
  my $PGMNAM = "CCRNXC";
  $bpe->RUN_PGMS($PGMNAM) unless $repro;

}
