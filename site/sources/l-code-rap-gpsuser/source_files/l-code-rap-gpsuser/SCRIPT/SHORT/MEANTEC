use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;
use File::Compare qw(compare);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $sav, $dis, $upd, $dirOut) =
    $bpe->getKeys('$YSS+0', 'V_SAV', 'V_DIS', 'V_UPD', 'DIR_OUT');

  my $host = "$ENV{HOST}";
  print "Host: $host\n";

  if (substr($host,0,6) eq "antlia") {return;}

# Run program
# -----------
  my $PGMNAM = "IONANA";
  $bpe->RUN_PGMS($PGMNAM);

  my $cpsFil = "${dirOut}MEANTEC.CPS";
  my $epsFil = "${dirOut}meantec.eps";
  my $jpgFil = "${dirOut}meantec.jpg";
  my $datFil = "${dirOut}MEANTEC.SUM";

  $bpe->putKey("$ENV{U}/PAN/plotMeantec.INP","MEANTEC",$datFil);
  $bpe->putKey("$ENV{U}/PAN/plotMeantec.INP","FIGOUT", $epsFil);
  $PGMNAM = "plotMeantec";
  $bpe->RUN_PGMS($PGMNAM);
  $epsFil = $bpe->getKey("$ENV{U}/INP/plotMeantec.INP","FIGOUT"); # adjust the path

  $bpe->putKey("$ENV{U}/PAN/plotMeantec.INP","FIGOUT",$jpgFil);
  $PGMNAM = "plotMeantec";
  $bpe->RUN_PGMS($PGMNAM);
  $jpgFil = $bpe->getKey("$ENV{U}/INP/plotMeantec.INP","FIGOUT"); # adjust the path

#  copy($cpsFil,$epsFil);
#  system("ls $epsFil | $ENV{AUTO}/eps2jpg.pl 150 3");

  copy($epsFil,"${PATH_AFTP}users/acc_getsum/");
  copy($jpgFil,"${PATH_AFTP}users/acc_getsum/");
  copy($datFil,"${PATH_AFTP}users/acc_getsum/");

  copy($epsFil,"${PATH_AFTP}users/schaer/meantec/");
  copy($jpgFil,"${PATH_AFTP}users/schaer/meantec/");
  copy($datFil,"${PATH_AFTP}users/schaer/meantec/");

  copy($jpgFil,"${PATH_WWW}code/");

}
