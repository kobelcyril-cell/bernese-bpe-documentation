use strict;
use warnings;

# Local packages
use lib "$ENV{BPE}";
use bpe_util qw(copy2archive);

sub run {
  my $bpe = shift;
  my $PGMNAM;

# Get variables
# -------------
  my(
    $yyddd,$yydddm1,
    $dirOut,
    $dirPre,$extPre,
  ) =
  $bpe->getKeys(
    '$YD+0','$YD-1',
    'DIR_OUT',
    'DIR_PRE','EXT_PRE',
  );

  my $ultFil = "$dirOut/../MSC/ULT${yyddd}.FLG";

  my $ultLin   = -e $ultFil ? `cat $ultFil` : "24 23 23 0";
  my $hour_end = substr($ultLin,0,2);

##  $hour_end = "ID" unless(-e $ultFil);
  $hour_end = "00" unless(-e $ultFil);

# Run programs
# ------------
  $PGMNAM = "PREWEI";
  $bpe->RUN_PGMS($PGMNAM);

  my $preInp = $bpe->getKey("$ENV{U}/INP/$PGMNAM.INP","PREOUT");
  my $preOut = "$ENV{S}/RAP/ORB/M${hour_end}${yydddm1}.${extPre}";
  &copy2archive($preInp,$preOut);
}

# =============================================================================

__END__
