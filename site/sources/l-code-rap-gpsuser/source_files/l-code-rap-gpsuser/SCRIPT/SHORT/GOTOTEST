package GOTOTEST;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GOTOTEST
#
# Purpose :  Go to specific PID (PARAM2 or PARAM3)
#
# Programs:
#
# Author  :  S. Schaer
# Created :  19-Feb-2026
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;

  my $PARAM2   = $$bpe{PARAM2};
  my $PARAM3   = $$bpe{PARAM3};

  my ($goto) = $bpe->getKeys('V_GOTO');

  prtMess($bpe,"V_GOTO=$goto (B:$PARAM3/F:$PARAM2)");

  if (substr($goto,0,1) eq "B" || $goto eq "") {
    prtMess($bpe,"GOTO: $PARAM3");
    prtGoto($bpe,$PARAM3);
  } else {
    prtMess($bpe,"GOTO: $PARAM2");
    prtGoto($bpe,$PARAM2);
  }

}
