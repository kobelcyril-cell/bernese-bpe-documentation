package REALIG_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  REALIG_P
#
# Purpose :  Execute ADDNEQ2
#
# PARAMs  :  PARAM1 - year for parallel processing
#
# Author  :  S. Schaer
# Created :  15-Jun-2017
#
# Changes :  16-Jun-2017/ss: Save realigbed results on savedisk
#            25-Jul-2017/ss: Save _FULL results
#            27-Jul-2017/ss: Added _SIG and _DEL test solutions
#            24-Nov-2015/av: Skip 12183,15182,17279 (vTPv negativ)
#            16-Dec-2019/ss: Considered RCLKGNSS GRE results (wk 2072)
#            30-Jul-2020 ST: Add use igs_device.
#            02-Dec-2022/ss: FCLKGNSS GRE results available (wk 2238);
#                            RCLKGNSS GRE results no longer considered
#            29-Jan-2024 SS: Set IGNORE_ERR=solcheck if necessary
#
# ============================================================================
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyyy0, $param1, $dirOut, $dirNeq, $extNeq) =
    $bpe->getKeys('$Y+0', 'PARAM1', 'DIR_OUT', 'DIR_NEQ', 'EXT_NEQ');

# Set variables
# -------------
  my $yyyy = $param1;
  my @sol = ("A1G","A1R");
  my $mjd1 = gps_date("-ymd $yyyy 01 01 -o %IJ");
  my $mjd2 = gps_date("-ymd $yyyy 12 31 -o %IJ");

##  my $dirSav = "$PATH_SAV$CAMP_SAVIGS/REALIGNED/";
##  my $dirSav = "$PATH_SAV/REPRO_ION/REALIGNED/ORIGINAL/";
##  my $dirSav = "$PATH_SAV/REPRO_ION/REALIGNED/NO_JUMPS/";
##  my $dirSav = "$PATH_SAV/REPRO_ION/REALIGNED/WITH_JUMPS/";
##  my $dirSav = "$PATH_SAV/REPRO_ION/REALIGNED/WITH_JUMPS_AND_SVN/";
  my $dirSav = "$PATH_SAV/REPRO_ION/REALIGNED/LAST/";
  check_dir($dirSav);

  `cp ${dirOut}../*/A1[GR]_FULL*.* $dirSav`;

  prtMess($bpe,"BIAS REALIGNMENT FOR YEAR $yyyy");

  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SATELL",'SAT_BIA_$(PCV)');
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SINEXIN","SINEX_BIA_COD");
# No a priori bias values (by default):
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBINP"," ");

  my ($mjd, $sol, $fil, $inp, $out, $nam1, $nam2);
##  my $mjdS = gps_date("-yd 16366 -o %IJ");
  my $mjdS = gps_date("-yd 16135 -o %IJ");

  for ($mjd=$mjd1;$mjd<=$mjd2;$mjd++) {
    my $yyddd = gps_date("-mjd $mjd -o %y%j");
    foreach $sol (@sol) {

      $inp = "$PATH_SAV$CAMP_SAVIGS/$yyyy/SOL/${sol}${yyddd}.${extNeq}.gz";
##      $inp = "$PATH_SAV/REPRO_ION/$yyyy/SOL/${sol}${yyddd}.${extNeq}.gz" if $yyyy <= 2016;
      $inp = "$PATH_SAV/REPRO_ION/$yyyy/SOL/${sol}${yyddd}.${extNeq}.gz" if $mjd <= $mjdS;
      $out = "${dirNeq}${sol}${yyddd}.${extNeq}";
##      $fil = "${dirOut}${sol}${yyddd}_.OUT";
##      $fil = "${dirOut}../ORB/${sol}${yyddd}_.OSB";
##      $fil = "${dirSav}${sol}${yyddd}.OSB";
##      print "NEXT: ${sol}${yyddd}\n" if -s $fil;
##      next if -s $fil;
##      next unless $yyyy eq "2015" || $yyyy eq "2016" || $yyyy eq "2017";
##      next unless $yyddd eq "15001";
##      next if $yyyy eq "2016";
##      next if $yyyy eq "2017";
      next if $yyddd eq "15182" || $yyddd eq "12183" || $yyddd eq "17279";
      if (-s $inp) {
        $nam1 = "${sol}${yyddd}";
        prtMess($bpe,"BIAS REALIGNMENT FOR $nam1");
        copy($inp,$dirNeq);
        system("gunzip -d -f $out.gz");
        $nam2 = $nam1."_";

        $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","TITLE","CODE'S REALIGNED BIAS SOLUTION FOR $yyddd");
        $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","INPFILE","$nam1");
# Define a priori bias values here (default: zero values if not set here):
        $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBINP","${sol}_FULL");
        $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT","$nam2");
        $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT","$nam2");
        $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","BIASSNX","$nam2");
        if ($mjd==99999) {
          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","IGNORE_ERR","solcheck");
          prtMess($bpe,"IGNORE_ERR FOR $nam1");
        } else {
          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","IGNORE_ERR","");
        }

        my $inpR = "$PATH_SAV$CAMP_SAVRAPCLK/$yyyy/SOL/${sol}${yyddd}0.${extNeq}.gz";
        my $outR = "${dirNeq}${sol}${yyddd}0.${extNeq}";
        if ($mjd >= 58748 && $mjd < 59910 && -s $inpR) {
          prtMess($bpe,"INCLUDED RAPID SOLUTION ${yyddd}0");
          copy($inpR,$dirNeq);
          system("gunzip -d -f $outR.gz");
          my @lst = ($nam1,$nam1."0");
          replaceSelLst($bpe,"ADDNEQ2","INPFILE",@lst);
        }

##  setUserVar($bpe,"YSS_M","$yss_m","Y_M","$y_m","S_M","$s_m","_M","$_m");
##  setUserVar($bpe,"FIL","$iFil");

# Run program
# -----------
        my $PGMNAM = "ADDNEQ2";
        $bpe->RUN_PGMS($PGMNAM);

        move("${dirOut}${nam2}.OUT","${dirSav}${nam1}.OUT");
        move("${dirOut}../ORB/${nam2}.OSB","${dirSav}${nam1}.OSB");
        move("${dirOut}../ORB/${nam2}.BIA","${dirSav}${nam1}.BIA");

        if ($yyyy <= 1998) {
          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OCBS_ELIM","NO");
          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREF","NO");
          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBSIGS","0.3");

          $bpe->RUN_PGMS($PGMNAM);

          move("${dirOut}${nam2}.OUT","${dirSav}${nam1}_SIG.OUT");
          move("${dirOut}../ORB/${nam2}.OSB","${dirSav}${nam1}_SIG.OSB");
          move("${dirOut}../ORB/${nam2}.BIA","${dirSav}${nam1}_SIG.BIA");

          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OCBS_ELIM","DELETE");
          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREF","NO");
          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBSIGS"," ");

          $bpe->RUN_PGMS($PGMNAM);

          move("${dirOut}${nam2}.OUT","${dirSav}${nam1}_DEL.OUT");
          move("${dirOut}../ORB/${nam2}.OSB","${dirSav}${nam1}_DEL.OSB");
          move("${dirOut}../ORB/${nam2}.BIA","${dirSav}${nam1}_DEL.BIA");

          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OCBS_ELIM","NO");
          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREF","YES");
          $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBSIGS"," ");
        }

        unlink($out);
        unlink($outR);
      }

    }
  }

}
