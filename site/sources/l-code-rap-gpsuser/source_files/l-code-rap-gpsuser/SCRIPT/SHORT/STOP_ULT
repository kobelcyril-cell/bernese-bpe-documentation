package STOP_ULT;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  STOP_ULT
#
# Purpose :  Check whether ULTyyddd.ULT is justified
#
# Programs:
#
# Author  :  S. Schaer
# Created :  03-Jul-2019
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yydddm1, $yydddm2, $yyyy, $dirOut,
      $pcfFil) =
    $bpe->getKeys('$YD+0', '$YD-1', '$YD-2', '$Y+0', 'DIR_OUT',
                  'PCFFIL');

# Set variables
# -------------
  $pcfFil = (split('\.',$pcfFil))[0];

  my $repro = (-e "${dirOut}../MSC/REPROCESSING.FLG");

  my $ultFil = "${dirOut}../MSC/ULT${yyddd}.FLG";
  my $ultFilM1 = "${dirOut}../MSC/ULT${yydddm1}.FLG";
  my $ultFilM2 = "${dirOut}../MSC/ULT${yydddm2}.FLG";

  if (!-e $ultFil && $pcfFil eq "IGSULTRA") {
    prtMess($bpe,"STOP_ULT: $ultFil not found, but expected for $pcfFil");
    msg2key("BPE","STOP_ULT: $ultFil not found, but expected for $pcfFil");
##    die "STOP_ULT: $ultFil not found, but expected for $pcfFil\n";
  }
  if (-e $ultFil && $pcfFil eq "IGSRAPID") {
    prtMess($bpe,"STOP_ULT: $ultFil not expected for $pcfFil");
    msg2key("BPE","STOP_ULT: $ultFil not expected for $pcfFil");
    die "STOP_ULT: $ultFil not expected for $pcfFil\n";
  }
  if (-e $ultFilM1) {
    prtMess($bpe,"STOP_ULT: $ultFilM1 still existing");
    msg2key("BPE","STOP_ULT: $ultFilM1 still existing");
##    die "STOP_ULT: $ultFilM1 still existing\n";
  }
  if (-e $ultFilM2) {
    prtMess($bpe,"STOP_ULT: $ultFilM2 still existing");
    msg2key("BPE","STOP_ULT: $ultFilM2 still existing");
##    die "STOP_ULT: $ultFilM2 still existing\n";
  }

}
