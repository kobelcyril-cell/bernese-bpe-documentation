package GIR_DIS;
@ISA = ("RUNBPE");
# ==============================================================================
#
# Name:       GIR_DIS
#
# Purpose:    Distribute rapid GIM results
#
# Authors:    S. Schaer
#
# Created:    22-Oct-2014
#
# Changes:    22-Oct-2014 SS: Created based on GIR_FTP
#             19-May-2016 SS: Updated due to OSB implementation
#             26-May-2016 SS: Renamed DCB file (from RZ_ to RZS)
#             07-Feb-2018 SS: Use V_SAV (not V_DIS) for copyaftp
#             08-Mar-2022 AV: Save disk: yearly subdirectory
#             03-Nov-2022 AV: Copy long filname to CODE_TEST
#             09-Nov-2022 AV: Correct long ionosphere name
#             28-Nov-2022 AV: Change upload from CODE_TEST to CODE
#             10-Jan-2023 SS: Renamed ION.??? to GIM.???;
#                             unlinked COD?OPSPRD files
#
# ==============================================================================

use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;
use File::Compare qw(compare);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ddd, $yy, $yyyy, $wwwwd, $yydddm1,
      $V_I, $V_Z, $V_U,
      $dirOut, $dirInx, $extInx, $dirIon, $extIon, $dirDcb, $extDcb, $dirBia, $extBia) =
    $bpe->getKeys('$YD+0', '$+0', '$Y', '$Y+0', '$WD+0', '$YD-1',
                  'V_I', 'V_Z', 'V_U',
                  'DIR_OUT', 'DIR_INX', 'EXT_INX', 'DIR_ION', 'EXT_ION', 'DIR_DCB', 'EXT_DCB', 'DIR_BIA', 'EXT_BIA');


# Check whether this is an ULTRA
# ------------------------------
  my $ultFil = "$dirOut/../MSC/ULT$yyddd.FLG";
  my ($h_end,$h_tro,$h_rnx,$h_chr) = rdUltFlg($ultFil);
  $h_end = 24 unless -e $ultFil;


# BPE not allowed to distribute files
# -----------------------------------
  if($$bpe{V_SAV} ne "Y") {
    prtMess($bpe,"FILES NOT DISTRIBUTED");
    return;
  }


# Distribute rapid GIM results
# ----------------------------
  my ($inp,$out);

  $inp = "${PATH_SAV}${CAMP_SAVRAP}/${yyyy}/ORB/${V_U}S${yyddd}.${extDcb}";
  $out = "BSWUSER52/ORB/$yyyy/COR${yyddd}.DCB";
  copyaftp("-c",$inp,$out) or die "copyaftp failed with $inp\n";
  prtMess($bpe,"$inp copied to $inp");

  $inp = "${dirInx}${V_Z}_${yyddd}.${extInx}";
  unless (-s $inp) {
    $inp = "${dirInx}${V_I}_${yyddd}.${extInx}";
    $out = "CODE/CORG${ddd}0.${yy}I";
    copyaftp("-c",$inp,$out) or die "copyaftp failed with $inp\n";
    prtMess($bpe,"$inp copied to $inp");

    $inp = "${dirInx}${V_I}_${yyddd}.${extInx}";
    $out = "CODE/COD0OPSRAP_${yyyy}${ddd}0000_01D_01H_GIM.INX";
    copyaftp("-g",$inp,$out) or die "copyaftp failed with $inp\n";
    prtMess($bpe,"$inp copied to $inp");

    unlink(glob("$PATH_AFTP$CAMP_CODE/COPG${ddd}0.${yy}I*"));
    unlink(glob("$PATH_AFTP$CAMP_CODE/COD?OPSP?D_${yyyy}${ddd}*GIM.INX*"));
  }

  $inp = "${dirIon}${V_Z}_${yyddd}.${extIon}";
  unless (-s $inp) {
    $inp = "${dirIon}${V_I}_${yyddd}.${extIon}";
    $out = "CODE/COD${wwwwd}.ION_R";
    copyaftp($inp,$out) or die "copyaftp failed with $inp\n";
    prtMess($bpe,"$inp copied to $inp");

    $inp = "${dirIon}${V_I}_${yyddd}.${extIon}";
    $out = "CODE/COD0OPSRAP_${yyyy}${ddd}0000_01D_01H_GIM.ION";
    copyaftp($inp,$out) or die "copyaftp failed with $inp\n";
    prtMess($bpe,"$inp copied to $inp");

    unlink(glob("$PATH_AFTP$CAMP_CODE/COD${wwwwd}.ION_P*"));
    unlink(glob("$PATH_AFTP$CAMP_CODE/COD?OPSP?D_${yyyy}${ddd}*GIM.ION*"));
  }

  $inp = "${dirInx}${V_Z}_${yydddm1}.${extInx}";
  ($wwwwd,$ddd,$yy,$yyyy) = gps_date("-yd $yydddm1 -o %W%w %j %y %Y");
  $out = "CODE/CORG${ddd}0.${yy}I";
  copyaftp("-c",$inp,$out) or die "copyaftp failed with $inp\n";
  $out = "CODE/COD0OPSRAP_${yyyy}${ddd}0000_01D_01H_GIM.INX";
  copyaftp("-g",$inp,$out) or die "copyaftp failed with $inp\n";

  prtMess($bpe,"$inp copied to $inp");

  $inp = "${dirIon}${V_Z}_${yydddm1}.${extIon}";
  ($wwwwd,$ddd,$yy,$yyyy) = gps_date("-yd $yydddm1 -o %W%w %j %y %Y");
  $out = "CODE/COD${wwwwd}.ION_R";
  copyaftp($inp,$out) or die "copyaftp failed with $inp\n";
  $out = "CODE/COD0OPSRAP_${yyyy}${ddd}0000_01D_01H_GIM.ION";
  copyaftp($inp,$out) or die "copyaftp failed with $inp\n";
  prtMess($bpe,"$inp copied to $inp");

}
