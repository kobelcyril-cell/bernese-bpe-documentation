package RCFIT_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ARCFIT_P
#
# Purpose :  Parallel orbgen with different arc lengths
#
# Programs:  ORBGEN (DEFXTR, STDPRE)
#
# Author  :  M. Meindl
# Created :  31-Jul-2003               Last modified: 30-Mar-2006
#
# Changes :  29-Aug-2003 mm/ss: Special ORBGEN implemented
#            01-Sep-2003 mm: Some new (1.5, 2.5, 3.5) solutions
#            08-Sep-2003 mm/ss: Completely revised
#            10-Feb-2005 mm : Old date variables removed
#            30-Mar-2006 mm : setPlusMinus replaced by setMinusPlus
#            03-SEP-2019 DS: call updMacMod to update BOXWING.MAC with ECOM
#            14-Jul-2020 RD/PF: change $X/GEN -> PTH_SATCRUX
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use lib "$ENV{AUTO}";
use bpe_util;
use fileUpdate;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my $PARAM1   = $$bpe{PARAM1};
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};
  my ($yyddd,$dirPlatdef)  = $bpe->getKeys('$YD+0', 'PTH_PLATDEF');

  my $ultfil = "$CAMP_PTH$CAMPAIGN/MSC/ULT${yyddd}.FLG";
  my @ULTLST;
  if (-s $ultfil){ @ULTLST=split(" ",`cat $ultfil`) }
  else           { @ULTLST=("24") }

# Define number of days and set time window for special solutions
# ---------------------------------------------------------------
  my $stadat = int($PARAM1);
  my $statim = $ULTLST[0]-24*($PARAM1-$stadat);

  if ($statim < 0) { $stadat++; $statim+=24 }

  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","STADAT","\$YMD_STR-$stadat");
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","STATIM","$statim 00 00");

# Set minus day and user var
# --------------------------
  setUserVar($bpe,"CD4",$PARAM1);
##  setPlusMinus($bpe,0,-$stadat);
  setMinusPlus($bpe,-$stadat,0);


# Run program
# -----------
  my $PGMNAM = "ORBGEN";
  my $ERR_STATE = &updMacMod($bpe,"$ENV{U}/PAN/$PGMNAM.INP","${dirPlatdef}/BOXWING.MAC","ECOM");
  $bpe->RUN_PGMS($PGMNAM);


# Create precise orbit
# --------------------
  $PGMNAM = "STDPRE";
  $bpe->RUN_PGMS($PGMNAM);


}
