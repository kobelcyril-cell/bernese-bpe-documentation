#!/bin/sh
# SCRIPT-NAME
# sh script file written by bds
# -----------------------------
# functions used by shell
do_rm( ) {
    if [ "$1" ]
    then
        if [ -f `echo $1 | tr ' ' '\012' | head -1` ]
        then
            eval rm $1
        fi
    fi
}
#
toupper( ) {
    eval $1=`echo $2 | ${UPPERC}`
    eval export $1
}
#
seterr( ) {
    if [ $? = 0 ]
    then
        ERRSTAT=OK
    else
        ERRSTAT=ERR
    fi
}
#
# -----------------------------
# SHELL STARTS HERE
# -----------------------------
#
# IGSR_COP
# ========
#
# COPY AND DECOMPRESS RAW OBSERVATION AND NAVIGATION FILES
# --------------------------------------------------------
# 06-Jul-2012/RD: Extract "repositioning.com"-call from IGSR_COP
# 14-Dec-2014/AV: Change get_nav.com to get_obsdata.com
# 17-Mar-2015/AV: Add -min option to get_obsdata.com
# 11-Nov-2019/AV: Skip get_obsdata.com if V_SAVDSK eq Y
#
#
#
# SHELL VARIABLES:
# ----------------
#
# YEAR    :  Year of the session to be processed (2 digit)
# SESSION :  Session number (4 characters)
# CAMPAIGN:  Campaign name
# CAMP_PTH:  Campaign path
# CAMP_DRV:  Drive letter for campain (i.e. P)
# OPT_DIR :  Directory for panels
# PID     :  Process identification number (3 digits)
# SUB_PID :  Subprocess id (3 digits)
# PRT_FILE:  Protocol file name including path
# SCRIPT  :  Name of script
# TASKID  :  Task id of script, usually 00
# PRIORITY:  Priority of the script
# CPU     :  CPU the script is running on
# DAYYEAR :  Julian day of the year
# DAY     :  Day of the Month
# MONTH   :  Month, 1=JAN, 12=DEC
# GPSWEEK :  GPS week
# DAYWEEK :  Day of the week, 0=SUN, 6=SAT
# V_X     :  X Variable in DAT151__.PAN
# V_O     :  O Variable in DAT151__.PAN
# V_Z     :  Z Variable in DAT151__.PAN
# V_PLUS  :  Plus variable in DAT151__.PAN
# V_MINUS :  Minus variable in DAT151__.PAN
# V_x     :  User variable
# PARAMx  :  Script specific parameter, x is 1 thru 9
# U       :  Directory path to U:
#
# See if this shell is being run from the PCS
# script, or directly for testing.  If testing,
# no the header script is not passed in as %1%
#
if [ "$1" = "" ]
then
#
#   set variables for testing here
#
    TEST_START_DIR=`pwd`
    cd $U/WORK
    TESTING="YES"
    export TESTING
else
    TESTING="NO"
    export TESTING
    . "$1"
    seterr
fi
#
# START THE MENU SYSTEM IN NON-INTERACTIVE MODE
# ---------------------------------------------
. $X/SCRIPT/BEG_MENU
seterr
#
# SET VARIABLES IN DAT151__.PAN
# -----------------------------
. $X/SCRIPT/SET_SESS
seterr
#
# SHELL BODY
# ----------
#
# Get GPS/GLONASS navigation data and activate SAT_INI (if indicated)
# -------------------------------------------------------------------
$X/SCRIPT/PRT_MESS "$PRT_FILE" MSG "$SCRIPT" start_ultraFlags
seterr
ULTFIL=""$CAMP_PTH""$CAMPAIGN"/MSC/ULT"$YEAR""$DAYYEAR".FLG"
export ULTFIL
EXTFIL=""$CAMP_PTH""$CAMPAIGN"/ORB/EXT"$YEAR""$DAYYEAR".PRE"
export EXTFIL
APRFIL=""$CAMP_PTH""$CAMPAIGN"/ORB/APR"$YEAR""$DAYYEAR".PRE"
export APRFIL
INIFIL=""$CAMP_PTH""$CAMPAIGN"/MSC/SAT_INI.FLG"
export INIFIL
HEYFIL=""$CAMP_PTH""$CAMPAIGN"/MSC/HELLO_AGAIN.FLG"
export HEYFIL
REPFIL=""$CAMP_PTH""$CAMPAIGN"/MSC/REPOSITIONING.FLG"
export REPFIL
#
if [ -f `echo $ULTFIL | tr ' ' '\012' | head -1` ]
then
    :
#   PLEASE ACTIVATE THE FOLLOWING COMMAND FOR AUTO-SAT_INI IN ULTRA MODE:
#   call X:[AUTO]repositioning.com -auto
#   cp %EXTFIL% %APRFIL%
else
    $X/SCRIPT/PRT_MESS "$PRT_FILE" MSG "$SCRIPT" start_getNAVdata
    seterr
    #   call X:[AUTO]get_navdata.com
    if [ "$V_SAVDSK" != "Y" ]
    then
        ${AUTO}/get_obsdata.com -nav -m=IGS -nt=2 -min=5
    fi
    seterr
    $X/SCRIPT/PRT_MESS "$PRT_FILE" MSG "$SCRIPT" start_repositioning
    seterr
    if [ "$V_SAVDSK" != "Y" ]
    then
      ${AUTO}/repositioning.com
      seterr
    fi
#   mv %INIFIL%_RAP %INIFIL%
#   DECOMMENT THE FOLLOWING COMMAND FOR AUTOMATIC A PRIORI ORBIT PREPARATION:
#   cp %EXTFIL% %APRFIL%
    $X/SCRIPT/PRT_MESS "$PRT_FILE" MSG "$SCRIPT" set_flags
    seterr
    if [ -f `echo $APRFIL | tr ' ' '\012' | head -1` ]
    then
        :
    else
        cp "$EXTFIL" "$APRFIL"
    fi
#   HELLO_AGAIN:
    if [ -f `echo $HEYFIL | tr ' ' '\012' | head -1` ]
    then
        LINE=`cat "$HEYFIL"`
        export LINE
        PRN=`echo "$LINE" | cut -c1-3`
        echo PRN: "$PRN"
        echo "$PRN" > "$INIFIL"
        echo "$PRN" > "$REPFIL"
        cp "$EXTFIL" "$CAMP_PTH""$CAMPAIGN"/ORB/SAT_INI.PRE
        rm -f "$HEYFIL"
        ${AUTO}/msg2key.com NRT "IGSR_COP: SAT_INI activated wrt PRN "$PRN" (for a priori orbit improvement)!" "IGSR_COP: SAT_INI activated"
        seterr
    fi
fi
#
# --------------
# end the script
# --------------
. $X/SCRIPT/END_MENU
seterr
if [ "$TESTING" = "YES" ]
then
    cd "$TEST_START_DIR"
else
    . $X/SCRIPT/DO_TAIL
    seterr
fi
