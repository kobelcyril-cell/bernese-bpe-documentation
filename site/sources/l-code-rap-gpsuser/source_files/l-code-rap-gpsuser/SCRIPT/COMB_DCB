package COMB_DCB;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  COMB_DCB
#
# Purpose :  Compute 30-day sliding (or monthly) DCB combination
#
# PARAMs  :  PARAM1 - DCB solution identifier
#            PARAM2 - Optional minus parameter
#
# Author  :  S. Schaer
# Created :  23-Dec-2011
#
# Changes :  05-Jan-2012/ss: Copy particular DCB results
#            05-Jan-2012/ss: Set appropriate title using @id
#            06-Jan-2012/ss: Save DCB results
#            11-Jan-2012/ss: Consider MONTHLY.FLG
#            13-Jan-2012/ss: Use dcb_jumps.com
#            10-Feb-2012/ss: Save .F file
#            27-Aug-2012/ss: Consider V_SAV, V_DIS
#            03-Sep-2012/ss: Some generalizations
#            04-Sep-2012/ss: Update .DCB/.F files
#            06-Sep-2012/ss: Consider $id[4]
#            06-Sep-2012/ss: Recompute monthly combination if necessary
#            07-Sep-2012/ss: Stop when copy/copyaftp failed
#            07-Sep-2012/ss: Save and update last day's TGD information
#            02-Nov-2012/lp: Start supporting BSWUSER52
#            05-Nov-2014/ss: Included Z1N
#            01-Jun-2016/ss: Added $id[7] to control receiver DCB estimation
#            08-Jun-2016/ss: Added DCB solution types A10, A11, A12, Z31, Z32
#            14-Jun-2016/ss: Removed BSWUSER50
#            07-Feb-2018 SS: Use V_SAV (not V_DIS) for copyaftp
#            29-Aug-2018 AV: Temporary use g95
#            20-May-2021 SS: Changed unused EXE_G95 paths
#            01-Feb-2022 SS: Prepared for consideration of new D1?yyssss.DCB
#            15-Jul-2026 SS: Discontinued distribution of .F files
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;
use File::Compare qw(compare);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $mjd_last, $b, $sav, $dis, $upd, $dirDcb, $dirOut, $param1, $param2) =
    $bpe->getKeys('$YSS+0', '$JD+0', 'V_B', 'V_SAV', 'V_DIS', 'V_UPD', 'DIR_DCB', 'DIR_OUT', 'PARAM1', 'PARAM2');

# Exit if DCB solution identifier undefined
# -----------------------------------------
  die "DCB solution identifier undefined\n" if $param1 eq "";

# Exit if MONTHLY.FLG found and not end of month
# ----------------------------------------------
  my $flgFil = "${dirOut}../MSC/MONTHLY.FLG";
  if (-e $flgFil) {
    $ddp1 = gps_date("-mjd $mjd_last -d +1 -o %d");
    return unless $ddp1 eq "01";
    $dd = gps_date("-mjd $mjd_last -d -1 -o %d");
  }

# Set variables
# -------------
  my @id;
# Legend: GNSS  Type long/short Extension Receiver Dis./Upd. ALL? RECEST?
  @id = ("GNSS","P1-P2","P1P2","_ALL"  ,"1","1","1","1") if $param1 eq "Z3_";
  @id = ("GNSS","P1-P2","P1P2","_ALL"  ,"1","0","0","1") if $param1 eq "Z3N";
  @id = ("GNSS","P1-P2","P1P2","_ALL"  ,"1","0","0","1") if $param1 eq "Z1N";
  @id = ("GPS" ,"P1-C1","P1C1",""      ,"0","1","0","0") if $param1 eq "C1_";
  @id = ("GPS" ,"P1-C1","P1C1","_AR"   ,"0","0","0","0") if $param1 eq "W1_";
  @id = ("GPS" ,"P1-C1","P1C1","_CLK"  ,"0","0","0","0") if $param1 eq "TP_";
  @id = ("GPS" ,"P1-C1","P1C1","_CLK"  ,"0","0","0","0") if $param1 eq "F1P_";
  @id = ("GPS" ,"P1-C1","P1C1","_CLK"  ,"0","0","0","0") if $param1 eq "F3P_";
  @id = ("GPS" ,"P1-P2","P1P2","_GPS"  ,"0","1","0","0") if $param1 eq "B1_";
  @id = ("GNSS","P1-C1","P1C1","_RINEX","1","1","0","1") if $param1 eq "D11";
  @id = ("GNSS","P2-C2","P2C2","_RINEX","1","1","0","1") if $param1 eq "D12";
  @id = ("GNSS","P1-C1","P1C1","_IONO" ,"0","0","0","0") if $param1 eq "Z31";
  @id = ("GNSS","P2-C2","P2C2","_IONO" ,"0","0","0","0") if $param1 eq "Z32";
  @id = ("GNSS","P1-P2","P1P2","_COMBO","0","0","0","0") if $param1 eq "A10";
  @id = ("GNSS","P1-C1","P1C1","_COMBO","0","0","0","0") if $param1 eq "A11";
  @id = ("GNSS","P2-C2","P2C2","_COMBO","0","0","0","0") if $param1 eq "A12";

# Delete old DCB files
# --------------------
  my ($yyyy,$yyddd,$yyssss) = gps_date("-mjd $mjd_last -d -400 -o %Y %y%j %y%j0");
##  unlink("${dirDcb}${param1}${yyddd}.DCB");
##  unlink("${dirDcb}${param1}${yyssss}.DCB");
  ($yyyy,$yyddd,$yyssss) = gps_date("-mjd $mjd_last -d -366 -o %Y %y%j %y%j0");
##  unlink("${dirDcb}${param1}${yyddd}.DCB");
##  unlink("${dirDcb}${param1}${yyssss}.DCB");

# Copy requested DCB file time series
# -----------------------------------
  START:
  my $dcbLst = "${dirOut}DCB_${param1}.LST";
  my $dcbSel = "${dirOut}DCB_${param1}.SEL";
  open(DCBLST,"> $dcbLst");
  open(DCBSEL,"> $dcbSel");

  my @dcbFil;
  my @dcbLst;
  my $numLst = 0;
  my $mjd0 = 0;

  my $yymm_chk = "";
  my $chkFil;
  my $numFil = 0;

  my $mjd_first = gps_date("-doy 001 1990 -o %IJ");
##  my $mjd_first = gps_date("-doy 001 1995 -o %IJ");
##  $mjd_first = gps_date("-mjd $mjd_last -d $param2 -o %IJ") if $param2 ne "";
  $mjd_first = gps_date("-mjd $mjd_last -d -$dd -o %IJ") if -e $flgFil;
  for ($mjd=$mjd_first;$mjd<=$mjd_last;$mjd++) {
    ($yyyy,$yyddd,$yyssss) = gps_date("-mjd $mjd -o %Y %y%j %y%j0");

# Considered new D1?yyssss.DCB starting with day 001, 2022:
    if (substr($param1,0,2) eq "D1" && $mjd>=59580) {
##    if (substr($param1,0,2) eq "D1" && $mjd>=59611) {
      @dcbFil = ("$PATH_SAV$CAMP_SAVIGS/$yyyy/ORB/${param1}${yyssss}.DCB");
    } else {
      @dcbFil = ("$PATH_SAV$CAMP_SAVIGS/$yyyy/ORB/${param1}${yyddd}.DCB");
    }

    my $ok = 0;
    foreach $fil (@dcbFil) {
      if (-s $fil) {
         if ($sav eq "Y") {
           $yymm = gps_date("-mjd $mjd -o %y%m");
           if ($yymm_chk ne "") {
             if ($yymm ne $yymm_chk) {
               prtMess($bpe,"$fil IGNORED");
               $numFil++;
               last;
             }
           } else {
             $chkFil = "$PATH_SAV$CAMP_SAVIGS/$yyyy/ORB/${param1}_${yymm}.DCB";
             if (-s $chkFil) { $yymm_chk = $yymm if (stat($fil))[9]-(stat($chkFil))[9]>0 }
             else            { $yymm_chk = $yymm if $mjd-$mjd_last>=-30 }
           }
         }
         print "$fil\n";
         print DCBLST "$fil\n";
         print DCBSEL basename($fil)."\n";
         if ($param2 ne "") { push(@dcbLst,$fil) if $mjd-$mjd_last>=$param2 }
         else               { push(@dcbLst,$fil) }
         $numLst++;
         $ok++;
         $mjd0 = $mjd;
         last;
      }
    }
##    die "No DCB file $yyddd found\n" if $ok==0;
  }

  close(DCBLST);
  close(DCBSEL);

  prtMess($bpe,"DCB_${param1}.LST CONSISTING OF $numLst FILES CREATED");
  prtMess($bpe,"DCB_${param1}.SEL CONSISTING OF $numLst FILES CREATED");

# Exit if no DCB file found
# -------------------------
##  die "No $param1 DCB file found\n" if $mjd0==0;
  return if $mjd0==0;

# Copy DCB files if indicated
# ---------------------------
  my $dcbFil;
  foreach $fil (@dcbLst) {
    $dcbFil = "$dirDcb".basename($fil);
    if (compare($fil,$dcbFil)) {
      copy($fil,$dcbFil) or die "copy failed with $fil\n";
      print "$fil copied to $dcbFil\n";
      prtMess($bpe,basename($dcbFil)." COPIED");
    } else {
      print "$dcbFil up-to-date\n";
    }
  }

# Set title and DCB filename
# --------------------------
  my $title = "";
  my $dcbNam = "";

# Check whether monthly combination to be performed
# -------------------------------------------------
  $mjd0 = $mjd_last if -e $flgFil;
  my $ddp1 = gps_date("-mjd $mjd0 -d +1 -o %d");
  my ($dd,$mm,$yy,$ddd,$yyyy) = gps_date("-mjd $mjd0 -o %d %m %y %j %Y");
  $dd = 30 unless $ddp1 eq "01";
  my $plus  = $mjd0-$mjd_last;
  my $minus = $plus-$dd+1;

  setMinusPlus($bpe,$minus,$plus);
  $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","DCBINP","$param1\$YD+-");
  if (substr($param1,0,2) eq "D1") {
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","DCBINP","$param1\$YSS+-");
  }
  if (-e $flgFil && $numLst < $dd) {
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","DCBINP","$param1\$YD~~");
    prtMess($bpe,"MISSING DAILY DCB FILES");
  }
  if ($param1 eq "A10" || $param1 eq "A11" || $param1 eq "A12") {
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","DCBINP","$param1\$YD~~");
  }
  if ($param1 eq "Z31" || $param1 eq "Z32") {
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","DCBINP","$param1\$YD~~");
  }

  $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","SATSYS","ALL");
  $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","DCBTYP","AUTO");
##  $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","RECEST","1");
  $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","RECEST","$id[7]");
  $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","SATGRA","DCBEST_$param1.CPS");
  $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","LIMLO","-15");
  $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","LIMHI","+15");

  my $title = "CODE\'S ";
  unless ($ddp1 eq "01") {
##    $title .= "30-DAY $id[0] $id[1] DCB SOLUTION, ENDING D${ddd}, Y${yyyy}";
    $title = "CODE\'S 30-DAY $id[0] $id[1] DCB SOLUTION, ENDING DAY ${ddd}, ${yyyy}";
    $title = "30-DAY GPS BROADCAST TGD INFORMATION, ENDING DAY ${ddd}, ${yyyy}" if $param1 eq "B1_";
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","TITLE",$title);
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","DCBOUT","DCBEST_$param1");
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","SYSOUT","DCBEST_$param1");
  } else {
##    $title .= "MONTHLY $id[0] $id[1] DCB SOLUTION, YEAR-MONTH ${yy}-${mm}";
    $title = "CODE\'S MONTHLY $id[0] $id[1] DCB SOLUTION, YEAR ${yyyy}, MONTH ${mm}";
    $title = "MONTHLY GPS BROADCAST TGD INFORMATION, YEAR ${yyyy}, MONTH ${mm}" if $param1 eq "B1_";
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","TITLE",$title);
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","DCBOUT","DCBEST_$param1");
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","SYSOUT","DCBEST_$param1");
  }

# Prepare DCB files in terms of jumps or exclusions
# -------------------------------------------------
  my $s = substr($param1,0,2) eq "D1" ? "0" : "";
  system("$ENV{AUTO}/dcb_jumps.com $dirDcb$param1$yy$ddd$s.DCB $dd 50") && die "dcb_jumps.com failed\n";

# Run program
# -----------
# $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/storage/research/aiub_data/BSWsoftware/BERN/TOOL/EXE_G95/");
#  print "Change executable path to /storage/research/aiub_data/BSWsoftware/BERN/TOOL/EXE_G95/\n";

  my $PGMNAM = "DCBEST";
##  $bpe->RUN_PGMS($PGMNAM);
  $bpe->RUN_PGMS($PGMNAM) unless $mjd0==0;

# Perform extra run if requested
# ------------------------------
##  if ($param1 eq "Z3_") {
##  if ($id[6]) {
  if ($id[4]) {
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","RECEST","0");
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","DCBOUT","DCBEST_${param1}R");
    $bpe->putKey("$ENV{U}/PAN/DCBEST.INP","SYSOUT","DCBEST_${param1}R");
    $bpe->RUN_PGMS($PGMNAM) unless $mjd0==0;
  }

# Distribute particular DCB results
# ---------------------------------
  if ($sav eq "Y") {
##    if ($param1 eq "D11" ||
##        $param1 eq "D12") {
    if ($id[5]) {
##      if ($mjd-$mjd0>=-2) {
      if ($mjd-$mjd0>=-10) {
        $inp = "${dirDcb}DCBEST_${param1}.DCB";
        $inp = "${dirDcb}${param1}${yy}${ddd}.DCB" if $param1 eq "B1_";
        $out = "CODE/$id[2]$id[3].DCB";
        copyaftp($inp,$out) or die "copyaftp failed with $inp to $out\n";
        $out = "BSWUSER52/ORB/$id[2]$id[3].DCB";
        copyaftp($inp,$out) or die "copyaftp failed with $inp to $out\n";
        prtMess($bpe,"$id[2]$id[3].DCB DISTRIBUTED");
        if ($id[6]) {
          $inp = "${dirDcb}DCBEST_${param1}R.DCB";
          $out = "CODE/$id[2].DCB";
          copyaftp($inp,$out) or die "copyaftp failed with $inp to $out\n";
          $out = "BSWUSER52/ORB/$id[2].DCB";
          copyaftp($inp,$out) or die "copyaftp failed with $inp to $out\n";
          prtMess($bpe,"$id[2].DCB DISTRIBUTED");
        }
        $inp = "${dirDcb}DCBEST_${param1}.F_out_of_service";
        if (-s $inp) {
          $out = "CODE/$id[2]$id[3].F";
          copyaftp($inp,$out) or die "copyaftp failed with $inp to $out\n";
##          $out = "BSWUSER52/ORB/$id[2]$id[3].F";
##          copyaftp($inp,$out) or die "copyaftp failed with $inp to $out\n";
          prtMess($bpe,"$id[2]$id[3].F DISTRIBUTED");
        }
      }
      if ($ddp1 eq "01" && $param1 ne "B1_") {
        $inp = "${dirDcb}DCBEST_${param1}.DCB";
        $out = "CODE/${yyyy}/$id[2]${yy}${mm}$id[3].DCB";
        copyaftp("-c",$inp,$out) or die "copyaftp failed with $inp to $out\n";
        prtMess($bpe,"$id[2]${yy}${mm}$id[3].DCB DISTRIBUTED");
        if ($id[6]) {
          $inp = "${dirDcb}DCBEST_${param1}R.DCB";
          $out = "CODE/${yyyy}/$id[2]${yy}${mm}.DCB";
          copyaftp("-c",$inp,$out) or die "copyaftp failed with $inp to $out\n";
          prtMess($bpe,"$id[2]${yy}${mm}.DCB DISTRIBUTED");
        }
        $inp = "${dirDcb}DCBEST_${param1}.F_out_of_service";
        if (-s $inp) {
          $out = "CODE/${yyyy}/$id[2]${yy}${mm}$id[3].F";
          copyaftp("-c",$inp,$out) or die "copyaftp failed with $inp to $out\n";
          prtMess($bpe,"$id[2]${yy}${mm}$id[3].F DISTRIBUTED");
        }
      }
    } else {
      prtMess($bpe,"NOTHING TO BE DISTRIBUTED");
    }
  } else {
    prtMess($bpe,"NOTHING DISTRIBUTED");
  }

# Save DCB results
# ----------------
  if ($sav eq "Y") {
    my $dirSav = "$PATH_SAV$CAMP_SAVIGS/$yyyy/ORB/";
    check_dir($dirSav);
    if ($ddp1 eq "01") {
      $inp = "${dirDcb}DCBEST_${param1}.DCB";
      $out = "${dirSav}${param1}_${yy}${mm}.DCB";
      copy($inp,$out) or die "copy failed with $inp to $out\n";
      prtMess($bpe,"${param1}_${yy}${mm}.DCB SAVED");
      if ($id[5]) {
        $inp = "${dirDcb}${param1}${yy}${ddd}.DCB" if $param1 eq "B1_";
        $out = "${dirSav}$id[2]${yy}${mm}$id[3].DCB";
        copy($inp,$out) or die "copy failed with $inp to $out\n";
        prtMess($bpe,"$id[2]${yy}${mm}$id[3].DCB SAVED");
        if ($id[6]) {
          $inp = "${dirDcb}DCBEST_${param1}R.DCB";
          $out = "${dirSav}$id[2]${yy}${mm}.DCB";
          copy($inp,$out) or die "copy failed with $inp to $out\n";
          prtMess($bpe,"$id[2]${yy}${mm}.DCB SAVED");
        }
      }
      $inp = "${dirDcb}DCBEST_${param1}.F";
      if (-s $inp) {
        $out = "${dirSav}${param1}_${yy}${mm}.F";
        copy($inp,$out) or die "copy failed with $inp to $out\n";
        prtMess($bpe,"${param1}_${yy}${mm}.F SAVED");
        if ($id[5]) {
          $out = "${dirSav}$id[2]${yy}${mm}$id[3].F";
          copy($inp,$out) or die "copy failed with $inp to $out\n";
          prtMess($bpe,"$id[2]${yy}${mm}$id[3].F SAVED");
        }
      }
    } else {
      prtMess($bpe,"NOTHING TO BE SAVED");
    }
  } else {
    prtMess($bpe,"NOTHING SAVED");
  }

# Update DCB results
# ------------------
##  if ($upd eq "Y") {
  if ($upd eq "Y" && $mjd-$mjd0>=-10) {
     my $dirRef = "$ENV{REF}/";
##    if ($param1 eq "Z3_" ||
##        $param1 eq "C1_" ||
##        $param1 eq "D11" ||
##        $param1 eq "D12") {
    if ($id[5] || $param1 eq "W1_") {
      $inp = "${dirDcb}DCBEST_${param1}.DCB";
      $inp = "${dirDcb}${param1}${yy}${ddd}.DCB" if $param1 eq "B1_";
      $out = "${dirRef}$id[2]$id[3].DCB";
      copy($inp,$out) or die "copy failed with $inp to $out\n";
      prtMess($bpe,"$id[2]$id[3].DCB UPDATED");
##      if ($param1 eq "Z3_") {
      if ($id[6]) {
        $inp = "${dirDcb}DCBEST_${param1}R.DCB";
        $out = "${dirRef}$id[2].DCB";
        copy($inp,$out) or die "copy failed with $inp to $out\n";
        prtMess($bpe,"$id[2].DCB UPDATED");
      }
##      $inp = "${dirDcb}DCBEST_${param1}.F";
##      if (-s $inp) {
##        $out = "${dirRef}$id[2]$id[3].F";
##        copy($inp,$out) or die "copy failed with $inp to $out\n";
##        prtMess($bpe,"$id[2]$id[3].F UPDATED");
##      }
    } else {
      prtMess($bpe,"NOTHING TO BE UPDATED");
    }
  } else {
    prtMess($bpe,"NOTHING UPDATED");
  }

# Restart in case of ignored files
# --------------------------------
  if ($numFil>0) {
    prtMess($bpe,"RESTARTED WITH $numFil IGNORED FILES");
    goto START;
  }

}
