package ATX2EPN;
@ISA = ("RUNBPE");
# =============================================================================
#
# Name    :  ATX2EPN
#
# Purpose :  Update PCV_COD.E08 using ATX2PCV
#
# PARAMs  :
#
# Author  :  A. Gaede
#
# Created :  06-Aug-2007
#
# Changes :  06-Aug-2007/ag: A2P_EPN derived from PCV_EPN
#            09-Oct-2012/ss: Use STAINF variable
#            15-Oct-2014/ss: Revised
#            18-Nov-2014/ss: Consider V_PCVE (no longer EPNC.ATX)
#            30-Jan-2017/av: Optional pcve selection (param1)
#            02-Feb-2017/av/rd: Optional pcv selection (param2), setUserVar
#            14-Jul-2020 RD/PF: change $X/GEN -> PTH_PHASECC
#            04-Apr-2022 AV: Corrected PCV file name
#
# =============================================================================

# External packages
use strict;
use File::Copy qw(copy move);

# Local packages
use lib "$ENV{BPE}";
use bpe_util qw(prtMess setUserVar);
use lib "$ENV{AUTO}";
use gpsutil qw(msg2key);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $dirPhg,$extPhg,$dirPhasecc,$extPhasecc,
    $dirOut,
    $dirSta,
    $staInf,$satInf,$pcvInf,$pcv,$pcve,$nadir,
    $param1,$param2
  ) =
  $bpe->getKeys(
    'DIR_PHG','EXT_PHG','PTH_PHASECC','EXT_PHASECC',
    'DIR_OUT',
    'DIR_STA',
    'V_STAINF','V_SATINF','V_PCVINF','V_PCV','V_PCVE','V_NADIR',
    'PARAM1', 'PARAM2'
  );
  my $PGMNAM;

# If PARAM1 defined switch version
# --------------------------------
  if($param1 ne ""){
    $pcve = $param1;
    setUserVar($bpe,"PCVE",$param1);
  }

  if($param2 ne ""){
    setUserVar($bpe,"PCV",$param2);
  }

# Copy ANTEX information
# ----------------------
  &copy("$ENV{REF}/${pcve}.ATX",$dirOut);
  &copy("$ENV{REF}/${staInf}.STA",$dirSta);

# Update not allowed
# ------------------
  unless($$bpe{V_UPD} eq "Y") {
    &prtMess($bpe,"FILES NOT UPDATED");
    return;
  }

# Run program
# -----------
  $PGMNAM = "ATX2PCV";
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","MXFNAD",$nadir) unless($nadir eq "");
  $bpe->RUN_PGMS($PGMNAM);

  my $filNew = "${dirPhg}PCV_${pcve}.${extPhg}";
  my $filOld = "${dirPhasecc}/${pcvInf}_${pcve}.$extPhasecc";
  my $diff = `diff $filNew $filOld | wc -l`;
  $diff = $diff+0;
  if($diff > 4) {
    `diff $filNew $filOld > ${filOld}_DIF`;
    &copy($filOld,"${filOld}_BAK");
    &copy($filNew,"${filOld}_TMP");
    &move("${filOld}_TMP",$filOld);
    &msg2key("BPE","${pcvInf}.${pcve} updated in CONFIG directory");
  }
}

# =============================================================================

__END__
