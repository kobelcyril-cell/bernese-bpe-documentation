use strict;

use File::Copy;
use lib "$ENV{AUTO}";
use lib "$ENV{BPE}";
use lib "$ENV{EXE}";
use Gps_Date;
use newFTP;
use bpe_util;
use cddis_curl;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ddd, $yy, $yydddm1, $yydddm2, $V_I, $V_Z,
      $dirOut, $dirInx, $extInx) =
    $bpe->getKeys('$YD+0', '$+0', '$Y', '$YD-1', '$YD-2', 'V_I', 'V_Z',
                  'DIR_OUT', 'DIR_INX', 'EXT_INX');


# Check whether this is an ULTRA
# ------------------------------
  my $ultFil = "$dirOut/../MSC/ULT$yyddd.FLG";
  my ($h_end,$h_tro,$h_rnx,$h_chr) = rdUltFlg($ultFil);
  $h_end = 24 unless -e $ultFil;


# Compress IONEX file
# -------------------
  my $girFil   = "${dirInx}${V_I}_${yyddd}.${extInx}";
  my $girFilm1 = "${dirInx}${V_I}_${yydddm1}.${extInx}";
  my $girFilm2 = "${dirInx}${V_I}_${yydddm2}.${extInx}";
  die "IONEX file for upload missing: $girFil\n"   unless -s $girFil;
  die "IONEX file for upload missing: $girFilm1\n" unless -s $girFilm1;
  die "IONEX file for upload missing: $girFilm2\n" unless -s $girFilm2;

  my $long      = "COD0OPSRAP";
  my $yyyyddd   = gps_date("-yd $yyddd   -o %Y%j");
  my $yyyydddm1 = gps_date("-yd $yydddm1 -o %Y%j");
  my $yyyydddm2 = gps_date("-yd $yydddm2 -o %Y%j");

# BPE not allowed to distribute files
# -----------------------------------
  if($$bpe{V_DIS} ne "Y" || -e "$ENV{HOME}/../l_code/MSC/NO_DIS.FLG") {
    prtMess($bpe,"FILES NOT DISTRIBUTED");
##    return;
  }

# Upload IONEX file
# -----------------
  my %cddis_upload = ("${girFil}"   => "${long}_${yyyyddd}0000_01D_01H_GIM.INX.gz",
                      "${girFilm1}" => "${long}_${yyyydddm1}0000_01D_01H_GIM.INX.gz",
                      "${girFilm2}" => "${long}_${yyyydddm2}0000_01D_01H_GIM.INX.gz");
  my $iRun;
  my $nRun = 3;
  my $err = "ERR";
  for ($iRun=1;$iRun<=$nRun;$iRun++) {
    $err = "OK";

# Upload to cddis https:
    my $irc = upload_cddis_hash(\%cddis_upload);
    $err = "ERR" if $irc!=0;

### Upload r_ solutions to cddis;
##    my %r_ucddis=();
###    foreach my $key (keys %cddis_upload) { $r_ucddis{$key} = "r_".$cddis_upload{$key} }
##    $irc = upload_cddis_hash(\%r_ucddis);
##    $err = "ERR" if $irc!=0;

    last if $err eq "OK";
    sleep (900);
  }
  die "cddis_upload failed $nRun times" if $err eq "ERR";

}
