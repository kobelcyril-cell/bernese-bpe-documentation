package ADDNEQ2L;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ADDNEQ2L
#
# Purpose :  Compare bernese neqs of last 90 days
#
# Programs:  ADDNEQ2
#
# Author  :  E. Brockmann
# Created :  19-Aug-2025
#
# Changes :  19-Aug-2025 EB: Started
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;

# Set 90-day overlap
# ------------------
  setMinusPlus($bpe,-90,0);


# Run program
# -----------
  my $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);
}
