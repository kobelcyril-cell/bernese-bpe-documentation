package ORBMRG;
@ISA = ("RUNBPE");
# =============================================================================
#
# Name    :  ORBMRG
#
# Purpose :  PERFORM CCPREORB RUN TO MERGE 1-DAY PREDICTED ORBITS
#            WITH BROADCAST ORBITS
#
# Programs:
#
# Author  :  H. Bock
#
# Created :  06-Dec-2007
#
# Changes :  30-Jul-2010 ss: Consideration of second REPOSITIONING2.FLG file
#            01-Oct-2010 ss: Consideration of further REPOSITIONING FLG files
#            24-Feb-2013 ss: Considered endless orbit predictions
#            29-Oct-2015 eo: die if orbPredicted not available
#            10-Sep-2019 lp: Use V_NEWNAV to switch between old and new BRD-orbits
#            05-Mar-2020 av/st: Disable merge of GLONASS broadcasts
#                            (switched RB_ ($A) from GPS to multi GNSS)
#            06-Mar-2020 av/st: Changed forgotten newRB to BRD
#            22-Apr-2020 ST: Change from 'BRD' to '${v_a}_'.
#                            This results in equal code for both variants
#                            (Y/N) of V_NEWNAV.
#                            Therefore remove V_NEWNAV and corresponding IF.
#            23-Apr-2020 ST: Stop copy of $A_$YD+0 to $A0$YD+0.
#                            No special treatment for GLONASS broadcasts.
#                            Don't copy CODE$S+0 to $A_$YD+0.
#            24-Aug-2024 RD: Swap priority: use EXT before BRD
#                            (BRD may not be correct after maneuuvers)
#            30-Oct-2025 SS: Replaced 'S22' by 'G00'
#
# =============================================================================

use strict;

# Local packages
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,$ssss,$wwwwdm1,
    $CAMP_PTH,$CAMPAIGN,
    $dirPre,$extPre,
    $dirErp,$extErp,
    $v_a,$v_o,
  ) =
  $bpe->getKeys(
    '$YD+0','$S+0','$WD-1',
    'CAMP_PTH','CAMPAIGN',
    'DIR_PRE','EXT_PRE',
    'DIR_ERP','EXT_ERP',
    'V_A','V_O',
  );
  my $PGMNAM;

# Set T
# -----
  my $ultFil = "${CAMP_PTH}${CAMPAIGN}/MSC/ULT${yyddd}.FLG";
  my($h_end,$h_tro,$h_rnx,$h_chr) = &rdUltFlg($ultFil);
  my $T = &gtUltVrs($h_end,$h_chr);
  &setUserVar($bpe,"T",$T);

# Compare broadcast with 1-day predicted orbits
# ---------------------------------------------
  $PGMNAM = "ORBCMP";
  $bpe->RUN_PGMS($PGMNAM);

# Merge various orbits
# --------------------
  my $orbFil1= "${dirPre}ORBMRG_1.${extPre}";
  my $orbFil2= "${dirPre}ORBMRG_2.${extPre}";
  my $orbMrg = "${dirPre}CODE${ssss}.${extPre}";

# Consider special a priori orbits when available
# -----------------------------------------------
  my $orbPredicted = "${dirPre}${v_o}_${yyddd}.${extPre}";
  my $prn;

  unless (-f $orbPredicted) {
      prtMess($bpe,"orbPredicted file does not exist!");
      die;
  }

  my $manFil = "${CAMP_PTH}${CAMPAIGN}/MSC/REPOSITIONING.FLG";
  if(-e $manFil) {
    open(FIL,"<$manFil");
    while(<FIL>) {
      $prn=substr($_,0,3);
    }
    print "PRN: $prn ";
    close(FIL);
##    system("$ENV{AUTO}/replace.com $orbPredicted $prn 'G00'");}
    replace($orbPredicted,$prn,'G00');
  }

  my $manFil2 = "${CAMP_PTH}${CAMPAIGN}/MSC/REPOSITIONING2.FLG";
  if(-e $manFil2) {
    open(FIL2,"<$manFil2");
    while(<FIL2>) {
      $prn=substr($_,0,3);
    }
    print "PRN: $prn ";
    close(FIL2);
##    system("$ENV{AUTO}/replace.com $orbPredicted $prn 'G00'");}
    replace($orbPredicted,$prn,'G00');
    }

  my $manFil3 = "${CAMP_PTH}${CAMPAIGN}/MSC/REPOSITIONING3.FLG";
  if(-e $manFil3) {
    open(FIL3,"<$manFil3");
    while(<FIL3>) {
      $prn=substr($_,0,3);
    }
    print "PRN: $prn ";
    close(FIL3);
##    system("$ENV{AUTO}/replace.com $orbPredicted $prn 'G00'");}
    replace($orbPredicted,$prn,'G00');
  }

  my $manFil4 = "${CAMP_PTH}${CAMPAIGN}/MSC/REPOSITIONING4.FLG";
  if(-e $manFil4) {
    open(FIL4,"<$manFil4");
    while (<FIL4>) {
      $prn=substr($_,0,3);
    }
    print "PRN: $prn ";
    close(FIL4);
##    system("$ENV{AUTO}/replace.com $orbPredicted $prn 'G00'");}
    replace($orbPredicted,$prn,'G00');
  }

  copyfile("$orbPredicted","$orbMrg");

  my $orbAppend = "${dirPre}APR${yyddd}.$extPre";

  if(-e $orbAppend){
    prtMess($bpe,"SPECIAL_A_PRIORI_ORBITS_CONSIDERED");

    copyfile("$orbMrg","$orbFil1");
    copyfile("$orbAppend","$orbFil2");

    $PGMNAM = "CCPREORB";
    $bpe->RUN_PGMS($PGMNAM);

  } else {
    prtMess($bpe,"NO_SPECIAL_A_PRIORI_ORBITS_FOUND");
  }

# Consider endless orbit predictions
# ----------------------------------
  $orbAppend = "${dirPre}EXT${yyddd}.${extPre}";
  if(-e $orbAppend) {
    prtMess($bpe,"ENDLESS_ORBIT_PREDICTIONS_CONSIDERED");

    copyfile("$orbMrg","$orbFil1");
    copyfile("$orbAppend","$orbFil2");

    $PGMNAM = "CCPREORB";
    $bpe->RUN_PGMS($PGMNAM);

  } else {
    prtMess($bpe,"NO_ENDLESS_ORBIT_PREDICTIONS_FOUND");
  }

# Consider new (ALL-GNSS) broadcast orbits
# ----------------------------------------
  $orbAppend = "${dirPre}${v_a}_${yyddd}.${extPre}";

  if(-e $orbAppend) {
    prtMess($bpe,"NEW_GNSS_BROADCAST_ORBITS_CONSIDERED");

    copyfile("$orbMrg","$orbFil1");
    copyfile("$orbAppend","$orbFil2");

    $PGMNAM = "CCPREORB";
    $bpe->RUN_PGMS($PGMNAM) unless "$yyddd" == "24027" || "$yyddd" == "24076";

  } else {
    prtMess($bpe,"NO_NEW_GNSS_BROADCAST_ORBITS_FOUND");
  }

# Consider 2-day predicted orbits
# -------------------------------
  $orbAppend = "${dirPre}${v_o}2${yyddd}.${extPre}";
  if(-e $orbAppend) {
    prtMess($bpe,"2-DAY_PREDICTED_ORBITS_CONSIDERED");

    copyfile("$orbMrg","$orbFil1");
    copyfile("$orbAppend","$orbFil2");

    $PGMNAM = "CCPREORB";
    $bpe->RUN_PGMS($PGMNAM);

  } else {
    prtMess($bpe,"NO_2-DAY_PREDICTED_ORBITS_FOUND");
  }

# Check whether merged PRE file available
# ---------------------------------------
  if(not -e $orbMrg) {
    prtErr($bpe,"CODE${ssss}.${extPre}_NOT_FOUND");
  }

# Copy 1-day predicted ERP file for following ORBGEN run
# ------------------------------------------------------
  my $inpFil = "${dirErp}ULT${wwwwdm1}.${extErp}";  # 13-Jan-2014 SL
  my $outFil = "${dirErp}CODE${ssss}.${extErp}";
  if(-e $inpFil) {
    &copyfile($inpFil,$outFil);
  } else {
    prtErr($bpe,"CODE${ssss}.${extErp}_NOT_FOUND");
  }

}

# =============================================================================

__END__
