package POLUPD;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  POLUPD
#
# Purpose :  Execute POLUPD
#
# PARAMs  :
#
# Author  :  M. Meindl
# Created :  20-Oct-2003
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# Define variables
# ----------------
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};

# Run program
# -----------
  my $PGMNAM = "POLUPD";
  $bpe->RUN_PGMS($PGMNAM);

# Extract warnings from protocol files
# ------------------------------------
  getWarn($bpe,"${CAMP_PTH}${CAMPAIGN}/OUT/SLRPRED.ERR");

}
