package ATL_REF;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  ATL_REF
#
# Purpose :  Execute GRDS1S2 and update created file in REF if indicated
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  22-Feb-2012
#
# Changes :  __-___-____/__:
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;
use File::Compare qw(compare);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($crdInf, $atlInf,
      $dirCrd, $extCrd) =
    $bpe->getKeys('V_CRDINF', 'V_ATLINF',
                  'DIR_CRD', 'EXT_CRD');

# Update not allowed
# ------------------
  unless ($$bpe{V_UPD} eq "Y") {
    prtMess($bpe,"FILES NOT UPDATED");
    return;
  }

# Run program
# -----------
  my $PGMNAM = "GRDS1S2";
  $bpe->RUN_PGMS($PGMNAM);

  my $filUpd = "${dirCrd}${atlInf}.ATL";
  my $filRef = "$ENV{REF}/${atlInf}.ATL";
  my $filBak = "$ENV{REF}/${atlInf}.ATL_BAK";
  if (compare($filUpd,$filRef)) {
    copy($filRef,$filBak);
    copy($filUpd,$filRef);
    msg2key("MSC","${atlInf}.ATL updated in REF directory") }

}
