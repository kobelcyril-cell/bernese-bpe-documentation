package SKIP_SOL;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  SKIP_SOL
#
# Purpose :  Skip 3-day solution if indicated
#
# Programs:
#
# Author  :  A. Villiger
# Created :  15-Jul-2020
#
# Changes :
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Define variables
# ----------------
  my $skipsol   = $$bpe{V_SKIP3D};
  my $goto      = $$bpe{PARAM2};

  if($skipsol eq "Y"){
    prtMess($bpe,"3-DAY SOLUTION SKIPPED");
    prtGoto($bpe,$goto);
  }

}
