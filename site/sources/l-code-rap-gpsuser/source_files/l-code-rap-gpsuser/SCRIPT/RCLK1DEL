package RCLK1DEL;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RCLK1DEL
#
# Purpose :  Clean up the campaign
#            (delete all files with a delay of 5 sessions)
#
# PARAMs  :  PARAM1 = "TODAY" - delete all files for the current session
#                   = "-n" or "-(nn)" - used to redefine the number of
#                               sessions for deletion delay
#
# Author  :  R. Dach
# Created :  23-Jun-2009
#
# Changes :  25-Mar-2015 AS: MPRXTR-satellite statistics added
#            07-Jul-2015 SS: Remove .BIA files
#            05-Aug-2015 SS: Renamed processing summary file
#            18-May-2016 SS: Remove .OSB files
#            07-Jun-2016 RD: Add version with compatible attitude modelling
#            15-Jul-2016 AV: Add ifb outlier detection files
#            10-Oct-2016 RD: Remove version with compatible attitude modelling
#            22-Apr-2020 ST: There should be no more $A0 to delete
#            14-Jul-2020 RD/PF: change $X/GEN -> PTH_SATCRUX
#            01-Sep-2020 AV: Add CLKyyddd.SUM
#            13-Aug-2021 RD: Start using BSW-style filenameing in the campaign area
#            07-Apr-2022 ST: Remove DIR_BRD and EXT_BRD.
#            03-Nov-2022 AV: Del RINEX3 clock file $Q_yyyyssss.CLK
#            25-Sep-2024 RD: Delete OBSXTR files
#
# ============================================================================

use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $yyyy, $ssss, $yyddd, $ddd,
      $param1, $taskId,
      $v_a,$v_b,$v_c,$v_e,$v_h,$v_i,$v_k,$v_o,$v_q,$v_u,$v_w,$v_del,
      $dirClk, $dirCzh, $dirCzo, $dirDcb, $dirDel,
      $extClk, $extCzh, $extCzo, $extDcb, $extDel,
      $dirEdt, $dirErp, $dirLst, $dirOut, $dirPre, $dirRes,
      $extEdt, $extErp, $extLst, $extOut, $extPre, $extRes,
      $dirPzh, $dirPzo, $dirRxc, $dirSme, $dirSmc, $dirStd,
      $extPzh, $extPzo, $extRxc, $extSme, $extSmc, $extStd,
      $dirSum, $dirTrp, $dirRxo, $dirSmt, $dirNeq, $dirClb,
      $extSum, $extTrp, $extRxo, $extSmt, $extNeq, $extClb,
      $dirSig, $dirSos, $dirCrd, $dirRxn, $pthSatcrx, $dirGrd,
      $extSig, $extSos, $extCrd, $extRxn, $extSatcrx, $extGrd,
      $dirIon, $dirOsb, $dirBia, $dirLog, $dirPrt,
      $extIon, $extOsb, $extBia, $extLog, $extPrt
      ) =
    $bpe->getKeys(
      '$YSS-5','$Y+0', '$S-5','$YD-5','$-5',
      'PARAM1','TASKID',
      'V_A','V_B','V_C','V_E','V_H','V_I','V_K','V_O','V_Q','V_U','V_W','V_DEL',
      'DIR_CLK', 'DIR_CZH', 'DIR_CZO', 'DIR_DCB', 'DIR_DEL',
      'EXT_CLK', 'EXT_CZH', 'EXT_CZO', 'EXT_DCB', 'EXT_DEL',
      'DIR_EDT', 'DIR_ERP', 'DIR_LST', 'DIR_OUT', 'DIR_PRE', 'DIR_RES',
      'EXT_EDT', 'EXT_ERP', 'EXT_LST', 'EXT_OUT', 'EXT_PRE', 'EXT_RES',
      'DIR_PZH', 'DIR_PZO', 'DIR_RXC', 'DIR_SME', 'DIR_SMC', 'DIR_STD',
      'EXT_PZH', 'EXT_PZO', 'EXT_RXC', 'EXT_SME', 'EXT_SMC', 'EXT_STD',
      'DIR_SUM', 'DIR_TRP', 'DIR_RXO', 'DIR_SMT', 'DIR_NEQ', 'DIR_CLB',
      'EXT_SUM', 'EXT_TRP', 'EXT_RXO', 'EXT_SMT', 'EXT_NEQ', 'EXT_CLB',
      'DIR_SIG', 'DIR_SOS', 'DIR_CRD', 'DIR_RXN', 'PTH_SATCRUX', 'DIR_GRD',
      'EXT_SIG', 'EXT_SOS', 'EXT_CRD', 'EXT_RXN', 'EXT_SATCRUX', 'EXT_GRD',
      'DIR_ION', 'DIR_OSB', 'DIR_BIA', 'DIR_BPELOG', 'DIR_BPEPRT',
      'EXT_ION', 'EXT_OSB', 'EXT_BIA', 'EXT_BPELOG', 'EXT_BPEPRT'
      );

# Redefine the date if necessary
 if ( uc $param1 eq "TODAY" ) {
   ($yyssss, $ssss, $yyddd, $ddd) =
   $bpe->getKeys('$YSS+0','$S+0','$YD+0','$+0')
 } elsif ( $param1 ne "" ) {
   ($yyssss, $ssss, $yyddd, $ddd) =
   $bpe->getKeys('$YSS'.$param1,'$S'.$param1,'$YD'.$param1,'$'.$param1)
 }

 my $yy_ssss = substr($yyssss,0,2) . "_" . $ssss;

# Delete Files if requested
# -------------------------

 if ( ${v_del} eq "Y" )
  {

#       unlink("${dirSatcrx}/CLK${yyssss}.${extSatcrx}");
       unlink glob "$dirOut*.J_lk";

# ATM
       unlink glob("${dirTrp}??_${yyssss}.$extTrp");
       unlink glob("${dirIon}HOI${yyddd}.$extIon");

# BPE
       unlink glob("${dirLog}${taskId}${yyssss}_???_???.$extLog");
       unlink glob("${dirPrt}${taskId}${yyssss}_???_???.$extPrt");

# GRD
       unlink glob("${dirGrd}???${yyddd}.$extGrd");

# OBS
       unlink glob("${dirCzh}????${ssss}.$extCzh");
       unlink glob("${dirCzo}????${ssss}.$extCzo");
       unlink glob("${dirPzh}????${ssss}.$extPzh");
       unlink glob("${dirPzo}????${ssss}.$extPzo");

# ORB
       unlink glob("${dirErp}${v_k}_${yyssss}.${extErp}");
       unlink glob("${dirPre}${v_k}_${yyssss}.${extPre}");
       unlink glob("${dirStd}${v_k}_${yyssss}.${extStd}");
       unlink glob("${dirClk}${v_a}_${yyssss}.${extClk}");
       unlink glob("${dirClk}${v_w}1${yyssss}.${extClk}");
       unlink glob("${dirClk}${v_e}_${yyssss}.${extClk}");
       unlink glob("${dirClk}${v_q}_${yyssss}.${extClk}");
       unlink glob("${dirClk}${v_h}_${yyssss}.${extClk}");
       unlink glob("${dirClk}${v_u}_${yyssss}.${extClk}");
       unlink glob("${dirClk}${v_u}P${yyssss}.${extClk}");
##       unlink glob("${dirDcb}${v_u}_${yyssss}.${extDcb}");
##       unlink glob("${dirDcb}${v_u}_${yyssss}.F");
##       unlink glob("${dirDcb}${v_c}_${yyssss}.F");
##       unlink glob("${dirDcb}${v_c}F${yyssss}.F");
##       unlink glob("${dirDcb}${v_c}S${yyssss}.F");
##       unlink glob("${dirDcb}${v_c}_${yyssss}.${extDcb}");
##       unlink glob("${dirDcb}${v_c}F${yyssss}.${extDcb}");
##       unlink glob("${dirDcb}${v_c}S${yyssss}.${extDcb}");
       unlink glob("${dirOsb}???${yyssss}.${extOsb}");
       unlink glob("${dirBia}???${yyssss}.${extBia}");

# OUT
       unlink glob("${dirOut}GPSCMP.${ddd}");
       unlink glob("${dirOut}GPSWKS.${ddd}");
       unlink glob("${dirOut}GPSXTR.${ddd}");
       unlink glob("${dirRxc}${v_w}1${yyssss}.${extRxc}");
       unlink glob("${dirOut}${v_w}1${yyssss}.DIF");
       unlink glob("${dirOut}${v_w}1${yyssss}.IFO");
       unlink glob("${dirOut}${v_w}1${yyssss}.${extOut}");
       unlink glob("${dirOut}${v_w}1${yyssss}.PRC");
       unlink glob("${dirOut}${v_w}_${yyssss}.${extOut}");
       unlink glob("${dirRxc}${v_w}_${yyssss}.${extRxc}");
       unlink glob("${dirRxc}${v_e}_${yyssss}.${extRxc}");
       unlink glob("${dirOut}${v_e}_${yyssss}.DIF");
       unlink glob("${dirOut}${v_e}_${yyssss}.IFO");
       unlink glob("${dirOut}${v_e}_${yyssss}.${extOut}");
       unlink glob("${dirOut}${v_e}_${yyssss}.PRC");
       unlink glob("${dirOut}${v_c}${ssss}???.${extOut}");
       unlink glob("${dirSum}${v_c}G${yyssss}.${extSum}");
       unlink glob("${dirOut}${v_c}_${yyssss}.${extOut}");
#       unlink glob("${dirSum}${v_c}S${yyssss}.${extSum}.[0-9]");
       unlink glob("${dirSum}${v_c}S${yyssss}_.${extSum}");
       unlink glob("${dirSum}${v_c}S${yyssss}.${extSum}");
       unlink glob("${dirOut}${v_c}S${yyssss}.${extOut}");
       unlink glob("${dirOut}${v_c}F${yyssss}.${extOut}");
       unlink glob("${dirOut}CLK${yyssss}.PRC");
       unlink glob("${dirOut}RCLKGNSS.${yy_ssss}");
       unlink glob("${dirOut}CODXTR.${yy_ssss}");
       unlink glob("${dirOut}${v_b}${ssss}???.${extOut}");
       unlink glob("${dirOut}${v_b}${ssss}???_.${extOut}");
       unlink glob("${dirOut}${v_b}${ssss}???__.${extOut}");
       unlink glob("${dirRes}${v_b}${ssss}???.${extRes}");
       unlink glob("${dirSum}${v_b}G${yyssss}.${extSum}");
       unlink glob("${dirOut}${v_b}R${yyssss}.${extOut}");
       unlink glob("${dirEdt}${v_b}_${yyssss}.${extEdt}");
       unlink glob("${dirLst}${v_b}_${yyssss}.${extLst}");
       unlink glob("${dirSum}${v_b}_${yyssss}.${extSum}");
       unlink glob("${dirOut}${v_i}${ssss}???.${extOut}");
       unlink glob("${dirRes}${v_i}${ssss}???.${extRes}");
       unlink glob("${dirSum}${v_i}G${yyssss}.${extSum}");
       unlink glob("${dirOut}${v_i}R${yyssss}.${extOut}");
       unlink glob("${dirLst}${v_i}_${yyssss}.${extLst}");
       unlink glob("${dirSum}${v_i}_${yyssss}.${extSum}");
       unlink glob("${dirRxc}${v_q}A${yyssss}.${extRxc}");
       unlink glob("${dirRxc}${v_q}S${yyssss}.${extRxc}");
       unlink glob("${dirOut}${v_q}A${yyssss}.${extOut}");
       unlink glob("${dirOut}${v_q}C${yyssss}.PRC");
       unlink glob("${dirRxc}${v_q}N${yyssss}.${extRxc}");
       unlink glob("${dirRxc}${v_q}_${yyssss}.${extRxc}");
       unlink glob("${dirRxc}${v_q}_${yyyy}${ssss}.${extRxc}");
       unlink glob("${dirSum}MPR${yyssss}.${extSum}");
       unlink glob("${dirSum}MPS${yyssss}.${extSum}");
       unlink glob("${dirOut}MPR${ssss}???.${extOut}");
       unlink glob("${dirOut}MPRXTR.${yy_ssss}");
       unlink glob("${dirOut}OBS${ssss}???.${extOut}");
       unlink glob("${dirLst}ORB${yyssss}.${extLst}");
       unlink glob("${dirOut}ORB${yyssss}.${extOut}");
       unlink glob("${dirOut}RESCHK.${yy_ssss}");
       unlink glob("${dirOut}RNXERR.${yy_ssss}");
       unlink glob("${dirSmc}SMT${ssss}???.${extOut}");
       unlink glob("${dirSmc}SMT${yyssss}.${extSmc}");
       unlink glob("${dirDel}SPP${yyssss}.${extDel}");
       unlink glob("${dirRxc}SPP${ssss}???.${extRxc}");
       unlink glob("${dirOut}SPP${ssss}???.${extOut}");
       unlink glob("${dirOut}SP2${ssss}???.${extOut}");
       unlink glob("${dirOut}OBX_EDT_${yyssss}.${extOut}");
       unlink glob("${dirSum}OBX_EDT_${yyssss}.${extSum}");
       unlink glob("${dirOut}OBX_AMB_${yyssss}.${extOut}");
       unlink glob("${dirSum}OBX_AMB_${yyssss}.${extSum}");
       unlink glob("${dirRxc}${v_h}${ssss}???.${extRxc}");
       unlink glob("${dirOut}${v_h}${ssss}???.${extOut}");
       unlink glob("${dirRes}${v_h}${ssss}???.${extRes}");
       unlink glob("${dirSum}${v_h}G${yyssss}.${extSum}");
       unlink glob("${dirOut}${v_h}R${yyssss}.${extOut}");
       unlink glob("${dirRxc}${v_h}_${yyssss}.${extRxc}");
       unlink glob("${dirEdt}${v_h}_${yyssss}.${extEdt}");
       unlink glob("${dirLst}${v_h}_${yyssss}.${extLst}");
       unlink glob("${dirOut}${v_h}_${yyssss}.${extOut}");
       unlink glob("${dirSum}${v_h}_${yyssss}.${extSum}");
       unlink glob("${dirOut}TD_${yyssss}.${extOut}");
       unlink glob("${dirSum}TD_${yyssss}.${extSum}");
       unlink glob("${dirOut}${v_u}0${yyssss}.${extOut}");
       unlink glob("${dirRxc}${v_u}${ssss}???.${extRxc}");
       unlink glob("${dirOut}${v_u}${ssss}???.${extOut}");
       unlink glob("${dirRes}${v_u}${ssss}???.${extRes}");
       unlink glob("${dirSum}${v_u}A${yyssss}.${extSum}");
       unlink glob("${dirSum}${v_u}G${yyssss}.${extSum}");
       unlink glob("${dirOut}${v_u}P${yyssss}.${extOut}");
       unlink glob("${dirRxc}${v_u}P${yyssss}.${extRxc}");
       unlink glob("${dirOut}${v_u}R${yyssss}.${extOut}");
       unlink glob("${dirRxc}${v_u}_${yyssss}.${extRxc}");
       unlink glob("${dirLst}${v_u}_${yyssss}.${extLst}");
       unlink glob("${dirOut}${v_u}_${yyssss}.${extOut}");
       unlink glob("${dirSmc}${v_u}_${yyssss}.${extSmc}");
       unlink glob("${dirSme}${v_u}_${yyssss}.${extSme}");
       unlink glob("${dirSum}${v_u}_${yyssss}.${extSum}");
       unlink glob("${dirOut}TQ_${yyssss}.${extOut}");
       unlink glob("${dirSum}TQ_${yyssss}.${extSum}");
       unlink glob("${dirDel}RNX${yyssss}.${extDel}");
       unlink glob("${dirDel}SPP${yyssss}.${extDel}");
       unlink glob("${dirOut}CLK${yyddd}.SUM");

# RAW
       unlink glob("${dirRxn}????${ssss}.$extRxn");
       unlink glob("${dirRxo}????${ssss}.$extRxo");
       unlink glob("${dirSmt}*${ssss}.$extSmt");
       unlink glob("${dirRxo}*${ssss}.??O");

# SOL
       unlink glob("${dirNeq}${v_c}${ssss}???.$extNeq");
       unlink glob("${dirNeq}${v_u}${ssss}???.$extNeq");
       unlink glob("${dirNeq}${v_u}_${yyssss}.$extNeq");
       unlink glob("${dirNeq}${v_c}_${yyssss}.$extNeq");
#       unlink glob("${dirNeq}${v_c}F${yyssss}.$extNeq");
#       unlink glob("${dirNeq}${v_c}S${yyssss}.$extNeq");
#       unlink glob("${dirNeq}TD_${yyssss}.$extNeq");
#       unlink glob("${dirNeq}TQ_${yyssss}.$extNeq");

# STA
       unlink glob("${dirClb}${v_c}${ssss}??.${extClb}");
       unlink glob("${dirClb}${v_b}${ssss}??.${extClb}");
       unlink glob("${dirClb}${v_e}${ssss}??.${extClb}");
       unlink glob("${dirClb}${v_i}${ssss}??.${extClb}");
       unlink glob("${dirClb}${v_h}${ssss}??.${extClb}");
       unlink glob("${dirClb}${v_k}${ssss}??.${extClb}");
       unlink glob("${dirClb}${v_u}${ssss}??.${extClb}");
       unlink glob("${dirClb}${v_q}${ssss}??.${extClb}");
       unlink glob("${dirClb}${v_u}_${ssss}001.${extClb}");
       unlink glob("${dirSig}${v_w}_${yyssss}.${extSig}");
       unlink glob("${dirSos}${v_i}0${yyssss}.${extSos}");
       unlink glob("${dirSos}${v_i}_${yyssss}.${extSos}");
       unlink glob("${dirCrd}${v_o}_${yyssss}.${extCrd}");
       unlink glob("${dirCrd}${v_k}_${yyssss}.${extCrd}");
       unlink glob("${dirCrd}RCLK${yyssss}.${extCrd}");
       unlink glob("${dirCrd}${v_u}_${yyssss}.${extCrd}");

   }
  else
   {prtMess($bpe,"FILES NOT DELETED");}

}
