package REPC_SAV;
@ISA = ("RUNBPE");
# ==========================================================================
#
# Name    :  REPC_SAV
#
# Purpose :  Copy result files into the archive (from clock reprocessing)
#
# Programs:
#
# Author  :  R. Dach
# Created :  23-Jun-2009
#
# Changes :  30-Sep-2014 LP: Change GPS=>G for $v_gnss
#            06-Jun-2018 SS: Prepared for REPRO_IAR
#
# ==========================================================================

use strict;

use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;

use lib "$ENV{BPE}";
use bpe_util;

use File::Copy;

# --------------------------------------------------------------------------

sub run {
    my $bpe = shift;

# Define variables
# ----------------
my  ($yyssss, $yy, $yyyy, $ssss,
      $v_sav, $v_gnss, $v_q, $v_u, $v_qq, $v_uu, $v_c,
      $camp_pth, $campaign,
      $dirOut, $dirNeq, $dirClk, $dirRxc, $dirDcb, $dirClb,
      $extOut, $extNeq, $extClk, $extRxc, $extDcb, $extClb
    ) = $bpe->getKeys
    ('$YSS+0', '$Y', '$Y+0', '$S+0',
     'V_SAV','V_GNSS','V_Q','V_U','V_QQ','V_UU','V_C',
     'CAMP_PTH','CAMPAIGN',
     'DIR_OUT','DIR_NEQ','DIR_CLK','DIR_RXC','DIR_DCB','DIR_CLB',
     'EXT_OUT','EXT_NEQ','EXT_CLK','EXT_RXC','EXT_DCB','EXT_CLB'
    );


# Some directories
# ----------------
    my $dirSav = $v_gnss eq "G" ? "$PATH_SAV/$CAMP_SAVREP/$yyyy/" :
                                  "$PATH_SAV/$CAMP_SAVREP/$yyyy/";
    #    $dirSav = "$PATH_SAV/REPRO_IAR/$yyyy/";
    $dirSav = "$PATH_SAV/RCLKGNSS/$yyyy/";
    my $orbSav = "$dirSav/ORB/";
    my $outSav = "$dirSav/OUT/";
    my $solSav = "$dirSav/SOL/";
    my $staSav = "$dirSav/STA/";

    check_dir($orbSav,$outSav,$solSav,$staSav) if ( $v_sav eq "Y" );

# Extract the title of the reprocessing
# -------------------------------------
    my $repro = "$camp_pth$campaign/MSC/REPROCESSING.FLG";
    open(REP,"$repro");
    my $tit = <REP>;
    $tit = <REP>;
    close REP;
    chomp $tit;

# Copy files to savedisk
# ----------------------
    my @cpyLst = (
    "${dirDcb}${v_c}S${yyssss}.${extDcb} ${orbSav} f ",
    "${dirDcb}${v_c}F${yyssss}.${extDcb} ${orbSav} f ",
    "${dirClk}${v_q}_${yyssss}.${extClk} ${orbSav} fc",
    "${dirClk}${v_qq}_${yyssss}.${extClk} ${orbSav}${v_q}_${yyssss}_V52.${extClk} fc",
    "${dirClk}${v_u}_${yyssss}.${extClk} ${orbSav} fc",
    "${dirClk}${v_uu}_${yyssss}.${extClk} ${orbSav}${v_u}_${yyssss}_V52.${extClk} fc",
    "${dirOut}CLKREPRO.${yy}_${ssss}     ${outSav} f ",
    "${dirRxc}${v_q}A${yyssss}.${extRxc} ${outSav} fc",
    "${dirRxc}${v_q}_${yyssss}.${extRxc} ${outSav} fc",
    "${dirRxc}${v_qq}A${yyssss}.${extRxc} ${outSav}${v_q}A${yyssss}_V52.${extRxc} fc",
    "${dirRxc}${v_qq}_${yyssss}.${extRxc} ${outSav}${v_q}_${yyssss}_V52.${extRxc} fc",
    "${dirRxc}${v_u}_${yyssss}.${extRxc} ${outSav} fc",
    "${dirRxc}${v_uu}_${yyssss}.${extRxc} ${outSav}${v_u}_${yyssss}_V52.${extRxc} fc",
    "${dirNeq}${v_c}S${yyssss}.${extNeq} ${solSav} z ",
    "${dirNeq}${v_c}F${yyssss}.${extNeq} ${solSav} z ",
    "${dirClb}${v_u}${ssss}??.${extClb}  ${staSav} f ",
    );

# Distribution not allowed
# ------------------------
    if ( $v_sav ne "Y" ) {
      prtMess($bpe,"FILES NOT SAVED");

# Do the distribution
# -------------------
    } else {

      $Set_Verify=1;

      map { copyarchive( split(" ",$_),$tit ) } @cpyLst;

      # Stop in case of errors
      $On_Error_Cont = 1;
      err_print() || die();
    }

}

# ==========================================================================
