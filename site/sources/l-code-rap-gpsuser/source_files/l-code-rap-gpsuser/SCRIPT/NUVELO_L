package NUVELO_L;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  NUVELO_L
#
# Purpose :  Find best fitting tectonic plate for all sites (on the basis of
#            the $(CRDINF).VEL master file).
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  11-Mar-2025
#
# Changes :  11-Mar-2025 SS: Added list of exceptions (AMU?)
#            12-Mar-2025 SS: Some refinements
#
# ============================================================================

use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss,$crdInf,$pcfFil,$camp_pth,$campaign,$dirCrd,$dirOut) =
    $bpe->getKeys('$YS+0','V_CRDINF','PCFFIL','CAMP_PTH','CAMPAIGN','DIR_CRD','DIR_OUT');

  my $velInp = "${dirCrd}${crdInf}.VEL";
##  my $velInp = "${dirCrd}NUVELO_INIT.VEL";
  prtMess($bpe,"$velInp not found") if !-e $velInp;
  die "$velInp not found\n" if !-e $velInp;

  my $pmmRef = "$ENV{REF}/${crdInf}.PMM";
  prtMess($bpe,"$pmmRef not found") if !-e $pmmRef;
  die "$pmmRef not found\n" if !-e $pmmRef;
  my $pmmInp = "${dirCrd}${crdInf}.PMM";
  copy($pmmRef,$pmmInp);
##  $pmmInp = "${dirCrd}NNR-NUVEL1A.PMM";

  my $pldInp = "${dirCrd}${crdInf}.PLD";
  copy($velInp,$pldInp);

  $pcfFil = (split('\.',$pcfFil))[0];
  return if $pcfFil ne "IGSRAPID_" && $pcfFil ne "NUVELO";

# Get the list of tectonic plates to be considered
# ------------------------------------------------
  my @pldLst = `grep '^[A-Z][A-Z][A-Z][A-Z] ' $pmmInp | cut -c1-4 | sort -u`;
  chomp(@pldLst);

# Run program
# -----------
  my $PGMNAM = "NUVELO";

  my ($pld,$inp,$out,$out2);
  foreach $pld (@pldLst) {
    prtMess($bpe,"PLD=$pld");
    $pldOut = "${dirCrd}NUVELO_${pld}.PLD";

    open(INP,"$velInp");
    open(OUT,"> $pldOut");
    while ($inp=<INP>) {
      $out = $inp;
      if (substr($out,30,1) eq "\." && substr($out,45,1) eq "\." && substr($out,60,1) eq "\.") {
        chomp($out);
        substr($out,74,5) = " ${pld}\n";
      }
      print OUT $out;
    }
    close(INP);
    close(OUT);

    $bpe->putKey("$ENV{U}/PAN/NUVELO.INP","PMMFIL",$crdInf);
##    $bpe->putKey("$ENV{U}/PAN/NUVELO.INP","PMMFIL","NNR-NUVEL1A");
    $bpe->putKey("$ENV{U}/PAN/NUVELO.INP","VELTRN","NUVELO_${pld}");
    $bpe->putKey("$ENV{U}/PAN/NUVELO.INP","VELORS","NUVELO_${pld}");
    $bpe->putKey("$ENV{U}/PAN/NUVELO.INP","SYSOUT","NUVELO_${pld}");
    $bpe->RUN_PGMS($PGMNAM);
  }

# Search for best fitting NUVEL velocity vector
# ---------------------------------------------
  my $velOut = "${dirCrd}${crdInf}_BEST.VEL";
  $pldOut = "${dirCrd}${crdInf}_BEST.PLD";
  open(INP,"$velInp");
  open(OUT, "> $velOut");
  open(OUT2,"> $pldOut");
  while ($inp=<INP>) {
    $out  = $inp;
    $out2 = $inp;
    if (substr($out,30,1) eq "\." && substr($out,45,1) eq "\." && substr($out,60,1) eq "\.") {
      chomp($out);
##      my $sta = substr($out,0,21);
      my $sta = substr($out,5,16);
      my $vx0 = substr($out,21,15);
      my $vy0 = substr($out,36,15);
      my $vz0 = substr($out,51,15);
      my $vBest = 1e9;
      my $pldBest = "";
      my $linBest = "";
      my @vLoop = ();
      foreach $pld (@pldLst) {
        my $lin = `grep '$sta' ${dirCrd}NUVELO_$ {pld}.VEL`;
        chomp($lin);
        my $vx = substr($lin,21,15);
        my $vy = substr($lin,36,15);
        my $vz = substr($lin,51,15);
        my $v  = sqrt(($vx-$vx0)**2+($vy-$vy0)**2+($vz-$vz0)**2);
        push(@vLoop,$v);
        my $pld0 = substr($lin,75,4);
        if ($v<$vBest) {
          $vBest = $v;
          $pldBest = $pld0;
          $linBest = $lin;
          my $v0 = sprintf("%15.5f",$v);
##          print "TEST_ALL: $sta $v0 $pld0\n";
        }
        $vBest = sprintf("%15.5f",$vBest);
      }
##      print "TEST_BEST: $sta $vBest $pldBest\n";
      my @vSort = sort { $b <=> $a } @vLoop;
      my $ratio = 1;
      $ratio = $vSort[-2]/$vSort[-1] if $vSort[-1]!=0.00000;
      $ratio = sprintf("%7.3f",$ratio);

      my $flgRef = substr($out,70,4);
      my $pldRef = substr($out,75,4);
      my $modRef = "N";
      if ($pldRef ne "" && lindex($pldRef,@pldLst)!=-1) { $modRef = "Y" }
      my $modRep = " ";
      if ($pldRef eq "" )         { $modRep = "+" }
      elsif ($pldRef eq $pldBest) { $modRep = "." }
      elsif ($modRef eq "Y")      { $modRep = "?" }
      else                        { $modRep = "!" }
      my $str = "$modRep";
      $str = $str." $pldRef/$pldBest" if $pldRef ne "" && $pldRef ne $pldBest;
      my $rem = "$str";
      if ($modRep eq "?") { $pldBest = $pldRef; $linBest = $inp }
      substr($out,74,5) = " $pldBest$rem\n";
      my $tmp = $out;
      chomp($tmp);
      prtMess($bpe,"BEST: $vBest $ratio $modRef $tmp");
      print "BEST: $vBest $ratio $modRef $out";
      $out2 = $out;

# Take over NUVEL velocity vector?
      my $incVel = 0;
##      $incVel = 1 if substr($flgRef,0,3) eq "NNR";
      $incVel = 1;
      substr($out2,21,45) = substr($linBest,21,45) if $incVel;

# List of exceptions
      $out  = $inp if substr($sta,0,3) eq "AMU";
      $out2 = $inp if substr($sta,0,3) eq "AMU";

# Truncate additional comment
      $out = substr($out,0,79)."\n";
    }
    print OUT  $out;
    print OUT2 $out2;
  }
  close(INP);
  close(OUT);
  close(OUT2);

}
