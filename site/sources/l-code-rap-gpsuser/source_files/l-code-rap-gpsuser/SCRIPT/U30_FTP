use warnings;

# Local packages
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use newFTP;
use cddis_curl;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,$yydddp1,$wwwwdp1,$dddp1,$yyyyp1,
    $V_O,$V_I,
    $dirIep,$extIep,
    $dirOut,
    $dirPre,$extPre,
    $dirStd,$extStd,
  ) =
  $bpe->getKeys(
    '$YD+0','$YD+1','$WD+1','$+1','$Y+1',
    'V_O','V_I',
    'DIR_IEP','EXT_IEP',
    'DIR_OUT',
    'DIR_PRE','EXT_PRE',
    'DIR_STD','EXT_STD',
  );

# Check hour and whether next update already available
# ----------------------------------------------------
  my $ultFil = "$dirOut/../MSC/ULT${yyddd}.FLG";
  my $newFil = "${dirStd}${V_O}_${yydddp1}.${extStd}";
  my($h_end,$h_tro,$h_rnx,$h_chr) = &rdUltFlg($ultFil);
  my $T = &gtUltVrs($h_end,$h_chr);

  my $ultLin   = -e $ultFil ? `cat $ultFil` : "24 23 23 0";
  my $hour_end = substr($ultLin,0,2);

  if($hour_end >= 21 and !-e $newFil) {

# Make ACC summary file
# ---------------------
    system("$ENV{AUTO}/make_accsum.com $dddp1 $yyyyp1 06 $dirOut ${V_I}_$yyddd ULTRA_06");

# Distribution not allowed
# ------------------------
    if($$bpe{V_DIS} ne "Y" || -e "$ENV{HOME}/../l_code/MSC/NO_DIS.FLG") {
      prtMess($bpe,"FILES NOT DISTRIBUTED");
      return;
    }

# FTP to data centers
# -------------------
    my($ftp,$errCD,$errBG);
    my $iRun;
    my $nRun = 3;
    my $ftpSum = "${dirOut}FTP${yyddd}.U30";
    my $cu_orb = "${dirPre}US2${wwwwdp1}.${extPre}";
    my $cu_erp = "${dirIep}US2${wwwwdp1}.${extIep}";
    my $cu_orf = "cou${wwwwdp1}_06.sp3";
    my $cu_erf = "cou${wwwwdp1}_06.erp";
    my $cu_acc = "${dirOut}ULTRA_06.ACC";
    my $cu_acf = "igu_cod${wwwwdp1}_06.sum";

# FTP to CDDIS/BKG
# ----------------
    $errCD = "";
    $errBG = "";
    for($iRun=1;$iRun<=$nRun;$iRun++) {
# FTP to CDDIS
      if($errCD ne "OK") {
        $errCD = "OK";
##        open(FH,">>$ftpSum");
##        if($ftp = newFTP->new("cddisin.gsfc.nasa.gov",t=>60,v=>2,o=>*FH)) {
##          $ftp->login('aiubgps','stYs0147');
##          $ftp->cwd("/products/igu");
##          $ftp->ascii;
##          $ftp->put($cu_orb,$cu_orf);
##          $ftp->put($cu_erp,$cu_erf);
##          $ftp->put($cu_acc,$cu_acf);
##          $ftp->dir;
##          $ftp->quit;
##          $ftp->ftpOK or $errCD = "ERR";
##        } else {
##          $errCD = "ERR";
##        }
##        close FH;
        my %cddis_upload = ("$cu_orb" => "$cu_orf",
                            "$cu_erp" => "$cu_erf",
                            "$cu_acc" => "$cu_acf");
        my $irc = upload_cddis_hash(\%cddis_upload);
        $errCD = "ERR" if $irc!=0;
        prtMess($bpe,"FTP to CDDIS ended: $errCD");
      }
# FTP to BKG
      if($errBG ne "OK" && 1==2) {
        $errBG = "OK";
        my $host_bkg = "141.74.17.25";
        my $user_bkg = "code-put";
        my $port_bkg = "20022";
        open (FH,">>$ftpSum");
        if($ftp = newFTP->new($host_bkg,t=>60,v=>1, s=>1, v=>2, user=>$user_bkg, pass=>"cod4IGS+load", port=>$port_bkg, o=>*FH)) {
          $ftp->cwd("IGSac/");
          $ftp->ascii;
          $ftp->put($cu_orb,$cu_orf);
          $ftp->put($cu_erp,$cu_erf);
          $ftp->put($cu_acc,$cu_acf);
          $ftp->dir("*");
          $ftp->quit;
          $ftp->ftpOK or $errBG = "ERR";
        } else {
          $errBG = "ERR";
        }
        prtMess($bpe,"FTP to BKG ended: $errBG");
        close FH;
      }
      last if($errCD eq "OK" && $errBG eq "OK");
      sleep (60);
    }
  }
}

# =============================================================================

