package CRTULT_U;
@ISA = ("RUNBPE");
# =============================================================================
#
# Name    :  CRTULT_U
#
# Purpose :  Create ultra orbit submissions
#
# Programs:  STDPRE, PREWEI, POLXTR
#
# Author  :  M. Meindl, S. Schaer
#
# Created :  28-Jun-2004
#
# Changes :  12-Sep-2013 SL: Use &gtUltVrs, skip for old ULTRAs
#            24-Oct-2013 SL: POLXTR added
#            24-Oct-2019 SS: Automatically adjusted $titLin
#            09-Mar-2020 AV/ST: Changed option SATCLK of STDPRE
#                            from $P to $A.
#            24-Nov-2025 SS: Specify TITPRE using replaceSelLst to force SP3d
#            27-Nov-2025 SS: Add the DOI comment line to force SP3d
#
# =============================================================================

use strict;
use warnings;

# Local packages
use lib "$ENV{BPE}";
use bpe_util qw(rdUltFlg gtUltVrs prtMess setUserVar replaceSelLst);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,$ddd,$yydddm1,$yydddp1,$yyyy,$param1,$gnss,$doi,
    $CAMP_PTH,$CAMPAIGN,
    $dirIep,$extIep,
  ) =
  $bpe->getKeys(
    '$YD+0','$+0','$YD-1','$YD+1','$Y+0','PARAM1','V_GNSS','V_DOI_U',
    'CAMP_PTH','CAMPAIGN',
    'DIR_IEP','EXT_IEP',
  );
  my $PGMNAM;

# Prepare necessary info
# ----------------------
  my $ultFil = "${CAMP_PTH}${CAMPAIGN}/MSC/ULT$yyddd.FLG";
  my($h_end,$h_tro,$h_rnx,$h_chr) = &rdUltFlg($ultFil);
  my($T) = &gtUltVrs($h_end,$h_chr);
  &setUserVar($bpe,"T",$T);

  if($param1 < $T) {
    &prtMess($bpe,"SKIPPED (PARAM1<$T)");
    return;
  }
  if($T > 24) {
    &prtMess($bpe,"SKIPPED ($T>24)");
    return;
  }

  my $ultLin   = -e $ultFil ? `cat $ultFil` : "24 23 23 0";

  my $hour_end = substr($ultLin,0,2);
  my $hour_chr = substr($ultLin,9,1);
  my $sess_fin = "${yyyy}-$ddd$hour_chr";

  my $fitLen = $hour_end+24-$param1;
  if ($fitLen < 0) { $fitLen = 0 }
  my $prdLen = 48-$fitLen;

  my ($yyddd_0, $hour_0);
  if ($param1 < 24) {
    $yyddd_0 = $yydddm1;
    $hour_0 = $param1 }
  elsif ($param1 < 48) {
    $yyddd_0 = $yyddd;
    $hour_0 = $param1-24 }
  else {
    $yyddd_0 = $yydddp1;
    $hour_0 = $param1-48 }

  my $yyyyddd_0 = "20".substr($yyddd_0,0,2)."-".substr($yyddd_0,2,);
  $hour_0 = sprintf("%02d",$hour_0);

#               12345678901234567890123456789012345678901234567890123456c8901234567890123456d
  my $cenLin = "Center for Orbit Determination in Europe (CODE)";
##  my $titLin = "Ultra-Rapid $gnss orbits starting year-day $yyyyddd_0 $hour_0 hour";
  my $titLin = "Ultra-Rapid GNSS orbits starting year-day $yyyyddd_0 $hour_0 hour";
  my $addLin = "Based on last 24-hour part of a (up to 3-day) long-arc \$(GNSS) solution";
  my $remLin = "Observed/predicted: ${fitLen}/${prdLen} hours (data used up to year-session $sess_fin)";
  my $doiLin = "Product reference - DOI $doi";

# Run programs
# ------------
  $PGMNAM = "STDPRE";
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","TITLE2",$titLin);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","TITLE3",$remLin);
  my @lines = ($cenLin,$titLin,$addLin,$remLin);
# Add the DOI comment line to force SP3d
  push(@lines,$doiLin);
  replaceSelLst($bpe,$PGMNAM,"TITPRE",@lines);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","FITORB",$fitLen);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","FITCLK",$fitLen);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","NOPRED","12");
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","SATCLK","\$A_\$YD+0");
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "PREWEI";
  $bpe->RUN_PGMS($PGMNAM);

# POLXTR to extract pol epochs
# ----------------------------
  my(@o,@p);
  $PGMNAM = "POLXTR";
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","RECORD1",($param1-$T)/6+9);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","RECORD2",($param1-$T)/6+9);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","RECORD3",($param1-$T)/6+11);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","RECORD4",($param1-$T)/6+13);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","RECORD5",($param1-$T)/6+13);
  $bpe->RUN_PGMS($PGMNAM);
  open(O,"<".$bpe->getKey("$ENV{U}/INP/$PGMNAM.INP","IERSPOL"));
  push(@o,$_) while(<O>);
  close(O);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","RECORD1",($param1-$T)/6+13);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","RECORD2",($param1-$T)/6+13);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","RECORD3",($param1-$T)/6+15);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","RECORD4",($param1-$T)/6+17);
  $bpe->putKey("$ENV{U}/PAN/$PGMNAM.INP","RECORD5",($param1-$T)/6+17);
  $bpe->RUN_PGMS($PGMNAM);
  open(P,"<".$bpe->getKey("$ENV{U}/INP/$PGMNAM.INP","IERSPOL"));
  push(@p,$_) while(<P>);
  close(P);

  open(IEP,">".$bpe->getKey("$ENV{U}/INP/$PGMNAM.INP","IERSPOL"));
  print IEP $o[$_] foreach(0..6);
  print IEP $p[6];
  close(IEP);

}

# =============================================================================

__END__
