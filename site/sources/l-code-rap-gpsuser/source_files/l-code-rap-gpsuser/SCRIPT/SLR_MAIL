use strict;
use lib "$ENV{EXE}";
use lib "$ENV{BPE}";
use lib "$ENV{AUTO}";
use gpsutil;
use Gps_Date;
use bpe_util;
use File::Copy;
use File::Basename;
use newFTP;
use cddis_curl;

# overloaded 'run' method.
sub run {

  my $bpe = shift;

# CPF v1 or v2
# ------------
  my ($VCPF) = $bpe->getKeys ('V_VCPF');

# Get variables
# -------------
  my $mjd      = $$bpe{MJD};
  my $CAMP_PTH = $$bpe{CAMP_PTH};                                               
  my $CAMPAIGN = $$bpe{CAMPAIGN};
  my $warning  = $$bpe{V_WARN};

# Define pathes and filenames
# ---------------------------
  my $orbdir   = "$CAMP_PTH$CAMPAIGN/ORB";
  my $protfil  = "$CAMP_PTH$CAMPAIGN/OUT/PROTFIL.OUT";   
  my $warnfil  = "$CAMP_PTH$CAMPAIGN/OUT/$warning";
  
  my $curdir   = `pwd`;
  chomp($curdir);

# Change to ORB dir
# -----------------
  chdir $orbdir;  
 

# Mail CPF files to
# -----------------
  my $cpfUser;
#  my $cpfUser = 
####      'laser@aiubzmd.unibe.ch,'.
####      'urschl@aiub.unibe.ch';
####      'service@ranger.as.utexas.edu';
##old        'cpfpred@dgfi.badw-muenchen.de';
#wrong        'cpf_pred@dgfi.badw.de';
#        'cpfpred@dgfi.badw.de';
#        'christian.baumann@aiub.unibe.ch';
  my $subject;

# Upload CPF files to 
# -------------------
# name of DC
  my $dcNam  = "CDDIS";

# ftp-adress of DCs
##  my $dcFtp  = "cddis.gsfc.nasa.gov";
  my $dcFtp  = "cddisin.gsfc.nasa.gov";

# slr path
  my $dcPth  = "products/slr";

# user and password
  my $dcUser = "aiubgps";
  my $dcPass = "stYs0147";

# Set date
# --------
  my ($yyyy,$doy,$yymmdd,$mm,$dd,$yyddd) =
    gps_date("-mjd $mjd -o %Y %j %y%m%d %m %d %y%j");

# Open protocol file
# ------------------
  open (OUT,">$protfil") || die "Cannot open $protfil\n";
  print OUT ("\n DoY: $doy $yyyy   Day: ${dd}-${mm}-${yyyy}   MJD: $mjd\n\n");
  print OUT (" Generated CPF version $VCPF files: \n");

# Satellite names
# ---------------
  # Satellites send to CDDIS (the first x Satellites in list)
  # ------------------------
  my $nsat_cddis = 99; #send all cpf to dgfi

  my %defNames = ( "glonass1" => {"file" => "R",
                                  "SIC"  => 9100,
                                  "digit" => 2 },
                   "galileo"  => {"file" => "E",
                                  "SIC"  => 7000,
                                  "digit" => 3 },
                   "gps"      => {"file" => "G",
                                  "SIC"  => 5000,
                                  "digit" => 3 },
                  );

  my ($err1,$err2) = ('ERR','ERR');

# Loop over all satellites
# ------------------------
  my ($sat,$cpffil,$slrfil,@files,@subnam);
  my $isat = -1;
  my $nfil = 0;
  my $num_v1 = $doy + 500;
  my $num_v2 = $doy;

  foreach my $satType (keys %{defNames}) {

    # Construct the CPF name on BSW side
    my $cpfPattern = $defNames{$satType}->{"file"};
    $cpfPattern .= "?" x $defNames{$satType}->{"digit"};
    $cpfPattern .= "${yyddd}.CPF";

    # Loop the related CPF files
    foreach my $cpffil ( glob ("$orbdir/$cpfPattern") ){

      # Construct the ILRS satellite name
      my $satnam = "$satType" . substr( basename( $cpffil ), 1,  $defNames{$satType}->{"digit"});
      my $satSIC = $defNames{$satType}->{"sic"} +
                   substr( basename( $cpffil ), 1,  $defNames{$satType}->{"digit"});

      # Construct the related ILRS filename
      my $slrfil = "$orbdir/$satType";
      $slrfil .= substr( basename( $cpffil ), 1,  $defNames{$satType}->{"digit"});

      # CPF v1
      if ($VCPF == 1) {
        $slrfil .= "_cpf_${yymmdd}_${num_v1}1.cod";
      # CPF v2
      } elsif ($VCPF == 2) {
        $slrfil .= "_cpf_${yymmdd}_${num_v2}01.cod";
      # Unknown CPF version
      } else {
        prtMess($bpe,"CPF version $VCPF not implemented!");
        die("CPF version $VCPF not implemented!\n" .
            "Please check the script SLR_MAIL\n");
      }

      # Check the content of the file
      if (-s $cpffil) {
         open(CPF,$cpffil);
         my @CPFtext = <CPF>;
         close CPF;

         # First line must contain the satellite name
         if ( index($CPFtext[0],$satnam) == -1 ) {
           prtMess($bpe,"Wrong filenaming for $satnam");
           die("Wrong filenaming for satellite \"$satnam\"\n" .
               "CPFname: $cpffil\nSLRname: $slrfil\n" .
               "Content: $CPFtext[0]" .
               "Please check the script SLR_MAIL\n");
         }

         # Second line must contain the SIC number
         if ( index($CPFtext[1],"$satSIC") == -1 ) {
           prtMess($bpe,"Wrong SIC number for $satnam");
           die("Wrong SIC number for satellite \"$satnam\"\n" .
               "CPFname: $cpffil\nSLRname: $slrfil\n" .
               "Content: $CPFtext[0]" .
               "Please check the script SLR_MAIL\n");
         }

         # Rename CPF files
         copy($cpffil,$slrfil);
         unlink($cpffil);

         # Collect Files to be sent to CDDIS
         # ---------------------------------
         if ($isat<$nsat_cddis) {
           push(@files,basename($slrfil));
           push(@subnam,$satnam);
           print OUT ("  ",$slrfil,"\n");
           $nfil++;
         }
         else {
           print " CPF not sent to CDDIS: ${slrfil} \n";
         }
      }
    }
  }


# Check whether there are files that are not renamed for submission
# -----------------------------------------------------------------
  my @restFiles = glob("???${yyddd}.CPF");
  if ( @restFiles ) {
    open(WARN,">> $warnfil");
    print WARN "Remaining GPS/GLONASS CPF files that are not considered by the script SLR_MAIL for submission:\n";
    map { print WARN $_,"\n" } @restFiles;
    print WARN "Please update SLR_MAIL accordingly\n";
    close WARN;
  }

  @restFiles = glob("????${yyddd}.CPF");
  if ( @restFiles ) {
    open(WARN,">> $warnfil");
    print WARN "Remaining GALILEO CPF files that are not considered by the script SLR_MAIL for submission:\n";
    map { print WARN $_,"\n" } @restFiles;
    print WARN "Please update SLR_MAIL accordingly\n";
    close WARN;
  }

  if ($nfil eq 0) {
      print OUT ("none\n");
  }
  
  if ($nfil > 0) {

    if (0) {
# Send mail with CPF file inline
# ------------------------------
      my ($msg,$filatt,$ifil);
      $ifil = -1;

      print "\n\n--------------------- \n";
      print "Mailing CPF files to: $cpfUser\n";
      print "--------------------- \n";

# Send cpf file inline
      if ($$bpe{V_DIS} eq "Y") {
          $err1 = "OK";
          foreach $filatt (@files) {
              print "\n$filatt\n\n";
              $ifil++;
              $subject = "$subnam[$ifil] DAILY CPFS COD";
              send_mail($cpfUser, s=>$subject, f=>$filatt, m=>0) || ($err1 = "ERR");
          }
          print OUT ("\n CPF files sent to $cpfUser -> $err1\n");
      } else {
          prtMess($bpe,"FILES NOT DISTRIBUTED");
      }

   }  


# Upload CPF files to cddis
# -------------------------
      my ($ftp,$dcFile,$iRun,$nRun);
      $nRun = 6;

      if ($$bpe{V_DIS} eq "Y") {


          print "\n\n---------------------------------- \n";
          print "Uploading CPF files to datacenter: $dcNam \n";
          print "---------------------------------- \n\n";

          print "ftp to $dcFtp\n";
          print "cd $dcPth\n";
          print OUT "cd $dcPth\n";

          if (0) {
          for ($iRun=1;$iRun<=$nRun;$iRun++) {
              $err2 = "OK";
    
###              if ($ftp = newFTP->new($dcFtp,t=>60,v=>2,p=>0)) {
              if ($ftp = newFTP->new($dcFtp,t=>60,v=>2,p=>1)) {
    
                  $ftp->login($dcUser,$dcPass) or $err2 = "ERR";
                  $ftp->binary;
                  $ftp->cwd($dcPth);
                  foreach $dcFile (@files) { $ftp->put("$dcFile") };
                  $ftp->quit();
                  $ftp->ftpOK or $err2 = "ERR";
    
              } else { $err2 = "ERR" };
    
              print OUT ("\n CPF files sent to CDDIS (ftp), iRun = ${iRun} -> $err2\n");
              if ($err2 eq "OK") { last }
              sleep (600);
          }
          }
          
          # Upload to cddis https:

          upload_cddis(@files);  
 
          
      } else {
          prtMess($bpe,"FILES NOT DISTRIBUTED");    
      }
  }


  chdir $curdir;  


# Mail protocol file
# ------------------
  close (OUT);

  print "\n\n----------------- \n";
  print "Mailing protocol: $protfil \n";
  print "----------------- \n";

  $subject = "SLRPRED successfully completed: Day $doy $yyyy";
  msg2key("SLR","-f $protfil","$subject");


# Send warnings from PRT files
# -----------------------------
  my $slrWarn1 = "andrea.maier\@aiub.unibe.ch";
  my $slrWarn2 = "ulrich.meyer\@aiub.unibe.ch";
  
  if (-e $warnfil) {
     sysprint ("Mailing warning messages: $warning \n");
     $subject = "Warnings: SLR CPF Prediction for Day $doy $yyyy";
##     send_mail($slrWarn1, s=>$subject, f=>$warnfil);
     send_mail($slrWarn2, s=>$subject, f=>$warnfil);
     msg2key("SLR","-f $warnfil","$subject");
   }
   else {
     sysprint ("No warning messages mailed: $warning \n");
   }
   


# Write local time
# ----------------
  print "\n----------- \n";
  print "Local time: ".timprt."\n";
  print "----------- \n";

# Create BYE file if ftp ok
# -------------------------
  if ("$err1" eq "OK" && "$err2" eq "OK") {
      my $str = gps_date("-t -o %U / -93600 / %z / SLR_MAIL / %y%j");
      `echo '$str' > $ENV{X}/MSC/BYE_SLRPRED_FTP.SLR`;
  }

}

__END__

