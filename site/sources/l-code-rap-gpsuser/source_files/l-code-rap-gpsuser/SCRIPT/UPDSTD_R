package UPDSTD_R;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  UPDSTD_R
#
# Purpose :  Generate STD-files for all days of the n-day solution
#            (currently only useable for +0 and -2)
#
# Programs:  ORBGEN
#
# Author  :  M. Meindl
# Created :  30-Jul-2003
#
# Changes :  10-Feb-2005 mm: Old date variables removed
#            17-Nov-2005 ss: Use different ORBGEN program versions
#            18-Dec-2006 ss: Use different sat info files
#
# ----------------------------------------------------------------------------
use lib "$ENV{EXE}";
use Gps_Date;

sub run {
  my $bpe = shift;


# Get variables
# -------------
  my $PARAM1  = $$bpe{PARAM1};
  my $SOL     = $$bpe{"V_$PARAM1"};
  my ($yyddd,$dm1,$dm2) = $bpe->getKeys('$YD+0','$-1','$-2');

  my $mjd1 = gps_date("-doy $dm1 -o %J");
  my $mjd2 = gps_date("-doy $dm2 -o %J");

  print "MJD: $mjd1 $mjd2\n";

# Set correct pole file
# ---------------------
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","POLE","${SOL}_$yyddd");


# Run program (current day)
# -------------------------
  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);


# Run program (day -1)
# --------------------
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","IMPORB","${SOL}M1$dm1");
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","STDOUT","${SOL}M1$dm1");
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","RPROUT","");
##  $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/u/aiub/hugentob/GENREL/EXE") if $dm1 < 321;
##  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","SATELL","SAT_1397.I05_R18")
##    if $mjd1 < 54089;
  $bpe->RUN_PGMS($PGMNAM);


# Run program (day -2)
# --------------------
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","IMPORB","${SOL}M2$dm2");
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","STDOUT","${SOL}M2$dm2");
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","RPROUT","");
##  $bpe->putKey("$ENV{U}/PAN/MENU_PGM.INP","CMD_PATH","/u/aiub/hugentob/GENREL/EXE") if $dm2 < 321;
##  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","SATELL","SAT_1397.I05_R18")
##    if $mjd2 < 54089;
  $bpe->RUN_PGMS($PGMNAM);


}
