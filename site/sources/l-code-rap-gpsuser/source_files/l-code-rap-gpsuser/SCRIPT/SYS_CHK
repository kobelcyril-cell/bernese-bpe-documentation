package SYS_CHK;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  SYS_CHK
#
# Purpose :  Perform various relevant checks concerning:
#            - $PAN/AIUB_CMP.INP (counter)
#            - ANTEX model (number)
#            - gravitational model (validity)
#
# Programs:
#
# Author  :  S. Schaer
# Created :  07-Sep-2023
#
# Changes :  19-Sep-2023 SS: Checking established concerning three subjects
#            22-Sep-2023 SS: Point explicitly to $AUTO/check_antex.com
#            02-Sep-2024 SS: Check whether a newer GRV file is available
#            17-Oct-2024 SS: Considered day of week (dow)
#            03-Feb-2025 EB: ATX IGS20 allowed for RAPID with IG?20 coordinates
#            26-Feb-2025 SS: Send certain SMS less often
#            26-May-2025 EB: Do not remind for intentionally not updated ATX
#                            status week 2353, ignore updates 2354, 2356, 2360, 2361
#            26-Sep-2025 SS: Check whether MIDyydddm1.FLG file is available
#            24-Oct-2025 EB: System check IGc20 and ATX file change prepared
#            16-Dec-2025 SS: Ignore IGS20_2353 code for $REF/$(PCV).ATX
#            06-Jan-2026 SS: Ignore 'ANTENNA MODEL:' for $CONFIG/ANT_COD_$(PCV).PCV
#            29-Jan-2026 SS: Ignore igs20_2405.atx file
#            09-Feb-2026 SS: Do no longer ignore igs20_2405.atx (because now in accordance with igs20.atx)
#            12-May-2026 SS: Report G33-G39 data availability
#            28-May-2026 SS: Check whether SAT_yyyy.CRX for the new year is available
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use igs_device;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yyddd, $yyssss, $mjd, $wwwwd, $yydddm1,
      $cmpInf, $crdInf, $pcvInf, $pcv, $gravMod,
      $pcfFil, $dirOut) =
    $bpe->getKeys('$YD+0', '$YSS+0', '$JD+0', '$WD+0', '$YD-1',
                  'V_CMPINF', 'V_CRDINF', 'V_PCVINF', 'V_PCV', 'V_GRAVMOD',
                  'PCFFIL', 'DIR_OUT');

# Set variables
# -------------
  my $d = substr($wwwwd,4,1);
  my ($dow,$dd) = gps_date("-doy 0 -o %w %d");

  $pcfFil = (split('\.',$pcfFil))[0];

  my $tit = "${pcfFil}_${yyssss}_SYS_CHK: ";

# Check campaign table file (V_CMPINF)
# ------------------------------------
  my $cmpFil = "$ENV{PAN}/${cmpInf}.INP";
  die "$cmpFil not found\n" unless -e $cmpFil;
  my $nam = "\$PAN/${cmpInf}.INP";
  my $cmpNum = 0;
  my $cmpCnt = 0;
  open(INP,"$cmpFil");
  my $ok = 0;
  while (<INP>) {
    $ok = 0   if $ok && $_ =~ /\#\#/;
    $cmpCnt++ if $ok;
    if (substr($_,0,8) eq "CAMPAIGN") {
      $cmpNum = substr($_,8,)+0;
      $ok = 1;
    }
  }
  close(INP);
  prtMess($bpe,"Checked $nam ($cmpNum/$cmpCnt)");
  my $msg = $tit."Irregularity in $nam concerning number of campaigns ($cmpNum/$cmpCnt). Please correct ASAP.";
  msg2key("SYS",$msg) if $cmpNum!=$cmpCnt;

# Check validity of gravity field (V_GRAVMOD)
# -------------------------------------------
  my $grvFil = "$ENV{MODEL}/${gravMod}.GRV";
  die "$grvFil not found\n" unless -e $grvFil;
  my $nam = "\$MODEL/${gravMod}.GRV";

  my @grvLin = `grep '^gfct ' $grvFil | grep ' 2 ' | grep ' 0 '`;
  chomp(@grvLin);
  map { print "$_\n" } @grvLin;
  my $grvNum = @grvLin;
  die  "No C20 coefficient found in $nam\n"            if $grvNum==0;
  warn "More than one C20 coefficient found in $nam\n" if $grvNum>1;

  my $mjd0 = gps_date("-doy 0 -d +1 -o %IJ");
  my $expMax = -1e5;
  $ok = 0;
  foreach (@grvLin) {
    my $epoStr1 = (split(" ",$_))[7];
    my $epoStr2 = (split(" ",$_))[8];
    my $yyyy_mm_dd1 = substr($epoStr1,0,4)." ".substr($epoStr1,4,2)." ".substr($epoStr1,6,2);
    my $mjd1  = gps_date("-ymd $yyyy_mm_dd1 -o %IJ");
    my $yyyy_mm_dd2 = substr($epoStr2,0,4)." ".substr($epoStr2,4,2)." ".substr($epoStr2,6,2);
    my $mjd2  = gps_date("-ymd $yyyy_mm_dd2 -o %IJ");
    prtMess($bpe,"GRV data interval: $epoStr1/$mjd1 $epoStr2/$mjd2");
    $ok++ if $mjd0>=$mjd1 && $mjd0<$mjd2;
    my $exp = $mjd2-$mjd0;
    $expMax = $exp if $exp>$expMax;
  }
  my $str = $ok ? "valid" : "invalid";
  prtMess($bpe,"Checked $nam ($str)");
  $msg = $tit."$nam $str";
  msg2key("SYS",$msg) unless $ok;
  prtMess($bpe,"Checked $nam (expires in $expMax days)");
  $msg = $tit."$nam expires soon (in $expMax days)";
  msg2key("SYS",$msg) if $expMax<=30 && $pcfFil eq "IGSRAPID";

# Check whether a newer GRV file is available
# -------------------------------------------
  my $newFil = "${gravMod}.GRV";
  if (substr($newFil,0,10) eq "COSTG_FSM_") {
      substr($newFil,10,4) = "????" }
  else { die "Unchecked GRV model: $grvFil\n" }
  prtMess($bpe,"Checked GRV files: $newFil");
  $newFil = (glob("$ENV{MODEL}/$newFil"))[-1];
  if (basename($newFil) ne basename($grvFil)) {
    $nam = "\$MODEL/".basename($newFil);
    $msg = "$nam is newer than the currently used GRV model";
    prtMess($bpe,$msg);
    $msg = $tit.$msg;
    msg2key("SYS",$msg) if ($pcfFil eq "IGSRAPID" && $dow==1 && $dd<=7);
  } else {
    prtMess($bpe,"$nam corresponds to latest GRV model");
  }

# Check whether MIDyydddm1.FLG file is available
# ----------------------------------------------
  my $midFil = "${dirOut}../MSC/MID${yydddm1}.FLG";
  $nam = basename($midFil);
  if (!-e $midFil && $pcfFil eq "IGSRAPID") {
    $msg = $tit."$nam not found. Please restart RCLKGNSS_${yydddm1}0 to generate middle-day solution.";
    msg2key("SYS",$msg);
    prtMess($bpe,$msg);
    prtMess($bpe,"$nam not found");
  } elsif (-e $midFil) {
    prtMess($bpe,"$nam found");
  }

# Check whether SAT_yyyy.CRX for the new year is available
# --------------------------------------------------------
  my ($yyyyp) = gps_date("-yd $yyddd -d +15 -o %Y");
  my $crxFil = "$ENV{CONFIG}/SAT_${yyyyp}.CRX";
  $nam = basename($crxFil);
  if (!-e $crxFil && $pcfFil eq "IGSRAPID") {
    $msg = $tit."$nam not found. Please create $nam for the new year ($yyyyp).";
    msg2key("SYS",$msg);
    prtMess($bpe,$msg);
    prtMess($bpe,"$nam not found");
  } elsif (-e $crxFil) {
    prtMess($bpe,"$nam found");
  }

# Check ANTEX model
# -----------------
  my $atxMod = "IGS20";
# prepared a new ATX file name - to be confirmed
#  if ($wwwwd >= 24010) "IGC20";
#  if ($atxMod ne $crdInf && $pcfFil eq "IGSRAPID") {
# just make sure the last two characters to allow IG[BCDE]20 coordinates and IGS20 ATX (and also IG[CDEF].ATX)
  if (substr($atxMod,-2) ne substr($crdInf,-2) && $pcfFil eq "IGSRAPID") {
    prtMess($bpe,"ANTEX model ($atxMod) inconsistent with V_CRDINF ($crdInf)");
    die;
  }
  my $atxStr = lc($atxMod)."_[0-9][0-9][0-9][0-9].atx";
  my @atxFil = glob("$ENV{REF}/$atxStr");
  map { print "$_\n" } @atxFil;
  my $atxRef = $atxFil[-1];
##  $atxRef = $atxFil[-2] if $atxRef =~ /_2405/;
  $nam = "\$REF/".basename($atxRef);
  my $atxNam = uc((split('\.',basename($atxRef)))[0]);
  prtMess($bpe,"Latest ANTEX model: $nam");
  my @atxVrs = `grep 'SINEX CODE' $atxRef | sort -u`;
  my $atxVrs = (split(" ",$atxVrs[-1]))[0];
  my $atxNum = @atxVrs;
  $msg = "";
  $msg = $msg." SINEX CODE info not found."      if $atxNum==0;
  $msg = $msg." More than one SINEX CODE found." if $atxNum>1;
  $msg = $msg." SINEX CODE info ($atxVrs) inconsistent with filename ($atxNam)." if $atxVrs ne $atxNam;
  prtMess($bpe,"Checked $nam:$msg");
  if ($msg ne "") {
    $msg = $tit.$nam.":".$msg;
    msg2key("NEW",$msg);
  }

  my $atxFilIgs = "$ENV{REF}/".lc($atxMod).".atx";
  die "$atxFilIgs not found\n" unless -e $atxFilIgs;
  $nam = "\$REF/".basename($atxFilIgs);
  @atxVrs = `grep 'SINEX CODE' $atxFilIgs | sort -u`;
  my $atxVrsIgs = (split(" ",$atxVrs[-1]))[0];
  my $atxNumIgs = @atxVrs;
  $msg = "";
  $msg = $msg." SINEX CODE info not found."      if $atxNumIgs==0;
  $msg = $msg." More than one SINEX CODE found." if $atxNumIgs>1;
  $msg = $msg." SINEX CODE info ($atxVrsIgs) inconsistent with ref. info ($atxVrs)." if $atxVrsIgs ne $atxVrs;
  prtMess($bpe,"Checked $nam:$msg");
  if ($msg ne "") {
    $msg = $tit.$nam.":".$msg;
    msg2key("NEW",$msg);
  }

  my $atxFilCod = "$ENV{REF}/${pcv}.ATX";
  die "$atxFilCod not found\n" unless -e $atxFilCod;
  $nam = "\$REF/".basename($atxFilCod);
  @atxVrs = `grep 'SINEX CODE' $atxFilCod | grep -v 'IGS20_2353 ' | sort -u`;
  my $atxVrsCod = (split(" ",$atxVrs[-1]))[0];
  my $atxNumCod = @atxVrs;
  $msg = "";
  $msg = $msg." SINEX CODE info not found."      if $atxNumCod==0;
  $msg = $msg." More than one SINEX CODE found." if $atxNumCod>1;
  $msg = $msg." SINEX CODE info ($atxVrsCod) inconsistent with ref. info ($atxVrs). Please update $nam using \$AUTO/check_antex.com." if $atxVrsCod ne $atxVrs;
  prtMess($bpe,"Checked $nam:$msg");
  if ($msg ne "" && $pcfFil eq "IGSRAPID" && $dow==1) {
    $msg = $tit.$nam.":".$msg;
    msg2key("BPE",$msg);
##    msg2key("BPE",$msg) if ($atxVrsCod ne "IGS20_2353" || not ($atxVrs eq "IGS20_2354" || $atxVrs eq "IGS20_2356" || $atxVrs eq "IGS20_2360" || $atxVrs eq "IGS20_2361" || $atxVrs eq "IGS20_2370" || $atxVrs eq "IGS20_2375" || $atxVrs eq "IGS20_2385"));
  }

  my $pcvFil = "$ENV{CONFIG}/${pcvInf}_${pcv}.PCV";
  die "$pcvFil not found\n" unless -e $pcvFil;
  $nam = "\$CONFIG/".basename($pcvFil);
  @atxVrs = `grep '${atxMod}_' $pcvFil | grep -v 'ANTENNA MODEL:' | grep -v 'IGS20_2233' | grep -v 'IGS20_2353' | cut -c62-71 | sort -u`;
  chomp(@atxVrs);
  my $atxVrsPcv = $atxVrs[-1];
  my $atxNumPcv = @atxVrs;
  map { print "$_\n" } @atxVrs;
  $msg = "";
  $msg = $msg." SINEX CODE info not found."                   if $atxNumPcv==0;
  $msg = $msg." More than one SINEX CODE found."              if $atxNumPcv>1;
  $msg = $msg." SINEX CODE info ($atxVrsPcv) inconsistent with ref. info ($atxVrsCod)." if $atxVrsPcv ne $atxVrsCod;
  prtMess($bpe,"Checked $nam:$msg");
  if ($msg ne "") {
    $msg = $tit.$nam.":".$msg;
    msg2key("NEW",$msg);
  }

# Report G33-G39 data availability
# --------------------------------
  my ($yyyy0,$ddd0) = gps_date("-doy 0 -o %Y %j");
##  my @prnCat = `cat $PATH_DATA$CAMP_DATA/ORX/hourly/RINEX3/$yyyy0/$ddd0/*MO.rnx | grep '^G3[3-9] ' | cut -c1-3`;
  my @prnCat = `cat $PATH_DATA$CAMP_DATA/ORX/hourly/RINEX3/$yyyy0/$ddd0/*MO.rnx | grep '^G3[356789] ' | cut -c1-3`;
  chomp(@prnCat);

  my @prnLst = ();
  my @prnNum = ();
  my ($prn,$ind,$num);
  foreach $prn (@prnCat) {
    $ind = lindex($prn,@prnLst);
    if ($ind==-1) { push(@prnLst,$prn); push(@prnNum,1) } else { $prnNum[$ind]++ }
  }
  $msg = "";
  for ($ind=0;$ind<@prnLst;$ind++) {
    $prn = $prnLst[$ind];
    $num = $prnNum[$ind];
    print "$prn($num)\n";
    $msg .= "$prn($num) " if $num>100;
  }
  prtMess($bpe,"Checked G33-G39 data availability");
  if ($msg ne "") {
    $msg = $tit.$msg."active!";
    msg2key("NEW",$msg);
  }

}
