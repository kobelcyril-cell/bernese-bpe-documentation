package IAR_PRC;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  IAR_PRC
#
# Purpose :  Generate summary of ZERO_AR ambiguity fixing
#
# Programs:  GPSXTR, CRDMERGE, HELMR1
#
# Author  :  S. Schaer
# Created :  25-Sep-2017
#
# Changes :  26-Sep-2017 SS: Added CRDMERGE runs
#            26-Sep-2017 SS: Added HELMR1 run to verify FIX CRD results
#            29-Sep-2017 SS: Added GPSXTR/EXTAMB run for #AR_NLR counting mode
#            05-Oct-2017 SS: Added WLB/WLI/NLB/NLI PHABIA output files
#            02-Nov-2017 SS: Create IZDyyddd.tar.gz file containing OUT files
#            15-May-2018 SS: Save compressed IAR FPZ file
#            16-May-2018 SS: Consider CAMPAIGN
#            17-May-2018 SS: Check BADyyssss.FIX
#            22-May-2018 SS: Renamed IARyyssss.SUM to IARyyssss.PRC
#            23-May-2018 SS: Create IAR FLG file here (not in DO_PPPAR);
#                            extend IARyysss.PRC in case of additional runs
#            06-Jun-2018 SS: Considered REPROCESSING.FLG;
#                            moved extra file saving to IAR_SAV
#            27-Jun-2018 SS: Save NLB/NLI OUT of iteration 0
#            27-Jun-2018 SS: Simplified CRDMERGE sequence
#            27-Jun-2018 SS: Checked PHABIA RMS for WLB and NLB (N0B)
#            28-Jun-2018 SS: Corrected problem concerning IAR FPZ file
#            23-Aug-2018 SS: Create IAR BIA file (using iar2bia.com)
#            27-Nov-2025 SS: Introduced V_DOI
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd,$yyssss,$ssss,$yyyy,
      $pcfFil,$camp_pth,$campaign,$v_c,$v_sav,$v_doi,
      $dirCrd,$extCrd,
      $dirSum,$extSum,
      $dirOut,$extOut,
      $dirOsb,$extOsb,
      $dirBia,$extBia,
      $dirPzh,$extPzh)
      = $bpe->getKeys(
      '$YD+0','$YSS+0','$S+0','$Y+0',
      'PCFFIL','CAMP_PTH','CAMPAIGN','V_C','V_SAV','V_DOI',
      'DIR_CRD','EXT_CRD',
      'DIR_SUM','EXT_SUM',
      'DIR_OUT','EXT_OUT',
      'DIR_OSB','EXT_OSB',
      'DIR_BIA','EXT_BIA',
      'DIR_PZH','EXT_PZH');

  $pcfFil = (split('\.',$pcfFil))[0];

  print "Product reference - DOI $v_doi\n";

  my $repro = (-e "$camp_pth/$campaign/MSC/REPROCESSING.FLG");

  my $iarFlg = "$camp_pth/$campaign/MSC/IAR${yyssss}.FLG";
  my $iarRun = -e $iarFlg ? `cat $iarFlg`+1 : 0;

  my $iarFil = "${dirOut}IAR${yyssss}.FPZ";
  my $fpzFil = "${dirOut}../OBS/????${ssss}.FPZ";
  system("grep '1/1' $fpzFil > $iarFil");
  replace($iarFil,"${dirOut}../OBS/","");
  unlink(glob("$fpzFil"));

  my $iarPrc = "${dirSum}IAR${yyssss}.PRC";
  unlink($iarPrc) if $iarRun==0;
  unlink(glob("${dirOut}???${yyssss}.AMB"));

  my $PGMNAM = "GPSXTR";

  my $fixNam = "FIX${yyssss}";
  my $ambNam = "AMB${yyssss}";
  my $fixFil = "${dirSum}${fixNam}.${extSum}";
  my $ambFil = "${dirSum}${ambNam}.${extSum}";
  my $str    = "";
  my $rms    = "";
  my $rmsMax = 0.10;
  unlink($fixFil,$ambFil);

  if ($iarRun==0) {
    $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'????$S+0_WLI');
    $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","QIFOUT",$fixNam);
    $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBOUT",$ambNam);
    $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBLOD","1");
    $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","WL");
    $bpe->RUN_PGMS($PGMNAM);
    appFile("WIDELANE AMBIGUITY RESOLUTION",0,$fixFil,$iarPrc,0);
    unlink($fixFil,$ambFil);
  }

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'????$S+0_NLI');
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","QIFOUT",$fixNam);
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBOUT",$ambNam);
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBLOD","1");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","NL");
  $str = $iarRun==0 ? "NL" : "N${iarRun}";
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID",$str);
  $bpe->RUN_PGMS($PGMNAM);
  $str = $iarRun==0 ? "" : " $iarRun";
  appFile("NARROWLANE AMBIGUITY RESOLUTION$str (COUNTING ALL AMBIGUITIES)",0,$fixFil,$iarPrc,0);
  unlink($fixFil,$ambFil);

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'????$S+0_NLI');
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","QIFOUT",$fixNam);
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBOUT",$ambNam);
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBLOD","1");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","NLR");
  $str = $iarRun==0 ? "NLR" : "N${iarRun}R";
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID",$str);
  $bpe->RUN_PGMS($PGMNAM);
  $str = $iarRun==0 ? "" : " $iarRun";
  appFile("NARROWLANE AMBIGUITY RESOLUTION$str (COUNTING ONLY WIDELANE-RESOLVED AMBIGUITIES)",0,$fixFil,$iarPrc,0);
  unlink($fixFil,$ambFil);

# PHABIA results
# --------------
  if ($iarRun==0) {
    $fixFil = "${dirOut}WLB${yyssss}.${extOut}";
    appFile("WIDELANE FRACTIONAL BIAS BIAS DETERMINATION (USING WLB RESULTS)",0,$fixFil,$iarPrc,0);

    $rms = `grep 'RMS of unit weight' $fixFil | cut -c33-51`+0;
    if ($rms > $rmsMax) {
      $str = "${pcfFil}:${campaign}:${yyssss}: PHABIA WLB RMS: $rms cyc\n";
      prtMess($bpe,$str);
      msg2key("BPE",$str);
    }

    $fixFil = "${dirOut}WLI${yyssss}.${extOut}";
    appFile("WIDELANE FRACTIONAL BIAS BIAS VERIFICATION (USING WLI RESULTS)",0,$fixFil,$iarPrc,0);
  }

  $fixFil = "${dirOut}NLB${yyssss}.${extOut}";
  $str = $iarRun==0 ? "" : " $iarRun";
  appFile("NARROWLANE FRACTIONAL BIAS BIAS DETERMINATION$str (USING NLB RESULTS)",0,$fixFil,$iarPrc,0);

  $rms = `grep 'RMS of unit weight' $fixFil | cut -c33-51`+0;
  if ($rms > $rmsMax && $iarRun==0) {
    my $str = "${pcfFil}:${campaign}:${yyssss}: PHABIA NLB RMS: $rms cyc\n";
    prtMess($bpe,$str);
    msg2key("BPE",$str);
  }

  $fixFil = "${dirOut}NLI${yyssss}.${extOut}";
  $str = $iarRun==0 ? "" : " $iarRun";
  appFile("NARROWLANE FRACTIONAL BIAS BIAS VERIFICATION$str (USING NLI RESULTS)",0,$fixFil,$iarPrc,0);

  $PGMNAM = "CRDMERGE";
  $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP","CRDMRG",'????$S+0_NLB');
  $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP","CRDRES",'NLB$YSS+0');
  $bpe->RUN_PGMS($PGMNAM);

  $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP","CRDMRG",'????$S+0_NLI');
  $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP","CRDRES",'NLI$YSS+0');
  $bpe->RUN_PGMS($PGMNAM);

  $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP","CRDMRG",'????$S+0_FIX');
  $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP","CRDRES",'FIX$YSS+0');
  $bpe->RUN_PGMS($PGMNAM);

##  unlink(glob("${dirCrd}????${ssss}_NLB.${extCrd}"));
##  unlink(glob("${dirCrd}????${ssss}_NLI.${extCrd}"));
##  unlink(glob("${dirCrd}????${ssss}_FIX.${extCrd}"));
  unlink(glob("${dirCrd}????${ssss}_???.${extCrd}"));

  $PGMNAM = "HELMR1";
  $bpe->RUN_PGMS($PGMNAM);

# Various FIX files
# -----------------
  $fixFil = "${dirCrd}IAR${yyssss}.FIX";
  $str = $iarRun==0 ? "" : " $iarRun";
  appFile("LIST OF STATIONS THAT FULFILLED L1&L2 INTEGER AMBIGUITY INTRODUCTION TEST$str",0,$fixFil,$iarPrc,0);

  $fixFil = "${dirCrd}BAD${yyssss}.FIX";
  $str = $iarRun==0 ? "" : " $iarRun";
  appFile("LIST OF STATIONS THAT FAILED  L1&L2 INTEGER AMBIGUITY INTRODUCTION TEST$str",0,$fixFil,$iarPrc,0) if -e $fixFil;

  $str = "_$iarRun";
  copy($iarFil,$iarFil.$str);
  my $osbFil = "${dirOsb}IAR${yyssss}.${extOsb}";
  copy($osbFil,$osbFil.$str);
  my $biaFil = "${dirBia}IAR${yyssss}.${extBia}";
##  copy($biaFil,$biaFil.$str);

  my $outFil = "${dirOut}NLB${yyssss}.${extOut}";
  my $savFil = "${dirOut}N0B${yyssss}.${extOut}";
##  copy($outFil,$outFil.$str) if $iarRun==0;
  copy($outFil,$savFil) if $iarRun==0;
  $outFil = "${dirOut}NLI${yyssss}.${extOut}";
   $savFil = "${dirOut}N0I${yyssss}.${extOut}";
##  copy($outFil,$outFil.$str) if $iarRun==0;
  copy($outFil,$savFil) if $iarRun==0;

  $str = $iarRun==0 ? "" : "_$iarRun";
##  $str = "_$iarRun";
##  appFile("OSB INFORMATION$str",0,$osbFil,$iarPrc,0);
##  appFile("BIA INFORMATION$str",0,$biaFil,$iarPrc,0);

# Warning in case of BAD stations
# -------------------------------
  if (-e $fixFil) {
    my @sta = `grep '^[A-Z]... ' $fixFil | cut -c1-4`;
    my $sta = join(" ",@sta);
    my $num = @sta;
    my $msg = "${pcfFil}:${campaign}:${yyssss}:${iarRun}: $num BAD stations: $sta\n";
    prtMess($bpe,$msg);
    msg2key("BPE",$msg);
    warn($msg);
##    die($msg);
  }

# Create IAR BIA file
# -------------------
  my $biaFil0 = "${dirBia}${v_c}${yyssss}.${extBia}";
  system("$ENV{AUTO}/iar2bia.com $biaFil0 $osbFil $biaFil") &&
    die "Error executing: $ENV{AUTO}/iar2bia.com $biaFil0 $osbFil $biaFil\n";

# Create IAR FLG file (indicating successful ZERO_AR)
# ---------------------------------------------------
  system("echo '$iarRun' > $iarFlg");

}
