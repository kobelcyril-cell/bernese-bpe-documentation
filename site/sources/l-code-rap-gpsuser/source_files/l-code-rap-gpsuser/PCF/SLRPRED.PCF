# ============================================================================
# SLRPRED.PCF
# ============================================================================
# Description: Compute predictions for GPS/GLONASS for ILRS (CPF)
#
# Author     :  C. Urschl
#
# Changes    :  10-Jun-2009 DT: BPE_CLN added
#               03-Jan-2011 DT: V_RERUN added
#               10-May-2011 DT: I05 -> I08
#               31-May-2011 DT: Add CPF_AFTP
#               01-Mar-2012 DT: Add NEXTJOB if no orbit available
#               18-Jul-2013 CB: added files to clean up to script CPF_DEL
#               27-Oct-2017 UM: Change the sat-info file
#               22-Aug-2019 RD: Add V_MEANPL, V_SUBMOD, V_NUTMOD
#               03-Feb-2020 UM: V_VCPF added to define version of CPF files
#               24-Nov-2020 RD: Run CDDIS-HTTPS submission on sedna
#               03-Dec-2020 RD: Switch special CPU off again: SEDNA->LOCAL
#               16-Sep-2021 ST/UM: Transform into the new PCF format
#               Reorder BPE server variables for reporting
#               28-Mar-2022 ST: Rename V_CAMP to V_REQ_CAMP.
#               24-Feb-2026 RD: Rearrange PIDs
#               24-Feb-2026 RD: Add SP3CPF with hardwired SVN G082
#               25-Mar-2026 RD: Deactivate the special G20 prediction
#               28-Oct-2026 SS: Removed CAMPAGIN=SLRPRED
#               29-Oct-2026 SS: Changed V_SUBMOD from IERS2020XY to DESAI2016
#
# ============================================================================

PID  SCRIPT    OPT_DIR   PARAMETERS
#
# Copy orbits and update ERP
# --------------------------
001  ORB_5D_C  NO_OPT    CPU=LOCAL; NEXTJOB=105
011  POLUPD    SLRPRED   CPU=SHORT; WAIT=001
#
# Transform orbits to CPF format
# ------------------------------
051  SP3CPF    SLRPRED   CPU=SHORT; WAIT=011
#
# Send mail, delete and distribute files
# -----------------------------------------
101  SLR_MAIL  NO_OPT    CPU=LOCAL; WAIT=051
105  CPF_DEL   NO_OPT    CPU=LOCAL; WAIT=101
110  CPF_AFTP  NO_OPT    CPU=LOCAL; WAIT=101
#
# Clean BPE directory, End of BPE
# -------------------------------
900  BPE_CLN   NO_OPT    CPU=LOCAL; WAIT=105 110
999  BPE_BYE   NO_OPT    CPU=LOCAL; WAIT=900; PARAM1=-30; PARAM2=SLR
#
#

VARIABLE     DEFAULT        PARAMETERS
#
# General and model files:
# -----------------------
V_SATINF   = SATELLIT;      DESCRIPTION=Satellite information file
V_PCVINF   = ANT_COD;       DESCRIPTION=PCV information file
V_PCV      = I20;           DESCRIPTION=GNSS PCV model
#
V_MEANPL   = IERS2010;      DESCRIPTION=Mean pole model
V_SUBMOD   = DESAI2016;     DESCRIPTION=Subdaily pole model
V_NUTMOD   = IAU2000R06;    DESCRIPTION=Nutation model
#
# Processing options used in the BPE:
# ----------------------------------
V_VCPF     = 2;             DESCRIPTION=Version of CPF files
#
V_REQ_CAMP = SLRPRED;       DESCRIPTION=Campaign to be used
V_RERUN    = 1;             DESCRIPTION=Number of reruns in case of failure
V_PLUS     = +0;            DESCRIPTION=Plus  days
V_MINUS    = -0;            DESCRIPTION=Minus days
#
# Other variables:
# ---------------
V_WARN     = ERROR_SP.$Y_$S+0; DESCRIPTION=Collected Warnings from PRT files
V_XTR      = Y;             DESCRIPTION=Automatic program extraction (GPSXTR)
V_UPD      = Y;             DESCRIPTION=Update general files?
V_SAV      = Y;             DESCRIPTION=Save results?
V_DEL      = Y;             DESCRIPTION=Delete results?
V_DIS      = Y;             DESCRIPTION=Distribute results?
