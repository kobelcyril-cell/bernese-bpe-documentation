# ============================================================================
# RAPIDPLOTS.PCF
# ============================================================================
#
# Description:  Generate a series of plots based on RAPID products using the
# pyPLT-tools
#
# The results are located as eps and png in $P/PLOTS/FIG
#
# Author     :  R. Dach
# Created    :  23-Jan-2024
#
# Changes    :  17-Jan-2025 EB: historical GMT rapid plots added
#
# ============================================================================

PID  SCRIPT              OPT_DIR        PARAMETERS
#
# Delete specific files
# ---------------------
001  plot_copy           PLT_GEN        CPU=LOCAL
#
# Plot the constellations
# -----------------------
011  plotConstellations  PLT_GPS        CPU=SHORT; SCR_PATH=${AIUB}/BPE_SCR; WAIT=001
012  plotConstellations  PLT_GLO        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=001
013  plotConstellations  PLT_GAL        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=001
099  DUMMY               PLT_GEN        CPU=LOCAL; WAIT=011 012 013
#
# Plot the station network
# ------------------------
101  plotSatnum          PLT_GEN        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=099
111  plotCRDmap          PLT_GEN        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=099
121  plotStanum          PLT_GEN        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=099
122  plotHELMR1          PLT_GEN        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=099
199  DUMMY               PLT_GEN        CPU=LOCAL; WAIT=101 111 122
#
# Plot general solution statistics
# --------------------------------
201  plotAMBXTR          PLT_GEN        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=199
202  plotGPSXTR          PLT_RMS1       CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=201
203  plotGPSXTR          PLT_OBS1       CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=201
204  plotGPSXTR          PLT_PAR1       CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=201
205  plotGPSXTR          PLT_OBS3       CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=201
206  plotGPSXTR          PLT_PAR3       CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=201
209  DUMMY               PLT_GEN        CPU=LOCAL; WAIT=202 203 204 205 206
221  plotOBSXTR          PLT_OBSorbGPS  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=209
222  plotOBSXTR          PLT_MPRorbGPS  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=209
223  plotOBSXTR          PLT_EDTorbGPS  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=209
224  plotOBSXTR          PLT_OBSorbGLO  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=209
225  plotOBSXTR          PLT_MPRorbGLO  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=209
226  plotOBSXTR          PLT_EDTorbGLO  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=209
227  plotOBSXTR          PLT_OBSorbGAL  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=209
228  plotOBSXTR          PLT_MPRorbGAL  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=209
229  plotOBSXTR          PLT_EDTorbGAL  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=209
299  DUMMY               PLT_GEN        CPU=LOCAL; WAIT=221 222 223 224 225 226 227 228 229
#
# Plot products and related quality indicators
# --------------------------------------------
301  plotHLMmap          PLT_OBS3       CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=299
309  DUMMY               PLT_GEN        CPU=LOCAL; WAIT=301
311  plotCCRNXC          PLT_GPS        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=309
312  plotCCRNXC          PLT_GLO        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=309
313  plotCCRNXC          PLT_GAL        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=309
319  DUMMY               PLT_GEN        CPU=LOCAL; WAIT=311 312 313
321  plotSTDELE          PLT_GPS        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=319
322  plotSTDELE          PLT_GLO        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=319
323  plotSTDELE          PLT_GAL        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=319
324  plotSTDELE          PLT_OBSorbGPS  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=319
325  plotSTDELE          PLT_OBSorbGLO  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=319
326  plotSTDELE          PLT_OBSorbGAL  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=319
399  DUMMY               PLT_GEN        CPU=LOCAL; WAIT=321 322 323 324 325 326
#
401  plotAMBXTR          PLT_GENclk     CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=399
402  plotGPSXTR          PLT_RMSclk     CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=399
403  plotGPSXTR          PLT_OBSclk     CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=399
404  plotGPSXTR          PLT_PARclk     CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=399
409  DUMMY               PLT_GEN        CPU=LOCAL; WAIT=401 402 403 404
411  plotOBSXTR          PLT_OBSclkGPS  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=409
412  plotOBSXTR          PLT_EDTclkGPS  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=409
413  plotOBSXTR          PLT_OBSclkGLO  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=409
414  plotOBSXTR          PLT_EDTclkGLO  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=409
415  plotOBSXTR          PLT_OBSclkGAL  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=409
416  plotOBSXTR          PLT_EDTclkGAL  CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=409
499  DUMMY               PLT_GEN        CPU=LOCAL; WAIT=411 412 413 414 415 416
#
# Plot historical RAPID info via GMT
# ----------------------------------
501  IGSR_PLT            NO_OPT         CPU=LOCAL; WAIT=499; CONT_ERR
599  DUMMY               NO_OPT         CPU=LOCAL; WAIT=501
#
# Create processing summary file
# ------------------------------
990  plot_save           PLT_GEN        CPU=LOCAL; SCR_PATH=${AIUB}/BPE_SCR; WAIT=599
998  BPE_CLN             PLT_GEN        CPU=LOCAL; WAIT=990
999  BPE_BYE             PLT_GEN        CPU=LOCAL; WAIT=998
#
#

VARIABLE       DEFAULT        PARAMETERS
#
# General and model files:
# -----------------------
V_SATCRX     = SAT;           DESCRIPTION=Satellite problem file
V_SATINF     = SATELLIT;      DESCRIPTION=SATELLITE INFORMATION FILE
V_PCV        = I20;           DESCRIPTION=GNSS PCV MODEL (ABS)
#
# General settings
# ----------------
V_REQ_CAMP   = PLOTS_RAP;     DESCRIPTION=Campaign to be used
V_FIG        = rapid_;        DESCRIPTION=Prepending ID for all output plots
V_SAV        = Y;             DESCRIPTION=Publish plots on PATH_WWW/code/plots
V_DATE       = ;              DESCRIPTION=blank process latest file or define date as yyddd or yysss as in the filename
V_NUMDAYS    = 364;           DESCRIPTION=Length of the plots (positive integer value) if nothing script specific is defin
#
# Constellation plots
# -------------------
V_SATCONST   = SATCONST;      DESCRIPTION=Name of the ELE file in the plot campaign/blank no plot
#
# Station map plot
# ----------------
V_MAPCRD     = MAPCRD;        DESCRIPTION=Name of the CRD file in the plot campaign/blank no plot
#
# HELMERT residuals on a map
# --------------------------
V_MAPHLM     = MAPHLM;        DESCRIPTION=Name of the file with map of HELMERT residuals/blank no plot
#
# Plot number of stations per system in RAPID solution
# ----------------------------------------------------
V_STANUM     = STANUM;        DESCRIPTION=Name of the CRD file in the plot campaign/blank no plot
V_STANUMDAYS = 349;           DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot number of satellites per system in RAPID solution
# ------------------------------------------------------
V_SATNUM     = SATNUM;        DESCRIPTION=Name of the PRE file in the plot campaign/blank no plot
V_SATNUMDAYS = 364;           DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot ambiguity resolution rate in RAPID solution
# ------------------------------------------------
V_AMBXTR     = AMBXTR;        DESCRIPTION=Name of the summary file with OBSXTR for AMBRES/blank no plot
V_AMBXTRDAYS = 364;           DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot general solution statistics from GPSXTR in RAPID solutions
# ---------------------------------------------------------------
V_GPSXTR     = GPSXTR;        DESCRIPTION=Name of the summary file with GPSXTR for rms,#par,#obs/blank no plot
V_GPSXTRDAYS = 364;           DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot general solution statistics from OBSXTR in RAPID solutions
# ---------------------------------------------------------------
V_OBSXTR     = OBSXTR;        DESCRIPTION=Name of the summary file with OBSXTR for rms,#par,#obs/blank no plot
V_OBSXTRDAYS = 364;           DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot RMS of linear fit in RAPID clock solution (30s densification based on 3day orbits)
# ----------------------------------------------
V_CCRNXC     = CCRNXC;        DESCRIPTION=Name of the summary file with CCRNXC for RMS lin fit/blank no plot
V_CCRNXCDAYS = 364;           DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot Helmrt-transformation results in RAPID solution
# ----------------------------------------------------
V_HELMR1     = HELMR1;        DESCRIPTION=Name of the summary file with STDELE for orbit overlaps/blank no plot
V_HELMR1DAYS = 364;           DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot Orbit overlaps in RAPID solution (POS in 3day solutions)
# -------------------------------------
V_STDELE     = STDELE;        DESCRIPTION=Name of the summary file with STDELE for orbit overlaps/blank no plot
V_STDELEDAYS = 364;           DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
