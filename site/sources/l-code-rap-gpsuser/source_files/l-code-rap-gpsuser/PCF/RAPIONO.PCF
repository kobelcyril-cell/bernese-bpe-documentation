# ============================================================================
#
# Procedure Control File (PCF)
# All comment lines start with a #
#
# RAPIONO - Compute rapid 1-day and 3-day ionosphere models
# =========================================================
#
# Created:  22-Apr-2002/SS
#
#           03-Feb-2003/SS: Rapid ionosphere estimation outsourced
#           31-Aug-2004/RD: Adapt to the new CPU file
#           09-Sep-2004/SS: Upload IONEX results to CDDIS (GIR_FTP)
#           04-Apr-2005/SS: BPE_BYE as last process added
#           03-Aug-2007/MM: V_UPD, V_SAV, V_DEL, V_DIS introduced
#           19-May-2009/RD: V_NCLU introduced
#           18-Apr-2011/SS: Switch from IGS05 to IGS08
#           09-Oct-2012/ss: Switch from IGS08 to IGb08
#           19-Jul-2013/rd,hb: V_OBSSEL added
#           01-Nov-2013/rd,eo: SAT_1452 -> SAT_NONE for V_SATINF
#           10-Jun-2014/ss: Introduced V_SNXINF
#           16-Oct-2014/ss: Rewritten IONMRG (derived from IONMRG.BDS)
#           22-Oct-2014/ss: Redesigned using GIMCLU, MRG_ION, CLN_ION, etc.
#           17-Sep-2015/ss: Added GIRXTR
#           22-Apr-2016/ss: Added ADDNEQ2 NEQ reduction step in GIMCLU
#           18-May-2016/ss: Modifications due to OSB parameterization
#           24-May-2016/ss: Added GIR_UPD
#           25-May-2016/ss: Added additional bias solutions (ADDNEQ2)
#           21-Sep-2016/av: V_PSDINF introduced
#           30-Jan-2017 RD: Switch from IGB08 to IGS14
#           04-Dec-2017 AV: V_MACMOD and V_BOXWNG introduced
#           21-Aug-2019 RD: Add V_BLQINF, V_SUBMOD, V_NUTMOD
#           23-Sep-2019 SS: Enabled GRE in GPSEST of GIMEDT_P and GIMCLU_P
#           03-Feb-2020 RD: Switch from FES2004 to FES2014b
#           18-May-2020 SS: Switched to IGb14
#           24-Nov-2020 RD: Run CDDIS-HTTPS submission on sedna
#           02-Dec-2020 AV: Run CDDIS-HTTPS on local (GIR_FTP)
#           09-Sep-2021 ST/LP: Transform into the new PCF format
#           09-Sep-2021 ST/LP: Reorder BPE server variables for reporting
#           28-Nov-2021 LP: Remove V_MACMOD
#           28-Mar-2022 ST: Rename V_CAMP to V_REQ_CAMP.
#           29-Mar-2022 AV: Modfied OBSSEL, SATINF, PCVINF, BIAINF, BOXWING
#           26-Oct-2022 SS: Introduced V_PCC4MWGF
#           02-Nov-2022 SS: Redefined V_GNSS from GR to GRE
#           06-Dec-2022 LP: Switch from BOXWING.MAC to BOXWING_I20.MAC
#           20-Mar-2023 ST: Put CPU=LOCAL for GIMEDTAP.
#                           Put CPU=QUICK for GIMEDT_P.
#           02-Feb-2025 EB: Change from IGS20 to IGB20
#           26-Nov-2025 SS: Added V_DOI
#           12-Jan-2026 EB/SS: Changed from IGB20 to IGC20 and from I20_2388 to I20_2401=I20
#           28-Jan-2026 SS: Added BPE_INI with V_INI=Y (PARAM1=-nopcv)
#           19-May-2026 RD: Update V_DOIs
#
# ============================================================================

PID  SCRIPT    OPT_DIR   PARAMETERS
000  BPE_INI   NO_OPT    CPU=LOCAL; PARAM1=-nopcv; SCR_PATH=${AIUB}/BPE_SCR
#
# Zero-difference GIM and DCB estimation
# --------------------------------------
#
# Ionosphere data pre-processing
# ------------------------------
101  GIMEDTAP  NO_OPT    CPU=LOCAL; WAIT=000
102  GIMEDT_P  IGSR_GID  CPU=QUICK; WAIT=101; PARALLEL=101
110  GIM_CHK   IGSR_GIK  CPU=SHORT; WAIT=102
#
# Ionosphere (1-day) NEQ generation
# ---------------------------------
201  GIMCLUAP  IGSR_GIM  CPU=LOCAL; WAIT=110
202  GIMCLU_P  IGSR_GIM  CPU=BIG; WAIT=201; PARALLEL=201
203  MRG_ION   NO_OPT    CPU=LOCAL; WAIT=202; PARAM1=U
211  ADDNEQ2   IGSR_GIA  CPU=BIG; WAIT=202
212  ADDNEQ2   IGSR_GII  CPU=BIG; WAIT=202
213  ADDNEQ2   IGSR_GIB  CPU=BIG; WAIT=211
214  CLN_ION   NO_OPT    CPU=LOCAL; WAIT=203 212 213
#
# Ionosphere solutions
# --------------------
# - 1-day (RZ_)
221  ADDNEQ2   IGSR_GIP  CPU=BIG; WAIT=203 212
222  MOD_EST   NO_OPT    CPU=LOCAL; WAIT=221; PARAM1=U; PARAM2=OSB
223  ADDNEQ2   IGSR_BIE  CPU=BIG; WAIT=211 222
224  ADDNEQ2   IGSR_BIS  CPU=BIG; WAIT=213
225  ADDNEQ2   IGSR_BIF  CPU=BIG; WAIT=213
226  ADDNEQ2   IGSR_BIR  CPU=BIG; WAIT=213
227  ADDNEQ2   IGSR_BIG  CPU=BIG; WAIT=213
# - 3-day (RA_)
231  ADDNEQ2   IGSR_GI3  CPU=BIG; WAIT=203 212
# - 3-day (RM_)
232  ADDNEQ2   IGSR_GI2  CPU=BIG; WAIT=212
#
299  DUMMY     NO_OPT    CPU=LOCAL; WAIT=214 223 224 225 226 227 231 232
#
300  GIR_UPD   NO_OPT    CPU=LOCAL; WAIT=299
301  GIR_SAV   NO_OPT    CPU=LOCAL; WAIT=300
302  GIR_DIS   NO_OPT    CPU=LOCAL; WAIT=301
303  GIR_FTP   NO_OPT    CPU=LOCAL; WAIT=302
#
900  GIRXTR    IGSR_GIM  CPU=LOCAL; WAIT=303
999  BPE_BYE   NO_OPT    CPU=LOCAL; WAIT=900
#

VARIABLE     DEFAULT        PARAMETERS
V_DOI      = 10.48620/97772; DESCRIPTION=Product DOI
#
# Solution IDs used in the BPE:
# ----------------------------
V_A        = RB;            DESCRIPTION=Broadcast orbit
V_B        = RF;            DESCRIPTION=One-day orbit from 1. iteration
V_E        = RG;            DESCRIPTION=One-day orbit from 2. iteration
V_K        = RH;            DESCRIPTION=One-day orbit from 3. iteration
V_H        = RQ;            DESCRIPTION=Last/best one-day orbit
V_I        = RA;            DESCRIPTION=N-day solution (official rapid solution)
V_O        = RP;            DESCRIPTION=Predicted orbit
V_U        = RZ;            DESCRIPTION=Zero-difference GIM and DCB results
V_W        = F1;            DESCRIPTION=A priori orbit for IGS final solution
V_X        = RS;            DESCRIPTION=N-day solution (small NEQ file)
V_Z        = RM;            DESCRIPTION=Middle-day results
V_V        = T1;            DESCRIPTION=Test solution
#
# Reference frame and station related files:
# -----------------------------------------
V_CRDINF   = IGC20;         DESCRIPTION=CRD/VEL/FIX master file name
V_PSDINF   = IGC20;         DESCRIPTION=PSD corrections
#
V_STAINF   = CODE;          DESCRIPTION=Station information file
#
# General and model files:
# -----------------------
V_OBSSEL   = OBSERV_COD;    DESCRIPTION=Observation selection file
V_SATINF   = SATELLIT;      DESCRIPTION=Satellite information file
V_PCVINF   = ANT_COD;       DESCRIPTION=PCV information file
V_PCV      = I20;           DESCRIPTION=GNSS PCV model (IGS)
V_PCC4MWGF = 2022 11 27;    DESCRIPTION=PCC applied for MW/GF LC
#
V_SYSCRX   = SAT_GNSS;      DESCRIPTION=Satellite problem file for data import
#
V_SUBMOD   = DESAI2016;     DESCRIPTION=Subdaily pole model
V_NUTMOD   = IAU2000R06;    DESCRIPTION=Nutation model
#
V_BLQINF   = FES2014b;      DESCRIPTION=BLQ file name, CMC corrections
#
# Ambiguity resolution:
# --------------------
V_BL_AMB   = 6000;          DESCRIPTION=Max baseline length (km) for WUEBB AR
V_BL_QIF   = 2000;          DESCRIPTION=Max baseline length (km) for QIF AR
#
# Processing options used in the BPE:
# ----------------------------------
V_GNSS     = GRE;           DESCRIPTION=GNSS selection (RINEX system char.)
#
V_BOXWNG   = BOXWING_I20;   DESCRIPTION=Boxwing model file
#
V_NCLU     = 14;            DESCRIPTION=Number of clusters to be used
V_CLU      = 25;            DESCRIPTION=Maximum number of files per cluster
#
V_REQ_CAMP = IGSRAPID;      DESCRIPTION=Campaign to be used
V_RERUN    = 1;             DESCRIPTION=Number of reruns in case of failure
V_PLUS     = +0;            DESCRIPTION=Plus  days
V_MINUS    = -2;            DESCRIPTION=Minus days
#
V_SNXINF   = SINEX_COD;     DESCRIPTION=SINEX information skeleton
V_BIAINF   = SINEX_BIA_COD; DESCRIPTION=BIAS SINEX information skeleton
#
# Other variables:
# ---------------
V_INI      = Y;             DESCRIPTION=BPE initalization mode (Y/N/Verified)
V_XTR      = N;             DESCRIPTION=Automatic program extraction (GPSXTR)
V_UPD      = Y;             DESCRIPTION=Update general files?
V_SAV      = Y;             DESCRIPTION=Save results?
V_DEL      = Y;             DESCRIPTION=Delete results?
V_DIS      = Y;             DESCRIPTION=Distribute results?
