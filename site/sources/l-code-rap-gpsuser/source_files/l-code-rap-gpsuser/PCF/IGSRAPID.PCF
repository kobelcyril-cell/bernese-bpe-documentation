063  DEFSTD    IGSR_AA   CPU=SHORT; WAIT=060; CONT_ERR
069  WAIT      NO_OPT    CPU=LOCAL; WAIT=061 062 063
#
# Preparing the RINEX files, code processing
#
100  RNXSMTAP  NO_OPT    CPU=LOCAL; WAIT=029 032
101  RNXSMT_P  IGSR_A    CPU=QUICK; WAIT=100; PARALLEL=100
102  PHA_ONLY  NO_OPT    CPU=SHORT; WAIT=101
120  RXOBVSAP  IGSR_AA   CPU=LOCAL; WAIT=016 102
