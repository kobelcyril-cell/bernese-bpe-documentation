#
# Fixed solution, IGS - Rapid orbit computation
#
490  DEFCLU    NO_OPT    CPU=SHORT; WAIT=300 384
491  INIT_HOI  NO_OPT    CPU=LOCAL; WAIT=471 490
492  INIT_VMF  NO_OPT    CPU=LOCAL; WAIT=491
493  INIT_FIX  NO_OPT    CPU=LOCAL; WAIT=492; PARAM1=H
500  GPSCLUAP  NO_OPT    CPU=LOCAL; WAIT=493
501  GPSCLU_P  IGSR_Q    CPU=BIG; WAIT=500; PARALLEL=500
502  GPSXTR    IGSR_A    CPU=SHORT; WAIT=501
#
# Generation of RQ/RA/RM final solution results
# ---------------------------------------------
# A=Addition of 4 cluster NEQs
# R=Reduction of full NEQ (in terms of troposphere and orbit parameters)
# C=Coordinates computed using default FIX list
# P=Product generation (for coordinates, troposphere, orbit, ERP)
# S=SINEX generation
# G=GCC computation
503  WAIT_JOB  NO_OPT    CPU=LOCAL; WAIT=502; SKIP
510  ADDNEQ2   IGSR_F1A  CPU=BIG; WAIT=503
511  ADDNEQ2   IGSR_F1O  CPU=BIG; WAIT=510
512  ADDNEQ2   IGSR_F1R  CPU=BIG; WAIT=511
# START POINT:
520  WAIT      NO_OPT    CPU=LOCAL; WAIT=512
521  INIT_FIX  NO_OPT    CPU=LOCAL; WAIT=520; PARAM1=H
522  STA2STA   NO_OPT    CPU=LOCAL; WAIT=520; PARAM1=IGS_CRX
523  STA2STA   NO_OPT    CPU=LOCAL; WAIT=520; PARAM1=IGS_SNX; PARAM2=RNX_CRX
524  GET_NANU  NO_OPT    CPU=LOCAL; WAIT=520
530  ADDNEQ2   IGSR_F1C  CPU=LOCAL; WAIT=521 522 523
