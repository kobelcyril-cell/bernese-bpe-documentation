051  SATCLK2   IGSR_NAV  CPU=SHORT; WAIT=050
# RXN2PRE run also with unregistered satellites (for external)
055  RXN2PRE   IGSR_NAA  CPU=SHORT; WAIT=040; CONT_ERR
059  WAIT      NO_OPT    CPU=LOCAL; WAIT=051 055
060  ORBMRG    IGSR_A    CPU=SHORT; WAIT=059
