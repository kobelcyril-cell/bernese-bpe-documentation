#
# additional parameters required for PID's
#

VARIABLE     DEFAULT        PARAMETERS
V_DOI      = 10.48620/97772;  DESCRIPTION=Product DOI (RAPID)
V_DOI_U    = 10.48620/97774;  DESCRIPTION=Product DOI (ULTRA)
#
# Solution IDs used in the BPE:
# ----------------------------
V_A        = BRD;           DESCRIPTION=Broadcast orbit
V_C        = RB;            DESCRIPTION=Merge of predictions and orbits
V_B        = RF;            DESCRIPTION=One-day orbit from 1. iteration
V_E        = RG;            DESCRIPTION=One-day orbit from 2. iteration
V_K        = RH;            DESCRIPTION=One-day orbit from 3. iteration
V_H        = RQ;            DESCRIPTION=Last/best one-day orbit
V_I        = RA;            DESCRIPTION=N-day solution (official rapid solution)
V_O        = RP;            DESCRIPTION=Predicted orbit
V_P        = GB;            DESCRIPTION=GLONASS broadcast information
V_U        = RZ;            DESCRIPTION=Zero-difference GIM and DCB results
V_W        = F1;            DESCRIPTION=A priori orbit for IGS final solution
V_X        = __;            DESCRIPTION=N-day solution (small NEQ file)
V_Z        = RM;            DESCRIPTION=Middle-day results
V_V        = RU;            DESCRIPTION=Extra ultra rapid results
V_S        = UX;            DESCRIPTION=Extra prediction for ublox
#
# Reference frame and station related files:
# -----------------------------------------
V_CRDINF   = IGC20;         DESCRIPTION=CRD/VEL/FIX master file name
V_PSDINF   = IGC20;         DESCRIPTION=PSD corrections
V_CRDEPO   = 2020 01 01;    DESCRIPTION=CRD reference epoch
#
V_STAINF   = CODE;          DESCRIPTION=Station information file
#
# General and model files:
# -----------------------
V_CMPINF   = AIUB_CMP;      DESCRIPTION=Campaign table file
V_OBSSEL   = OBSERV_COD;    DESCRIPTION=Observation selection file
V_SATINF   = SATELLIT;      DESCRIPTION=Satellite information file
V_PCVINF   = ANT_COD;       DESCRIPTION=PCV information file
V_PCV      = I20;           DESCRIPTION=GNSS PCV model (IGS)
V_ANTAZI   = YES;           DESCRIPTION=Consider antenna rotations (YES|NO)
#
# Only extracting ANTEX files:
V_PCVIN0   = PHAS_COD;      DESCRIPTION=_PCV information file (BSW50)
V_PCVE     = E20;           DESCRIPTION=_GNSS PCV model (EPN)
V_NADIR    = 18;            DESCRIPTION=_Max nadir angle for GNSS PCV model
#
V_SYSCRX   = SAT_GNSS;      DESCRIPTION=Satellite problem file for data import
#
V_SUBMOD   = DESAI2016;     DESCRIPTION=Subdaily pole model
V_NUTMOD   = IAU2000R06;    DESCRIPTION=Nutation model
V_GRAVMOD  = COSTG_FSM_2603; DESCRIPTION=Gravity field model
#
V_TRPMOD   = GPT3;          DESCRIPTION=Default troposphere model
#
V_BLQINF   = FES2014b;      DESCRIPTION=BLQ file name, CMC corrections
V_ATLINF   = VAPL;          DESCRIPTION=ATL file name, CMC corrections
#
# Ambiguity resolution:
# --------------------
V_GNSSAR   = ALL;           DESCRIPTION=GNSS for ambiguity resolution; CARDS=GPS ALL
V_BL_AMB   = 6000;          DESCRIPTION=Max baseline length (km) for WUEBB AR
V_BL_QIF   = 2000;          DESCRIPTION=Max baseline length (km) for QIF AR
V_BL_L53   = 200;           DESCRIPTION=Max baseline length (km) for L53 AR
V_BL_L12   = 20;            DESCRIPTION=Max baseline length (km) for L12 AR
#
# Processing options used in the BPE:
# ----------------------------------
V_GNSS     = GRE;           DESCRIPTION=GNSS selection (RINEX system char.)
#
V_BOXWNG   = BOXWING_I20;   DESCRIPTION=Boxwing model file
V_SP3INT   = 300;           DESCRIPTION=Sampling in archived precise files
V_ATTINT   = 30;            DESCRIPTION=Sampling in attitude reporting files
V_DTSTC    = 08 00 00;      DESCRIPTION=Min. interval between pulse and maneuver
V_ARCFIT   = 3;             DESCRIPTION=Max arc length (days)
#
V_NCLU     = 14;            DESCRIPTION=Number of clusters to be used
V_DEFCLU   = 3;             DESCRIPTION=Number of clusters in the final solution
#
V_REQ_CAMP = IGSRAPID;      DESCRIPTION=Campaign to be used
V_RERUN    = 1;             DESCRIPTION=Number of reruns in case of failure
V_PLUS     = +0;            DESCRIPTION=Plus  days
V_MINUS    = -2;            DESCRIPTION=Minus days
#
V_TROFIX   = VLBI_TROPO;    DESCRIPTION=List of troposphere-connecting stations
V_SNXINF   = SINEX_RAP;     DESCRIPTION=SINEX information skeleton
#
# Other variables:
# ---------------
V_SAVDSK   = N;             DESCRIPTION=Copy a priori from savedisk
V_RELAX    = N;             DESCRIPTION=Relaxed error handling
V_SKIP3D   = N;             DESCRIPTION=Skip three-day solution
#
V_INI      = Y;             DESCRIPTION=BPE initalization mode (Y/N/Verified)
V_XTR      = Y;             DESCRIPTION=Automatic program extraction (GPSXTR)
V_UPD      = Y;             DESCRIPTION=Update general files?
V_SAV      = Y;             DESCRIPTION=Save results?
V_DEL      = Y;             DESCRIPTION=Delete results?
V_DIS      = Y;             DESCRIPTION=Distribute results?
