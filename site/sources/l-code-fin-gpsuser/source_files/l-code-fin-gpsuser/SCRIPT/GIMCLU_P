package GIMCLU_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  GIMCLU_P
#
# Purpose :  Execute GPSEST (parallel mode)
#
# PARAMs  :  PARAM1 - temporary file for parallel processing
#
# Author  :  S. Schaer
# Created :  22-Mar-2004
#
# Changes :  11-Aug-2011 RD: Updated for version 5.2
#            17-Oct-2014 SS: Updated for ionosphere analysis
#            22-Apr-2016 SS: Perform extra ADDNEQ2 run
#            16-Jan-2025 SS: Considered year with fractional part
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use bpe_util qw(prtMess setUserVar replaceSel prtBPEfile);
use lib $ENV{EXE};
use Gps_Date;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ddd, $ssss, $yyyy,
      $param1, $subPid, $clu) =
  $bpe->getKeys
     ('$YD+0', '$+0', '$S+0', '$Y+0',
      'PARAM1', 'SUB_PID', 'V_CLU');

# Set cluster number and input files
# ----------------------------------
  my $cluster = $clu eq "" ? "$ddd$param1" : "$ddd$subPid";
  my $ffff    = $clu eq "" ? $param1        : "____";

  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$ffff,"CCC",$subPid);

  if ($clu eq "") {
    prtMess($bpe,"PROCESSING FILE $param1$ssss");
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","CZFILES","$param1$ssss");
  } else {
    replaceSel($bpe,"GPSEST","CZFILES",$param1);
  }

# Update geomagnetic pole coordinates
# -----------------------------------
  my $yyyyF = gps_date("-yd $yyddd -d 0.5 -o %FY");
  my $lat = `$ENV{AUTO}/geomagnetic_pole.com $yyyyF -lat`;
  chomp($lat);
  my $lon = `$ENV{AUTO}/geomagnetic_pole.com $yyyyF -lon`;
  chomp($lon);
  print "FY: $yyddd $yyyyF $lat $lon\n";

  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","LATPOL",$lat);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","LONPOL",$lon);

##  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SANTOFF","0");
##  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SANTPAT","0");

# Run program
# -----------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

# Print processed stations BPE file
# ---------------------------------
  prtBPEfile($param1,0) if $clu ne "";

}
