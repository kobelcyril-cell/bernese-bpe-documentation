package GNSCLK_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GNSCLK_P
#
# Purpose :
#
# Programs:  GPSEST
#
# Author  :  M. Meindl
# Created :  05-Apr-2004
#
# Changes :  03-Oct-2014 lp: New GNSS selection using setGNSS
#            31-May-2016 SS: Updated due to OSB implementation
#            29-Sep-2016 SS/AV: Keep all CRDs in NEQ
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use File::Basename;


sub run {
  my $bpe = shift;


# Define variables
# ----------------
  my $PARAM1  = $$bpe{PARAM1};
  my $SUB_PID = $$bpe{SUB_PID};

# Replace selected with station list
# ----------------------------------
  replaceSel($bpe,"GPSEST","CZFILES",$PARAM1);

# Set correlation strategy
# ------------------------
  my $cluNum = index(basename($PARAM1),"000.BPE");
  if ($cluNum != -1) {
    setUserVar($bpe,"D4","000");
    &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_","ALL");
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PRE08","PRIOR_TO_NEQ_SAVING");
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBTYP","LC");
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBSAT","0");
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBREC","1");
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBSIGR","100");
  }
  else {
    setUserVar($bpe,"D4",$SUB_PID) }

# Run program
# -----------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBINP",'CLK$(D4)');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","NEQUARS","");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT",'C__$(D4)');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OBS2NEQ","0");
##  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PRE01","NO");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PRE06","NO");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBEST","0");

  $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'___$(D4)');
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'CL_$(D4)');
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NOINV","1");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","PRE-ELIMINATE");

  $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

# Delete BPE file
# ---------------
  open (BPE,$PARAM1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $PARAM1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;


}
