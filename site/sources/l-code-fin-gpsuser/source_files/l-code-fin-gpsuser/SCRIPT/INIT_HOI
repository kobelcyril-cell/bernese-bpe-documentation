package INIT_HOI;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  INIT_HOI
#
# Purpose :  Copy  best ionosphere product for HOI correction
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  08-Oct-2010
#
# Changes :  08-Mar-2022 AV: Rapid save disk: yearly subdirectory
#            10-Nov-2023 SS: Do not accept any null model
#
# ============================================================================
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use File::Copy;

sub run {

  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yyyy, $dirIon, $extIon) =
    $bpe->getKeys('$YD+0', '$Y+0', 'DIR_ION', 'EXT_ION');

  my $inpion = "";
  my @inpion0 = (
                 "$PATH_SAV/$CAMP_SAVIGS/$yyyy/ATM/Z3_${yyddd}.${extIon}",
                 "$CDIR_GIM/ATM/Z3_${yyddd}.${extIon}",
                 "$PATH_SAV/$CAMP_SAVIGS/$yyyy/ATM/Z1_${yyddd}.${extIon}",
                 "$CDIR_GIM/ATM/Z1_${yyddd}.${extIon}",
                 "$PATH_SAV/$CAMP_SAVRAP/${yyyy}/ATM/RM_${yyddd}.${extIon}",
                 "$CDIR_RAP/ATM/RM_${yyddd}.${extIon}",
                 "$PATH_SAV/$CAMP_SAVRAP/${yyyy}/ATM/RA_${yyddd}.${extIon}",
                 "$CDIR_RAP/ATM/RA_${yyddd}.${extIon}",
                 "$PATH_SAV/$CAMP_SAVRAP/${yyyy}/ATM/RZ_${yyddd}.${extIon}",
                 "$CDIR_RAP/ATM/RZ_${yyddd}.${extIon}",
                 );

  map { if (-s $_ && `grep '0.00000000' $_ | wc -l`+0 <= 1) { $inpion = $_ } } reverse @inpion0;

  my $oution = "${dirIon}HOI${yyddd}.${extIon}";
  copy($inpion,$oution) or die "Cannot copy $inpion to $oution\n";

  prtMess($bpe,"HOI initialization: $inpion copied to $oution")

}
