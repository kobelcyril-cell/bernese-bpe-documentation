package HCCRNXCB;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name:      CCRNXC
#
# Purpose:   Merge Clock RINEX files,
#
# Programs:  CCRNXC
#
# Authors:   H. Bock
#
# Created:   30-Jun-2003
# Last mod.: 08-Feb-2005
#
# Changes:   16-Mar-2004 HB: Replace V_W by V_Q
#                           (Integration of high-rate clocks in CLKRAPID.PCF)
#            08-Feb-2005 MM: $s replaced by $bpe, some unused stuff deleted
#            21-Nov-2016 AS/AV: added $yyssss if FCLKGNSS.PCF
#
# ----------------------------------------------------------------------------
use strict;

use lib "$ENV{BPE}";
use bpe_util;
use File::Copy;


sub run
{
  my $bpe = shift;


# Define variables
# ----------------
  my           ($yyddd ,$yyssss,
                $param1,$pcf,
                $U ,$V_Q ,$V_U ,$V_N ,$V_G, $V_QQ, $V_UU ) =
  $bpe->getKeys('$YD+0','$YSS+0',
                'PARAM1', 'PCFFIL',
                'U','V_Q','V_U','V_N','V_G','V_QQ','V_UU');


  my $udate = $pcf =~/FCLKGNSS/ ? $yyssss : $yyddd ;
  $udate = $yyssss if $pcf =~/FCLKI20/;
  print "PCF: $pcf UDATE: $udate\n";

  my $tmpfil = "$U/WORK/tmpfil";
  open (OUT,">$tmpfil");

# COD
  if ( $param1 eq "HCK3D" ) {
    print OUT "${V_Q}N${udate}\n";
    print OUT "${V_U}_${udate}\n";

    print "$param1 - inp 1: ${V_Q}N${udate}\n";
    print "$param1 - inp 2: ${V_U}_${udate}\n";
  }
# V52
  if ( $param1 eq "HCK3X" ) {
    print OUT "${V_QQ}N${udate}\n";
    print OUT "${V_UU}_${udate}\n";

    print "$param1 - inp 1: ${V_QQ}N${udate}\n";
    print "$param1 - inp 2: ${V_UU}_${udate}\n";
  }
# COF
  if ( $param1 eq "HCK1D" ) {
    print OUT "${V_N}N${udate}\n";
    print OUT "${V_G}_${udate}\n";

    print "$param1 - inp 1: ${V_N}N${udate}\n";
    print "$param1 - inp 2: ${V_G}_${udate}\n";
  }
  close OUT;

  replaceSel($bpe,"CCRNXC","RCLKINP",$tmpfil);

# Run program CCRNXC
# --------------------
  my $PGMNAM = "CCRNXC";
  $bpe->RUN_PGMS($PGMNAM);

}
