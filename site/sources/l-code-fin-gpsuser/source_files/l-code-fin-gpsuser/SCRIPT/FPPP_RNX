use strict;

use File::Basename;

use lib $ENV{BPE};
use bpe_util;

use lib "$ENV{AUTO}";
use igs_device;

sub run {
  my $bpe = shift;



# Get variables
# -------------
 my   ($yyyy,$yy, $ddd, $ssss, $yyssss, $yyyyssss, $b,
      $dirRxo,$dirPzh,$dirClk,$dirDel,
      $extRxo,$extPzh,$extClk,$extDel
      ) =
    $bpe->getKeys(
      '$Y+0','$Y', '$+0', '$S+0','$YSS+0','$YYYSS+0','V_B',
      'DIR_RXO','DIR_PZH','DIR_CLK','DIR_DEL',
      'EXT_RXO','EXT_PZH','EXT_CLK','EXT_DEL'
      );

  #system("$ENV{AUTO}/get_obsdata.com $ddd -nostat -min=5");  # Repeat FTP

# Start the list of file to be copied
  my $clk = "${dirClk}${b}$yyssss.${extClk}";
  my @clkFil = stat($clk);

# Here we collect the files
  my %new = ();

# From the merged high-rate 5sec archive:
  foreach my $file ( glob("$CDIR_DATA/ORX/highrate/RINEX2/$yyyy/$ddd/????${ssss}.${yy}D.gz") ) {
    my $sta = substr(basename($file),0,4);
    my $pzh = "${dirPzh}${sta}${ssss}.${extPzh}";
    my @pzhFil = stat($pzh);
    my @rnxFil = stat($file);
    $new{$sta} = $file if ( ( !-s $pzh ) ||                # not processed yet
#                            ($pzhFil[9] < $rnxFil[9]) ||   # new RINEX file
                            ($pzhFil[9] < $clkFil[9]) );   # new clock solution
  }
  close RNX;

# RINEX 2 and RINEX 3 archive
  unlink glob("$dirRxo/?????????_${yyyyssss}.*");

  system("$ENV{AUTO}/put_igsdata.com $yy $ssss -o $dirRxo \"-or %FIN %CLK %ION %HRD %MGEX %PPP %EPN\" -r -v --bsw"); #
  my $rnxLst = "$dirRxo/RNXFIL${yy}${ddd}.lst";
  die "rinex file list not available: $rnxLst \n" unless -s $rnxLst;
  open RNX, "< $rnxLst";
  while (<RNX>) {
    chomp();
    my @dat = split();
    my $dest = $dat[0];
    my $src  = $dat[1];
    next unless -s $src;

    my $sta = substr(basename($dest),0,4);
    my $pzh = "${dirPzh}${sta}${ssss}.${extPzh}";
    my @pzhFil = stat($pzh);
    my @rnxFil = stat($src);

# check if already deleted in previous MPR run
    my $delFil = "${dirDel}MPR${yyssss}.${extDel}";
    my $mpr_sta="";
    if (-e $delFil) {
      $mpr_sta=`cat ${delFil} | grep "${sta}${ssss}.${extPzh}" 2>/dev/null`;
    }
    unlink (glob("${dirRxo}/${sta}*")) if ("${mpr_sta}" ne "");   # eliminated in previous MPR -> rm also Rinex
    next if ("${mpr_sta}" ne "");                                 # eliminated in previous MPR -> next
                                                                  # else use it, if...
    next unless(( !-s $pzh ) ||                                   # not processed yet
                ($pzhFil[9] < $rnxFil[9]) ||                      # new RINEX file
                ($pzhFil[9] < $clkFil[9]));                       # new clock solution
    system("gzip -d -c $src | CRX2RNX >${dirRxo}/$dest") && warn "Decompressing error wrt $src\n";
    print "$src copied to ${dirRxo}/$dest\n";
  }
  close RNX;

# Remove bad data
# ---------------
# -- reprocessing R03:
# grep "  1$" PPP09*OUT | awk '{print "A=`grep PARAM1 ../RP"$8"/BPE/*_"$9".PRT`; echo $A "$8}' | /bin/bash | awk '{print "  unlink(glob(\"${dirRxo}/../*/"$3""substr($4,3,4)"."substr($4,1,2)"O\"));"}'
# Remove LEO ...
  unlink (glob("${dirRxo}/../*/SACC*"));
  unlink (glob("${dirRxo}/../*/LPG2*"));
  unlink (glob("${dirRxo}/../*/JOGJ*")) if $yyyy == 2011 || $yyyy == 2010; # Wrong marker name (YOGY)
  unlink (glob("${dirRxo}/../*/OUS3*"));
# 2000
  unlink(glob("${dirRxo}/../*/GOLD1820.00O"));
  unlink(glob("${dirRxo}/../*/GOLD1830.00O"));
  unlink(glob("${dirRxo}/../*/NOT12520.00O"));
  unlink(glob("${dirRxo}/../*/NOT12530.00O"));
  unlink(glob("${dirRxo}/../*/NOT12550.00O"));
  unlink(glob("${dirRxo}/../*/NOT12560.00O"));
  unlink(glob("${dirRxo}/../*/NOT12570.00O"));
  unlink(glob("${dirRxo}/../*/NOT12580.00O"));
  unlink(glob("${dirRxo}/../*/ANKR2970.00O"));
