package BPE_CLN;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  BPE_CLN
#
# Purpose :  Clean BPE subdirectory
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  16-Feb-2004
#
# ============================================================================

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssssm30, $ssssm30, $taskId,
      $dirBpePrt, $extBpePrt,
      $dirBpeLog, $extBpeLog) =
    $bpe->getKeys('$YSS-(30)', '$S-(30)', 'TASKID',
                  'DIR_BPEPRT', 'EXT_BPEPRT',
                  'DIR_BPELOG', 'EXT_BPELOG');

# Delete PRT/LOG and BPE files
# ----------------------------
##  $taskId = "??";
  my @delLst = ("${dirBpePrt}${taskId}${yyssssm30}_???_???.${extBpePrt}",
                "${dirBpeLog}${taskId}${yyssssm30}_???_???.${extBpeLog}",
                "${dirBpePrt}???${ssssm30}???.BPE");

  foreach (@delLst) { unlink(glob($_)) }

}
