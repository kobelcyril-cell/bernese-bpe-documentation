package GIM_ORB;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GIM_ORB
#
# Purpose :  PREPARE STD/ERP INFORMATION BASED ON CODE'S FINAL SOLUTION
#
# Programs:  GIM_ORB
#
# Author  :  A. Villiger
# Created :  29-Sep-2016
#
# Changes :  27-Oct-2016 ss: Considered HR_yyssss.CLK
#            22-Apr-2020 ST: Change 'RB_' to 'BRD_'
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};

use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{BPE}";
use bpe_util;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ( $yyddd ,$yyssss,$yyyy  , $ddd,
       $repro,$v_e    ,$v_h,
       $crdInf,$v_mgex,$v_mix,
       $dirClk,$dirErp,$dirPre,$dirIon,
       $extClk,$extErp,$extPre,$extIon ) =
    $bpe->getKeys( '$YD+0'  ,'$YSS+0' ,'$Y+0'   , '$+0'    ,
                   'V_REPRO','V_E'    ,'V_H'    ,
                   'V_CRDINF','V_MGEX', '$V_MIX',
                   'DIR_CLK','DIR_ERP','DIR_PRE','DIR_ION',
                   'EXT_CLK','EXT_ERP','EXT_PRE','EXT_ION');


  my $preout = "${dirPre}GIM${yyddd}.${extPre}";
  my $erpout = "${dirErp}GIM${yyddd}.${extErp}";
  my $clkout = "${dirClk}GIM${yyddd}.${extClk}";
  my $ionout = "${dirIon}GIM${yyddd}.${extIon}";

  my $preapr = "${dirPre}APR${yyddd}.${extPre}";
  my @presel;
  my @clksel;
  my @ionsel;

# Define priority selection
# -------------------------
  if($repro){
    @presel = ( "$PATH_SAV/REPRO_03/${yyyy}/ORB/F1_${yyddd}.PRE");
    @clksel = ( "$PATH_SAV/$CAMP_SAVIGS/${yyyy}/ORB/B1_${yyddd}.CLK");
  }elsif($v_mgex eq "Y"){
    @presel = ("$PATH_SAV/MGEX/${yyyy}/ORB/RM_${yyddd}.PRE.Z");
    @clksel = ("$PATH_SAV/MGEX/${yyyy}/ORB/T3_${yyddd}.CLK.Z");
  }else{
    my $savDsk = "$PATH_SAV/$CAMP_SAVIGS/$yyyy/";
    @presel = ( "${savDsk}/ORB/_F3_${yyddd}.PRE",
                "${savDsk}/ORB/_F1_${yyddd}.PRE",
                "${CDIR_FIN}/ORB/F3_${yyddd}.PRE",
                "${CDIR_FIN}/ORB/F1_${yyddd}.PRE",
                "${CDIR_RAP}/ORB/RM_${yyddd}.PRE",
                "${CDIR_RAP}/ORB/RA_${yyddd}.PRE");

    @clksel = (
##                "$PATH_SAV/$CAMP_SAVRAPCLK/${yyyy}/ORB/HR_${yyssss}.CLK.Z",
                "${savDsk}/ORB/B1_${yyddd}.CLK",
                "${CDIR_FIN}/ORB/B1_${yyddd}.CLK",
                "${CDIR_RAP}/ORB/BRD_${yyddd}.CLK",
                "${CDIR_RAP}/ORB/BRD${yyddd}.CLK");

    @ionsel = ( "${savDsk}/ATM/${v_h}_${yyddd}.${extIon}",
                "${savDsk}/ATM/${v_e}_${yyddd}.${extIon}",
                "${CDIR_RAP}/ATM/RM_${yyddd}.${extIon}",
                "${CDIR_RAP}/ATM/RA_${yyddd}.${extIon}",
                "${CDIR_RAP}/ATM/RZ_${yyddd}.${extIon}");
  }

# Copy ORB, ERP, CLK and ION (optional) files
# -------------------------------------------
  foreach my $filpre (@presel){
    if( -s $filpre){
      prepFile($filpre,$preout);
      my $filerp = $filpre;
      $filerp =~ s/\.PRE/\.ERP/;
      prepFile($filerp,$erpout);
      last;
    }
  }
  foreach my $filclk (@clksel){
    if( -s $filclk){
      prepFile($filclk,$clkout);
      last;
    }
  }

  foreach my $filion (@ionsel){
    if( -s $filion){
      prepFile($filion,$ionout);
      last;
    }
  }

# Check PRE, ERP and CLK files
# ----------------------------
  unless(-s $preout){prtErr($bpe,"PRE_INFO_NOT_FOUND"); die();};
  unless(-s $erpout){prtErr($bpe,"ERP_INFO_NOT_FOUND"); die();};
  unless(-s $clkout){prtErr($bpe,"CLK_INFO_NOT_FOUND"); die();};

# Merge APR Orbit
# ---------------
  if(-s $preapr){
    copyfile("${dirErp}/GIM$yyddd.{$extErp}","${dirErp}/APR$yyddd.${extErp}");
    my $PGMNAM = "CCPREORB";
    $bpe->RUN_PGMS($PGMNAM);
    copyfile("${dirPre}/COMB$yyddd.{$extErp}","${dirPre}/GIM$yyddd.${extErp}");
  }

# Create STD file
# ---------------
  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);



# Merge GLONASS clocks
# --------------------
  my $clkinp = "$CDIR_RAP/ORB/GB_$yyddd.${extClk}";
  my $clkapr = "${dirClk}/APR$yyddd.${extClk}";

  if( -s $clkinp ){
    copyfile($clkout,$clkapr);
    system("$ENV{AUTO}/filmerge.pl $clkapr $clkinp $clkout 5");
  }
}



sub prepFile{
  my $inpFil = shift;
  my $outFil = shift;

  die "$inpFil does not exists\n" unless(-f $inpFil );

  if($inpFil =~ /\.gz$/){
    copyfile($inpFil,"$outFil.gz")       || err_print();
    uncompress("-z gunzip","$outFil.gz") || err_print();
    print "copy $inpFil to $outFil\n";
  }elsif($inpFil =~ /\.Z$/){
    copyfile($inpFil,"$outFil.Z")        || err_print();
    uncompress("-z gunzip","$outFil.Z")  || err_print();
    print "copy $inpFil to $outFil\n";
  }else{
    copyfile($inpFil,$outFil)            || err_print();
    print "copy $inpFil to $outFil\n";
  }
}
