package FIL_VER;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  FIL_VER
#
# Purpose :  Extract RMS from various FILEST checking output files.
#
# Programs:
#
# PARAMs  :  PARAM1 - Solution type descriptor
#
# Author  :  S. Schaer
# Created :  24-Oct-2016
#
# Changes :  25-Oct-2016/ss: Renamed files and deleted .RES files
#            26-Oct-2016/ss: Consider solution type descriptor
#            26-Oct-2016/ss: Report bad station observation files
#            01-Nov-2016/ss: Added RESRMS run and additional detection
#
# ----------------------------------------------------------------------------
use lib "$ENV{AUTO}";
use gpsutil;
use lib $ENV{BPE};
use bpe_util;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ddd, $ssss, $param1,
      $repro,
      $pcfFil, $taskId,
      $dirOut,$extOut,$dirOsb,$extOsb,$dirBia,$extBia,$dirRes,$extRes) =
    $bpe->getKeys('$YD+0', '$+0', '$S+0', 'PARAM1',
                  'V_REPRO',
                  'PCFFIL', 'TASKID',
                  'DIR_OUT','EXT_OUT','DIR_OSB','EXT_OSB','DIR_BIA','EXT_BIA','DIR_RES','EXT_RES');

  $pcfFil = (split('\.',$pcfFil))[0];

  $param1 = "STA" if $param1 eq "";
  my $sol = $param1;
  my $chr = substr($sol,0,1);

  my $outFil = "${dirOut}FIL${ddd}????_${chr}.${extOut}";
  $outFil = "${dirOut}????${ssss}_I.${extOut}" if $sol eq "STA";
  print "OUTFIL: $outFil\n";

  my $chkFil = "${dirOut}${sol}${yyddd}.CHK";
  print "CHKFIL: $chkFil\n";

  if (-s $chkFil) { move($chkFil,$chkFil."_OLD") }

  system("grep -i posteriori $outFil | grep ' M ' | sort -n -k9 > $chkFil");
  replace($chkFil,$dirOut,"");
  replace($chkFil," A POSTERIORI SIGMA OF UNIT WEIGHT  :","");
  replace($chkFil,' M  \(SIGMA OF ONE-WAY L1 PHASE OBSERVABLE AT ZENITH\)',"");
  unless ($sol eq "STA") {
    replace($chkFil,"FIL${ddd}","");
    replace($chkFil,"_${chr}","${ssss}_${chr}");
  } else {
    replace($chkFil,"_I","_${chr}");
  }

  my $dirBad = "${dirOut}../OUT_BAD/";
  check_dir($dirBad);

  my $badFil = "${dirOut}../MSC/BAD${yyddd}.FLG";
  my @lin = `cat $chkFil`;
  chomp(@lin);
  my ($n,$i,$rms,$rmsm,$sta,$lin);
  my $bad = 0;
  my $tol = 2;
  $tol = 4 if $sol eq "STA";
  $tol = 8 if $sol eq "ION";
##  $tol = 100;
  $n = @lin;
  for ($i=1;$i<=$n-1;$i++) {
    $rms  = (split(" ",$lin[$i]))[1];
    $rmsm = (split(" ",$lin[$i-1]))[1] if $bad == 0;
    $sta = substr((split(" ",$lin[$i]))[0],0,8);
    $lin = (split(" ",$lin[$i]))[0];
    if ($rms/$rmsm > $tol && $rms > 0.001 && $rmsm != 0) {
      `echo '$sta $lin $rms $rmsm' >> $badFil`;
      my $nam = "FIL${ddd}${sta}_${chr}.${extRes}";
      $nam = "${sta}${ssss}_.${extRes}" if $sol eq "STA";
      print "BAD: ${dirRes}${nam} ${dirBad}${nam}\n";
      copy("${dirRes}${nam}","${dirBad}${nam}");
      $bad++;
    }
  }
# Additional detection of bad observation data for CLK estimation
  if ($sol eq "CLK" && $bad == 0 && $rms >= 0.003) {
    `echo '$sta $lin $rms $rmsm' >> $badFil`;
    $bad = 1;
  }

# Run program
# -----------
  $bpe->putKey("$ENV{U}/PAN/MENU_EXT.INP","EXT_SUM","LST");

  $bpe->putKey("$ENV{U}/PAN/RESRMS.INP","RESFIL","FIL\$+0????_${chr}");
  $bpe->putKey("$ENV{U}/PAN/RESRMS.INP","RESFIL","????\$S+0_") if $sol eq "STA";
  $bpe->putKey("$ENV{U}/PAN/RESRMS.INP","SYSOUT","${sol}\$YD+0");
  $bpe->putKey("$ENV{U}/PAN/RESRMS.INP","OUTPUT","${sol}\$YD+0");
  $bpe->putKey("$ENV{U}/PAN/RESRMS.INP","STAWGTRS","${sol}\$YD+0");

  my $PGMNAM = "RESRMS";
  $bpe->RUN_PGMS($PGMNAM);

  unlink(glob($outFil)) unless $sol eq "STA";

  my $resFil = "${dirRes}FIL${ddd}????_${chr}.${extRes}";
  $resFil = "${dirRes}????${ssss}_.${extRes}" if $sol eq "STA";
  unlink(glob($resFil));

}
