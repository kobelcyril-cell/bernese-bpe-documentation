use strict;
use File::Basename;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yy,$ddd,$ssss,$sol,$param2,
      $dirPzh, $dirNeq, $dirOut, $dirOsb,$dirClk,
      $extPzh, $extNeq, $extOut, $extOsb,$extClk ) =
     $bpe->getKeys(
      '$Y','$+0','$S+0',"$$bpe{PARAM2}",'PARAM2',
      'DIR_PZH','DIR_NEQ','DIR_OUT','DIR_OSB','DIR_CLK',
      'EXT_PZH','EXT_NEQ','EXT_OUT','EXT_OSB','EXT_CLK');


# Remove old solution files
# -------------------------
  if ( $sol ne "" && $param2 =~ /^V_/ ) {
    unlink glob("${dirOut}${sol}R${ssss}*.${extOut}");
    unlink glob("${dirClk}${sol}R${ssss}*.${extClk}");
    unlink glob("${dirOsb}${sol}R${ssss}*.${extOsb}");
  }

# Get list of stations to be processed
# ------------------------------------
  my @station;
  foreach (glob("${dirNeq}/${sol}_${ssss}????.${extNeq}")){
    my ($sta) = /${ssss}(\w\w\w\w)\.${extNeq}/;
    print "$_ ${ssss}(\w\w\w\w)\.${extNeq} $sta\n";
    push @station, "$sta $sol";
  }

# Put the BPE cluster files into the list
# ---------------------------------------
  initPar_Bl($bpe, @station);

}
