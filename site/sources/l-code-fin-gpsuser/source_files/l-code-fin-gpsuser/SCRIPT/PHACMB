package PHACMB;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  PHACMB
#
# Purpose :  Execute PHACMB
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  26-Jul-2017
#
# Changes :  19-Sep-2017 AV: Modified OSB generation(replace L.X)
#            26-Sep-2017 SS: Corrections concerning $iz_file and $izdfile
#            22-May-2018 SS: Translation of PARAMs
#            05-Jun-2018 SS: Created PHA OSB file
#            20-Jun-2018 SS: Added ECJ
#            19-Sep-2018 SS: Considered NO_NLB.FLG
#            26-Sep-2023 SS: Added E:L5I
#            28-Sep-2023 SS: Commented E:L5I
#            30-Apr-2024 SS: Considered C:L6X
#            02-May-2024 SS: Inserted comprehensive list of GNSS observables
#            03-May-2024 SS: Added G:L1L, G:L1X, R:L3Q, R:L3X
#            11-Mar-2026 SS: Reviewed OBS table: +R:L4X, +R:L6X
#                                                +E:L6B, -E:L8I
#                                                -C:L5D
#                                                +J:L1E, -J:L1Z, +J:L5P
#                                                +S:L1C, +S_L5I
#
# ============================================================================
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my   ($yyssss,
        $isb,$wlb,$nlb,$izd,
        $dirOut,$dirOsb,$extOsb) =
 $bpe->getKeys(
      '$YSS+0',
      'PARAM1','PARAM2','PARAM3','PARAM4',
      'DIR_OUT','DIR_OSB','EXT_OSB'
      );

  $isb = $$bpe{"V_$isb"} if length($isb) == 1;
  $wlb = $$bpe{"V_$wlb"} if length($wlb) == 1;
  $nlb = $$bpe{"V_$nlb"} if length($nlb) == 1;
  $izd = $$bpe{"V_$izd"} if length($izd) == 1;

# Create combined OSB file
# ------------------------
  my $isbfile = "${dirOsb}/${isb}${yyssss}.${extOsb}";
  my $wl_file = "${dirOsb}/${wlb}${yyssss}.${extOsb}";
  my $nl_file = "${dirOsb}/${nlb}${yyssss}.${extOsb}";
  my $iz_file = "${dirOsb}/".substr(${izd},0,2)."_${yyssss}.${extOsb}";
  my $izdfile = "${dirOsb}/${izd}${yyssss}.${extOsb}";
  my $phafile = "${dirOsb}/PHA${yyssss}.${extOsb}";

  if(-s $wl_file && -s $nl_file){
    system("perl $ENV{AUTO}/cmb_phabia.com $wl_file $nl_file $iz_file");
    if(-s $iz_file){

      my %osb;
# G: C1C/L1C C1L/L1L C1W/L1W C1X/L1X C2L/L2L C2S/L2S C2W/L2W C2X/L2X C5Q/L5Q C5X/L5X
      $osb{G}{L1X}{L1C} = 1;
      $osb{G}{L1X}{L1L} = 1;
      $osb{G}{L1X}{L1W} = 1;
      $osb{G}{L1X}{L1X} = 1;
      $osb{G}{L2X}{L2C} = 1;
      $osb{G}{L2X}{L2L} = 1;
      $osb{G}{L2X}{L2S} = 1;
      $osb{G}{L2X}{L2W} = 1;
      $osb{G}{L2X}{L2X} = 1;
      $osb{G}{L5X}{L5Q} = 1;
      $osb{G}{L5X}{L5X} = 1;
# R: C1C/L1C C1P/L1P C2C/L2C C2P/L2P C3Q/L3Q C3X/L3X C4X/L4X C6X/L6X
      $osb{R}{L1X}{L1C} = 1;
      $osb{R}{L1X}{L1P} = 1;
      $osb{R}{L2X}{L2C} = 1;
      $osb{R}{L2X}{L2P} = 1;
      $osb{R}{L3X}{L3Q} = 1;
      $osb{R}{L3X}{L3X} = 1;
      $osb{R}{L4X}{L4X} = 1;
      $osb{R}{L6X}{L6X} = 1;
# E: C1C/L1C C1X/L1X C5Q/L5Q C5X/L5X C6B/L6B C6C/L6C C6X/L6X C7Q/L7Q C7X/L7X C8Q/L8Q C8X/L8X
      $osb{E}{L1X}{L1C} = 1;
      $osb{E}{L1X}{L1X} = 1;
      $osb{E}{L5X}{L5Q} = 1;
      $osb{E}{L5X}{L5X} = 1;
      $osb{E}{L6X}{L6B} = 1;
      $osb{E}{L6X}{L6C} = 1;
      $osb{E}{L6X}{L6X} = 1;
      $osb{E}{L7X}{L7Q} = 1;
      $osb{E}{L7X}{L7X} = 1;
      $osb{E}{L8X}{L8Q} = 1;
      $osb{E}{L8X}{L8X} = 1;
# C: C1D/L1D C1P/L1P C1X/L1X C2I/L2I C2X/L2X C5P/L5P C5X/L5X C6I/L6I C6X/L6X C7D/L7D C7I/L7I C7X/L7X C7Z/L7Z C8X/L8X
      $osb{C}{L1X}{L1D} = 1;
      $osb{C}{L1X}{L1P} = 1;
      $osb{C}{L1X}{L1X} = 1;
      $osb{C}{L2X}{L2I} = 1;
      $osb{C}{L2X}{L2X} = 1;
      $osb{C}{L5X}{L5P} = 1;
      $osb{C}{L5X}{L5X} = 1;
      $osb{C}{L6X}{L6I} = 1;
      $osb{C}{L6X}{L6X} = 1;
      $osb{C}{L7X}{L7D} = 1;
      $osb{C}{L7X}{L7I} = 1;
      $osb{C}{L7X}{L7X} = 1;
      $osb{C}{L7X}{L7Z} = 1;
      $osb{C}{L8X}{L8X} = 1;
# J: C1C/L1C C1E/L1E C1L/L1L C1X/L1X C1Z/L1Z C2L/L2L C2S/L2S C2X/L2X C5P/L5P C5Q/L5Q C5X/L5X C6L/L6L C6S
      $osb{J}{L1X}{L1C} = 1;
      $osb{J}{L1X}{L1E} = 1;
      $osb{J}{L1X}{L1L} = 1;
      $osb{J}{L1X}{L1X} = 1;
      $osb{J}{L2X}{L2L} = 1;
      $osb{J}{L2X}{L2S} = 1;
      $osb{J}{L2X}{L2X} = 1;
      $osb{J}{L5X}{L5P} = 1;
      $osb{J}{L5X}{L5Q} = 1;
      $osb{J}{L5X}{L5X} = 1;
# S: C1C/L1C C5I/L5I
      $osb{S}{L1X}{L1C} = 1;
      $osb{S}{L5X}{L5I} = 1;

      open OUT, "> $izdfile";
      open INP, "< $isbfile";
      map {print OUT $_} (<INP>);
      close INP;
      open INP, "< $iz_file";
      foreach (<INP>){
        if(/OSB  (\w)\d\d\d .* (L\d\w) /){
          my $otyp = $2;
          chomp;
          foreach my $obstyp (sort keys %{$osb{$1}{$otyp}}){
            my $line = $_;
            $line =~ s/$otyp/$obstyp/;
            print OUT "$line\n";
          }
        }
      }
      map {print OUT $_ if / L\d\w /} (<INP>);
      close INP;
      close OUT;
    }
    unlink($iz_file);

    my $nlbFlg = "${dirOut}../MSC/NO_NLB.FLG";
    if (-e $nlbFlg) {
      `grep -v '  L[1-9][A-Z]   ' $izdfile > ${izdfile}_`;
      move("${izdfile}_",$izdfile);
      print "PHA OSB removed from IAR${yyssss}.OSB due to NO_NLB.FLG\n";
    }

    `grep -v '  C[1-9][A-Z]   ' $izdfile > $phafile`;
    die "$phafile not found\n" unless -s $phafile;
  }
}
