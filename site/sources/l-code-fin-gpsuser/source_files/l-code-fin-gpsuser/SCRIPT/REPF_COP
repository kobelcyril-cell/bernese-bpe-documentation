use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyssss,$yyyy,$yy,$ssss,$ddd,$yyddd,$yymm,$wwwwd,$mjd,
    $gnss,  $v_tropMod,
    $crdInf,$psdInf,$v_b,$v_k,$v_x,$v_repErp,$param2,$camp_pth,$campaign,
    $dirCrd,$dirRxo,$dirErp,$dirOsb,$dirDcb,$dirPre,$dirSnx,$dirPsd,$dirVel,$dirSta,
    $extCrd,$extRxo,$extErp,$extOsb,$extDcb,$extPre,$extSnx,$extPsd,$extVel,$extSta
  ) =
  $bpe->getKeys(
    '$YSS+0','$Y+0','$Y','$S+0','$+0','$YD+0','$M+0','$WD+0','$JD+0',
    'V_GNSS',  'V_TRPMOD',
    'V_CRDINF','V_PSDINF','V_B','V_K','V_X','V_REPERP','PARAM2','CAMP_PTH','CAMPAIGN',
    'DIR_CRD','DIR_RXO','DIR_ERP','DIR_OSB','DIR_DCB','DIR_PRE','DIR_SNX','DIR_PSD','DIR_VEL','DIR_STA',
    'EXT_CRD','EXT_RXO','EXT_ERP','EXT_OSB','EXT_DCB','EXT_PRE','EXT_SNX','EXT_PSD','EXT_VEL','EXT_STA'
  );

  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");
  my ($line, @tmp, $inpPre, $inpErp);


# Prepare reference files
# -----------------------
  my $psdFil = $psdInf eq ""? "":"${psdInf}.${extPsd}";
  system("$ENV{AUTO}/copyRef.pl ${dirCrd}.. $crdInf $psdFil REF$yyssss");
  if ($mjd < 157023) {
   copyfile("$ENV{REF}/$crdInf.${extSnx}","$dirSnx");
   copyfile("$dirCrd/$crdInf.${extCrd}","${dirCrd}/${crdInf}_0.${extCrd}");
   copyfile("$dirVel/$crdInf.${extVel}","${dirVel}/${crdInf}_0.${extVel}");

   $bpe->putKey("$ENV{U}/PAN/SNX2NQ0.INP","DATUMSTR","IGb14_0") if $crdInf eq "IGB14";
   $bpe->putKey("$ENV{U}/PAN/SNX2NQ0.INP","DATUMSTR","IGb20_0") if $crdInf eq "IGB20";

   my $PGMNAM = "SNX2NQ0";
   $bpe->RUN_PGMS($PGMNAM);

   $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP",'RADIO_1',0);
   $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP",'RADIO_2',1);
   $PGMNAM = "CRDMERGE";
   $bpe->RUN_PGMS($PGMNAM);

   $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP",'RADIO_1',1);
   $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP",'RADIO_2',0);
   $PGMNAM = "CRDMERGE";
   $bpe->RUN_PGMS($PGMNAM);
  }

# copyfile("${dirOsb}CODE.${extOsb}","${dirOsb}APR${yyddd}.${extOsb}");
# copyfile("$ENV{REF}/CODE_Y1994_EXT.${extOsb}","${dirOsb}APR${yyddd}.${extOsb}");
 copyfile("$ENV{S}/MGEX/$yyyy/ORB/IAR${yyddd}0.${extOsb}","${dirOsb}APR${yyddd}.${extOsb}");
 
 copyfile("$ENV{REF}/CODE.${extSta}","${dirSta}");

# Copy files for reprocessing
# ---------------------------
#old    # DCB
#old    # ---
#old    # TUM monthly DCBs
#old    my $inpDcb = "$PATH_DATA$CAMP_DATA/DCB_TUM/C1_$yymm.$extDcb";
#old    # CODE operational DCBs
#old    if (!-e $inpDcb)
#old    {$inpDcb ="$PATH_SAV/$CAMP_SAVIGS/$yyyy/ORB/P1C1$yymm.$extDcb";}
#old    copyfile("$inpDcb","${dirDcb}${v_b}0$yyddd.$extDcb");

  # ERP
  # ---
  copyfile("$ENV{REF}/$v_repErp.${extErp}","$dirErp");

  # Orbits: DACH repro if available
  # -------------------------------
  $inpPre = "$ENV{S}/MGEX/$yyyy/ORB/RMN$yyddd.${extPre}.Z";

  if ( !-e $inpPre ) {
    print "EGSIEM-REPRO reprocessed orbits not available: using operational orbits ...\n";

    # operational CODE F3 orbits (starting 260/2012)
    $inpPre = "$ENV{S}/MGEX/$yyyy/ORB/RM_$yyddd.${extPre}.Z";
   }
  else {
   copy($inpPre,"${dirPre}ERP${yyddd}.$extPre.Z");
   uncompress("${dirPre}ERP${yyddd}.$extPre.Z");
  }

  copyfile("$inpPre","${dirPre}${v_x}_${yyddd}.${extPre}.Z");
  uncompress("${dirPre}${v_x}_${yyddd}.${extPre}.Z");

  # extract only current day from ERP file
  copyfile("$ENV{REF}/${v_repErp}.${extErp}","${dirErp}");
  my $PGMNAM = "POLUPD";
  $bpe->RUN_PGMS($PGMNAM);

  copyfile("${dirErp}${v_x}_${yyddd}.${extErp}","${dirErp}FIN${yyddd}.${extErp}");

  # Generate "broadcast" for reprocessing
  $PGMNAM = "SATCLK2";
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);

  # Copy Vienna grid files
    if ( $v_tropMod =~ /VMF/ ) {
      system("$ENV{AUTO}/copyGrid.pl ${dirCrd}.. $ddd $v_tropMod");
    }


# Copy MGEX orbits if Galileo is active
  if($gnss=~/Z/){
    my $mgxsrc  = "$ENV{S}/MGEX/${yyyy}/ORB/";
    my $mgxorb0 = "MGX${yyddd}.${extPre}";
    my $mgxorb  = "RM_${yyddd}.${extPre}";
    $mgxorb = "${mgxorb}.Z" if(-e "${mgxsrc}${mgxorb}.Z");
    $mgxorb = "${mgxorb}.gz" if(-e "${mgxsrc}${mgxorb}.gz");
    my $dstorb = "${dirPre}/$mgxorb";
    $dstorb =~ s/RM_/MGX/;
    if(-e "${mgxsrc}${mgxorb}"){
      copyfile("${mgxsrc}${mgxorb}",$dstorb);
      if( $dstorb=~/\.(Z|gz)$/){
        system("gzip -d $dstorb");
      }
    }

    my $mgxerp0 = "MGX${yyddd}.${extErp}";
    my $mgxerp  = "RM_${yyddd}.${extErp}";
    $mgxerp = "${mgxerp}.Z" if(-e "${mgxsrc}${mgxerp}.Z");
    $mgxerp = "${mgxerp}.gz" if(-e "${mgxsrc}${mgxerp}.gz");
    my $dsterp = "${dirPre}/$mgxerp";
    $dsterp =~ s/RM_/MGX/;
    if(-e "${mgxsrc}${mgxerp}"){
      copyfile("${mgxsrc}${mgxerp}",$dsterp);
      if( $dsterp=~/\.(Z|gz)$/){
        system("gzip -d $dsterp");
      }
    }
    unless ( -e "${dirPre}/$mgxorb0" && -e "${dirPre}/$mgxerp0" ) {
      prtMess($bpe,"MGEX products are missing from $mgxsrc");
      die("MGEX products are missing from $mgxsrc");
    }

#  }elsif($gnss=~/[CJ]/){
#    prtMess($bpe,"Beidou and QZSS not supported( selected: $gnss");
#    die;
  }

# Stop in case of error
# ---------------------
  $On_Error_Cont = 1;
  err_print() || die();

# Prepare daily RINEX data
# ------------------------
  # Uncompress XML_ORX
  my @xmlorxList = glob("$ENV{PATH_XMLORX}/XML_ORX/daily/RINEX?/${yyyy}/${ddd}/*");
  foreach my $xmlorx (@xmlorxList) {
    uncompress("-z gunzip",$xmlorx,1)
  }

#    system("$ENV{AUTO}/put_data.com $yy $sss %REP %FIN $dirRxo");
    my $rnx = $mjd < 57023 ? " -r2 " : "-r[23]";
    system("$ENV{AUTO}/put_igsdata.com $yy $ssss -o $dirRxo %REP %FIN $rnx --bsw");

# Use only one receiver of antenna splitter stations
     my $selFil="$ENV{REF}/ANTSPLIT.SEL";
     open(FIL,$selFil);
     for(my $i=1;$i<=3;$i++){ $line=<FIL>;}
     while ($line= <FIL>) {
         @tmp=split(" ",$line);
         if (-e "${dirRxo}$tmp[0]${ssss}.$extRxo")
           { unlink("${dirRxo}$tmp[1]${ssss}.$extRxo") ;
             print "${dirRxo}$tmp[1]${ssss}.$extRxo deleted\n";}
     }
     close FIL;
     # special handling of BAHR/BHR1/BHR2
     if (-e "${dirRxo}BAHR${ssss}.$extRxo")
       {unlink("${dirRxo}BHR1${ssss}.$extRxo");
        unlink("${dirRxo}BHR2${ssss}.$extRxo");}

     if (-e "${dirRxo}HARB3000.20O"){unlink("${dirRxo}HARB3000.20O");}
     if (-e "${dirRxo}HRAO3000.20O"){unlink("${dirRxo}HRAO3000.20O");}
     if (-e "${dirRxo}HRAO3390.20O"){unlink("${dirRxo}HRAO3390.20O");}
     if (-e "${dirRxo}SUTH3390.20O"){unlink("${dirRxo}SUTH3390.20O");}
     if (-e "${dirRxo}SUTM3390.20O"){unlink("${dirRxo}SUTM3390.20O");}

  system("$ENV{AUTO}/rinex.com $dirRxo $ddd $yy");


# Copy coordinates from last reprocessing for comparison
# ------------------------------------------------------
#  if ($repro) {
#    my $sol = 'OLD';
#    my $oldCrd = "$ENV{S}/$ENV{CAMP_SAVREPO}/${yyyy}/STA/${v_k}_${yyddd}.${extCrd}";
#    print "copied $oldCrd -> ${dirCrd}${sol}${yyddd}.${extCrd}\n";
#    copy("$oldCrd","${dirCrd}${sol}${yyddd}.${extCrd}");
#  }

}

# ==============================================================================

__END__
