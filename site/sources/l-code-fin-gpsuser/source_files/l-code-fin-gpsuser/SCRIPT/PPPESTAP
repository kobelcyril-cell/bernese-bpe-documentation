package PPPESTAP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  PPPESTAP
#
# Purpose :  Prepare parallel GPSEST run for zero-difference files
#
# Remark  :  The use only phase data
#
# PARAMs  :  PARAM2 - output file identifier (default: EST)
#
# Author  :  R. Dach
# Created :  11-Aug-2011
#
# Changes :  06-Nov-2019 MK: add Galileo
#
# ============================================================================
use strict;

use File::Basename;

use lib $ENV{BPE};
use bpe_util qw(prtErr initPar_Bl initPar_Cl);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ssss    , $yyssss  ,
      $param2  , $i       , $clu     , $obstyp  , $dirBpe,
      $dirCzh  , $dirPzh  , $dirOut  , $dirNeq  , $dirObs,
      $extCzh  , $extPzh  , $extOut  , $extNeq) =
  $bpe->getKeys
     ('$S+0'   , '$YSS+0' ,
      'PARAM2' , 'V_I'    , 'V_PPPCLU','PARAM3','DIR_BPEPRT',
      'DIR_CZH', 'DIR_PZH', 'DIR_OUT', 'DIR_NEQ','DIR_PZH',
      'EXT_CZH', 'EXT_PZH', 'EXT_OUT', 'EXT_NEQ');

# Delete old files (OUT, NQ0)
# ---------------------------
  my $est = "EST";
  if ( $param2 ne "" ) {
    $est = defined $$bpe{$param2} ? $$bpe{$param2} : $param2;
  }
  
# Initialize parallel run
# -----------------------
  my $bpeFil = "${dirBpe}${est}${ssss}";


# Find out which observation files are needed
# -------------------------------------------
  my $isCode  = $obstyp ne "" ?  ($obstyp ne "PHASE") : 0;
  my $isPhase = $obstyp ne "" ?  ($obstyp ne "CODE")  : 1;


#  print "eo: dirty workaround... rm URUM obs files!\n";
#  system("rm -v ${dirObs}URUM$ssss.*");


  my @obsFil = ();
  if ($isPhase) {
    @obsFil = glob("${dirPzh}????${ssss}.${extPzh}");
  } elsif ($isCode) {
    @obsFil = glob("${dirCzh}????${ssss}.${extCzh}");
  }

# Filter GPS-only sites for GLONASS-only solution
# -----------------------------------------------
  if ( $est eq "GLO" ) {
    my @newLst = ();
    foreach my $obs ( @obsFil ) {
      my $sta = substr(basename($obs),0,4);
      my $gnsOut = "${dirOut}${i}${ssss}${sta}.${extOut}";
      my $glo = 0;
      open ( OUT,"<$gnsOut");
      while(my $line = <OUT>) {
        $glo = $glo || ( $line =~ /^ 1[102][0-9]   255/ );
        last if $glo ||  $line =~ /^ SATELLITE PROBLEMS/;
      }
      close OUT;
      push @newLst,$obs if $glo;
    }
    @obsFil = @newLst;
  }

  if ( $est eq "GAL" ) {
    my @newLst = ();
    foreach my $obs ( @obsFil ) {
      my $sta = substr(basename($obs),0,4);
      my $gnsOut = "${dirOut}${i}${ssss}${sta}.${extOut}";
      my $gal = 0;
      open ( OUT,"<$gnsOut");
      while(my $line = <OUT>) {
        $gal = $gal || ( $line =~ /^ 2[102][0-9]   29/ );
        last if $gal ||  $line =~ /^ SATELLITE PROBLEMS/;
      }
      close OUT;
      push @newLst,$obs if $gal;
    }
    @obsFil = @newLst;
  }
  
  if ($clu ne "") {
    initPar_Cl($bpe,$bpeFil,@obsFil,0,$clu,0, ("$obstyp"));
  } else {
    @obsFil = map { substr(basename($_),0,4) } @obsFil;
    initPar_Bl($bpe,@obsFil, ("$obstyp"));
  }

}
