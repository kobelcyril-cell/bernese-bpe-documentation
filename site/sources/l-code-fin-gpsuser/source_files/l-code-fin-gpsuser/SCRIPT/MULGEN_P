package MULGEN_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  MULGEN_P
#
# Purpose :  Execute GPSEST and ADDNEQ2 for bias multiplier retrieval
#
# PARAMs  :  PARAM1 - processing filename (baseline)
#
# Author  :  S. Schaer
# Created :  23-Jun-2016
#
# Changes :  08-Feb-2019 AV: Remove stations with dof bellow 0
#            16-Jan-2025 SS: Considered year with fractional part
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib $ENV{EXE};
use Gps_Date;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($param1,$yyyy,$yyddd,$ssss,$dirout, $extout) =
    $bpe->getKeys('PARAM1','$Y+0','$YD+0','$S+0','DIR_OUT','EXT_OUT');

  my $file = $param1;

# Set variables
# -------------
  setUserVar($bpe,"FFFF","$file");

  prtMess($bpe,"BASELINE: $file");

# Update geomagnetic pole coordinates
  # -----------------------------------
  my $yyyyF = gps_date("-yd $yyddd -d 0.5 -o %FY");
  my $lat = `$ENV{AUTO}/geomagnetic_pole.com $yyyyF -lat`;
  chomp($lat);
  my $lon = `$ENV{AUTO}/geomagnetic_pole.com $yyyyF -lon`;
  chomp($lon);
  print "FY: $yyddd $yyyyF $lat $lon\n";

  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","LATPOL",$lat);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","LONPOL",$lon);

# Run programs
# ------------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

  my $outfil   = $bpe->getKey("$ENV{U}/INP/GPSEST.INP","SYSOUT");
  my $ndof = getDOF($outfil);
  if($ndof>=0){
   $PGMNAM = "ADDNEQ2";
   $bpe->RUN_PGMS($PGMNAM);
  }else{
    unlink $bpe->getKey("$ENV{U}/INP/GPSEST.INP","NEQUARS");
    my $badFil = "${dirout}../MSC/BAD${yyddd}.FLG";
    print "BADFIL: $badFil\n";
    open OUT, ">>$badFil";
    print OUT "$file\n";
    close OUT;
    prtMess($bpe,"BAD OBSERVATION DATA FOUND: ${file}${ssss}");
  }

}

sub getDOF{
    my $inpfil = shift;
    open INP, "< $inpfil";
    my $numobs =  0;
    my $numpar = 99;

    foreach (<INP>){
        $numobs = $1 if /^ TOTAL NUMBER OF OBSERVATIONS   *(\d*)/;
        $numobs = $1 if /^ Total number of observations   *(\d*)/;
        $numpar = $1 if /^ TOTAL NUMBER OF PARAMETERS *(\d*) /;
        $numpar = $1 if /^ Total number of parameters *(\d*) /;
    }
    close INP;
    return ($numobs-$numpar);
}
