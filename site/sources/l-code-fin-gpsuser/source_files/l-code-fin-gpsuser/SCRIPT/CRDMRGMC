package CRDMRGMC;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name:      CRDMRGMC
#
# Purpose:   Merge coordinate files
#
# Programs:  CRDMERGE
#
# Author  :  A. Villiger/A.Susnik
# Created :  11-Oct-2016
#
# Changes :  10-Jul-2018 AV: Only merge in case of PPP
#            22-Apr-2020 RD: Remove the 1-day part
#
# ----------------------------------------------------------------------------

use strict;
use lib $ENV{BPE};


sub run
{
  my $bpe = shift;


# Get variables
# -------------
  my ($yyssss, $mode, $upd, $v_k) =
    $bpe->getKeys('$YSS+0', 'V_MODE','PARAM1','V_K');


# merge itrf with 3-day coordinates
# ---------------------------------
  my $PGMNAM = "CRDMERGE";
  if($upd){
    $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP","CRDMTR","${upd}_${yyssss}");
  }
  $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP","CRDMTR","${v_k}_${yyssss}");
  $bpe->putKey("$ENV{U}/PAN/CRDMERGE.INP","CRDRES","${v_k}_${yyssss}");

# Run program CRDMERGE
# --------------------
  $bpe->RUN_PGMS($PGMNAM) if $mode=~/PPP/;

}
