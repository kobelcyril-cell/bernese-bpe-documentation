package FCLK1DEL;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  FCLK1DEL
#
# Purpose :  Delete FCLKGNSS files
#
# PARAMs  :
#
# Author  :  A. Villiger
# Created :  24-Oct-2016
#
# Changes :  06-Mar-2017 AV: Add additional PPP solutions
#            07-Mar-2017 AV: Add SATMRK output
#            07-Mar-2017 AV: Fix inversion solutions
#            08-Jan-2018 AV: Remove station NEQs after one day
#            26-Jul-2019 AV: Bugfix regarding deletion (??? -> ????)
#            09-Jul-2020 RD/AV: Remove 1-day solution
#            13-Jul-2020 RD/PF: PTH_GEN->PTH_SATCRUX
#            13-Aug-2021 RD: Start using BSW-style filenaming in the campaign area
#            09-Jan-2023 RD: PPP-based Troposphere products added
#            20-Apr-2023 RD: Merge and store also tropo results as TRP (for BKG)
#
# ============================================================================
use strict;
use lib "$ENV{AUTO}";
use gpsutil qw(copyfile);
use igs_device;
use lib "$ENV{BPE}";


sub run {
  my $bpe = shift;



# Get variables
# -------------
 my ( $yyyy, $yy,$yyssss, $yyddd, $ssss,$ddd,$dddm5,
      $yyyym05, $yyyym10, $yyyym30,$ssssm01, $ssssm02, $ssssm05, $ssssm10,$ssssm30,
      $yydddm05, $yyssssm05, $yydddm10,$yyssssm02,$yyssssm10, $yyssssm30, $yyssssm90,
      $a, $b, $c, $h, $i, $k, $e, $trp,
      $u, $t, $q, $w, $del,$repro,
      $dirCrx, $dirRes, $dirEdt, $dirStd, $dirErp, $dirGrd, $dirIon, $dirTro,
      $extCrx, $extRes, $extEdt, $extStd, $extErp, $extGrd, $extIon, $extTro,
      $dirSmt, $dirRxo, $dirFix, $dirClk, $dirRxc, $dirSmc, $dirSos, $dirSig,
      $extSmt, $extRxo, $extFix, $extClk, $extRxc, $extSmc, $extSos, $extSig,
      $dirNeq, $dirCrd, $dirTrp, $dirOsb, $dirOut, $dirSum, $dirLst, $dirDel,
      $extNeq, $extCrd, $extTrp, $extOsb, $extOut, $extSum, $extLst, $extDel,
      $dirPzh, $dirPzo, $dirCzh, $dirCzo, $dirClb, $dirLog, $dirPrt,
      $extPzh, $extPzo, $extCzh, $extCzo, $extClb, $extLog, $extPrt,
      ) =
    $bpe->getKeys(
      '$Y+0', '$Y','$YSS+0', '$YD+0', '$S+0','$+0','$-5',
      '$Y-5','$Y-(10)','$Y-(30)','$S-1','$S-2','$S-5','$S-(10)','$S-(30)',
      '$YD-5','$YSS-5','$YD-(10)','$YSS-2','$YSS-(10)','$YSS-(30)','$YSS-(90)',
      'V_A', 'V_B', 'V_C', 'V_H','V_I', 'V_K', 'V_E', 'V_TRP',
      'V_U','V_T','V_Q','V_W','V_DEL','V_REPRO',
      'PTH_SATCRUX','DIR_RES','DIR_EDT','DIR_STD','DIR_ERP','DIR_GRD','DIR_ION','DIR_TRO',
      'EXT_SATCRUX','EXT_RES','EXT_EDT','EXT_STD','EXT_ERP','EXT_GRD','EXT_ION','EXT_TRO',
      'DIR_SMT','DIR_RXO','DIR_FIX','DIR_CLK','DIR_RXC','DIR_SMC','DIR_SOS','DIR_SIG',
      'EXT_SMT','EXT_RXO','EXT_FIX','EXT_CLK','EXT_RXC','EXT_SMC','EXT_SOS','EXT_SIG',
      'DIR_NEQ','DIR_CRD','DIR_TRP','DIR_OSB','DIR_OUT','DIR_SUM','DIR_LST','DIR_DEL',
      'EXT_NEQ','EXT_CRD','EXT_TRP','EXT_OSB','EXT_OUT','EXT_SUM','EXT_LST','EXT_DEL',
      'DIR_PZH','DIR_PZO','DIR_CZH','DIR_CZO','DIR_CLB','DIR_BPELOG','DIR_BPEPRT',
      'EXT_PZH','EXT_PZO','EXT_CZH','EXT_CZO','EXT_CLB','EXT_BPELOG','EXT_BPEPRT'
      );

# Set all deletion dates to current session
# -----------------------------------------
     if(1==2){
       $yyssssm02 = $yyssss;
       $ssssm02   = $ssss;
       $yyyym05   = $yyyy;
       $yydddm05  = $yyddd;
       $yyssssm05 = $yyssss;
       $ssssm05   = $ssss;
       $yyyym10   = $yyyy;
       $ssssm10   = $ssss;
       $yydddm10  = $yyddd;
       $yyssssm10 = $yyssss;
       $yyssssm30 = $yyssss;
       $ssssm30   = $ssss;
       $yyssssm90 = $yyssss;
     }

# Delete Files if requested
# -------------------------
    if ( ${del} ne "Y" ) {
#      prtMess($bpe,"FILES NOT DELETED");

# Delete Files from Previous Run
# ------------------------------
    } else {
        print "UNLINK STAFF\n";
        unlink glob "$dirOut*.J_lk";

# Input files
# ------------------------
        unlink glob "$dirCrd/${k}_${yyssssm10}.${extCrd}";
        unlink glob "$dirCrd/FCLK${yyssssm10}.${extCrd}";
        unlink glob "$dirCrd/X3D_${yyssss}.${extCrd}";
        unlink glob "$dirCrd/PPP${yyssssm10}.${extCrd}";

        unlink glob "$dirCrd/${b}_${yyssssm10}.${extCrd}";
        unlink glob "$dirStd/${b}_${yyssssm10}.${extStd}";
        unlink glob "$dirErp/${b}_${yyssssm10}.${extErp}";
        unlink glob "$dirStd/${k}_${yyssssm10}.${extStd}";
        unlink glob "$dirErp/${k}_${yyssssm10}.${extErp}";

        unlink glob "$dirTrp/${k}?${yyssssm10}.${extTrp}";

        unlink glob "$dirClk/${a}?${yyssssm10}.${extClk}";
        unlink glob "$dirRxc/${a}?${yyssssm10}.${extRxc}";
        unlink glob "$dirOsb/APR${yydddm10}*.${extOsb}";

        unlink glob "$dirIon/HOI${yydddm10}.${extIon}";
        unlink glob "$dirGrd/VMF${yydddm10}.${extGrd}";
        unlink glob "$dirCrx/CLK${yyssssm10}.${extCrx}";

# Prepocessing RINEX input
# ------------------------
        unlink glob "$dirRxo/????${ssssm10}.${dirRxo}";
        unlink glob "$dirRxo/*${ssssm10}.RXO";
        unlink glob "$dirSmt/*${ssssm10}.${dirSmt}";
        unlink glob "$dirPzh/????${ssssm10}.???";

        unlink glob "$dirOut/SMT2${yyssssm10}??.${extOut}";
        unlink glob "$dirOut/OBS2${yyssssm10}??.${extOut}";

        unlink glob "$dirSmc/SMT${yyssssm10}.${extSmc}";
        unlink glob "$dirLst/RNX${yyssssm10}.${extLst}";
        unlink glob "$dirDel/DEL${yyssssm10}.${extDel}";

        unlink glob "$dirRxc/${e}${ssssm10}*.$extRxc";
        unlink glob "$dirOut/${e}${ssssm10}*.$extOut";

        unlink glob "$dirClk/${a}0${yyssssm10}*.$extClk";
        unlink glob "$dirClk/${a}_${yyssssm10}*.$extClk";

        unlink glob "$dirRxc/${w}_${yyssssm10}*.$extRxc";
        unlink glob "$dirSig/${w}_${yyssssm10}*.$extSig";
        unlink glob "$dirOut/${w}_${yyssssm10}*.$extOut";

        unlink glob "$dirOut/${i}?${ssssm10}*.${extOut}";
        unlink glob "$dirOut/${i}?${ssssm10}*.${extOut}";
        unlink glob "$dirRes/${i}?${ssssm10}*.${extRes}";
        unlink glob "$dirRes/${i}?${ssssm10}*.${extRes}";
        unlink glob "$dirSum/${i}?${ssssm10}*.${extSum}";
        unlink glob "$dirLst/${i}?${ssssm10}*.${extLst}";
        unlink glob "$dirSos/${i}?${ssssm10}*.${extSos}";
        unlink glob "$dirSos/${i}?${ssssm10}*.${extSos}";
        unlink glob "$dirOut/${i}?${yyssssm10}*.${extOut}";
        unlink glob "$dirSum/${i}?${yyssssm10}*.${extSum}";
        unlink glob "$dirLst/${i}?${yyssssm10}*.${extLst}";
        unlink glob "$dirSos/${i}?${yyssssm10}*.${extSos}";


        unlink glob "$dirNeq/${b}${ssssm10}*.${extNeq}";
        unlink glob "$dirRes/${b}${ssssm10}*.${extRes}";
        unlink glob "$dirOsb/${b}${ssssm10}*.${extOsb}";
        unlink glob "$dirOut/${b}${ssssm10}*.${extOut}";
        unlink glob "$dirSum/${b}G${yyssssm10}*.${extSum}";

        unlink glob "$dirEdt/${b}_${yyssssm10}*.${extEdt}";
        unlink glob "$dirSum/${b}_${yyssssm10}*.${extSum}";
        unlink glob "$dirLst/${b}_${yyssssm10}*.${extLst}";
        unlink glob "$dirOut/${b}R${yyssssm10}*.${extOut}";

        unlink glob "$dirOut/FIL${ssssm10}*.${extOut}";
        unlink glob "$dirClk/FIL${ssssm10}*.${extClk}";
        unlink glob "$dirRxc/FIL${ssssm10}*.${extRxc}";

        unlink glob "$dirNeq/${t}${ssssm10}*.${extNeq}";
        unlink glob "$dirOut/${t}${ssssm10}*.${extOut}";

        unlink glob "$dirNeq/${t}_${yyssssm10}*.${extNeq}";
        unlink glob "$dirOut/${t}?${yyssssm10}*.${extOut}";
        unlink glob "$dirOsb/${t}?${yyssssm10}*.${extOsb}";
        unlink glob "$dirSum/${t}?${yyssssm10}*.${extSum}";


        unlink glob "$dirClk/${e}_${yyssssm10}.${extClk}";
        unlink glob "$dirRxc/${e}_${yyssssm10}.${extRxc}";
        unlink glob "$dirOut/${e}_${yyssssm10}.PRC";
        unlink glob "$dirOut/${e}_${yyssssm10}.${dirOut}";

        unlink glob "$dirSum/MPR${yyssssm10}*.${extSum}";
        unlink glob "$dirSum/MPS${yyssssm10}*.${extSum}";
        unlink glob "$dirDel/MPR${yyssssm10}*.${extDel}";

        unlink glob "$dirNeq/${h}${ssssm10}*.${extNeq}";
        unlink glob "$dirRes/${h}${ssssm10}*.${extRes}";
        unlink glob "$dirRxc/${h}${ssssm10}*.${extRxc}";
        unlink glob "$dirOut/${h}${ssssm10}*.${extOut}";
        unlink glob "$dirSum/${h}G${yyssssm10}*.${extSum}";

        unlink glob "$dirEdt/${h}_${yyssssm10}*.${extEdt}";
        unlink glob "$dirSum/${h}_${yyssssm10}*.${extSum}";
        unlink glob "$dirLst/${h}_${yyssssm10}*.${extLst}";
        unlink glob "$dirOut/${h}R${yyssssm10}*.${extOut}";

        unlink glob "$dirClk/${h}_${yyssssm10}*.${extClk}";
        unlink glob "$dirRxc/${h}R${yyssssm10}*.${extRxc}";
        unlink glob "$dirOut/${h}_${yyssssm10}*.${extOut}";

# Clean from PPP preparation
# --------------------------
        unlink glob "$dirTrp/${t}?${yyssssm10}.${extTrp}";
        unlink glob "$dirTrp/${t}?${yyssssm10}.${extTrp}";
        unlink glob "$dirTrp/${b}?${yyssssm10}.${extTrp}";
        unlink glob "$dirTrp/${b}?${yyssssm10}.${extTrp}";
        unlink glob "$dirOut/MRX${ssssm02}????.${extOut}";
        unlink glob "$dirOut/MRX${ssssm10}????.${extOut}";

# Clean clock estimation (300s)
# -----------------------------
#       Parallel Run 3-Day / 1-Day
        unlink glob "$dirNeq/${u}?${ssssm01}????.${extNeq}"; # Parallel run
        unlink glob "$dirOut/${u}?${ssssm01}????.${extOut}"; # Parallel run
        unlink glob "$dirCrd/${u}?${ssssm01}????.${extCrd}"; # Parallel run
        unlink glob "$dirRxc/${u}?${ssssm01}????.${extRxc}"; # Parallel run

        unlink glob "$dirNeq/${u}?${ssssm02}????.${extNeq}"; # Parallel run
        unlink glob "$dirOut/${u}?${ssssm02}????.${extOut}"; # Parallel run
        unlink glob "$dirCrd/${u}?${ssssm02}????.${extCrd}"; # Parallel run
        unlink glob "$dirRxc/${u}?${ssssm02}????.${extRxc}"; # Parallel run
        unlink glob "$dirNeq/${u}?${ssssm10}????.${extNeq}"; # Parallel run
        unlink glob "$dirOut/${u}?${ssssm10}????.${extOut}"; # Parallel run
        unlink glob "$dirCrd/${u}?${ssssm10}????.${extCrd}"; # Parallel run
        unlink glob "$dirRxc/${u}?${ssssm10}????.${extRxc}"; # Parallel run

#       Combination
        unlink glob "$dirNeq/${u}?${yyssssm30}.${extNeq}";   # Stacked NEQ
        unlink glob "$dirOut/${u}?${yyssssm30}.${extOut}";   # Stacked NEQ
        unlink glob "$dirSum/${u}?${yyssssm30}.${extSum}";   # Stacked NEQ

#       Invert clock solution
        unlink glob "$dirNeq/${u}?${yyssssm02}???.${extNeq}"; # Solve NEQ
        unlink glob "$dirOut/${u}?${yyssssm02}???.${extOut}"; # Solve NEQ
        unlink glob "$dirTrp/${u}?${yyssssm02}???.${extTrp}"; # Solve NEQ
        unlink glob "$dirCrd/${u}?${yyssssm02}???.${extCrd}"; # Solve NEQ
        unlink glob "$dirClk/${u}?${yyssssm02}???.${extClk}"; # Solve NEQ
        unlink glob "$dirRxc/${u}?${yyssssm02}???.${extRxc}"; # Solve NEQ
        unlink glob "$dirOsb/${u}?${yyssssm02}???.${extOsb}"; # Solve NEQ
        unlink glob "$dirNeq/${u}?${yyssssm10}???.${extNeq}"; # Solve NEQ
        unlink glob "$dirOut/${u}?${yyssssm10}???.${extOut}"; # Solve NEQ
        unlink glob "$dirTrp/${u}?${yyssssm10}???.${extTrp}"; # Solve NEQ
        unlink glob "$dirCrd/${u}?${yyssssm10}???.${extCrd}"; # Solve NEQ
        unlink glob "$dirClk/${u}?${yyssssm10}???.${extClk}"; # Solve NEQ
        unlink glob "$dirRxc/${u}?${yyssssm10}???.${extRxc}"; # Solve NEQ
        unlink glob "$dirOsb/${u}?${yyssssm10}???.${extOsb}"; # Solve NEQ

#       300sec Results
        unlink glob "$dirCrd/${u}?${yyssssm30}.${extCrd}";      # Final solution
        unlink glob "$dirTrp/${u}?${yyssssm30}.${extTrp}";      # Final solution
        unlink glob "$dirRxc/${u}?${yyssssm30}.${extRxc}";      # Final solution
        unlink glob "$dirClk/${u}?${yyssssm30}.${extClk}";      # Final solution

#       300sec Results
        unlink glob "$dirOut/${trp}${ssssm02}????.${extOut}";   # Tropo solution
        unlink glob "$dirTrp/${trp}${ssssm02}????.${extTrp}";   # Tropo solution
        unlink glob "$dirTro/${trp}${ssssm02}????.${extTro}";   # Tropo solution
        unlink glob "$dirOut/${trp}${ssssm10}????.${extOut}";   # Tropo solution
        unlink glob "$dirTrp/${trp}${ssssm10}????.${extTrp}";   # Tropo solution
        unlink glob "$dirTro/${trp}${ssssm10}????.${extTro}";   # Tropo solution

        unlink glob "$dirTrp/${trp}${yyssssm10}.${extTrp}";     # Final solution
        unlink glob "$dirTro/${trp}_${yyssssm10}.${extTro}";    # Final solution
        unlink glob "$dirSum/${trp}_${yyssssm10}.${extSum}";    # Final solution
        unlink glob "$dirTrp/${trp}${yyssssm30}.${extTrp}";     # Final solution
        unlink glob "$dirTro/${trp}_${yyssssm30}.${extTro}";    # Final solution
        unlink glob "$dirSum/${trp}_${yyssssm30}.${extSum}";    # Final solution

# CRD / TRP for ultra-high-rate clocks
# ------------------------------------
        unlink glob " ${dirClb}${yy}${ssss}HRD.${extClb}";

        unlink glob "$dirOut/${c}${ssssm30}HRD.$extOut";
        unlink glob "$dirNeq/${c}${ssssm30}HRD.$extNeq";
        unlink glob "$dirNeq/${c}?${yyssssm30}.$extNeq";
        unlink glob "$dirRes/${c}${ssssm30}HRD.$extRes";

        unlink glob "$dirOut/${c}H${yyssssm30}.$extOut";
        unlink glob "$dirCrd/${c}_${yyssssm30}.$extCrd";
        unlink glob "$dirTrp/${c}_${yyssssm30}.$extTrp";

# Clean clock estimation (30 s /05s)
# ----------------------------------
        unlink glob "$dirRxo/????${ssssm10}.???";             # RINEX Files
        unlink glob "$dirRxo/HRD/????${ssssm10}.???";         # RINEX Files
        unlink glob "$dirCzh/????${ssssm10}.???";             # RINEX Files
        unlink glob "$dirCzh/../OBS1/????${ssssm10}.???";     # RINEX Files
        unlink glob "$dirCzh/../OBSH/????${ssssm10}.???";     # RINEX Files

        unlink glob "$dirClk/${q}?${yyssssm30}.$extClk";
        unlink glob "$dirRxc/${q}?${yyssssm30}.$extRxc";
        unlink glob "$dirRxc/${q}?${yyssssm30}_v3.$extRxc";
        unlink glob "$dirOut/${q}?${yyssssm30}.$extOut";
        unlink glob "$dirOut/${q}?${yyssssm30}.PRC";

        unlink glob "$dirClk/${c}?${yyssssm30}.$extClk";
        unlink glob "$dirRxc/${c}?${yyssssm30}.$extRxc";
        unlink glob "$dirRxc/${c}?${yyssssm30}_v3.$extRxc";
        unlink glob "$dirOut/${c}?${yyssssm30}.$extOut";
        unlink glob "$dirOut/${c}?${yyssssm30}.PRC";

# Div
        unlink glob " ${dirClb}${yydddm10}RNX.${extClb}";
        unlink glob " ${dirClb}HCK${yydddm10}.${extFix}";
        unlink glob "$dirOut/RX?${ssssm02}??.BPE";
        unlink glob "$dirOut/RX?${ssssm10}??.BPE";
        my ($yym30) = $yyyym30 =~ /\d\d(\d\d)/;
        unlink glob "$dirOut/OBX_???_${yym30}${ssssm30}.$extOut";
        unlink glob "$dirSum/OBX_???_${yym30}${ssssm30}.$extSum";
        unlink glob "$dirOut/GPSXTR.${yym30}_${ssssm30}";
        unlink glob "$dirOut/GPSWKS.${yym30}_${ssssm30}";
        unlink glob "$dirOut/GPSCMP.${yym30}_${ssssm30}";
        unlink glob "$dirOut/RNXSTAT.${yym30}_${dddm5}";
        unlink glob "$dirOut/NOB${yyssssm90}.$extOut";
        unlink glob "$dirOut/NOI${yyssssm90}.$extOut";
        unlink glob "$dirOut/XTR${yyssssm90}.$extOut";
        unlink glob "$dirOut/IAR${yyssssm90}.FPZ_0";

# BPE
# -----
        unlink "$dirPrt/??${yyssssm10}_*.$extPrt";
        unlink "$dirLog/??${yyssssm10}_*.$extLog";

        if($repro){
          unlink "$dirRxo/${ddd}/*";
        }
    }
}


