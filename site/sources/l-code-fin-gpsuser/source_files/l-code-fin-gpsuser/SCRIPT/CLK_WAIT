package CLK_WAIT;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  CLK_WAIT
#
# Purpose :  Wait for final clk file
#
# Programs:  ---
#
# Author  :  R. Dach
#
# Created :  06-Dec-2007
#
# Changes :  25-Jul-2008 RD/PS: Adopted for reprocessing
#            09-Jan-2014 HB: Correct $yyyy-variable for a week over 1 Jan
#            10-Feb-2017 SS/AV: Reduced waiting time(s)
#            22-Apr-2020 RD: Remove the 1-day part
#            22-Aug-2022 AV: Change wait condition for IGS20
#            30-Nov-2022 SS: Treated F3U_ CLK info with second midnight epoch
#
# ----------------------------------------------------------------------------
use strict;

use lib "$ENV{BPE}";
use lib "$ENV{AUTO}";
use igs_device;
use bpe_util;
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd0, $yyyy0, $v_t, $v_n, $preClk, $dirClk, $extClk, $dirStd, $extStd,
       $camp_pth, $campaign)
       = $bpe->getKeys(
      '$YD+0','$Y+0','V_T','V_N','V_PRECLK','DIR_CLK','EXT_CLK','DIR_STD','EXT_STD',
      'CAMP_PTH','CAMPAIGN');

  my $repro = $preClk eq "BRD";

  my $reproCount = 0;
  for ( my $ii = 0; $ii > -7; $ii-- ) {
    my $yyddd  = gps_date("-yd $yyddd0 -d $ii -o %y%j");
    my $yyssss = gps_date("-yd $yyddd0 -d $ii -o %y%j0");
    my $yyyy   = gps_date("-yd $yyddd0 -d $ii -o %Y");

    my $clk3   = $repro ? "${v_t}${yyddd}.$extClk.Z" : "${v_t}${yyssss}.$extClk";
    $clk3      = "$clk3.Z" if $v_t eq "F3U_";
    my $orb3   = $repro ? "${v_n}${yyddd}.$extStd.Z" : "${v_n}${yyddd}.$extStd";
    my $dirSav = $repro ? "$PATH_SAV$CAMP_SAVREP" : "$PATH_SAV$CAMP_SAVIGS";
    if($campaign =~ /I20FINAL/){
       $dirSav = "${PATH_SAV}/IGS_I20";
    }
    my $inp3 = "$dirSav/$yyyy/ORB/$clk3";
    my $inp3o= "$dirSav/$yyyy/ORB/$orb3";
    my $out3 = "${dirClk}${v_t}${yyddd}.$extClk";
    my $prt  = "${PATH_FCLK}${CAMP_FCLK}/BPE/${FCLK_ID}${yyssss}_999_000.PRT";
    if($campaign =~ /I20FINAL/){
       $prt = "$ENV{R}/FCLKI20/BPE/${FCLK_ID}${yyssss}_999_000.PRT";
    }

    my $wait = 2;
    while ($wait) {
      if ( $wait == 2 ) {
        print "\nWaiting for these files:\n$inp3\n";
        print "$prt\n" unless $repro;
        $wait = 1
      }

      if ( $repro || -e $prt ) {

        if ( $repro ) {
          $wait = 0 if ( -e $inp3 );
        } else {
          $wait = 0 if ( -e $inp3 && ((stat($inp3o))[9] < (stat($inp3))[9]));
        }

        prtMess($bpe,"CLK FILES $clk3 NOT YET AVAILABLE") if $wait;

      } else {

        prtMess($bpe,"WAITING FOR FCLKGNSS PROCESS: ${yyssss}") if $wait;

      }
      sleep 30 unless $wait == 0;

      $reproCount++ if $repro;
      last if ( $reproCount == 2 );
    }

    sleep 30;

    if ($repro || $v_t eq "F3U_") {
      system("zcat $inp3 > $out3") unless -e $out3;
    } else {
      copyfile("$inp3","$out3") unless -e $out3;
    }
    last if ( $reproCount == 2 );
  }
}

