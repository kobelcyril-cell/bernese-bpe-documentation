package TIMEST_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  TIMEST_A
#
# Purpose :  Parallel run of GPSEST using code and phase data
#            and estimating osb via addneq iteration
#
# Programs:  GPSEST
#
# Author  :  A. Villiger
# Created :  24-Apr-2016
#
# Changes :  20-May-2016 AV/SS: Add solution from PARAM3
#            20-May-2016 AV/SS: Remove solution from PARAM3
#            18-Oct-2016 AV: Add CODE/PHASE/[BOTH] mode
#
# ----------------------------------------------------------------------------

use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{EXE}";
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($param1  ,$subPid ,$param2,
      $yyddd   ,$ssss   ,$B       ,$I,
      $dirIon  ,
      $extIon) =
    $bpe->getKeys(
      'PARAM1' ,'SUB_PID','PARAM2',
      '$YD+0'  ,'$S+0'   ,'V_B'   ,'V_I',
      'DIR_ION','EXT_ION');

# Initialize code/phase/BOTH mode
# -------------------------------
  my $mode = $param2  =~/(CODE|PHASE|BOTH)/? $param2 : "BOTH";
#  unless($mode =~/(CODE|PHASE|BOTH)/){
#    prtErr($bpe,"UNKNOWN OBSERVATION TYPE $mode") and
#        die "PROCESSING STOPPED";
#  }else{
      prtMess($bpe,"SCREEN_${mode}_DATA");
#}

# Initialize $D4 variable with subpid
# -----------------------------------
  setUserVar($bpe,"D4",$subPid,"CCC",$subPid);
  my $name="";

# Replace selected with station list
# ----------------------------------
  replaceSel($bpe,"GPSEST","CZFILES",$param1) unless $mode =~ /PHASE/;
  replaceSel($bpe,"GPSEST","PZFILES",$param1) unless $mode =~ /CODE/;

# Print the selected files to the log file
# ----------------------------------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;


# Deactivate inversion and residual
# ---------------------------------

# Run program: 1. GPSEST
# ----------------------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);
  my $rnam = $bpe->getKey("$ENV{U}/INP/GPSEST.INP","NEQUARS");
  $rnam = basename($rnam,".NQ0");
  print "NAME: $rnam \n";

# Run program: 2. ADDNEQ2
# -----------------------
  $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

# Run program: 3. GPSEST
# -----------------------
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","NEQUARS","${rnam}_");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBINP","$rnam");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBEST", "0");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OBS2NEQ","0");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PRE04","PRIOR_TO_NEQ_SAVING");
  $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

  }

