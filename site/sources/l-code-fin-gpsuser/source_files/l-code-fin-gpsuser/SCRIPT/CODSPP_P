package CODSPP_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  CODSPP_P
#
# Purpose :  Parallel CODSPP run
#
# Programs:  CODSPP
#
# Author  :  M. Meindl
# Created :  30-Jul-2003
#
# Changes :  17-Feb-2004/ss: Reduce ITRMAX in ULTRA mode
#            23-Jul-2008 rd: prepare for reprocessing
#            21-May-2019 SS: Print warnings to RNX.ERR
#            22-May-2019 SS: Support RNXyyssss.ERR and RNXERR.yy_ssss
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yyssss , $ssss , $ddd , $yy , $param1 , $subPid  ,  $clu ,  $nclu    , $dirOut ) =
  $bpe->getKeys
     ('$YSS+0', '$S+0', '$+0', '$Y', 'PARAM1', 'SUB_PID', 'V_CLU', 'V_NCLU' ,'DIR_OUT');


# Set cluster number and input files
# ----------------------------------
  my $cluster = $clu eq "" && $nclu eq "" ? "$ddd$param1" : "$yyssss" . substr($subPid,1);
  my $ffff    = $clu eq "" && $nclu eq "" ? $param1       : "____";

  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$ffff,"CCC",$subPid);

  if ($clu eq "" && $nclu eq "" ) {
    $bpe->putKey("$ENV{U}/PAN/CODSPP.INP","CODEFILE","$param1$ssss") }
  else {
    replaceSel($bpe,"CODSPP","CODEFILE",$param1) }

# Run program
# -----------
  my $PGMNAM = "CODSPP";
  $bpe->RUN_PGMS($PGMNAM);

# Extract warning/error messages
# ------------------------------
  my $rnxErr = "${dirOut}RNX${yyssss}.ERR";
  &getWarn($bpe,$rnxErr) if -e $rnxErr;
  &getWarn($bpe,"${dirOut}RNXERR.${yy}_${ssss}") unless -e $rnxErr;

# Delete BPE file
# ---------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;
  unlink($param1);

}
