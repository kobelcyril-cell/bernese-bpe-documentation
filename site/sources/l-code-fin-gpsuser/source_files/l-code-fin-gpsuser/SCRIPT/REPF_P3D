package REPF_P3D;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  REPF_P3D
#
# Purpose :  Make a "protocol" of the final 3-day solution
#            (reprocessing mode)
#
# PARAMs  :
#
# Author  :  R. Dach
#
# Created :  24-Jul-2008
#
# Changes :  22-Aug-2011, PS: Arc splitting summary from extra campaign
#            07-Feb-2012, PS: Arc splitting summary from savedisk
#            17-Jun-2013, SL: Some smaller modifications
#            21-Jun-2013, PS: F3_ instead of F3H LST file 
#            26-Jun-2013, PS: Do not consider 3-day orbit fits
#
# ============================================================================

use strict;
use warnings;

use lib "$ENV{BPE}";
use bpe_util_rd qw(appFile);
use lib "$ENV{AUTO}";
use igs_device;

sub run {

  my $bpe = shift;

# Get variables
# -------------
  my(
    $yy,       $yyyy,     $ssss,  $yyddd,  $wwwwd,
    $b,        $e,        $h,     $i,      $x,      $u,    $z,
    $dirOut,   $extOut,
    $dirSum,   $extSum,
    $dirLst,   $extLst,
  ) =
  $bpe->getKeys(
    '$Y',      '$Y+0',    '$S+0', '$YD+0', '$WD+0',
    'V_B',     'V_E',     'V_H',  'V_I',   'V_X',   'V_U', 'V_Z',
    'DIR_OUT', 'EXT_OUT',
    'DIR_SUM', 'EXT_SUM',
    'DIR_LST', 'EXT_LST',
  );

# Initialize processing summary file
# ----------------------------------
  my $prcFil = "${dirOut}IGSREP3D.${yy}_${ssss}";
  unlink($prcFil);

  my $log = "";
  $log .= "IGSREP3D finished at: ".gmtime(time)." UT";
  appFile($log,0,"",$prcFil,0);

  appFile("REPRO 3D BPE PROCESSING SUMMARY FOR YEAR-SESSION $yy-$ssss",
    0,"",$prcFil,0);

# Append processing summary files
# -------------------------------
  my $sumFil;
  appFile("PART 1: GNSS COORDINATE/ORBIT/ERP SOLUTION STATISTICS",
    0,"",$prcFil,0);
  $sumFil = "${dirSum}${z}_${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1,'#GPSXTR');
  appFile("",1,"",$prcFil,0);

  $sumFil = "${PATH_SAV}${CAMP_SAVREP}/${yyyy}/OUT/ASP${yy}${ssss}.${extSum}";
  my $filesize = -s $sumFil;
  if ($filesize == 0) {
    appFile("PART 2-1: NO ARC SPLITTING FOR $yy-$ssss",1,"",$prcFil,0,'#ARCSPL');
  }
  else{
    appFile("PART 2-1: ARC SPLITTING FOR $yy-$ssss",0,$sumFil,$prcFil,1,'#ARCSPL');
    appFile("",2,"",$prcFil,0);
  }

#  $sumFil = "${dirOut}COD${wwwwd}.${extLst}";
#  appFile("PART 2-2: 3-DAY ORBIT FIT",2,$sumFil,$prcFil,1);

  $sumFil = "${dirLst}${z}_${yyddd}.${extLst}";
  appFile("PART 3: GNSS COORDINATE VERIFICATION STATISTICS",
          2,$sumFil,$prcFil,1,'#HLMTRF');

}

# ============================================================================

__END__
