    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","SUMFIL",'WEEKFIT1');
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","SUMACC",'WEEKVER1');
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","SYSOUT",'WEEKFIT1');

    my $PGMNAM = "ORBGEN";
    $bpe->RUN_PGMS($PGMNAM);

