package PPPEDT_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  PPPEDT_P
#
# Purpose :  Precise-point-positioning (PPP) analysis (parallel mode):
#            - Predefined screening levels are considered.
#            - Generation of result and NEQ files for each station.
#
# PARAMs  :  PARAM1 - temporary file for parallel processing
#
# Author  :  M. Meindl, U. Hugentobler, S. Schaer
# Created :  23-Jul-2003
#
# Changes :  11-Aug-2011 RD: Updated for version 5.2
#            20-May-2016 AV: OSB implementation: new processing loop for code
#                            GPSEST->ADDNEQ2->GPSEST->RESCHK
#            20-Apr-2020 AV: Remove stations with too many ambiguities
#            22-Apr-2020 AV: MAXAMB check removed (done in MAUPRP)
#            04-May-2020 AV: ADDNEQ sysout renamed from "RED" to "EDA"
#            07-Dec-2020 RD: Add PCF variable V_TRPMOD
#            25-Feb-2021 AV: Undo ADDNEQ2-loop
#            10-Jul-2021 LP: More generalized handling of TROPO model
#
# ============================================================================
use strict;

use File::Copy;

use lib $ENV{BPE};
use bpe_util qw(prtMess getWarn replaceSel setUserVar prtBPEfile);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ssss, $yyddd,
      $param1, $subPid, $clu, $obstyp, $maxAmb, $v_tropMod,
      $dirOut, $dirSum, $dirRes,$dirPzh,
      $extOut, $extSum, $extRes) =
  $bpe->getKeys(
      '$S+0','$YD+0',
      'PARAM1', 'SUB_PID', 'V_PPPCLU', 'V_OBSTYP', 'V_MAXAMB', 'V_TRPMOD',
      'DIR_OUT', 'DIR_SUM', 'DIR_RES' , 'DIR_PZH',
      'EXT_OUT', 'EXT_SUM', 'EXT_RES');

# Initialize flags
# ----------------
  my $fl  = 'F';
  my $est = 1;

# Set cluster number and input files
# ----------------------------------
  my $cluster = $clu eq "" ? "$ssss$param1" : "$ssss$subPid";
  my $ffff    = $clu eq "" ? $param1        : "____";

  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$ffff,"CCC",$subPid,"FL",$fl);

  if ($clu eq "") {
    prtMess($bpe,"PROCESSING FILE $param1$ssss");

    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PZFILES","$param1$ssss") unless uc($obstyp) eq "CODE";
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","CZFILES","$param1$ssss") unless uc($obstyp) eq "PHASE";
    $bpe->putKey("$ENV{U}/PAN/SATMRK.INP","PZHFIL","$param1$ssss") }
  else {
    replaceSel($bpe,"GPSEST","PZFILES",$param1) unless uc($obstyp) eq "CODE";
    replaceSel($bpe,"GPSEST","CZFILES",$param1) unless uc($obstyp) eq "PHASE";
    replaceSel($bpe,"SATMRK","PZHFIL",$param1);
  }

# GMF/VMF troposphere model switch
# --------------------------------
  my $tropMod = 'VMF'; # default
  $v_tropMod  = $v_tropMod.'    ';
  if (substr($v_tropMod,3,1) ne ' ') {$tropMod = substr($v_tropMod,0,4);}
  else                               {$tropMod = substr($v_tropMod,0,3);}

  my $flgFil = "${dirOut}../MSC/TRP_${yyddd}.FLG";
  my $flgLin = -e $flgFil ? `cat $flgFil` : $tropMod;
  chomp($flgLin);
  prtMess($bpe,"GMF/VMF troposphere model switch: $flgLin");

  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","TROPOS","DRY_".$flgLin);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MAPPNG","WET_".$flgLin);
  if     ($flgLin =~ /VMF/) {$bpe->putKey("$ENV{U}/PAN/GPSEST.INP","VMF_FILES",'VMF$YD+0');}
  elsif (($flgLin =~ /GMF/)||($flgLin =~ /GPT/)) {$bpe->putKey("$ENV{U}/PAN/GPSEST.INP","VMF_FILES",' ');}
  else                     {die "*** Invalid TROPO model: $flgLin \n";}


# Specify thresholds for screening loops
# ---------------------------------------
  my @phaRes = ( 600, 60, 6, 0.6, 0.06, 0.006 );
  my @codRes = ( 600, 60, 6, 0.6, 0.06, 0.006 );

  my $nEdt = @phaRes;

# Data screening loop
# -------------------
  for (my $iEdt=1; $iEdt<=$nEdt; $iEdt++) {
    prtMess($bpe,"SCREENING LOOP $iEdt");

# Set current screening thresholds
# --------------------------------
    my $phaMax = shift @phaRes;
    $bpe->putKey("$ENV{U}/PAN/RESRMS.INP","BIGRES", $phaMax);
    my $codMax = shift @codRes;
    $bpe->putKey("$ENV{U}/PAN/RESRMS.INP","BIGRES2",$codMax);
    prtMess($bpe,"LEVEL: $phaMax $codMax");


# GPSEST - ADDNEQ GPSEST loop for code biases
# -------------------------------------------
    my $PGMNAM = "GPSEST";
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT", 'E1$(FL)$(CLUSTER)');
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","NEQUARS",'');
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PRE04",  'PRIOR_TO_NEQ_SAVING');
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PRE23",  'PRIOR_TO_NEQ_SAVING');
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OBS2NEQ", 0);
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBEST",  1);
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBINP", 'APR$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBOUT", 'ED$(FL)$(CLUSTER)');
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBREF", 'RECEIVERS_ONLY');
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBSIGS",'0.01');

    $PGMNAM = "GPSEST";
    $bpe->RUN_PGMS($PGMNAM) if $est;


    # Check if max amb exceeded
    my $outfil = "${dirOut}E1${fl}${cluster}.$extOut";
    print "Get number of ambiguities: ";
    my $numAmb = getNumAmb($outfil);
    print "$numAmb \n";
    if($numAmb > $maxAmb){
      prtMess($bpe,"Too many ambiguities ($numAmb > $maxAmb): $cluster");
#      unlink glob "$dirPzh/${param1}${ssss}.???";
#      return;
    }

    copy ("${dirOut}EDF${cluster}.${extOut}",
          "${dirOut}EDL${cluster}.${extOut}") if $iEdt == 1;
    copy ("${dirRes}EDF${cluster}.${extRes}",
          "${dirRes}EDL${cluster}.${extRes}") if $iEdt == 1;

# Screen residuals
# ----------------
    $PGMNAM = "RESRMS";
    $bpe->RUN_PGMS($PGMNAM);

# Check whether edit requests reported
# ------------------------------------
    $est = 1;
    open (INP,"$$bpe{SYSOUT}");
    while (<INP>) { $est = 0 if /NO EDIT REQUESTS/ }
    close (INP);

    $PGMNAM = "SATMRK";
    $bpe->RUN_PGMS($PGMNAM) if $est;

# Redefine loop variable
# ----------------------
    $fl = 'L';
    setUserVar($bpe,"FL",$fl) if $iEdt == 1;
  }

# Do additional GPSEST run in case of open edit requests
# -----------------------------------------------------------------------
  my $PGMNAM = "GPSEST";

  $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM) if $est;


# Create NEQ without a-priori OSB values
# --------------------------------------
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT", 'ED$(FL)$(CLUSTER)');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","NEQUARS",'$C$(CLUSTER)');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PRE04",  'AS_SOON_AS_POSSIBLE');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PRE23",  'EVERY_EPOCH');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OBS2NEQ", 1);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBEST",  1);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBINP", '');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","DCBOUT", '');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBREF", 'YES');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBSIGS",'');

  $bpe->RUN_PGMS($PGMNAM);

# Extract warning/error messages from protocol file
# -------------------------------------------------
  my $sumFil = "${dirSum}WRN${cluster}.${extSum}";
  getWarn($bpe,$sumFil);

# Print processed stations BPE file
# ---------------------------------
  prtBPEfile($param1,0) if ($clu ne "");

}


sub getNumAmb{
  my $file = shift;
  print " ($file) ";
  my $ret  = 0;
  if(-e $file){
    open INP, "< $file";
    foreach (<INP>){
      $ret = $1   if(/^ Ambiguities    *(\d*) */);
    }
    close INP;
  }
  return $ret;
}
