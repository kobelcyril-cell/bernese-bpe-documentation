package ARCSPLIT;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name:      ARCSPLIT
#
# Purpose:   Arc splitting for reprocessing solution
#
# Programs:  ORBGEN, DEFXTR
#
# Author  :  P. Steigenberger
# Created :  18-Aug-2011               Last modified: __-___-____
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------

use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;

sub run
{
  my $bpe = shift;


# Get variables
# -------------
  my ($yyssss, $yyyy, $yyyyp1, $yyddd, $yydddp1, $ssss, $mjd, $u,$v_k,
      $dirOut, $dirSum, $dirErp, $dirPre, $dirStd,
               $extSum, $extErp, $extPre, $extStd
      ) =
    $bpe->getKeys(
      '$YSS+0', '$Y+0', '$Y+1','$YD+0', '$YD+1','$S+0', '$JD+0', 'U', 'V_K',
      'DIR_OUT','DIR_SUM','DIR_ERP','DIR_PRE','DIR_STD',
                'EXT_SUM','EXT_ERP','EXT_PRE','EXT_STD'
      );

  copyfile("$PATH_SAV/$CAMP_SAVREP/$yyyy/ORB/${v_k}_$yyddd.$extStd","$dirStd");
  copyfile("$PATH_SAV/$CAMP_SAVREP/$yyyy/ORB/${v_k}_$yyddd.$extPre","$dirPre");
  copyfile("$PATH_SAV/$CAMP_SAVREP/$yyyy/ORB/${v_k}_$yyddd.$extErp","$dirErp");

  copyfile("$PATH_SAV/$CAMP_SAVREP/$yyyyp1/ORB/${v_k}_$yydddp1.$extStd","$dirStd");
  copyfile("$PATH_SAV/$CAMP_SAVREP/$yyyyp1/ORB/${v_k}_$yydddp1.$extPre","$dirPre");
  copyfile("$PATH_SAV/$CAMP_SAVREP/$yyyyp1/ORB/${v_k}_$yydddp1.$extErp","$dirErp");

  my $PGMNAM = "POLUPD";
  $bpe->RUN_PGMS($PGMNAM);

  my $PGMNAM = "STDELE";
  $bpe->RUN_PGMS($PGMNAM);

# 2-day overlap
# -------------
  setMinusPlus($bpe,+0,+1);
  $bpe->putKey("$u/PAN/ORBGEN.INP","RADIO_1",'0');
  $bpe->putKey("$u/PAN/ORBGEN.INP","RADIO_2",'1');
  $bpe->putKey("$u/PAN/ORBGEN.INP","STADAT",'$YMD_STR+0');
  $bpe->putKey("$u/PAN/ORBGEN.INP","ENDDAT",'$YMD_STR+1');

# Run program ORBGEN
# --------------------
  $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);

# Check the program run (espcially ARC-SPLIT)
# -------------------------------------------

# Set time dependent options for GLONASS
  if ($mjd < 54832 ) {
    $bpe->putKey("$u/PAN/DEFXTR.INP","LIM_GLO","5")
  }
  elsif ($mjd < 55197) {
    $bpe->putKey("$u/PAN/DEFXTR.INP","FAC_GLO","5")
  }

  my $orbOut=$bpe->getKey("$u/INP/ORBGEN.INP","SYSOUT");
  $bpe->putKey("$u/PAN/DEFXTR.INP","JOBOUT",$orbOut);
  $PGMNAM = "DEFXTR";
  $bpe->RUN_PGMS($PGMNAM);

}
