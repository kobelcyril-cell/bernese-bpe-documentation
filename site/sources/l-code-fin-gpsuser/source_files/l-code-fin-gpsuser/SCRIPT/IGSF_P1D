#
# Name    :  IGSF_P1D
#
# Purpose :  Make a "protocol" of the final 1-day solution
#
# PARAMs  :
#
# Author  :  S. Lutz
#
# Created :  04-Jun-2013
#
# Changes :  18-Sep-2000/SS: Change extension of ASPLIT file from DDD to YY_DDD
#            18-Sep-2000/SS: Change extension of ORBCHK file from DDD to YY_DDD
#            18-Sep-2000/SS: Change extension of MPRXTR file from DDD to YY_DDD
#            18-Sep-2000/SS: Change extension of CODXTR file from DDD to YY_DDD
#            04-Apr-2002/MM: Files RNX_CHK and F1_yyddd.SUM removed
#            04-Jan-2003/HU: Pole files in ORB instead of X/GEN
#            23-Jul-2008 PS/RD: prepare for reprocesing
#            01-Aug-2008 SL  Path to Logfile corrected
#            06-Oct-2010/SS: Deletion of ION file removed
#            04-Jun-2013 SL: BDS to Perl
#            25-Sep-2013 LP: ORB_CHK results are optional (CONT_ERR)
#            10-Feb-2015 LP: ORB_VER results are optional (CONT_ERR)
#            17-Mar-2015 RD/SS: F1I considered
#            25-Mar-2015 AS: MPRXTR-satellite statistics added
#            26-Sep-2016 AV: Add RNXSTAT.YY_DDD (RINEX-source)
#            08-Feb-2019 AV: Sort RINEX error messages
#            31-Aug-2019 RD: Add OBSXTR program
#            01-Sep-2021 RD/ST/LP: Add printing of BPE server variables
#            13-Jun-2023 EB: Daily repeatability plots and outlier suggestions
#            26-Oct-2023 EB: Copy repeatability files to www
#            19-Sep-2025 EB: Add 90-days ADDNEQ combi repeatabilities
#            27-Oct-2025 EB: outlier check 7->3 days
#            17-Dec-2025 EB: crd_rep.pl reports to log
#            09-Jul-2026 EB: generate istp/TRA files
#            19-Aug-2026 EB: start update plots for 3months process comparisons
#
# ============================================================================

use strict;
use warnings;

use lib "$ENV{BPE}";
use bpe_util qw(appFile timprt reportBPEvariables);
use lib "$ENV{AUTO}";
use igs_device;

sub run {

  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyssss,$yy,$yyyy,$ssss,$yyddd,$ddd,$wwwwd,$wwwwdm1,
    $z,$u,$b,$k,
    $pthPcf, $pcfNam, $script,
    $dirLst,$extLst,
    $dirOut,$extOut,
    $dirRpr,$extRpr,
    $dirSmc,$extSmc,
    $dirSum,$extSum,
    $dirStd,$extStd,
  ) =
  $bpe->getKeys(
    '$YSS+0','$Y','$Y+0','$S+0','$YD+0','$+0','$WD+0','$WD-1',
    'V_Z','V_U','V_B','V_K',
    'PTH_PCF', 'PCFFIL','SCRIPT',
    'DIR_LST','EXT_LST',
    'DIR_OUT','EXT_OUT',
    'DIR_RPR','EXT_RPR',
    'DIR_SMC','EXT_SMC',
    'DIR_SUM','EXT_SUM',
    'DIR_STD','EXT_STD',
  );

# Sort RINEX error output
# -----------------------
  my $rnxerr = "${dirOut}RNX${yy}${ssss}.ERR";
  if(-e $rnxerr){
    system("$ENV{AUTO}/get_warn.pl $rnxerr $rnxerr");
  }

# Initialize processing summary file
# ----------------------------------
  my $prcFil = "${dirOut}F1D${yyddd}.PRC";
  unlink($prcFil);

  my $log = "";
  my $logFil = "$ENV{HOME}/LOG/IGSFINAL.LOG";
  if(-s $logFil) {
    my(@yss) = ();
    open(LOG,"<$logFil");
    while(<LOG>) {
      push(@yss,$_) if($_ =~ /^Year\/session:/);
      $log .= $_ if($_ =~ /^IGSFINAL job/);
      $log .= $_ if($_ =~ /^IGSFINAL one/);
    }
    close(LOG);
    $log = "" unless($yss[0] =~ "$yyyy/$ssss");
  }
  $log .= "IGSFIN1D finished at: ".gmtime(time)." UT";
  appFile($log,0,"",$prcFil,0);

  appFile("FINAL 1D BPE PROCESSING SUMMARY FOR YEAR-SESSION $yy-$ssss",
    0,"",$prcFil,0);

# Report the BPE settings
# -----------------------
  open(PRC,">> $prcFil");
  print PRC "Summary file generated at ",timprt()," by $script\n\n";

  $pthPcf =~ s/$$bpe{U}/$$bpe{U_OLD}/;
  print "${pthPcf}/${pcfNam}\n";
  print PRC reportBPEvariables($bpe,"${pthPcf}/${pcfNam}");
  print PRC "\n\n";

  close PRC;

# Append summary files
# --------------------
  my $sumFil;
  $sumFil = "${dirOut}RNXSTAT.${yy}_${ddd}";
  appFile("",1,$sumFil,$prcFil,0);  # CONT_ERR
  $sumFil = "${dirSum}MPS${yyssss}.${extSum}";
  appFile("",1,$sumFil,$prcFil,1);
  $sumFil = "${dirOut}RESCHK.${yy}_${ssss}";
  appFile("",1,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}OBX_EDT_${yyddd}.${extSum}";
  appFile("OBSXTR - satellite statistics",1,$sumFil,$prcFil,1);
  $sumFil = "${dirLst}DEFXTR.${yy}_${ssss}";
  appFile("",1,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}OBX_AMB_${yyddd}.${extSum}";
  appFile("OBSXTR - satellite-wise ambiguity statistics",1,$sumFil,$prcFil,1);

  $sumFil = "${dirSum}${z}_${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${u}_${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${b}_${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,0);
  $sumFil = "${dirSum}${k}A${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${k}O${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${k}R${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${k}C${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${k}G${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${k}S${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${k}_${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${k}H${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${k}T${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${k}I${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  appFile("",1,"",$prcFil,0);

  $sumFil = "${dirLst}${u}G${wwwwd}.${extLst}";
  appFile("",2,$sumFil,$prcFil,0);  # CONT_ERR
  $sumFil = "${dirLst}${k}G${wwwwd}.${extLst}";
  appFile("",2,$sumFil,$prcFil,0);  # CONT_ERR
  $sumFil = "${dirLst}COD${wwwwdm1}.${extLst}";
  appFile("",2,$sumFil,$prcFil,0);  # CONT_ERR

  $sumFil = "${dirOut}ORBCHK.${yy}_${ssss}";
  appFile("",1,$sumFil,$prcFil,0);  # CONT_ERR
  $sumFil = "${dirOut}ASPLIT.${yy}_${ssss}";
  appFile("",1,$sumFil,$prcFil,0);  # CONT_ERR

  print "\nProcessing summary file created: $prcFil\n";

# Generate daily repeatability plots und suggest outliers (accessible with fin_mon)
# ---------------------------------------------------------------------------------
  system("$ENV{AUTO}/crd_rep.pl -f ${dirOut}CRDCHK.PLT  -c 4  -yrange \"30/30\"  -urange \"60/60\"  -timetyp DOY -rms -m -d ${dirOut}../MSC/restxt/daily -dirout ${dirOut}../MSC/resplt/daily -errorbar 4 -outlier 4 -ignore 3 -max_outlier_hor 12 -max_outlier_ver 30 -min_outlier_num 1 -stafac_rms_hor 2.5 -stafac_rms_ver 5.0 -stafac_outlier 0.1 -o eps 2>/dev/null > ${dirOut}../MSC/restxt/crd_rep_daily.log");
  system("$ENV{AUTO}/img2img.pl -source ${dirOut}../MSC/resplt/daily -target ${PATH_WWW}code/mon -add _fin -resolution 90 -v");

# Generate monthly repeatability plots und suggest outliers (ADDNEQ2)
# -------------------------------------------------------------------
  system("$ENV{AUTO}/crd_rep.pl -f ${dirOut}F1N_REP.PLT  -c 4  -yrange \"30/30\"  -urange \"60/60\"  -timetyp DOY -rms -m -d ${dirOut}../MSC/restxt/monthly -dirout ${dirOut}../MSC/resplt/monthly -errorbar 4 -outlier 4 -ignore 3 -max_outlier_hor 12 -max_outlier_ver 30 -min_outlier_num 1 -stafac_rms_hor 2.5 -stafac_rms_ver 5.0 -stafac_outlier 0.1 -o eps  2>/dev/null > ${dirOut}../MSC/restxt/crd_rep_monthly.log");
  system("$ENV{AUTO}/img2img.pl -source ${dirOut}../MSC/resplt/monthly -target ${PATH_WWW}code/mon -add _finm -resolution 90 -v");

# Generate istp files for T and I type (generates a TRA file)
# -----------------------------------------------------------
  system("$ENV{AUTO}/extract_istp.pl -f ${dirOut}${k}T${yyddd}.$extOut");
  system("$ENV{AUTO}/extract_istp.pl -f ${dirOut}${k}I${yyddd}.$extOut");

# Update 3 months inter-process comparisons plots
# -----------------------------------------------
  system("$ENV{AUTO}/make_oper_comp.bash -sol FIN >~/LOG/make_oper_comp_fin.log 2>&1 &");

# Delete Obsolete Files
# ---------------------
  my @delLst = (
    "${dirStd}${u}G${wwwwd}.${extStd}",
    "${dirRpr}${u}G${wwwwd}.${extRpr}",
    "${dirStd}${k}G${wwwwd}.${extStd}",
    "${dirRpr}${k}G${wwwwd}.${extRpr}",
  );

  foreach(@delLst) {
    my(@f) = glob("$_");
    print "\n$_: ".scalar(@f)."\n";
    foreach my $f(@f) {
      next unless(-e $f);
      unlink($f);
      print "  $f removed\n";
    }
  }

}

# ============================================================================

__END__
