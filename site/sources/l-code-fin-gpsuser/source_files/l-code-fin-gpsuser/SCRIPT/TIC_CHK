package TIC_CHK;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  TIC_CHK
#
# Purpose :  Check time intervals connected (TIC) by at least one phase
#            observation and reject remove OBS data with unmet requirements.
#
# Programs:
#
# Remark  :
#
# PARAMs  :  PARAM1 - Solution identifier $sol (optional)
#            PARAM2 - $obsMin (optional)
#            PARAM3 - $ticMax (optional)
#
# Author  :  S. Schaer
#
# Created :  28-Aug-2025
#
# Changes :  28-Aug-2025 SS: Report rejections in TIC_CHK.LST file
#            29-Aug-2025 SS: Some minor refinements
#            17-Sep-2025 SS: Also check key values for G/E (with AR)
#
# ============================================================================

use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Basename;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,$yyssss,$yyyyssss,$ddd,$ssss,$yyyy,$mjd,
    $v_i,$param1,$param2,$param3,
    $pcfFil,
    $dirObs,$dirOut,$extOut,
  ) =
  $bpe->getKeys(
    '$YD+0','$YSS+0','$YYYSS+0','$+0','$S+0','$Y+0','$JD+0',
    'V_I','PARAM1','PARAM2','PARAM3',
    'PCFFIL',
    'DIR_PZH','DIR_OUT','EXT_OUT',
  );

  $pcfFil = (split('\.',$pcfFil))[0];

  my $sol = $param1 ne "" ? $param1 : $v_i."P";
  my $out = "${dirOut}${sol}${ssss}????.${extOut}";
  prtMess($bpe,"Checked: $out");
  my $ticLst = "${dirOut}TIC_CHK.LST";
  my $ticSum = "${dirOut}TIC${yyssss}.LST";

  my $obsMin = $param2 ne "" ? $param2 : 0.75;
  my $ticMax = $param3 ne "" ? $param3 : 4;
##  if ($mjd >= 60932 && $mjd < 60939) { $obsMin = 0.996528;
##                                       $ticMax = 1 }
##  if ($mjd >= 60939 && $mjd < 60946) { $obsMin = 0.989583;
##                                       $ticMax = 2 }
  $obsMin = sprintf("%8.6f",$obsMin);
  prtMess($bpe,"OBSMIN: $obsMin");
  prtMess($bpe,"TICMAX: $ticMax");

  my $numFil = 0;
  my $numBadObs = 0;
  my $numBadTic = 0;
  my $numBad = 0;
  my $numRej = 0;
  my ($fil,$nam,$lin,$sta,$obs,$tic,$flgObs,$flgTic,$str,$rem);
  my ($obsG,$ticG,$obsE,$ticE);
  open(SUM,"> $ticSum");
  my @fil = glob($out);
  foreach $fil (@fil) {
    $nam = basename($fil);
    $lin = `grep '#TIC__' $fil`;
    next if $lin eq "";
    $numFil++;
    $sta = substr($lin,13,14);
    $obs = substr($lin,119,9);
    $tic = substr($lin,128,4);
    if ($obs<$obsMin) { $flgObs = "*" } else { $flgObs = " " }
    if ($tic>$ticMax) { $flgTic = "*" } else { $flgTic = " " }
    $lin = `grep '#TIC_G' $fil`;
    if ($lin ne "") {
      $obsG = substr($lin,119,9);
      $ticG = substr($lin,128,4);
      if ($obsG<$obsMin && $flgObs eq " ") { $flgObs = "G" }
      if ($ticG>$ticMax && $flgTic eq " ") { $flgTic = "G" }
    }
    $lin = `grep '#TIC_E' $fil`;
    if ($lin ne "") {
      $obsE = substr($lin,119,9);
      $ticE = substr($lin,128,4);
      if ($obsE<$obsMin && $flgObs eq " ") { $flgObs = "E" }
      if ($ticE>$ticMax && $flgTic eq " ") { $flgTic = "E" }
    }
    $str = "$sta $obs$flgObs $tic$flgTic";
    $rem = "";
    if ($flgObs ne " " || $flgTic ne " ") {
      prtMess($bpe,"Rejected: $sta $obs$flgObs $tic$flgTic");
      $sta = substr($sta,0,4);
      my @bad = glob("${dirObs}${sta}${ssss}.[PC]Z[HO]");
      my $num = @bad;
      if ($num!=4) { $rem = " (already rejected)"; $numRej++ }
      `echo '$yyssss: $str$rem' >> $ticLst`;
      map { print "BAD: $_\n" } @bad;
      map { move($_,"${dirObs}../TMP/") } @bad;
##      map { copy($_,"${dirObs}../TMP/") } @bad;
##      unlink(@bad);
      $numBadObs++ if $flgObs ne " ";
      $numBadTic++ if $flgTic ne " ";
      $numBad++;
    }
    print "$nam: $str$rem\n";
    print SUM   "$str$rem\n";
  }
  my $numSta = $numFil-$numBad;
  print     "\n*Summary: $numFil/$numBadObs/$numBadTic/$numBad/$numRej/$numSta ($obsMin/$ticMax)\n";
  print SUM "\n*Summary: $numFil/$numBadObs/$numBadTic/$numBad/$numRej/$numSta ($obsMin/$ticMax)\n";
  close(SUM);
  prtMess($bpe,"Summary: $numFil/$numBadObs/$numBadTic/$numBad/$numRej/$numSta ($obsMin/$ticMax)");

  die "No OUT file(s) successfully checked: $out\n" if $numFil==0;

  die "All OBS files rejected\n" if $numFil-$numBad==0;

}
