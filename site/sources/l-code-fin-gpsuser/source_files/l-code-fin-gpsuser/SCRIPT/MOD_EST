package MOD_EST;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  MOD_EST
#
# Purpose :  Modify .EST file for ADDNEQ2 run.
#
# PARAMs  :  PARAM1 - .EST file identifier
#            PARAM2 - grep string to be modified (e.g. OSB)
#            PARAM3 - Second grep string (optional)
#            PARAM4 - Third  grep string (optional)
#
# Author  :  S. Schaer
# Created :  19-May-2016
#
# Changes :  01-Sep-2021 RD: '#' is not allowed in a PCF (commenting)
#
# ============================================================================
use strict;

use File::Basename;

use lib "$ENV{AUTO}";
use gpsutil qw{replace};
use lib $ENV{BPE};
use bpe_util qw(prtMess);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ddd, $yyddd, $ssss,
      $param1, $param2, $param3, $param4,
      $dirOut, $dirEst,
      $extOut, $extEst) =
  $bpe->getKeys
     ('$+0', '$YD+0', '$S+0',
      'PARAM1', 'PARAM2', 'PARAM3', 'PARAM4',
      'DIR_OUT', 'DIR_EST',
      'EXT_OUT', 'EXT_EST');

# Set .EST filename
# -----------------
  $param1 = $$bpe{"V_$param1"}."_" if length($param1) == 1;

  my $estFil = "${dirEst}${param1}${yyddd}.${extEst}";

  my $str1 = '#' . $param2;
  my $str2 = "_" . $param2;
  replace($estFil,$str1,$str2);
  prtMess($bpe,".EST file ".basename($estFil)." modified $str1 to $str2");

  if ($param3 ne "") {
    $str1 = '#' . $param3;
    $str2 = '_' . $param3;
    replace($estFil,$str1,$str2);
    prtMess($bpe,".EST file ".basename($estFil)." modified $str1 to $str2");
  }
  if ($param4 ne "") {
    $str1 = '#' . $param4;
    $str2 = '_' . $param4;
    replace($estFil,$str1,$str2);
    prtMess($bpe,".EST file ".basename($estFil)." modified $str1 to $str2");
  }

}
