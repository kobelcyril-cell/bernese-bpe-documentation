package GPSESTAP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GPSESTAP
#
# Purpose :  Prepare parallel GPSEST run
#
# Programs:
#
# Author  :  M. Meindl
# Created :  30-Jul-2003               Last modified: 23-Jul-2008
#
# Changes :  26-Jan-2005 mm: New initPar call (w/o tmpFil)
#            10-Feb-2005 mm: Old date variables removed
#            10-Jul-2008 rd: temp files contain session
#            23-Jul-2008 rd: prepare for reprocessing
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yyddd,$yyssss,$ssss,
      $obsDir,$bpeDir,$outDir,$solDir) =
      $bpe->getKeys('$YD+0','$YSS+0','$S+0',
      "DIR_PSH","DIR_BPEPRT","DIR_OUT","DIR_NEQ");


# Define directories and file names
# ---------------------------------
  my $bpeFil = "${bpeDir}EST${yyssss}";
  my @obsFil = glob("${obsDir}????${ssss}.PSH");


# Remove residual files, output files, BPE files, NQ0's
# -----------------------------------------------------
  unlink(glob("${outDir}????$ssss.RES"));
  unlink(glob("${outDir}$yyddd*.OUT"));
  unlink(glob("${bpeFil}???.BPE"));
  unlink(glob("${solDir}$yyddd*.NQ0"));
  unlink(glob("${solDir}$yyddd*.NEQ"));


# Initialize parallel run
# -----------------------
  my $numClu = 14;
  my $numFil = 0;
  my $minClu = 0;
  initPar_Cl($bpe,$bpeFil,@obsFil,$numClu,$numFil,$minClu);


}
