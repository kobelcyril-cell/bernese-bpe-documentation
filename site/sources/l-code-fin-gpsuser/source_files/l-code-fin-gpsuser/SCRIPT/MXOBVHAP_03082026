package MXOBVHAP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name:      MXOBVHAP
#
# Purpose:   Prepare parallel MXOBV3 run for high-rate clock generation
#
# Programs:  ---
#
# Authors:   H.Bock
#
# Created:   04-Jul-2003
# Last mod.: 29-Sep-2009
#
# Changes:   16-Mar-2004 HB: Add concatenation of cluster files
#                           (Integration of high-rate clocks in CLKRAPID.PCF)
#            31-Jan-2005 mm: New initPar call (w/o tmpFil)
#            08-Feb-2005 mm: $s replaced by $bpe
#            21-Mar-2006 RD: Delete old observation files from OBS1
#            06-Oct-2008 HB: Case R05: Copy 5-sec files from RAW/HRD to RAW,
#                            if CRD and TRP available
#            17-Sep-2009 HB: Check for number of epochs in 5s-RNX-files and
#                            use only complete files for FIX-file
#            29-Sep-2009 rd/mm: remove double entires from CLB files
#            11-Jun-2013 RD: At least 10 reference clocks are requested
#                            (allow also for incomplete files)
#
# ----------------------------------------------------------------------------

use strict;
use File::Basename;
use lib "$ENV{BPE}";
use lib "$ENV{AUTO}";
use lib "$ENV{EXE}";
use gpsutil;
use bpe_util;
use Gps_Date;

sub run
{
  my $bpe = shift;

# Define variables
# ----------------
  my ( $yyddd, $yyssss,$yyyy, $ddd, $ssss,
       $PARAM2,$PARAM3,$PARAM4,$v_s,$v_u,$v_gnsh,$repro,
       $dirRxo,  $dirClb,  $dirPzh,  $dirOut, $dirSmt, $dirCrd, $dirFix,
       $extRxo,  $extClb,  $extPzh,  $extSmt, $extCrd, $extFix ) =
      $bpe->getKeys(
      '$YD+0','$YSS+0','$Y+0','$+0','$S+0',
      'PARAM2','PARAM3','PARAM4','V_S','V_U','V_GNSH','V_REPRO',
      'DIR_RXO','DIR_CLB','DIR_PZH','DIR_OUT','DIR_SMT','DIR_CRD','DIR_FIX',
      'EXT_RXO','EXT_CLB','EXT_PZH','EXT_SMT','EXT_CRD','EXT_FIX' );

  my $bpeFil;
  my $file;
  my $hrdLst;
  my $crdFil;
  my $fixFil;
  my $iLin=0;
  my $OK;
  my ($sta,$stal,$rnx);
  my @tst    = ();
  my @staLst = ();
  my @refLst = ();
  my @allFil = ();
  my @args   = ();

  my $numEpo;
  my $epoStr=gps_date("-doy ${ddd} ${yyyy} -o %y %m %d");
  $epoStr="'^ $epoStr'";
  $epoStr=~ s/ 0/ [ 0]/g;

# Check the availability of the alternative OBS-directories
# ---------------------------------------------------------
  check_dir($dirPzh);

  if ($PARAM3 eq 'R30'){
# Set some directories and file names
# -----------------------------------
      $bpeFil = "${dirOut}/RXH${ddd}";

# Get files to process
# --------------------
      my %hlpFil = ();
      my @files  = glob("$dirPzh/../OBS/????${ssss}.${extPzh}");
    # Get list of stations
      foreach (@files){
        my ($STA) = /\/(\w\w\w\w)${ssss}\.${extPzh}/;
        $hlpFil{$STA} = "${dirRxo}${STA}${ssss}.${extRxo}" if -e "${dirPzh}/../OBS/${STA}${ssss}.${extPzh}";
      }

      @allFil = values %hlpFil;


  } elsif ($PARAM3 eq 'R05'){
# Set some directories and file names
# -----------------------------------
      $bpeFil = "${dirOut}/RXS${ddd}";

# Get files to process
# --------------------
      $hrdLst ="${dirRxo}hrd${yyddd}.lst";
      $crdFil ="${dirCrd}${v_u}_${yyssss}.${extCrd}";

# List of stations which have estimated CRD
# -----------------------------------------
      print "$crdFil\n";
      open(CRD,"<$crdFil");
      while (<CRD>) {
          $iLin++;
          if ($iLin>6){
              @tst=split(" ",$_);
              if ($#tst>0){
                  if ($_ =~ /    [A-Z]$/){
                      push(@staLst,substr($_,5,14))} } } }
      close CRD;

# Check if HRD stations have estimated CRD or not
# -----------------------------------------------
      my %nEpochs = ();
      my $notCop=0;
      open(LST,"<$hrdLst");
      while (<LST>) {
          $OK='NOK';
          foreach $stal (@staLst){
              $rnx =substr($_,0,4);
              $sta =substr($stal,0,4);
              if ($sta eq $rnx){
                  $OK='OK';}
              if ($OK eq 'OK'){
                  print "${dirRxo}HRD/${rnx}${ssss}.${extRxo}\n";
                  push(@allFil,"${dirRxo}${rnx}${ssss}.${extRxo}");
                  if (-e "${dirRxo}HRD/${rnx}${ssss}.${extRxo}"){
                    copyfile ("${dirRxo}HRD/${rnx}${ssss}.${extRxo}","${dirRxo}${rnx}${ssss}.${extRxo}");
                    print "${dirRxo}HRD/${rnx}${ssss}.${extRxo} copied to ${dirRxo}${rnx}${ssss}.${extRxo}\n";
                  }
                  $numEpo=`grep $epoStr ${dirRxo}${rnx}${ssss}.${extRxo} | wc -l`;
                  chomp($numEpo);
                  print "$stal $numEpo\n";
                  $nEpochs{$stal} = $numEpo;
                  if ($numEpo > 17279){
                      push(@refLst,"$stal");}
                  last;
              }
          }
          if($OK eq 'NOK'){
              print "${dirRxo}HRD/${rnx}${ssss}.${extRxo} not copied\n";
              $notCop++;
          }
      }
      close LST;
      if(1==2){
          $bpe->setVar("MISHRD",$notCop);
      }

# Check that at least 10 stations are in the @refLst
# --------------------------------------------------
      if ( $#refLst < 10 ) {
        print "\n\nREDUCED TRACKING: \n".
              "allowing also for reference clock \n".
              "candidates with a reduced number of epochs:\n";
        my $iSta = 0;
        my $lNum = 0;
        @refLst = ();
        foreach my $sta1 ( sort {$nEpochs{$b} <=> $nEpochs{$a}} keys %nEpochs ) {
          last if ( $lNum != $nEpochs{$sta1} && $iSta > 15 );
          print "$sta1 $nEpochs{$sta1}\n";
          push @refLst,$sta1;
          $iSta++;
          $lNum = $nEpochs{$sta1};
        } }

# Write FIX-file for CCRNXC
# -------------------------
################################################################
# Check against available OBS-files is done at PID 835 CCRNXCF #
################################################################
      $fixFil ="${dirFix}HCK${yyddd}.${extFix}";
      open(LOG,">$fixFil");
      print LOG "LIST OF STATIONS FOR REFERENCE CLOCK TRANSFORMATION                  17-DEC-2007\n";
      print LOG "--------------------------------------------------------------------------------\n\n";
      print LOG "Station name\n";
      print LOG "****************\n";
      foreach $sta (sort @refLst){
          print LOG "$sta\n";}
      print LOG "\n\nAutomatically created by MXOBVHAP\n";
      close LOG;
}


# Delete old Bernese observation files of the session
# ---------------------------------------------------
  if($PARAM3 eq 'R30'){
    unlink glob("${dirPzh}/../OBS1/????${ssss}.?Z?");
  }elsif($PARAM3 eq 'R05'){
    unlink glob("${dirPzh}/../OBSH/????${ssss}.?Z?");
  }


  push (@args,"$PARAM3");
  push (@args,"$PARAM4");
  initPar_Cl($bpe, $bpeFil, @allFil, $PARAM2, 0, 0, @args);

}
