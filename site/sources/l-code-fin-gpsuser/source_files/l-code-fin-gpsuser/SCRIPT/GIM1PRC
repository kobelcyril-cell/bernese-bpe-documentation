
package GIM1PRC;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  GIM1PRC
#
# Purpose :  Create IGSIONO BPE processing summary file
#            Transformed from GIM_PRC
#
# PARAMs  :
#
# Author  :  A. Villiger
# Created :  02-Sep-2021
#
# Changes :  01-May-2003 SS: Store results concerning estimated GPS/GLONASS time offsets
#            15-Oct-2003 SS: Merge OFF DCB files
#            28-Apr-2006 SS: Create igsiono.txt
#            03-Aug-2007 MM: V_DIS activated
#            23-Jul-2008 RD: RNXERR.yy_ddd -> RNXyyssss.ERR
#            01-Oct-2009 SS: Bugfix/correction wrt CAMP_SAVIGS
#            14-Jan-2012 SS: Use save_offdcb.com
#            08-Jun-2016 SS: Execute save_dcboff.com in OFFDCB script
#            21-Oct-2016 SS: Move CLKEDT.SUM to CLKEDT.yy_ddd
#            07-Feb-2018 SS: Use V_UPD (not V_DIS) for WWW updates
#            15-Feb-2019 RD: Sort the RINEX messages (use of get_warn.pl)
#            02-Sep-2021 AV: Change from BDS to perl
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use bpe_util;

use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ( $yy, $yyyy, $yyssss, $ddd,
       $upd,
       $pthPcf, $pcfNam, $script,
       $dirSmc,$dirSum,$dirOut,$dirDcb,
       $extSmc,$extSum,$extOut,$extDcb) =
    $bpe->getKeys(
       '$Y', '$Y+0', '$YSS+0', '$+0',
       'V_UPD',
       'PTH_PCF', 'PCFFIL','SCRIPT',
       'DIR_SMC', 'DIR_SUM','DIR_OUT', 'DIR_DCB',
       'EXT_SMC', 'EXT_SUM','EXT_OUT', 'EXT_DCB');

# Move files
# ----------
  my %files;
  # CODSPP
  $files{CODSPP}{inp} = "$dirSmc/RXO${yyssss}.${extSmc}";
  $files{CODSPP}{out} = "$dirSmc/RNXGRA.${yy}_${ddd}";
  #CLKDER
  $files{CLKDET}{inp} = "$dirSum/CLKDET.${extSum}";
  $files{CLKDET}{out} = "$dirSum/CLKDET.${yy}_${ddd}";

  foreach my $file (keys %files){
    if(-s $files{$file}{inp}){
        movefile($files{$file}{inp},$files{$file}{out});
    }
  }

# Crate protocoll file
# --------------------
  my $status = "ok";
  my $prtFil = "${dirOut}/IGSIONO.${yy}_${ddd}";

# Report the BPE settings
# -----------------------
  open(PRC,"> $prtFil");
  print PRC "Summary file generated at ",timprt()," by $script\n\n";

  $pthPcf =~ s/$$bpe{U}/$$bpe{U_OLD}/;
  print "${pthPcf}/${pcfNam}\n";
  print PRC reportBPEvariables($bpe,"${pthPcf}/${pcfNam}");
  print PRC "\n\n";

  close PRC;

# Print processing summaries to protocol
# --------------------------------------
  my $gimXtr = "${dirOut}/GIMXTR.${yy}_${ddd}";
  if(-s $gimXtr){
    appendfile($prtFil, $gimXtr);
  }else{
    $status = "error";
  }

  my $resRms = "${dirOut}/RESRMS.${yy}_${ddd}";
  if(-s $resRms){
    appendfile($prtFil, $resRms);
  }else{
    $status = "error";
  }

  my $rnxGra = "${dirOut}/RNXGRA.${yy}_${ddd}";
  if(-s $rnxGra){
    appendfile($prtFil, $rnxGra);
  }else{
    $status = "error";
  }

  my $rnxErr = "${dirOut}/RNX${yyssss}.ERR";
  system("perl $ENV{AUTO}/get_warn.pl $rnxErr $rnxErr");
  if(-s $rnxErr){
    appendfile($prtFil, $rnxErr);
  }

# Store results concerning estimated GPS/GLO time offsets
# -------------------------------------------------------
  my $dcbFil = "$dirDcb/OFF${yy}${ddd}.$extDcb";
  my @cdFils = glob "$dirOut/CD${ddd}???.$extOut";

  my $timoff = "$dirSum/TIMOFF.$extSum";
  open OUT, ">> $timoff";
  if(-s $dcbFil){
    open INP, "< $dcbFil";
    foreach (<INP>){
      print OUT "$dcbFil: $_" if(/^R  /);
    }
    close INP;
  }
  foreach my $fil (@cdFils){
    open INP, "< $fil";
    foreach (<INP>){
      print OUT "$fil: $_" if(/NSEC/);
    }
    close INP;
  }
  print OUT " \n";
  close OUT;

# Update www directory
# --------------------
  my $wwwFil = "$ENV{PATH_WWW}/code/igsiono.txt";
  if($upd eq "Y"){
    copyfile($prtFil, $wwwFil);
  }else{
    prtMes($bpe,"FILES_NOT_DISTRIBUTED");
  }

# If error occured die
# --------------------
  if($status eq "ERR"){
    print "Error occured while creating protocol\n";
    die;
  }
}




# ============================================================================

__END__
