#!/bin/sh
# SCRIPT-NAME
# sh script file written by bds
# -----------------------------
# functions used by shell
do_rm( ) {
    if [ "$1" ]
    then
        if [ -f `echo $1 | tr ' ' '\012' | head -1` ]
        then
            eval rm $1
        fi
    fi
}
#
toupper( ) {
    eval $1=`echo $2 | ${UPPERC}`
    eval export $1
}
#
seterr( ) {
    if [ $? = 0 ]
    then
        ERRSTAT=OK
    else
        ERRSTAT=ERR
    fi
}
#
# -----------------------------
# SHELL STARTS HERE
# -----------------------------
#
# IGSF_CHK
# ========
#
# CHECKS THE GPSEDT SUMMARY FOR BAD SATELLITES RESP. MANEUVERS
# AND RESTARTS THE IGSFINAL
# ------------------------------------------------------------
#
# 18-Sep-2000/SS: Change extension of RESRMS file from DDD to YY_DDD
# 18-Sep-2000/SS: Change extension of ASPLIT file from DDD to YY_DDD
# 18-Sep-2000/SS: Change extension of CODXTR file from DDD to YY_DDD
# 12-Mar-2003/SS: Bug fix: SATELLITE(s) w/o ":"
# 28-Jul-2003 RD: Adapt to the new BPE (remove _NEW, use STARTCOUNT)
# 20-Feb-2008/rd: Delete file containing the bad stations
# 07-Jan-2009/ps: Use V_SATCRX variable
#
#
# SHELL VARIABLES:
# ----------------
#
# YEAR    :  Year of the session to be processed (2 digit)
# SESSION :  Session number (4 characters)
# CAMPAIGN:  Campaign name
# CAMP_PTH:  Campaign path
# CAMP_DRV:  Drive letter for campain (i.e. P)
# OPT_DIR :  Directory for panels
# PID     :  Process identification number (3 digits)
# SUB_PID :  Subprocess id (3 digits)
# PRT_FILE:  Protocol file name including path
# SCRIPT  :  Name of script
# TASKID  :  Task id of script, usually 00
# PRIORITY:  Priority of the script
# CPU     :  CPU the script is running on
# DAYYEAR :  Julian day of the year
# DAY     :  Day of the Month
# MONTH   :  Month, 1=JAN, 12=DEC
# GPSWEEK :  GPS week
# DAYWEEK :  Day of the week, 0=SUN, 6=SAT
# V_X     :  X Variable in DAT151__.PAN
# V_O     :  O Variable in DAT151__.PAN
# V_Z     :  Z Variable in DAT151__.PAN
# V_PLUS  :  Plus variable in DAT151__.PAN
# V_MINUS :  Minus variable in DAT151__.PAN
# V_x     :  User variable
# PARAMx  :  Script specific parameter, x is 1 thru 9
# U       :  Directory path to U:
#
# use the new menu system
TSTMENU="TRUE"
export TSTMENU
#
# See if this shell is being run from the PCS
# script, or directly for testing.  If testing,
# no the header script is not passed in as %1%
#
if [ "$1" = "" ]
then
#
#   set variables for testing here
#
    TEST_START_DIR=`pwd`
    cd $U/WORK
    TESTING="YES"
    export TESTING
else
    TESTING="NO"
    export TESTING
    . "$1"
    seterr
fi
#
# START THE MENU SYSTEM IN NON-INTERACTIVE MODE
# ---------------------------------------------
. $X/SCRIPT/BEG_MENU
seterr
#
# SET VARIABLES IN DAT151__.PAN
# -----------------------------
. $X/SCRIPT/SET_SESS
seterr
#
# SHELL BODY
# ----------
#
#
# Set number of iterations
# ------------------------
MAXRUN="3"
export MAXRUN
iRUN=""$STARTCOUNT""
export iRUN
#
# DEFINE A TMPFIL FOR THE RESULT OF THE CHECK
# -------------------------------------------
TMPFIL=""$CAMP_PTH""$CAMPAIGN"/OUT/"$YEAR""$DAYYEAR".CHK"
export TMPFIL
rm -f "$TMPFIL"
#
# SET SOME FILE NAMES
# -------------------
${EXE}/NPUTKEY $U/PAN/RESCHK.INP CODXTR CODXTR."$YEAR"_"$SESSION"
seterr
if [ -f `echo $CAMP_PTH$CAMPAIGN/OUT/ASPLIT.$YEAR_$SESSION | tr ' ' '\012' | head -1` ]
then
    ${EXE}/NPUTKEY $U/PAN/RESCHK.INP ASPLIT ASPLIT."$YEAR"_"$SESSION"
    seterr
fi
${EXE}/NPUTKEY $U/PAN/MENU_EXT.INP EXT_SUM "$YEAR"_"$SESSION"
seterr
${EXE}/NPUTKEY $U/PAN/RESCHK.INP RESRMS RESRMS."$YEAR"_"$SESSION"
seterr
${EXE}/NPUTKEY $U/PAN/RESCHK.INP SATCRUX "$V_SATCRX"_"$YR_4".CRX
seterr
${EXE}/NPUTKEY $U/PAN/MENU_EXT.INP EXT_DEL CHK
seterr
${EXE}/NPUTKEY $U/PAN/RESCHK.INP DELSTA "$YEAR""$DAYYEAR".CHK
seterr
${EXE}/NPUTKEY $U/PAN/RESCHK.INP SUMOUT RESSUM
seterr
#
# Prevent IGSFINAL RESCHK looping
# -------------------------------
FLGFIL=""$CAMP_PTH""$CAMPAIGN"/MSC/NO_LOOP.FLG"
export FLGFIL
if [ -f `echo $FLGFIL | tr ' ' '\012' | head -1` ]
then
    ${EXE}/NPUTKEY $U/PAN/RESCHK.INP BADSTA 0
    seterr
    ${EXE}/NPUTKEY $U/PAN/RESCHK.INP MANSAT 0
    seterr
fi
#
# the check is a perl script
# --------------------------
PGMNAM="RESCHK"
export PGMNAM
. $X/SCRIPT/RUN_PGMS
seterr
#
# Add SYSOUT to the summary list
# ------------------------------
XTRSUM=""$CAMP_PTH""$CAMPAIGN"/OUT/RESCHK."$YEAR"_"$SESSION""
export XTRSUM
if [ -f `echo $XTRSUM | tr ' ' '\012' | head -1` ]
then
    cat "$CAMP_PTH""$CAMPAIGN"/OUT/"$SYSOUT" >> "$XTRSUM"
else
    cp "$CAMP_PTH""$CAMPAIGN"/OUT/"$SYSOUT" "$XTRSUM"
fi
cat "$CAMP_PTH""$CAMPAIGN"/OUT/RESSUM."$YEAR"_"$SESSION" >> "$XTRSUM"
#
# Delete bad stations
# -------------------
RESULT=`cat "$TMPFIL"`
export RESULT
iDel="0"
export iDel
#
for DELFIL in  $RESULT
do
    rm -f "$DELFIL"
    iDel=`expr "$iDel" + 1`
    export iDel
done
#
# Check for bad satellites
# ------------------------
iSat="0"
export iSat
HELP1=`cat "$CAMP_PTH""$CAMPAIGN"/OUT/"$SYSOUT"`
export HELP1
for LINE in  $HELP1
do
    LAST=""$THIS""
    export LAST
    THIS=""$LINE""
    export THIS
    if [ "$LAST" = "BAD" ]
    then
        if [ "$THIS" = "SATELLITE(s)" ]
        then
            iSat="1"
            export iSat
        fi
    fi
    if [ "$LAST" = "FOR" ]
    then
        if [ "$THIS" = "SATELLITE(s):" ]
        then
            iSat="1"
            export iSat
        fi
    fi
done
#
# Was an event in this solution?
# ------------------------------
iOK=`expr "$iDel" + "$iSat"`
export iOK
if [ "$iOK" -gt 0 ]
then
#
#   CALL THE CHECK PROGRAM with full output
#   ---------------------------------------
    ${EXE}/NPUTKEY $U/PAN/RESCHK.INP SUMMARY DETAILS
    seterr
    PGMNAM="RESCHK"
    export PGMNAM
    . $X/SCRIPT/RUN_PGMS
    seterr
#
#   Add RESRMS summary to the summary
#   ---------------------------------
#   open write #FILNAM $U/WORK/RESRMS
    rm -f $U/WORK/RESRMS
#
    echo $U/INP/"$PGMNAM".INP RESRMS | $XG/GETKEY >> $U/WORK/RESRMS
#   close #FILNAM
    RESRMS=`cat $U/WORK/RESRMS`
    export RESRMS
    rm -f $U/WORK/RESRMS
#
    if [ -f `echo $XTRSUM | tr ' ' '\012' | head -1` ]
    then
        cat "$RESRMS" >> "$XTRSUM"
    else
        cp "$RESRMS" "$XTRSUM"
    fi
fi
#
# Check where to go
# -----------------
if [ "$iOK" -eq 0 ]
then
    $X/SCRIPT/PRT_GOTO "$PARAM2"
    seterr
else
#
#   Continue because of MAXRUN was reached
    if [ "$iRUN" -ge "$MAXRUN" ]
    then
        $X/SCRIPT/PRT_GOTO "$PARAM2"
        seterr
    else
#
#       Bad satellites found
        if [ "$iSat" -gt 0 ]
        then
            $X/SCRIPT/PRT_GOTO "$PARAM3"
            seterr
        else
#
#           Delete bad stations
            if [ "$iDel" -gt 0 ]
            then
                $X/SCRIPT/PRT_GOTO "$PARAM4"
                seterr
            fi
        fi
    fi
fi
#
rm -f "$TMPFIL"
#
# --------------
# end the script
# --------------
. $X/SCRIPT/END_MENU
seterr
if [ "$TESTING" = "YES" ]
then
    cd "$TEST_START_DIR"
else
    . $X/SCRIPT/DO_TAIL
    seterr
fi
