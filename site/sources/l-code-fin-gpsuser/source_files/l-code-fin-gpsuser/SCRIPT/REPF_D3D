package REPF_D3D;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  REPF_D3D
#
# Purpose :  Delete all files from the current session for IGSFIN3D.PCF
#
# PARAMs  :
#
# Author  :  P. Steigenberger
#
# Created :  24-Jul-2008
#
# Changes :  13-Nov-2008 SL/PS: comment unlink line (${dirNq0}?3?)
#
# ============================================================================

use strict;
use warnings;

use lib "$ENV{BPE}";
use bpe_util qw(prtMess);

sub run {

  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyssss, $yy, $ssss, $ddd, $yyddd, $yydddm1,
    $yydddp1,$wwwwd, $v_k,$v_o,$v_del,
    $dirCrd, $dirOut,$dirClk,$dirEle, $dirErp,
    $extCrd, $extOut,$extClk,$extEle, $extErp,
    $dirFix, $dirGcc, $dirIep,
    $extFix, $extGcc, $extIep,
    $dirLst, $dirNq0, $dirPre, $dirRes, $dirRpr,
    $extLst, $extNq0, $extPre, $extRes, $extRpr,
    $dirStd, $dirSum, $dirTrp,
    $extStd, $extSum, $extTrp,
  ) =
  $bpe->getKeys(
    '$YSS+0','$Y','$S+0','$+0','$YD+0','$YD-1',
    '$YD+1','$WD+0','V_K','V_O','V_DEL',
    'DIR_CRD','DIR_OUT','DIR_CLK','DIR_ELE','DIR_ERP',
    'EXT_CRD','EXT_OUT','EXT_CLK','EXT_ELE','EXT_ERP',
    'DIR_FIX','DIR_GCC','DIR_IEP',
    'EXT_FIX','EXT_GCC','EXT_IEP',
    'DIR_LST','DIR_NEQ','DIR_PRE','DIR_RES','DIR_RPR',
    'EXT_LST','EXT_NEQ','EXT_PRE','EXT_RES','EXT_RPR',
    'DIR_STD','DIR_SUM','DIR_TRP',
    'EXT_STD','EXT_SUM','EXT_TRP',
  );

# Delete Files if requested
# -------------------------

 if ( ${v_del} eq "Y" )
  {

       unlink glob "$dirOut*.J_lk";

# ATM
       unlink glob("${dirTrp}?3_$yyddd.$extTrp");

# ORB
       deletefile("${dirPre}${v_k}_$yydddm1.$extPre",$ddd,3);
       deletefile("${dirErp}${v_k}_$yydddm1.$extErp",$ddd,3);
       deletefile("${dirClk}${v_o}_$yydddm1.$extClk",$ddd,3);
       deletefile("${dirStd}I1_$yydddm1.$extStd",$ddd,3);
       deletefile("${dirRpr}I1_$yydddm1.$extRpr",$ddd,3);

       deletefile("${dirPre}${v_k}_$yyddd.$extPre",$ddd,3);
       deletefile("${dirErp}${v_k}_$yyddd.$extErp",$ddd,3);
       deletefile("${dirClk}${v_o}_$yyddd.$extClk",$ddd,3);
       deletefile("${dirStd}I1_$yyddd.$extStd",$ddd,3);
       deletefile("${dirRpr}I1_$yyddd.$extRpr",$ddd,3);

       deletefile("${dirPre}${v_k}_$yydddp1.$extPre",$ddd,3);
       deletefile("${dirErp}${v_k}_$yydddp1.$extErp",$ddd,3);
       deletefile("${dirClk}${v_o}_$yydddp1.$extClk",$ddd,3);
       deletefile("${dirStd}I1_$yydddp1.$extStd",$ddd,3);
       deletefile("${dirRpr}I1_$yydddp1.$extRpr",$ddd,3);

       unlink glob("${dirEle}?3?$yyddd.$extEle");
       unlink glob("${dirEle}?3M1$yydddm1.$extEle");
       unlink glob("${dirEle}?3P1$yydddp1.$extEle");
       unlink glob("${dirErp}?3?$yyddd.$extErp");
       unlink glob("${dirErp}FIN$yyddd.$extErp");
       unlink glob("${dirGcc}?3?$yyddd.$extGcc");
       unlink glob("${dirIep}?3?$yyddd.$extIep");
       unlink glob("${dirPre}?3?$yyddd.$extPre");
       unlink glob("${dirPre}?3M1$yydddm1.$extPre");
       unlink glob("${dirPre}?3P1$yydddp1.$extPre");
       unlink glob("${dirStd}?3?$yyddd.$extStd");
       unlink glob("${dirStd}Q1G$wwwwd.$extStd");
       unlink glob("${dirStd}?3M1$yydddm1.$extStd");
       unlink glob("${dirStd}?3P1$yydddp1.$extStd");

# OUT
       unlink glob("${dirLst}?3?${yyddd}.${extLst}");
       unlink glob("${dirLst}COD${wwwwd}.${extLst}");
       unlink glob("${dirOut}?3?${yyddd}.${extOut}");
       unlink glob("${dirOut}*.${yy}_${ddd}");
       unlink glob("${dirOut}*.${yy}_${ssss}");
       unlink glob("${dirSum}?3?${yyddd}.${extSum}");
       unlink glob("${dirSum}DF?${yyssss}.${extSum}");
       unlink glob("${dirSum}???${yyssss}.${extOut}");
       unlink glob("${dirSum}F3D${yyddd}.PRC");
       unlink glob("${dirSum}ASP${yyssss}.${extSum}");

# SOL
       deletefile("${dirNq0}${v_k}_$yydddm1.$extNq0",$ddd,3);
       deletefile("${dirNq0}${v_k}_$yyddd.$extNq0",$ddd,3);
       deletefile("${dirNq0}${v_k}_$yydddp1.$extNq0",$ddd,3);

#       unlink glob("${dirNq0}?3?$yyddd.${extNq0}");

# STA
       unlink glob("${dirCrd}?3?$yyddd.${extCrd}");
       unlink glob("${dirFix}REF$yyssss.${extFix}");
   }
  else
   {prtMess($bpe,"FILES NOT DELETED");}

}

# ============================================================================

__END__
