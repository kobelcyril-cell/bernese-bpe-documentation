package REPF_D1D;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  REPF_D1D
#
# Purpose :  Delete all files from the current session for IGSFIN1D.PCF
#            V_DEL is ignored if PARAM1 = DELETE (for initialization)
#
# PARAMs  :
#
# Author  :  S. Lutz, R. Dach
# Created :  22-Jul-2008
#
# Changes :  28-Jul-2008 PS: V_DEL and PARAM1 added
#            11-Jun-2013 SL: Use @delLst
#            14-Jan-2021 RD: Delete also results from ATTXTR
#            13-Aug-2021 RD: Start using BSW-style filenaming in the campaign area
#            07-Apr-2022 ST: Remove DIR_BRD, EXT_BRD, DIR_TAB and EXT_TAB.
#
# ============================================================================

use strict;
use warnings;

use lib $ENV{BPE};
use bpe_util qw(prtMess);

sub run {

  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyssss, $yyyy, $yy, $ssss, $ddd, $yyddd, $yymm, $wwwwd,
    $taskid, $del,  $param1,
    $dirCrd, $dirOut, $dirRxo, $dirObs, $dirSmc, $dirSme,
    $extCrd, $extOut, $extRxo, $extObs, $extSmc, $extSme,
    $dirBsl, $dirClb, $dirClk, $dirDcb, $dirEdt,
    $extBsl, $extClb, $extClk, $extDcb, $extEdt,
    $dirEle, $dirErp, $dirGcc, $dirIep, $dirInx, $dirIon,
    $extEle, $extErp, $extGcc, $extIep, $extInx, $extIon,
    $dirLst, $dirNq0, $dirPre, $dirRes, $dirRpr, $dirSig,
    $extLst, $extNq0, $extPre, $extRes, $extRpr, $extSig,
    $dirSmt, $dirStd, $dirSum, $dirTro, $dirTrp,
    $extSmt, $extStd, $extSum, $extTro, $extTrp,
    $dirFix, $dirObx,
    $extFix, $extObx
  ) =
  $bpe->getKeys(
    '$YSS+0','$Y+0','$Y','$S+0','$+0','$YD+0','$M+0','$WD+0',
    'TASKID', 'V_DEL', 'PARAM1',
    'DIR_CRD','DIR_OUT','DIR_RXO','DIR_PSH','DIR_SMC','DIR_SME',
    'EXT_CRD','EXT_OUT','EXT_RXO','EXT_PSH','EXT_SMC','EXT_SME',
    'DIR_BSL','DIR_CLB','DIR_CLK','DIR_DCB','DIR_EDT',
    'EXT_BSL','EXT_CLB','EXT_CLK','EXT_DCB','EXT_EDT',
    'DIR_ELE','DIR_ERP','DIR_GCC','DIR_IEP','DIR_INX','DIR_ION',
    'EXT_ELE','EXT_ERP','EXT_GCC','EXT_IEP','EXT_INX','EXT_ION',
    'DIR_LST','DIR_NEQ','DIR_PRE','DIR_RES','DIR_RPR','DIR_SIG',
    'EXT_LST','EXT_NEQ','EXT_PRE','EXT_RES','EXT_RPR','EXT_SIG',
    'DIR_SMT','DIR_STD','DIR_SUM','DIR_TRO','DIR_TRP',
    'EXT_SMT','EXT_STD','EXT_SUM','EXT_TRO','EXT_TRP',
    'DIR_FIX','DIR_OBX',
    'EXT_FIX','EXT_OBX'
  );

# List of files to be deleted
# ---------------------------
  my @delLst = (
# Protocol
    "${dirSum}IGSREP1D.${yy}_${ssss}",

# Observation files
    "${dirOut}SMT${yyddd}[0-9][0-9][0-9].${extOut}",
    "${dirOut}RXO${yyddd}[0-9][0-9][0-9].${extOut}",
    "${dirSum}RNX${yyssss}.ERR",
    "${dirRxo}*${ssss}.${extRxo}",
    "${dirRxo}*${ssss}.RXO",
    "${dirSmt}*${ssss}.${extSmt}",
    "${dirObs}????${ssss}.???",

# Preprocessing
    "${dirOut}CD${yyddd}[0-9][0-9][0-9].${extOut}",
    "${dirSmc}${yyddd}.${extSmc}",
    "${dirSme}${yyddd}.${extSme}",
    "${dirSum}CODXTR.${yy}_${ssss}",



# Troposphere and Ionosphere
    "${dirTrp}?1_${yyddd}.${extTrp}",
    "${dirTro}?1_${yyddd}.${extTro}",
    "${dirIon}?1_${yyddd}.${extIon}",
    "${dirInx}?1_${yyddd}.${extInx}",

# Orbits, ERPs and DCBs
    "${dirDcb}????${ddd}W.${extDcb}",
    "${dirDcb}????${ddd}W.F",
    "${dirDcb}W10${yyddd}.${extDcb}",
    "${dirClk}?1_${yyddd}.${extClk}",
    "${dirDcb}?1_${yyddd}.${extDcb}",
    "${dirDcb}?1_${yyddd}.F",
    "${dirEle}?1_${yyddd}.${extEle}",
    "${dirErp}?1_${yyddd}.${extErp}",
    "${dirErp}FIN${yyddd}.${extErp}",
    "${dirGcc}?1_${yyddd}.${extGcc}",
    "${dirIep}?1_${yyddd}.${extIep}",
    "${dirObx}?1_${yyddd}.${extObx}",
    "${dirPre}?1_${yyddd}.${extPre}",
    "${dirPre}IGS${yyddd}.${extPre}",
    "${dirRpr}?1_${yyddd}.${extRpr}",
    "${dirStd}?1_${yyddd}.${extStd}",

# Output files
    "${dirOut}${yyddd}[0-9][0-9][0-9].${extOut}",
    "${dirEdt}${yyddd}[0-9][0-9][0-9].${extEdt}",
    "${dirRes}${yyddd}[0-9][0-9][0-9].${extRes}",
    "${dirSum}${yyddd}[0-9][0-9][0-9].${extSum}",
    "${dirEdt}ED${yyddd}[0-9][0-9][0-9].${extEdt}",
    "${dirSum}ED${yyddd}[0-9][0-9][0-9].${extSum}",
    "${dirOut}EF${yyddd}[0-9][0-9][0-9].${extOut}",
    "${dirRes}EF${yyddd}[0-9][0-9][0-9].${extRes}",
    "${dirOut}EL${yyddd}[0-9][0-9][0-9].${extOut}",
    "${dirRes}EL${yyddd}[0-9][0-9][0-9].${extRes}",
    "${dirOut}MP${yyddd}[0-9][0-9][0-9].${extOut}",
    "${dirOut}MRK${yyddd}[0-9][0-9][0-9].${extOut}",
    "${dirOut}RMS${yyddd}[0-9][0-9][0-9].${extOut}",

    "${dirEdt}????${ddd}C.${extEdt}",
    "${dirOut}????${ddd}[ABCRPQVFNW].${extOut}",
    "${dirRes}????${ddd}C.${extRes}",
    "${dirSum}????${ddd}C.${extSum}",
    "${dirOut}?1?$yyddd.${extOut}",
    "${dirLst}?1?$yyddd.${extLst}",
    "${dirOut}[A-Z][A-Z][A-Z]${yyssss}.AMB",
    "${dirOut}[A-Z][A-Z][A-Z]$yyssss.${extOut}",
    "${dirOut}[A-Z][A-Z][A-Z][A-Z]$yyssss.${extOut}",
    "${dirSum}[A-Z][A-Z][A-Z]$yyssss.${extSum}",
    "${dirSum}OC1_$yyssss.${extSum}",

    "${dirSum}AMBX$yyssss.${extSum}",
    "${dirSum}EST?${yyssss}.${extSum}",
    "${dirSum}[GHQW]1?$yyddd.${extSum}",
    "${dirSum}MLWX$yyssss.${extSum}",
    "${dirOut}ATT_$yyddd.${extOut}",
    "${dirOut}ORB$yyddd.${extOut}",
    "${dirLst}RNX$yyddd.${extLst}",
    "${dirOut}TAB$yyddd.${extOut}",
    "${dirSmc}RXO$yyssss.${extSmc}",
    "${dirEdt}SPP$yyssss.${extEdt}",

    "${dirSum}DEFWKS.${yy}_${ssss}",
    "${dirSum}DEFXTR.${yy}_${ssss}",
    "${dirSum}GPSCMP.${yy}_${ssss}",
    "${dirSum}GPSWKS.${yy}_${ssss}",
    "${dirSum}GPSXTR.${yy}_${ssss}",
    "${dirSum}MPRXTR.${yy}_${ssss}",
    "${dirSum}RESCHK.${yy}_${ssss}",
    "${dirSum}RESRMS.${yy}_${ssss}",
    "${dirSum}RESSUM.${yy}_${ssss}",
    "${dirSum}${taskid}D${yyddd}.PRC",

    "${dirOut}HLMR$yyddd.${extOut}",

# Normal equations
    "${dirNq0}${yyddd}[0-9][0-9][0-9].${extNq0}",
    "${dirNq0}????${ddd}W.${extNq0}",
    "${dirNq0}?1?${yyddd}.${extNq0}",

# Coordinates and station files
    "${dirCrd}?1?${yyddd}.${extCrd}",
    "${dirCrd}FIN${yyddd}.${extCrd}",
    "${dirClb}${yyddd}_??.${extClb}",
    "${dirBsl}?1?${yyddd}.${extBsl}",
    "${dirBsl}???${yyssss}.SEL",
    "${dirFix}REF${yyssss}.${extFix}",

    "${dirOut}*.J_lk",
  );

# Delete the files
# ----------------
  if($del eq "Y" || $param1 eq "DELETE") {
    foreach(@delLst) {
      my(@f) = glob("$_");
      print "$_: ".scalar(@f)."\n";
      foreach my $f(@f) {
        unlink($f);
        print "  $f deleted\n";
      }
    }
  } else {
    prtMess($bpe,"FILES NOT DELETED (V_DEL=$del)");
  }

}

# ============================================================================

__END__
