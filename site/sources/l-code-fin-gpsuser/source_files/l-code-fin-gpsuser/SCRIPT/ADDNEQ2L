package ADDNEQ2L;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ADDNEQ2L
#
# Purpose :  Compare bernese neqs of last 90 days
#
# Programs:  ADDNEQ2
#
# Author  :  E. Brockmann
# Created :  19-Aug-2025
#
# Changes :  19-Aug-2025 EB: Started
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($camp_pth, $campaign, $param1) =
    $bpe->getKeys('CAMP_PTH', 'CAMPAIGN', 'PARAM1');

# Set default
# -----------
  $param1 = -90 if $param1 eq "";

# Skip the script in case of reprocessing
# ---------------------------------------
  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");
  unless ($repro) {

# Set 90-day overlap
# ------------------
    setMinusPlus($bpe,-90,0);

# Run program
# -----------
    my $PGMNAM = "ADDNEQ2";
    $bpe->RUN_PGMS($PGMNAM);

  } # end of non-reprocessing
}
