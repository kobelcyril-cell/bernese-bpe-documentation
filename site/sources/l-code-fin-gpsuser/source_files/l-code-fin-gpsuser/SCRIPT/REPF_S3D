package REPF_S3D;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  REPF_S3D
#
# Purpose :  Copy all relevant results to save disk
#            (for reprocessing)
#
# Programs:
#
# Author  :  R. Dach
#
# Created :  07-Dec-2007
#
# Changes :  17-Jun-2013 SL: Some smaller modifications
#            25-Jun-2013 PS: Don't save CODwwwwd.LST files 
#                            (for repro generated by ORBVER.PCF)
#
# ============================================================================

use strict;
use warnings;
use File::Basename;

use lib "$ENV{BPE}";
use bpe_util qw(check_dir copy2archive prtMess);
use lib "$ENV{AUTO}";
use igs_device;

sub run {

  my $bpe = shift;

# Define variables
# ----------------
  my(
    $yyddd, $yy, $yyyy, $ssss, $ddd, $wwwwd, $yyssss,
    $x, $e, $h, $i, $u, $z, $k,
    $sav, $prc, $pcfFil,
    $camp_pth, $campaign,  $dirBpe,
    $dirOut, $dirNeq, $dirTrp, $dirErp, $dirIep, $dirPre,
    $extOut, $extNeq, $extTrp, $extErp, $extIep, $extPre,
    $dirStd, $dirEle, $dirCrd, $dirGcc, $dirLst, $dirFix,
    $extStd, $extEle, $extCrd, $extGcc, $extLst, $extFix,
    $dirSnx, $dirTro, $dirEst, $dirSum,
    $extSnx, $extTro, $extEst, $extSum,
  ) =
  $bpe->getKeys(
    '$YD+0','$Y','$Y+0','$S+0','$+0','$WD+0','$YSS+0',
    'V_X','V_E','V_H','V_I','V_U','V_Z','V_K',
    'V_SAV','V_PRC','V_PCFFIL',
    'CAMP_PTH','CAMPAIGN', 'DIR_BPEOUT',
    'DIR_OUT','DIR_NEQ','DIR_TRP','DIR_ERP','DIR_IEP','DIR_PRE',
    'EXT_OUT','EXT_NEQ','EXT_TRP','EXT_ERP','EXT_IEP','EXT_PRE',
    'DIR_STD','DIR_ELE','DIR_CRD','DIR_GCC','DIR_LST','DIR_FIX',
    'EXT_STD','EXT_ELE','EXT_CRD','EXT_GCC','EXT_LST','EXT_FIX',
    'DIR_SNX','DIR_TRO','DIR_EST','DIR_SUM',
    'EXT_SNX','EXT_TRO','EXT_EST','EXT_SUM',
  );

# Some directories
# ----------------
  my $dirSav = "${camp_pth}${campaign}/../${yyyy}/";
  my $orbSav = "${dirSav}ORB/";
  my $outSav = "${dirSav}OUT/";
  my $atmSav = "${dirSav}ATM/";
  my $solSav = "${dirSav}SOL/";
  my $staSav = "${dirSav}STA/";
  my $bpeSav = "${dirSav}BPE/";

  if($sav eq "Y") {
    &check_dir($orbSav,$outSav,$atmSav,$solSav,$staSav,$bpeSav);
  }

# Extract the title of the reprocessing
# -------------------------------------
  my $repro = "${camp_pth}${campaign}/MSC/REPROCESSING.FLG";
  open(REP,"$repro");
  my $tit = <REP>;
  my $tit2 = <REP>;  # <<< ?
  $tit = $tit2 if ( $tit2 ne "" );
  close(REP);
  chomp($tit);

# Copy files to savedisk
# ----------------------
# Mandatory files
  my @cpyLst = (
# Protocol
    "${dirOut}IGSREP3D.${yy}_${ssss}    ${outSav} f ",

# Normal equations
    "${dirNeq}${z}N${yyddd}.${extNeq}   ${solSav} z ",

# Final solution
    "${dirOut}${z}_${yyddd}.${extOut}   ${outSav} f ",
    "${dirFix}${z}_${yyddd}.${extFix}   ${staSav} f ",
    "${dirGcc}${z}_${yyddd}.${extGcc}   ${orbSav} f ",
    "${dirCrd}${z}_${yyddd}.${extCrd}   ${staSav} f ",
    "${dirTrp}${z}_${yyddd}.${extTrp}   ${atmSav} f ",
##    "${dirTro}${z}_${yyddd}.${extTro}   ${atmSav} fc ", # after TROTRO (below)
    "${dirErp}${z}_${yyddd}.${extErp}   ${orbSav} f ",
    "${dirIep}${z}_${yyddd}.${extIep}   ${orbSav} f ",
    "${dirIep}${z}N${yyddd}.${extIep}   ${orbSav} f ",
    "${dirEle}${z}_${yyddd}.${extEle}   ${orbSav} f ",
    "${dirStd}${z}_${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirPre}${z}_${yyddd}.${extPre}   ${orbSav} f ", # to be replaced by ${z}N
    "${dirSnx}${z}_${yyddd}.${extSnx}   ${solSav} fc ",
    "${dirTro}${z}N${yyddd}.${extTro}   ${atmSav}${z}_${yyddd}.${extTro} fc ",
    "${dirSum}${z}W${yyddd}.${extSum}   ${outSav} _ ",

    "${dirBpe}${prc}${yyssss}.LOG       ${bpeSav} o",
  );

  if ( basename($pcfFil,".PCF") eq "IGSFIN3T" ) {  push(@cpyLst,

# Solution with GNSS specific parameters (ISTPs, ERPs, GCCs), 3-day
    "${dirCrd}${z}I${yyddd}.${extCrd}   ${staSav} _ ",
    "${dirTrp}${z}I${yyddd}.${extTrp}   ${atmSav} _ ",
    "${dirTro}${z}I${yyddd}.${extTro}   ${atmSav} c ",
    "${dirEst}${z}I${yyddd}.${extEst}   ${solSav} _ ",
    "${dirOut}${z}I${yyddd}.${extOut}   ${outSav} _ ",

# Final solution, 1-day (pulse deleted)
    "${dirCrd}${k}0${yyddd}.${extCrd}   ${staSav} f ",
    "${dirTrp}${k}0${yyddd}.${extTrp}   ${atmSav} f ",
    "${dirErp}${k}0${yyddd}.${extErp}   ${orbSav} f ",
    "${dirIep}${k}0${yyddd}.${extIep}   ${orbSav} f ",
    "${dirEle}${k}0${yyddd}.${extEle}   ${orbSav} f ",
    "${dirStd}${k}0${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirPre}${k}0${yyddd}.${extPre}   ${orbSav} f ",
    "${dirOut}${k}0${yyddd}.${extOut}   ${outSav} _ ",

# Solution with GNSS specific parameters (ISTPs, ERPs, GCCs); 1-day
    "${dirCrd}${k}I${yyddd}.${extCrd}   ${staSav} _ ",
    "${dirTrp}${k}I${yyddd}.${extTrp}   ${atmSav} _ ",
    "${dirTro}${k}I${yyddd}.${extTro}   ${atmSav} c ",
    "${dirEst}${k}I${yyddd}.${extEst}   ${solSav} _ ",
    "${dirOut}${k}I${yyddd}.${extOut}   ${outSav} _ ",

  ); }

  if($sav eq "Y") {
    my(@err) = ();
    foreach(@cpyLst) {
      push(@err,"$_\n") if(&copy2archive(split(" ",$_),$tit));
    }
    die "\n *** copy2archive failed for\n @err\n" if(@err);

#    system("$ENV{AUTO}/changeLODsign.com ${solSav}/${z}_${yyddd}.${extSnx}.Z");
  }

# Some messages
# -------------
  if($sav ne "Y") {
    &prtMess($bpe,"FILES NOT SAVED");
    print       "\nFILES NOT SAVED\n";
  }

}

# ============================================================================

__END__
