package GOTO_SCR;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  GOTO_SRC
#
# Purpose :  Jump to specified PID
#
# PARAMs  :  PARAM2 PARAM3
#
# Author  :  A. Villiger
# Created :  12-Oct-2016
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($mode,$param2,$param3) =
      $bpe->getKeys(
      'V_MODE','PARAM2','PARAM3');

# Write the "next jobs" statement
# -------------------------------
  if($mode =~ /PPP/){
      $bpe->PRT_GOTO($param2);
  }else{
    $bpe->PRT_GOTO($param3);
  }
}
