#!/bin/sh
# SCRIPT-NAME
# sh script file written by bds
# -----------------------------
# functions used by shell
do_rm( ) {
    if [ "$1" ]
    then
        if [ -f `echo $1 | tr ' ' '\012' | head -1` ]
        then
            eval rm $1
        fi
    fi
}
#
toupper( ) {
    eval $1=`echo $2 | ${UPPERC}`
    eval export $1
}
#
seterr( ) {
    if [ $? = 0 ]
    then
        ERRSTAT=OK
    else
        ERRSTAT=ERR
    fi
}
#
# -----------------------------
# SHELL STARTS HERE
# -----------------------------
#
# GIM_DEL
# =======
#
# 21-Sep-2001/ss: Delete GPSG IONEX files
# 06-Jan-2002/ss: Delete NEQ files
# 13-Feb-2002/ss: Delete very large NQ0 files
# 04-Jan-2003/hu: Remove pole file from ORB not X/GEN
# 28-Jul-2003/ss: Change from old to new BPE
# 10-Jun-2014/ss: Delete BIA results
# 23-Oct-2014/ss: Delete ???yyddd_.OUT
# 06-Nov-2014/ss: Updated
# 08-Jun-2016/ss: Updated due to OSB implementation
# 15-Sep-2016/ss: Delete A1S NQ0 files
# 23-Nov-2020/rd: Delete REFyyddd_A.OUT files
# 13-Aug-2021 RD: Start using BSW-style filenaming in the campaign area
# 25-Jun-2025 EB: OBSI and RAWI also cleaned up
#
# SHELL VARIABLES:
# ----------------
#
# YEAR    :  Year of the session to be processed (2 digit)
# SESSION :  Session number (4 characters)
# CAMPAIGN:  Campaign name
# CAMP_PTH:  Campaign path
# CAMP_DRV:  Drive letter for campain (i.e. P)
# OPT_DIR :  Directory for panels
# PID     :  Process identification number (3 digits)
# SUB_PID :  Subprocess id (3 digits)
# PRT_FILE:  Protocol file name including path
# SCRIPT  :  Name of script
# TASKID  :  Task id of script, usually 00
# PRIORITY:  Priority of the script
# CPU     :  CPU the script is running on
# DAYYEAR :  Julian day of the year
# DAY     :  Day of the Month
# MONTH   :  Month, 1=JAN, 12=DEC
# GPSWEEK :  GPS week
# DAYWEEK :  Day of the week, 0=SUN, 6=SAT
# V_X     :  X Variable in DAT151__.PAN
# V_O     :  O Variable in DAT151__.PAN
# V_Z     :  Z Variable in DAT151__.PAN
# V_PLUS  :  Plus variable in DAT151__.PAN
# V_MINUS :  Minus variable in DAT151__.PAN
# V_x     :  User variable
# PARAMx  :  Script specific parameter, x is 1 thru 9
# U       :  Directory path to U:
#
# See if this shell is being run from the PCS
# script, or directly for testing.  If testing,
# no the header script is not passed in as %1%
#
if [ "$1" = "" ]
then
#
#   set variables for testing here
#
    TEST_START_DIR=`pwd`
    cd $U/WORK
    TESTING="YES"
    export TESTING
else
    TESTING="NO"
    export TESTING
    . "$1"
    seterr
fi
#
# START THE MENU SYSTEM IN NON-INTERACTIVE MODE
# ---------------------------------------------
. $X/SCRIPT/BEG_MENU
seterr
#
# SET VARIABLES IN DAT151__.PAN
# -----------------------------
. $X/SCRIPT/SET_SESS
seterr
#
# SHELL BODY
# ----------
#
# Remove files
# ------------
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/GIMXTR."$YEARM90"_"$DAYYM90"*
#
rm -f "$CAMP_PTH""$CAMPAIGN"/ORB/???"$YEARM8""$DAYYM8".PRE
rm -f "$CAMP_PTH""$CAMPAIGN"/ORB/???"$YEARM8""$DAYYM8".STD
rm -f "$CAMP_PTH""$CAMPAIGN"/ORB/???"$YEARM8""$DAYYM8".ERP
rm -f "$CAMP_PTH""$CAMPAIGN"/ORB/GIM"$YEARM8""$DAYYM8".CLK
rm -f "$CAMP_PTH""$CAMPAIGN"/ATM/GIM"$YEARM8""$DAYYM8".ION
#
rm -f "$CAMP_PTH""$CAMPAIGN"/RAW/*"$SESSM2".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/RAW/*"$SESSM8".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/RAW/*"$SESSM30".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/RAWI/*"$YEARM2""$SESSM2".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/RAWI/*"$YEARM8""$SESSM8".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/RAWI/*"$YEARM30""$SESSM30".???*
#
rm -f "$CAMP_PTH""$CAMPAIGN"/OBS/????"$SESSM2".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/OBS/????"$SESSM8".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/OBS/????"$SESSM15".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/OBSI/????"$SESSM2".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/OBSI/????"$SESSM8".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/OBSI/????"$SESSM15".???*
#
rm -f "$CAMP_PTH""$CAMPAIGN"/OBS_BAD/????"$SESSM90".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/OBS_LEO/????"$SESSM90".???*
#
rm -f "$CAMP_PTH""$CAMPAIGN"/TMP/????"$SESSM2".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/TMP/????"$SESSM8".???*
rm -f "$CAMP_PTH""$CAMPAIGN"/TMP/????"$SESSM15".???*
#
rm -f "$CAMP_PTH""$CAMPAIGN"/ATM/???"$YEARM30""$DAYYM30".ION
rm -f "$CAMP_PTH""$CAMPAIGN"/ATM/???"$YEARM30""$DAYYM30".INX
rm -f "$CAMP_PTH""$CAMPAIGN"/ATM/????"$SESSM30"."$YEARM30"N
rm -f "$CAMP_PTH""$CAMPAIGN"/ATM/????"$SESSM30"."$YEARM30"I*
#
rm -f "$CAMP_PTH""$CAMPAIGN"/ATM/???"$YEARM30""$DAYYM30".TRP
#
rm -f "$CAMP_PTH""$CAMPAIGN"/STA/???"$YEARM90""$DAYYM90".CRD
#
rm -f "$CAMP_PTH""$CAMPAIGN"/ORB/???"$YEARM90""$DAYYM90".DCB
rm -f "$CAMP_PTH""$CAMPAIGN"/ORB/???"$YEARM90""$DAYYM90".OSB
rm -f "$CAMP_PTH""$CAMPAIGN"/ORB/???"$YEARM90""$DAYYM90".BIA
#
rm -f "$CAMP_PTH""$CAMPAIGN"/ORB/???"$YEARM30""$DAYYM30".CLK
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/???"$YEARM30""$DAYYM30".CLK
#
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/SMT"$YEARM30""$DAYYM30"???.OUT
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/???"$YEARM30""$DAYYM30".OUT
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/???"$YEARM30""$DAYYM30"_A.OUT
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/???"$YEARM30""$DAYYM30"_.OUT
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/???"$YEARM30""$DAYYM30".SUM
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/???"$YEARM30""$DAYYM30"_.SUM
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/???"$YEARM30""$DAYYM30"_M.SUM
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/"$YEARM8""$DAYYM8"*.*
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/*."$YEARM90"_"$DAYYM90"
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/???"$YEARM90""$DAYYM90".LST
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/???"$YEARM90""$DAYYM90"*.OUT
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/???"$YEARM90""$DAYYM90"*.ERR
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/RX"$DAYYM30"_???.OUT
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/GIM???.OUT
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/RESRMS_GIM"$DAYYM30"_???.OUT
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/SATMRK_"$DAYYM30"_???.OUT
#
rm -f "$CAMP_PTH""$CAMPAIGN"/OUT/RXO"$YEARM30""$SESSM30".SMC
#
rm -f "$CAMP_PTH""$CAMPAIGN"/SOL/"$V_F"S"$YEARM8""$DAYYM8".NQ0
rm -f "$CAMP_PTH""$CAMPAIGN"/SOL/"$V_F"S"$YEARM8""$DAYYM8".NQ0.gz
rm -f "$CAMP_PTH""$CAMPAIGN"/SOL/???"$YEARM30""$DAYYM30".NQ0
rm -f "$CAMP_PTH""$CAMPAIGN"/SOL/???"$YEARM30""$DAYYM30".NQ0.gz
rm -f "$CAMP_PTH""$CAMPAIGN"/SOL/???"$YEARM90""$DAYYM90".NQ0
rm -f "$CAMP_PTH""$CAMPAIGN"/SOL/???"$YEARM90""$DAYYM90".NQ0.gz
#
# Remove BPE PRT/LOG files
# ------------------------
rm -f "$CAMP_PTH""$CAMPAIGN"/BPE/"$TASKID""$YEARM8""$SESSM8"_???_???.???*
#
rm -f "$CAMP_PTH""$CAMPAIGN"/BPE/??"$YEARM30""$SESSM30"_???_???.???*
rm -f "$CAMP_PTH""$CAMPAIGN"/BPE/??"$YEARM90""$SESSM90"_???_???.???*
#
# --------------
# end the script
# --------------
. $X/SCRIPT/END_MENU
seterr
if [ "$TESTING" = "YES" ]
then
    cd "$TEST_START_DIR"
else
    . $X/SCRIPT/DO_TAIL
    seterr
fi
