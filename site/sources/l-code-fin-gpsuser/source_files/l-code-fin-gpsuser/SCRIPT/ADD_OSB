package ADD_OSB;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ADD_OSB
#
# Purpose :  Create concatenated ???yyddd.OSB file on the basis of
#            site-specific .OSB files.
#
# Programs:
#
# PARAMs  :  PARAM1 - Solution identifier
#
# Author  :  S. Schaer
# Created :  21-Jun-2016
#
# Changes :  29-Jun-2016/ss: Create in addition concatenated .BIA file
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ssss, $param1,
      $dirOsb,$extOsb,$dirBia,$extBia) =
    $bpe->getKeys('$YD+0', '$S+0', 'PARAM1',
                  'DIR_OSB','EXT_OSB','DIR_BIA','EXT_BIA');

  $param1 = "S1_" if $param1 eq "";

  $param1 = $$bpe{"V_$param1"} if length($param1) == 1;
  $param1 = $param1."_"        if length($param1) == 2;

  my $osbFil = "${dirOsb}${param1}${yyddd}.${extOsb}";
  unlink($osbFil);
  print "OSBFIL: $osbFil\n";

  my @fil = glob("${dirOsb}????${ssss}_.${extOsb}");
  for (@fil) {
    print "FIL: $_\n";
    if (-s $osbFil) { appFile("",0,$_,$osbFil,0) }
    else            { copy($_,$osbFil) }
  }

  my $biaFil = "${dirBia}${param1}${yyddd}.${extBia}";
  unlink($biaFil);
  print "BIAFIL: $biaFil\n";

  @fil = glob("${dirBia}????${ssss}_.${extBia}");
  for (@fil) {
    print "FIL: $_\n";
    if (-s $biaFil) { appFile("",0,$_,$biaFil,0) }
    else            { copy($_,$biaFil) }
  }

}
