package GOTO_REP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  GOTO_REP
#
# Purpose :  goto PARAM2 in case of reprocessing otherwise goto PARAM3
#
#
# Author  :  R. Dach
# Created :  22-Jul-2008
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($param2, $param3, $camp_pth, $campaign) =
    $bpe->getKeys(
      'PARAM2', 'PARAM3','CAMP_PTH','CAMPAIGN');

  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");


# Write the "next jobs" statement
# -------------------------------
  my $target = $repro ? $param2 : $param3;
  prtGoto($bpe,$target);

}
