use strict;
use warnings;

use lib "$ENV{BPE}";
use bpe_util qw(check_dir appFile copy2archive prtMess);
use lib "$ENV{AUTO}";
use igs_device;

sub run {

  my $bpe = shift;

# Define variables
# ----------------
  my(
    $yyssss,$yyddd,$yy,$yyyy,$ddd,$ssss,$wwwwd,$mm,$dd,$wwww,
    $b,$o,$v,$k,$u,$z,
    $sav,$upd,$loading,
    $crdInf,
    $dirOut,$dirNeq,$dirTrp,$dirErp,$dirIep,$dirPre,
    $extOut,$extNeq,$extTrp,$extErp,$extIep,$extPre,
    $dirStd,$dirEle,$dirCrd,$dirGcc,$dirSmc,$dirSum,
    $extStd,$extEle,$extCrd,$extGcc,$extSmc,$extSum,
    $dirClk,$dirRpr,$dirOsb,$dirClb,$dirGrd,$dirFix,
    $extClk,$extRpr,$extOsb,$extClb,$extGrd,$extFix,
    $dirSnx,$dirTro,$dirEst,$dirObx,
    $extSnx,$extTro,$extEst,$extObx
  ) =
  $bpe->getKeys(
    '$YSS+0','$YD+0','$Y','$Y+0','$+0','$S+0','$WD+0','$M','$D','$W-7',
    'V_B','V_O','V_V','V_K','V_U','V_Z',
    'V_SAV','V_UPD','V_LOADNG',
    'V_CRDINF',
    'DIR_OUT','DIR_NEQ','DIR_TRP','DIR_ERP','DIR_IEP','DIR_PRE',
    'EXT_OUT','EXT_NEQ','EXT_TRP','EXT_ERP','EXT_IEP','EXT_PRE',
    'DIR_STD','DIR_ELE','DIR_CRD','DIR_GCC','DIR_SMC','DIR_SUM',
    'EXT_STD','EXT_ELE','EXT_CRD','EXT_GCC','EXT_SMC','EXT_SUM',
    'DIR_CLK','DIR_RPR','DIR_OSB','DIR_CLB','DIR_GRD','DIR_FIX',
    'EXT_CLK','EXT_RPR','EXT_OSB','EXT_CLB','EXT_GRD','EXT_FIX',
    'DIR_SNX','DIR_TRO','DIR_EST','DIR_OBX',
    'EXT_SNX','EXT_TRO','EXT_EST','EXT_OBX'
  );

# Some definition
# ---------------
  my $tmpSol = 0;
  $tmpSol = 1 if($crdInf =~ /IGSxx/);

# Some directories
# ----------------
  my $dirSav = "${PATH_SAV}${CAMP_SAVIGS}/${yyyy}/";
  if($tmpSol){
    $dirSav = "${PATH_SAV}${CAMP_SAVIGS}_I20/${yyyy}/";
  }
  my $orbSav = "${dirSav}ORB/";
  my $outSav = "${dirSav}OUT/";
  my $atmSav = "${dirSav}ATM/";
  my $solSav = "${dirSav}SOL/";
  my $staSav = "${dirSav}STA/";
  my $grdSav = "${dirSav}GRD/";
  my $wwwPwd = "${PATH_WWW}code/";
  $wwwPwd = "/storage/homefs/l_bernese/www/code/" if $wwwPwd =~ /gpfs/;
  if($tmpSol){
    $wwwPwd = "$dirSav/www/";
  }
  if($sav eq "Y") {
    &check_dir($orbSav,$outSav,$atmSav,$solSav,$staSav,$grdSav);
    &check_dir($wwwPwd);
  }

# Reorder the RNX messages
# ------------------------
  system("perl $ENV{AUTO}/get_warn.pl ${dirOut}RNX${yyssss}.ERR ${dirOut}RNX${yyssss}.ERR");

# Create merged protocol file
# ---------------------------
  my $prtFil = "${dirOut}IGSFIN1D.${yy}_${ddd}";
  unlink($prtFil);

  my @prcLst = (
    "${dirOut}F1D${yyddd}.PRC 1",
    "${dirOut}RNX${yyssss}.ERR 0",
    "${dirSmc}RXO${yyssss}.${extSmc} 1",
    "${dirOut}CODXTR.${yy}_${ssss} 1",
    "${dirOut}MPRXTR.${yy}_${ssss} 1",
    "${dirOut}RESRMS.${yy}_${ssss} 1",
    "${dirOut}OBX_MPR_${yyddd}.${extOut} 1",
    "${dirSum}OBX_MPR_${yyddd}.${extSum} 1",
    "${dirOut}OBX_EDT_${yyddd}.${extOut} 1",
    "${dirSum}OBX_EDT_${yyddd}.${extSum} 1",
    "${dirSum}AMB${yyssss}.${extSum} 1",
    "${dirOut}OBX_AMB_${yyddd}.${extOut} 1",
    "${dirOut}${k}_${yyddd}.LST 1",
    "${dirSum}${k}_${wwwwd}.${extSum} 1",
    "${dirOut}${k}_${wwwwd}.${extOut} 1",
    "${dirOut}${k}_${wwwwd}.CMP 0",  # CONT_ERR
  );

  foreach(@prcLst) {
    &appFile("",2,(split)[0],$prtFil,(split)[1]);
  }

  print "\nProtocol file created: $prtFil\n\n";

# Create short protocol file
# --------------------------
  my $prtFilshort = "${dirOut}IGSFIN1D_SHORT.TXT";
  system("perl $ENV{AUTO}/typ_f1d.pl -q ${ddd} > $prtFilshort");
  my $rnxFil="${dirOut}RXO${yyssss}.SMC";

# Copy files to savedisk
# ----------------------
# Mandatory files
  my @cpyLst = (
# Protocol
    "${prtFil}                          ${outSav} _ ",
    "${prtFil}                          ${wwwPwd}igsfin1d.txt _ ",
    "${prtFilshort}                     ${wwwPwd}igsfin1d_short.txt _ ",
    "${rnxFil}                          ${wwwPwd}igsfin1d_rnx.txt _ ",

# A priori files
    "${dirClk}${o}_${yyddd}.${extClk}   ${orbSav} _ ",
    "${dirOsb}APR${yyddd}.${extOsb}     ${orbSav} _ ",

# Intermediate solutions
    "${dirEle}${z}_${yyddd}.${extEle}   ${orbSav} _ ",
    "${dirEle}${u}_${yyddd}.${extEle}   ${orbSav} _ ",

# OSB solution
    "${dirNeq}${b}_${yyddd}.${extNeq}   ${solSav} z ",
    "${dirOsb}${b}_${yyddd}.${extOsb}   ${orbSav} _ ",

# A priori orbits for NEQ files
    "${dirStd}${v}_${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirRpr}${v}_${yyddd}.${extRpr}   ${orbSav} _ ",

# Cluster assignment files
    "${dirClb}${yyddd}_??.${extClb}     ${staSav} _ ",

# Normal equations
    "${dirNeq}${k}N${yyddd}.${extNeq}   ${solSav} z ",
    "${dirNeq}${k}_${yyddd}.${extNeq}   ${solSav} z ",

# Final solution
    "${dirFix}${k}_${yyddd}.${extFix}   ${staSav} _ ",
    "${dirGcc}${k}_${yyddd}.${extGcc}   ${orbSav} _ ",
    "${dirCrd}${k}_${yyddd}.${extCrd}   ${staSav} _ ",
    "${dirTrp}${k}_${yyddd}.${extTrp}   ${atmSav} _ ",
##    "${dirTro}${k}_${yyddd}.${extTro}   ${atmSav} c ", # no TROTRO
    "${dirErp}${k}_${yyddd}.${extErp}   ${orbSav} _ ",
    "${dirIep}${k}_${yyddd}.${extIep}   ${orbSav} _ ",
    "${dirEle}${k}_${yyddd}.${extEle}   ${orbSav} _ ",
    "${dirStd}${k}_${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirObx}${k}_${yyddd}.${extObx}   ${orbSav} _ ",
    "${dirPre}${k}_${yyddd}.${extPre}   ${orbSav} _ ",
    "${dirSnx}${k}_${yyddd}.${extSnx}   ${solSav} c ",
    "${dirTro}${k}N${yyddd}.${extTro}   ${atmSav}${k}_${yyddd}.${extTro} c ",

# Solution with subdaily ERPs
    "${dirCrd}${k}H${yyddd}.${extCrd}   ${staSav} _ ",
    "${dirTrp}${k}H${yyddd}.${extTrp}   ${atmSav} _ ",
    "${dirTro}${k}H${yyddd}.${extTro}   ${atmSav} c ",
    "${dirErp}${k}H${yyddd}.${extErp}   ${orbSav} _ ",
    "${dirIep}${k}H${yyddd}.${extIep}   ${orbSav} _ ",
    "${dirEle}${k}H${yyddd}.${extEle}   ${orbSav} _ ",
    "${dirStd}${k}H${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirPre}${k}H${yyddd}.${extPre}   ${orbSav} _ ",

# Solution with GNSS specific parameters (ISTPs only)
    "${dirCrd}${k}T${yyddd}.${extCrd}   ${staSav} _ ",
    "${dirTrp}${k}T${yyddd}.${extTrp}   ${atmSav} _ ",
    "${dirTro}${k}T${yyddd}.${extTro}   ${atmSav} c ",
    "${dirErp}${k}T${yyddd}.${extErp}   ${orbSav} _ ",
    "${dirIep}${k}T${yyddd}.${extIep}   ${orbSav} _ ",
    "${dirEle}${k}T${yyddd}.${extEle}   ${orbSav} _ ",
    "${dirStd}${k}T${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirPre}${k}T${yyddd}.${extPre}   ${orbSav} _ ",
    "${dirEst}${k}T${yyddd}.${extEst}   ${solSav} _ ",
    "${dirOut}${k}T${yyddd}.TRA         ${outSav} o ",

# Solution with GNSS specific parameters (ISTPs, ERPs, GCCs)
    "${dirCrd}${k}I${yyddd}.${extCrd}   ${staSav} _ ",
    "${dirTrp}${k}I${yyddd}.${extTrp}   ${atmSav} _ ",
    "${dirTro}${k}I${yyddd}.${extTro}   ${atmSav} c ",
    "${dirEle}${k}I${yyddd}.${extEle}   ${orbSav} _ ",
    "${dirStd}${k}I${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirPre}${k}I${yyddd}.${extPre}   ${orbSav} _ ",
    "${dirEst}${k}I${yyddd}.${extEst}   ${solSav} _ ",
    "${dirOut}${k}I${yyddd}.${extOut}   ${outSav} c ",
    "${dirOut}${k}I${yyddd}.TRA         ${outSav} o ",

# Other files
    "${dirOut}V1__${wwww}.LST           ${outSav} _ ",
    "${dirOut}V1__${wwww}.LIS           ${outSav} _ ",
    "${dirOut}SDB${yyssss}.LST          ${outSav} _ ",
    "${dirOut}REPOSITIONING.LST         ${outSav} _ ",
  );

  if($sav eq "Y") {
    my(@err) = ();
    foreach(@cpyLst) {
      if($crdInf =~ /IGS20/){
        my @chunk = split(" ",$_);
        print "Check: $_\n@chunk\n";
        if($chunk[0] =~ /V1__....\.L../){
          print "Skip if $chunk[0] does not exists: ".
                (-e $chunk[0])."\n";
          next unless -e $chunk[0];
        }
      }
      push(@err,"$_\n") if(&copy2archive(split(" ",$_)));
    }
    die "\n *** copy2archive failed for\n @err\n" if(@err);
  }

# Optional files
  @cpyLst = (
    "${dirGrd}VMF${yyddd}.${extGrd}     ${grdSav} _ ",
  );
  if ( $loading eq "VAPL" ) {
    push(@cpyLst,"${dirGrd}APL${yyddd}.${extGrd}     ${grdSav} _ ");
  } elsif ( $loading eq "GFZ" ) {
    push(@cpyLst,"${dirGrd}NTAL_${yyddd}.${extGrd}     ${grdSav} _ ");
    push(@cpyLst,"${dirGrd}NTOL_${yyddd}.${extGrd}     ${grdSav} _ ");
    push(@cpyLst,"${dirGrd}HYDL_${yyddd}.${extGrd}     ${grdSav} _ ");
  }

  if($sav eq "Y") {
    my(@err) = ();
    foreach(@cpyLst) {
      push(@err,"$_\n") if(&copy2archive(split(" ",$_)));
    }
    print "\n ### copy2archive failed for\n @err\n" if(@err);
  }

# Save GPS broadcast OSBs
# -----------------------
##  my $src = "${dirOsb}${o}_${yyddd}.${extOsb}";
##  my $trg = "$ENV{REF}/P1P2_GPS.${extOsb}";
##  if ($upd eq "Y") {
##      copy2archive($src,"${trg}_TMP") or die "Cannot copy $src to ${trg}_TMP\n";
##      move("${trg}_TMP",$trg) or die "Cannot copy ${trg}_TMP to $src\n";
##  }
##
##  if ($sav eq "Y" && $dd == 1) {
##      copy2archive($src,"${orbSav}P1P2${yy}${mm}_GPS.${extOsb}") or
##          die "Cannot copy $src to ${orbSav}P1P2${yy}${mm}_GPS.${extOsb}\n";
##  }

# Save W1_yyddd.DCB
# -----------------
  my $osbFil = "${dirOsb}${b}_${yyddd}.${extOsb}";
  my $dcbFil = "${orbSav}${b}_${yyddd}.DCB";
  if ($sav eq "Y") {
    system("$ENV{AUTO}/osb2dcb.com $osbFil $dcbFil P1-C1");
    die "$dcbFil not created" unless -s $dcbFil;
  }

# Some messages
# -------------
  if($sav ne "Y") {
    &prtMess($bpe,"FILES NOT SAVED");
    print       "\nFILES NOT SAVED\n";
  }
##  &prtMess($bpe,"FILES NOT UPDATED") if($upd ne "Y");

}

# ============================================================================

__END__
