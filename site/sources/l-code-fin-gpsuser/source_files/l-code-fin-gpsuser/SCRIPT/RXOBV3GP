package RXOBV3GP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name:      RXOBV3GP
#
# Purpose:   A priori script to prepare parallel running of RXOBV3
#            (use RNXGRA to find a list of the best stations)
#
# Programs:  RNXGRA
#
# Author  :  R. Dach
# Created :  17-Nov-2005               
#
# Changes :  19-May-2009 rd: Session dependent parallelization filenames
#            11-Oct-2016 as/av: merge with l_code_rap script 
#            23-Mar-2017 rd: consider V_GNSS
#            
# ----------------------------------------------------------------------------

use strict;
use lib "$ENV{BPE}";
use bpe_util;


sub run
{
  my $bpe = shift;

# Get variables
# -------------
  my ( $yyssss, $yyddd, $ssss, $ddd,
       $param1, $param2, $numFil, $numClu, $dirBpe, $dirTmp, $gnss, 
       $dirOut, $dirSmt, $dirCzh, $dirPzh, $dirCzo, $dirPzo,
       $extOut, $extSmt, $extCzh, $extPzh, $extCzo, $extPzo ) =
  $bpe->getKeys
     ( '$YSS+0' ,'$YD+0'  ,'$S+0'   ,'$+0',
       'PARAM1' ,'PARAM2' ,'V_CLU'  ,'V_NCLU' ,'DIR_BPEPRT', 'T', 'V_GNSS', 
       'DIR_OUT','DIR_SMT','DIR_CZH','DIR_PZH','DIR_CZO','DIR_PZO',
       'EXT_OUT','EXT_SMT','EXT_CZH','EXT_PZH','EXT_CZO','EXT_PZO' );


  $numFil = $param2 if ($param2 ne "");


# Select GNSS, if desired
# -----------------------
  &setGNSS($bpe,"$ENV{U}/PAN/RNXGRA.INP","USE_",$gnss);


# Use RNXGRA to detect the best RINEX obs files
# ---------------------------------------------
  my $PGMNAM = "RNXGRA";
  $bpe->RUN_PGMS($PGMNAM);


# Get the name of the SUMMARY file of RNXGRA
# ------------------------------------------
  my $sum = $bpe->getKey("$ENV{U}/INP/RNXGRA.INP","SUMMARY");


# Check for warnings in LOGfile
# -----------------------------
  getWarn($bpe,$sum);


# Add the list of bad stations to the summary file
# ------------------------------------------------
  my $del = $bpe->getKey("$ENV{U}/INP/RNXGRA.INP","DELFILE");
  appFile("Files excluded from processing:",0,$del,$sum,0);
  unlink ($del);


# Get the file name with the list of good RINEX files
# ---------------------------------------------------
  my $lst = $bpe->getKey("$ENV{U}/INP/RNXGRA.INP","LSTFILE");

  my @rxoFil = ();
  open (LST,"< $lst");
  while (<LST>) { chomp(); push @rxoFil,$_ }
  close (LST);

  unlink ($lst);


# Define directories and file names
# ---------------------------------
  my $bpeFil = "${dirBpe}OBS${ssss}";
  unlink(glob("${bpeFil}???.BPE"));


# Delete old files (CZH, PZH, CZO, PZO)
# -------------------------------------
  unlink glob("${dirCzh}????${ssss}.${extCzh}");
  unlink glob("${dirPzh}????${ssss}.${extPzh}");
  unlink glob("${dirCzo}????${ssss}.${extCzo}");
  unlink glob("${dirPzo}????${ssss}.${extPzo}");


# Initialize parallel run
# -----------------------
  $numClu = 14 unless $numClu;
  $numFil = 20 unless $numFil;
  my $minClu = 0;

  initPar_Cl($bpe,$bpeFil,@rxoFil,$numClu,$numFil,$minClu);

}
