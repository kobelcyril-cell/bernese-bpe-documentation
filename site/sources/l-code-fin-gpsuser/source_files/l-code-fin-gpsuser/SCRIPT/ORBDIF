package ORBDIF;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ORBDIF
#
# Purpose :  Execute ORBGEN and STDDIF for determination of time and velocity
#            change of satellite repositionings
#
# Programs:  ORBGEN, STDDIF
#
# Author  :  S. Schaer
# Created :  15-Dec-2003               Last modified: 08-Feb-2005
#
# Changes :  09-Jan-2004/ss: Second call of STDDIF
#            09-Dec-2004/ss: Handle case with two repositionings
#            08-Feb-2005/mm: Remove old date variables
#            28-Feb-2013/ss: Use special SAT info file
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use File::Copy;

sub run {
  my $bpe = shift;

# Define variables
# ----------------
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};

  my ($preDir,$erpDir,$outDir) = $bpe->getKeys("DIR_PRE","DIR_ERP","DIR_OUT");

# Run programs
# ------------
##  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","SATELL","SAT_1452.I08_R26");

  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);

##  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","SATELL","SAT_1452.I08_R26");

  $PGMNAM = "STDDIF";
  $bpe->RUN_PGMS($PGMNAM);

  my $SYSOUT = $$bpe{SYSOUT};
  system("grep Maneuver $SYSOUT >> ${outDir}REPOSITIONING.LST");

  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDORB",'$Z_$YD-1');
  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDOR1",'PM_$YD+0');
  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STADAT",'$YMD_STR-1');
  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","ENDDAT",'$YMD_STR-1');

  $PGMNAM = "STDDIF";
  $bpe->RUN_PGMS($PGMNAM);

  $SYSOUT = $$bpe{SYSOUT};
  system("grep Maneuver $SYSOUT >> ${outDir}REPOSITIONING.LST");

  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDORB",'$Z_$YD+0');
  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDOR1",'$Z_$YD+0');
  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STADAT",'$YMD_STR+0');
  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","ENDDAT",'$YMD_STR+0');

  $PGMNAM = "STDDIF";
  $bpe->RUN_PGMS($PGMNAM);

  $SYSOUT = $$bpe{SYSOUT};
  system("grep Maneuver $SYSOUT >> ${outDir}REPOSITIONING.LST");

  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDORB",'$Z_$YD-1');
  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STDOR1",'$Z_$YD-1');
  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","STADAT",'$YMD_STR-1');
  $bpe->putKey("$ENV{U}/PAN/STDDIF.INP","ENDDAT",'$YMD_STR-1');

  $PGMNAM = "STDDIF";
  $bpe->RUN_PGMS($PGMNAM);

  $SYSOUT = $$bpe{SYSOUT};
  system("grep Maneuver $SYSOUT >> ${outDir}REPOSITIONING.LST");

}
