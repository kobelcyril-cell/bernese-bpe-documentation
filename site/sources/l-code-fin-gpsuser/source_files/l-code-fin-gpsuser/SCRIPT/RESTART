package RESTART;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RESTART
#
# Purpose :  Restart BPE process in case of bad observation data.
#
# PARAMs  :  PARAM2 - goto PID
#
# Author  :  S. Schaer
#
# Created :  26-Oct-2016
#
# Changes :  08-Nov-2016/av: Skip msg2key in repro mode
#            30-Jul-2019/ss: Changed key from NEW to MSC
#
# ============================================================================

use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,$ssss,$yy,
    $param2,$param3,$param4,
    $pcfFil,$startcount,$repro,
    $dirOut,$extOut,$dirRxo,$extRxo,$dirCzh,$extCzh,
  ) =
  $bpe->getKeys(
    '$YD+0','$S+0','$Y',
    'PARAM2','PARAM3','PARAM4',
    'PCFFIL','STARTCOUNT','V_REPRO',
    'DIR_OUT','EXT_OUT','DIR_RXO','EXT_RXO','DIR_CZH','EXT_CZH',
  );

  $pcfFil = (split('\.',$pcfFil))[0];

  my $bad = 0;
  my @bad = ();

# Ignore/remove observation files indicated as bad
# ------------------------------------------------
  my $badFil = "${dirOut}../MSC/BAD${yyddd}.FLG";
  if (-s $badFil) {
    my @lin = `cat $badFil`;
    chomp(@lin);
    @lin = sort(@lin);
    foreach (@lin) {
      my $sta = substr((split(" ",$_))[0],0,4);
      my $rxoFil = "${dirRxo}${sta}${ssss}.${extRxo}";
      my $czhFil = "${dirCzh}${sta}${ssss}.${extCzh}";
      if (-s $rxoFil || -s $czhFil) {
        if (lindex($sta,@bad) == -1) {
          prtMess($bpe,"BAD OBSERVATION DATA FOUND: ${sta}${ssss}");
          print        "BAD OBSERVATION DATA FOUND: ${sta}${ssss}\n";
          push(@bad,$sta);
          $bad++;
        }
      }
    }
  }

##  if ($bad > 0) {
  if ($bad > 0 && $startcount <= 2) {
    my $str = join(" ",sort(@bad));
    msg2key("MSC","$pcfFil ${yyddd}0 RESTART($startcount): Bad observation data found: $str") unless $repro;
    prtMess($bpe,"BAD OBSERVATION DATA FOUND AND RESTARTED");
    prtGoto($bpe,$param2);
  } else {
    prtMess($bpe,"NO BAD OBSERVATION DATA FOUND");
  }

}
