package FPPP_SAV;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  FPPP_SAV
#
# Purpose :  Save result files for PPPFIN.PCF
#
# PARAMs  :  
#
# Author  :  R. Dach
# Created :  10-Jun-2013
#
# Changes :  24-May-2016 AV: OSB implementation
#            21-Aug-2017 SS: WLB/WLI/NLB/NLI stuff
#            02-Nov-2017 SS: Activated WLB/WLI/NLB/NLI delection
#            06-Nov-2019 MK: add Galileo
#            25-Jan-2021 RD: Add OBSXTR selection
#            08-Jul-2024 ML: Added SATMRK_????????.OUT (due to Lnn-errors)
#
# ============================================================================
use strict;
use lib "$ENV{AUTO}";
use gpsutil qw(copyfile);
use igs_device;
use lib "$ENV{BPE}";
use bpe_util qw(check_dir copy2archive prtMess);


sub run {
  my $bpe = shift;



# Get variables
# -------------
 my   ( $yyyym05, $yyyym10,$yyyym30, $ssssm02, $ssssm05, $ssssm10, $ssssm30,
      $yydddm05, $yyssssm05, $yyssssm10, $yyssssm30, $yyssssm90,
      $a, $b, $c, $f, $h, $i, $k, $l, $o, $n, $del,
      $dirRes, $dirEdt, $dirStd, $dirErp, $dirGrd, $dirIon,
      $extRes, $extEdt, $extStd, $extErp, $extGrd, $extIon,
      $dirSmt, $dirRxo, $dirFix, $dirClk, $dirRxc,
      $extSmt, $extRxo, $extFix, $extClk, $extRxc,
      $dirNeq, $dirCrd, $dirTrp, $dirOsb, $dirOut, $dirSum, $dirLst,
      $extNeq, $extCrd, $extTrp, $extOsb, $extOut, $extSum, $extLst,
      $dirPzh, $dirPzo, $dirCzh, $dirCzo,
      $extPzh, $extPzo, $extCzh, $extCzo
      ) =
    $bpe->getKeys(
      '$Y-5','$Y-(10)','$Y-(30)','$S-2','$S-5','$S-(10)','$S-(30)',
      '$YD-5','$YSS-5','$YSS-(10)','$YSS-(30)','$YSS-(90)',
      'V_A', 'V_B', 'V_C', 'V_F', 'V_H','V_I', 'V_K', 'V_L', 'V_O', 'V_N', 'V_DEL',
      'DIR_RES','DIR_EDT','DIR_STD','DIR_ERP','DIR_GRD','DIR_ION',
      'EXT_RES','EXT_EDT','EXT_STD','EXT_ERP','EXT_GRD','EXT_ION',
      'DIR_SMT','DIR_RXO','DIR_FIX','DIR_CLK','DIR_RXC',
      'EXT_SMT','EXT_RXO','EXT_FIX','EXT_CLK','EXT_RXC',
      'DIR_NEQ','DIR_CRD','DIR_TRP','DIR_OSB','DIR_OUT','DIR_SUM','DIR_LST',
      'EXT_NEQ','EXT_CRD','EXT_TRP','EXT_OSB','EXT_OUT','EXT_SUM','EXT_LST',
      'DIR_PZH','DIR_PZO','DIR_CZH','DIR_CZO',
      'EXT_PZH','EXT_PZO','EXT_CZH','EXT_CZO'
      );

      my $yym30 = substr($yyyym30,2,2);
      my $yym10 = substr($yyyym10,2,2);
      my $yym05 = substr($yyyym05,2,2);

# Delete Files if requested
# -------------------------
    if ( ${del} ne "Y" ) {
      prtMess($bpe,"FILES NOT DELETED");

# Delete Files from Previous Run
# ------------------------------
    } else {
        unlink glob "$dirOut*.J_lk";

# Clean ATM directory:
        unlink glob "${dirIon}HOI${yydddm05}.${extIon}";
        unlink glob "${dirTrp}${c}${yyssssm30}.${extTrp}";
        unlink glob "${dirTrp}${i}${yyssssm30}.${extTrp}";
        unlink glob "${dirTrp}${k}${yyssssm30}.${extTrp}";
        unlink glob "${dirTrp}${l}${yyssssm30}.${extTrp}";
        unlink glob "${dirTrp}${o}${yyssssm30}.${extTrp}";
        unlink glob "${dirTrp}${c}${ssssm10}????.${extTrp}";
        unlink glob "${dirTrp}${i}${ssssm10}????.${extTrp}";
        unlink glob "${dirTrp}${k}${ssssm10}????.${extTrp}";
        unlink glob "${dirTrp}${l}${ssssm10}????.${extTrp}";
        unlink glob "${dirTrp}${o}${ssssm10}????.${extTrp}";

# Clean GRD directory:
        unlink glob "${dirGrd}VMF${yydddm05}.${extGrd}";

# Clean OBS directory:
        unlink glob "${dirPzh}????${ssssm02}.${extPzh}";
        unlink glob "${dirPzo}????${ssssm02}.${extPzo}";
        unlink glob "${dirCzh}????${ssssm02}.${extCzh}";
        unlink glob "${dirCzo}????${ssssm02}.${extCzo}";

# Clean OBS1 directory:
        unlink glob "${dirPzh}../OBS1/????${ssssm10}.${extPzh}";
        unlink glob "${dirPzo}../OBS1/????${ssssm10}.${extPzo}";
        unlink glob "${dirCzh}../OBS1/????${ssssm10}.${extCzh}";
        unlink glob "${dirCzo}../OBS1/????${ssssm10}.${extCzo}";

# Clean ORB directory:
        unlink glob "${dirErp}RAP_${yyyym05}.${extErp}";
        unlink glob "${dirErp}C04_${yyyym05}.${extErp}";
        unlink glob "${dirOsb}${h}${yyssssm30}.${extOsb}";
        unlink glob "${dirOsb}ED?${ssssm10}????.${extOsb}";
        unlink glob "${dirErp}${b}${yyssssm05}.${extErp}";
        unlink glob "${dirStd}${b}${yyssssm05}.${extStd}";
        unlink glob "${dirClk}${b}${yyssssm05}.${extClk}";
        unlink glob "${dirOsb}[WN]L?${yyssssm30}.${extOsb}";

# Clean OUT directory:
        unlink glob "${dirOut}PPP${yyssssm30}.PRC";
        unlink glob "${dirOut}STA${yyssssm30}.PRC";
##        unlink glob "${dirOut}IAR${yyssssm30}.PRC";
        unlink glob "${dirOut}PPP_CLK.${yym30}_${ssssm30}";
        unlink glob "${dirRxc}${b}${yyssssm05}.${extRxc}";
        unlink glob "${dirOut}CD${yyssssm05}??.${extOut}";
        unlink glob "${dirOut}MP${yyssssm05}??.${extOut}";
        unlink glob "${dirOut}RXO${yyssssm05}??.${extOut}";
        unlink glob "${dirOut}SMT${yyssssm05}??.${extOut}";
        unlink glob "${dirOut}CHK${yyssssm05}.${extOut}";
        unlink glob "${dirSum}CHK${yyssssm05}.${extSum}";
        unlink glob "${dirSum}MPR${yyssssm05}.${extSum}";
        unlink glob "${dirOut}RNX${yyssssm05}.ERR";
        unlink glob "${dirOut}MRG${yyssssm05}.${extOut}";
        unlink glob "${dirOut}MRG${i}${yyssssm05}.${extOut}";
        unlink glob "${dirOut}MRG${k}${yyssssm05}.${extOut}";
        unlink glob "${dirOut}MRG${l}${yyssssm05}.${extOut}";
        unlink glob "${dirOut}MRG${o}${yyssssm05}.${extOut}";
        unlink glob "${dirOut}SPP${yyssssm05}.${extOut}";
        unlink glob "${dirSum}TMP${yyssssm05}.${extSum}";
        unlink glob "${dirOut}XTR${yyssssm05}.${extOut}";
        unlink glob "${dirOut}KIX${ssssm05}????.${extOut}";
        unlink glob "${dirOut}RNXERR.${yym10}_${ssssm10}";
        unlink glob "${dirOut}CODXTR.${yym10}_${ssssm10}";
        unlink glob "${dirOut}GPSCMP.${yym05}_${ssssm05}";
        unlink glob "${dirOut}GPSWKS.${yym05}_${ssssm05}";
        unlink glob "${dirOut}GPSXTR.${yym05}_${ssssm05}";
        unlink glob "${dirOut}MPRXTR.${yym10}_${ssssm10}";
        unlink glob "${dirSum}EDF${yyssssm05}.${extSum}";
        unlink glob "${dirOut}EDF${ssssm02}????.${extOut}";
        unlink glob "${dirRes}EDF${ssssm10}????.${extRes}";
        unlink glob "${dirSum}EDL${yyssssm05}.${extSum}";
        unlink glob "${dirOut}EDL${ssssm10}????.${extOut}";
        unlink glob "${dirRes}EDL${ssssm10}????.${extRes}";
        unlink glob "${dirOut}MRK${ssssm02}????.${extOut}";
        unlink glob "${dirOut}RES${ssssm02}????.${extOut}";
        unlink glob "${dirEdt}RES${ssssm02}????.${extEdt}";
        unlink glob "${dirSum}RES${yyssssm05}.${extSum}";
        unlink glob "${dirOut}RES${yyssssm05}.PRC";
        unlink glob "${dirSum}WRN${ssssm10}????.${extSum}";
        unlink glob "${dirOut}OBS???_${yyssssm05}.${extOut}";
        unlink glob "${dirSum}OBS???_${yyssssm05}.${extSum}";
        unlink glob "${dirOut}${c}${yyssssm30}.${extOut}";
        unlink glob "${dirSum}${c}${yyssssm30}.${extSum}";
        unlink glob "${dirSum}${f}${yyssssm30}.${extSum}";
        unlink glob "${dirOut}${f}${yyssssm30}.${extOut}";
        unlink glob "${dirOut}${f}${ssssm10}????.${extOut}";
        unlink glob "${dirOut}${h}${yyssssm30}.${extOut}";
        unlink glob "${dirSum}${h}${yyssssm30}.${extSum}";
        unlink glob "${dirSum}${i}${yyssssm30}.${extSum}";
        unlink glob "${dirOut}${i}${yyssssm30}.${extOut}";
        unlink glob "${dirOut}${i}${ssssm10}????.${extOut}";
        unlink glob "${dirSum}${k}${yyssssm30}.${extSum}";
        unlink glob "${dirOut}${k}${yyssssm30}.${extOut}";
        unlink glob "${dirOut}${k}${ssssm10}????.${extOut}";
        unlink glob "${dirSum}${l}${yyssssm30}.${extSum}";
        unlink glob "${dirOut}${l}${yyssssm30}.${extOut}";
        unlink glob "${dirOut}${l}${ssssm10}????.${extOut}";
        unlink glob "${dirSum}${o}${yyssssm30}.${extSum}";
        unlink glob "${dirOut}${o}${yyssssm30}.${extOut}";
        unlink glob "${dirOut}${o}${ssssm10}????.${extOut}";
        unlink glob "${dirSum}${n}${ssssm10}????.${extSum}";
        unlink glob "${dirOut}${n}${ssssm10}????.${extOut}";
        unlink glob "${dirRxc}${c}${ssssm05}????.${extRxc}";
        unlink glob "${dirOut}????${ssssm30}_???.${extOut}";
        unlink glob "${dirOut}SATMRK_????????.${extOut}";

       # unlink glob "${dirOut}${i}${ssssm10}????.${extOut}";

# Clean RAW directory:
        unlink glob "${dirRxo}*${ssssm02}.RXO";
        unlink glob "${dirRxo}????${ssssm02}.${extRxo}";
        unlink glob "${dirSmt}*${ssssm02}.${extSmt}";

# Clean SOL directory:
        unlink glob "${dirNeq}${f}${yyssssm90}.${extNeq}";
        unlink glob "${dirNeq}${h}${yyssssm90}.${extNeq}";
        unlink glob "${dirNeq}${i}${yyssssm90}.${extNeq}";
        unlink glob "${dirNeq}${k}${yyssssm90}.${extNeq}";
        unlink glob "${dirNeq}${l}${yyssssm90}.${extNeq}";
        unlink glob "${dirNeq}${o}${yyssssm90}.${extNeq}";
        unlink glob "${dirNeq}${c}${ssssm10}????.${extNeq}";
        unlink glob "${dirNeq}${f}${ssssm10}????.${extNeq}";
        unlink glob "${dirNeq}${i}${ssssm10}????.${extNeq}";
        unlink glob "${dirNeq}${k}${ssssm10}????.${extNeq}";
        unlink glob "${dirNeq}${l}${ssssm10}????.${extNeq}";
        unlink glob "${dirNeq}${o}${ssssm10}????.${extNeq}";

# Clean STA directory:
        unlink glob "${dirLst}FIL???${yyssssm05}.${extLst}";
        unlink glob "${dirCrd}${a}${yyssssm30}.${extCrd}";
        unlink glob "${dirCrd}${c}${yyssssm30}.${extCrd}";
        unlink glob "${dirCrd}${i}${yyssssm30}.${extCrd}";
        unlink glob "${dirCrd}${k}${yyssssm30}.${extCrd}";
        unlink glob "${dirCrd}${l}${yyssssm30}.${extCrd}";
        unlink glob "${dirCrd}${o}${yyssssm30}.${extCrd}";
        unlink glob "${dirCrd}${c}${ssssm10}????.${extCrd}";
        unlink glob "${dirCrd}${i}${ssssm10}????.${extCrd}";
        unlink glob "${dirCrd}${k}${ssssm10}????.${extCrd}";
        unlink glob "${dirCrd}${l}${ssssm10}????.${extCrd}";
        unlink glob "${dirCrd}${o}${ssssm10}????.${extCrd}";
        unlink glob "${dirFix}REF${yyssssm05}.${extFix}";

# Remove also old plots:
        my $pltDir = "${PATH_WWW}${CAMP_SAVPPP}/";
        unlink glob  "${pltDir}????/KIN_????_${yyssssm10}.eps";
        unlink glob  "${pltDir}????/KIN_????_${yyssssm10}.png";
        unlink glob  "${pltDir}????/KIN_????_${yyssssm10}_0.eps";
        unlink glob  "${pltDir}????/KIN_????_${yyssssm10}_0.png";

    }
}

