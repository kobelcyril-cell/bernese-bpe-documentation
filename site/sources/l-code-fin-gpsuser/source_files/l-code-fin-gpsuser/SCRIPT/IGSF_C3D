use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my( $crdInf, $psdInf, $v_k, $v_o,
      $dirOut, $dirPsd, $dirCrd, $dirNeq, $dirStd, $dirRpr, $dirFix, $dirClk, $dirErp,
               $extPsd, $extCrd, $extNeq, $extStd, $extRpr, $extFix, $extClk, $extErp,
      $pthSkl
  ) =
  $bpe->getKeys(
    'V_CRDINF', 'V_PSDINF', 'V_K', 'V_O',
    'DIR_OUT', 'DIR_PSD', 'DIR_CRD', 'DIR_NEQ', 'DIR_STD', 'DIR_RPR', 'DIR_FIX', 'DIR_CLK', 'DIR_ERP',
               'EXT_PSD', 'EXT_CRD', 'EXT_NEQ', 'EXT_STD', 'EXT_RPR', 'EXT_FIX', 'EXT_CLK', 'EXT_ERP',
    'PTH_SINEXIN'
  );


# Prepare reference files
# -----------------------
  my $psdFil = $psdInf eq ""? "":"${psdInf}.${extPsd}";
  system("$ENV{AUTO}/copyRef.pl ${dirOut}.. $crdInf $psdFil");

  print "Execute $ENV{AUTO}/copySkl.pl IGSFIN3D $pthSkl\n";
  system("$ENV{AUTO}/copySkl.pl IGSFIN3D $pthSkl");

# Remove lock files
# -----------------
  my @lock = glob "$dirOut/*.J_lk";
  unlink(@lock);

# Coplete NEQ-files from SAVEDISK if needed
# -----------------------------------------
  my $copyFrom = "$PATH_SAV/$CAMP_SAVIGS";
  copyfile3($bpe,"$copyFrom","F1_",$extCrd,$dirCrd);
  copyfile3($bpe,"$copyFrom","I1_",$extRpr,$dirRpr);
  copyfile3($bpe,"$copyFrom","I1_",$extStd,$dirStd);
  copyfile3($bpe,"$copyFrom","${v_k}_","${extNeq}.gz",$dirNeq);
  copyfile3($bpe,"$copyFrom","${v_k}N","${extNeq}.gz",$dirNeq);
  copyfile3($bpe,"$copyFrom","${v_o}_","$extClk",$dirClk);

  copyfile1($bpe,"$copyFrom","F1_",$extFix,$dirFix,'+0');

  copyfile1($bpe,"$copyFrom","F3_",$extStd,$dirStd,'-1');
  copyfile1($bpe,"$copyFrom","F3_",$extErp,$dirErp,'-1');

}
# ==============================================================================



# copy +/-  1 day files for 3-day solution
# ----------------------------------------

sub copyfile3 {
  use File::Basename;

  my $bpe      = $_[0];  # BPE environment
  my $copyFrom = $_[1];  # Directory where to copy from
  my $filTyp = $_[2];  # 3-character file type, e.g. Q1_
  my $extTyp = $_[3];  # file extension
  my $dir    = $_[4];  # directory where to copy

  my( $yyddd, $yydddm1, $yydddp1, $yyyy, $yyyym1, $yyyyp1  ) =
  $bpe->getKeys(
    '$YD+0','$YD-1','$YD+1','$Y+0','$Y-1','$Y+1');

  my $subDir=substr($dir,-4);

  my @inpLst = ( "$copyFrom/$yyyym1/$subDir/$filTyp$yydddm1.$extTyp",
                 "$copyFrom/$yyyy/$subDir/$filTyp$yyddd.$extTyp",
                 "$copyFrom/$yyyyp1/$subDir/$filTyp$yydddp1.$extTyp" );
  foreach my $input ( @inpLst ) {
    my $inpFil = basename($input);
    $inpFil =~ s/\.gz$//;
    $inpFil =~ s/\.Z$//;
     
    next if -s "${dir}/$inpFil";

    print "Copying $input to $dir\n";
    copyfile("$input" ,"$dir");


    # uncompress gzip files
    if (substr($extTyp,-2) eq "gz") {
      print "GUNZIP $dir/${inpFil}.gz\n";
      uncompress("-z gunzip","$dir/${inpFil}.gz");
    }

    # uncompress Z files
    if (substr($extTyp,-1) eq "Z") {
      print "GUNCOMPRESS $dir/${inpFil}.Z\n";
      uncompress("$dir/${inpFil}.Z");
    }
  }
}


# copy +/-  1 day files for 3-day solution
# ----------------------------------------

sub copyfile1 {
  use File::Basename;

  my $bpe      = $_[0];  # BPE environment
  my $copyFrom = $_[1];  # Directory where to copy from
  my $filTyp = $_[2];  # 3-character file type, e.g. Q1_
  my $extTyp = $_[3];  # file extension
  my $dir    = $_[4];  # directory where to copy
  my $day    = $_[5];  # day for time varialbes

  my( $yyddd, $yyyy ) =
  $bpe->getKeys(
    '$YD'.$day,'$Y'.$day);

  my $subDir=substr($dir,-4);

  my $input = "$copyFrom/$yyyy/$subDir/$filTyp$yyddd.$extTyp";

  my $inpFil = basename($input);
  $inpFil =~ s/\.gz$//;
  $inpFil =~ s/\.Z$//;

  unless ( -s "${dir}/$inpFil" ) {

    print "Copying $input to $dir\n";
    copyfile("$input" ,"$dir");


    # uncompress gzip files
    if (substr($extTyp,-2) eq "gz") {
      print "GUNZIP $dir/${inpFil}.gz\n";
      uncompress("-z gunzip","$dir/${inpFil}.gz");
    }

    # uncompress Z files
    if (substr($extTyp,-1) eq "Z") {
      print "GUNCOMPRESS $dir/${inpFil}.Z\n";
      uncompress("$dir/${inpFil}.Z");
    }
  }
}

__END__
