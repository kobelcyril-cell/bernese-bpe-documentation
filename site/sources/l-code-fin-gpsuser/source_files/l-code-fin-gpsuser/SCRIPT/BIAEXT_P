package BIACAL_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  BIACAL_P
#
# Purpose :  Execute GPSEST and ADDNEQ2 for bias calibration
#
# PARAMs  :  PARAM1 - processing filename (baseline)
#
# Author  :  S. Schaer
# Created :  22-Jun-2016
#
# Changes :  28-Jun-2016/ss: Adjusted after GPSEST RDIDCB bugfix
#            17-Aug-2021/av: Support new BSW RINEX naming scheme
#            16-Jan-2025 SS: Considered year with fractional part
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib $ENV{EXE};
use Gps_Date;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd,$param1,$subPid,$yyyy,$ssss,$dirRxo,$extRxo) =
    $bpe->getKeys('$YD+0','PARAM1','SUB_PID','$Y+0','$S+0',"DIR_RXO","EXT_RXO");

  my $file = $param1;

# Set variables
# -------------
  setUserVar($bpe,"FFFF","$file","CD4","$subPid");

  prtMess($bpe,"BASELINE: $file");

# Get list of obstypes
# --------------------
  my $rnxFil = (glob "$dirRxo/${file}*${ssss}.{$extRxo,RXO}")[0];
  print  "GET OBSFIL: $rnxFil\n";
  my @obsTyp = getObsTyp($rnxFil);
  print "FIL_: $rnxFil $#obsTyp\n";
  return unless @obsTyp;
  print "FILE: $rnxFil @obsTyp\n";

# Update geomagnetic pole coordinates
  # -----------------------------------
  my $yyyyF = gps_date("-yd $yyddd -d 0.5 -o %FY");
  my $lat = `$ENV{AUTO}/geomagnetic_pole.com $yyyyF -lat`;
  chomp($lat);
  my $lon = `$ENV{AUTO}/geomagnetic_pole.com $yyyyF -lon`;
  chomp($lon);
  print "FY: $yyddd $yyyyF $lat $lon\n";

  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","LATPOL",$lat);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","LONPOL",$lon);

  @biasel = ('OBSERV_MGEX_B1.SEL','OBSERV_MGEX_B2.SEL','OBSERV_MGEX_B3.SEL','OBSERV_MGEX_B4.SEL','OBSERV_MGEX_B5.SEL','OBSERV_COD.SEL'    ,'OBSERV_MGEX_BX.SEL');
  @bianum = ('B1'             ,'B2'             ,'B3'             ,'B4'             ,'B5'             ,'B6'             ,'BX');

  $bpe->putKey("$$bpe{U}/PAN/MENU_EXT.INP","DIR_SMT","RAWI");
  $bpe->putKey("$$bpe{U}/PAN/MENU_EXT.INP","DIR_CZH","OBSI");
  $bpe->putKey("$$bpe{U}/PAN/MENU_EXT.INP","DIR_CZO","OBSI");
  $bpe->putKey("$$bpe{U}/PAN/MENU_EXT.INP","DIR_PZH","OBSI");
  $bpe->putKey("$$bpe{U}/PAN/MENU_EXT.INP","DIR_PZO","OBSI");

# Run for different OBS_SEL's
# ---------------------------
  foreach my $num (@obsTyp){
    my $obsSel = $biasel[$num];
    setUserVar($bpe,"SOL",$bianum[$num]);
    print "PROCESS: $num, $obsSel, $bianum[$num]\n";

    # Read RINEX File
    $bpe->putKey("$$bpe{U}/PAN/RNXSMT.INP" ,"OBSSEL",$obsSel);
    my $PGMNAM = "RNXSMT";
    $bpe->RUN_PGMS($PGMNAM);

    # Import RINEX File
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" ,"OBSSEL",$obsSel);
    $PGMNAM = "RXOBV3";
    $bpe->RUN_PGMS($PGMNAM);

    # Clock synchronisation
    $PGMNAM = "CODSPP";
    $bpe->RUN_PGMS($PGMNAM);

    # GPSEST for screening
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "OBSSEL" , $obsSel);
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "DCBINP" , 'APR$YD+0');
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "OSBEST" , "1");
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "OSBSIGS", "0.00001");
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "NEQUARS", '');
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "OBS2NEQ", '');

    if($bianum[$num] eq "B6_"){
      $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "USE_R", '1');
    }else{
      $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "USE_R", '0');
    };

    $PGMNAM = "GPSEST";
    $bpe->RUN_PGMS($PGMNAM);

    # Analyse residuals
    $PGMNAM = "RESRMS";
    $bpe->RUN_PGMS($PGMNAM);

    # Remove outliers
    $PGMNAM = "SATMRK";
    $bpe->RUN_PGMS($PGMNAM);

    # Create BIAS NEQ
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "DCBINP" , "");
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "NEQUARS", '$(FFFF)$S+0_$(SOL)');
#    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "RESIDRS", "");
#    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "GLOBION", "0");
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "OSBEST" , "1");
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "OSBSIGS" ,"");
    $bpe->putKey("$$bpe{U}/PAN/GPSEST.INP" , "OBS2NEQ", '1');

    $PGMNAM = "GPSEST";
    $bpe->RUN_PGMS($PGMNAM);

    # Create reduced NEQ
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'$(FFFF)$S+0_$(SOL)_G');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","INPFILE", '$(FFFF)$S+0_$(SOL)');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'$(FFFF)$S+0_$(SOL)_G');
#    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","PRE-ELIMINATE");
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NOINV","1");
    $PGMNAM = "ADDNEQ2";
    $bpe->RUN_PGMS($PGMNAM);

  }

}

sub getObsTyp{
  my $rnxFil = shift;
  my %obsTyp;
  open FIL, "< $rnxFil";
  my $sys = "";
  my $rnxVer = "";
  foreach (<FIL>){
    $rnxVer = $1 if /^ *(\d)\..* RINEX VERSION/;
    if($rnxVer == 3){
      if(/SYS \/ \#/){
        $sys = $1 if /^([GRECJ]) /;
        next unless $sys;
        my @chunks = split " ", substr($_,7,52);
        foreach my $obs (@chunks){
          if($obs =~ /(C)(\d)(\w)/){
            $obsTyp{$sys}{$2}{$3} = 1;
            print "TYPE $obs\n";
          }
        }
      }else{
        if(/TYPES OF OBSERV/){
          $obsTyp{G}{1}{C}  if(/ C1 /);
          $obsTyp{G}{2}{C}  if(/ C2 /);
        }
        last if $sys;
      }
    }
    else{
      last;
    }
  }
  close FIL;

  #  Types
  # Num 1: W / L
  # Num 2: C / C
  # Num 3: C / S
  # Num 4: Frq 5
  my @retLst;
  push @retLst, 5;
  push @retLst, 0 if exists $obsTyp{G}{1}{W} && exists $obsTyp{G}{2}{L};
#  push @retLst, 1 if exists $obsTyp{G}{1}{C} && exists $obsTyp{G}{2}{C};
  push @retLst, 2 if exists $obsTyp{G}{1}{C} && exists $obsTyp{G}{2}{S};
  push @retLst, 4 if exists $obsTyp{G}{1}{W} && exists $obsTyp{G}{2}{S};
#  push @retLst, 5 if exists $obsTyp{G}{1}{W} && exists $obsTyp{G}{2}{C};

  print "SEL: @retLst\n";
  return @retLst;
}
