#!/bin/sh
# SCRIPT-NAME
# sh script file written by bds
# -----------------------------
# functions used by shell
do_rm( ) {
    if [ "$1" ]
    then
        if [ -f `echo $1 | tr ' ' '\012' | head -1` ]
        then
            eval rm $1
        fi
    fi
}
#
toupper( ) {
    eval $1=`echo $2 | ${UPPERC}`
    eval export $1
}
#
seterr( ) {
    if [ $? = 0 ]
    then
        ERRSTAT=OK
    else
        ERRSTAT=ERR
    fi
}
#
# -----------------------------
# SHELL STARTS HERE
# -----------------------------
#
# LEO_EXCL
# ========
#
# 07-MAR-2003/SS
#
# EXCLUDE LEO OBS DATA AS SPECIFIED IN LEO.LST FILE
# -------------------------------------------------
#
# SHELL VARIABLES:
# ----------------
#
# YEAR    :  Year of the session to be processed (2 digit)
# SESSION :  Session number (4 characters)
# CAMPAIGN:  Campaign name
# CAMP_PTH:  Campaign path
# CAMP_DRV:  Drive letter for campain (i.e. P)
# OPT_DIR :  Directory for panels
# PID     :  Process identification number (3 digits)
# SUB_PID :  Subprocess id (3 digits)
# PRT_FILE:  Protocol file name including path
# SCRIPT  :  Name of script
# TASKID  :  Task id of script, usually 00
# PRIORITY:  Priority of the script
# CPU     :  CPU the script is running on
# DAYYEAR :  Julian day of the year
# DAY     :  Day of the Month
# MONTH   :  Month, 1=JAN, 12=DEC
# GPSWEEK :  GPS week
# DAYWEEK :  Day of the week, 0=SUN, 6=SAT
# V_X     :  X Variable in DAT151__.PAN
# V_O     :  O Variable in DAT151__.PAN
# V_Z     :  Z Variable in DAT151__.PAN
# V_PLUS  :  Plus variable in DAT151__.PAN
# V_MINUS :  Minus variable in DAT151__.PAN
# V_x     :  User variable
# PARAMx  :  Script specific parameter, x is 1 thru 9
# U       :  Directory path to U:
#
# See if this shell is being run from the PCS
# script, or directly for testing.  If testing,
# no the header script is not passed in as %1%
#
if [ "$1" = "" ]
then
#
#   set variables for testing here
#
    TEST_START_DIR=`pwd`
    cd $U/WORK
    TESTING="YES"
    export TESTING
else
    TESTING="NO"
    export TESTING
    . "$1"
    seterr
fi
#
# START THE MENU SYSTEM IN NON-INTERACTIVE MODE
# ---------------------------------------------
. $X/SCRIPT/BEG_MENU
seterr
#
# SET VARIABLES IN DAT151__.PAN
# -----------------------------
. $X/SCRIPT/SET_SESS
seterr
#
# SHELL BODY
# ----------
INPPTH=""$CAMP_PTH""$CAMPAIGN"/OBS/"
export INPPTH
OUTPTH=""$CAMP_PTH""$CAMPAIGN"/OBS_LEO/"
export OUTPTH
#
LEOLST=""$CAMP_PTH""$CAMPAIGN"/MSC/LEO.LST"
export LEOLST
#
if [ -f `echo $LEOLST | tr ' ' '\012' | head -1` ]
then
    NUMLEO="0"
    export NUMLEO
#
    LEONAM=`cat "$LEOLST"`
    export LEONAM
    for NAME in  $LEONAM
    do
        LEOFIL=""$INPPTH""$NAME""$SESSION".???"
        export LEOFIL
        NUMFIL="0"
        export NUMFIL
        for FILE in  $LEOFIL
        do
            if [ -f `echo $FILE | tr ' ' '\012' | head -1` ]
            then
                $X/SCRIPT/PRT_MESS "$PRT_FILE" MSG "$SCRIPT" "$FILE"_EXCLUDED
                seterr
                cp "$FILE" "$OUTPTH"
                rm -f "$FILE"
                NUMFIL=`expr "$NUMFIL" + 1`
                export NUMFIL
                if [ "$NUMFIL" -eq 1 ]
                then
                    NUMLEO=`expr "$NUMLEO" + 1`
                    export NUMLEO
                fi
            fi
        done
    done
    if [ "$NUMLEO" -eq 0 ]
    then
        $X/SCRIPT/PRT_MESS "$PRT_FILE" MSG "$SCRIPT" NO_LEO_DATA_FOUND
        seterr
    fi
else
    $X/SCRIPT/PRT_MESS "$PRT_FILE" ERR "$SCRIPT" LEO.LST_FILE_NOT_FOUND
    seterr
    STATUS=""ERR""
    export STATUS
fi
#
# --------------
# end the script
# --------------
. $X/SCRIPT/END_MENU
seterr
if [ "$TESTING" = "YES" ]
then
    cd "$TEST_START_DIR"
else
    . $X/SCRIPT/DO_TAIL
    seterr
fi
