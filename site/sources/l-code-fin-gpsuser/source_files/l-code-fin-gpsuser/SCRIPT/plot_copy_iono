package plot_copy_iono;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  plot_copy_iono
#
# Purpose :  Copy files for plotting to  campaign $P/PLOTS/
#
# Programs:  plot_copy_iono
#
# Author  :  R. Dach   
# Created :  23-Jan-2024
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------

use strict;

use File::Basename;
use lib $ENV{EXE};
use Gps_Date;
use lib $ENV{AUTO};
use igs_device;
use gpsutil;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ( $myDate, $fig, $numDays, $inxFin, $inxRap, $inxMapDays,
       $inxDif, $inxDifDays, $osb,
       $dirSum, $dirInx, $dirOsb,
       $extSum, $extInx, $extOsb ) = 
      $bpe->getKeys(
      'V_DATE', 'V_FIG', 'V_NUMDAYS','V_INXFIN','V_INXRAP','V_INXMAPDAYS',
      'V_INXDIF','V_INXDIFDAYS', 'V_OSB',
      'DIR_SUM','DIR_INX', 'DIR_OSB',
      'EXT_SUM','EXT_INX', 'EXT_OSB');

  print "myDate = \"$myDate\"\n";
  $myDate = "*" if "$myDate" eq "";
  print "myDate = \"$myDate\"\n";

  $Set_Verify=1;


# Place an indicator to identify the most recent plot files in plot_save
# ----------------------------------------------------------------------
  open(SUM,"> ${dirSum}/START.${extSum}");
  print SUM "Plotting process started\n";
  close SUM;


# Copy the INX-files from final iono to plot the maps
# ---------------------------------------------------
  if ( "$inxFin" ne "" ) {
    if ( $inxMapDays eq "" ) { $inxMapDays = $numDays }
    if ( $inxMapDays !~ /^\d+$/) {
      die("BPE variable V_INXMAPDAYS = \"$inxMapDays\" is not an integer\n");
    }
    unlink glob("${dirInx}${inxFin}_*.${extInx}");
    my $lastInx = (glob("${PATH_SAV}${CAMP_SAVIGS}/20??/ATM/Z3_${myDate}.INX.Z"))[-1];
    my $lastDate = substr(basename($lastInx),-11,5);

    copyfile($lastInx,"${dirInx}${inxFin}_lastDay.${extInx}.Z");
    uncompress("${dirInx}${inxFin}_lastDay.${extInx}.Z");

    open(SUM,"> ${dirSum}../FIG/${fig}${inxFin}.html");
    print SUM gps_date("-yd $lastDate","-o %Y-%j");
    close SUM;

    foreach (my $thisDay = 0; $thisDay > -$inxMapDays; $thisDay--) {
      my ($thisYear,$thisDate) = gps_date("-yd $lastDate","-d $thisDay","-o %Y %y%j");
      my $thisInx = "${PATH_SAV}${CAMP_SAVIGS}/${thisYear}/ATM/Z3_${thisDate}.INX.Z";
      copyfile($thisInx,"${dirInx}${inxFin}_${thisDate}.${extInx}.Z");
      uncompress("${dirInx}${inxFin}_${thisDate}.${extInx}.Z");
    }
  }


# Copy the INX-files from rapid iono to plot the maps
# ---------------------------------------------------
  if ( "$inxRap" ne "" ) {
    if ( $inxMapDays eq "" ) { $inxMapDays = $numDays }
    if ( $inxMapDays !~ /^\d+$/) {
      die("BPE variable V_INXMAPDAYS = \"$inxMapDays\" is not an integer\n");
    }
    unlink glob("${dirInx}${inxRap}_*.${extInx}");
    my $lastInx = (glob("${PATH_SAV}${CAMP_SAVRAP}/20??/ATM/RM_${myDate}.INX.Z"))[-1];
    my $lastDate = substr(basename($lastInx),-11,5);

    copyfile($lastInx,"${dirInx}${inxRap}_lastDay.${extInx}.Z");
    uncompress("${dirInx}${inxRap}_lastDay.${extInx}.Z");

    open(SUM,"> ${dirSum}../FIG/${fig}${inxRap}.html");
    print SUM gps_date("-yd $lastDate","-o %Y-%j");
    close SUM;

    foreach (my $thisDay = 0; $thisDay > -$inxMapDays; $thisDay--) {
      my ($thisYear,$thisDate) = gps_date("-yd $lastDate","-d $thisDay","-o %Y %y%j");
      my $thisInx = "${PATH_SAV}${CAMP_SAVRAP}/${thisYear}/ATM/RM_${thisDate}.INX.Z";
      copyfile($thisInx,"${dirInx}${inxRap}_${thisDate}.${extInx}.Z");
      uncompress("${dirInx}${inxRap}_${thisDate}.${extInx}.Z");
    }
  }


# Copy the INX-files from final iono to plot the maps
# ---------------------------------------------------
  if ( "$inxDif" ne "" ) {
    if ( $inxDifDays eq "" ) { $inxDifDays = $numDays }
    if ( $inxDifDays !~ /^\d+$/) {
      die("BPE variable V_INXDIFDAYS = \"$inxDifDays\" is not an integer\n");
    }
    unlink glob("${dirInx}${inxDif}???_*.${extInx}");
    my $lastInx = (glob("${PATH_SAV}${CAMP_SAVIGS}/20??/ATM/Z3_${myDate}.INX.Z"))[-1];
    my $lastDate = substr(basename($lastInx),-11,5);

    my $endeDate = gps_date("-yd $lastDate","-o %Y-%j");

    foreach (my $thisDay = 0; $thisDay > -$inxDifDays; $thisDay--) {
      my ($thisYear,$thisDate) = gps_date("-yd $lastDate","-d $thisDay","-o %Y %y%j");

      my $thisFin = "${PATH_SAV}${CAMP_SAVIGS}/${thisYear}/ATM/Z3_${thisDate}.INX.Z";
      copyfile($thisFin,"${dirInx}${inxDif}fin_${thisDate}.${extInx}.Z");
      uncompress("${dirInx}${inxDif}fin_${thisDate}.${extInx}.Z");

      my $thisRap = "${PATH_SAV}${CAMP_SAVRAP}/${thisYear}/ATM/RM_${thisDate}.INX.Z";
      copyfile($thisRap,"${dirInx}${inxDif}rap_${thisDate}.${extInx}.Z");
      uncompress("${dirInx}${inxDif}rap_${thisDate}.${extInx}.Z");

      open(SUM,"> ${dirSum}../FIG/${fig}${inxDif}.html");
      print SUM "From " . gps_date("-yd $thisDate","-o %Y-%j") . " to $endeDate";
      close SUM;
    }
  }

# Copy latest monthly mean OSB-file to plot the values
# ----------------------------------------------------
  if ( "$osb" ne "" ) {
    my $osbFil = $osb;
    unlink("${dirOsb}${osbFil}.${extOsb}");
    my $myMonth = $myDate;
    if ( $myDate  =~ /^[+-]?\d+$/ ) {
      gps_date("-yd $myDate","-d -35","-o %y%m");
    }
    my $inpOsb = (glob("${PATH_SAV}${CAMP_SAVIGS}/20??/ORB/A1R_${myMonth}.OSB"))[-1];
    copyfile($inpOsb,"${dirOsb}${osbFil}.${extOsb}");
    
    my $osbMonth = substr($inpOsb,-8,4);
    $bpe->setVar("OSBTIT","for $osbMonth");
  }



}
