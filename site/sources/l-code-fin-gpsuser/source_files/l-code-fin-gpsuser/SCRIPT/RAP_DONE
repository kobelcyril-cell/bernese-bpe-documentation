package RAPDONE;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  RAP_DONE
#
# Purpose :  Skip the 1st iteration if rapid results are available
#
# Programs:
#
# Author  :  R. Dach
# Created :  12-Dec-2007
#
# Changes :  22-Jul-2008 PS/RD: prepare for reprocesing
#            08-Aug-2014 SS: Considered RM_yyddd.PRE information
#            01-Feb-2019 AV: Consider RM_yyddd.PRE from save disk
#            19-Sep-2019 AV: Consider RM_yysss.PRE from campaign
#            02-May-2022 RD: Consider annual sub-dirs for $S/RAP
#            18-Aug-2022 AV: Change mean pole for IGS20
#
# ----------------------------------------------------------------------------

use strict;

use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{BPE}";
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yydddP1, $ddd, $yyddd, $ssss, $yyyy,
      $crdinf, $v_x,
      $camp_pth, $campaign,
      $dirPre, $extPre, $dirErp, $extErp) = $bpe->getKeys(
      '$YD+1', '$+0','$YD+0','$S+0','$Y+0',
      'V_CRDINF', 'V_X',
      'CAMP_PTH','CAMPAIGN',
      'DIR_PRE','EXT_PRE','DIR_ERP','EXT_ERP');

# Skip the script in case of reprocessing
# ---------------------------------------
  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");
  unless ($repro) {

# Define file names from rapid solution
# -------------------------------------
##    my $preFil = "$PATH_RAP/$CAMP_RAP/ORB/RA_${yyddd}.PRE";
##    my $erpFil = "$PATH_RAP/$CAMP_RAP/ORB/RA_${yyddd}.ERP";
##    my $preFil = "$CDIR_RAP/ORB/RAM1${ddd}.PRE";
##    my $erpFil = "$PATH_RAP/$CAMP_RAP/ORB/RA_${yydddP1}.ERP";
##    my $preFil = "$PATH_RAP/$CAMP_RAP/ORB/RM_${yyddd}.PRE";
##    my $erpFil = "$PATH_RAP/$CAMP_RAP/ORB/RM_${yyddd}.ERP";
    my $preFil = "$PATH_SAV/RAP/$yyyy/ORB/RM_${yyddd}.PRE.Z";
    my $erpFil = "$PATH_SAV/RAP/$yyyy/ORB/RM_${yyddd}.ERP";
    if ( ! -e $preFil && $erpFil ) {
      $preFil = "$PATH_RAP/$CAMP_RAP/ORB/RM_${yyddd}.PRE";
      $erpFil = "$PATH_RAP/$CAMP_RAP/ORB/RM_${yyddd}.ERP";
    }
### For reprocessing
### Define file names from rapid solution
### -------------------------------------
###  my $preFil = "$PATH_SAV$CAMP_SAVIGS/2008/ORB/Q1_${yyddd}.PRE";
###  my $erpFil = "$PATH_SAV$CAMP_SAVIGS/2008/ORB/Q1_${yyddd}.ERP";


# Does the files exist?
# ---------------------
    print "$preFil $erpFil\n";
    if ( -e $preFil && $erpFil ) {
      if($preFil =~ /\.Z/){
        copyfile($preFil,"${dirPre}${v_x}_${yyddd}.${extPre}.Z");
        system("gzip -d -f ${dirPre}${v_x}_${yyddd}.${extPre}.Z");
      }else{
        copyfile($preFil,"${dirPre}${v_x}_${yyddd}.${extPre}");
      }
      copyfile($erpFil,"${dirErp}${v_x}_${yyddd}.${extErp}");
      print"RAPID orbit ${preFil} copied to ${dirPre}${v_x}_${yyddd}.${extPre}\n";
      print"RAPID ERP ${erpFil} copied to ${dirErp}${v_x}_${yyddd}.${extErp}\n";

# Change mean pole model (IGS20)
# ------------------------------
      if($crdinf =~ /IGS20/){
        my $PGMNAM = "POLUPD";
        $bpe->RUN_PGMS($PGMNAM);
        movefile("${dirErp}/MOD_${yyddd}.${extErp}","${dirErp}/${v_x}_${yyddd}.${extErp}");
      }

# Add extra a priori orbit information
# ------------------------------------
      my $aprFil = "${dirPre}APR${yyddd}.$extPre";
      if ( -e $aprFil ) {
        my $PGMNAM = "CCPREORB";
        $bpe->RUN_PGMS($PGMNAM);

        movefile("${dirPre}APR_${ssss}.$extPre","${dirPre}${v_x}_${yyddd}.$extPre");
      }

      $On_Error_Cont = 1;
      err_print() || die();
    }

  } # end of non-reprocessing
}
