package OBSXTR_SCR;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    : OBSXTR_SCR
#
# Purpose : Screen PZH-files and delete with OBSXTR
#
# Programs: OBSXTR_SCR
#
# Author  : M. Lasser
# Created : 18-Aug-2026
#
# Changes : __-___-____ __:
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;

sub run {
    my $bpe = shift;

    # Run OBSXTR to remove stations with few observations
    # ---------------------------------------------------
    my $PGMNAM = "OBSXTR";
    $bpe->RUN_PGMS($PGMNAM);

    my $delList = $bpe->getKey("$ENV{U}/INP/OBSXTR.INP",'DELFILE');
    if (-s $delList) {
        open (DEL,$delList);
        while (<DEL>) {
            chomp;
            while ( /^ / ) { s/^ // }  # Remove leading blanks
            # delete also code header and obs files (not only phase)
            $_=~s/\..../.*/;
            unlink (glob($_));
            prtMess($bpe,"$_ deleted")
        }
        close DEL;
        appFile ("Files excluded (deleted) from processing:",0,"$delList","$$bpe{SYSOUT}",1);
        unlink $delList;
    }
    else {
        prtMess($bpe,"No obs. file excluded (deleted)");
    }
}
