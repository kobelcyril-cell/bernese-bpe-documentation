package GIM_VER;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GIM_VER
#
# Purpose :  Verfification of GIM results concerning RMS of unit weight etc.
#
# Programs:
#
# PARAMs  :  PARAM1 - Plus-minus tolerance for RMS (default: +-10%)
#            PARAM2 - Minus tolerance (optional)
#
# Remark  :
#
# Author  :  S. Schaer
# Created :  23-Aug-2016
#
# Changes :  25-Aug-2016 SS: Added exception for C1C16234
#            26-Aug-2016 SS: Added minus tolerance (as optional PARAM2)
#            30-Aug-2016 SS: Exepetion for C1C removed (problem solved)
#            29-Sep-2016 AV: Skip die in repro mode
#            17-Oct-2016 SS: Collect posteriori information in ddd.RMS file
#            21-Oct-2016 SS: Added msg2key statement
#            07-Nov-2016 SS: Do not verify A1V
#            30-Jul-2019 SS: Changed key from NEW to BPE
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ddd, $yydddm1, $yydddm2,
      $repro,
      $pcfFil, $param1, $param2,
      $v_e, $v_h, $v_c, $v_w, $v_x, $v_z, $v_f,
      $dirOut ,$extOut) =
    $bpe->getKeys('$YD+0', '$+0', '$YD-1', '$YD-2',
                  'V_REPRO',
                  'PCFFIL', 'PARAM1', 'PARAM2',
                  'V_E', 'V_H', 'V_C', 'V_W', 'V_X', 'V_Z', 'V_F',
                  'DIR_OUT', 'EXT_OUT');

  my $tol = $param1 eq "" ? 10 : $param1;
  $tol = sprintf("%4.1f",$tol) if $tol < 100;
  prtMess($bpe,"GIM_VER: Tolerance: +-$tol\%");
  my $tolm = $param2 eq "" ? $tol : $param2;

  $pcfFil = (split('\.',$pcfFil))[0];
##  if ($pcfFil eq "IGSIONO") {
##  }

  my $fil = "${dirOut}${ddd}.RMS";
##  move($fil,$fil."_OLD") if -s $fil;
##  system("grep -i posteriori '????${ddd}*.OUT' > $fil");

  my @out = ("${v_e}I${yyddd}","${v_h}I${yydddm1}","${v_z}S${yyddd}","${v_z}F${yyddd}","${v_x}R${yyddd}",
             "_${v_e}A${yyddd}","${v_e}S${yyddd}","${v_e}F${yyddd}","${v_e}R${yyddd}","${v_e}G${yyddd}","${v_e}X${yyddd}",
             "_${v_e}B${yyddd}","${v_e}E${yyddd}",
             "_${v_w}A${yyddd}","${v_w}S${yyddd}","${v_w}F${yyddd}","${v_w}R${yyddd}","${v_w}G${yyddd}","${v_w}C${yyddd}",
             "_${v_c}A${yyddd}","${v_c}S${yyddd}","${v_c}F${yyddd}","${v_c}R${yyddd}","${v_c}G${yyddd}","${v_c}X${yyddd}",
             "${v_c}M${yyddd}",
             "${v_f}S${yyddd}","${v_f}F${yyddd}","${v_f}R${yyddd}","${v_f}G${yyddd}","_${v_f}V${yyddd}",
             );
  my $err = 0;
  for my $nam (@out) {
    next if substr($nam,0,1) eq "_";
    my $fil = "${dirOut}$nam.${extOut}";
    getstring("-a 40 -b 51",$fil,"A posteriori RMS of unit weight");
    my $rms = $StrList[0];
    my $film1 = $fil;
    $film1 =~ s/${yydddm1}/${yydddm2}/;
    $film1 =~ s/${yyddd}/${yydddm1}/;
    getstring("-a 40 -b 51",$film1,"A posteriori RMS of unit weight");
    my $rmsm1 = $StrList[0];
    $rmsm1 = $rms unless -s $film1;
    my $fac = 2;
    $fac = $rms/$rmsm1 if $rmsm1 > 0;
    $fac = sprintf("%10.3f",$fac);
    my $dev = ($fac-1)*100;
    $dev = sprintf("%8.1f",$dev);
    print "$fil: RMS: $rms $rmsm1 $fac $dev\n";

# General exceptions:
##    next if substr($nam,0,3) eq "${v_w}C";
# Particlar exceptions:
##    next if $nam eq "${v_w}C16234" || $nam eq "${v_w}C16235";

##    $err++ if abs($dev) > $tol;
    $err++ if $dev > $tol || $dev < -$tolm;
  }
  if ($err > 0) {
    prtMess($bpe,"GIM_VER: GIM results not accepted due to $err problems (considering tolerance of +-$tol\%)");
    msg2key("BPE","$pcfFil GIM_VER ${yyddd}0: GIM results not accepted due to $err problems");
##    die "\nGIM_VER: GIM results not accepted due to $err problems (considering tolerance of +-$tol\%)\n\n" unless $repro;
  }

}

