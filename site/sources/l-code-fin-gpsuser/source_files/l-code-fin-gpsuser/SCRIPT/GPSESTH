package GPSESTH;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GPSESTH
#
# Purpose :  Run for parameter estimation and NEQ-file generation
#
# Programs:  GPSEST
#
# Author  :  M. Meindl
# Created :  01-Apr-2008               Last modified:
#
# Changes :  01-May-2008 RD: No entries in HRD-list
#            03-Aug-2009 RD/SL: syntax in copy call corrected
#            24-Nov-2016 AV: CLKFINAL/FCLKGNSS: use yyddd/yyssss
#            12-Jul-2021 LP: Add $v_tropMod for VMF3
#
# ----------------------------------------------------------------------------
use strict;
use lib "$ENV{AUTO}";
use gpsutil;
use lib $ENV{BPE};
use bpe_util;
use File::Copy;


sub run {
  my $bpe = shift;


# Define variables
# ----------------
  my ($yyddd, $yyssss,$v_c, $v_tropMod,$pcf, $dirClb, $extClb, $outDir) =
    $bpe->getKeys('$YD+0','$YSS+0','V_C', 'V_TRPMOD','PCFFIL','DIR_CLB','EXT_CLB','DIR_OUT');

  my @obsLst;
#  my $udate = $pcf =~/FCLKGNSS/ ? "$yyssss" : "$yyddd" ;
  my $udate = "$yyssss";
  my $obsFil = "${dirClb}${udate}HRD.${extClb}";

  $bpe->putKey("$$bpe{U}/PAN/MENU_EXT.INP","DIR_PZH","OBS");
  $bpe->putKey("$$bpe{U}/PAN/MENU_EXT.INP","DIR_PZO","OBS");
  $bpe->putKey("$$bpe{U}/PAN/MENU_EXT.INP","DIR_CZH","OBS");
  $bpe->putKey("$$bpe{U}/PAN/MENU_EXT.INP","DIR_CZO","OBS");

# Replace selected with station list
# ----------------------------------
  replaceSel($bpe,"GPSEST","PZFILES",$obsFil);

# GMF/VMF troposphere model switch
# --------------------------------
  my $tropMod = 'VMF'; # default
  if ($v_tropMod ne "") {
    $v_tropMod  = $v_tropMod.'    ';
    if (substr($v_tropMod,3,1) ne ' ') {$tropMod = substr($v_tropMod,0,4);}
    else                               {$tropMod = substr($v_tropMod,0,3);}
  }
  my $flgFil = "${outDir}../MSC/TRP_${yyddd}.FLG";
  my $flgLin = -e $flgFil ? `cat $flgFil` : $tropMod;
  chomp($flgLin);
  prtMess($bpe,"GMF/VMF troposphere model switch: $flgLin");

  my $TROPMOD_KEY = $flgLin;
     $TROPMOD_KEY =~ s/GMF3/GPT3/;
  my $TROPMF_KEY  = $flgLin;
     $TROPMF_KEY  =~ s/GPT/GMF/;
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","TROPOS","DRY_".$TROPMOD_KEY);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MAPPNG","WET_".$TROPMF_KEY);
  if     ($flgLin =~ /VMF/) {$bpe->putKey("$ENV{U}/PAN/GPSEST.INP","VMF_FILES",'VMF$YD+0');}
  elsif (($flgLin =~ /GMF/)||($flgLin =~ /GPT/)) {$bpe->putKey("$ENV{U}/PAN/GPSEST.INP","VMF_FILES",' ');}
  else                     {die "*** Invalid TROPO model: $flgLin \n";}


# Run program
# -----------
  if ( -s $obsFil ) {
    my $PGMNAM = "GPSEST";
    $bpe->RUN_PGMS($PGMNAM);
  }

}
