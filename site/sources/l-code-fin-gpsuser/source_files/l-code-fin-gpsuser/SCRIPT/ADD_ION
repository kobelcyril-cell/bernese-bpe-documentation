package ADD_ION;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ADD_ION
#
# Purpose :  Create concatenated ???yyddd.ION file on the basis of
#            site-specific .ION files.
#
# Programs:
#
# PARAMs  :  PARAM1 - Solution identifier
#
# Author  :  S. Schaer
# Created :  21-Jun-2016
#
# Changes :  15-Jul-2016/ss: Create S1_yyddd.TEC
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ssss, $param1,
      $dirIon,$extIon) =
    $bpe->getKeys('$YD+0', '$S+0', 'PARAM1',
                  'DIR_ION','EXT_ION');

  $param1 = "S1_" if $param1 eq "";

  $param1 = $$bpe{"V_$param1"} if length($param1) == 1;
  $param1 = $param1."_"        if length($param1) == 2;

  my $ionFil = "${dirIon}${param1}${yyddd}.${extIon}";
  unlink($ionFil);
  print "IONFIL: $ionFil\n";

  my @fil = glob("${dirIon}????${ssss}_.${extIon}");
  for (@fil) {
    print "FIL: $_\n";
    if (-s $ionFil) { appFile("",0,$_,$ionFil,0) }
    else            { copy($_,$ionFil) }
  }

  `grep ' ---       --- ' ${dirIon}../OUT/????${ssss}_I.OUT > ${dirIon}../OUT/${param1}${yyddd}.TEC`;
  `grep ' ---       --- ' ${dirIon}../OUT/????${ssss}_I.OUT | sort -u > ${dirIon}../OUT/MAX${yyddd}.TEC`;

}
