package EDTXTR;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  EDTXTR
#
# Purpose :  GENERATE SUMMARY OF THE PARALEL CODSPP RUNS
#
# Programs:
#
# Author  :  H. Bock
# Created :  06-Dec-2007               Last modified: 23-Jul-2008
#
# Changes :  23-Jul-2008 rd: prepare for reprocessing
#            28-May-2022 ST: Remove unused v_camp.
#
# ----------------------------------------------------------------------------
use strict;
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss,$ssss,$yy,$ddd,$pid,
      $dirOut,$dirSum,$extSum) =
    $bpe->getKeys('$YSS+0','$S+0','$Y','$+0','PID',
                  'DIR_OUT','DIR_SUM','EXT_SUM');

# Run program
# -----------
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT","E[FL]${yyssss}???");
  my $PGMNAM = "GPSXTR";
  $bpe->RUN_PGMS($PGMNAM);

# Summary of program run for Protocol
# -----------------------------------
  my $title = "GPSXTR from PID $pid at " . timstr(localtime(time));
  my $cmpSum="$dirOut/GPSCMP.${yy}_${ssss}";
  appFile ("$title",0,"$dirSum/ESTC${yyssss}.${extSum}","$cmpSum",1);

  my $wksSum="$dirOut/GPSWKS.${yy}_${ssss}";
  appFile ("$title",0,"$dirSum/ESTW${yyssss}.${extSum}","$wksSum",1);


# Generate residual overview from first and last iteration
# --------------------------------------------------------
  my $resSum="$dirOut/CHK$yyssss.SUM";

  unlink("$resSum");

  my $resFil="EF${yyssss}??";
  $bpe->putKey("$$bpe{U}/PAN/RESRMS.INP","RESFIL","$resFil");

  $PGMNAM = "RESRMS";
  $bpe->RUN_PGMS($PGMNAM);

  my $resOut="$dirOut/RESRMS.${yy}_$ssss";
  appFile ("",0,"$resSum","$resOut",1);

# Second RESRMS run
# -----------------
  unlink("$resSum");

  $resFil="EL${yyssss}??";

  $bpe->putKey("$$bpe{U}/PAN/RESRMS.INP","RESFIL","$resFil");

  $PGMNAM = "RESRMS";
  $bpe->RUN_PGMS($PGMNAM);

  appFile ("",0,"$resSum","$resOut",1);

}
