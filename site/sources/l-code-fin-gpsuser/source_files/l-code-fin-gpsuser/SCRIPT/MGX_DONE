package MGX_DONE;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  MGX_DONE
#
# Purpose :  Extend orbits with MGEX orbits (secundary source)
#
# Programs:
#
# Author  :  A. Villiger
# Created :  06-May-2019
#
# Changes :
#
# ----------------------------------------------------------------------------

use strict;

use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{BPE}";
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd,$ssss,$v_x,
      $dirPre,$extPre)
     = $bpe->getKeys(
      '$YD+0','$S+0','V_X',
      'DIR_PRE','EXT_PRE');

# Skip the script in case of reprocessing
# ---------------------------------------

  my $mgxorb = "${dirPre}MGX${yyddd}.$extPre";
  if ( -e $mgxorb ) {
    my $PGMNAM = "CCPREORB";
    $bpe->putKey("$ENV{U}/PAN/CCPREORB.INP",'MERGE2','MGX$YD+0');
    $bpe->putKey("$ENV{U}/PAN/CCPREORB.INP",'CHAR4' ,'MGX_');
    $bpe->RUN_PGMS($PGMNAM);

    movefile("${dirPre}MGX_${ssss}.$extPre","${dirPre}${v_x}_${yyddd}.$extPre");
  }
}
