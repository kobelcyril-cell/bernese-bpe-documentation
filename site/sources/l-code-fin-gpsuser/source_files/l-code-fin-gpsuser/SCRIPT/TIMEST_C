package TIMEST_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  TIMEST_P
#
# Purpose :  Parallel run of GPSEST using code and phase data
#
# Programs:  GPSEST
#
# Author  :  R. Dach
# Created :  17-Nov-2005
#
# Changes :  __-___-____/__:
#
# ----------------------------------------------------------------------------

use strict;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($param1, $subPid, $yyddd, $dirIon, $extIon) =
    $bpe->getKeys('PARAM1', 'SUB_PID', '$YD+0', 'DIR_ION', 'EXT_ION');


# Initialize $D4 variable with subpid
# -----------------------------------
  setUserVar($bpe,"CCC",$subPid);


# Replace selected with station list
# ----------------------------------
  replaceSel($bpe,"GPSEST","CZFILES",$param1);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PZFILES","");


# Print the selected files to the log file
# ----------------------------------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;


# Run program
# -----------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);


}

