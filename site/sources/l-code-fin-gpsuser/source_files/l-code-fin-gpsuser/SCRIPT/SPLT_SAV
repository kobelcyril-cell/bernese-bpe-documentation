package SPLT_SAV;
@ISA = ("RUNBPE");
# ==========================================================================
#
# Name    :  SPLT_SAV
#
# Purpose :  Save result files of ARCSPLIT.PCF to savedisk
#
# Programs:
#
# Author  :  P. Steigenberger
# Created :  07-Feb-2012               Last modified:
#
# Changes :  19-Sep-2019, IS: Add CMP$yyssss
#
# ==========================================================================

use strict;

use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;

use lib "$ENV{BPE}";
use bpe_util;

use File::Copy;

# --------------------------------------------------------------------------

sub run {
    my $bpe = shift;

# Define variables
# ----------------
my  ($yyssss, $yyyy, $v_sav, $v_k, $dirSum, $extSum, $dirOut, $extOut) = $bpe->getKeys
    ('$YSS+0', '$Y+0', 'V_SAV', 'V_K', 'DIR_SUM', 'EXT_SUM', 'DIR_OUT','EXT_OUT');


# Some directories
# ----------------
  my $dirSav = "$dirOut/../$yyyy/";
  my $outSav = "$dirSav/OUT/";
  my $orbSav = "$dirSav/ORB/";

  check_dir($outSav,$orbSav) if ( $v_sav eq "Y" );


# Distribution not allowed
# ------------------------
  if ( $v_sav ne "Y" ) {
      prtMess($bpe,"FILES NOT SAVED");

# Do the distribution
# -------------------
    } else {

      my $filnam ="ELE${yyssss}.$extOut";
      copyfile("$dirOut/$filnam","$outSav/$filnam");

      $filnam ="ASP${yyssss}.$extSum";
      copyfile("$dirSum/$filnam","$outSav/$filnam");

      $filnam ="DFX${yyssss}.$extSum";
      copyfile("$dirOut/$filnam","$outSav/$filnam");

      $filnam ="${v_k}_${yyssss}.OEX";
      copyfile("$dirOut/$filnam","$orbSav/$filnam");


      $On_Error_Cont = 1;
      err_print() || die();

    }

}

# ==========================================================================
