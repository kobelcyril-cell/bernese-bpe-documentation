package SNGDIF;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  SNGDIF
#
# Purpose :  Create baselines
#
# Programs:  SNGDIF
#
# Author  :  M. Meindl
# Created :  30-Jul-2003
#
# Changes :  10-Feb-2005 mm: Old date variables removed
#            26-May-2025 rd: add special clustering for BDS and QZSS
#
# ----------------------------------------------------------------------------
use strict;

use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Define variables
# ----------------
  my $V_MIX    = "";
  $V_MIX    = $$bpe{V_MIX};

  my ($ssss,$yyddd,$obsDir,$clbDir,$gnss) =
         $bpe->getKeys('$S+0','$YD+0',"DIR_PSH","DIR_CLB","V_GNSS");


# Set options and print message
# -----------------------------
  if ($V_MIX eq "Y") {
    prtMess($bpe,"OBS-MAX strategy selected");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","STRATEGY","OBS-MAX")
  }
#  else {
#    prtMess($bpe,"SHORTEST strategy selected");
#    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","STRATEGY","SHORTEST") }


# Delete single difference files
# ------------------------------
  unlink(glob("${obsDir}????${ssss}.?S?"));
  unlink(glob("${clbDir}${yyddd}_??.CLB"));

# Special runs for not well observed systems
# ------------------------------------------
  my @delFil = ();

  # BDS3
  if ( $gnss =~ /C/ ) {

    my $bdsBsl = 'BDSBSL' . $yyddd;
    my $PGMNAM = "SNGDIF";

    # update $U/PAN/pgm.INP to $U/INP/pgm.INP
    # ---------------------------------------
    $bpe->inpOutMenu("","$$bpe{U}/PAN/$PGMNAM.INP",
                        "$$bpe{U}/INP/$PGMNAM.INP", $PGMNAM);

    my $redBas = $bpe->getKey("$ENV{U}/INP/SNGDIF.INP","REDBAS");
    my $outBas = $bpe->getKey("$ENV{U}/INP/SNGDIF.INP","BASPRT");

    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","USE_C","1");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASPRT","$bdsBsl");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","REDBAS","0");

    $bpe->RUN_PGMS($PGMNAM);

    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","USE_C","0");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASDEF","$bdsBsl");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASPRT","$outBas");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","REDBAS","$redBas");

    push @delFil, $bdsBsl;
  }


  # QZSS
  if ( $gnss =~ /J/ ) {

    my $qzsBsl = 'QZSBSL' . $yyddd;
    my $PGMNAM = "SNGDIF";

    # update $U/PAN/pgm.INP to $U/INP/pgm.INP
    # ---------------------------------------
    $bpe->inpOutMenu("","$$bpe{U}/PAN/$PGMNAM.INP",
                        "$$bpe{U}/INP/$PGMNAM.INP", $PGMNAM);

    my $redBas = $bpe->getKey("$ENV{U}/INP/SNGDIF.INP","REDBAS");
    my $outBas = $bpe->getKey("$ENV{U}/INP/SNGDIF.INP","BASPRT");

    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","USE_J","1");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASPRT","$qzsBsl");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","REDBAS","0");

    $bpe->RUN_PGMS($PGMNAM);

    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","USE_J","0");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASDEF","$qzsBsl");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASPRT","$outBas");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","REDBAS","$redBas");
    
    push @delFil, $qzsBsl;
  }


  # Galileo before 2016
  if ( $gnss =~ /E/ && $yyddd < 16000) {

    my $galBsl = 'GALBSL' . $yyddd;
    my $PGMNAM = "SNGDIF";

    # update $U/PAN/pgm.INP to $U/INP/pgm.INP
    # ---------------------------------------
    $bpe->inpOutMenu("","$$bpe{U}/PAN/$PGMNAM.INP",
                        "$$bpe{U}/INP/$PGMNAM.INP", $PGMNAM);

    my $redBas = $bpe->getKey("$ENV{U}/INP/SNGDIF.INP","REDBAS");
    my $outBas = $bpe->getKey("$ENV{U}/INP/SNGDIF.INP","BASPRT");

    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","USE_E","1");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASPRT","$galBsl");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","REDBAS","0");

    $bpe->RUN_PGMS($PGMNAM);

    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","USE_E","0");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASDEF","$galBsl");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASPRT","$outBas");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","REDBAS","$redBas");
    
    push @delFil, $galBsl;
  }

  # GLONASS before 2009
  if ( $gnss =~ /R/ && $yyddd < 9000) {

    my $gloBsl = 'GLOBSL' . $yyddd;
    my $redBas = $bpe->getKey("$ENV{U}/PAN/SNGDIF.INP","REDBAS");
    my $outBas = $bpe->getKey("$ENV{U}/PAN/SNGDIF.INP","BASPRT");
    $outBas =~ s/80006/$yyddd/;

    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","USE_R","1");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASPRT","$gloBsl");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","REDBAS","0");

    my $PGMNAM = "SNGDIF";
    $bpe->RUN_PGMS($PGMNAM);

    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","USE_R","0");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASDEF","$gloBsl");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","BASPRT","$outBas");
    $bpe->putKey("$ENV{U}/PAN/SNGDIF.INP","REDBAS","$redBas");

    push @delFil, $gloBsl;
  }

# Run program
# -----------
  my $PGMNAM = "SNGDIF";
  $bpe->RUN_PGMS($PGMNAM);


  unlink(@delFil) if @delFil;
}
