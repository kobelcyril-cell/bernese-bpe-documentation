use lib $ENV{BPE};
use bpe_util;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ssss, $dirBpe, $dirPsh, $extPsh) =
  $bpe->getKeys
     ('$S+0', 'DIR_BPEPRT', 'DIR_PSH', 'EXT_PSH');

# Initialize parallel run
# -----------------------
  my $bpeFil = "${dirBpe}EST${ssss}";
  my @pshFil = glob("${dirPsh}????${ssss}.${extPsh}");

  @pshFil = map { substr(basename($_),0,4) } @pshFil;
  initPar_Bl($bpe,@pshFil);

}
