package BASESTAP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  BASESTAP
#
# Purpose :  Prepare parallel GPSEST run for baseline-wise analysis
#
# PARAMs  :
#
# Author  :  R. Dach                   Last modified: 26-Mar-2010
# Created :  26-mar-2010
#
# Changes :
#
