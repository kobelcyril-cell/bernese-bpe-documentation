package RNXSMT_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RNXSMT_P
#
# Purpose :  Execute RNXSMT
#
# PARAMs  :  PARAM1 - temporary file for parallel processing
#
# Author  :  M. Meindl
# Created :  23-Jul-2003
#
# Changes :  23-Jul-2008 ps: Unique output filenames
#            12-Oct-2016 av: Add nclu
#            06-Dec-2016 av: Temporary freq check for igsfin1d14
#            10-Dec-2020 st: RNXSMT: RNXFIL -> RNXFIL_SHORT
#            13-Aug-2021 RD: Start using BSW-style filenaming in the campaign area
#            26-May-2025 rd: add V_GNSS to manage USE_x
#
# ============================================================================
use strict;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ssss , $ddd , $yyssss , 
      $param1 , $subPid  , $nclu   , $clu   , $v_gnss,
      $dirOut,$campaign) =
   $bpe->getKeys
     ('$S+0', '$+0', '$YSS+0', 
      'PARAM1', 'SUB_PID', 'V_NCLU','V_CLU', 'V_GNSS',
      'DIR_OUT','CAMPAIGN');

# Set cluster number and input files
# ----------------------------------
  my $cluster = $clu eq "" && $nclu eq ""? "$ddd$param1" : "$yyssss" . substr($subPid,1);
  my $ffff    = $clu eq "" && $nclu eq ""? $param1       : "____";

  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$ffff,"CCC",$subPid);

  if ($clu eq "" && $nclu eq "") {
    $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","RNXFIL_SHORT","$param1$ssss") }
  else {
    replaceSel($bpe,"RNXSMT","RNXFIL_BSW",$param1);
    replaceSel($bpe,"RNXSMT","RNXFIL_SHORT",$param1) }


# Select GNSS, if desired
# -----------------------
  &setGNSS($bpe,"$ENV{U}/PAN/RNXSMT.INP","USE_",$v_gnss);


#  if($campaign=~/IGSFIN1D14/){
#    $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","GLOFRQ",1);
#  }
# Run program
# -----------
  my $PGMNAM = "RNXSMT";
  $bpe->RUN_PGMS($PGMNAM);

# Extract warning/error messages from protocol file
# -------------------------------------------------
  getWarn($bpe,"${dirOut}RNX${yyssss}.ERR");


# Delete BPE file
# ---------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;
  unlink($param1);

}
