package ADDNEQ2;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  ADDNEQ2
#
# Purpose :  Execute ADDNEQ2
#
# PARAMs  :
#
# Author  :  M. Meindl
# Created :  20-Oct-2003
#
# Changes :  24-Apr-2007/ss: Execute GPSXTR if desired
#            24-Sep-2012/ss: Do not execute GPSXTR if NOINV marked
#            10-Oct-2012/ss: Ignore NOINV
#            07-Aug-2023/eb: Set VAR_PLUS
#
# ============================================================================

use lib $ENV{BPE};
use bpe_util qw(setUserVar);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($minus) = $bpe->getKeys('PARAM1');
  $bpe->putKey("$ENV{U}/PAN/MENU_VAR.INP","VAR_MINUS",$minus);

# try also to include more recent PPP runs (called by ~~)
  my ($plus) ="+2";
  $bpe->putKey("$ENV{U}/PAN/MENU_VAR.INP","VAR_PLUS",$plus);

  my $nday = sprintf "%2.2d", -$minus+1;
  setUserVar($bpe,"NDAY",$nday);

# Run program
# -----------
  my $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);


}
