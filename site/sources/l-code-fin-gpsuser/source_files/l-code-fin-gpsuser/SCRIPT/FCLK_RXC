package FCLK_RXC;
@ISA = ("RUNBPE");
# ==============================================================================
#
# Name    :  FCLK_RXC
#
# Purpose :  Copy RINEX files for FCLKGNSS
#
# PARAMs  :
#
# Author  :  A. Villiger
#
# Created :  15-Nov-2016
#
# Changes :  11-Jul-2017 AV: Use check_dir for 5 second data
#            29-Sep-2020 AV: Exclusions from repro3 added
#            24-Feb-2020 AV: Exclusions from repro3 added
#
# ==============================================================================

use strict;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib "$ENV{BPE}";
use bpe_util;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my $CAMP_PTH = $$bpe{CAMP_PTH};
  my $CAMPAIGN = $$bpe{CAMPAIGN};

  my($ssss,$ddd,$yy,
     $param1,$mode,$repro, $dirRxo, $extRxo
  ) =
  $bpe->getKeys(
     '$S+0','$+0','$Y',
     'PARAM1','V_MODE','V_REPRO','DIR_RXO','EXT_RXO'
  );

  if($mode =~ /PPP/){
    if($param1 =~ /R30/){
      system("$ENV{AUTO}/put_igsdata.com $yy $ssss -o $dirRxo \"-or %FIN %CLK %ION %HRD %MGEX\" -r");
      system("$ENV{AUTO}/rinex.com $dirRxo $ddd $yy");
      unlink("${dirRxo}/EBRE2650.07O");
      unlink("${dirRxo}/CAS12650.07O");
      unlink("${dirRxo}/PDEL2560.06O");
      unlink("${dirRxo}/THU31220.05O");
      unlink("${dirRxo}/MDVO0220.03O");
      unlink("${dirRxo}/MDVO0640.02O");
    }
    elsif($param1 =~ /R05/){
     # my $waitFile = "${CAMP_PTH}${CAMPAIGN}/OUT/HRX${yy}${ddd}.LST";
     #  unless ($repro) {
     #    until (-e $waitFile && (stat($waitFile))[9] + $olderThan <= time) {
     #      print "$waitFile is not yet available (from MERGE.PCF, l_code)\n";
     #      sleep $waiting;
     #    }
     #  }
     &check_dir($dirRxo);
     system("$ENV{AUTO}/put_igsdata.com $yy $ddd -o $dirRxo HRD");
     unlink("${dirRxo}/CAS11790.04O");
     unlink("${dirRxo}/CRO11790.04O");
     unlink("${dirRxo}/CEDU0130.20O");

    }
  }
}
