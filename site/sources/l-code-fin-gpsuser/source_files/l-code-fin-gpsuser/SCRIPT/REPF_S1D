package REPF_S1D;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  REPF_S1D
#
# Purpose :  Copy all relevant results to save disk
#            (from reprocessing)
#
# Programs:
#
# Author  :  R. Dach
#
# Created :  07-Dec-2007
#
# Changes :  27-Mar-2008 HB: Correct extension for monthly P1P2-file
#                            on savedisk
#            23-Jul-2008 rd: RNXERR.yy_ddd -> RNXyyssss.ERR
#            24-Jul-2008 rd/ps: v_w -> v_k
#            21-Aug-2008 ps: Save Q1N coordinates
#            21-Oct-2008 ps: W1 DCB handling
#            11-Nov-2008 ps: Save Q1 ADDNEQ output
#            20-Jan-2011 ps: W1 NEQ filename corrected
#            11-Jun-2013 SL: Use &copy2archive instead of copy
#            17-Jun-2013 SL: Some smaller modifications
#            20-Jun-2013 PS: SDB file optional (does not exist for GPS-only)
#            07-May-2019 RD: V_LOADNG added (to switch between TU VIenna and GFZ)
#            15-Jul-2019 IS: Save IGS_CRX.STA
#            07-Aug-2019 IS: Save HLMR$yyddd.OUT
#               Oct-2019 IS: change compression c->z
#            14-Jan-2021 RD: Copy also results from ATTXTR
#            26-May-2025 rd: comment script to adjust the LOD sign
#
# ============================================================================

use strict;
use warnings;

use lib "$ENV{BPE}";
use bpe_util qw(check_dir copy2archive prtMess);
use lib "$ENV{AUTO}";
use igs_device;

sub run {

  my $bpe = shift;

# Define variables
# ----------------
  my(
    $yyssss,$yyddd, $yy, $yyyy, $ddd, $ssss, $wwwwd, $mm, $dd,
    $b, $o, $v, $k, $u, $z,
    $sav,$loading,$prc,$crdInf,
    $camp_pth, $campaign, $dirBpe,
    $dirOut, $dirNeq, $dirTrp, $dirErp, $dirIep, $dirPre,
    $extOut, $extNeq, $extTrp, $extErp, $extIep, $extPre,
    $dirStd, $dirEle, $dirCrd, $dirGcc, $dirSmc, $dirSum,
    $extStd, $extEle, $extCrd, $extGcc, $extSmc, $extSum,
    $dirClk, $dirRpr, $dirDcb, $dirClb, $dirGrd, $dirFix,
    $extClk, $extRpr, $extDcb, $extClb, $extGrd, $extFix,
    $dirSnx, $dirTro, $dirEst, $dirSta, $dirVel, $dirObx,
    $extSnx, $extTro, $extEst, $extSta, $extVel, $extObx
  ) =
  $bpe->getKeys(
    '$YSS+0','$YD+0','$Y','$Y+0','$+0','$S+0','$WD+0','$M','$D',
    'V_B','V_O','V_V','V_K','V_U','V_Z',
    'V_SAV','V_LOADNG','V_PRC','V_CRDINF',
    'CAMP_PTH','CAMPAIGN', 'DIR_BPEOUT',
    'DIR_OUT','DIR_NEQ','DIR_TRP','DIR_ERP','DIR_IEP','DIR_PRE',
    'EXT_OUT','EXT_NEQ','EXT_TRP','EXT_ERP','EXT_IEP','EXT_PRE',
    'DIR_STD','DIR_ELE','DIR_CRD','DIR_GCC','DIR_SMC','DIR_SUM',
    'EXT_STD','EXT_ELE','EXT_CRD','EXT_GCC','EXT_SMC','EXT_SUM',
    'DIR_CLK','DIR_RPR','DIR_DCB','DIR_CLB','DIR_GRD','DIR_FIX',
    'EXT_CLK','EXT_RPR','EXT_DCB','EXT_CLB','EXT_GRD','EXT_FIX',
    'DIR_SNX','DIR_TRO','DIR_EST','DIR_STA','DIR_VEL','DIR_OBX',
    'EXT_SNX','EXT_TRO','EXT_EST','EXT_STA','EXT_VEL','EXT_OBX'
  );

# Some directories
# ----------------
  my $dirSav = "${camp_pth}${campaign}/../${yyyy}/";
  my $orbSav = "${dirSav}ORB/";
  my $outSav = "${dirSav}OUT/";
  my $atmSav = "${dirSav}ATM/";
  my $solSav = "${dirSav}SOL/";
  my $staSav = "${dirSav}STA/";
  my $grdSav = "${dirSav}GRD/";
  my $bpeSav = "${dirSav}BPE/";

  if($sav eq "Y") {
    &check_dir($orbSav,$outSav,$atmSav,$solSav,$staSav,$grdSav,$bpeSav);
  }

# Extract the title of the reprocessing
# -------------------------------------
  my $repro = "${camp_pth}${campaign}/MSC/REPROCESSING.FLG";
  open(REP,"$repro");
  my $tit = <REP>;
  my $tit2 = <REP>;  # <<< ?
  $tit = $tit2 if ( $tit2 ne "" );
  close(REP);
  chomp($tit);

# Copy files to savedisk
# ----------------------
# Mandatory files
  my @cpyLst = (
# Protocol
    "${dirOut}IGSREP1D.${yy}_${ssss}    ${outSav} f ",
    "${dirOut}${k}_${yyddd}.${extOut}   ${outSav} f ",

# A priori files
    "${dirClk}${o}_${yyddd}.${extClk}   ${orbSav} f ",

# Intermediate solutions
    "${dirEle}${z}_${yyddd}.${extEle}   ${orbSav} f ",
    "${dirEle}${u}_${yyddd}.${extEle}   ${orbSav} f ",

# DCB solution (optional, see below)
##    "${dirNeq}${b}_${yyddd}.${extNeq}   ${solSav} z ",
##    "${dirDcb}${b}_${yyddd}.${extDcb}   ${orbSav} f ",

# A priori orbits for NEQ files
    "${dirStd}${v}_${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirRpr}${v}_${yyddd}.${extRpr}   ${orbSav} _ ",

# Cluster assignment files
    "${dirClb}${yyddd}_??.${extClb}     ${staSav} f ",

# Normal equations
    "${dirNeq}${k}N${yyddd}.${extNeq}   ${solSav} z ",
    "${dirNeq}${k}_${yyddd}.${extNeq}   ${solSav} z ",

# Final solution
    "${dirFix}${k}_${yyddd}.${extFix}   ${staSav} f ",
    "${dirGcc}${k}_${yyddd}.${extGcc}   ${orbSav} f ",
    "${dirCrd}${k}_${yyddd}.${extCrd}   ${staSav} f ",
    "${dirTrp}${k}_${yyddd}.${extTrp}   ${atmSav} f ",
##    "${dirTro}${k}_${yyddd}.${extTro}   ${atmSav} c ", # after TROTRO (below)
    "${dirErp}${k}_${yyddd}.${extErp}   ${orbSav} f ",
    "${dirIep}${k}_${yyddd}.${extIep}   ${orbSav} f ",
    "${dirIep}${k}N${yyddd}.${extIep}   ${orbSav} f ",
    "${dirEle}${k}_${yyddd}.${extEle}   ${orbSav} f ",
    "${dirStd}${k}_${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirObx}${k}_${yyddd}.${extObx}   ${orbSav} f ",
    "${dirPre}${k}_${yyddd}.${extPre}   ${orbSav} f ", # to be replaced by ${k}N
    "${dirSnx}${k}_${yyddd}.${extSnx}   ${solSav} fz ", #changed c->z
    "${dirTro}${k}N${yyddd}.${extTro}   ${atmSav}${k}_${yyddd}.${extTro} fz ",#fc->fz
    "${dirSum}${k}W${yyddd}.${extSum}   ${outSav} _ ",

# STA2STA
    "${dirSta}IGS_CRX.${extSta}         ${staSav} f ",

    "${dirBpe}${prc}${yyssss}.LOG       ${bpeSav} o",
    "$dirCrd/$crdInf.${extCrd}          ${staSav}${crdInf}_$yyddd.${extCrd} _",
    "$dirVel/$crdInf.${extVel}          ${staSav}${crdInf}_$yyddd.${extVel} _",

  );

  if($sav eq "Y") {
    my(@err) = ();
    foreach(@cpyLst) {
      push(@err,"$_\n") if(&copy2archive(split(" ",$_),$tit));
    }
    die "\n *** copy2archive failed for\n @err\n" if(@err);
  }

# Optional files
  @cpyLst = (
    "${dirGrd}VMF${yyddd}.${extGrd}     ${grdSav} f ",
    "${dirNeq}${b}_${yyddd}.${extNeq}   ${solSav} z ",
    "${dirDcb}${b}_${yyddd}.${extDcb}   ${orbSav} f ",
# Other files
    "${dirOut}SDB${yyssss}.LST          ${outSav} _ ",    
    "${dirOut}HLMR${yyddd}.OUT          ${outSav} _ ",    
  );

  if ( $loading eq "VAPL" ) {
    push(@cpyLst,"${dirGrd}APL${yyddd}.${extGrd}     ${grdSav} f ");
  } elsif ( $loading eq "GFZ" ) {
    push(@cpyLst,"${dirGrd}NTAL_${yyddd}.${extGrd}     ${grdSav} f ");
    push(@cpyLst,"${dirGrd}NTOL_${yyddd}.${extGrd}     ${grdSav} f ");
    push(@cpyLst,"${dirGrd}HYDL_${yyddd}.${extGrd}     ${grdSav} f ");
  }

  if($sav eq "Y") {
    my(@err) = ();
    foreach(@cpyLst) {
      push(@err,"$_\n") if(&copy2archive(split(" ",$_),$tit));
    }
    print "\n ### copy2archive failed for\n @err\n" if(@err);

#    system("$ENV{AUTO}/changeLODsign.com ${solSav}/${k}_${yyddd}.${extSnx}.gz");
  }

# Some messages
# -------------
  if($sav ne "Y") {
    &prtMess($bpe,"FILES NOT SAVED");
    print       "\nFILES NOT SAVED\n";
  }

}

# ============================================================================

__END__
