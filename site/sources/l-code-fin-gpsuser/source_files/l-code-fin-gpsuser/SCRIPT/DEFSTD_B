package DEFSTD_B;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  DEFSTD_B
#
# Purpose :  Generate standard orbit with orbgen (from tabular or precise
#            orbits), in addition a precise file is created
#
# Programs:  ORBGEN, DEFXTR, STDPRE
#
# Author  :  M. Meindl
# Created :  03-Aug-2003               Last modified: 23-Jul-2008
#
# Changes :  09-Feb-2005 mm: Old date variables removed
#            23-Jul-2008 ps: Unique filenames
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($ddd,$yy,$ssss,$yyssss,$pid,$pcf,
      $dirOut,$dirSum,$extSum) =
      $bpe->getKeys(
      '$+0','$Y','$S+0','$YSS+0','PID','PCFFIL',
      "DIR_OUT","DIR_SUM","EXT_SUM");


# Run program
# -----------
  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);

  my $SYSOUT = $$bpe{SYSOUT};


# Check program run
# -----------------
  $bpe->putKey("$ENV{U}/PAN/DEFXTR.INP","JOBOUT",$SYSOUT);
  $PGMNAM = "DEFXTR";
  $bpe->RUN_PGMS($PGMNAM);


# Summary of program run for protocol
# -----------------------------------
  my $title = "ORBGEN (PID: $pid): " . timstr(localtime(time));
  appFile("$title",0,"${dirSum}DFX${yyssss}.${extSum}",
          "${dirOut}DEFXTR.${yy}_${ssss}",1);
  appFile("$title",0,"${dirSum}DFW${yyssss}.${extSum}",
          "${dirOut}DEFWKS.${yy}_${ssss}",1);


# Generate precise orbit file
# ---------------------------
  if($pcf eq "AMBRES"){
    $PGMNAM = "STDPRE";
    $bpe->RUN_PGMS($PGMNAM);
  }


}
