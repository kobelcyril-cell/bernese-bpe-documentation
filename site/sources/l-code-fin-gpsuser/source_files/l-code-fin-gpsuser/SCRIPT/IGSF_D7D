package IGSF_D7D;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  IGSF_D7D
#
# Purpose :  Deletion script for IGSFIN7D process
#
# PARAMs  :
#
# Author  :  S. Lutz
#
# Created :  20-Jun-2013
#
# Changes :  14-Sep-2001/SS: Remove F7 ERP file from GEN environment
#            10-Oct-2001/SS: Remove GCC file
#            04-Jan-2003/HU: Pole files in ORB instead of X/GEN
#            03-Apr-2003/ss: Remove F7 FIX file
#            28-Jul-2003/ss: Change from old to new BPE
#            10-Jun-2013 SL: BDS to Perl
#            09-Jul-2020 RD/AV: Remove 1-day solution
#            07-Apr-2022 ST: Remove DIR_AMB, EXT_AMB, DIR_BPE, EXT_BPE,
#                            DIR_BRD, EXT_BRD, DIR_CMP, EXT_CMP, DIR_ERR, EXT_ERR,
#                            DIR_LOG, EXT_LOG, DIR_ONQ, EXT_ONQ, DIR_ORB,
#                            DIR_PRC, EXT_PRC, DIR_PRT, EXT_PRT, DIR_SEL, EXT_SEL,
#                            DIR_TAB and EXT_TAB.
#
# ============================================================================

use strict;
use warnings;

use lib $ENV{BPE};
use bpe_util qw(prtMess);

sub run {

  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyssss,$yyyy,$yy,$yym1,$yym2,$yym8,$yym15,$yym30,$yym90,
    $ssss,$ssssm1,$ssssm2,$ssssm3,$ssssm8,$ssssm15,$ssssm30,
    $ddd,$dddm1,$dddm8,$dddm15,$dddm30,$dddm90,
    $yydddm8,$yydddm15,$yydddm30,$yydddm90,$yymm,
    $wwww,$wwwwm90,$wwwwdm30,
    $yyssssm2,$yyssssm8,$yyssssm15,$yyssssm30,$yyssssm90,
    $a,$h,$k,$u,$v,$x,$z,
    $del,
    $taskid,
    $dirBsl,$extBsl,
    $dirBpelog,$extBpelog,
    $dirBpeprt,$extBpeprt,
    $dirClb,$extClb,
    $dirClk,$extClk,
    $dirCrd,$extCrd,
    $dirDcb,$extDcb,
    $dirDel,$extDel,
    $dirEdt,$extEdt,
    $dirEle,$extEle,
    $dirErp,$extErp,
    $dirEst,$extEst,
    $dirFix,$extFix,
    $dirGcc,$extGcc,
    $dirGrd,$extGrd,
    $dirIep,$extIep,
    $dirIon,$extIon,
    $dirLst,$extLst,
    $dirNeq,$extNeq,
    $dirCzh,$extCzh,$dirCzo,$extCzo,
    $dirPzh,$extPzh,$dirPzo,$extPzo,
    $dirCsh,$extCsh,$dirCso,$extCso,
    $dirPsh,$extPsh,$dirPso,$extPso,
    $dirOxo,
    $dirOut,$extOut,
    $dirPlt,$extPlt,
    $dirPre,$extPre,
    $dirRxo,
    $dirRes,$extRes,
    $dirRpr,$extRpr,
    $dirSmc,$extSmc,
    $dirSme,$extSme,
    $dirSmt,$extSmt,
    $dirSnx,$extSnx,
    $dirStd,$extStd,
    $dirSum,$extSum,
    $dirTro,$extTro,
    $dirTrp,$extTrp,
  ) =
  $bpe->getKeys (
    '$YSS+0','$Y+0','$Y','$Y-1','$Y-2','$Y-8','$Y-(15)','$Y-(30)','$Y-(90)',
    '$S+0','$S-1','$S-2','$S-3','$S-8','$S-(15)','$S-(30)',
    '$+0','$-1','$-8','$-(15)','$-(30)','$-(90)',
    '$YD-8','$YD-(15)','$YD-(30)','$YD-(90)','$M+0',
    '$W+0','$W-(90)','$WD-(30)',
    '$YSS-2','$YSS-8','$YSS-(15)','$YSS-(30)','$YSS-(90)',
    'V_A','V_H','V_K','V_U','V_V','V_X','V_Z',
    'V_DEL',
    'TASKID',
    'DIR_BSL','EXT_BSL',
    'DIR_BPELOG','EXT_BPELOG',
    'DIR_BPEPRT','EXT_BPEPRT',
    'DIR_CLB','EXT_CLB',
    'DIR_CLK','EXT_CLK',
    'DIR_CRD','EXT_CRD',
    'DIR_DCB','EXT_DCB',
    'DIR_DEL','EXT_DEL',
    'DIR_EDT','EXT_EDT',
    'DIR_ELE','EXT_ELE',
    'DIR_ERP','EXT_ERP',
    'DIR_EST','EXT_EST',
    'DIR_FIX','EXT_FIX',
    'DIR_GCC','EXT_GCC',
    'DIR_GRD','EXT_GRD',
    'DIR_IEP','EXT_IEP',
    'DIR_ION','EXT_ION',
    'DIR_LST','EXT_LST',
    'DIR_NEQ','EXT_NEQ',
    'DIR_CZH','EXT_CZH','DIR_CZO','EXT_CZO',
    'DIR_PZH','EXT_PZH','DIR_PZO','EXT_PZO',
    'DIR_CSH','EXT_CSH','DIR_CSO','EXT_CSO',
    'DIR_PSH','EXT_PSH','DIR_PSO','EXT_PSO',
    'DIR_OXO',
    'DIR_OUT','EXT_OUT',
    'DIR_PLT','EXT_PLT',
    'DIR_PRE','EXT_PRE',
    'DIR_RXO',
    'DIR_RES','EXT_RES',
    'DIR_RPR','EXT_RPR',
    'DIR_SMC','EXT_SMC',
    'DIR_SME','EXT_SME',
    'DIR_SMT','EXT_SMT',
    'DIR_SNX','EXT_SNX',
    'DIR_STD','EXT_STD',
    'DIR_SUM','EXT_SUM',
    'DIR_TRO','EXT_TRO',
    'DIR_TRP','EXT_TRP',
  );

# Reformat year string
# --------------------
  $yym1  = substr($yym1,2,2);
  $yym2  = substr($yym2,2,2);
  $yym8  = substr($yym8,2,2);
  $yym15 = substr($yym15,2,2);
  $yym30 = substr($yym30,2,2);
  $yym90 = substr($yym90,2,2);

# List of files to be deleted
# ---------------------------
  my @delLst = (
    "${dirNeq}${x}?${wwwwm90}7.${extNeq}",
    "${dirGcc}${x}_${wwwwm90}7.${extGcc}",
    "${dirCrd}${x}?${wwwwm90}7.${extCrd}",
    "${dirErp}${x}_${wwwwm90}7.${extErp}",
    "${dirIep}${x}_${wwwwm90}7.${extIep}",
    "${dirSnx}${x}_${wwwwm90}7.${extSnx}",
    "${dirOut}${x}?${wwwwm90}7.${extOut}",
    "${dirPlt}${x}_${wwwwm90}7.${extPlt}",
    "${dirSum}${x}?${wwwwm90}7.${extSum}",
    "${dirLst}${x}?${wwwwm90}7.${extLst}",

    "${dirCrd}${z}_${wwwwm90}7.${extCrd}",
    "${dirFix}${z}_${wwwwm90}7.${extFix}",
    "${dirOut}${z}_${wwwwm90}7.${extOut}",
    "${dirPlt}${z}_${wwwwm90}7.${extPlt}",
    "${dirSum}${z}?${wwwwm90}7.${extSum}",
    "${dirLst}${z}_${wwwwm90}7.${extLst}",

    "${dirErp}COD${wwwwm90}7.${extErp}",
    "${dirSum}COD${wwwwm90}7.${extSum}",

    "${dirOut}AMUN${wwwwm90}.${extOut}",
    "${dirLst}SAT_${wwwwm90}.${extLst}",
    "${dirSum}SAT_${wwwwm90}.${extSum}",
    "${dirLst}SUM_${wwwwm90}.${extLst}",
    "${dirLst}COD${wwwwm90}?.${extLst}",
    "${dirLst}IGS_${wwwwm90}.${extLst}",
    "${dirSum}FIX_${wwwwm90}.${extSum}",
    "${dirSum}STA_${wwwwm90}.${extSum}",

# BPE files
    "${dirBpeprt}${taskid}${yyssssm8}_???_???.${extBpeprt}",
    "${dirBpelog}${taskid}${yyssssm8}_???_???.${extBpelog}",
  );

# Delete the files
# ----------------
  if($del eq "Y") {
    foreach(@delLst) {
      my(@f) = glob("$_");
      print "\n$_: ".scalar(@f)."\n";
      foreach my $f(@f) {
        next unless(-e $f);
        unlink($f);
        print "  $f removed\n";
      }
    }
  }

# Some messages
# -------------
  if($del ne "Y") {
    &prtMess($bpe,"FILES NOT DELETED (V_DEL=$del)");
    print       "\nFILES NOT DELETED (V_DEL=$del)\n";
  }

}

# ============================================================================

__END__
