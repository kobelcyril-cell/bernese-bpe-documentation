package MRG_ION;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  MRG_ION
#
# Purpose :  Create master ION file based on a set of cluster ION files.
#
# Programs:
#
# PARAMs  :  PARAM1 - GIM (1-day) solution identifier
#
# Remark  :
#
# Author  :  S. Schaer
# Created :  21-Oct-2014
#
# Changes :  22-Oct-2014 SS: Set $out
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ddd,
      $pcfFil, $param1,
      $dirIon ,$extIon, $dirNeq, $extNeq) =
    $bpe->getKeys('$YD+0', '$+0',
                  'PCFFIL', 'PARAM1',
                  'DIR_ION', 'EXT_ION', 'DIR_NEQ', 'EXT_NEQ');

  $param1 = $$bpe{"V_$param1"} if length($param1) == 1;
  $pcfFil = (split('\.',$pcfFil))[0];

# Execute merge_ion.com
# ---------------------
  my $inp = "${dirIon}GIM${ddd}";
  my $out = $param1 eq "" ? "${dirIon}GIM${ddd}000.${extIon}" : "${dirIon}${param1}_${yyddd}.${extIon}";
  system("$ENV{AUTO}/merge_ion.com $inp $out");

  die "$out not created\n" unless -s $out;

}

