use strict;

use File::Basename;
use File::Copy;

use lib "$ENV{AUTO}";
use igs_device;
use sta_util qw(initStaLst getNEU getREC getANT);

use lib "$ENV{EXE}";
use Gps_Date;

use lib "$ENV{BPE}";
use bpe_util qw(prtMess check_dir);


sub run {
  my $bpe = shift;


# Get variables
# -------------
 my   ($mjdE, $yyssss, $sta, $param2, $plt,
      $yyssm4, $yyssm3, $yyssm2, $yyssm1, $yyssm0,
      $c, $i, $k, $l, $n, $o,
      $dirPlt, $dirSum, $dirAbb, $dirSta, $dirCrd,
      $extPlt, $extSum, $extAbb, $extSta, $extCrd
      ) =
    $bpe->getKeys(
      '$JD+0','$YSS+0','PARAM1','PARAM2','V_PLT',
      '$YSS-4', '$YSS-3', '$YSS-2', '$YSS-1', '$YSS+0',
      'V_C','V_I','V_K','V_L','V_N','V_O',
      'DIR_PLT','DIR_SUM','DIR_ABB','DIR_STA','DIR_CRD',
      'EXT_PLT','EXT_SUM','EXT_ABB','EXT_STA','EXT_CRD'
      );

# 9chr sta
my $sta9chr=`grep \"${sta}00... " $ENV{REF}/CODE.STA | tail -1 | awk '{print substr(\$0,212,9)'}`;
chomp $sta9chr;

# Networks
my $stainfo=`grep \"^${sta} " $ENV{REF}/CODE_STA.SEL | head -1`;
chomp $stainfo;

# EUREF links
my $euref_info="";
if ($stainfo =~ /%euref/ ) {
  $euref_info="&nbsp;|&nbsp;<a href=\"https://www.epncb.oma.be/_networkdata/siteinfo4onestation.php?station=${sta}\" target=\"EUREF\" title=\"EUREF network for $sta\">EUR</a>&nbsp;|&nbsp;<a href=\"https://epncb.oma.be/_productsservices/timeseries/index.php?station=${sta}&update\" target=\"ECC\" title=\"EUREF time series for $sta\">ECC</a>";
}

# Which network processed
my %Net_links = (
  "1,RAP"   => "https://code.aiub.unibe.ch/code/rap.html",
  "2,CLK"   => "https://code.aiub.unibe.ch/code/clk.html",
  "3,ION"   => "https://code.aiub.unibe.ch/code/ion.html",
  "4,FIN"   => "https://code.aiub.unibe.ch/code/fin.html",
  "5,EPN"   => "https://code.aiub.unibe.ch/code/epn.html",
  "6,MGEX"  => "https://code.aiub.unibe.ch/code/mgx.html"
);
my $line_net="<tr><td><strong>Networks:</td><td></strong>&nbsp;<tt>";
my $ifirst=0;
foreach my $keya (sort keys %Net_links){
  my @KEYS=split(',',$keya);
  my $key=$KEYS[1];
  if ($stainfo =~ /%$key/) {
    if ($ifirst > 0) {
      $line_net.="&nbsp;|&nbsp;";
    }
    $line_net.="<a href=\"$Net_links{$keya}\" target=\"$key\" title=\"$key network for $sta\">$key</a>";
    $ifirst+=1;;
  }
}
$line_net.="</tt></td></tr>";


# Define the plot layout
# ----------------------
  my %GMT = ();
##  $GMT{COLOR}{PPP} = $$bpe{V_COLOR_PPP};# || "200/0/200";
##  $GMT{COLOR}{GNS} = $$bpe{V_COLOR_GNS};# || "200/0/0";
##  $GMT{COLOR}{GPS} = $$bpe{V_COLOR_GPS};# || "0/0/200";
##  $GMT{COLOR}{GLO} = $$bpe{V_COLOR_GLO};# || "0/180/0";
##  $GMT{COLOR}{GAL} = $$bpe{V_COLOR_GAL};# || "180/120/0";

##  $GMT{SYMBOL}{PPP} = $$bpe{V_SYMBOL_PPP};# || "c0.3";
##  $GMT{SYMBOL}{GNS} = $$bpe{V_SYMBOL_GNS};# || "c0.3";
##  $GMT{SYMBOL}{GPS} = $$bpe{V_SYMBOL_GPS};# || "c0.3";
##  $GMT{SYMBOL}{GLO} = $$bpe{V_SYMBOL_GLO};# || "c0.3";
##  $GMT{SYMBOL}{GAL} = $$bpe{V_SYMBOL_GAL};# || "c0.3";

##  $GMT{TEXT}{PPP} = $$bpe{V_TEXT_PPP};# || "GPS+GLO+GAL using code and phase data",
##  $GMT{TEXT}{GNS} = $$bpe{V_TEXT_GNS};# || "GPS+GLO+GAL using only phase data";
##  $GMT{TEXT}{GPS} = $$bpe{V_TEXT_GPS};# || "GPS-only using only phase data";
##  $GMT{TEXT}{GLO} = $$bpe{V_TEXT_GLO};# || "GLONASS-only using only phase data";
##  $GMT{TEXT}{GAL} = $$bpe{V_TEXT_GAL};# || "GALILEO-only using only phase data";

  $GMT{COLOR}{PPP} = "200/0/200";
  $GMT{COLOR}{GNS} = "200/0/0";
  $GMT{COLOR}{GPS} = "0/0/200";
  $GMT{COLOR}{GLO} = "0/180/0";
  $GMT{COLOR}{GAL} = "180/120/0";
  $GMT{COLOR}{KIN} = "200/0/0";

  $GMT{SYMBOL}{PPP} = "c0.3";
  $GMT{SYMBOL}{GNS} = "c0.3";
  $GMT{SYMBOL}{GPS} = "c0.3";
  $GMT{SYMBOL}{GLO} = "c0.3";
  $GMT{SYMBOL}{GAL} = "c0.3";
  $GMT{SYMBOL}{KIN} = "c0.1";

  $GMT{TEXT}{PPP} = "GPS+GLO+GAL using code and phase data",
  $GMT{TEXT}{GNS} = "GPS+GLO+GAL using only phase data";
  $GMT{TEXT}{GPS} = "GPS-only using only phase data";
  $GMT{TEXT}{GLO} = "GLONASS-only using only phase data";
  $GMT{TEXT}{GAL} = "GALILEO-only using only phase data";
  $GMT{TEXT}{KIN} = "GPS+GLO+GAL using only phase data";

# Is plotting requested?
# ----------------------
  if ( uc $plt ne "Y" ) {
    prtMess($bpe,"NO RESULTS ARE PLOTTED");

# Do the distribution
# -------------------
  } else {


# Read the PLT files:
# ------------------
    my %plt = ();
    my %sta = ();
    my @pltFiles = ( "${dirPlt}${c}${param2}series.${extPlt}",
                     "${dirPlt}${i}${param2}series.${extPlt}",
                     "${dirPlt}${k}${param2}series.${extPlt}",
                     "${dirPlt}${l}${param2}series.${extPlt}",
                     "${dirPlt}${o}${param2}series.${extPlt}");
    # Loop the files
    foreach my $pltFil ( @pltFiles ) {
      my $sol = substr(basename($pltFil),0,3);

      # read through the file
      open(PLT,$pltFil);
      while(<PLT>) {

        # Extract information from one line
        next unless substr($_,0,4) eq $sta;
        $sta{$sta}{NAM} = substr($_,0,16);
        my @rec = split();
        my $mjd = $rec[-4];
        my $val = $rec[-5];
        my $rms = $rec[-3];

        # Fill in the main record
        if ( $rec[-6] == 1 ) {         # North component
          $plt{$sta}{$sol}{$mjd}{Nval} = $val * 1000;
          $plt{$sta}{$sol}{$mjd}{Nrms} = $rms * 1000;
        } elsif ( $rec[-6] == 2 ) {    # East component
          $plt{$sta}{$sol}{$mjd}{Eval} = $val * 1000;
          $plt{$sta}{$sol}{$mjd}{Erms} = $rms * 1000;
        } else {                       # Up component
          $plt{$sta}{$sol}{$mjd}{Uval} = $val * 1000;
          $plt{$sta}{$sol}{$mjd}{Urms} = $rms * 1000;
        }
      }
      close PLT;
    } # End reading all PLT-files

# Create the plots for each station
# ---------------------------------
    my $frmt = "--PLOT_DATE_FORMAT=\"jjj\" ".
               "--TIME_INTERVAL_FRACTION=\"0.05\" ";
    my $xBox = "-JX20/5";     # Size of the diagrams
    my $Ymax = 30;            # Default scale for the horizontal components
    my $Vmax = 50;            # Default scale for the vertical component
    my $Ylab = 20;            # Default label for the horizontal components
    my $Vlab = 50;            # Default label for the vertical component
    my $Ytik = 10;            # Default thickmarks for the horizontal components
    my $Vtik = 10;            # Default thickmarks for the vertical component

    # Define start and end time
    my $mjdB = $mjdE-$param2-1;
    my $mjdE = $mjdE+1;
    my $datB = mjd2dat($mjdB);
    my $datE = mjd2dat($mjdE);

    # Prepare the station
    my $pltDir = "${PATH_WWW}${CAMP_SAVPPP}/$sta/";
    check_dir($pltDir);

    # Loop the solutions
    foreach my $sol ( keys %{$plt{$sta}} ) {


      my ( $myNmin, $myNmax, $Nmin, $Nmax, $Nlab, $Ntik,
           $myEmin, $myEmax, $Emin, $Emax, $Elab, $Etik,
           $myUmin, $myUmax, $Umin, $Umax, $Ulab, $Utik );

      # Make two plots
      for ( my $iPlot = 1; $iPlot <= 2; $iPlot++ ) {

        my $eps = $iPlot == 1 ? "${pltDir}PLT_${sta}_${sol}.ps" :
                  "${pltDir}PLT_${sta}_${sol}_0.ps";


        # First plot with the default settings:
        if ( $iPlot == 1 ) {
          $myNmin = -$Ymax;    $myNmax =  $Ymax;
          $myEmin = -$Ymax;    $myEmax =  $Ymax;
          $myUmin = -$Vmax;    $myUmax =  $Vmax;

          $Nmin = -$Ymax;   $Nmax = $Ymax;    $Nlab = $Ylab;    $Ntik = $Ytik;
          $Emin = -$Ymax;   $Emax = $Ymax;    $Elab = $Ylab;    $Etik = $Ytik;
          $Umin = -$Vmax;   $Umax = $Vmax;    $Ulab = $Vlab;    $Utik = $Vtik;
        }

        # Second plot with possibly adapted diagram boundaries
        if ( $iPlot == 2 ) {

          # north component
          if ( $myNmax - $myNmin > $Nmax - $Nmin ) {
            $Nmin = $myNmin;    $Nmax =  $myNmax;
            while ( ($Nmax - $Nmin) / $Nlab > 5 ) {
              $Nlab = $Nlab * 2; $Ntik = $Nlab/4; }
          }

          # East component
          if ( $myEmax - $myEmin > $Emax - $Emin ) {
            $Emin = $myEmin;    $Emax =  $myEmax;
            while ( ($Emax - $Emin) / $Elab > 5 ) {
              $Elab = $Elab * 2; $Etik = $Elab/4;  }
          }

          # Vertical component
          if ( $myUmax - $myUmin > $Umax - $Umin ) {
            $Umin = $myUmin;    $Umax =  $myUmax;
            while ( ($Umax - $Umin) / $Ulab > 5 ) {
              $Ulab = $Ulab * 2; $Utik = $Ulab/4;  }
          }
        }

        # frames
        my $rBoxX;
        my $rBoxY;
        my $randX;
        my $randY;

        # Vertical Component:
        # -------------------
        # define frames
        $rBoxX = "-R$datB/$datE/$Umin/$Umax";
        $rBoxY = "-R$mjdB/$mjdE/$Umin/$Umax";
        $randX = "-Ba5Df1dSn -Bsa1YSn ";
        $randY = "-Ba${Ulab}g10000000f${Utik}:\"Up [mm]\":We";

        # make the diagram
        system("psbasemap $xBox $rBoxY $randY -X5 -K > $eps");

        open(GMT,"| psxy $xBox $rBoxX $randX $frmt ".
                 "-S$GMT{SYMBOL}{$sol} -G$GMT{COLOR}{$sol} -N -K -O >> $eps");
        foreach my $mjd ( sort keys %{$plt{$sta}{$sol}} ) {
          my $val = $plt{$sta}{$sol}{$mjd}{Uval};
          if ( $iPlot == 1 ) {
            $myUmin = $val if ( $myUmin > $val );
            $myUmax = $val if ( $myUmax < $val );
            $val = $Umin if ( $val < $Umin );
            $val = $Umax if ( $val > $Umax );
          }
          print GMT mjd2dat($mjd)," ${val}\n";
        }
        close GMT;

        # add the legend
        open(GMT,"| pslegend -JX -R -Dx0/-1.5/20/2.0/tl -K -O >> $eps");
        print GMT "S 0 $GMT{SYMBOL}{$sol} - $GMT{COLOR}{$sol} - 0.5 $GMT{TEXT}{$sol}\n";
        close GMT;


        # East Component:
        # --------------
        # define frames
        $rBoxX = "-R$datB/$datE/$Emin/$Emax";
        $rBoxY = "-R$mjdB/$mjdE/$Emin/$Emax";
        $randX = "-Ba5Df1dsn";
        $randY = "-Ba${Elab}g10000000f${Etik}:\"East [mm]\":We";

        # make the diagram
        system("psbasemap $xBox $rBoxY $randY -Y5.5 -K -O >> $eps");
        open(GMT,"| psxy $xBox $rBoxX $randX $frmt ".
                 "-S$GMT{SYMBOL}{$sol} -G$GMT{COLOR}{$sol} -N -K -O >> $eps");
        foreach my $mjd ( sort keys %{$plt{$sta}{$sol}} ) {
          my $val = $plt{$sta}{$sol}{$mjd}{Eval};
          if ( $iPlot == 1 ) {
            $myEmin = $val if ( $myEmin > $val );
            $myEmax = $val if ( $myEmax < $val );
            $val = $Emin if ( $val < $Emin );
            $val = $Emax if ( $val > $Emax );
          }
          print GMT mjd2dat($mjd)," ${val}\n";
        }
        close GMT;


        # North Component:
        # ----------------
        # define frames
        $rBoxX = "-R$datB/$datE/$Nmin/$Nmax";
        $rBoxY = "-R$mjdB/$mjdE/$Nmin/$Nmax";
        $randX = "-Ba5Df1d/10sN";
        $randY = "-Ba${Nlab}g10000000f${Ntik}:\"North [mm]\"::.\"Station $sta{$sta}{NAM}\":We " .
                    "--HEADER_FONT_SIZE=\"18\" --HEADER_OFFSET=\"1.2c\"";

        # make the diagram
        system("psbasemap $xBox $rBoxY $randY -Y5.5 -K -O >> $eps");
        open(GMT,"| psxy $xBox $rBoxX $randX $frmt ".
                 "-S$GMT{SYMBOL}{$sol} -G$GMT{COLOR}{$sol} -N -O >> $eps");
        foreach my $mjd ( sort keys %{$plt{$sta}{$sol}} ) {
          my $val = $plt{$sta}{$sol}{$mjd}{Nval};
          if ( $iPlot == 1 ) {
            $myNmin = $val if ( $myNmin > $val );
            $myNmax = $val if ( $myNmax < $val );
            $val = $Nmin if ( $val < $Nmin );
            $val = $Nmax if ( $val > $Nmax );
          }
          print GMT mjd2dat($mjd)," ${val}\n";
        }
        close GMT;


        # Set the bounding box
        system("ps2raster -A -P -Teg $eps");
        unlink($eps);
      }
    }

#
# Make long KIN plots (with 07 days daily GNS repeatabiliy)
# ---------------------------------------------------------
    my $sta_l=lc($sta);
# sampling to 900 sec (15 min)
#    system ("$ENV{AUTO}/kin2plt.pl -f \"${dirSum}${n}????${sta}.${extSum}\" -interval 900 -o $sta.${extPlt}");
# full sampling (5 min)
    system ("$ENV{AUTO}/kin2plt.pl -f \"${dirSum}${n}????${sta}.${extSum}\"  -o ${sta}_KIN.${extPlt}");
    system ("$ENV{AUTO}/crd_rep.pl -f  ${sta}_KIN.${extPlt} -comp ${dirPlt}${i}07series.${extPlt}  -c 4  -yrange \"30/30\" -urange \"60/60\" -timetyp DOY -rms -m -o eps 2>/dev/null");
    system ("$ENV{AUTO}/img2img.pl  -source . -file ${sta_l} -inp eps  -target $pltDir -add _kin -resolution 90 -v");
    move("${sta}_KIN.PLT","${dirSum}");
    move("${sta_l}.eps","${pltDir}${sta_l}_kin.eps");

# Make the Web-page for the station
# ---------------------------------
    # Prepare some variables/filenames
    my $abbFil = "${dirAbb}CODE.${extAbb}";
    my $staFil = "${dirSta}CODE.${extSta}";
    my $crdFil = "${dirCrd}${c}${yyssss}.${extCrd}";
    initStaLst(abb=>$abbFil, crd=>$crdFil, sta=>$staFil);

    my $html   = "${pltDir}${sta}.html";
    my $title  = "Results for $sta";
    my @blh    = getNEU($sta);

    my $now    = gps_date("-t -o %U");
    my $delay = 14 * 86400;   # 2 weeks
    my $delaymonth = 30 * 86400;   # 1 month
    my $delay3month = 3 * $delaymonth ;   # 3 month

    # Make the web-page
    open(WWW,"> $html");
    print WWW "<!DOCTYPE html>\n";
    print WWW "<html>\n";
    print WWW "<head>\n";
    print WWW "<link rel=\"stylesheet\" href=\"../../code/general/ppp_style.css\">\n";
    print WWW "</head>\n";
    print WWW "<body>\n";
    print WWW "<h1>$title<a name=\"top\"></h1>\n";
    print WWW "<table><tr><td>\n";
    print WWW "<p><table>\n";
    print WWW "<tr><td><strong>Station name:</td><td></strong>&nbsp;<tt>" . $sta . "</tt></td></tr>\n";
    print WWW "<tr><td><strong>Location:</td><td></strong>&nbsp;<tt><a href=\"https://www.google.com/maps?q=$blh[0],$blh[1]&ll=$blh[0],$blh[1]&z=4\" target=\"Map\" title=\"location of $sta\" >Map</a>&nbsp;|&nbsp;<a href=\"https://code.aiub.unibe.ch/code/general/api3_focus_google.html?f=https://code.aiub.unibe.ch/PPP/plt.kml&n=$blh[0]&e=$blh[1]&z=7\" target=\"KML\" title=\"KML zoom to $sta\" >KML</a></tt></td></tr>\n";
    print WWW "<tr><td><strong>Info:</td><td></strong>&nbsp;<tt><a href=\"https://network.igs.org/${sta9chr}\" target=\"IGS\" title=\"IGS info for $sta\" >IGS</a>&nbsp;|&nbsp;<a href=\"https://webigs-rf.ign.fr/stations/${sta}\" target=\"ACC\" title=\"ACC info for $sta\" >ACC</a>${euref_info}</tt></td></tr>\n";
    print WWW "${line_net}\n";
    print WWW "<tr><td><strong>Receiver type:</td><td></strong>&nbsp;<tt>" . getREC($sta) . "</tt></td></tr>\n";
    print WWW "<tr><td><strong>Antenna type:</td><td></strong>&nbsp;<tt>" . getANT($sta) . "</tt></td></tr>\n";
    print WWW "</table></p>\n";
    print WWW "</td><td></tr></table>\n";

    print WWW "<table><tr><td>\n";
    print WWW "<p><table>\n";
    print WWW "<tr><td><strong>PPP-GNS:</td><td></strong>&nbsp;<a href=\"#PPP_GNS\">PPP by satellite system</a></td></tr>\n";
    print WWW "<tr><td><strong>PPP-KIN:</td><td></strong>&nbsp;<a href=\"#GNS_KIN\">PPP-GNS kinematic</a></td></tr>\n";
    print WWW "<tr><td><strong>PPP-Check:</td><td></strong>&nbsp;<a href=\"#GNS_OUTLIER\">Outlier detection</a></td></tr>\n";
    print WWW "<tr><td><strong>RAP/FIN/EPN-Check (1 month):</td><td></strong>&nbsp;<a href=\"#DIFF_OUTLIER\">Outlier detection</a></td></tr>\n";
    print WWW "<tr><td><strong>RAP/FIN-Check (3 months):</td><td></strong>&nbsp;<a href=\"#RAPM_OUTLIER\">Outlier detection</a></td></tr>\n";
    print WWW "<tr><td><strong>FIN/MGEX ISTPs 1D (3 months):</td><td></strong>&nbsp;<a href=\"#ISTP_3MON\">Inter-System Translation Parameters</a></td></tr>\n";
    print WWW "<tr><td><strong>FIN/MGEX ISTPs 1D (long):</td><td></strong>&nbsp;<a href=\"#ISTP_ALL\">Inter-System Translation Parameters</a></td></tr>\n";
    print WWW "<tr><td><strong>COD-IGS diffs (1 year):</td><td></strong>&nbsp;<a href=\"#ACC_COD_ANNUAL\">COD-IGS + other ACs</a></td></tr>\n";
    print WWW "<tr><td><strong>COD-IGS diffs / IGS repeat. (all years):</td><td></strong>&nbsp;<a href=\"#ACC_COD\">Long-time series</a></td></tr>\n";
    print WWW "</table></p>\n";
    print WWW "</td><td></tr></table>\n";


    print WWW "<p>Go to: <a href=\"../ppp.html\">most recent PPP solution</a> or <a href=\"../plt.html\">time series from the recent PPP solutions</a>.</p>\n";

    print WWW "<table bgcolor=\"#FFC300\" width=\"600\">\n";
    print WWW "  <tr>\n";
    print WWW "    <td>\n";
    print WWW "      &#160;\n";
    print WWW "      <a href=\"#top\"><img src=\"../../code/general/up.gif\" width=\"14\" height=\"10\" border=\"0\" alt=\"top\"></a>\n";
    print WWW "      <a href=\"#bottom\"><img src=\"../../code/general/down.gif\" width=\"14\" height=\"10\" border=\"0\" alt=\"down\"></a>\n";
    print WWW "      &#160;\n";
    print WWW "    </td>\n";
    print WWW "  </tr>\n";
    print WWW "</table>\n";

    print WWW "<h2><a name=\"PPP_GNS\"></a>Stability of the recent PPP solutions:</h2>\n";
    print WWW "<p><table cellspacing=\"30\"><tr><td>\n";
    if ( -s "${pltDir}PLT_${sta}_GNS_0.png" && ($now - (stat("${pltDir}PLT_${sta}_GNS_0.png"))[9] < $delay) ) {
      print WWW "<A onclick=\"window.open('PLT_${sta}_GNS_0.png','','toolbar=0,location=0,directories=0,status=0,menubar=0,scrollbars=1,resizable=0,width=800,height=600'); return false;\" href=\"PLT_${sta}_GNS_0.png\"><IMG src=\"PLT_${sta}_GNS.png\" border=0 width=\"100%\"></A>\n";
    }
    print WWW "</td><td>\n";
    if ( -s "${pltDir}PLT_${sta}_PPP_0.png" && ($now - (stat("${pltDir}PLT_${sta}_PPP_0.png"))[9] < $delay) ) {
      print WWW "<A onclick=\"window.open('PLT_${sta}_PPP_0.png','','toolbar=0,location=0,directories=0,status=0,menubar=0,scrollbars=1,resizable=0,width=800,height=600'); return false;\" href=\"PLT_${sta}_PPP_0.png\"><IMG src=\"PLT_${sta}_PPP.png\" border=0 width=\"100%\"></A>\n";
    }
    print WWW "</td></tr><tr><td>\n";
    if ( -s "${pltDir}PLT_${sta}_GPS_0.png" && ($now - (stat("${pltDir}PLT_${sta}_GPS_0.png"))[9] < $delay) ) {
