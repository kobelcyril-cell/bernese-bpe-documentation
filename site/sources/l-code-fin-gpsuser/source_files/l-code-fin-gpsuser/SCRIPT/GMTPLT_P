      }
      print WWW "</td></tr>\n";
    }
# close table
    print WWW "</table></p>\n";

    print WWW "<table bgcolor=\"#FFC300\" width=\"600\">\n";
    print WWW "  <tr>\n";
    print WWW "    <td>\n";
    print WWW "      &#160;\n";
    print WWW "      <a href=\"#top\"><img src=\"../../code/general/up.gif\" width=\"14\" height=\"10\" border=\"0\" alt=\"top\"></a>\n";
    print WWW "      <a href=\"#bottom\"><img src=\"../../code/general/down.gif\" width=\"14\" height=\"10\" border=\"0\" alt=\"down\"></a>\n";
    print WWW "      &#160;\n";
    print WWW "    </td>\n";
    print WWW "  </tr>\n";
    print WWW "</table>\n";

    print WWW "<address>\n";
    print WWW "Page last modified: ".&gps_date("-t -o %z")." UT<a name=\"bottom\">\n";
    print WWW "</address>\n";
    print WWW "</body>\n";
    print WWW "</html>\n";
    close WWW;

  }

}

  sub mjd2dat() {
      my $mjd = shift;
      my $dat = gps_date("-mjd $mjd","-o %XT");
      return $dat;
  }

