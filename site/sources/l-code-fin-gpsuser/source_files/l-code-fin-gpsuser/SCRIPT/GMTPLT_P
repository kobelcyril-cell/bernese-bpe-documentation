      }
      print WWW "</td><td>\n";
      if ( -s "${PATH_WWW}code/plots_acc/${sta_l}_igs.png" && ($now - (stat("${PATH_WWW}code/plots_acc/${sta_l}_igs.png"))[9] < $delay3month)) {
