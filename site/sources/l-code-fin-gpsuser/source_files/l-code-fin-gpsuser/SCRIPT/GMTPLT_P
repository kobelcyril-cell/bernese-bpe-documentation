          $n_acs++;
        }
      }
      if ($n_acs==0) {
        print WWW "none\n";
      }
      print WWW "</td><td align=left nowrap>\n";
      print WWW "</td></tr>\n";
      print WWW "<br>\n";

      print WWW "<tr><td align=left colspan=\"2\" nowrap>\n";
