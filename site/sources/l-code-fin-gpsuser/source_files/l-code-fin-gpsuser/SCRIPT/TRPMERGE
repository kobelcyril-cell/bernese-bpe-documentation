package TRPMERGE;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  TRPMERGE
#
# Purpose :  Merge TRP-files
#
# Programs:
#
# Author  :  R. Dach
# Created :  06-Dec-2007
#
# Changes :  22-Oct-2016 AV: Added FCLK3
#            17-Nov-2016 AV: Added FCLK1
#            23-Nov-2016 AV: Added FHK1D and FHK3D
#            07-Sep-2018 AV: Adjusted FHK1D and FHK3D
#            15-May-2020 LP: Allow for individual header size determined by &getTropHeadInf
#
# ----------------------------------------------------------------------------

use strict;

use lib "$ENV{AUTO}";
use gpsutil;
use statistics_util;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yyssss, $ssss,
      $v_k, $v_u, $v_o, $v_f, $v_g, $v_l, $v_r, $v_c, $v_p, $v_s,
      $v_q, $v_n, $v_uu, $v_oo, $v_rr, $v_cc,
      $dirTrp,  $extTrp, $par1) = $bpe->getKeys(
      '$YD+0','$YSS+0','$S+0',
      'V_K','V_U','V_O','V_F','V_G','V_L','V_R','V_C','V_P','V_S',
      'V_Q','V_N','V_UU','V_OO','V_RR','V_CC',
      'DIR_TRP','EXT_TRP','PARAM1');

  my $trpFin = "";
  my $trpClk = "";
  my $trpAll = "";


# Clocks 3D (COD)
# ---------------
  if ($par1 eq 'CLK3D'){
    $trpFin = "${dirTrp}/${v_k}_$yyddd.${extTrp}";
    $trpClk = "${dirTrp}/${v_u}_$yyddd.${extTrp}";
    $trpAll = "${dirTrp}/${v_o}_$yyddd.${extTrp}";
  }


# Clocks 3D, for version 5.2
# --------------------------
  if ($par1 eq 'CLK3X'){
    $trpFin = "${dirTrp}/${v_k}_$yyddd.${extTrp}";
    $trpClk = "${dirTrp}/${v_uu}_$yyddd.${extTrp}";
    $trpAll = "${dirTrp}/${v_oo}_$yyddd.${extTrp}";
  }


# Clocks 1D (COF)
# ---------------
  if ($par1 eq 'CLK1D'){
    $trpFin = "${dirTrp}/${v_f}_$yyddd.${extTrp}";
    $trpClk = "${dirTrp}/${v_g}_$yyddd.${extTrp}";
    $trpAll = "${dirTrp}/${v_l}_$yyddd.${extTrp}";
  }


# High-rate 3D: COD
# ---------------
  if ($par1 eq 'HCK3D'){
    $trpFin = "${dirTrp}/${v_o}_$yyddd.${extTrp}";
    $trpClk = "${dirTrp}/${v_r}_$yyddd.${extTrp}";
    $trpAll = "${dirTrp}/${v_c}_$yyddd.${extTrp}";
  }

# High-rate 3D: V52
# ---------------
  if ($par1 eq 'HCK3X'){
    $trpFin = "${dirTrp}/${v_oo}_$yyddd.${extTrp}";
    $trpClk = "${dirTrp}/${v_rr}_$yyddd.${extTrp}";
    $trpAll = "${dirTrp}/${v_cc}_$yyddd.${extTrp}";
  }

# High-rate 1D: COF
# ---------------
  if ($par1 eq 'HCK1D'){
    $trpFin = "${dirTrp}/${v_l}_$yyddd.${extTrp}";
    $trpClk = "${dirTrp}/${v_p}_$yyddd.${extTrp}";
    $trpAll = "${dirTrp}/${v_s}_$yyddd.${extTrp}";
  }

# FCLKGNSS
# ---------------
  if ($par1 eq 'TST12'){
    $trpFin = "${dirTrp}/${v_k}_$yyddd.${extTrp}";
    $trpClk = "${dirTrp}/${v_k}1$yyssss.${extTrp}";
    $trpAll = "${dirTrp}/${v_k}2$yyssss.${extTrp}";
  }

# FCLKGNSS
# ---------------
  if ($par1 eq 'TST34'){
    $trpFin = "${dirTrp}/${v_k}_$yyddd.${extTrp}";
    $trpClk = "${dirTrp}/${v_k}3$yyssss.${extTrp}";
    $trpAll = "${dirTrp}/${v_k}4$yyssss.${extTrp}";
  }

# FCLKGNSS
# ---------------
  if ($par1 eq 'TST56'){
    $trpFin = "${dirTrp}/${v_k}_$yyddd.${extTrp}";
    $trpClk = "${dirTrp}/${v_k}5$yyssss.${extTrp}";
    $trpAll = "${dirTrp}/${v_k}6$yyssss.${extTrp}";
  }

# FCLKGNSS
# ---------------
  if ($par1 eq 'TST89'){
    $trpFin = "${dirTrp}/${v_k}_$yyddd.${extTrp}";
    $trpClk = "${dirTrp}/${v_k}8$yyssss.${extTrp}";
    $trpAll = "${dirTrp}/${v_k}9$yyssss.${extTrp}";
  }

# FCLKGNSS
# ---------------
  if ($par1 eq 'FCLK3'){
    $trpFin = "${dirTrp}/${v_k}_$yyssss.${extTrp}";
    $trpClk = "${dirTrp}/${v_u}E$yyssss.${extTrp}";
    copyfile($trpClk,"${dirTrp}/${v_u}1$yyssss.${extTrp}");
    $trpAll = "${dirTrp}/${v_u}_$yyssss.${extTrp}";
  }
  if ($par1 eq 'FCLK1'){
    $trpFin = "${dirTrp}/${v_f}_$yyssss.${extTrp}";
    $trpClk = "${dirTrp}/${v_g}E$yyssss.${extTrp}";
    $trpAll = "${dirTrp}/${v_g}_$yyssss.${extTrp}";
  }
  if ($par1 eq 'FHK3D'){
    $trpFin = "${dirTrp}/${v_u}_$yyssss.${extTrp}";
    $trpClk = "${dirTrp}/${v_q}_$yyssss.${extTrp}";
    $trpAll = "${dirTrp}/${v_c}_$yyssss.${extTrp}";
  }
  if ($par1 eq 'FHK1D'){
    $trpFin = "${dirTrp}/${v_g}_$yyssss.${extTrp}";
    $trpClk = "${dirTrp}/${v_n}_$yyssss.${extTrp}";
    $trpAll = "${dirTrp}/${v_s}_$yyssss.${extTrp}";
  }
# PPP
# ---
  if (substr($par1,0,3) eq 'PPP'){
    my $sol = $$bpe{substr($par1,4)};
    $trpFin = "${dirTrp}/${sol}${ssss}????.${extTrp}";
    $trpAll = "${dirTrp}/${sol}$yyssss.${extTrp}";
    my $trpTmp = "${dirTrp}/${sol}$yyssss.${extTrp}_tmp";

    print "$par1 - inp 1: trpFin = $trpFin\n";
    print "$par1 - out  : trpAll = $trpAll\n";
    print "$par1 - tmp  : trpTmp = $trpTmp\n";

    foreach my $trpFil ( sort glob "${trpFin}" ) {
      if (! -e $trpTmp) {
        copyfile($trpFil,$trpTmp);
      } else {
        my ($ERR_STATE1,$tropFileVers1,$nHeadLines1,$numEpoTrop1) = &getTropHeadInf($trpTmp);
        my ($ERR_STATE2,$tropFileVers2,$nHeadLines2,$numEpoTrop2) = &getTropHeadInf($trpFil);

        system ("$ENV{AUTO}/filmerge.pl $trpTmp $trpFil $trpAll $nHeadLines1 1 $nHeadLines2");
        copyfile($trpAll,$trpTmp);
      }
    }
    unlink $trpTmp;


# Merge the files
# ---------------
  } else {
    print "$par1 - inp 1: trpFin = $trpFin\n";
    print "$par1 - inp 2: trpClk = $trpClk\n";
    print "$par1 - out  : trpAll = $trpAll\n";
    if ($trpFin ne "" && $trpClk ne "" && $trpAll ne "" ) {
      my ($ERR_STATE1,$tropFileVers1,$nHeadLines1,$numEpoTrop1) = &getTropHeadInf($trpFin);
      my ($ERR_STATE2,$tropFileVers2,$nHeadLines2,$numEpoTrop2) = &getTropHeadInf($trpClk);

      system ("$ENV{AUTO}/filmerge.pl $trpFin $trpClk $trpAll $nHeadLines1 1 $nHeadLines2");
    }
  }
}
