package RESDEF;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RESDEF
#
# Purpose :  Last line of defence against evil PPP observation files.
#            Screen residuals and remove bad stations
#
# PARAMs  :
#
# Author  :  A. Villiger
# Created :  15-Dec-2016
#
# Changes :  13-Feb-2016 AV: Store number of bad obs-files (V_MISOBS)
#            29-Apr-2019 AV: Remove stations with more than 300 ambiguities
#
# ============================================================================

use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyyy, $yy,  $ssss,  $yyssss,$v_i,
      $dirSum, $dirCzh,$dirOut, $extSum,$extOut) =
  $bpe->getKeys(
      '$Y+0','$Y', '$S+0', '$YSS+0','V_I',
      'DIR_SUM', 'DIR_CZH', 'DIR_OUT','EXT_SUM', 'EXT_OUT');
#
# Run GPSXTR
# ----------
  my $PGMNAM = "GPSXTR";
  $bpe->RUN_PGMS($PGMNAM);

# Run RESRMS
# ---------------
  $PGMNAM = "RESRMS";
  $bpe->RUN_PGMS($PGMNAM);

# Get summary file
# ----------------
  my $sumfil = $bpe->getKey("$ENV{U}/INP/RESRMS.INP","OUTPUT");

# Check for the bad stations
# --------------------------
  if(-e $sumfil){
    $PGMNAM = "RESCHK";
    $bpe->RUN_PGMS($PGMNAM);
    my $shortsum = $bpe->getKey("$ENV{U}/INP/RESCHK.INP","SUMOUT");
    my $delsta   = $bpe->getKey("$ENV{U}/INP/RESCHK.INP","DELSTA");

# Delete the guilty stations!
# ---------------------------
    my %bad;
    my $delObs = 0;
    if( -s $delsta){
      open DEL, "< $delsta";
      foreach (<DEL>){
        chomp;
        unlink glob $_;
        $bad{$1} = 1 if(/(\w\w\w\w)${ssss}\.\w\w\w/);
        print "unlink $1 $_\n";
        $delObs++;
      }
      close DEL;
    }
# Check for exceeding MAXAMB
# --------------------------
    my @outfil = glob "$dirOut/${v_i}P${ssss}????.$extOut";
    print "SEARCH: $dirOut/${v_i}P${ssss}????.$extOut\n";
    my %maxamb;
    foreach my $filout (@outfil){
      my $sta = "";
      if($filout=~/${ssss}(\w\w\w\w)\.OUT/){
        $sta = $1;
      }
      open INP, " < $filout";
      foreach my $line (<INP>){
        if($line=~/^ AMBIGUITIES                              *(\d*) /){
          $maxamb{$sta} = $1;
        }
        if($line=~/^ Ambiguities                              *(\d*) /){
          $maxamb{$sta} = $1;
        }
      }
      close INP;
    }
    foreach my $sta (sort keys %maxamb){
      if($maxamb{$sta} > 300){
          printf "AMB: %4s  % 4i exceeded\n", $sta, $maxamb{$sta};
          unlink glob "${dirCzh}$sta${ssss}.???";
          $delObs++;
      }else{
          printf "AMB: %4s  % 4i\n", $sta, $maxamb{$sta};
      }
    }

# Delete manually sations
# -----------------------
    my @mandel;
    if(${yyssss} eq "170580_"){
      push @mandel, "${dirCzh}NAIN${ssss}.???";
      push @mandel, "${dirCzh}UNBD${ssss}.???";
    }
    foreach (@mandel){
      unlink glob $_;
      $bad{$1} = 2 if(/(\w\w\w\w)${ssss}\./);
      print "unlink $1 $_\n";
      $delObs++
    }

# Set variable for later PRC generation
# -------------------------------------
    if(1==2){
      $bpe->setVar("MISOBS",$delObs);
    }

# Mark delted stations in SUM file
# --------------------------------
    copyfile($sumfil, "${sumfil}_tmp");
    open INP, "< ${sumfil}_tmp";
    open OUT, "> $sumfil";
    foreach (<INP>){
      chomp;
      if(/^ (\w\w\w\w)......${ssss}/){
        print "0:$_\n";
        s/ ${ssss}/ DEL / if(exists $bad{$1} && $bad{$1} == 1);
        s/ ${ssss}/ MDEL/ if(exists $bad{$1} && $bad{$1} == 2);
      }
      print OUT "$_\n";
    }
    close INP;
    close OUT;
    unlink "${sumfil}_tmp";
  }

}

