package COMPAR2;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  COMPAR2
#
# Purpose :  Compare bernese coordinate files of last 7 days
#
# Programs:  COMPAR2
#
# Author  :  M. Meindl
# Created :  03-Aug-2003               Last modified: 22-Jul-2008
#
# Changes :  30-Mar-2006 mm: setPlusMinus replaced by setMinusPlus
#            22-Jul-2008 PS/RD: prepare for reprocesing
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($camp_pth, $campaign) = $bpe->getKeys('CAMP_PTH','CAMPAIGN');

# Skip the script in case of reprocessing
# ---------------------------------------
  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");
  unless ($repro) {

# Set 7-day overlap
# -----------------
##    setPlusMinus($bpe,0,-6);
    setMinusPlus($bpe,-6,0);


# Run program
# -----------
    my $PGMNAM = "COMPAR2";
    $bpe->RUN_PGMS($PGMNAM);

  } # end of non-reprocessing

}
