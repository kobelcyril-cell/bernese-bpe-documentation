package CLN_CAL;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  CLN_CAL
#
# Purpose :  Clean up bias calibration files
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  21-Jun-2016
#
# Changes :  26-Oct-2016/ss: Unlink .RES files
#
# ============================================================================
use strict;

use File::Basename;

use lib $ENV{BPE};
use bpe_util qw(prtErr initPar_Bl);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ddd, $yyddd, $ssss,
      $dirBpe,
      $dirCzh, $dirOut, $dirBia, $dirIon, $dirOsb, $dirNeq, $dirRes,
      $extCzh, $extOut, $extBia, $extIon, $extOsb, $extNeq, $extRes) =
  $bpe->getKeys
     ('$+0', '$YD+0', '$S+0',
      'DIR_BPEPRT',
      'DIR_CZH', 'DIR_OUT', 'DIR_BIA', 'DIR_ION', 'DIR_OSB', 'DIR_NEQ', 'DIR_RES',
      'EXT_CZH', 'EXT_OUT', 'EXT_BIA', 'EXT_ION', 'EXT_OSB', 'EXT_NEQ', 'EXT_RES');

# Delete old files (OUT, SMC)
# ---------------------------
  unlink glob("${dirOut}????${ssss}_*.${extOut}");
  unlink glob("${dirNeq}????${ssss}_*.${extNeq}");
  unlink glob("${dirIon}????${ssss}_.${extIon}");
  unlink glob("${dirOsb}????${ssss}_.${extOsb}");
  unlink glob("${dirBia}????${ssss}_.${extBia}");
  unlink glob("${dirRes}????${ssss}_.${extRes}");

}
