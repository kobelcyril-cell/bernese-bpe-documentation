package WEEKPRE;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  WEEKPRE
#
# Purpose :  Set/change orbit accuracy codes in precise orbit files of a
#            completed week
#
# Programs:  PREWEI
#
# Author  :  S. Schaer
# Created :  16-Oct-2012
#
# Changes :  25-Oct-2012/ss: Save updated PRE files
#            29-Mar-2018/rd/ss: Handle SP3d PRE filenames
#            ??-???.???? ??: Modification using BRD
#            06-Dec-2019 av: Bugfix satellite clock name
#            22-Apr-2020 RD: Remove the 1-day part
#            24-Nov-2022 SS: Retrieved second midnight epoch
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $wwwwd, $wwww,  $dayWeek, $preClk, $v_o, $upd, $sav,
      $dirOut, $dirLst, $extLst, $dirClk, $extClk) =
    $bpe->getKeys('$YD+0', '$WD+0', '$W+0', 'DAYWEEK', 'V_PRECLK','V_O', 'V_UPD', 'V_SAV',
                  'DIR_OUT', 'DIR_LST', 'EXT_LST', 'DIR_CLK','EXT_CLK');

  if ($dayWeek == 6 && $upd eq "Y") {
    my $lstFil = "${dirLst}IGS_${wwww}.${extLst}";
    if (-s $lstFil) {
      $bpe->putKey("$ENV{U}/PAN/PREWEI.INP","LIST",'IGS_$W+0');
      prtMess($bpe,"LST file used: ${dirLst}IGS_${wwww}.${extLst}");
    } else {
##      $bpe->putKey("$ENV{U}/PAN/PREWEI.INP","LIST",'COD$WD+0');
##      prtMess($bpe,"LST file used: ${dirLst}COD${wwwwd}.${extLst}");
      prtMess($bpe,"IGS_${wwww}.LST NOT FOUND");
      die "IGS_${wwww}.LST NOT FOUND\n";
    }

  # Check if reprofile exists
  if( $preClk eq "BRD" ){
    my $stdpre = "$ENV{U}/PAN/STDPRE.INP";
    my $satclk = "B1_$yyddd";
    $bpe->putKey($stdpre,"SATCLK",$satclk);
    $bpe->putKey($stdpre,"TITLE2","Final GPS orbits and clocks for year-day $yyddd");
    $bpe->putKey($stdpre,"TITLE3","Note: Middle day of a 3-day arc/BRD clocks");
    $bpe->putKey($stdpre,"CLKINFO","BRD");
  }

# Run programs
# ------------
    my $PGMNAM = "STDPRE";
    $bpe->RUN_PGMS($PGMNAM);

    $PGMNAM = "PREWEI";
    $bpe->RUN_PGMS($PGMNAM);

    my ($i,$yyyy,$ssss,$mm,$dd,$mjd,$nam,$savFil);
    for ($i=0;$i<=6;$i++) {
      ($yyddd,$yyyy,$ssss,$mm,$dd,$mjd) = gps_date("-wd $wwww$i -o %y%j %Y %j0 %m %d %IJ");

      $nam = $bpe->getKey("$ENV{U}/INP/STDPRE.INP","STDORB");
      $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","STDORB",substr(basename($nam),0,3).$yyddd);
      $nam = $bpe->getKey("$ENV{U}/INP/STDPRE.INP","IMPELE");
      $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","IMPELE",substr(basename($nam),0,3).$yyddd);
      if( $preClk eq "BRD" ){
        $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","SATCLK","B1_".$yyddd);
      } else {
        $nam = $bpe->getKey("$ENV{U}/INP/STDPRE.INP","SATCLK");
        my $namclk = ${dirClk} . substr(basename($nam),0,4)."$yyddd.${extClk}";
        $nam = $v_o unless -e $namclk;
        $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","SATCLK",substr(basename($nam),0,4).$yyddd);
      }
      $nam = $bpe->getKey("$ENV{U}/INP/STDPRE.INP","POLE");
      $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","POLE",substr(basename($nam),0,3).$yyddd);
      $nam = $bpe->getKey("$ENV{U}/INP/STDPRE.INP","PREOUT");
      $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","PREOUT",substr(basename($nam),0,-9).$yyddd);

##      $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","SESSION_YEAR",$yyyy);
##      $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","SESSION_STRG",$ssss);
      $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","STADAT","$yyyy $mm $dd");
      $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","ENDDAT","$yyyy $mm $dd");

# Retrieved second midnight epoch (if requested)
# ----------------------------------------------
      if ($mjd>=59910 || $dirOut=~/I20/) {
        $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","ENDTIM","24 00 00");
      }

      $bpe->setUserVar("SCRyyyy-ssss","$yyyy-$ssss");
#      $bpe->putKey("$ENV{U}/PAN/STDPRE.INP","TITLE2","Final GNSS orbits and GPS clocks for year-day $yyddd");
      $PGMNAM = "STDPRE";
      $bpe->RUN_PGMS($PGMNAM);

      $nam = $bpe->getKey("$ENV{U}/INP/PREWEI.INP","PREFIL");
      $bpe->putKey("$ENV{U}/PAN/PREWEI.INP","PREFIL",substr(basename($nam),0,-9).$yyddd);

      $PGMNAM = "PREWEI";
      $bpe->RUN_PGMS($PGMNAM);

      $nam = $bpe->getKey("$ENV{U}/INP/PREWEI.INP","PREFIL");
      prtMess($bpe,basename($nam)." UPDATED");

# Done in IGSF_S7D as well
#      if ($sav eq "Y") {
#        $savFil = "$PATH_SAV$CAMP_SAVIGS/$yyyy/ORB/".basename($nam);
#        copy($nam,$savFil) or die "copy failed with $nam to $savFil\n";
#        prtMess($bpe,basename($nam)." SAVED");
#      }

    }
  } else {
    prtMess($bpe,"NOTHING DONE");
  }

}
