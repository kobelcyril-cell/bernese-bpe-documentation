use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyyy, $yy,  $ssss,  $yyssss, $ddd, $yyddd,
      $V_K,  $V_E,  $V_B,  $V_C,  $V_H,  $V_I,  $V_U,  $V_Q,  $V_Z, $V_T,
      $pthPcf, $pcfNam, $script,
      $v_gnss,$v_gnsh,$crdinf,$sampl,$mode, $repro,$mishrd,$misobs,
      $camp_pth,$campaign, $ut24   ,$v_lapack,  $u,
      $dirOut,   $dirCrd,   $dirSme,   $dirSum,   $dirLst,   $dirRxc,
      $extOut,   $extCrd,   $extSme,   $extSum,   $extLst,   $extRxc) =
    $bpe->getKeys(
      '$Y+0','$Y', '$S+0', '$YSS+0', '$+0', '$YD+0',
      'V_K', 'V_E', 'V_B', 'V_C', 'V_H', 'V_I', 'V_U', 'V_Q', 'V_Z', 'V_T',
      'PTH_PCF', 'PCFFIL','SCRIPT',
      'V_GNSS','V_GNSH','V_CRDINF','V_SAMPL','V_MODE'  ,'V_REPRO','V_MISHRD','V_MISOBS',
      'CAMP_PTH','CAMPAIGN', 'V_UT24','V_LAPACK', 'U',
      'DIR_OUT', 'DIR_CRD', 'DIR_SME', 'DIR_SUM', 'DIR_LST', 'DIR_RXC',
      'EXT_OUT', 'EXT_CRD', 'EXT_SME', 'EXT_SUM', 'EXT_LST', 'EXT_RXC');


# Read clock files for statistitcs
# --------------------------------
# - Read the RMS-values for the linear fit from the CCRNXC output
  my %rmsClk = ();
  $rmsClk{F3P} = readRms("$dirOut/${V_U}_${yyssss}.$extOut");
  $rmsClk{F3H} = readRms("$dirOut/${V_Q}_${yyssss}.$extOut");
  $rmsClk{F3U} = readRms("$dirOut/${V_C}_${yyssss}.$extOut") if $v_gnsh;

# - Read the Station RMS-values of the GPSEST output
  my %rmsSta = ();
  my %obsSta = ();
  my %staSys = ();
  ($rmsSta{F3P},$obsSta{F3P}) = staRms("${dirSum}${V_U}R${yyssss}.${extSum}");
  if($mode=~/PPP/){
    ($staSys{F3P}) = getGNSS("${dirSum}${V_I}_${yyssss}.${extSum}");
  }else{
    ($staSys{F3P}) = getSys ("${dirCrd}${V_K}_${yyssss}.${extCrd}");
  }

# Initialize processing summary file
# ----------------------------------
  my $prcFil = "${dirOut}FCLK${yyssss}.PRC";
  unlink $prcFil;

  if ($repro) {
    appFile("CLOCK REPROCESSING BPE PROCESSING SUMMARY FOR YEAR-SESSION $yy-$ssss",
      1,"",$prcFil,0);
  } else {
    appFile("CLOCK FINAL BPE PROCESSING SUMMARY FOR YEAR-SESSION $yy-$ssss",
      1,"",$prcFil,0);
  }

# Report the BPE settings
# -----------------------
  open(PRC,">> $prcFil");
  print PRC "Summary file generated at ",timprt()," by $script\n\n";

  $pthPcf =~ s/$$bpe{U}/$$bpe{U_OLD}/;
  print "${pthPcf}/${pcfNam}\n";
  print PRC reportBPEvariables($bpe,"${pthPcf}/${pcfNam}");
  print PRC "\n\n";

  close PRC;

  $mishrd = $mishrd eq ""? "udef" : sprintf "%4i",$mishrd;
  $misobs = $misobs eq ""? "udef" : sprintf "%4i",$misobs;

# Count number of satellites and receivers
  my ($p3_satn,$p3_recn,$p3_ref) = getNumSol("$dirRxc/${V_U}_${yyssss}.$extRxc"); #3-Day, 300s
  my ($h3_satn,$h3_recn,$h3_ref) = getNumSol("$dirRxc/${V_Q}A${yyssss}.$extRxc"); #3-Day, 300s
  my ($u3_satn,$u3_recn,$u3_ref) = getNumSol("$dirRxc/${V_C}A${yyssss}.$extRxc"); #3-Day, 300s

# Get best satellite and receiver clock (linear fit)
  my ($p3_prn,$p3_prn_rms, $p3_rec,$p3_rec_rms) = extractBestRms(\%rmsClk,"F3P");
  my ($h3_prn,$h3_prn_rms, $h3_rec,$h3_rec_rms) = extractBestRms(\%rmsClk,"F3H");
  my ($u3_prn,$u3_prn_rms, $u3_rec,$u3_rec_rms) = extractBestRms(\%rmsClk,"F3U");

  my $sum_p3 = sprintf "%4is %4i  %4i  %4s   %4s   %s",$sampl,$p3_satn,$p3_recn,$misobs,$p3_ref,"${V_U}_${yyssss}.$extRxc";
  my $sum_h3 = sprintf "%4is %4i  %4i  %4s   %4s   %s",    30,$h3_satn,$h3_recn,$misobs,$h3_ref,"${V_Q}_${yyssss}.$extRxc";
  my $sum_u3 = sprintf "%4is %4i  %4i  %4s   %4s   %s",     5,$u3_satn,$u3_recn,$mishrd,$u3_ref,"${V_C}_${yyssss}.$extRxc";

  my $nli    = " UNDEF ";
  my $nli_file = "${dirOut}NLI${yyssss}.${extOut}";
  if(-e $nli_file){
    open INP, "< $nli_file";
    foreach my $line (<INP>){
      if($line=~/ A posteriori RMS of unit weight *(\d*\.\d*) m/){
        $nli = sprintf "% 7.4f", $1;
      }
    }
    close INP;
  }

  my $bst_p3 = sprintf "%4s % 7.4f  %4s % 7.4f  % 7s",$p3_prn,$p3_prn_rms,$p3_rec,$p3_rec_rms, $nli;
  my $bst_h3 = sprintf "%4s % 7.4f  %4s % 7.4f  % 7s",$h3_prn,$h3_prn_rms,$h3_rec,$h3_rec_rms, $nli;
  my $bst_u3 = sprintf "%4s % 7.4f  %4s % 7.4f  % 7s",$u3_prn,$u3_prn_rms,$u3_rec,$u3_rec_rms, $nli;

  appFile(" Selected options for this FCLKGNSS run:\n\n".
          " DESCRIPTION_______________ VALUE___________________\n".
          " Creation date (GMT)      : ".gmtime()."\n".
          " Processed session        : $yyyy $ssss\n".
          " Observations from        : $mode\n".
          " Used ITRF                : $crdinf\n".
          " Repro mode               : ".($repro? "YES" : "NO")."\n".
          " Sampling rate for GPSEST : $sampl\n".
          " GNSS for $sampl/30s cklocks : $v_gnss\n".
          " GNSS for      5s cklocks : $v_gnsh\n".
          " Extrapolate 24 UT (5s)   : $ut24\n".
          " Use LAPACK solution      : $v_lapack\n".
          "\n".
          " Overview clock solution/densification:\n\n".
          " DESCRIPTION________________ Samp_ #Sat  #Rec  #Mis   Ref_   File__________  Sat  rms____  Rec_ Rms____ Rms_NLI_\n".
          " 3-Day clock estimation    : $sum_p3  $bst_p3\n".
          " 3-Day clock densification : $sum_h3  $bst_h3\n".
          " 3-Day clock densification : $sum_u3  $bst_u3\n",
          1,"",$prcFil,0);
  my $sumFil;
  my $tmpFil = "$ENV{U}/WORK/fclk_prc.tmp";



# Clock computation summary
# -------------------------

# - Summary of clock computation: 1-Days
  $sumFil = "${dirSum}${V_U}U${yyssss}.${extSum}";
  print "SUM: $sumFil\n";
  selExtr($sumFil,$tmpFil,"Rms",0,"\n\n3-Day: Unify satellite clocks");
  $sumFil = "${dirSum}${V_U}_${yyssss}.${extSum}";
  print "SUM: $sumFil\n";
  selExtr($sumFil,$tmpFil,"Rms",0,"\n3-Day: Satellite clock inversion (4x6-hour blocks)");

  # Remark
  open OUT, ">> $tmpFil";
  print OUT "\n\nRemark:\n".
            " Difference in #par due to station pre-elimination in F3-solution whereas\n".
            " #obs reflects the weak troposphere constrains (related pseudo-observations).\n";
  close OUT;

  appFile("PART  1: SATELLITE CLOCK ESTIMATION SUMMARY",2,$tmpFil,$prcFil,1);

# - Count satellite clock records in clock RINEX files
  my $tmp = "$ENV{U}/WORK/fclk_prc.tmp";
  unlink $tmp;

  my %refClk = ();
  my %cntClk = ();
  my $clk300s = 288;
  my $clk030s = 2880;
  my $clk005s = $ut24 =~ /Y/ ? 17281 : 17280 ;
  ($refClk{F3P},$cntClk{F3P}) = countClk("$dirRxc/${V_U}_${yyssss}.$extRxc",$tmp,$clk300s);
  ($refClk{F3H},$cntClk{F3H}) = countClk("$dirRxc/${V_Q}_${yyssss}.$extRxc",$tmp,$clk030s);
  ($refClk{F3U},$cntClk{F3U}) = countClk("$dirRxc/${V_C}_${yyssss}.$extRxc",$tmp,$clk005s) if $v_gnsh;

  appFile("PART 2: NUMBER OF SATELLITE CLOCK RECORDS IN THE CLOCK RINEX FILES\n".
          "        ${V_U}: from GPSEST cluster solution,         3-day (300s)\n".
          "        ${V_Q}: high-rate CLKEST desification,        3-day ( 30s)\n".
          "        ${V_C}: ultra high-rate CLKEST desification,  3-day (  5s)",
          2,$tmp,$prcFil,1);
  unlink $tmp;



# - Make a list of the solutions with their reference clocks
  open(TMP,"> $tmp");
  printf TMP " %s%15s%15s%15s\n%s\n",
  'Sol:',"F3P","F3H","F3U",'-' x 80;
  printf TMP " %s%15s%15s%15s\n%s\n",
  'Ref:',$refClk{F3P},$refClk{F3H},$refClk{F3U},'-' x 80;

# - Report the RMS of the linear fit for the satellite clocks (assending order)
  foreach my $clk ( sort { $rmsClk{F3P}->{$a}<=>$rmsClk{F3P}->{$b} }
                    keys %{$rmsClk{F3P}} ) {
    next unless ( $clk =~ /[GRECJS][\d][\d] / );
    printf TMP " %s%15s%15s%15s\n",
    $clk,$rmsClk{F3P}->{$clk},$rmsClk{F3H}->{$clk},$rmsClk{F3U}->{$clk};
  }

# - Report the RMS of the linear fit for the station clocks (assending order)
  printf TMP "\n\n%s\n %s%15s%15s%15s | %10s%10s %6s\n%s\n",
  '-' x 80,'Sta ',"F3P","F3H","F3U","RMS(F3P)","#OBS(F3P)","SYSTEM",'-' x 80;
  foreach my $clk ( sort { $rmsClk{F3P}->{$a}<=>$rmsClk{F3P}->{$b} }
                    keys %{$rmsClk{F3P}} ) {
    next if ( $clk =~ /[GRECJS][\d][\d] / );
    my $system = exists $staSys{F3P}{$clk}? $staSys{F3P}{$clk}:" ";
    foreach  (qw(F3P F3H F3U)){
      unless(exists $rmsClk{$_}->{$clk}){$rmsClk{$_}->{$clk} = ""}
    }
    printf TMP " %s%15s%15s%15s | %10s%10s %-6s\n",
    $clk,$rmsClk{F3P}->{$clk},$rmsClk{F3H}->{$clk},$rmsClk{F3U}->{$clk},
         $rmsSta{F3P}->{$clk},$obsSta{F3P}->{$clk},$system;
  }
  printf TMP "%s\n",'-' x 103;
  close TMP;
# - add this statistics to the summary file
  appFile("PART  2: LINEAR FIT OF THE BEST PERFORMING CLOCKS\n".
          "        ${V_U}: from GPSEST cluster solution,         3-day (300s)\n".
          "        ${V_Q}: high-rate CLKEST desification,        3-day ( 30s)\n".
          "        ${V_C}: ultra high-rate CLKEST desification,  3-day (  5s)",
          2,$tmp,$prcFil,1);
  unlink $tmp;

# Protocoll from RINEX level on
# -----------------------------
  if($mode =~ /RINEX/){
  # - Single-point-positioning summary
    $sumFil = "${dirOut}CODXTR.${yy}_${ssss}";
    appFile("PART 3: SINGLE-POINT-POSITIONING SUMMARY",2,$sumFil,$prcFil,1);

  # - Code weighting summary
    $sumFil = "${dirOut}${V_I}R${yy}${ssss}.${extOut}";
    appFile("PART 4: WEIGHTING OF THE CODE OBSERVATIONS",2,$sumFil,$prcFil,1);

  # - PPP preprocessing summary
    $sumFil = "${dirSum}PPP${yyssss}.${extSum}";
    appFile("PART 5: PPP SUMMARY TO COMPLETE CRD+TRP FILES",2,$sumFil,$prcFil,0);

  # - Code screening summary
    $sumFil = "${dirSum}${V_B}G${yyssss}.${extSum}";
    appFile("PART 6: SCREENING OF THE CODE OBSERVATIONS",1,$sumFil,$prcFil,1);

    $sumFil = "${dirSum}${V_B}_${yyssss}.${extSum}";
    appFile("",2,$sumFil,$prcFil,1);

  # - Compute the interfrequency code biases
    # unlink $sumFil;
    # map { appFile("",0,$_,$sumFil,1) } sort glob "${sumFil}.[0-9]";

    $sumFil = "${dirSum}${V_T}S${yyssss}.${extSum}";
    appFile("PART 7.1: Observable-specifc code biases",1,$sumFil,$prcFil,1);

    $sumFil = "${dirSum}${V_T}G${yyssss}.${extSum}";
    appFile("PART 7.3: Observable-specifc code biases (CBG solution)",1,$sumFil,$prcFil,1);


    # $sumFil = "${dirSum}${V_T}G${yyssss}.${extSum}";
    # appFile("PART 7.2: INTER-FREQUENCY/P1-C1 CODE BIASES",2,$sumFil,$prcFil,1);

    # $sumFil = "${dirSum}TD_${yyssss}.${extSum}";
    # appFile("PART 7.3: DCB EXTRACTION SUMMARY",2,$sumFil,$prcFil,1);

    # $sumFil = "${dirSum}TQ_${yyssss}.${extSum}";
    # appFile("PART 7.4: FREQ EXTRACTION SUMMARY",2,$sumFil,$prcFil,1);

  # - Phase preprocessing summary
    $sumFil = "${dirOut}MPRXTR.${yy}_${ssss}";
    appFile("PART 8: PHASE PREPROCESSING SUMMARY",2,$sumFil,$prcFil,1);

    $sumFil = "${dirSum}MPS${yyssss}.${extSum}";
    appFile("",2,$sumFil,$prcFil,1);

  # - Residual screening summary
    $sumFil = "${dirSum}${V_H}G${yyssss}.${extSum}";
    appFile("PART 9: CODE+PHASE RESIDUAL SCREENING SUMMARY",2,$sumFil,$prcFil,1);

    $sumFil = "${dirOut}/OBX_EDT_$yyssss.${extOut}";
    appFile("",2,$sumFil,$prcFil,1);
    $sumFil = "${dirSum}/OBX_EDT_$yyssss.${extSum}";
    appFile("",2,$sumFil,$prcFil,1);

  # Amiguity statistics
  # -------------------
    $sumFil = "${dirOut}/OBX_AMB_$yyssss.${extOut}";
    appFile("PART 10: Satellite-wise ambiguity statistics",2,$sumFil,$prcFil,1);
    $sumFil = "${dirSum}/OBX_AMB_$yyssss.${extSum}";
    appFile("",2,$sumFil,$prcFil,1);

  }

# Protocoll from PPP level on
# -----------------------------
  if($mode=~/PPP/){
  # - Residual screening summary
    $sumFil = "${dirSum}${V_I}_${yyssss}.${extSum}";
    appFile("PART 3: CODE+PHASE RESIDUAL SCREENING SUMMARY",2,$sumFil,$prcFil,1);

    $sumFil = "${dirOut}/OBX_EDT_$yyssss.${extOut}";
    appFile("",2,$sumFil,$prcFil,1);
    $sumFil = "${dirSum}/OBX_EDT_$yyssss.${extSum}";
    appFile("",2,$sumFil,$prcFil,1);

  # Amiguity statistics
  # -------------------
    $sumFil = "${dirOut}/OBX_AMB_$yyssss.${extOut}";
    appFile("PART 4: Satellite-wise ambiguity statistics",2,$sumFil,$prcFil,1);
    $sumFil = "${dirSum}/OBX_AMB_$yyssss.${extSum}";
    appFile("",2,$sumFil,$prcFil,1);
  }

# Create short protocol file
# --------------------------
  my $prcFilshort = "${dirOut}FCLKGNSS_SHORT.TXT";
  system("perl $ENV{AUTO}/typ_fclk.pl -q ${ddd} > $prcFilshort");

# Copy file to www
# ----------------
  copyfile("$prcFil","${PATH_WWW}code/fclkgnss.txt");
  copyfile("$prcFilshort","${PATH_WWW}code/fclkgnss_short.txt");

# Check number of complete satellites and exist
# ---------------------------------------------
  my $misclk = 0;
  my $missol = "";
  foreach my $sol (sort keys %cntClk){
    print "Complete clocks for $sol: $cntClk{$sol}\n";
    unless ($cntClk{$sol} > 0){
      $misclk++;
      $missol = "$missol $sol";
    }
  }

  if($misclk>0){
    my $msg = "FCLKGNSS: Incomplete clocks for $missol";
    prtMess($bpe,$msg);
    msg2key("BPE",$msg);
    die "Incomplete clocks for ${missol}\n";
  }

# #
# # Define files to be displayed
# # ----------------------------
#   my $alles =  ($repro) ? "${dirOut}/FCLKREPRO.${yy}_${ssss}" :
#                           "${dirOut}/FCLKGNSS.${yy}_${ssss}";

#   my @filelist =  (
#                 "${dirOut}/RNXERR.${yy}_${ssss}",
#                 "${dirOut}/SMT${yyssss}.SMC",
#                 "${dirOut}/CLK${yyssss}.PRC",
#                 "${dirOut}/${V_H}_${yyssss}.OUT",
#                 "${dirOut}/${V_U}_${yyssss}.OUT",
#                 "${dirOut}/${V_G}_${yyssss}.OUT",
#                 "${dirOut}/${V_Q}_${yyssss}.OUT",
#                 "${dirOut}/${V_N}_${yyssss}.OUT",
#                 "${dirOut}/RESCHK.${yy}_${ssss}",
#                 "${dirSum}/${V_H}_${yyssss}.SUM",
#                 "${dirSum}/${V_U}_${yyssss}.SUM",
#                 "${dirSum}/${V_G}_${yyssss}.SUM",
#                 "${dirOut}/${V_Q}C${yyssss}.PRC",
#                 "${dirOut}/${V_N}C${yyssss}.PRC",
#                ) ;
#    unlink($alles);
#    map { appFile($_,2,$_,$alles,0) } (@filelist);


# ==============================================================================
# Count satellite clock records in clock RINEX files
# ==============================================================================
  sub countClk(){
    use File::Basename;

    my $clkFil = shift;
    my $tmpFil = shift;
    my $numEpo = shift || 2880;

    my $refClk = "";
    my $maxsat = 0;
    # Count the satellites
    my %clkNum = ();

    die("Clock RINEX file $clkFil is missing.\n") unless -s $clkFil;

    open (CLK,"< $clkFil");
    while (<CLK>) {
      $refClk = substr($_,0,4) if ( /ANALYSIS CLK REF/ );
      unless (/^AS /) { next }
      my $sat = substr($_,3,3);

      $clkNum{$sat} = 0 unless defined $clkNum{$sat};

      $clkNum{$sat}++;
    }
    close CLK;

    # Read the old file into a buffer
    my @line = ();
    my $old = (-s $tmpFil);
    if ($old) {
      open (OLD,"< $tmpFil");
      while (my $lin = <OLD>) {
        chomp ($lin);
        push @line,$lin;
      }
      close OLD;
    }

    # A new header for the table
    unless ($old) {
      push @line, sprintf " Sat%21s \n",basename($clkFil);
      push @line, sprintf "--------------------------\n";

      foreach my $sat (sort keys %clkNum) {
        push @line, sprintf " %s%12.0f%9.2f%s\n",
            $sat,$clkNum{$sat},$clkNum{$sat}/$numEpo*100,"%";
        $maxsat ++ if $clkNum{$sat} >= $numEpo;
      }
    # Extent the header for the table
    } else {
      $line[0] .= sprintf "%20s \n",basename($clkFil);
      $line[1] .= sprintf "---------------------\n";

      for (my $ii=2; $ii<=$#line; $ii++) {
        my $sat = substr($line[$ii],1,3);
        $line[$ii] .= sprintf "%11.0f%9.2f%s\n",
              $clkNum{$sat},$clkNum{$sat}/$numEpo*100,"%";
        $maxsat ++ if $clkNum{$sat} >= $numEpo;
      }
    }

    # Write the new file
    open (NEW,"> $tmpFil");
    print NEW @line;
    close NEW;
    return ($refClk,$maxsat);
  }



# ==============================================================================
# Count satellite clock records in clock RINEX files
# ==============================================================================
  sub readRms(){
    use File::Basename;

    my $outFil = shift;

    # Count the satellites
    my %clkRms = ();

    die("CCRNXC program output file $outFil is missing.\n") unless -s $outFil;

    my $iRead = 0;
    open(OUT,$outFil);
    while(<OUT>) {
      if ( /^ Clock name/ ) {
        $iRead = 1; next;
      }
      next if ( /^ ---------------------/ );
      next unless $iRead;
      last if ( /^ Stations with / );
      my $clk = substr($_,1,4);
      $clkRms{$clk} = (split())[-2];
    }
    close OUT;

    return \%clkRms;
  }

}

# ==============================================================================
# Station RMS from GPSXTR
# ==============================================================================

sub staRms{
  my $i1d  = shift;

  my %staRms;
  my %staObs;

  open INP, "cat $i1d | grep Rms |";
  foreach (<INP>){
    chomp;
#      " F1PR3180BAKO.OUT Rms:  1.1 , # fil.:   2 , # obs.:    8794 , # par.:   414"
    if(/ \w\w\wR(\d\d\d)0(\w\w\w\w).OUT Rms: *(\d*\.\d).*obs\.: *(\d*) .*par\.: *(\d*)/){
      $staRms{$2} = $3;
      $staObs{$2} = $4;
    }
  }
  close INP;

  return (\%staRms,\%staObs);
}

sub selExtr{
  my $inp = shift;
  my $out = shift;
  my $sel = shift;
  my $new = shift;
  my $pre = shift;
  open INP, " < $inp";
  open OUT, " > $out" if $new==1;
  open OUT, ">> $out" if $new==0;
  print OUT "$pre\n" if $pre;

  foreach (<INP>){
    chomp;
    print OUT "$_\n"   if /$sel/;
  }

  close OUT;
  close INP;
}

sub recExtr{
  my $i1d  = shift;
  my $i2d  = shift;
  my $sol1 = shift;
  my $sol2 = shift;
  my $out  = shift;

  my %data;
  my @station;
  open INP, "cat $i1d | grep Rms | sort -n -k3 |";
  foreach (<INP>){
    chomp;
    if(/ ${sol1}R(\d\d\d)0(\w\w\w\w).OUT  Rms: *(\d*\.\d*) .*obs\.: *(\d*) .*par\.: *(\d*)/){
      push @station,$2 unless $2 ~~ @station;
      $data{$1}{$2}{$sol1}{rms} = $3;
      $data{$1}{$2}{$sol1}{obs} = $4;
      $data{$1}{$2}{$sol1}{par} = $5;
    }
  }
  close INP;

  open INP, "cat $i2d | grep Rms | sort -n -k3 |";
  foreach (<INP>){
    chomp;
    if(/${sol2}R(\d\d\d)(\w\w\w\w).OUT  Rms: *(\d*\.\d).*obs\.: *(\d*) .*par\.: *(\d*)/){
      push @station,$2 unless $2 ~~ @station;
      $data{$1}{$2}{$sol2}{rms} = $3;
      $data{$1}{$2}{$sol2}{obs} = $4;
      $data{$1}{$2}{$sol2}{par} = $5;
    }
  }
  close INP;

  open OUT, " > $out";
  print  OUT "Receiver clock estimation\n";
  printf OUT "DOY STA_ RMS__ RMS__ obs___ obs___ par___ par___\n".
             "         %3s   %3s   %3s    %3s    %3s    %3s   \n".
             "------------------------------------------------\n",$sol1,$sol2,$sol1,$sol2,$sol1,$sol2;
  foreach my $doy (sort keys %data){
    foreach my $sta (@station){
      printf OUT  "%3i %4s %5.1f %5.1f %6i %6i %6i %6i\n",$doy,$sta,
                  $data{$doy}{$sta}{$sol1}{rms},$data{$doy}{$sta}{$sol2}{rms},
                  $data{$doy}{$sta}{$sol1}{obs},$data{$doy}{$sta}{$sol2}{obs},
                  $data{$doy}{$sta}{$sol1}{par},$data{$doy}{$sta}{$sol2}{par};
    }
  }
  close OUT;
}

# ==============================================================================
# GNSS extraction from CRD file
# ==============================================================================

sub getSys{
  my $file = shift;

  my %staSys;
  print "OPEN FILE $file\n";
  open INP, "< $file";
  foreach (<INP>){
    chomp;
    if(/^[ \d][ \d]\d  (\w\w\w\w).* \w * ([G ][R ]?[E ]?[C ]?[J ]?)( |$)/){
      print "SYSTEM: $2 $_\n";
      $staSys{$1} = $2;
    }
  }
  close INP;
  print "CLOSE\n";

  return (\%staSys);
}

sub getNumSol{
  my $file = shift;

  my $satn = 0;
  my $recn = 0;
  my $ref= "";
  open INP, "< $file";
  foreach (<INP>){
    $satn = $1 if /^  ([ \d][ \d][ \d]\d)  *# OF SOLN SATS/;
    $recn = $1 if /^  ([ \d][ \d][ \d]\d) .*# OF SOLN STA \/ TRF/;
    $ref  = "$ref $1" if /(\w*) .*ANALYSIS CLK REF/;
  }
  close INP;
  $ref =~ s/^\s+|\s+$//g;
  return ($satn, $recn, $ref);
}

sub getGNSS{
  my $file = shift;
  my @sat;
  my @system = qw(G R E C J);
  my $nsat;
  my %stat;
  open INP, "< $file";

  foreach (<INP>){
    if(/BASELINE  SESS/){
      foreach my $svn (split(" ",$_)){if($svn=~/^\d*$/){push @sat, $svn; $nsat++;}};
    }elsif(/^ (\w\w\w\w)/ && !/TOTAL/){
      my $sta = $1;
      my %syst;
      for(my $i=1; $i<=$nsat;$i++){
         $syst{$system[int($sat[$i-1])/100]}=1 if(substr($_,10+$i*6,6) =~ /\d*[\.\d]/);
      }
      my $strsys="";
      foreach my $sys (@system){$strsys = "${strsys}${sys}" if exists $syst{$sys}}
      $stat{$sta}=$strsys;
    }
  }
  close INP;
  return \%stat;
}

sub extractBestRms{
  my $rmsClk = shift;
  my $sol    = shift;
  my $sat    = "";
  my $rec    = "";
  my $sat_rms = 0;
  my $rec_rms = 0;

  foreach my $clk ( sort { $rmsClk->{$sol}{$a}<=>$rmsClk->{$sol}{$b} }
                    keys %{$rmsClk->{$sol}} ) {
      if( $clk =~ /[GRECJS][\d][\d] / && $sat eq ""){
        $sat = $clk;
        $sat_rms = $rmsClk->{$sol}{$clk}
      }elsif($rec eq  "" || $rec_rms == 0){
        $rec = $clk;
        $rec_rms = $rmsClk->{$sol}{$clk}
      }
  }
  return ($sat,$sat_rms,$rec,$rec_rms);
}
