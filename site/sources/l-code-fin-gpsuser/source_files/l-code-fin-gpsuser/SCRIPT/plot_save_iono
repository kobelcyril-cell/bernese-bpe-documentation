package plot_save_iono;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  plot_save_iono
#
# Purpose :  Rename file in the $P/PLOTS_INO/FIG area by prepending iono_
#            where it is not possible via the INP-file
#
# Programs:  plot_save_iono
#
# Author  :  R. Dach   
# Created :  23-Jan-2024
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------

use strict;

use File::stat;
use File::Basename;
use lib $ENV{AUTO};
use igs_device;
use gpsutil;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ( $fig, $sav, $dirSum, $dirFig ) = 
      $bpe->getKeys(
      'V_FIG', 'V_SAV','DIR_SUM','DIR_FIG');

  if(substr(uc($sav),0,1) eq "Y") {

    my $latest = stat((sort {stat($a)->mtime <=> stat($b)->mtime} glob("$dirSum/*"))[0])->mtime;

    $Set_Verify=1;

    for my $pngFil ( glob("$dirFig/*") ) {
      my $pngTim = stat($pngFil)->mtime;
      next  if ( $pngTim < $latest );
      my $filNam = basename($pngFil);
      next if $filNam =~ /^$fig/;
      my $dirNam = dirname($pngFil);
      movefile($pngFil,"$dirNam/$fig$filNam");
    }

    $On_Error_Cont = 1;
    err_print() || die();
  } else {
    &prtMess($bpe,"FILES NOT PUBLISHED");
    print       "\nFILES NOT PUBLISHED\n";
  }
}
