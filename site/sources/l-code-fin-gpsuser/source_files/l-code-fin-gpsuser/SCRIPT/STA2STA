package STA2STA;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  STA2STA
#
# Purpose :  Create extra STA file for SINEX generation
#
# PARAMs  :  PARAM1 - Name of extra STA file (and keyword)
#            PARAM2 - Negative keyword (optional)
#
# Author  :  S. Schaer
# Created :  30-Nov-2004
#
# Changes :  03-Mar-2005/ss: Adapted for LPT analysis
#            01-May-2006/ss: Consider negative keyword if indicated
#            22-May-2006/di/eb: Take STA-file from campaign STA directory
#            24-Jul-2008/rd/ps: check if up-to-date file already available
#            09-Oct-2012/ss: Use STAINF variable
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($staInf, $param1, $param2, $dirSta, $extSta) =
    $bpe->getKeys('V_STAINF', 'PARAM1', 'PARAM2', 'DIR_STA', 'EXT_STA');

  $staInf = "CODE" if $staInf eq "";

# Create extra STA file for SINEX generation
# ------------------------------------------
  my $inpFil = "$ENV{REF}/${staInf}.STA";
##  my $inpFil = "${dirSta}${staInf}.STA";
  my $outFil = "${dirSta}${param1}.${extSta}";

  if ( (stat($inpFil))[9] > (stat($outFil))[9])
  {
    open(INPFIL,"< $inpFil");
    open(OUTFIL,"> $outFil");

    while (<INPFIL>) {
      next if /%$param2/ && $param2 ne "";
      s/^(....)_/$1 /g if /%$param1/;
      print OUTFIL }

    close(INPFIL);
    close(OUTFIL);

    prtMess($bpe,"$outFil derived from $inpFil");
  }

}
