package RXOBV3_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RXOBV3_P
#
# Purpose :  Execute RXOBV3 (for preprocessed/smoothed data files)
#
# PARAMs  :  PARAM1 - temporary file for parallel processing
#
# Author  :  M. Meindl
# Created :  23-Jul-2003
#
# Changes :  25-Apr-2007/ss: Consider V_GNSS, if defined
#            23-Jul-2008 ps: Unique output filenames
#            29-Sep-2014 lp: New GNSS selection using setGNSS
#            10-Dec-2020 st: RXOBV3: RXOFILE -> RXOFILE_SHORT
#            13-Aug-2021 RD: Start using BSW-style filenaming in the campaign area
#
# ============================================================================
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil qw(copyfile);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($ssss, $ddd, $yyssss,
      $param1, $subPid, $clu, $nclu, $v_gnss, $dirOut,
      $dirCrd, $extCrd, $a) =
  $bpe->getKeys('$S+0', '$+0', '$YSS+0',
      'PARAM1', 'SUB_PID', 'V_CLU','V_NCLU', 'V_GNSS', 'DIR_OUT',
      'DIR_CRD','EXT_CRD','V_A');

# Select GNSS, if desired
# -----------------------
  &setGNSS($bpe,"$ENV{U}/PAN/RXOBV3.INP","USE_",$v_gnss);

# Set cluster number and input files
# ----------------------------------
  my $cluster = $clu eq "" && $nclu eq ""? "$ddd$param1" : "$yyssss" . substr($subPid,1);
  my $ffff    = $clu eq "" && $nclu eq ""? $param1       : "____";

  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$ffff,"CCC",$subPid);

  if ($clu eq "" && $nclu eq "") {
    $bpe->putKey("$ENV{U}/PAN/RXOBV3.INP","RXOFILE_SHORT","$param1$ssss");
    $bpe->putKey("$ENV{U}/PAN/RXOBV3.INP","SMTFILE","$param1$ssss") }
  else {
    replaceSel($bpe,"RXOBV3","RXOFILE_BSW",$param1);
    replaceSel($bpe,"RXOBV3","RXOFILE_SHORT",$param1);
    replaceSel($bpe,"RXOBV3","SMTFILE",$param1) }

  if ( $bpe->getKey("$ENV{U}/PAN/RXOBV3.INP","COORD") =~ /CLUSTER/ ) {
    copyfile("$dirCrd/${a}${yyssss}.${extCrd}","$dirCrd/${a}${cluster}.${extCrd}");
  }


# Run program
# -----------
  my $PGMNAM = "RXOBV3";
  $bpe->RUN_PGMS($PGMNAM);

# Extract warning/error messages from protocol file
# -------------------------------------------------
  getWarn($bpe,"${dirOut}RNX${yyssss}.ERR");


# Delete BPE file
# ---------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;
  unlink($param1);

}
