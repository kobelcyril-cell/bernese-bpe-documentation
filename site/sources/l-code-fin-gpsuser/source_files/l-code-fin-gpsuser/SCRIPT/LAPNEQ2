package LAPNEQ2;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  LAPNEQ2
#
# Purpose :  Execute LAPACK-ADDNEQ2/GPSXTR
#
# PARAMs  :
#
# Author  :  A. Villiger
# Created :  03-Sep-2018
#
# Changes :
#
# ============================================================================
use lib "$ENV{BPE}";
use bpe_util qw(prtGoto prtMess);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($xtr,$lapack,$nextjob, $goto) =
  $bpe->getKeys('V_XTR','V_LAPACK','PARAM1', 'PARAM2');

# Run program
  # -----------
  if($lapack =~ /Y/){
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","LPINV","0");
    my $PGMNAM = "ADDNEQ2";
    $bpe->RUN_PGMS($PGMNAM);

    $PGMNAM = "GPSXTR";
    $bpe->RUN_PGMS($PGMNAM);
    $bpe->PRT_GOTO($param2);

    if ($nextjob eq "NEXTJOB") {
      prtMess($bpe,"LAPACK full NEQ invertion activated");
      prtGoto($bpe,$goto);
    }

  }

}
