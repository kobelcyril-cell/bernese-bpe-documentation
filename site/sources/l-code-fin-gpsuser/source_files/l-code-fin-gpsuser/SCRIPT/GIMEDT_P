#!/bin/sh
# SCRIPT-NAME
# sh script file written by bds
# -----------------------------
# functions used by shell
do_rm( ) {
    if [ "$1" ]
    then
        if [ -f `echo $1 | tr ' ' '\012' | head -1` ]
        then
            eval rm $1
        fi
    fi
}
#
toupper( ) {
    eval $1=`echo $2 | ${UPPERC}`
    eval export $1
}
#
seterr( ) {
    if [ $? = 0 ]
    then
        ERRSTAT=OK
    else
        ERRSTAT=ERR
    fi
}
#
# -----------------------------
# SHELL STARTS HERE
# -----------------------------
#
# Changes:
# 27-aug-2001 rd: switch to the new menu system
# 09-oct-2001 mm: Replace SERVOBS by SATMRK (newmenu)
# 08-Sep-2005/ss: Make use of geomagnetic_pole.com
#
# GIMEDT_P
# ========
#
# PARALLEL RUN FOR RESIDUAL SCREENING
# -----------------------------------
#
# Shell Variables: (set when running the header file)
# ---------------
#
# YEAR    :  Year of the session to be processed (2 digit)
# SESSION :  Session number (4 characters)
# CAMPAIGN:  Campaign name
# CAMP_PTH:  Campaign path
# CAMP_DRV:  Drive letter for campain (i.e. P)
# OPT_DIR :  Directory for panels
# PID     :  Process identification number (3 digits)
# SUB_PID :  Subprocess id (3 digits)
# PRT_FILE:  Protocol file name including path
# SCRIPT  :  Name of script
# TASKID  :  Task id of script, usually 00
# PRIORITY:  Priority of the script
# CPU     :  CPU the script is running on
# DAYYEAR :  Julian day of the year
# DAY     :  Day of the Month
# MONTH   :  Month, 1=JAN, 12=DEC
# GPSWEEK :  GPS week
# DAYWEEK :  Day of the week, 0=SUN, 6=SAT
# V_X     :  X Variable in DAT151__.PAN
# V_O     :  O Variable in DAT151__.PAN
# V_Z     :  Z Variable in DAT151__.PAN
# V_PLUS  :  Plus variable in DAT151__.PAN
# V_MINUS :  Minus variable in DAT151__.PAN
# V_x     :  User variable
# PARAMx  :  Script specific parameter, x is 1 thru 9
# U       :  Directory path to U:
#
# Use the new menu
TSTMENU="TRUE"
export TSTMENU
#
# See if this shell is being run from the PCS
# script, or directly for testing.  If testing,
# no the header script is not passed in as %1%
#
if [ "$1" = "" ]
then
#
#   set variables for testing here
#
    TEST_START_DIR=`pwd`
    cd $U/WORK
    TESTING="YES"
    export TESTING
else
    TESTING="NO"
    export TESTING
    . "$1"
    seterr
fi
#
# START THE MENU SYSTEM IN NON-INTERACTIVE MODE
# ---------------------------------------------
. $X/SCRIPT/BEG_MENU
seterr
#
# SET VARIABLES IN DAT151__.PAN
# -----------------------------
. $X/SCRIPT/SET_SESS
seterr
#
# Get "PARALEL" parameter (PARAM1)
# --------------------------------
FILE=""$PARAM1""
export FILE
#
# Set variable SESSION4 in panel DAT151__.PAN (3-char ID: e.g. 000)
# -----------------------------------------------------------------
tmpfil="CD"$tmp_pid".SEL"
export tmpfil
# open write #fid "$tmpfil"
rm -f "$tmpfil"
#
echo '"'D4'"' '"'"$SUB_PID"'"' >> "$tmpfil"
# close #fid
${EXE}/NPUTKEY $U/PAN/MENU_VAR.INP USERVAR SELECTED PREPEND "$tmpfil"
seterr
rm -f "$tmpfil"
#
# Replace "SELECTED" by files
# ---------------------------
${EXE}/NPUTKEY $U/PAN/GPSEST.INP CZFILES SELECTED REPLACE "$FILE"
seterr
${EXE}/NPUTKEY $U/PAN/SATMRK.INP CZHFIL SELECTED REPLACE "$FILE"
seterr
#
# Set lat and lon of geomagnetic pole
# -----------------------------------
${AUTO}/geomagnetic_pole.com "$YEAR" -lat > POLE.TMP
seterr
LATPOL=`cat POLE.TMP`
export LATPOL
${AUTO}/geomagnetic_pole.com "$YEAR" -lon > POLE.TMP
seterr
LONPOL=`cat POLE.TMP`
export LONPOL
#
${EXE}/NPUTKEY $U/PAN/GPSEST.INP LATPOL "$LATPOL"
seterr
${EXE}/NPUTKEY $U/PAN/GPSEST.INP LONPOL "$LONPOL"
seterr
#
# Define the loop
# ---------------
# set LOOP = 1 2 3
LOOP="1 2"
export LOOP
for COUNT in  $LOOP
do
#
#   Run the program
#   ---------------
    PGMNAM="GPSEST"
    export PGMNAM
    . $X/SCRIPT/RUN_PGMS
    seterr
#
    PGMNAM="RESRMS"
    export PGMNAM
    . $X/SCRIPT/RUN_PGMS
    seterr
#
    PGMNAM="SATMRK"
    export PGMNAM
    . $X/SCRIPT/RUN_PGMS
    seterr
#
    if [ "$COUNT" = "1" ]
    then
        TMPFLG="GIM"
        export TMPFLG
        RESFIL=""$CAMP_PTH""$CAMPAIGN"/OUT/"$TMPFLG""$SUB_PID"_L.RES"
        export RESFIL
        RESSAV=""$CAMP_PTH""$CAMPAIGN"/OUT/"$TMPFLG""$SUB_PID"_F.RES"
        export RESSAV
        cp "$RESFIL" "$RESSAV"
    fi
#
#   End of edit loop
#   ----------------
done
#
# --------------
# end the script
# --------------
. $X/SCRIPT/END_MENU
seterr
if [ "$TESTING" = "YES" ]
then
    cd "$TEST_START_DIR"
else
    . $X/SCRIPT/DO_TAIL
    seterr
fi
