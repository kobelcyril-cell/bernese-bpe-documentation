#!/bin/sh
# SCRIPT-NAME
# sh script file written by bds
# -----------------------------
# functions used by shell
do_rm( ) {
    if [ "$1" ]
    then
        if [ -f `echo $1 | tr ' ' '\012' | head -1` ]
        then
            eval rm $1
        fi
    fi
}
#
toupper( ) {
    eval $1=`echo $2 | ${UPPERC}`
    eval export $1
}
#
seterr( ) {
    if [ $? = 0 ]
    then
        ERRSTAT=OK
    else
        ERRSTAT=ERR
    fi
}
#
# -----------------------------
# SHELL STARTS HERE
# -----------------------------
#
# Changes:
# 27-aug-2001 rd: Switch to the new menu system now
# 28-Mar-2002 SS: Append Z3 GIM parameters summary
# 05-Nov-2014 SS: Revised
# 08-Jun-2016 SS: Reduced
#
# GIMXTR
# ======
#
# GENERATE SUMMARY OF THE PARALLEL GIMEST EDIT RUNS
# -------------------------------------------------
#
# SHELL VARIABLES:
# ----------------
#
# YEAR    :  Year of the session to be processed (2 digit)
# SESSION :  Session number (4 characters)
# CAMPAIGN:  Campaign name
# CAMP_PTH:  Campaign path
# CAMP_DRV:  Drive letter for campain (i.e. P)
# OPT_DIR :  Directory for panels
# PID     :  Process identification number (3 digits)
# SUB_PID :  Subprocess id (3 digits)
# PRT_FILE:  Protocol file name including path
# SCRIPT  :  Name of script
# TASKID  :  Task id of script, usually 00
# PRIORITY:  Priority of the script
# CPU     :  CPU the script is running on
# DAYYEAR :  Julian day of the year
# DAY     :  Day of the Month
# MONTH   :  Month, 1=JAN, 12=DEC
# GPSWEEK :  GPS week
# DAYWEEK :  Day of the week, 0=SUN, 6=SAT
# V_X     :  X Variable in DAT151__.PAN
# V_O     :  O Variable in DAT151__.PAN
# V_Z     :  Z Variable in DAT151__.PAN
# V_PLUS  :  Plus variable in DAT151__.PAN
# V_MINUS :  Minus variable in DAT151__.PAN
# V_x     :  User variable
# PARAMx  :  Script specific parameter, x is 1 thru 9
# U       :  Directory path to U:
#
# use the new menu
TSTMENU="TRUE"
export TSTMENU
#
# See if this shell is being run from the PCS
# script, or directly for testing.  If testing,
# no the header script is not passed in as %1%
#
if [ "$1" = "" ]
then
#
#   set variables for testing here
#
    TEST_START_DIR=`pwd`
    cd $U/WORK
    TESTING="YES"
    export TESTING
else
    TESTING="NO"
    export TESTING
    . "$1"
    seterr
fi
#
# START THE MENU SYSTEM IN NON-INTERACTIVE MODE
# ---------------------------------------------
. $X/SCRIPT/BEG_MENU
seterr
#
# SET VARIABLES IN DAT151__.PAN
# -----------------------------
. $X/SCRIPT/SET_SESS
seterr
#
# SHELL BODY
# ----------
#
# Run the program
# ---------------
PGMNAM="GPSXTR"
export PGMNAM
. $X/SCRIPT/RUN_PGMS
seterr
#
GIMFIL=""$CAMP_PTH""$CAMPAIGN"/OUT/GIMXTR."$YEAR"_"$DAYYEAR""
export GIMFIL
#
# Generate residual overview from first and last iteration
# --------------------------------------------------------
TMPFLG="GIM"
export TMPFLG
RESFIL=""$TMPFLG"???_F"
export RESFIL
${EXE}/NPUTKEY $U/PAN/RESRMS.INP RESFIL "$RESFIL"
seterr
#
PGMNAM="RESRMS"
export PGMNAM
. $X/SCRIPT/RUN_PGMS
seterr
#
RESXTR=""$CAMP_PTH""$CAMPAIGN"/OUT/RESRMS."$YEAR"_"$DAYYEAR""
export RESXTR
cp "$CAMP_PTH""$CAMPAIGN"/OUT/RESRMS.SUM "$RESXTR"
#
# Second RESRMS run
# -----------------
RESFIL=""$TMPFLG"???_L"
export RESFIL
${EXE}/NPUTKEY $U/PAN/RESRMS.INP RESFIL "$RESFIL"
seterr
#
PGMNAM="RESRMS"
export PGMNAM
. $X/SCRIPT/RUN_PGMS
seterr
#
cat "$CAMP_PTH""$CAMPAIGN"/OUT/RESRMS.SUM >> "$RESXTR"
#
cat "$CAMP_PTH""$CAMPAIGN"/OUT/CLKEDT.SUM >> "$RESXTR"
#
# --------------
# end the script
# --------------
. $X/SCRIPT/END_MENU
seterr
if [ "$TESTING" = "YES" ]
then
    cd "$TEST_START_DIR"
else
    . $X/SCRIPT/DO_TAIL
    seterr
fi
