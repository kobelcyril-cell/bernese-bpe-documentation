package GPSEDTAP;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GPSEDTAP
#
# Purpose :  Prepare parallel GPSEST run with residual screening
#
# Programs:
#
# Author  :  M. Meindl
# Created :  30-Jul-2003               Last modified: 23-Jul-2008
#
# Changes :  26-Jan-2005 mm: New initPar call (w/o tmpFil)
#            10-Feb-2005 mm: Old date variables removed
#            23-Jul-2008 rd: prepare for reprocessing
#            13-Jun-2023 RD: Correct the deletion for the cluster result files
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss  ,$ssss    ,$ddd     ,$clu     ,
      $dirRes  ,$dirNeq  ,$dirEdt  ,$dirOut  ,$dirPsh  ,$dirSum,
      $extRes  ,$extNeq  ,$extEdt  ,$extOut  ,$extPsh  ,$extSum,
      $dirBpe  ) =
  $bpe->getKeys
     ('$YSS+0' ,'$S+0'   ,'$+0'    ,'V_CLU'  ,
      'DIR_RES','DIR_NEQ','DIR_EDT','DIR_OUT','DIR_PSH','DIR_SUM',
      'EXT_RES','EXT_NEQ','EXT_EDT','EXT_OUT','EXT_PSH','EXT_SUM',
      'DIR_BPEPRT');


# Delete old files (OUT, RES, NEQ, EDT)
# -------------------------------------
  my $cluster = $clu ne "" ? "${yyssss}??" : "${ddd}????";

  unlink glob("${dirOut}E[FL]${cluster}.${extOut}");
  unlink glob("${dirRes}E[FL]${cluster}.${extRes}");
  unlink glob("${dirEdt}ED${cluster}.${extEdt}");
  unlink glob("${dirSum}ED${cluster}.${extSum}");
  unlink glob("${dirOut}RMS${cluster}.${extOut}");
  unlink glob("${dirOut}MRK${cluster}.${extOut}");


# Initialize parallel run
# -----------------------
  my $bpeFil = "${dirBpe}EDT${yyssss}";
  unlink(glob("${bpeFil}???.BPE"));

  my @pshFil = glob("${dirPsh}????${ssss}.${extPsh}");

  if ($clu ne "") {
    initPar_Cl($bpe,$bpeFil,@pshFil,0,$clu,0) }
  else {
    @pshFil = map { substr(basename($_),0,4) } @pshFil;
    initPar_Bl($bpe,@pshFil) }

}
