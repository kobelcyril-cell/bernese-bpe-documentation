package REPF_C7D;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  REPF_C7D
#
# Purpose :  Copy required files for IGSFIN7D.PCF in reprocessing mode
#
# PARAMs  :
#
# Author  :  P. Steigenberger
# Created :  29-Jul-2008
#
# Changes :  15-Jan-2009, PS: Added staInf
#            29-Jul-2011, PS: Added POLUPD
#            07-Feb-2012, PS: V_REPERP for a priori ERP (reprocessing)
#            21-Jun-2013, PS: Copy $KN NEQs, FIX file, uncompressed B1 clocks 
#            22-Sep-2016, AV/RD: Add PSD to copyRef
#            15-Jul-2019, IS: Copy IGS_CRX.STA
#
# ============================================================================
use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;


sub run {
  my $bpe = shift;



# Get variables
# -------------
 our  ($yyddd, $yydddm1, $yydddm2, $yydddm3, $yydddm4, $yydddm5, $yydddm6, $yydddm7, $yydddp1, 
       $yyyy, $yyyym1, $yyyym2,$yyyym3, $yyyym4,$yyyym5, $yyyym6,$yyyym7, $yyyyp1,
      $yyssss, $wwww, $v_b, $v_f, $v_k, $v_l, $v_n, $v_o,$v_w,
      $v_repErp, $crdInf, $psdInf, $staInf, $staCrx,
      $dirClk, $dirCrd, $dirErp, $dirNq0, $dirPre, $dirRpr,
      $extClk, $extCrd, $extErp, $extNq0, $extPre, $extRpr,
      $dirStd, $dirSta, $dirFix, $dirClk, $dirPsd, $dirOut,
      $extStd, $extSta, $extFix, $extClk, $extPsd, $extOut,
      $dirSum, $dirEle, $dirIep, $dirVel,
      $extSum, $extEle, $extIep, $extVel,
      ) =
    $bpe->getKeys(
      '$YD+0','$YD-1','$YD-2','$YD-3','$YD-4','$YD-5','$YD-6','$YD-7','$YD+1',
      '$Y+0','$Y-1','$Y-2','$Y-3','$Y-4','$Y-5','$Y-6','$Y-7','$Y+1',
      '$YSS+0', '$W+0', 'V_B', 'V_F', 'V_K', 'V_L', 'V_N', 'V_O','V_W',
      'V_REPERP','V_CRDINF','V_PSDINF','V_STAINF','V_SATCRX',
      'DIR_CLK','DIR_CRD','DIR_ERP','DIR_NEQ','DIR_PRE','DIR_RPR',
      'EXT_CLK','EXT_CRD','EXT_ERP','EXT_NEQ','EXT_PRE','EXT_RPR',
      'DIR_STD','DIR_STA','DIR_FIX','DIR_CLK','DIR_PSD','DIR_OUT',
      'EXT_STD','EXT_STA','EXT_FIX','EXT_CLK','EXT_PSD','EXT_OUT',
      'DIR_SUM','DIR_ELE','DIR_IEP','DIR_VEL',
      'EXT_SUM','EXT_ELE','EXT_IEP','EXT_VEL',
      );

# Prepare reference files
# -----------------------
  my $psdFil = $psdInf eq ""? "":"$psdInf.$extPsd";
  system("$ENV{AUTO}/copyRef.pl ${dirCrd}.. $crdInf $psdFil REF$yyssss");

  my $copyFrom = "$PATH_SAV/$CAMP_SAVREP";
  my $copyFrom = "$dirStd/../../";

  copyfile("$copyFrom/${yyyym3}/STA/${crdInf}_$yydddm3.${extCrd}","$dirCrd/$crdInf.${extCrd}");
  copyfile("$copyFrom/${yyyym3}/STA/${crdInf}_$yydddm3.${extVel}","$dirVel/$crdInf.${extVel}");

#  copyfile("$CDIR_FIN/MSC/COD.SKL","$dirOut/../MSC");
#  copyfile("$CDIR_FIN/MSC/COF.SKL","$dirOut/../MSC");


# Copy orbits and ERPs
# --------------------
  copyfile("$copyFrom/$yyyym7/ORB/${v_w}$yydddm7.$extErp" ,"$dirErp");
  copyfile("$copyFrom/$yyyym7/ORB/${v_w}$yydddm7.$extPre" ,"$dirPre");
  copyfile("$copyFrom/$yyyym7/ORB/${v_w}$yydddm7.$extStd" ,"$dirStd");
  copyfile("$copyFrom/$yyyyp1/ORB/${v_w}$yydddp1.$extErp" ,"$dirErp");
  copyfile("$copyFrom/$yyyyp1/ORB/${v_w}$yydddp1.$extPre" ,"$dirPre");
  copyfile("$copyFrom/$yyyyp1/ORB/${v_w}$yydddp1.$extStd" ,"$dirStd");

  copyfile("$copyFrom/$yyyym7/ORB/${v_l}$yydddm7.$extErp" ,"$dirErp");
  copyfile("$copyFrom/$yyyym7/ORB/${v_l}$yydddm7.$extPre" ,"$dirPre");
  copyfile("$copyFrom/$yyyym7/ORB/${v_l}$yydddm7.$extStd" ,"$dirStd");
  copyfile("$copyFrom/$yyyyp1/ORB/${v_l}$yydddp1.$extErp" ,"$dirErp");
  copyfile("$copyFrom/$yyyyp1/ORB/${v_l}$yydddp1.$extPre" ,"$dirPre");
  copyfile("$copyFrom/$yyyyp1/ORB/${v_l}$yydddp1.$extStd" ,"$dirStd");

  unless ( -e "$copyFrom/$yyyym7/ORB/${v_n}$yydddm7.$extPre") {
    copyfile("$copyFrom/$yyyym7/ORB/${v_l}$yydddm7.$extErp" ,"$dirErp/${v_n}$yydddm7.$extErp");
    copyfile("$copyFrom/$yyyym7/ORB/${v_l}$yydddm7.$extPre" ,"$dirPre/${v_n}$yydddm7.$extPre");
    copyfile("$copyFrom/$yyyym7/ORB/${v_l}$yydddm7.$extStd" ,"$dirStd/${v_n}$yydddm7.$extStd");
  } else {
    copyfile("$copyFrom/$yyyym7/ORB/${v_n}$yydddm7.$extErp" ,"$dirErp");
    copyfile("$copyFrom/$yyyym7/ORB/${v_n}$yydddm7.$extPre" ,"$dirPre");
    copyfile("$copyFrom/$yyyym7/ORB/${v_n}$yydddm7.$extStd" ,"$dirStd");
  }
  unless ( -e "$copyFrom/$yyyym7/ORB/${v_n}$yydddm7.$extPre") {
    copyfile("$copyFrom/$yyyyp1/ORB/${v_l}$yydddp1.$extErp" ,"$dirErp/${v_n}$yydddp1.$extErp");
    copyfile("$copyFrom/$yyyyp1/ORB/${v_l}$yydddp1.$extPre" ,"$dirPre/${v_n}$yydddp1.$extPre");
    copyfile("$copyFrom/$yyyyp1/ORB/${v_l}$yydddp1.$extStd" ,"$dirStd/${v_n}$yydddp1.$extStd");
  } else {
    copyfile("$copyFrom/$yyyyp1/ORB/${v_n}$yydddp1.$extErp" ,"$dirErp");
    copyfile("$copyFrom/$yyyyp1/ORB/${v_n}$yydddp1.$extPre" ,"$dirPre");
    copyfile("$copyFrom/$yyyyp1/ORB/${v_n}$yydddp1.$extStd" ,"$dirStd");
  }
  copyfile7("$copyFrom","${v_b}",$extIep,$dirIep);
  copyfile7("$copyFrom","${v_w}",$extErp,$dirErp);
  copyfile7("$copyFrom","${v_w}",$extPre,$dirPre);
  copyfile7("$copyFrom","${v_w}",$extStd,$dirStd);
  copyfile7("$copyFrom","${v_l}",$extIep,$dirIep);
  copyfile7("$copyFrom","${v_l}",$extErp,$dirErp);
  copyfile7("$copyFrom","${v_l}",$extPre,$dirPre);
  copyfile7("$copyFrom","${v_l}",$extStd,$dirStd);
  copyfile7("$copyFrom","${v_l}",$extEle,$dirEle);
  copyfile7("$copyFrom","${v_f}",$extIep,$dirIep);
  copyfile7("$copyFrom","${v_n}",$extIep,$dirIep);
  copyfile7("$copyFrom","${v_n}",$extErp,$dirErp);
  copyfile7("$copyFrom","${v_n}",$extPre,$dirPre);
  copyfile7("$copyFrom","${v_n}",$extStd,$dirStd);
  copyfile7("$copyFrom","${v_n}",$extEle,$dirEle);
#  copyfile3("$copyFrom","I1_",$extRpr,$dirRpr);
#  copyfile3("$copyFrom","I1_",$extStd,$dirStd);
  copyfile7("$copyFrom","B1_","$extClk",$dirClk);

# Copy station information file
# -----------------------------
#  copyfile("$ENV{REF}/$staInf.${extSta}",$dirSta);

# Copy station IGS_CRX.STA
# -------------------------
  copyfile("$copyFrom/$yyyy/STA/${staCrx}.${extSta}",${dirSta});
  
# Copy 1-d FIX file
# ------------------
  copyfile("$copyFrom/$yyyy/STA/${v_k}_$yyddd.${extFix}",$dirFix); 

# Copy B1 clocks
# ------------------
  copyfile7("$copyFrom","{v_s}","${extClk}",$dirClk); 
  copyfile7("$copyFrom","{v_t}","${extClk}",$dirClk); 
  copyfile7("$copyFrom","{v_o}","${extClk}",$dirClk); 

# Copy NEQs
# ---------
  copyfile7("$copyFrom","${v_b}","${extNq0}.gz",$dirNq0);
  copyfile7("$copyFrom","${v_f}","${extNq0}.gz",$dirNq0);
  
# Create a priori ERP file for ADDNEQ
# -----------------------------------
  copyfile("$ENV{REF}/${v_repErp}.${extErp}","${dirErp}");
  my $PGMNAM = "POLUPD";
  $bpe->RUN_PGMS($PGMNAM);

# Needed by POLXTR for weekly ERP-files
# -------------------------------------
  copyfile("$ENV{REF}/${v_repErp}.${extErp}","${dirErp}RAP_$yyyy.${extErp}");

# Copy summary files
# ------------------
  copyfile7("$copyFrom","F1W","${extSum}",$dirSum);
  copyfile7("$copyFrom","F3W","${extSum}",$dirSum);
  

# Copy the 1-day protocol files
# -----------------------------
  copyfile("$copyFrom/$yyyym6/OUT/IGSREP1D.".substr(${yyyym6},2,2)."_".substr(${yydddm6},2,3)."0" ,"$dirOut/F1D$yydddm6.PRC");
  copyfile("$copyFrom/$yyyym5/OUT/IGSREP1D.".substr(${yyyym5},2,2)."_".substr(${yydddm5},2,3)."0" ,"$dirOut/F1D$yydddm5.PRC");
  copyfile("$copyFrom/$yyyym4/OUT/IGSREP1D.".substr(${yyyym4},2,2)."_".substr(${yydddm4},2,3)."0" ,"$dirOut/F1D$yydddm4.PRC");
  copyfile("$copyFrom/$yyyym3/OUT/IGSREP1D.".substr(${yyyym3},2,2)."_".substr(${yydddm3},2,3)."0" ,"$dirOut/F1D$yydddm3.PRC");
  copyfile("$copyFrom/$yyyym2/OUT/IGSREP1D.".substr(${yyyym2},2,2)."_".substr(${yydddm2},2,3)."0" ,"$dirOut/F1D$yydddm2.PRC");
  copyfile("$copyFrom/$yyyym1/OUT/IGSREP1D.".substr(${yyyym1},2,2)."_".substr(${yydddm1},2,3)."0" ,"$dirOut/F1D$yydddm1.PRC");
  copyfile("$copyFrom/$yyyy/OUT/IGSREP1D.".substr(${yyyy},2,2)."_".substr(${yyddd},2,3)."0" ,"$dirOut/F1D$yyddd.PRC");
}


# copy +/-  1 day files for 3-day solution
# ----------------------------------------

sub copyfile7 {

   my $copyFrom = $_[0];  # Directory where to copy from
   my $filTyp = $_[1];  # 3-character file type, e.g. Q1_
   my $extTyp = $_[2];  # file extension
   my $dir    = $_[3];  # directory where to copy

   our ($yyddd, $yydddm1, $yydddm2, $yydddm3, $yydddm4, $yydddm5, $yydddm6, 
        $yyyy,  $yyyym1,  $yyyym2,  $yyyym3,  $yyyym4,  $yyyym5,  $yyyym6);
   my $filnam;

   my $subDir=substr($dir,-4);

   copyfile("$copyFrom/$yyyym6/$subDir/$filTyp$yydddm6.$extTyp" ,"$dir");
   copyfile("$copyFrom/$yyyym5/$subDir/$filTyp$yydddm5.$extTyp" ,"$dir");
   copyfile("$copyFrom/$yyyym4/$subDir/$filTyp$yydddm4.$extTyp" ,"$dir");
   copyfile("$copyFrom/$yyyym3/$subDir/$filTyp$yydddm3.$extTyp" ,"$dir");
   copyfile("$copyFrom/$yyyym2/$subDir/$filTyp$yydddm2.$extTyp" ,"$dir");
   copyfile("$copyFrom/$yyyym1/$subDir/$filTyp$yydddm1.$extTyp" ,"$dir");
   copyfile("$copyFrom/$yyyy/$subDir/$filTyp$yyddd.$extTyp" ,"$dir");


# uncompress gzip files
   if (substr($extTyp,-2) eq "gz")
    {
      foreach  ( glob "$dir/$filTyp?????.???.gz")
         { uncompress("-z gunzip",$_); }
    }

# uncompress Z files
   if (substr($extTyp,-1) eq "Z")
    {
      foreach  ( glob "$dir/$filTyp?????.???.Z")
         { uncompress($_); }
    }

}




