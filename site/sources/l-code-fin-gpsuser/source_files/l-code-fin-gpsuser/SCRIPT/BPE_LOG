package BPE_LOG;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  BPE_LOG
#
# Purpose :  Create BPE processing summary file
#            Requires variable V_PRC
#
# Author  :  U. Hugentobler
#
# Created :  20-Jul-2017
# Last mod.:
#
# Changes :
#
# ============================================================================

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $prc, $taskid, $dirOut, $dirBpe) =
    $bpe->getKeys('$YSS+0', 'V_PRC', 'TASKID', 'DIR_OUT', 'DIR_BPEOUT');

# Collect BPE output
# ------------------
  my $logFil = "${$dirBpe}${prc}${yyssss}.LOG";
  print "logfil : $logFil\n";
  print "pattern: ${dirBpe}${taskid}${yyssss}_???_???.PRT\n";
  my @files = glob("${dirBpe}${taskid}${yyssss}_???_???.PRT");
  my ($prt,$file);

  open(TMP,">$logFil");
  my $date = `date`;
  print TMP "
  ============================================================================\n";
  print TMP " date: $date\n";

# print
  foreach $file (sort @files) {

    print TMP "
    ----------------------------------------------------------------------------\n";
    print TMP " $file\n";

    $prt = 0;
    open (INP,$file);
    while (<INP>) {
      $prt = 1 if /SCRIPT  STARTED/;
      print TMP if $prt;
      $prt = 0 if /SCRIPT  ENDED/;
    }
    close (INP);
  }
  print TMP "
    ----------------------------------------------------------------------------\n";
  close (TMP);
}
