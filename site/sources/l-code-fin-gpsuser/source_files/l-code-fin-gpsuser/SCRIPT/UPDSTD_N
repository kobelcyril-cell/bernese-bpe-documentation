package UPDSTD_N;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  UPDSTD_N
#
# Purpose :  Genetare STD-files for all days of the n-day solution:
#            N can be 1 to infinity
#            Based on former BDS script
#
# Programs:  UPDSTD_N
#
# Author  :  R. Dach
# Created :  05-Jun-2019
#
# Changes :
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;

use strict;

sub run {
  my $bpe = shift;

  my ($yyyy,$ddd,$yyddd,
      $param1,$minus,$plus,
      $dirOut) = $bpe->getKeys(
      '$Y+0','$+0','$YD+0',
      'PARAM1','V_MINUS','V_PLUS',
      'DIR_OUT');

  my ($sol)  = $bpe->getKeys("V_${param1}");
  my $repro  = "${dirOut}/../MSC/REPROCESSING.FLG";
  my $updstd = "$ENV{U}/PAN/ORBGEN.INP";

  if($sol){
    $bpe->putKey($updstd,"POLE","${sol}_${yyddd}");
  }

# Run program
# -----------
  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);

# Extract remaining arcs (PM-range)
# Name -1: ???M1$YYDDD
#      +1: ???P1$YYDDD
# ---------------------------------
  my $mcount = 0;
  my $pcount = 0;

  for(my $nday = $minus; $nday <= $plus; $nday++){
    next if $nday == 0;
    my $mod  = $nday < 0? "M" : "P";
    my $cnt  = abs($nday);
    my $pm   = $nday<0? "-$cnt":"+$cnt";
    my ($yydddt) = $bpe->getKeys('$YD'.${pm});
    my $nam = "${sol}${mod}${cnt}${yydddt}";

    print "Process $nday: $yydddt\n";

    $bpe->putKey($updstd,"IMPORB","$nam");
    $bpe->putKey($updstd,"STDOUT","$nam");
    $bpe->putKey($updstd,"RPROUT","");
    $bpe->putKey($updstd,"SESSION_STRG",'$S'.$pm);
    $bpe->putKey($updstd,"SESSION_YEAR",'$Y'.$pm);
    $bpe->putKey($updstd,"STADAT",'$YMD_STR'.$pm);
    $bpe->putKey($updstd,"ENDDAT",'$YMD_STR'.$pm);
    $bpe->RUN_PGMS($PGMNAM);
  }
}
