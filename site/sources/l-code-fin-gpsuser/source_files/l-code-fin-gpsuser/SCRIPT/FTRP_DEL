package FTRP_DEL;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  FTRP_DEL
#
# Purpose :  Clean campaign from PPPTROPO.PCF processing
#
# Programs:
#
# Author  :  R. Dach
# Created :  01-Jan-2021
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------
use strict;

sub run {
  my $bpe = shift;

# Get variables
# -------------
 my  ($yyssss, $yyddd, $ssss,
      $ppp, $crd, $orb, $v_del,
      $dirOut, $dirSum, $dirCrd, $dirFix, $dirGrd, $dirLst,
      $extOut, $extSum, $extCrd, $extFix, $extGrd, $extLst,
      $dirClk, $dirErp, $dirOsb, $dirStd,
      $extClk, $extErp, $extOsb, $extStd,
      $dirPzh, $dirPzo, $dirCzh, $dirCzo,
      $extPzh, $extPzo, $extCzh, $extCzo,
      $dirIon, $dirTrp, $dirTro, $dirSla,
      $extIon, $extTrp, $extTro, $extSla) =

    $bpe->getKeys(
      '$YSS-1', '$YD-1', '$S-1',
      'V_PPP', 'V_CRD', 'V_ORB', 'V_DEL',
      'DIR_OUT', 'DIR_SUM', 'DIR_CRD', 'DIR_FIX', 'DIR_GRD', 'DIR_LST',
      'EXT_OUT', 'EXT_SUM', 'EXT_CRD', 'EXT_FIX', 'EXT_GRD', 'EXT_LST',
      'DIR_CLK', 'DIR_ERP', 'DIR_OSB', 'DIR_STD',
      'EXT_CLK', 'EXT_ERP', 'EXT_OSB', 'EXT_STD',
      'DIR_PZH', 'DIR_PZO', 'DIR_CZH', 'DIR_CZO',
      'EXT_PZH', 'EXT_PZO', 'EXT_CZH', 'EXT_CZO',
      'DIR_ION', 'DIR_TRP', 'DIR_TRO', 'DIR_TRS',
      'EXT_ION', 'EXT_TRP', 'EXT_TRO', 'EXT_TRS');


# Delete Files if requested
# -------------------------

 if ( ${v_del} eq "Y" )
  {

       unlink glob "$dirOut*.J_lk";

# ATM
       unlink glob "$dirTrp/${ppp}${ssss}????.${extTrp}";
       unlink glob "$dirTro/${ppp}${ssss}????.${extTro}";
       unlink glob "$dirSla/${ppp}${ssss}????.${extSla}";
       unlink glob "$dirTro/${ppp}_${yyssss}.${extTro}";
       unlink glob "$dirSla/SLA_${yyssss}.tar.gz";
       unlink glob "$dirIon/HOI${yyddd}.${extIon}";

# BPE

# GRD
       unlink glob "$dirGrd/VMF${yyddd}.${extGrd}";

# OBS
       unlink glob "$dirPzh/????${ssss}.${extPzh}";
       unlink glob "$dirPzo/????${ssss}.${extPzo}";
       unlink glob "$dirCzh/????${ssss}.${extCzh}";
       unlink glob "$dirCzo/????${ssss}.${extCzo}";

# ORB
       unlink glob "$dirClk/${orb}${yyssss}.${extClk}";
       unlink glob "$dirErp/${orb}${yyssss}.${extErp}";
       unlink glob "$dirOsb/${orb}${yyssss}.${extOsb}";
       unlink glob "$dirStd/${orb}${yyssss}.${extStd}";

# ORX

# OUT
       unlink glob "$dirSum/OBS_${yyssss}.${extSum}";
       unlink glob "$dirOut/OBS_${yyssss}.${extOut}";
       unlink glob "$dirOut/${ppp}${ssss}????.${extOut}";
       unlink glob "$dirSum/${ppp}_${yyssss}.${extSum}";

# RAW

# SOL

# STA
       unlink glob "$dirCrd/${crd}${yyssss}.${extCrd}";
       unlink glob "$dirFix/REF${yyssss}.${extFix}";
       unlink glob "$dirLst/FIL${yyssss}.${extLst}";
  }

}
