package FOBS_SAV;
@ISA = ("RUNBPE");
# ==========================================================================
#
# Name    :  FOBS_SAV
#
# Purpose :  Save the observation file into an archive
#
# Programs:
#
# Author  :  A. Villiger
#
# Created :  11-Mar-2020
#
# Changes :  11-Mar-2020 AV: Forged from ZOBS_SAV
#            19-Mai-2020 AV: Store do yearly sub directory
#            30-Jul-2020 ST: Add use igs_device.
#
# ==========================================================================

use strict;
use File::Basename qw(dirname basename);
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil qw(msg2key);
use lib "$ENV{BPE}";
use bpe_util;

# --------------------------------------------------------------------------

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss,$ssss,$yyyy,
      $camp_pth, $campaign, $obstar, $v_sav, $repsav,$sav,
      $dirCzh,  $dirCzo,  $dirPzh,  $dirPzo,
      $extCzh,  $extCzo,  $extPzh,  $extPzo) =
     $bpe->getKeys(
      '$YSS+0','$S+0','$Y+0',
      'CAMP_PTH','CAMPAIGN','V_OBSTAR','V_SAV','V_REPSAV','V_SAV',
      'DIR_CZH','DIR_CZO','DIR_PZH','DIR_PZO',
      'EXT_CZH','EXT_CZO','EXT_PZH','EXT_PZO');

  print "$dirCzh,  $dirCzo,  $dirPzh,  $dirPzo\n $extCzh,  $extCzo,  $extPzh,  $extPzo\n";
# Define the directories for final processing (default)
  my $obsTar = "$CDIR_DATA/OBS/$obstar$yyssss.tar.gz";

# Change paths for a reprocessing
# -------------------------------
  if ($repsav) {
    $obsTar = "$PATH_SAV${repsav}/$yyyy/OBS/$obstar$yyssss.tgz";
  }else{
    $obsTar = "$ENV{D}/OBS/$yyyy/FCLK$yyssss.tgz";
  }

# Saving not allowed
# ------------------
  if ( $v_sav ne "Y" ) {
    prtMess($bpe,"FILES NOT SAVED");
    $obsTar = "";
  }

# Archive observation files
# -------------------------
  if ($obsTar ne "" && $sav eq "Y") {
    &check_dir(&dirname($obsTar));
    print "OBSTAR: $obsTar\n";
    # Create the archives
    system ("tar -cvf - ${dirCzh}????$ssss.$extCzh " .
                       "${dirCzo}????$ssss.$extCzo " .
                       "${dirPzh}????$ssss.$extPzh " .
                       "${dirPzo}????$ssss.$extPzo | gzip -c > $obsTar");

  }
}
