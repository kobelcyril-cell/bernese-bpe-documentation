package GIM_DIS;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GIM_DIS
#
# Purpose :  Distribute and save GIM products
#
# Programs:
#
# Author  :  R. Dach
# Created :  14-Dec-2007
#
# Changes :  27-Aug-2008/rd,ss: Stop supporting BSWUSER/BSWUSER42
#            12-Aug-2009/ss: Copy COD DCB in compressed form
#            10-Jun-2014/ss: Save BIA results
#            05-Nov-2014/ss: Ignored Z3N results
#            06-Nov-2014/ss: Compressed Z1N ION
#            31-May-2016/ss: Updated due to OSB implementation
#            14-Jun-2016/ss: Completely revised
#            29-Jun-2016/ss/av: Save extra bias calibration results
#            04-Jul-2016/ss: Do no longer save Z1_ NQ0
#            24-Aug-2016/ss: Save Z3I OSB/BIA results
#            07-Feb-2018 SS: Use V_SAV (not V_DIS) for copyaftp
#            09-Jan-2023 SS: Used long filenames
#
# ----------------------------------------------------------------------------
use strict;

use lib "$ENV{AUTO}";
use gpsutil;

use lib "$ENV{BPE}";
use bpe_util;


sub run {
  my $bpe = shift;

# Define variables
# ----------------
  my ($yyddd, $yy, $yyyy,
      $yydddm1, $dddm1, $yyyym1, $wwwwdm1,
      $repro,
      $E, $H, $C, $W, $X, $Z, $F,
      $sav, $dis, $del, $mix,
      $dirOut, $dirInx, $dirIon, $dirOsb, $dirBia, $dirNeq, $dirClk, $dirRxc,
      $extOut, $extInx, $extIon, $extOsb, $extBia, $extNeq, $extClk, $extRxc) =
    $bpe->getKeys('$YD+0', '$Y', '$Y+0',
      '$YD-1', '$-1', '$Y-1', '$WD-1',
      'V_REPRO',
      'V_E', 'V_H', 'V_C', 'V_W', 'V_X', 'V_Z', 'V_F',
      'V_SAV', 'V_DIS', 'V_DEL', 'V_MIX',
      'DIR_OUT','DIR_INX','DIR_ION','DIR_OSB','DIR_BIA','DIR_NEQ','DIR_CLK','DIR_RXC',
      'EXT_OUT','EXT_INX','EXT_ION','EXT_OSB','EXT_BIA','EXT_NEQ','EXT_CLK','EXT_RXC');

  my $yym1 = sprintf "%2.2d", $yyyym1 % 100;


# Adjust resulting INX files in case of GPS/GLONASS-combined processing
# ---------------------------------------------------------------------
  if ( $mix eq "" ) {
    prtErr($bpe,"V_MIX UNDEFINED"); die();
  } elsif ($mix eq "Y" ) {
    my $inxFil = "$dirInx/${E}_${yyddd}.$extInx";
##    replace ($inxFil,"GPS                 ","GNSS                ");

    $inxFil = "$dirInx/${H}_${yydddm1}.$extInx";
##    replace ($inxFil,"GPS                 ","GNSS                ");
  }


# Copy final ionosphere products to ftp server
# --------------------------------------------
  unless($repro){
    if ( $sav eq "Y") {

      my $fil = "$dirInx/${H}_${yydddm1}.$extInx";
##      copyaftp("-c",$fil,"CODE/$yyyym1/CODG${dddm1}0.${yym1}I");
      copyaftp("-g",$fil,"CODE/$yyyym1/COD0OPSFIN_${yyyym1}${dddm1}0000_01D_01H_GIM.INX");

      $fil = "$dirIon/${H}_${yydddm1}.$extIon";
##      copyaftp("-c",$fil,"CODE/$yyyym1/COD${wwwwdm1}.ION");
      copyaftp("-g",$fil,"CODE/$yyyym1/COD0OPSFIN_${yyyym1}${dddm1}0000_01D_01H_GIM.ION");

##    $fil = "$dirOsb/${H}_${yydddm1}.$extOsb";
##    copyaftp("-c",$fil,"BSWUSER50/ORB/$yyyym1/COD${yydddm1}.DCB"  );

      $On_Error_Cont = 1;
      err_print() || die();
    }



# Remove rapid/predicted ionosphere products from ftp server
# ----------------------------------------------------------
    if ( $del eq "Y" ) {

      unlink glob ("$PATH_AFTP$CAMP_CODE/COD?OPSRAP_${yyyym1}${dddm1}0000_01D_01H_GIM.???*");
      unlink glob ("$PATH_AFTP$CAMP_CODE/CO?G${dddm1}0.${yym1}I*");
      unlink glob ("$PATH_AFTP$CAMP_CODE/COD${wwwwdm1}.ION*");
      unlink glob ("$PATH_AFTP$CAMP_BSW*/ORB/${yyyym1}/COR${yydddm1}.DCB*");

    }
  }


# Copy final ionosphere products to save disk
# -------------------------------------------
# $E=Z1 / $H=Z3 / $C=S1 / $W=C1 / $F=A1 / $X=X1 / $Z=Z1

  if ( $sav eq "Y" ) {

    my ($nam,@nam,$inp,$out);

# 3-day results:
# --------------
    my $dirSav = $repro ?   "$PATH_SAV/REPRO_ION/$yyyym1/":
                            "$PATH_SAV/$CAMP_SAVIGS/$yyyym1/";
    my $orbSav = "$dirSav/ORB/";
    my $atmSav = "$dirSav/ATM/";
    my $solSav = "$dirSav/SOL/";
    my $outSav = "$dirSav/OUT/";
    check_dir($orbSav,$atmSav,$solSav,$outSav);

    unless($repro){
      if ($yyddd ne "16136") {
        $nam = "${H}_${yydddm1}.$extIon";
        $inp = "$dirIon/$nam";
        $out = "$atmSav/$nam";
        copyfile($inp,$out);
        die "$inp not found" unless -s $inp;

        $nam = "${H}_${yydddm1}.$extInx";
        $inp = "$dirInx/$nam";
        $out = "$atmSav/$nam";
        copyfile($inp,$out);
        compress($out);
        die "$inp not found" unless -s $inp;

        $nam = "${H}I${yydddm1}.$extOsb";
        $inp = "$dirOsb/$nam";
        $out = "$orbSav/$nam";
        copyfile($inp,$out);
        die "$inp not found" unless -s $inp;

        $nam = "${H}I${yydddm1}.$extBia";
        $inp = "$dirBia/$nam";
        $out = "$orbSav/$nam";
        copyfile($inp,$out);
        die "$inp not found" unless -s $inp;
      }
    }

    $dirSav = $repro ? "$PATH_SAV/REPRO_ION/$yyyy/":
                       "$PATH_SAV/$CAMP_SAVIGS/$yyyy/";
    $dirSav = "$PATH_SAV/$CAMP_SAVIGS/$yyyy/";
    $orbSav = "$dirSav/ORB/";
    $atmSav = "$dirSav/ATM/";
    $solSav = "$dirSav/SOL/";
    $outSav = "$dirSav/OUT/";
    check_dir($orbSav,$atmSav,$solSav,$outSav);

# .NQ0:
    @nam = (
##            "${E}_${yyddd}",
            "${E}B${yyddd}","${E}G${yyddd}","${E}R${yyddd}","${E}I${yyddd}","${E}X${yyddd}",
            "${C}B${yyddd}","${C}G${yyddd}","${C}R${yyddd}",                "${C}X${yyddd}",
            "${W}B${yyddd}","${W}G${yyddd}","${W}R${yyddd}",
                            "${F}G${yyddd}","${F}R${yyddd}","${F}V${yyddd}",
            "${C}M${yyddd}",
            );
    for (@nam) {
      next if $repro && $_=~/^..S${yyddd}/;
      $nam = "$_.$extNeq";
      $inp = "$dirNeq/$nam";
      $out = "$solSav/$nam";
      copyfile($inp,$out);
      system("gzip -f $out");
      die "$inp not found" unless -s $inp;
    }

# .ION:
    @nam = (
            "${E}_${yyddd}","${Z}S${yyddd}","${Z}F${yyddd}","${X}R${yyddd}","${C}_${yyddd}",
            );
    for (@nam) {
      $nam = "$_.$extIon";
      $inp = "$dirIon/$nam";
      $out = "$atmSav/$nam";
      copyfile($inp,$out);
      die "$inp not found" unless -s $inp;
    }

# .INX:
    @nam = (
            "${E}_${yyddd}","${Z}S${yyddd}","${Z}F${yyddd}","${X}R${yyddd}",
            );
    for (@nam) {
      $nam = "$_.$extInx";
      $inp = "$dirInx/$nam";
      $out = "$atmSav/$nam";
      copyfile($inp,$out);
      compress($out);
      die "$inp not found" unless -s $inp;
    }

# .OSB:
    @nam = (
            "${E}S${yyddd}","${E}F${yyddd}","${E}R${yyddd}","${E}G${yyddd}","${E}I${yyddd}",
            "${C}S${yyddd}","${C}F${yyddd}","${C}R${yyddd}","${C}G${yyddd}",
            "${W}S${yyddd}","${W}F${yyddd}","${W}R${yyddd}","${W}G${yyddd}",
            "${F}S${yyddd}","${F}F${yyddd}","${F}R${yyddd}","${F}G${yyddd}",
            "${E}I${yyddd}","${E}E${yyddd}","${X}R${yyddd}","${W}C${yyddd}","${F}V${yyddd}",
            "${C}_${yyddd}",
            );
    for (@nam) {
      $nam = "$_.$extOsb";
      $inp = "$dirOsb/$nam";
      $out = "$orbSav/$nam";
      copyfile($inp,$out);
      die "$inp not found" unless -s $inp;
    }

# .BIA:
    @nam = (
            "${E}S${yyddd}","${E}F${yyddd}","${E}R${yyddd}","${E}G${yyddd}","${E}I${yyddd}",
            "${C}S${yyddd}","${C}F${yyddd}","${C}R${yyddd}","${C}G${yyddd}",
            "${W}S${yyddd}","${W}F${yyddd}","${W}R${yyddd}","${W}G${yyddd}",
            "${F}S${yyddd}","${F}F${yyddd}","${F}R${yyddd}","${F}G${yyddd}",
            "${E}I${yyddd}","${E}E${yyddd}","${X}R${yyddd}","${W}C${yyddd}","${F}V${yyddd}",
            "${C}_${yyddd}",
            );
    for (@nam) {
      $nam = "$_.$extBia";
      $inp = "$dirBia/$nam";
      $out = "$orbSav/$nam";
      copyfile($inp,$out);
      die "$inp not found" unless -s $inp;
    }

# .OUT:x
    $nam = "${C}M${yyddd}.$extOut";
    $inp = "$dirOut/$nam";
    $out = "$outSav/$nam";
    copyfile($inp,$out);
    die "$inp not found" unless -s $inp;

# .DCB:
    $nam = "OFF${yyddd}.DCB";
    $inp = "$dirOsb/$nam";
    $out = "$orbSav/$nam";
    copyfile($inp,$out);
    die "$inp not found" unless -s $inp;

# OSB2DCB:
    $nam = "${E}R${yyddd}.$extOsb";
    $inp = "$dirOsb/$nam";
    $out = "$orbSav/Z3_${yyddd}.DCB";
    system("$ENV{AUTO}/osb2dcb.com $inp $out P1-P2");
    die "$out not created" unless -s $out;

    $nam = "${E}G${yyddd}.$extOsb";
    $inp = "$dirOsb/$nam";
    $out = "$orbSav/Z31${yyddd}.DCB";
    system("$ENV{AUTO}/osb2dcb.com $inp $out P1-C1");
    die "$out not created" unless -s $out;

    $nam = "${E}G${yyddd}.$extOsb";
    $inp = "$dirOsb/$nam";
    $out = "$orbSav/Z32${yyddd}.DCB";
    system("$ENV{AUTO}/osb2dcb.com $inp $out P2-C2");
    die "$out not created" unless -s $out;

    $nam = "${C}R${yyddd}.$extOsb";
    $inp = "$dirOsb/$nam";
    $out = "$orbSav/Z1N${yyddd}.DCB";
    system("$ENV{AUTO}/osb2dcb.com $inp $out P1-P2");
    die "$out not created" unless -s $out;

    $nam = "${W}G${yyddd}.$extOsb";
    $inp = "$dirOsb/$nam";
    $out = "$orbSav/C1_${yyddd}.DCB";
    system("$ENV{AUTO}/osb2dcb.com $inp $out P1-C1");
    die "$out not created" unless -s $out;
##    system ("$ENV{AUTO}/dcb_downweight.com $out $MJD");

    $nam = "${F}G${yyddd}.$extOsb";
    $inp = "$dirOsb/$nam";
    $out = "$orbSav/A10${yyddd}.DCB";
    system("$ENV{AUTO}/osb2dcb.com $inp $out P1-P2");
    die "$out not created" unless -s $out;

    $nam = "${F}G${yyddd}.$extOsb";
    $inp = "$dirOsb/$nam";
    $out = "$orbSav/A11${yyddd}.DCB";
    system("$ENV{AUTO}/osb2dcb.com $inp $out P1-C1");
    die "$out not created" unless -s $out;

    $nam = "${F}G${yyddd}.$extOsb";
    $inp = "$dirOsb/$nam";
    $out = "$orbSav/A12${yyddd}.DCB";
    system("$ENV{AUTO}/osb2dcb.com $inp $out P2-C2");
    die "$out not created" unless -s $out;

##    $nam = "${W}_${yyddd}.$extClk";
##    copyfile("$dirClk/$nam","$orbSav/$nam");

##    $nam = "${W}_${yyddd}.$extRxc";
##    copyfile("$dirRxc/$nam","$outSav/$nam");
##    compress("$outSav/$nam");

    $On_Error_Cont = 1;
    err_print() || die();
  }

}
