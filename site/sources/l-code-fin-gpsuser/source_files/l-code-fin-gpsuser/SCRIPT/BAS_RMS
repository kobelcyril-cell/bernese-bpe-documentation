package BAS_RMS;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  BAS_RMS
#
# Purpose :  Extract RMS from BASEST checking output files.
#
# Programs:
#
# PARAMs  :  PARAM1 - Solution type descriptor
#
# Author  :  S. Schaer
# Created :  01-Nov-2016
#
# Changes :  01-Nov-2016/ss: Derived from FIL_VER
#
# ----------------------------------------------------------------------------
use lib "$ENV{AUTO}";
use gpsutil;
use lib $ENV{BPE};
use bpe_util;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ddd, $ssss, $param1,
      $repro,
      $pcfFil, $taskId,
      $dirOut,$extOut,$dirOsb,$extOsb,$dirBia,$extBia,$dirRes,$extRes) =
    $bpe->getKeys('$YD+0', '$+0', '$S+0', 'PARAM1',
                  'V_REPRO',
                  'PCFFIL', 'TASKID',
                  'DIR_OUT','EXT_OUT','DIR_OSB','EXT_OSB','DIR_BIA','EXT_BIA','DIR_RES','EXT_RES');

  $pcfFil = (split('\.',$pcfFil))[0];

  $param1 = "RMS" if $param1 eq "";

  my $outFil = "${dirOut}${ddd}????.${extOut}";
  print "OUTFIL: $outFil\n";

  my $chkFil = "${dirOut}${param1}${yyddd}.CHK";
  print "CHKFIL: $chkFil\n";

  if (-s $chkFil) { move($chkFil,$chkFil."_OLD") }

  system("grep -i posteriori $outFil | grep ' M ' | sort -n -k9 > $chkFil");
  replace($chkFil,$dirOut,"");
  replace($chkFil," A POSTERIORI SIGMA OF UNIT WEIGHT  :","");
  replace($chkFil,' M  \(SIGMA OF ONE-WAY L1 PHASE OBSERVABLE AT ZENITH\)',"");

# Run program
# -----------
  $bpe->putKey("$ENV{U}/PAN/MENU_EXT.INP","EXT_SUM","LST");

  $bpe->putKey("$ENV{U}/PAN/RESRMS.INP","RESFIL","\$+0????");
  $bpe->putKey("$ENV{U}/PAN/RESRMS.INP","SYSOUT","${param1}\$YD+0");
  $bpe->putKey("$ENV{U}/PAN/RESRMS.INP","OUTPUT","${param1}\$YD+0");

  my $PGMNAM = "RESRMS";
  $bpe->RUN_PGMS($PGMNAM);

  unlink(glob($outFil));

  my $resFil = "${dirRes}${ddd}????.${extRes}";
  unlink(glob($resFil));

}
