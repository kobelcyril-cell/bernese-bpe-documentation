package IERS_XTR;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  IERS_XTR
#
# Purpose :  Extract IERS file
#
# PARAMs  :
#
# Author  :  U. Hugentobler
# Created :  30-Dec-2004
# Changes :  16-Jul-2019 IS: copy lstfil if necessary
#            24-Sep-2026 RD: Add extension to list file
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use File::Basename;

use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ( $dirOut, $dirLst, $extLst, $u_old, $optDir ) =  
    $bpe->getKeys ( 'DIR_OUT', 'DIR_LST', 'EXT_LST', 'U_OLD', 'OPT_DIR' );

# Get POLXTR list filename
# ------------------------
  my $lstfilbase = basename($bpe->getKey("$ENV{U}/PAN/POLXTR.INP","EPLIST"));
  $lstfilbase =  $lstfilbase  . ".$extLst" unless $lstfilbase =~ /${extLst}$/;
  my $lstfil = $dirLst.$lstfilbase;
  print "Listfile: $lstfil\n";

  unless (-s $lstfil) {
    copyfile("${u_old}/OPT/${optDir}/$lstfilbase",${dirOut});
  }

# Execute  iers_xtr
# -----------------
  @ARGV=($lstfil);
  do ("$ENV{AUTO}/iers_xtr.pl");

# Make a copy back to $U/OPT/
# ---------------------------
  if ( -s "$lstfil" ) {
    copyfile("$lstfil","${u_old}/OPT/${optDir}");
  } else {
    die "$lstfil is missing!\nTry to use the copy from ${u_old}/OPT/${optDir}\n";
  }

# Run program
# -----------
  my $PGMNAM = "POLXTR";
  $bpe->RUN_PGMS($PGMNAM);

}
