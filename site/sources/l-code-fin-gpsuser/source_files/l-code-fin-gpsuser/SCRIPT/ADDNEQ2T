package ADDNEQ2T;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ADDNEQ2T
#
# Purpose :  Combine NQ0 files to generate a n-day solution
#
# Programs:  ADDNEQ2, GPSXTR
#
# PARAMs  :  PARAM1 - Solution variable name
#            PARAM2 - Third character of solution name (optionally)
#            PARAM3 - Minus day for TRP FLG check
#            PARAM4 - Plus  day for TRP FLG check
#
# Author  :  M. Meindl, S. Schaer
# Created :  30-Jul-2003
#
# Changes :  07-Oct-2010/ss: Adapted for final processing
#            07-Oct-2010/ss: Consider TRP FLG files of three days
#            03-Oct-2012/ss: Several generalizations
#            04-Oct-2012/ss: Further developed and activated for FIN/RAP/ULT
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use lib "$ENV{EXE}";
use Gps_Date;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $dayWeek, $xtr, $pcfFil,
      $param1 ,$param2, $param3, $param4, $param5, $param6,
      $dirOut, $dirEle, $extEle) =
    $bpe->getKeys('$YD+0', 'DAYWEEK', 'V_XTR', 'PCFFIL',
                  'PARAM1', 'PARAM2', 'PARAM3', 'PARAM4', 'PARAM5', 'PARAM6',
                  'DIR_OUT', 'DIR_ELE', 'EXT_ELE');

  $param1 = $$bpe{"V_$param1"};
  $pcfFil = (split('\.',$pcfFil))[0];

  die "Unexpected length of PARAM1 ($param1)\n" unless length($param1) == 2;
  die "Unexpected length of PARAM2 ($param2)\n" if     length($param2) >  1;
  die "Undefined PARAM3\n" if $param3 eq "" && $param4 ne "";
  die "Undefined PARAM4\n" if $param3 ne "" && $param4 eq "";

##  $param3 = -1 if $param3 eq "";
##  $param4 = +1 if $param4 eq "";
  $param6 = $param5 if $param6 eq "";

  my $sol2 = $param1;
  my $sol3 = $param1."_";
  $sol2 = "_".$param2     if $param2 ne "";
  $sol3 = $param1.$param2 if $param2 ne "";

# Consider TRP FLG files
# ----------------------
  my ($i,$yyddd0,$flgFil,$num,$str,$yyddd1);
  my $numFlg = 0;
  if ($param3 ne "") {
    for ($i=$param3;$i<=$param4;$i++) {
      $yyddd0 = gps_date("-yd $yyddd -d $i -o %y%j");
      $flgFil = "${dirOut}../MSC/TRP_${yyddd0}.FLG";
      if (-s $flgFil) {
        prtMess($bpe,"TRP FLG file found: $flgFil");
        $numFlg++;
      }
    }
    $num = $param4-$param3+1;
    print "NUM: $num\n";
    if ($numFlg>0 && $numFlg<$num) {
      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","TRP_ELIM","BEFORE_STACKING");
      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","GRD_ELIM","BEFORE_STACKING");
      prtMess($bpe,"TRP model change detected: # of FLG: $numFlg");
      prtMess($bpe,"TRP parameter pre-elimination set to BEFORE_STACKING");
##      msg2key("BPE","${pcfFil}_${yyddd}: ADDNEQ2N: TRP parameter pre-elimination set to BEFORE_STACKING: # of FLG: $numFlg");
      msg2key("MSC","${pcfFil}_${yyddd}: ADDNEQ2N: TRP parameter pre-elimination set to BEFORE_STACKING: # of FLG: $numFlg");
    } else {
##      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","TRP_ELIM","BEFORE_STACKING");
##      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","GRD_ELIM","BEFORE_STACKING");
      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","TRP_ELIM","EXCEPT_FOR_BOUNDARIES");
      $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","GRD_ELIM","EXCEPT_FOR_BOUNDARIES");
      prtMess($bpe,"No TRP model change detected: # of FLG: $numFlg");
    }
  }

# Run programs
# ------------
  my $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

  if ($xtr ne "") {
    $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",$$bpe{SYSOUT});

    $PGMNAM = "GPSXTR";
    $bpe->RUN_PGMS($PGMNAM);
  }

}

