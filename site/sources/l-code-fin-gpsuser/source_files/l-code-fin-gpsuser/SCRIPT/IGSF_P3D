package IGSF_P3D;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  IGSF_P3D
#
# Purpose :  Make a "protocol" of the final 3-day solution
#
# PARAMs  :
#
# Author  :  S. Lutz
#
# Created :  05-Jun-2013
#
# Changes :  18-Sep-2000/SS: Change extension of ASPLIT file from DDD to YY_DDD
#            18-Sep-2000/SS: Change extension of ORBCHK file from DDD to YY_DDD
#            22-Aug-2001/SS: Do no longer consider output coming from old ADDNEQ program
#            05-Jun-2013 SL: BDS to Perl
#            25-Sep-2013 LP: ORB_CHK results are optional (CONT_ERR)
#            17-Mar-2015 RD/SS: F3I considered
#            01-Sep-2021 RD/ST/LP: Add printing of BPE server variables
#            09-Jul-2026 EB: generate istp/TRA files
#
# ============================================================================

use strict;
use warnings;

use lib "$ENV{BPE}";
use bpe_util qw(appFile timprt reportBPEvariables);

sub run {

  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyssss,$yy,$yyyy,$ssss,$yyddd,$ddd,$wwwwd,
    $z,
    $pthPcf, $pcfNam, $script,
    $dirLst,$extLst,
    $dirOut,$extOut,
    $dirRpr,$extRpr,
    $dirSmc,$extSmc,
    $dirSum,$extSum,
    $dirStd,$extStd,
  ) =
  $bpe->getKeys(
    '$YSS+0','$Y','$Y+0','$S+0','$YD+0','$+0','$WD+0',
    'V_Z',
    'PTH_PCF', 'PCFFIL','SCRIPT',
    'DIR_LST','EXT_LST',
    'DIR_OUT','EXT_OUT',
    'DIR_RPR','EXT_RPR',
    'DIR_SMC','EXT_SMC',
    'DIR_SUM','EXT_SUM',
    'DIR_STD','EXT_STD',
  );

# Initialize processing summary file
# ----------------------------------
  my $prcFil = "${dirOut}F3D${yyddd}.PRC";
  unlink($prcFil);

  my $log = "";
  my $logFil = "$ENV{HOME}/LOG/IGSFINAL.LOG";
  if(-s $logFil) {
    my(@yss) = ();
    open(LOG,"<$logFil");
    while(<LOG>) {
      push(@yss,$_) if($_ =~ /^Year\/session:/);
      $log .= $_ if($_ =~ /^IGSFINAL job/);
      $log .= $_ if($_ =~ /^IGSFINAL three/);
    }
    close(LOG);
    $log = "" unless($yss[1] =~ "$yyyy/$ssss");
  }
  $log .= "IGSFIN3D finished at: ".gmtime(time)." UT";
  appFile($log,0,"",$prcFil,0);

  appFile("FINAL 3D BPE PROCESSING SUMMARY FOR YEAR-SESSION $yy-$ssss",
    0,"",$prcFil,0);

# Report the BPE settings
# -----------------------
  open(PRC,">> $prcFil");
  print PRC "Summary file generated at ",timprt()," by $script\n\n";

  $pthPcf =~ s/$$bpe{U}/$$bpe{U_OLD}/;
  print "${pthPcf}/${pcfNam}\n";
  print PRC reportBPEvariables($bpe,"${pthPcf}/${pcfNam}");
  print PRC "\n\n";

  close PRC;

# Append summary files
# --------------------
  my $sumFil;
  $sumFil = "${dirSum}${z}1${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${z}O${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${z}_${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${z}H${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${z}R${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${z}C${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${z}G${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${z}S${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${z}T${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  $sumFil = "${dirSum}${z}I${yyddd}.${extSum}";
  appFile("",0,$sumFil,$prcFil,1);
  appFile("",1,"",$prcFil,0);

  $sumFil = "${dirLst}${z}G${wwwwd}.${extLst}";
  appFile("",2,$sumFil,$prcFil,0);  # CONT_ERR

  $sumFil = "${dirOut}ORBCHK.${yy}_${ssss}";
  appFile("",1,$sumFil,$prcFil,0);  # CONT_ERR
  $sumFil = "${dirOut}ASPLIT.${yy}_${ssss}";
  appFile("",1,$sumFil,$prcFil,0);  # CONT_ERR

  print "\nProcessing summary file created: $prcFil\n";

# Generate istp files for T and I type (generates a TRA file)
# -----------------------------------------------------------
  system("$ENV{AUTO}/extract_istp.pl -f ${dirOut}${z}T${yyddd}.$extOut");
  system("$ENV{AUTO}/extract_istp.pl -f ${dirOut}${z}I${yyddd}.$extOut");
 
# Delete Obsolete Files
# ---------------------
  my @delLst = (
    "${dirStd}${z}G${wwwwd}.${extStd}",
    "${dirRpr}${z}G${wwwwd}.${extRpr}",
  );

  foreach(@delLst) {
    my(@f) = glob("$_*");
    print "\n$_: ".scalar(@f)."\n";
    foreach my $f(@f) {
      unlink($f);
      print "  $f removed\n";
    }
  }

}

# ============================================================================

__END__
