package FCLK4PRE;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  FCLK4PRE
#
# Purpose :  Copy relevant final CLK files into IGSFINAL campaign
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  10-Feb-2017
#
# Changes :  22-Apr-2020 RD: Remove the 1-day part
#            22-Aug-2022 AV: Different directory for I20
#            30-Nov-2022 SS: Copied F3U CLK (to get second midnight epoch)
#            02-Dec-2022 AV: Undo temporary changes (IGS20 active)
#
# ============================================================================

use strict;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $yyddd, $mjd, $yyyy, $wwwwd, 
      $V_U, $V_C,
      $crdInf,
      $dirOut, $dirClk,
      $extOut, $extClk, $extLst,
      ) =
    $bpe->getKeys(
      '$YSS+0', '$YD+0', '$JD+0', '$Y+0', '$WD+0',
      'V_U', 'V_C',
      'V_CRDINF',
      'DIR_OUT', 'DIR_CLK',
      'EXT_OUT', 'EXT_CLK', 'EXT_LST',
      );

   my $SATCLK = "${dirClk}${V_U}_${yyssss}.${extClk}";
   my $FINDIR = "$ENV{P}/IGSFINAL/ORB/${V_U}_${yyddd}.${extClk}";
   $FINDIR = "$ENV{R}/I20FINAL/ORB/${V_U}_${yyddd}.${extClk}" if $crdInf=~/IGSxx/;
   copyfile($SATCLK,$FINDIR);
   die "$SATCLK not found\n" unless -s $SATCLK;

   if ($mjd>=55910 || $crdInf=~/IGS20/) {
     $SATCLK = "${dirClk}${V_C}_${yyssss}.${extClk}";
     $FINDIR = "$CDIR_FIN/ORB/${V_C}_${yyddd}.${extClk}";
##     $FINDIR = "$ENV{R}/I20FINAL/ORB/${V_C}_${yyddd}.${extClk}" if $crdInf=~/IGSxx/;
     copyfile($SATCLK,$FINDIR);
     die "$SATCLK not found\n" unless -s $SATCLK;
   }

}
