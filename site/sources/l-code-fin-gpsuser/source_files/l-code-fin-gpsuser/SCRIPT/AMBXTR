package AMBXTR;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  AMBXTR
#
# Purpose :  Generate summary of the paralel ambiguity fixing
#
# Programs:  GPSXTR
#
# Author  :  M. Meindl
# Created :  27-Jan-2005
#
# Changes :  23-Jul-2008 PS: Prepared for reprocessing
#            28-Feb-2011 SS: NL summaries forced to GPS-only
#            03-Oct-2014 lp: Change of GNSS selection (AMBLOD)
#            02-Oct-2017 SS: Added NLR and L3R summaries
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use File::Copy;

sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yyssss,  $ddd, $yy, $ssss,
      $dirSum,  $extSum,
      $dirOut,  $extOut)
      = $bpe->getKeys(
      '$YSS+0','$+0', '$Y', '$S+0',
      'DIR_SUM','EXT_SUM',
      'DIR_OUT','EXT_OUT');

  my $fixsum = "$dirOut/AMB${yyssss}.SUM";
  unlink $fixsum;
  unlink (glob "${dirOut}???${yyssss}.AMB");


  my $filMlwX="MLWX${yyssss}";
  my $filAmbX="AMBX${yyssss}";
  my $mlwxtr = "${dirSum}${filMlwX}.${extSum}";
  my $ambxtr = "${dirSum}${filAmbX}.${extSum}";

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","QIFOUT",$filMlwX);
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBOUT",$filAmbX);

  my $PGMNAM = "GPSXTR";

# Check all GPSEST WIDELANE runs using GPSXTR
# -------------------------------------------
  unlink("$mlwxtr","$ambxtr");

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBLOD","1");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","WL");
  $bpe->RUN_PGMS($PGMNAM);

  appFile("WIDELANE AMBIGUITY RESOLUTION (MEL-WUEBB)",2,$mlwxtr,$fixsum,0);
  copy($ambxtr,"${dirOut}MWW${yyssss}.AMB");


# Check all GPSEST NARROW LANE  (from 1st iteration) runs using GPSXTR
# --------------------------------------------------------------------
  unlink("$mlwxtr","$ambxtr");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'????$+0F');
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBLOD","1");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","0NL");
  $bpe->RUN_PGMS($PGMNAM);

  appFile("NARROWLANE AMBIGUITY RESOLUTION (1. ITERATION / ALL)",2,$mlwxtr,$fixsum,0);
  copy($ambxtr,"${dirOut}MWF${yyssss}.AMB");


# Check all GPSEST NARROW LANE (from last iteration) runs using GPSXTR
# --------------------------------------------------------------------
  unlink("$mlwxtr","$ambxtr");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'????$+0N');
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBLOD","1");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","NL");
  $bpe->RUN_PGMS($PGMNAM);

  appFile("NARROWLANE AMBIGUITY RESOLUTION (LAST ITERATION / ALL)",2,$mlwxtr,$fixsum,0);
  copy($ambxtr,"${dirOut}MWN${yyssss}.AMB");

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","NLR");
  $bpe->RUN_PGMS($PGMNAM);

  appFile("NARROWLANE AMBIGUITY RESOLUTION (LAST ITERATION / WL-RESOLVED ONLY)",2,$mlwxtr,$fixsum,0);


# Check all GPSEST L5 runs using GPSXTR
# -------------------------------------
  unlink("$mlwxtr","$ambxtr");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'????$+0P');
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBLOD","1");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","L5");
  $bpe->RUN_PGMS($PGMNAM);

  appFile("WIDELANE AMBIGUITY RESOLUTION (L5)",2,$mlwxtr,$fixsum,0);
#  copy($ambxtr,"${dirOut}QIF${yyddd}.AMB");


# Check all GPSEST L3 runs using GPSXTR
# -------------------------------------
  unlink("$mlwxtr","$ambxtr");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'????$+0A');
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","L3");
  $bpe->RUN_PGMS($PGMNAM);

  appFile("NARROWLANE AMBIGUITY RESOLUTION (COUNTING ALL AMBIGUITIES)",2,$mlwxtr,$fixsum,0);
#  copy($ambxtr,"${dirOut}QIF${yyddd}.AMB");

  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","L3R");
  $bpe->RUN_PGMS($PGMNAM);

  appFile("NARROWLANE AMBIGUITY RESOLUTION (COUNTING ONLY L5-RESOLVED AMBIGUITIES)",2,$mlwxtr,$fixsum,0);


# Check all GPSEST QIF runs using GPSXTR
# --------------------------------------
  unlink("$mlwxtr","$ambxtr");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'????$+0Q');
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","QIF");
  $bpe->RUN_PGMS($PGMNAM);

  appFile("QIF AMBIGUITY RESOLUTION",2,$mlwxtr,$fixsum,0);
  copy($ambxtr,"${dirOut}QIF${yyssss}.AMB");


# Check all GPSEST L1&L2 runs using GPSXTR
# ----------------------------------------
  unlink("$mlwxtr","$ambxtr");
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",'????$+0B');
  $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","AMBID","L12");
  $bpe->RUN_PGMS($PGMNAM);

  appFile("AMBIGUITY RESOLUTION (L1&L2)",2,$mlwxtr,$fixsum,0);
  copy($ambxtr,"${dirOut}QIF${yyssss}.AMB");


# Get maximum RMS of GPSEST solutions
# -----------------------------------
  my $tmpSum = "$dirOut/TMP$yyssss.SUM";
  unlink $tmpSum;
  foreach my $chr ( "W", "N", "Q", "P", "A", "B" ) {
    @ARGV = ("${dirOut}????${ddd}${chr}.$extOut",$tmpSum);
    do "$ENV{AUTO}/maxrms_extr.com";
  }

  appFile("MAXIMUM RMS OF GPSEST AMBIGUITY SOLUTIONS",2,$tmpSum,$fixsum,0);
  unlink $tmpSum;


# Generate residual overview from before and after ambiguity resolution
# ---------------------------------------------------------------------
  my %resAll=();
  my $resSum="$dirOut/VER$yyssss.SUM";

  unlink("$resSum");

  my $resFil="????${ddd}V0";
  $bpe->putKey("$$bpe{U}/PAN/RESRMS.INP","RESFIL","$resFil");

  $PGMNAM = "RESRMS";
  $bpe->RUN_PGMS($PGMNAM);

  my $resOut="$dirOut/AMBRES.${yy}_$ssss";
  unlink $resOut;
  open(SUM,"$resSum");
  while(<SUM>) {
    if ( /SESS/ ) {
      $resAll{sat}{V0} = $_;
    } elsif ( / ${ssss}/ ) {
      my $bsl = substr($_,1,9);
      $resAll{$bsl}{V0_line} = $_;
      $resAll{$bsl}{V0_rms}  = (split())[-1];
    } elsif ( /TOTAL RMS:/ ) {
      $resAll{tot}{V0}  = (split())[-1];
    }
  }
  close SUM;
  appFile ("",0,"$resSum","$resOut",1);

# Second RESRMS run
# -----------------
  unlink("$resSum");

  my $resFil="????${ddd}V1";

  $bpe->putKey("$$bpe{U}/PAN/RESRMS.INP","RESFIL","$resFil");

  $PGMNAM = "RESRMS";
  $bpe->RUN_PGMS($PGMNAM);

  appFile ("",0,"$resSum","$resOut",1);
  open(SUM,"$resSum");
  while(<SUM>) {
    if ( /SESS/ ) {
      $resAll{sat}{V1} = $_;
    } elsif ( / ${ssss}/ ) {
      my $bsl = substr($_,1,9);
      $resAll{$bsl}{V1_line} = $_;
      $resAll{$bsl}{V1_rms}  = (split())[-1];
    } elsif ( /TOTAL RMS:/ ) {
      $resAll{tot}{V1}  = (split())[-1];
    }
  }
  close SUM;
  unlink("$resSum");


# Summary from RESCHK run
# -----------------------
  $bpe->putKey("$$bpe{U}/PAN/RESCHK.INP","RESRMS","$resOut");
  $bpe->putKey("$$bpe{U}/PAN/MENU_EXT.INP","EXT_SUM","${yy}_${ssss}");

  $PGMNAM = "RESCHK";
  $bpe->RUN_PGMS($PGMNAM);

  my $resSum="$dirOut/AMBVER.${yy}_$ssss";
  appFile ("Residuals before and after ambiguity resolution",0,
           "$resSum","$fixsum",1);

  open(AMB,">> $fixsum");
  print AMB "\nBaselines with the biggest increase of rms-values due to AR\n";
  foreach my $bsl ( sort { ($resAll{$b}{V1_rms}-$resAll{$b}{V0_rms}) <=> 
                           ($resAll{$a}{V1_rms}-$resAll{$a}{V0_rms}) } 
                    keys %resAll ) {
    next if $bsl eq "sat";
    next if $bsl eq "tot";
    last if ( $resAll{$bsl}{V1_rms}-$resAll{$bsl}{V0_rms} <= 0.2 );
    print AMB "$bsl $resAll{$bsl}{V0_rms} -> $resAll{$bsl}{V1_rms}\n";
  }
  print AMB "\n";

  print AMB "\nBaselines with the biggest rms-values after AR\n";
  foreach my $bsl ( sort { $resAll{$b}{V1_rms} <=> $resAll{$a}{V1_rms} } 
                    keys %resAll ) {
    next if $bsl eq "sat";
    next if $bsl eq "tot";
    last unless ( $resAll{$bsl}{V1_rms} >= 2.0 );
    print AMB "$bsl $resAll{$bsl}{V0_rms} -> $resAll{$bsl}{V1_rms}\n";
  }
  print AMB "\n\n";
  close AMB;
  appFile ("",0,"$resOut","$fixsum",1);


  unlink("$resSum");
  unlink("$resOut");

# ----------------------------------------------------------------------------
# End of script
# ----------------------------------------------------------------------------
}
