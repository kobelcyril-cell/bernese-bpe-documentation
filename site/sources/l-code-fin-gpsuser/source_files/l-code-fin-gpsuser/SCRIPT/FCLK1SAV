package FCLK1SAV;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  FCLK1SAV
#
# Purpose :  Copy result file into the archive
#
# Programs:
#
# Author  :  A. Villiger
# Created :  23-Nov-2016
#
# Changes :  10-Feb-2017 AV/SS: Save into regular IGS save repository
#            13-Feb-2017 AV: Save BIA file (PPP-solution)
#            13-Feb-2017 SS: Renamed protocol file (to FCLKGNSS)
#            10-Jul-2018 AV: Consider repro flag for savedisk
#            06-Aug-2018 AV: Do not copy orbits in case of repro
#            09-Jul-2020 RD/AV: Remove 1-day solution
#            20-Aug-2022 AV: Savepath for I20
#            02-Dec-2022 AV: Undo temporary changes (IGS20 active)
#            09-Jan-2023 RD: PPP-based Troposphere products added
#            20-Apr-2023 RD: Merge and store also tropo results as TRP (for BKG)
#
# ----------------------------------------------------------------------------
use strict;

use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;

use lib "$ENV{BPE}";
use bpe_util;

sub run {
  my $bpe = shift;

# Define variables
# ----------------
  my ($yyssss, $yyddd, $yy, $yyyy, $ssss,
      $u, $q, $c, # 3-Day: 300, 30, 5sec
      $t, $trp, $repro, $mode, $sav, $gnsh, # OSB
      $crdInf,
      $dirClk, $dirOut, $dirSmc, $dirSum, $dirRxc, $dirOsb, $dirNeq, $dirTrp, $dirTro,
      $extClk, $extOut, $extSmc, $extSum, $extRxc, $extOsb, $extNeq, $extTrp, $extTro,
      $dirCrd, $dirPre,$dirBia,
      $extCrd, $extPre,$extBia) =
#
    $bpe->getKeys('$YSS+0', '$YD+0', '$Y', '$Y+0', '$S+0',
      'V_U', 'V_Q', 'V_C',
      'V_T', 'V_TRP', 'V_REPRO','V_MODE','V_SAV','V_GNSH',
      'V_CRDINF',
      'DIR_CLK','DIR_OUT','DIR_SMC','DIR_SUM','DIR_RXC','DIR_OSB','DIR_NEQ','DIR_TRP','DIR_TRO',
      'EXT_CLK','EXT_OUT','EXT_SMC','EXT_SUM','EXT_RXC','EXT_OSB','EXT_NEQ','EXT_TRP','EXT_TRO',
      'DIR_CRD','DIR_PRE','DIR_BIA',
      'EXT_CRD','EXT_PRE','EXT_BIA');

# Save Files to
# -------------
  my $dirSav;
  if($repro){
    $dirSav = "$PATH_SAV/$repro/$yyyy/";
  }else{
    $dirSav = "$PATH_SAV/$CAMP_SAVIGS/$yyyy/";
  }
  if($crdInf =~ /IGSxx/){
    $dirSav = "$PATH_SAV/IGS_I20/$yyyy/";
  }
#  my $dirSav = "$PATH_SAV/FCLKGNSS/$yyyy/";

  my $crdSav = "$dirSav/STA/";
  my $orbSav = "$dirSav/ORB/";
  my $osbSav = "$dirSav/ORB/";
  my $biaSav = "$dirSav/ORB/";
  my $outSav = "$dirSav/OUT/";
  my $atmSav = "$dirSav/ATM/";
  my $solSav = "$dirSav/SOL/";


  check_dir($crdSav,$orbSav,$osbSav,$outSav,$atmSav,$solSav) if ( $sav eq "Y" );

# Create merged CLKFINAL protocol file
# ------------------------------------
  my @prcList = ( "$dirOut/FCLK${yyssss}.PRC",
                  "$dirOut/${u}U${yyssss}.$extOut",
                  "$dirOut/${u}_${yyssss}.$extOut",
#                  "$dirSum/${u}R${yyssss}.$extSum",
                  "$dirOut/${q}_${yyssss}.$extOut",
                  "$dirOut/${q}C${yyssss}.PRC",
                  "$dirOut/${c}_${yyssss}.$extOut",
                  "$dirOut/${c}C${yyssss}.PRC",
                  "$dirSum/${trp}_${yyssss}.$extSum");

  my $prcAll  = "$dirOut/FCLKGNSS.${yy}_${ssss}";

  if ( -e $prcList[0] ) {

    unlink $prcAll;

    map { appFile("$_",2,$_,$prcAll,1 ) } @prcList;

    if ( $sav eq "Y" ) {
      copyfile("$prcAll","$outSav");
    }

    $On_Error_Cont = 1;
    err_print() || die();
  }

# Distribution not allowed
# ------------------------
  if ( $sav ne "Y" ) {
     prtMes($bpe,"FILES NOT SAVED");
  } else {

    $Set_Verify=1;

# Copy files to save disk
# -----------------------

# Osb parameters
    my $filnam = "${t}S${yyssss}.$extOsb";
    copyfile("$dirOsb/$filnam","$osbSav/$filnam");

# Osb parameters
    my $filnam = "u{t}B${yyssss}.$extOsb";
    copyfile("$dirOsb/$filnam","$osbSav/$filnam") if -e $filnam;

# Bia parameters
    my $filnam = "${t}S${yyssss}.$extBia";
    copyfile("$dirBia/$filnam","$biaSav/$filnam") if -e $filnam;

# Toposphere and Coordinates (3-Day, 300s)
    $filnam = "${u}_${yyssss}.$extTrp";
    copyfile("$dirTrp/$filnam","$atmSav/$filnam") unless $gnsh;

    $filnam = "${u}_${yyssss}.$extCrd";
    copyfile("$dirCrd/$filnam","$crdSav/$filnam") unless $gnsh;

# Toposphere and Coordinates (3-Day, 5s)
    $filnam = "${c}_${yyssss}.$extTrp";
    copyfile("$dirTrp/$filnam","$atmSav/$filnam") if $gnsh;

    $filnam = "${c}_${yyssss}.$extCrd";
    copyfile("$dirCrd/$filnam","$crdSav/$filnam") if $gnsh;

# Clocks and NEQ (3-Day, 300s)
    $filnam = "${u}_${yyssss}.$extClk";
    copyfile("$dirClk/$filnam","$orbSav/$filnam");

    $filnam = "${u}_${yyssss}.$extRxc";
    copyfile("$dirRxc/$filnam","$outSav/$filnam");
    compress("$outSav/$filnam");

    $filnam = "${u}_${yyssss}.$extNeq";
    copyfile("$dirNeq/$filnam","$solSav/$filnam");
    system("gzip -f $solSav/$filnam");

# Clocks (3-Day, 30s)
    $filnam = "${q}_${yyssss}.$extClk";
    copyfile("$dirClk/$filnam","$orbSav/$filnam");
    compress("$orbSav/$filnam");

    $filnam = "${q}_${yyssss}.$extRxc";
    copyfile("$dirRxc/$filnam","$outSav/$filnam");
    compress("$outSav/$filnam");

    $filnam = "${q}A${yyssss}.$extRxc";
    copyfile("$dirRxc/$filnam","$outSav/$filnam");
    compress("$outSav/$filnam");

    $filnam = "${q}_${yyssss}_v3.$extRxc";
    copyfile("$dirRxc/$filnam","$outSav/$filnam");
    compress("$outSav/$filnam");

# Clocks (3-Day,  5s)
    if ($gnsh){
      $filnam = "${c}_${yyssss}.$extClk";
      copyfile("$dirClk/$filnam","$orbSav/$filnam");
      compress("$orbSav/$filnam");

      $filnam = "${c}_${yyssss}.$extRxc";
      copyfile("$dirRxc/$filnam","$outSav/$filnam");
      compress("$outSav/$filnam");

      $filnam = "${c}A${yyssss}.$extRxc";
      copyfile("$dirRxc/$filnam","$outSav/$filnam");
      compress("$outSav/$filnam");

      $filnam = "${c}_${yyssss}_v3.$extRxc";
      copyfile("$dirRxc/$filnam","$outSav/$filnam");
      compress("$outSav/$filnam");

# Copy also the orbit files containing the clocks (from IGSFINAL)
# (after including the clocks and with PREWEI)
      unless($repro){
        copyfile("$CDIR_FIN/ORB/F3X${yyddd}.PRE","$orbSav/F3_${yyddd}.PRE");
      }

    }


# Troposphere SINEX
   if ( "$trp" ne "" ) {
      $filnam = "${trp}_${yyssss}.$extTro";
      copyfile("$dirTro/$filnam","$atmSav/$filnam");
      compress("$atmSav/$filnam");

      $filnam = "${trp}_${yyssss}.$extTrp";
      copyfile("$dirTrp/${trp}${yyssss}.$extTrp","$atmSav/$filnam");
      compress("$atmSav/$filnam");

      $filnam = "${trp}_${yyssss}.$extSum";
      copyfile("$dirSum/$filnam","$outSav/$filnam");
      compress("$outSav/$filnam");
   }

    $On_Error_Cont = 1;
    err_print() || die();
  }
}
