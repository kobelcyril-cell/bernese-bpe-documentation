package IONGEN_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  IONGEN_P
#
# Purpose :  Execute GPSEST and ADDNEQ2 for iono retrieval
#
# PARAMs  :  PARAM1 - processing filename (baseline)
#
# Author  :  S. Schaer
# Created :  22-Jun-2016
#
# Changes :  16-Jan-2025 SS: Considered year with fractional part
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib $ENV{EXE};
use Gps_Date;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd,$param1,$yyyy) =
    $bpe->getKeys('$YD+0','PARAM1','$Y+0');

  my $file = $param1;

# Set variables
# -------------
  setUserVar($bpe,"FFFF","$file");

  prtMess($bpe,"BASELINE: $file");

# Update geomagnetic pole coordinates
  # -----------------------------------
  my $yyyyF = gps_date("-yd $yyddd -d 0.5 -o %FY");
  my $lat = `$ENV{AUTO}/geomagnetic_pole.com $yyyyF -lat`;
  chomp($lat);
  my $lon = `$ENV{AUTO}/geomagnetic_pole.com $yyyyF -lon`;
  chomp($lon);
  print "FY: $yyddd $yyyyF $lat $lon\n";

  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","LATPOL",$lat);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","LONPOL",$lon);

# Run programs
# ------------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

##  $PGMNAM = "ADDNEQ2";
##  $bpe->RUN_PGMS($PGMNAM);

}
