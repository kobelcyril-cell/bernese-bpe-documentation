package COMPAR2;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  COMPAR2
#
# Purpose :  Compare bernese coordinate files of last 30 days
#
# Programs:  COMPAR2
#
# Author  :  M. Meindl
# Created :  03-Aug-2003
#
# Changes :  30-Mar-2006 mm: setPlusMinus replaced by setMinusPlus
#            22-Jul-2008 PS/RD: prepare for reprocesing
#            25-Sep-2012/ss: Some cosmetic changes; added PARAM1
#            18-Sep-2023 SS: Renamed from CRD_CHK to COMPAR2
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($camp_pth, $campaign, $param1) =
    $bpe->getKeys('CAMP_PTH', 'CAMPAIGN', 'PARAM1');

# Set default
# -----------
  $param1 = -30 if $param1 eq "";

# Skip the script in case of reprocessing
# ---------------------------------------
  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");
  unless ($repro) {

# Set 30-day overlap
# ------------------
##    setMinusPlus($bpe,-30,0);
    setMinusPlus($bpe,$param1,0);

# Run program
# -----------
    my $PGMNAM = "COMPAR2";
    $bpe->RUN_PGMS($PGMNAM);

  } # end of non-reprocessing

}
