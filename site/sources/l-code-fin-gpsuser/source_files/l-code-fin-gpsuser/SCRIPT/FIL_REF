package FIL_REF;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  FIL_REF
#
# Purpose :  Detect bad reference stations concerning GPS clocks.
#
# Programs:
#
# PARAMs  :  PARAM1 - Solution type descriptor
#
# Author  :  S. Schaer
# Created :  04-Nov-2016
#
# Changes :  04-Nov-2016/ss: Derived from FIL_VER
#            08-Nov-2016/ss: Delete NEQ files
#            08-Nov-2016/av: Skip msg2kex in repro mode
#            08-Nov-2016/ss: Update REFyyddd.FIX file if indicated
#
# ----------------------------------------------------------------------------
use lib "$ENV{AUTO}";
use gpsutil;
use lib $ENV{BPE};
use bpe_util;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ddd, $ssss, $yyyy, $param1,
      $repro,
      $pcfFil, $taskId,
      $dirOut,$extOut,$dirOsb,$extOsb,$dirBia,$extBia,$dirRes,$extRes,$dirNeq,$extNeq,$dirFix,$extFix) =
    $bpe->getKeys('$YD+0', '$+0', '$S+0', '$Y+0', 'PARAM1',
                  'V_REPRO',
                  'PCFFIL', 'TASKID',
                  'DIR_OUT','EXT_OUT','DIR_OSB','EXT_OSB','DIR_BIA','EXT_BIA','DIR_RES','EXT_RES','DIR_NEQ','EXT_NEQ','DIR_FIX','EXT_FIX');

  $pcfFil = (split('\.',$pcfFil))[0];

  $param1 = "REF" if $param1 eq "";
  my $sol = $param1;
  my $chr = substr($sol,0,1);

  my $outFil = "${dirOut}FIL${ddd}????_${chr}.${extOut}";
  print "OUTFIL: $outFil\n";

  my $chkFil = "${dirOut}${sol}${yyddd}.CHK";
  print "CHKFIL: $chkFil\n";

  if (-s $chkFil) { move($chkFil,$chkFil."_OLD") }

  system("grep '^   23     1 ' $outFil | sort -n -k6 > $chkFil");
  replace($chkFil,$dirOut,"");
  replace($chkFil,"FIL${ddd}","");
  replace($chkFil,"_${chr}","${ssss}_${chr}");

  my @lin = `cat $chkFil | cut -c1-4,65-83`;
  chomp(@lin);

  my $badFil = "${dirOut}../MSC/BAD${yyddd}.FLG";
  my $bad = 0;
  my @bad = ();
  my $tol = 0.01;
##  my $tol = 0.03;
##  my $tol = 0.05;
  $tol = 0.2 if $yyyy < 2000;

  foreach (@lin) {
    my $sta = substr((split(" ",$_))[0],0,4);
    my $clk = (split(" ",$_))[1];
    if (abs($clk) > $tol) {
      print "CLK: $sta $clk\n";
      if (lindex($sta,@bad) == -1) {
        prtMess($bpe,"BAD OBSERVATION DATA FOUND: ${sta}${ssss}");
        print        "BAD OBSERVATION DATA FOUND: ${sta}${ssss}\n";
        push(@bad,$sta);
        $bad++;
      }
    }
  }
  if ($bad > 0) {
    my $str = join(" ",sort(@bad));
##    msg2key("NEW","$pcfFil ${yyddd}0 FIL_REF: Bad clock reference stations: $str") unless($repro);
    prtMess($bpe,"BAD CLOCK REFERENCE STATIONS: $str");
    copy("${fixFil}","${fixFil}_OLD");
    my $fixFil = "${dirFix}REF${yyddd}.${extFix}";
    foreach (@bad) {
##      `echo '$_${ssss}' >> $badFil`;
##      `echo '_$_${ssss}' >> $badFil`;
      replace($fixFil,"^$_ ","$_\_");
##      `cat $fixFil | grep -v '^$_' > ${fixFil}_TMP`;
##      move("${fixFil}_TMP",$fixFil);
    }
  } else {
    unlink($chkFil);
  }

  unlink(glob($outFil));

  my $resFil = "${dirRes}FIL${ddd}????_${chr}.${extRes}";
  unlink(glob($resFil));

  my $neqFil = "${dirNeq}FIL${ddd}????_${chr}.${extNeq}";
  unlink(glob($neqFil));

}
