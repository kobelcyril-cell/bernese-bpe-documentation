package BAS_DEL;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  BAS_DEL
#
# Purpose :  Delete old files concerning BASTST.PCF
#
# PARAMs  :  PARAM1 - ALL to delete all files of current session
#
# Author  :  S. Schaer
# Created :  21-Apr-2004
#
# ============================================================================

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $ddd, $c,
      $dirOut, $extOut,
      $dirSum, $extSum,
      $dirRes, $extRes) =
    $bpe->getKeys('$YSS+0', '$+0', 'V_C',
                  'DIR_OUT', 'EXT_OUT',
                  'DIR_SUM', 'EXT_SUM',
                  'DIR_RES', 'EXT_RES');

# Create list of files to be deleted
# ----------------------------------
  my @delLst = ("${dirOut}BAS${yyssss}.PRC",
                "${dirOut}${c}${ddd}????.${extOut}",
                "${dirRes}${c}${ddd}????.${extRes}",
                "${dirOut}XTR${yyssss}.${extOut}",
                "${dirSum}${c}${yyssss}.${extSum}",
                "${dirOut}RMS${yyssss}.${extOut}",
                "${dirSum}RMS${yyssss}.${extSum}");

  foreach (@delLst) { unlink(glob($_)) }

}
