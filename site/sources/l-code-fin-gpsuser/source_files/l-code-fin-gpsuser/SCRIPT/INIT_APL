package INIT_APL;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  INIT_APL
#
# Purpose :  Initialization concerning APL setup
#
# Programs:
#
# Author  :  S. Schaer
# Created :  23-Feb-2012
#
# Changes :  11-Apr-2014/RD: Correct download for version 4
#            07-May-2019 RD: V_LOADNG added (to switch between TU VIenna and GFZ)
#            05-Jun-2019 IS: msg2key only is no repro
#            05-Jan-2023 RD: Handle new year transision
#            18-Aug-2026 RD: No flag files for loading are needed anymore
#
# ----------------------------------------------------------------------------

use strict;

use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use igs_device;
use File::Copy;
use File::Basename;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,$yydp1,$ddd,$dp1,$yyyy,$yyp1,
    $pcfFil,$taskId,$loading,$crdInf,
    $dirOut, $dirGrd, $dirCrd,
    $extOut, $extGrd, $extCrd
  ) =
  $bpe->getKeys(
    '$YD+0', '$YD+1','$+0','$+1','$Y+0','$Y+1',
    'PCFFIL','TASKID','V_LOADNG','V_CRDINF',
    'DIR_OUT','DIR_GRD','DIR_CRD',
    'EXT_OUT','EXT_GRD','EXT_CRD',
  );

# Set variables
# -------------
  $pcfFil = (split('\.',$pcfFil))[0];
  my @grdFilLst = $loading eq "VAPL" ? 
                           ("${dirGrd}APL${yyddd}.${extGrd}") :
                  $loading eq "GFZ" ?
                           ("${dirGrd}NTAL_${yyddd}.${extGrd}",
                            "${dirGrd}NTOL_${yyddd}.${extGrd}",
                            "${dirGrd}HYDL_${yyddd}.${extGrd}") :
                  $loading eq "NONE" ?
                           ("", "", "") :
                  ("undef");
  if ( $grdFilLst[0] eq "undef" ) {
    die "\nUnsupported source of loading files!\n" .
        "Currently supported values are: NONE, VAPL, GFZ\n\n";
  }

  my @flgFilLst = $loading eq "VAPL" ? 
                           ("${dirOut}../MSC/APL_${yyddd}.FLG") :
                  $loading eq "GFZ" ?
                           ("${dirOut}../MSC/NTAL_${yyddd}.FLG",
                            "${dirOut}../MSC/NTOL_${yyddd}.FLG",
                            "${dirOut}../MSC/HYDL_${yyddd}.FLG") :
                  ("");
  my $ultFil = "${dirOut}../MSC/ULT${yyddd}.FLG";
  my $repFil = "${dirOut}../MSC/REPROCESSING.FLG";
  

# Remove GRD/FLG file
# -------------------
  if ( $grdFilLst[0] ne "" ) {
    unlink(@grdFilLst);
    unlink(@flgFilLst);
  }

# Get latest grid files and copy them into the campaign
# -----------------------------------------------------
  # Vienna APL
  if ( $loading eq "VAPL" ) {
##      system("$ENV{AUTO}/get_apl.com");
    system("$ENV{AUTO}/get_apl4.com $dp1 +8") unless ( -e $ultFil || -e $repFil);
    system("$ENV{AUTO}/copyGrid.pl $dirOut/../ $ddd $yyyy APL -oneFile");

  # GFZ files
  } elsif ( $loading eq "GFZ" ) {
    system("python $ENV{AUTO}/get_GFZloading.py  NTAL NTOL HYDL SLEL") unless ( -e $ultFil || -e $repFil);
    system("python $ENV{AUTO}/copy_GFZloading.py -p $dirOut/../ -t NTAL NTOL HYDL -o -c $dirCrd/${crdInf}.${extCrd} $ddd $yyyy");
    if ( $yyyy != $yyp1 ) {
      system("python $ENV{AUTO}/copy_GFZloading.py -p $dirOut/../ -t NTAL NTOL HYDL -o -c $dirCrd/${crdInf}.${extCrd} $dp1 $yyp1");
      foreach my $what ("NTAL","NTOL","HYDL") {
        print "$what\n";
        open(OUT,">> ${dirGrd}${what}_${yyddd}.${extGrd}");
        open(INP,   "${dirGrd}${what}_${yydp1}.${extGrd}");
        print OUT <INP>;
        close(OUT);
        close(INP);
        unlink("${dirGrd}${what}_${yydp1}.${extGrd}");
      }
    }
  }

}

__END__
