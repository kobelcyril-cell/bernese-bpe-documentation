package GNSAMBAP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  GNSAMBAP
#
# Purpose :  Prepare parallel WL/NL ambiguity resolution process for a set of
#            baselines selected by BASLST
#
# PARAMs  :
#
# Author  :  M. Meindl
# Created :  20-Oct-2003
#
# Changes :  25-Apr-2007/ss: Derived from GPSQIFAP
#            09-Mar-2011/ss: Lower baseline length limit reduced to 0
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $ddd, $bl, $bl0, $dirBsl, $dirOut, $extOut,
      $dirRes, $extRes, $dirEdt, $extEdt, $dirSum, $extSum) =
  $bpe->getKeys
     ('$YD+0', '$+0', 'V_BL_AMB', 'V_BL_L12', 'DIR_BSL', 'DIR_OUT', 'EXT_OUT',
      'DIR_RES', 'EXT_RES', 'DIR_EDT', 'EXT_EDT', 'DIR_SUM', 'EXT_SUM');

  my ($mjd, $arIter, $iRun) =
  $bpe->getKeys
     ('$JD+0', 'V_ARITER', 'STARTCOUNT');

# Delete old RESRMS/SATMRK outputs
# --------------------------------
unlink glob("${dirOut}RES????.${extOut}");
unlink glob("${dirOut}MRK????.${extOut}");

# Delete old files (OUT, SEL)
# ---------------------------
##  my $basFil = "${dirBsl}AMB${yyssss}.SEL";
##  unlink ($basFil);
##  unlink glob("${dirOut}????${ssss}_C.${extOut}");
##  unlink glob("${dirRes}????${ssss}_C.${extRes}");
##  unlink glob("${dirEdt}????${ssss}_C.${extEdt}");
##  unlink glob("${dirSum}????${ssss}_C.${extSum}");
##  unlink glob("${dirOut}????${ssss}_W.${extOut}");
##  unlink glob("${dirOut}????${ssss}_N.${extOut}");

# Compute maximum baseline length
# -------------------------------
  my $basLen = int($bl*$iRun/$arIter);
  print "ITERATION $iRun USING MAX BASELINE LENGTH $basLen\n";

# Disable MW-AR for ROGUE receivers in reprocessing mode except for AS-free periods
# ---------------------------------------------------------------------------------
  my $repro = (-e "${dirOut}../MSC/REPROCESSING.FLG");
  if ($repro) {
    if (($mjd >     0       && $mjd < 49383.00000) ||
        ($mjd > 49826.87499 && $mjd < 49847.83334) ||
        ($mjd > 49886.99999 && $mjd < 49909.00002) ||
        ($mjd > 49999.99999 && $mjd < 50022.00001) ||
        ($mjd > 50480.99999 && $mjd < 50503.00000)) {
      print "MJD: $mjd\n";
      print "AS-free period: MW-AR for ROGUE activated\n";
      $bpe->putKey("$ENV{U}/PAN/BASLST.INP","EXCLU","");
    } else {
      $bpe->putKey("$ENV{U}/PAN/BASLST.INP","EXCLU","ROGUE SNR");
    }
  }

# Set maximum/minimum baseline length if defined
# ----------------------------------------------
##  $bpe->putKey("$ENV{U}/PAN/BASLST.INP","MAXLEN",$bl) unless $bl eq "";
  $bpe->putKey("$ENV{U}/PAN/BASLST.INP","MAXLEN",$basLen);
##  $bpe->putKey("$ENV{U}/PAN/BASLST.INP","MINLEN",$bl0) unless $bl0 eq "";

# Run program
# -----------
  my $PGMNAM = "BASLST";
  $bpe->RUN_PGMS($PGMNAM);

# Get baselines to be processed
# -----------------------------
  my $basFil=$bpe->getKey("$ENV{U}/INP/BASLST.INP","SELBSL");
  my @basLin;
  open (BAS,$basFil);
  push (@basLin,<BAS>);
  close BAS;
  chomp(@basLin);

# Initialize parallel run
# -----------------------
  initPar_Bl($bpe,@basLin);

}
