package GPSEDT_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GPSEDT_P
#
# Purpose :  Parallel run for residual screening
#
# Programs:  GPSEST
#
# Author  :  M. Meindl
# Created :  30-Jul-2003               Last modified: 23-Jul-2008
#
# Changes :  10-Feb-2005 mm: created
#            23-Jul-2008 rd: prepare for reprocessing
#            26-May-2025 rd: add V_GNSS to manage USE_x
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;
use File::Copy;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yyssss, $ssss , $ddd , $param1 , $subPid ,  $clu,    $v_gnss  ) =
  $bpe->getKeys
     ('$YSS+0', '$S+0', '$+0', 'PARAM1', 'SUB_PID', 'V_CLU', 'V_GNSS');

# Set cluster number, input files, and loop variable
# --------------------------------------------------
  my $cluster = $clu eq "" ? "$ddd$param1" : "$yyssss" . substr($subPid,1);
  my $ffff    = $clu eq "" ? $param1       : "____";

  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$ffff,"CCC",$subPid,"FL","F");

  if ($clu eq "") {
    $bpe->putKey("$ENV{U}/PAN/SATMRK.INP","PSHFIL","$param1$ssss");
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PSFILES","$param1$ssss") }
  else {
    replaceSel($bpe,"SATMRK","PSHFIL",$param1);
    replaceSel($bpe,"GPSEST","PSFILES",$param1) }


# Select GNSS, if desired
# -----------------------
  &setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_",$v_gnss);

# Run programs
# ------------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "RESRMS";
  $bpe->RUN_PGMS($PGMNAM);

  $PGMNAM = "SATMRK";
  $bpe->RUN_PGMS($PGMNAM);

# Redefine loop variable
# ----------------------
  setUserVar($bpe,"FL","L");

# Run program
# -----------
  $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

# Delete BPE file
# ---------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;
  unlink($param1);

}
