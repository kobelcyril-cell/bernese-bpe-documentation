package BIACAL_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  BIACAL_P
#
# Purpose :  Execute GPSEST and ADDNEQ2 for bias calibration
#
# PARAMs  :  PARAM1 - processing filename (baseline)
#
# Author  :  S. Schaer
# Created :  22-Jun-2016
#
# Changes :  28-Jun-2016/ss: Adjusted after GPSEST RDIDCB bugfix
#            16-Jan-2025 SS: Considered year with fractional part
#
# ============================================================================
use lib $ENV{BPE};
use bpe_util;
use lib $ENV{EXE};
use Gps_Date;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd,$param1,$yyyy) =
    $bpe->getKeys('$YD+0','PARAM1','$Y+0');

  my $file = $param1;

# Set variables
# -------------
  setUserVar($bpe,"FFFF","$file");

  prtMess($bpe,"BASELINE: $file");

# Update geomagnetic pole coordinates
  # -----------------------------------
  my $yyyyF = gps_date("-yd $yyddd -d 0.5 -o %FY");
  my $lat = `$ENV{AUTO}/geomagnetic_pole.com $yyyyF -lat`;
  chomp($lat);
  my $lon = `$ENV{AUTO}/geomagnetic_pole.com $yyyyF -lon`;
  chomp($lon);
  print "FY: $yyddd $yyyyF $lat $lon\n";

  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","LATPOL",$lat);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","LONPOL",$lon);

# Run programs
# ------------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'$(FFFF)$S+0_C');

  $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT",'$(FFFF)$S+0_B');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBREC_G","SYSTEM");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBREC_E","SYSTEM");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBREC_C","SYSTEM");
#  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OBS2NEQ" ,"0");
 
  $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'$(FFFF)$S+0_B');
##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'$(FFFF)$S+0_B');
##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","GIM_ELIM","BEFORE_STACKING");
##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","ANT_ELIM","NO");
##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","ANTX_ELIM","NO");
##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SPV_ELIM","NO");
##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NOINV","1");
##
##  $PGMNAM = "ADDNEQ2";
##  $bpe->RUN_PGMS($PGMNAM);

##  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","INPFILE",'$(FFFF)$S+0_B');
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'$(FFFF)$S+0_G');
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'$(FFFF)$S+0_G');
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","OSBREC_R","PRE-ELIMINATE");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","ANT_ELIM","NO");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","ANTX_ELIM","NO");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SPV_ELIM","NO");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NOINV","1");

  $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

}

