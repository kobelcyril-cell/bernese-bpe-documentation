package COMPAR_3;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  COMPAR_3
#
# Purpose :  Compare Bernese coordinate files of 3 days (+/- 1 day)
#
# Programs:  COMPAR2
#
# Author  :  M. Meindl
# Created :  03-Aug-2003               
#
# Changes :  30-Mar-2006 mm: setPlusMinus replaced by setMinusPlus
#            22-Jul-2008 PS/RD: prepare for reprocesing
#            26-Jun-2013 PS: cosmetic changes
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($camp_pth, $campaign) = $bpe->getKeys('CAMP_PTH','CAMPAIGN');

# Skip the script in case of reprocessing
# ---------------------------------------
  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");
  unless ($repro) {

# Set 3-day overlap
# -----------------
  setMinusPlus($bpe,-1,+1);

# Run program
# -----------
    my $PGMNAM = "COMPAR2";
    $bpe->RUN_PGMS($PGMNAM);

  } # end of non-reprocessing

}
