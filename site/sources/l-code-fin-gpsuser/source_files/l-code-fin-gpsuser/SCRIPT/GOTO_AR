package GOTO_AR;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GOTO_AR
#
# Purpose :  Iteration script for ambiguity resolution.
#            The number of iterations to do is stored in V_ARITER.
#            This script counts the "PROCESS STARTED" in log-file to get the number
#            iterations already done.
#
# Programs:  ---
#
# Author  :  R. Dach
# Created :  06-Dec-2007               Last modified: __.___-____
#
# Changes :
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($arIter,$param2,$param3) = $bpe->getKeys('V_ARITER','PARAM2','PARAM3');

# Get number of iterations
# ------------------------
  my $iRun = $$bpe{STARTCOUNT};

# Write the corresponding "GOTO PID" STATEMENT
# --------------------------------------------
  if ($iRun == $arIter) {

    $bpe->PRT_GOTO($param3)

  } else {

    $bpe->PRT_GOTO($param2)

  }
}
