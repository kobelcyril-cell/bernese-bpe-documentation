package IGSF_S3D;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  IGSF_S3D
#
# Purpose :  Copy all relevant results to save disk
#
# Programs:
#
# Author  :  R. Dach
#
# Created :  07-Dec-2007
#
# Changes :  22-Aug-2001/SS: Do no longer save results coming from old
#                            ADDNEQ program
#            04-Jan-2003/HU: Pole files in ORB instead of X/GEN
#            09-Jan-2003/SS: Pole files in ORB savedisk subdirectories
#            31-Mar-2003/SS: Save gzipped NQ0
#            28-Apr-2006/SS: Create igsfin3d.txt
#            03-Aug-2007/MM: V_SAV, V_DIS activated
#            24-Feb-2011/ss: Save V3D LST/LIS file
#            05-Jun-2013 SL: Use @cpyLst and &copy2archive
#            17-Mar-2015 RD/SS: F3I considered
#            13-Aug-2015 SS: Save F3 M1/P1 orbit/ERP results
#            28-Mar-2018 SS: Save F3M SNX file
#            16-Aug-2022 AV: Temporary changes for IGS20
#            01-Dec-2022 AV: Undo temporary changes (IGS20 active)
#            23-Oct-2023 EB: Short protocol generation
#            31-Oct-2025 EB: Generate also sat info for dashboard
#            09-Jul-2026 EB: save istp/TRA files
#
# ============================================================================

use strict;
use warnings;

use lib "$ENV{BPE}";
use bpe_util qw(check_dir appFile copy2archive prtMess);
use lib "$ENV{AUTO}";
use igs_device;

sub run {

  my $bpe = shift;

# Define variables
# ----------------
  my(
    $yyddd, $yy, $yyyy, $ssss, $ddd, $wwwwd, $wwww,
    $yydddm1, $yydddp1, $yyyym1, $yyyyp1, $dddp1,
    $x, $e, $h, $i, $u, $z,
    $sav, $crdInf,
    $dirOut, $dirNeq, $dirTrp, $dirErp, $dirIep, $dirPre,
    $extOut, $extNeq, $extTrp, $extErp, $extIep, $extPre,
    $dirStd, $dirEle, $dirCrd, $dirGcc, $dirSmc, $dirSum,
    $extStd, $extEle, $extCrd, $extGcc, $extSmc, $extSum,
    $dirClk, $dirRpr, $dirDcb, $dirClb, $dirGrd, $dirFix,
    $extClk, $extRpr, $extDcb, $extClb, $extGrd, $extFix,
    $dirSnx, $dirTro, $dirEst,
    $extSnx, $extTro, $extEst,
  ) =
  $bpe->getKeys(
    '$YD+0','$Y','$Y+0','$S+0','$+0','$WD+0','$W-7',
    '$YD-1','$YD+1','$Y-1','$Y+1','$+1',
    'V_X','V_E','V_H','V_I','V_U','V_Z',
    'V_SAV', 'V_CRDINF',
    'DIR_OUT','DIR_NEQ','DIR_TRP','DIR_ERP','DIR_IEP','DIR_PRE',
    'EXT_OUT','EXT_NEQ','EXT_TRP','EXT_ERP','EXT_IEP','EXT_PRE',
    'DIR_STD','DIR_ELE','DIR_CRD','DIR_GCC','DIR_SMC','DIR_SUM',
    'EXT_STD','EXT_ELE','EXT_CRD','EXT_GCC','EXT_SMC','EXT_SUM',
    'DIR_CLK','DIR_RPR','DIR_DCB','DIR_CLB','DIR_GRD','DIR_FIX',
    'EXT_CLK','EXT_RPR','EXT_DCB','EXT_CLB','EXT_GRD','EXT_FIX',
    'DIR_SNX','DIR_TRO','DIR_EST',
    'EXT_SNX','EXT_TRO','EXT_EST',
  );

# Some definition
# ---------------
  my $tmpSol = 0;
  $tmpSol = 1 if($crdInf =~ /IGSxx/);

# Some directories
# ----------------
  my $dirSav = "${PATH_SAV}${CAMP_SAVIGS}/${yyyy}/";
  my $dirSavM1 = "${PATH_SAV}${CAMP_SAVIGS}/${yyyym1}/";
  my $dirSavP1 = "${PATH_SAV}${CAMP_SAVIGS}/${yyyyp1}/";
  if($tmpSol){
    $dirSav   = "${PATH_SAV}${CAMP_SAVIGS}_I20/${yyyy}/";
    $dirSavM1 = "${PATH_SAV}${CAMP_SAVIGS}_I20/${yyyym1}/";
    $dirSavP1 = "${PATH_SAV}${CAMP_SAVIGS}_I20/${yyyyp1}/";
  }
  my $orbSav = "${dirSav}ORB/";
  my $outSav = "${dirSav}OUT/";
  my $atmSav = "${dirSav}ATM/";
  my $solSav = "${dirSav}SOL/";
  my $staSav = "${dirSav}STA/";
  my $orbSavM1 = "${dirSavM1}ORB/";
  my $orbSavP1 = "${dirSavP1}ORB/";

  my $wwwPwd = "${PATH_WWW}code/";
  if($tmpSol){
    $wwwPwd = "$dirSav/www/";
  }

  if($sav eq "Y") {
    &check_dir($orbSav,$outSav,$atmSav,$solSav,$staSav,$orbSavM1,$orbSavP1);
    &check_dir("$wwwPwd");
  }

# Create merged protocol file
# ---------------------------
  my $prtFil = "${dirOut}IGSFIN3D.${yy}_${ddd}";
  unlink($prtFil);

  my @prcLst = (
    "${dirOut}F3D${yyddd}.PRC 1",
    "${dirOut}F3_${yyddd}.LST 1",
    "${dirSum}${z}_${wwwwd}.${extSum} 1",
    "${dirOut}${z}_${wwwwd}.${extOut} 1",
    "${dirOut}NUL_${wwwwd}.CMP 0",  # not "${z}_" because of CONT_ERR
  );

  foreach(@prcLst) {
    &appFile("",2,(split)[0],$prtFil,(split)[1]);
  }

  print "\nProtocol file created: $prtFil\n\n";

# Create short protocol file
# --------------------------
  my $prtFilshort = "${dirOut}IGSFIN1D_SHORT.TXT";
  my $prtFilsat = "${dirOut}IGSFIN1D_SAT.TXT";
  system("perl $ENV{AUTO}/typ_f1d.pl -q ${dddp1} > $prtFilshort");
  system("perl $ENV{AUTO}/comp_obs_pre.pl -d ${ddd} -t FIN -p PRE -s GRE -v -oh 7 > $prtFilsat");


# Copy files to savedisk
# ----------------------
# Mandatory files
  my @cpyLst = (
# Protocol
    "${prtFil}                          ${outSav} _ ",
    "${prtFil}                          ${wwwPwd}igsfin3d.txt _ ",
    "${prtFilshort}                     ${wwwPwd}igsfin1d_short.txt _ ",
    "${prtFilsat}                       ${wwwPwd}igsfin1d_sat.txt _ ",

# Normal equations
    "${dirNeq}${z}N${yyddd}.${extNeq}   ${solSav} z ",

# Final solution
    "${dirFix}${z}_${yyddd}.${extFix}   ${staSav} _ ",
    "${dirGcc}${z}_${yyddd}.${extGcc}   ${orbSav} _ ",
    "${dirCrd}${z}_${yyddd}.${extCrd}   ${staSav} _ ",
    "${dirTrp}${z}_${yyddd}.${extTrp}   ${atmSav} _ ",
##    "${dirTro}${z}_${yyddd}.${extTro}   ${atmSav} c ", # no TROTRO
    "${dirErp}${z}_${yyddd}.${extErp}   ${orbSav} _ ",
    "${dirIep}${z}_${yyddd}.${extIep}   ${orbSav} _ ",
    "${dirEle}${z}_${yyddd}.${extEle}   ${orbSav} _ ",
    "${dirStd}${z}_${yyddd}.${extStd}   ${orbSav} _ ",
##    "${dirPre}${z}_${yyddd}.${extPre}   ${orbSav} _ ", # no PREWEI
    "${dirSnx}${z}_${yyddd}.${extSnx}   ${solSav} c ",
#    "${dirSnx}${z}M${yyddd}.${extSnx}   ${solSav} c ",
    "${dirTro}${z}N${yyddd}.${extTro}   ${atmSav}${z}_${yyddd}.${extTro} c ",
# M1 results
##    "${dirErp}${z}M1${yydddm1}.${extErp}   ${orbSavM1} _ ",
    "${dirIep}${z}M1${yydddm1}.${extIep}   ${orbSavM1} _ ",
    "${dirEle}${z}M1${yydddm1}.${extEle}   ${orbSavM1} _ ",
    "${dirStd}${z}M1${yydddm1}.${extStd}   ${orbSavM1} _ ",
    "${dirPre}${z}M1${yydddm1}.${extPre}   ${orbSavM1} _ ",
# P1 results
##    "${dirErp}${z}P1${yydddp1}.${extErp}   ${orbSavP1} _ ",
    "${dirIep}${z}P1${yydddp1}.${extIep}   ${orbSavP1} _ ",
    "${dirEle}${z}P1${yydddp1}.${extEle}   ${orbSavP1} _ ",
    "${dirStd}${z}P1${yydddp1}.${extStd}   ${orbSavP1} _ ",
    "${dirPre}${z}P1${yydddp1}.${extPre}   ${orbSavP1} _ ",

# Solution with subdaily ERPs
    "${dirCrd}${z}H${yyddd}.${extCrd}   ${staSav} _ ",
    "${dirTrp}${z}H${yyddd}.${extTrp}   ${atmSav} _ ",
    "${dirTro}${z}H${yyddd}.${extTro}   ${atmSav} c ",
    "${dirErp}${z}H${yyddd}.${extErp}   ${orbSav} _ ",
    "${dirIep}${z}H${yyddd}.${extIep}   ${orbSav} _ ",
    "${dirEle}${z}H${yyddd}.${extEle}   ${orbSav} _ ",
    "${dirStd}${z}H${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirPre}${z}H${yyddd}.${extPre}   ${orbSav} _ ",

# Solution with GNSS specific parameters (ISTPs only)
    "${dirCrd}${z}T${yyddd}.${extCrd}   ${staSav} _ ",
    "${dirTrp}${z}T${yyddd}.${extTrp}   ${atmSav} _ ",
    "${dirTro}${z}T${yyddd}.${extTro}   ${atmSav} c ",
    "${dirErp}${z}T${yyddd}.${extErp}   ${orbSav} _ ",
    "${dirIep}${z}T${yyddd}.${extIep}   ${orbSav} _ ",
    "${dirEle}${z}T${yyddd}.${extEle}   ${orbSav} _ ",
    "${dirStd}${z}T${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirPre}${z}T${yyddd}.${extPre}   ${orbSav} _ ",
    "${dirEst}${z}T${yyddd}.${extEst}   ${solSav} _ ",
    "${dirOut}${z}T${yyddd}.TRA         ${outSav} o ",

# Solution with GNSS specific parameters (ISTPs, ERPs, GCCs)
    "${dirCrd}${z}I${yyddd}.${extCrd}   ${staSav} _ ",
    "${dirTrp}${z}I${yyddd}.${extTrp}   ${atmSav} _ ",
    "${dirTro}${z}I${yyddd}.${extTro}   ${atmSav} c ",
    "${dirEle}${z}I${yyddd}.${extEle}   ${orbSav} _ ",
    "${dirStd}${z}I${yyddd}.${extStd}   ${orbSav} _ ",
    "${dirPre}${z}I${yyddd}.${extPre}   ${orbSav} _ ",
    "${dirEst}${z}I${yyddd}.${extEst}   ${solSav} _ ",
    "${dirOut}${z}I${yyddd}.${extOut}   ${outSav} c ",
    "${dirOut}${z}I${yyddd}.TRA         ${outSav} o ",
# Other files
#ss:    "${dirOut}V3__${wwww}.LST           ${outSav} _ ",
#ss:    "${dirOut}V3__${wwww}.LIS           ${outSav} _ ",
  );

  if($sav eq "Y") {
    my(@err) = ();
    foreach(@cpyLst) {
      push(@err,"$_\n") if(&copy2archive(split(" ",$_)));
    }
    die "\n *** copy2archive failed for\n @err\n" if(@err);
  }

# Optional files
  @cpyLst = (
  );

  if($sav eq "Y") {
    my(@err) = ();
    foreach(@cpyLst) {
      push(@err,"$_\n") if(&copy2archive(split(" ",$_)));
    }
    print "\n ### copy2archive failed for\n @err\n" if(@err);
  }

# Some messages
# -------------
  if($sav ne "Y") {
    &prtMess($bpe,"FILES NOT SAVED");
    print       "\nFILES NOT SAVED\n";
  }

}

# ============================================================================

__END__
