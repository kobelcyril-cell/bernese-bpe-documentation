use strict;
use File::Basename;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use igs_device;
use gpsutil;
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyssss,$yyyy,$yy,$ssss,$ddd,$yyddd,$yymm,$wwwwd,$mjd,
    $yydddm1,$yydddm2,$yyyym1,$yyym2,
    $gnss,  $v_tropMod,
    $crdInf,$psdInf,$v_b,$v_x,$v_k,,$v_repErp,$param2,$camp_pth,$campaign,
    $dirCrd,$dirRxo,$dirErp,$dirOsb,$dirDcb,$dirPre,$dirSnx,$dirPsd,
    $extCrd,$extRxo,$extErp,$extOsb,$extDcb,$extPre,$extSnx,$extPsd,
    $pthSkl
  ) =
  $bpe->getKeys(
    '$YSS+0','$Y+0','$Y','$S+0','$+0','$YD+0','$M+0','$WD+0','$JD+0',
    '$YD-1','$YD-2','$Y-1','$Y-2',
    'V_GNSS',  'V_TRPMOD',
    'V_CRDINF','V_PSDINF','V_B','V_X','V_K','V_REPERP','PARAM2','CAMP_PTH','CAMPAIGN',
    'DIR_CRD','DIR_RXO','DIR_ERP','DIR_OSB','DIR_DCB','DIR_PRE','DIR_SNX','DIR_PSD',
    'EXT_CRD','EXT_RXO','EXT_ERP','EXT_OSB','EXT_DCB','EXT_PRE','EXT_SNX','EXT_PSD',
    'PTH_SINEXIN'
  );

  my $repro = (-e "$camp_pth$campaign/MSC/REPROCESSING.FLG");
  my ($line, @tmp, $inpPre, $inpErp);


# Prepare reference files
# -----------------------
  my $psdFil = $psdInf eq ""? "":"${psdInf}.${extPsd}";
  system("$ENV{AUTO}/copyRef.pl ${dirCrd}.. $crdInf $psdFil REF$yyssss");
  copyfile("${dirOsb}CODE.${extOsb}","${dirOsb}APR${yyddd}.${extOsb}");

  print "Execute $ENV{AUTO}/copySkl.pl IGSFIN1D $pthSkl\n";
  system("$ENV{AUTO}/copySkl.pl IGSFIN1D $pthSkl");


# Copy files for reprocessing
# ---------------------------
  if ($repro) {

    # DCB
    # ---
    # TUM monthly DCBs
    my $inpDcb = "$PATH_DATA$CAMP_DATA/DCB_TUM/C1_$yymm.$extDcb";
    # CODE operational DCBs
    if (!-e $inpDcb)
    {$inpDcb ="$PATH_SAV/$CAMP_SAVIGS/$yyyy/ORB/P1C1$yymm.$extDcb";}
    copyfile("$inpDcb","${dirDcb}${v_b}0$yyddd.$extDcb");

    # ERP
    # ---
    copyfile("$ENV{REF}/$v_repErp.${extErp}","$dirErp");

    # Orbits: DACH repro if available
    # -------------------------------
     $inpPre = "$PATH_SAV/$CAMP_SAVREPO/$yyyy/ORB/F3_$yyddd.${extPre}.gz";

    if ( !-e $inpPre ) {
      print "DACH reprocessed orbits not available: using operational orbits ...\n";

      # operational CODE G3 orbits (until 259/2012)
      if ($mjd < 56186){
          $inpPre = "$PATH_SAV/$CAMP_SAVIGS/$yyyy/ORB/G3_$yyddd.${extPre}.gz";
        }
      # operational CODE F3 orbits (starting 260/2012)
      else{
          $inpPre = "$PATH_SAV/$CAMP_SAVIGS/$yyyy/ORB/F3_$yyddd.${extPre}.gz";
        }
     }

    copyfile("$inpPre","${dirPre}${v_x}_${yyddd}.${extPre}.gz");
    uncompress("-z gunzip","${dirPre}${v_x}_${yyddd}.${extPre}.gz");

    # extract only current day from ERP file
    copyfile("$ENV{REF}/${v_repErp}.${extErp}","${dirErp}");
    my $PGMNAM = "POLUPD";
    $bpe->RUN_PGMS($PGMNAM);

    copyfile("${dirErp}${v_x}_${yyddd}.${extErp}","${dirErp}FIN${yyddd}.${extErp}");

    # Merge IGS combo
#    my $igsPre = "$CDIR_DATA/IGS_ORB/IGS$wwwwd.SP3.Z";
#    if ( -s $igsPre ) {
#      my $myIGS  = "${dirPre}IGS${yyddd}.$extPre";
#      system("zcat $igsPre > $myIGS");

#      my $PGMNAM = "CCPREORB";
#      $bpe->RUN_PGMS($PGMNAM);

#      movefile("${dirPre}IGS_${ssss}.$extPre","${dirPre}${v_x}_${yyddd}.$extPre");
#    }

    # Generate "broadcast" for reprocessing
    my $PGMNAM = "SATCLK2";
    $bpe->RUN_PGMS($PGMNAM);

    $PGMNAM = "ORBGEN";
    $bpe->RUN_PGMS($PGMNAM);

    # Copy orbit of previous reprocessing run for comparisons
    $inpPre = "$PATH_SAV/$CAMP_SAVREPO/$yyyy/ORB/F3_$yyddd.$extPre";
    if (-e "$inpPre")
     {copy($inpPre,"${dirPre}PDR${yyddd}.$extPre");}
     else {prtMess($bpe,"PDR ORBITS NOT AVAILABLE");}

    # Copy Vienna grid files
    if ( $v_tropMod =~ /VMF/ ) {
      system("$ENV{AUTO}/copyGrid.pl ${dirCrd}.. $ddd $v_tropMod");
    }

# Copy files for IGSFIN1D
# -----------------------
  } else {
    copyfile("$CDIR_RAP/ORB/RAP_$yyyy.${extErp}","${dirErp}FIN${yyddd}.$extErp");

    # PRE-Files from prev. days if not available
    # ------------------------------------------
    foreach my $preFil ( "${dirPre}/${v_k}_${yydddm1}.${extPre}", 
                         "${dirPre}/${v_k}_${yydddm2}.${extPre}", 
                         "${dirErp}/${v_k}_${yydddm1}.${extErp}", 
                         "${dirErp}/${v_k}_${yydddm2}.${extErp}" ) {
      unless ( -s $preFil ) {
        if ( -s "$PATH_SAV$CAMP_SAVIGS/$yyyym1/ORB/".basename($preFil) ) {
          copyfile("$PATH_SAV$CAMP_SAVIGS/$yyyym1/ORB/".basename($preFil),$dirPre);
        }
      }
    }

    # Adapt mean pole if needed
    # -------------------------
    if($crdInf =~/IGS20/){
       my $PGMNAM = "POLUPD";
       $bpe->putKey("$ENV{U}/PAN/POLUPD.INP","ERPFIL","FIN${yyddd}");
       $bpe->RUN_PGMS($PGMNAM);
       copyfile("${dirErp}${v_x}_${yyddd}.${extErp}","${dirErp}FIN${yyddd}.${extErp}");
    }

    # Copy Vienna grid files
    # ----------------------
    if ( $v_tropMod =~ /VMF/ ) {
      system("$ENV{AUTO}/copyGrid.pl ${dirCrd}.. $ddd $v_tropMod -d=7");
    }
  }

# Copy MGEX orbits if Galileo is active
  if($gnss=~/E/ && 1 == 2){
    my $mgxsrc = "${PATH_SAV}/${CAMP_SAVMGEX}/${yyyy}/ORB/";
    my $mgxorb = "RM_${yyddd}.${extPre}";
    $mgxorb = "${mgxorb}.Z" if(-e "${mgxsrc}${mgxorb}.Z");
    $mgxorb = "${mgxorb}.gz" if(-e "${mgxsrc}${mgxorb}.gz");
    my $dstorb = "${dirPre}/$mgxorb";
    $dstorb =~ s/RM_/MGX/;
    if(-e "${mgxsrc}${mgxorb}"){
      copyfile("${mgxsrc}${mgxorb}",$dstorb);
      if( $dstorb=~/\.(Z|gz)$/){
        system("gzip -d $dstorb");
      }
    }

    my $mgxerp = "RM_${yyddd}.${extErp}";
    $mgxerp = "${mgxerp}.Z" if(-e "${mgxsrc}${mgxerp}.Z");
    $mgxerp = "${mgxerp}.gz" if(-e "${mgxsrc}${mgxerp}.gz");
    my $dsterp = "${dirPre}/$mgxerp";
    $dsterp =~ s/RM_/MGX/;
    if(-e "${mgxsrc}${mgxerp}"){
      copyfile("${mgxsrc}${mgxerp}",$dsterp);
      if( $dsterp=~/\.(Z|gz)$/){
        system("gzip -d $dsterp");
      }
    }

  }elsif($gnss=~/[CJ]/){
    prtMess($bpe,"Beidou and QZSS not supported( selected: $gnss");
    die;
  }

# Stop in case of error
# ---------------------
  $On_Error_Cont = 1;
  err_print() || die();

# Prepare daily RINEX data
# ------------------------
  if ( $repro ) {
#    system("$ENV{AUTO}/put_data.com $yy $ssss %REP $dirRxo");
    system("$ENV{AUTO}/put_igsdata.com $yy $ssss -o $dirRxo %REP --bsw");
# Use only one receiver of antenna splitter stations
     my $selFil="$ENV{REF}/ANTSPLIT.SEL";
     open(FIL,$selFil);
     for(my $i=1;$i<=3;$i++){ $line=<FIL>;}
     while ($line= <FIL>) {
         @tmp=split(" ",$line);
         if (-e "${dirRxo}$tmp[0]${ssss}.$extRxo")
           { unlink("${dirRxo}$tmp[1]${ssss}.$extRxo") ;
             print "${dirRxo}$tmp[1]${ssss}.$extRxo deleted\n";}
     }
     close FIL;
     # special handling of BAHR/BHR1/BHR2
     if (-e "${dirRxo}BAHR${ssss}.$extRxo")
       {unlink("${dirRxo}BHR1${ssss}.$extRxo");
        unlink("${dirRxo}BHR2${ssss}.$extRxo");}
  }
  else {
    system("$ENV{AUTO}/get_obsdata.com $ddd -m=IGS -nt=8 -min=5 -nostat");  # Repeat FTP
    #    system("$ENV{AUTO}/put_data.com $yy $ssss %FIN $dirRxo");
    my $selection ="%FIN";

    system("$ENV{AUTO}/put_igsdata.com $yy $ssss -o $dirRxo %FIN -r --bsw");

##    system("$ENV{AUTO}/rinex.com $dirRxo $ddd");
    system("$ENV{AUTO}/put_igsdata.com $yy $ddd -n $dirRxo --bsw");
# Deletion of bad data:
    unlink("${dirRxo}KHAR1860.14O");
    unlink("${dirRxo}KOSG3600.14O");
    unlink("${dirRxo}SUTM3570.16O");
    unlink("${dirRxo}SUTH3570.16O");
    unlink("${dirRxo}MAL20880.17O");
    unlink("${dirRxo}NOVM3240.18O");
    unlink("${dirRxo}ALIC0770.19O");
    unlink("${dirRxo}ADIS0230.20O");
    unlink("${dirRxo}SFER0640.20O");
    unlink("${dirRxo}SFER0650.20O");
    unlink("${dirRxo}HARB3000.20O");
    unlink("${dirRxo}HRAO3000.20O");
    unlink("${dirRxo}YKRO3100.20O");
    unlink("${dirRxo}HRAO3390.20O");
    unlink("${dirRxo}SUTM3390.20O");
    unlink("${dirRxo}SUTH3390.20O");
    unlink("${dirRxo}UNB33460.20O");
    unlink("${dirRxo}UNBN3460.20O");
    unlink("${dirRxo}UNB30530.21O");
    unlink("${dirRxo}UNBN0530.21O");
# ITRF 14 Solution
    if($campaign =~/IGSFINAL14/){
      unlink("${dirRxo}AMU2297.16O");
      unlink("${dirRxo}LPGS297.16O");
      unlink("${dirRxo}MCM4297.16O");
    }
  }

  system("$ENV{AUTO}/rinex.com $dirRxo $ddd $yy");
}

# ==============================================================================

__END__
