use strict;

sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($wwww) = $bpe->getKeys('$W+0',);

  system("$ENV{AUTO}/orb_lst.com $wwww $$bpe{CAMP_PTH}$$bpe{CAMPAIGN}") &&
  die "Error excuting orblst.com for week $wwww\n";

}
