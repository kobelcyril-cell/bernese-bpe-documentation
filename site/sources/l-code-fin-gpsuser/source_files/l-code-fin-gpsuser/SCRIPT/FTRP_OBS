package FTRP_OBS;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  FTRP_OBS
#
# Purpose :  Extract the observation archive for PPPTROPO.PCF
#
# Programs:
#
# Author  :  R. Dach
# Created :  01-Jan-2021
#
# Changes :  __-___-____ __:
#
# ----------------------------------------------------------------------------
use strict;

use lib "$ENV{AUTO}";
use gpsutil qw(copyfile err_print);

sub run {
  my $bpe = shift;

# Get variables
# -------------
 my  ($yyssss, $yyyy, $ssss,
      $v_obsdir, $v_obstar,
      $dirPzh,
      $extPzh) =

    $bpe->getKeys(
      '$YSS+0', '$Y+0', '$S+0',
      'V_OBSDIR', 'V_OBSTAR',
      'DIR_PZH',
      'EXT_PZH');


  # Copy the archive into the campaign
  copyfile("${v_obsdir}/${v_obstar}","${dirPzh}");
  our $On_Error_Cont = 1;
  err_print() || die();

  # untar the archive
  my %untar = ();
  open(TAR,"tar -xzvf ${dirPzh}/${v_obstar} -C ${dirPzh} |");
  while (<TAR>) {
    chomp();
    $untar{$_} = "${dirPzh}" . (split("/",$_))[-1];
  }
  close(TAR);

  # Clean the campiagn from all observation files of the session
  unlink(glob("${dirPzh}/????${ssss}.???"));

  # Bring the files into the OBS-dir
  foreach my $from (keys %untar) {
    rename("$dirPzh$from","$untar{$from}");
  }

  # Remove the archive in the campaign
  unlink("${dirPzh}/${v_obstar}");

}
