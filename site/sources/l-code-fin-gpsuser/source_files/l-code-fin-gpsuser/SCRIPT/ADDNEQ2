package ADDNEQ2;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  ADDNEQ2
#
# Purpose :  Execute ADDNEQ2/GPSXTR
#
# PARAMs  :  PARAM1: GTRADEL: Delete GTRA (except V_GTRA)
#                    GTRASNX: Delete GTRA (pre-elim V_GTRA, with scale)
#
# Author  :  M. Meindl
# Created :  20-Oct-2003
#
# Changes :  24-Apr-2007/ss: Execute GPSXTR if desired
#            24-Sep-2012/ss: Do not execute GPSXTR if NOINV marked
#            10-Oct-2012/ss: Ignore NOINV
#            29-Jun-2016/ss: Run GPSXTR only if V_XTR set to Y
#            08-May-2019/av: Add option to set GTRA behaviour
#
# ============================================================================
use lib "$ENV{BPE}";
use bpe_module;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($xtr,$gtra,$param1) = $bpe->getKeys('V_XTR','V_GTRA','PARAM1');
  print "\n\nEexecution path: XG: $ENV{XG}\n\n";
  if($gtra){
    my %options;
    my $panel = "$ENV{U}/PAN/ADDNEQ2.INP";
    $options{gnss} = $gtra;
    if($param1=~/GTRADEL/){
      $options{mode} = "NO";
    }elsif($param1=~/GTRASNX/){
      $options{mode} = "AFTER_STACKING";
    }
    if(exists $options{mode}){
      setGTRApar($bpe,$panel,\%options);
    }
  }

# Run program
# -----------
  my $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

  my $noInv = $bpe->getKey("$ENV{U}/INP/ADDNEQ2.INP","NOINV");

##  if ($xtr ne "" && $noInv ne "1") {
##  if ($xtr ne "") {
  if ($xtr eq "Y") {
##    my $outFil = $bpe->getKey("$ENV{U}/INP/ADDNEQ2.INP","SYSOUT");
##    $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",$outFil);
    $bpe->putKey("$ENV{U}/PAN/GPSXTR.INP","OUTPUT",$$bpe{SYSOUT});

    $PGMNAM = "GPSXTR";
    $bpe->RUN_PGMS($PGMNAM);
  }

}
