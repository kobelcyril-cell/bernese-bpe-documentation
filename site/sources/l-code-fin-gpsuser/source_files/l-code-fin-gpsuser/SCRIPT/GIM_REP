package GOTO_AR;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  GIM_REP
#
# Purpose :  GOTO script based on REPRO flag
#
# Programs:  ---
#
# Author  :  A. Villiger
# Created :  28-Sep-2016
#
# Changes :
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($repro,
      $param2,$param3
     ) = $bpe->getKeys(
      'V_REPRO',
      'PARAM2','PARAM3');

# Write the corresponding "GOTO PID" STATEMENT
# --------------------------------------------
  if ($repro) {
    $bpe->PRT_GOTO($param3)
  } else {
    $bpe->PRT_GOTO($param2)
  }
}
