package IEPMERGE;
@ISA = ("RUNBPE");
# =============================================================================
#
# Name    :  IEPMERGE
#
# Purpose :  Merge daily IEP files from POLXTR (V_B, V_F)
#            PARAM1: minus day of first file to be merged, e.g., -6
#
# Programs:
#
# Author  :  S. Lutz
#
# Created :  28-Jun-2013
#
# Changes :  22-FEB-2018 SS: Revised and simplified
#            06-DEC-2019 AV: Fixed variable names V_L -> V_B and V_N -> V_F
#
# =============================================================================

use strict;
use warnings;

use lib "$ENV{EXE}";
use Gps_Date qw(gps_date);

sub run {

  my $bpe = shift;

# Get variables
# -------------
  my(
    $yyddd,$wwww,$mjd,
    $param1,
    $camp_pth, $campaign,
    $f,
    $dirIep,$extIep,
  ) =
  $bpe->getKeys(
    '$YD+0','$W+0','$JD+0',
    'PARAM1',
    'CAMP_PTH','CAMPAIGN',
    'V_F',
    'DIR_IEP','EXT_IEP',
  );

  $param1 = 0 unless($param1);

  my(@sol) = ($f);

  foreach my $sol (@sol) {

    my(@version,@model) = ();
    my(@lin) = ();
    my(@err) = ();

    print gmtime(time)." UT: Last $sol file for header\n";

    my($date) = &gps_date("-mjd $mjd -o %y%j");
    my($fil) = "${dirIep}${sol}${date}.${extIep}";
    push(@err," *** $fil cannot not be read\n") unless(-s $fil);
    open(INP,"<$fil");
    while(<INP>) {
      last if($_ =~ "^$mjd");
      $version[0] = $_ if($_ =~ /^VERSION/);
      $model[0] = $_ if($_ =~ /^NUTATION MODEL/);
      push(@lin,"$_");
    }
    close(INP);

    print gmtime(time)." UT: Loop all $sol files for data\n";

    for(my $i=$mjd+$param1;$i<=$mjd;$i++) {
      $date = &gps_date("-mjd $i -o %y%j");
      $fil = "${dirIep}${sol}${date}.${extIep}";
      push(@err," *** $fil cannot not be read\n") unless(-s $fil);
      open(INP,"<$fil");
      while(<INP>) {
        $version[0] = $_ if($_ =~ /^VERSION/);
        if($version[1] && $version[0] ne $version[1]) {
          die " *** Version change in $fil\n";
        } else { $version[1] = $version[0]; }
        $model[0] = $_ if($_ =~ /^NUTATION MODEL/);
        if($model[1] && $model[0] ne $model[1]) {
          die " *** Model change in $fil\n";
        } else { $model[1] = $model[0]; }
        push(@lin,"$_") if($_ =~ "^$i");
##        push(@lin,"$_") if($_ =~ "^$i\.50");
      }
      close(INP);
    }

    die(@err) if(@err);

    print gmtime(time)." UT: Print $sol output file\n";

    $date = &gps_date("-mjd $mjd -o %W");
    $fil = "${dirIep}${sol}${date}7.${extIep}";
    open(OUT,">$fil");
    print OUT (@lin);
    close(OUT);
    print " Output written to $fil\n";

  }

}

# =============================================================================

__END__
