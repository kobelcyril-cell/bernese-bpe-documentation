# ============================================================================
# PPPFINAL.PCF
# ============================================================================
# Purpose:   PRECISE POINT POSITIONING (PPP)
# based on RCLKGNSS.PCF products
# - computes coordinates, troposphere and receiver clocks
# - compares GPS-only/GLONASS-only/GPS+GLONASS
# - compares with solutions from previous days
# - cleaned zero-diff. observation files are stored
# PPPFINAL BPE processing summary file name: PPPyyssss.PRC
# Remark:    Different plots are generated an embbeded in a system of
# web-pages:
# - GMTKIN_P: plots related to the kinematic solution
# - GMTPLT_P: plots from the time series
# station-specific web-pages
# - FPPP_PRC: web-page for the most recent PPP solution
# - FPPP_F7D: web-page for time series of PPP solutions
# The web-pages and plots are located at $PATH_WWW/$CAMP_SAVPPP.
#
# Author  :  R. Dach
# Created :  10-Jun-2013
#
# Changes :  18-Jul-2013/rd,hb: V_SATINF: SAT_1452->SAT_NONE
#            18-Jul-2013/rd,lp: V_OBSSEL added
#            21-May-2016/av:  Changes due to OSB implementation
#            21-Sep-2016/av: V_PSDINF introduced
#            27-Sep-2016/av: Switch RNXGRA and RNXSMT
#            10-Oct-2016/av: Add SATMON screening
#            25-Jan-2017 av: Add additional IGS-compatible bias run
#            30-Jan-2017 RD: Switch from IGB08 to IGS14
#            20-Jul-2017 SS/AV: Added MELWUEBB FILEST sequence (WLB)
#            26-Jul-2017 SS: Added WL integer (WLI) sequence
#            19-Sep-2017 SS: Added NLB and NLI sequence
#            26-Sep-2017 SS: Added IZDXTR
#            10-Nov-2017 AV/RD: Change waiting conditions (OSB/PHABIA)
#            04-Dec-2017 AV: V_MACMOD and V_BOXWNG introduced
#            06-Mar-2018 AV: CONT_ERR for 293
#            14-May-2018 SS: Removed SATMRK at PID 294; commented CONT_ERR
#            15-May-2018 SS: Substituted DO_PPPAR for determination of
#                            IPPP phase biases and IAR of PPP data
#            22-May-2018 SS: Moved DO_PPPAR to end of BPE
#            30-May-2018 SS: Added V_IAR
#            12-Jun-2018 SS: Replaced DO_PPPAR by integrated PPP AR
#            21-Jun-2018 SS: Substituted PPPAR_AP/PPPAR__P
#            23-Aug-2018 SS: Added V_BIAINF
#            21-Aug-2019 RD: Add V_BLQINF, V_SUBMOD, V_NUTMOD
#            05-Feb-2020 RD: Switch from FES2004 to FES2014b
#            17-Feb-2020 MK: Add GALILEO
#            18-May-2020 SS: Switched to IGb14
#            05-Nov-2020 AV: Add test OSB solution (CBT)
#            07-Dec-2020 RD: Add PCF variable V_TRPMOD
#            25-Jan-2021 RD: Add OBSXTR selection
#            05-May-2021 AV: Change from Compatibility to Macromodel
#            01-Sep-2021 RD: Transform into the new PCF format
#            01-Sep-2021 RD/ST/LP: Reorder BPE server variables for reporting
#            28-Nov-2021 LP: Remove V_MACMOD
#            28-Mar-2022 ST: Rename V_CAMP to V_REQ_CAMP.
#            29-Mar-2022 AV: Modified keywords
#            27-Oct-2022 SS: Introduced V_PCC4MWGF
#            06-Dec-2022 LP: Switch from BOXWING.MAC to BOXWING_I20.MAC
#            08-Mar-2023 RD: GMT-based plotting scripts switch to LOCAL
#            09-Mar-2023 SS: Introduced V_GNSSAR
#            28-Mar-2023 RD/EB: Put parallel jobs with CPU=SHORT to CPU=QUICK/FOX
#            11-May-2023 LP: Add V_GRAVMOD
#            21-Sep-2023 SS: Updated V_GRAVMOD to COSTG_FSM_2303
#            25-Sep-2023 SS: Added BPE_BYE as last process
#            18-Oct-2023 SS: Save CRD 7-day results and perform CRD_UPD process
#                            (which was previously included in IGSFIN7D)
#            11-Dec-2023 RD: Add script DELALL to clean old files from the campaign
#            12-Jan-2024 LP: Updated V_GRAVMOD to COSTG_FSM_2309
#            29-Jan-2024 EB: FPPP_P7D waiting for FPPP_PRC
#            03-Sep-2024 SS: Updated V_GRAVMOD to COSTG_FSM_2312
#            22-Oct-2024 MK: Updated V_GRAVMOD to COSTG_FSM_2406
#            02-Feb-2025 EB: Change from IGS20 to IGB20
#            14-Feb-2025 EB: RNXGRA SHORT->LOCAL (stable processing time: but skipped anyhow)
#            03-Sep-2025 SS: Updated V_GRAVMOD to COSTG_FSM_2412
#            04-Dec-2025 EB: Plotting as default
#            14-Jan-2026 SS: Updated V_GRAVMOD to COSTG_FSM_2503
#            15-Jan-2026 EB/SS: Changed from IGB20 to IGC20 and from I20_2388 to I20_2401=I20
#            16-Jan-2026 SS: Implemented BPE_INI with PARAM1=-reset
#            17-Jan-2026 SS: Removed PARAM1=-reset
#            28-Jan-2026 SS: Added V_INI=Y
#            10-Feb-2026 SS: Changed V_PCV to I20_????
#            23-Feb-2026 SS: Changed V_GRAVMOD to COSTG_FSM_????
#            17-Aug-2026 ML: Add OBSXTR (PID 224) to remove station with too few obs
#
# ============================================================================

PID  SCRIPT    OPT_DIR   PARAMETERS
000  BPE_INI   NO_OPT    CPU=LOCAL; PARAM1=-reset; SCR_PATH=${AIUB}/BPE_SCR
#
# Copy required files and create a priori CRD file
# ------------------------------------------------
010  FPPP_COP  FPPP_SAV  CPU=LOCAL; WAIT=000
011  FPPP_RNX  FPPP_SAV  CPU=LOCAL; WAIT=010
#
015  INIT_VMF  NO_OPT    CPU=SHORT; WAIT=010
016  INIT_HOI  NO_OPT    CPU=SHORT; WAIT=010
#
020  COOVEL    FPPP_GEN  CPU=SHORT; WAIT=010
#
# Preprocess, convert, and synchronize observation data
# -----------------------------------------------------
101  RNXSMTAP  FPPP_GEN  CPU=SHORT; WAIT=011 015 016 020
102  RNXSMT_P  FPPP_GEN  CPU=QUICK; WAIT=101; PARALLEL=101
111  RNXGRA    FPPP_GEN  CPU=LOCAL; WAIT=102; SKIP
121  RXOBV3AP  FPPP_GEN  CPU=SHORT; WAIT=111; PARAM2=14
122  RXOBV3_P  FPPP_GEN  CPU=QUICK; WAIT=121; PARALLEL=121
123  CRDMRDAT  FPPP_GEN  CPU=SHORT; WAIT=122
131  CODSPPAP  FPPP_GEN  CPU=SHORT; WAIT=020 123
132  CODSPP_P  FPPP_GEN  CPU=SHORT; WAIT=131; PARALLEL=131
133  CODXTR    FPPP_GEN  CPU=SHORT; WAIT=132; NEXTJOB=900
134  CRDMRDAT  FPPP_GEN  CPU=SHORT; WAIT=132
141  FILESTAP  FPPP_MON  CPU=SHORT; WAIT=020 133 134
142  FILEST_P  FPPP_MON  CPU=FOX; WAIT=141; PARALLEL=141
143  SATMONAP  FPPP_MON  CPU=MEGA;  WAIT=142; PARAM3=PPP
144  SATMON_P  FPPP_MON  CPU=FOX; WAIT=143; PARALLEL=143
151  MAUPRPAP  FPPP_GEN  CPU=SHORT; WAIT=020 144
152  MAUPRP_P  FPPP_GEN  CPU=QUICK; WAIT=151; PARALLEL=151
153  MPRXTR    FPPP_GEN  CPU=SHORT; WAIT=152; NEXTJOB=_ 900
199  DUMMY     NO_OPT    CPU=SHORT; WAIT=101 144 153
#
# Compute PPP solutions station by station (including data screening)
# -------------------------------------------------------------------
201  PPPEDTAP  FPPP_GEN  CPU=SHORT; WAIT=199
202  PPPEDT_P  FPPP_GEN  CPU=FOX; WAIT=201; PARALLEL=201
203  PPPREDAP  FPPP_RED  CPU=SHORT; WAIT=202
204  PPPRED_P  FPPP_RED  CPU=FOX; WAIT=203; PARALLEL=203
205  GPSXTR    FPPP_GEN  CPU=SHORT; WAIT=204
211  RES_SUM   FPPP_AUX  CPU=SHORT; WAIT=204
221  CRDMERGE  FPPP_AUX  CPU=SHORT; WAIT=204
222  TRPMERGE  FPPP_AUX  CPU=SHORT; WAIT=204; PARAM1=PPP_V_C
223  ADDNEQ2   FPPP_AUX  CPU=SHORT; WAIT=221
#224  MKCLUS    FPPP_AUX  CPU=SHORT; WAIT=221; CONT_ERR
224  OBSXTR_SCR FPPP_AUX  CPU=SHORT; WAIT=221
229  DUMMY     NO_OPT    CPU=LOCAL; WAIT=205 211 222 223 224
#
# Estimation of code biases (independent)
# Alternativ PPP solutions may run in parallel
# --------------------------------------------
230  ADDNEQ2   FPPP_ISB  CPU=LOCAL; WAIT=229
231  ADDNEQ2   FPPP_IS0  CPU=LOCAL; WAIT=230
232  ADDNEQ2   FPPP_IS1  CPU=LOCAL; WAIT=230
233  ADDNEQ2   FPPP_IS2  CPU=LOCAL; WAIT=230
234  ADDNEQ2   FPPP_IST  CPU=LOCAL; WAIT=230
#
290  SKIP_IAR  FPPP_IAR  CPU=LOCAL; WAIT=229; NEXTJOB=299
291  PPPAR_AP  FPPP_IAR  CPU=LOCAL; WAIT=290
292  PPPAR__P  FPPP_IAR  CPU=FOX; WAIT=291; PARALLEL=291
293  PHABIA    FPPP_WLI  CPU=LOCAL; WAIT=292
294  PHABIA    FPPP_NLI  CPU=LOCAL; WAIT=292
295  OBSFMT    FPPP_IAR  CPU=LOCAL; WAIT=292
296  IAR_XTR   FPPP_IAR  CPU=LOCAL; WAIT=293 294 295
#
299  DUMMY     NO_OPT    CPU=LOCAL; WAIT=211 222 230 231 232 233 296
#
# Compute alternative PPP solutions
# ---------------------------------
# Phase-only: GPS+GLONASS+Galileo
301  PPPESTXP  FPPP_GNS  CPU=SHORT; WAIT=296; PARAM2=V_I
302  PPPEST_P  FPPP_GNS  CPU=FOX; WAIT=301; PARALLEL=301
303  ADDNEQ2   FPPP_GNS  CPU=SHORT; WAIT=302
304  CRDMERGE  FPPP_GNS  CPU=SHORT; WAIT=302
305  TRPMERGE  FPPP_GNS  CPU=SHORT; WAIT=302; PARAM1=PPP_V_I
306  GPSXTR    FPPP_GNS  CPU=SHORT; WAIT=303
309  DUMMY     NO_OPT    CPU=LOCAL; WAIT=304 305 306
#
# Phase-only: GPS-only
321  PPPESTXP  FPPP_GPS  CPU=SHORT; WAIT=296; PARAM2=V_K
322  PPPEST_P  FPPP_GPS  CPU=FOX; WAIT=321; PARALLEL=321
323  ADDNEQ2   FPPP_GPS  CPU=SHORT; WAIT=322
324  CRDMERGE  FPPP_GPS  CPU=SHORT; WAIT=322
325  TRPMERGE  FPPP_GPS  CPU=SHORT; WAIT=322; PARAM1=PPP_V_K
326  GPSXTR    FPPP_GPS  CPU=SHORT; WAIT=323
329  DUMMY     NO_OPT    CPU=LOCAL; WAIT=324 325 326
#
# Phase-only: GLONASS-only
341  PPPESTXP  FPPP_GLO  CPU=SHORT; WAIT=309; PARAM2=V_L
342  PPPEST_P  FPPP_GLO  CPU=FOX; WAIT=341; PARALLEL=341
343  ADDNEQ2   FPPP_GLO  CPU=SHORT; WAIT=342
344  CRDMERGE  FPPP_GLO  CPU=SHORT; WAIT=342
345  TRPMERGE  FPPP_GLO  CPU=SHORT; WAIT=342; PARAM1=PPP_V_L
346  GPSXTR    FPPP_GLO  CPU=SHORT; WAIT=343
349  DUMMY     NO_OPT    CPU=LOCAL; WAIT=344 345 346
#
# Phase-only: GALILEO-only
351  PPPESTXP  FPPP_GAL  CPU=SHORT; WAIT=309; PARAM2=V_O
352  PPPEST_P  FPPP_GAL  CPU=FOX; WAIT=351; PARALLEL=351
353  ADDNEQ2   FPPP_GAL  CPU=SHORT; WAIT=352
354  CRDMERGE  FPPP_GAL  CPU=SHORT; WAIT=352
355  TRPMERGE  FPPP_GAL  CPU=SHORT; WAIT=352; PARAM1=PPP_V_O
356  GPSXTR    FPPP_GAL  CPU=SHORT; WAIT=353
359  DUMMY     NO_OPT    CPU=LOCAL; WAIT=354 355 356
#
# Phase-only: GPS+GLONASS; kinematic
361  PPPESTXP  FPPP_KIN  CPU=SHORT; WAIT=296; PARAM2=V_N
362  PPPEST_P  FPPP_KIN  CPU=FOX; WAIT=361; PARALLEL=361
363  PPPESTXP  FPPP_KIN  CPU=SHORT; WAIT=362; PARAM2=V_N
364  GPSXTR_P  FPPP_KIN  CPU=FOX; WAIT=363; PARALLEL=363
#
# Plot kinematic solutions
365  GMTGMTAP  FPPP_GEN  CPU=SHORT; WAIT=364; SKIP
366  GMTKIN_P  FPPP_GEN  CPU=FOX; WAIT=365; SKIP; PARALLEL=365
#
399  DUMMY     NO_OPT    CPU=LOCAL; WAIT=309 329 349 359 366
#
# Compute time series solutions
# -----------------------------
# Code+Phase: GPS+GLO+GAL
401  ADDNEQPM  FPPP_AU7  CPU=SHORT; WAIT=399; PARAM1=-48
405  ADDNEQPM  FPPP_AU7  CPU=SHORT; WAIT=399; PARAM1=-6
#
# Phase-only: GPS+GLO+GAL
411  ADDNEQPM  FPPP_GN7  CPU=SHORT; WAIT=399; PARAM1=-48
415  ADDNEQPM  FPPP_GN7  CPU=SHORT; WAIT=399; PARAM1=-6
#
# Phase-only: GPS-only
421  ADDNEQPM  FPPP_GP7  CPU=SHORT; WAIT=399; PARAM1=-48
425  ADDNEQPM  FPPP_GP7  CPU=SHORT; WAIT=399; PARAM1=-6
#
# Phase-only: GLONASS-only
431  ADDNEQPM  FPPP_GL7  CPU=SHORT; WAIT=399; PARAM1=-48
435  ADDNEQPM  FPPP_GL7  CPU=SHORT; WAIT=399; PARAM1=-6
#
# Phase-only: GALILEO-only
441  ADDNEQPM  FPPP_GA7  CPU=SHORT; WAIT=399; PARAM1=-48
445  ADDNEQPM  FPPP_GA7  CPU=SHORT; WAIT=399; PARAM1=-6
#
# Delete old files from the campaign
# Run in parallel to 7-day ADDNEQ2
# ----------------------------------
451  DELALL    NO_OPT    CPU=LOCAL; WAIT=399; SCR_PATH=${AIUB}/BPE_SCR
# ----------------------------------
#
# CRD_UPD process (to generate updated $REF/IGSyyupd.CRD)
490  CRD_UPD   FPPP_CRD  CPU=SHORT; WAIT=415
#
# Plot coordinate time series
491  GMTGMTAP  FPPP_GEN  CPU=LOCAL; WAIT=401 411 421 431 441; PARAM2=49
492  GMTPLT_P  FPPP_GEN  CPU=LOCAL; WAIT=491; PARALLEL=491
#
499  DUMMY     NO_OPT    CPU=LOCAL; WAIT=231 232 405 415 425 435 445 451 490 492
#
# Determination of IPPP phase biases and IAR of PPP data
# ------------------------------------------------------
800  DO_PPPAR  NO_OPT    CPU=LOCAL; WAIT=299 499; SKIP
#
# End of BPE
# ----------
900  DUMMY     NO_OPT    CPU=LOCAL; WAIT=499 800
901  FPPP_PRC  FPPP_GEN  CPU=LOCAL; WAIT=900
902  FPPP_P7D  FPPP_GEN  CPU=SHORT; WAIT=901
910  FPPP_SAV  FPPP_GEN  CPU=LOCAL; WAIT=901 902
911  ZOBS_SAV  FPPP_SAV  CPU=LOCAL; WAIT=910
920  FPPP_DEL  FPPP_GEN  CPU=LOCAL; WAIT=911
998  BPE_CLN   NO_OPT    CPU=LOCAL; WAIT=920
999  BPE_BYE   NO_OPT    CPU=LOCAL; WAIT=998
#
#

VARIABLE     DEFAULT        PARAMETERS
#
# Solution IDs used in the BPE:
# ----------------------------
V_A        = APR;           DESCRIPTION=A priori information
V_B        = RAP;           DESCRIPTION=Orbit/ERP, DCB, CLK information
V_C        = PPP;           DESCRIPTION=CRD/TRP/TRO/SNX and CLK results
V_E        = REF;           DESCRIPTION=CRD results at reference epoch
V_F        = RED;           DESCRIPTION=Reduced size NEQs (only with CRD)
V_H        = ISB;           DESCRIPTION=Solution for ISB of the day from PPP
V_G        = CBS;           DESCRIPTION=ISB (consistent to IGS DCB values)
V_I        = GNS;           DESCRIPTION=PPP: GNSS, phase-only solution
V_K        = GPS;           DESCRIPTION=PPP: GPS-only, phase-only solution
V_L        = GLO;           DESCRIPTION=PPP: GLONASS-only, phase-only solution
V_N        = KIN;           DESCRIPTION=PPP: GNSS, phase-only, kin. solution
V_O        = GAL;           DESCRIPTION=PPP: GALILEO-only, phase-only solution
#
# Reference frame and station related files:
# -----------------------------------------
V_CRDINF   = IGC20;         DESCRIPTION=CRD/VEL/FIX master file name
V_PSDINF   = IGC20;         DESCRIPTION=PSD corrections
#
# General and model files:
# -----------------------
V_OBSSEL   = OBSERV_COD;    DESCRIPTION=Observation selection file
V_SATINF   = SATELLIT;      DESCRIPTION=Satellite information file
V_PCVINF   = ANT_COD;       DESCRIPTION=PCV information file
V_PCV      = I20_2444;      DESCRIPTION=GNSS PCV model
V_PCC4MWGF = 2022 11 27;    DESCRIPTION=PCC applied for MW/GF LC
#
V_SATCRX   = SAT_$Y+0;      DESCRIPTION=Satellite problem file
V_SYSCRX   = SAT_GNSS;      DESCRIPTION=Satellite problem file for data import
#
V_SUBMOD   = DESAI2016;     DESCRIPTION=Subdaily pole model
V_NUTMOD   = IAU2000R06;    DESCRIPTION=Nutation model
V_GRAVMOD  = COSTG_FSM_2603;  DESCRIPTION=Gravity field model
#
V_TRPMOD   = GMF;           DESCRIPTION=Default troposphere model
#
V_BLQINF   = FES2014b;      DESCRIPTION=BLQ file name, CMC corrections
#
# Processing options used in the BPE:
# ----------------------------------
V_GNSS     = GRE;           DESCRIPTION=GNSS selection (RINEX system char.)
V_GNSSAR   = GE;            DESCRIPTION=GNSS for ambiguity resolution (RINEX system char.)
#
V_BOXWNG   = BOXWING_I20;   DESCRIPTION=Boxwing model file
#
V_SAMPL    = 300;           DESCRIPTION=Sampling rate of the GPSEST solution
V_TRPINT   = 01 00 00;      DESCRIPTION=PPP: Troposphere: ZPD parameter spacing
#
V_CLU      = 20;            DESCRIPTION=Maximum number of files per cluster
#
V_REQ_CAMP = PPPFIN;        DESCRIPTION=Campaign to be used
V_RERUN    = 1;             DESCRIPTION=Number of reruns in case of failure
V_PLUS     = +0;            DESCRIPTION=Plus  days
V_MINUS    = -30;           DESCRIPTION=Minus days
#
V_BIAINF   = SINEX_BIA_COD;  DESCRIPTION=BIAS SINEX information skeleton
#
# Other variables:
# ---------------
V_OBSTAR   = PPP;           DESCRIPTION=Name of the archive with observ. files
V_RESET    = N;             DESCRIPTION=Recompute all stations for this day
V_INI      = Y;             DESCRIPTION=BPE initalization mode (Y/N/Verified)
V_XTR      = Y;             DESCRIPTION=Automatic program extraction (GPSXTR)
V_UPD      = Y;             DESCRIPTION=Update general files?
V_SAV      = Y;             DESCRIPTION=Save results?
V_PLT      = Y;             DESCRIPTION=Plot results?
V_DEL      = Y;             DESCRIPTION=Delete results?
V_DIS      = Y;             DESCRIPTION=Distribute results?
V_IAR      = Y;             DESCRIPTION=Perform ZERO_AR using DO_PPPAR
