341  GPSEST_P  IGSF_G    CPU=QUICK; WAIT=340; PARALLEL=340
342  GPSXTR    IGSF_A    CPU=LOCAL; WAIT=341
360  ADDNEQ2   IGSF_G    CPU=SHORT; WAIT=342
361  CRD_CHK   IGSF_G    CPU=LOCAL; WAIT=360; NEXTJOB=310
362  SMA_CHK   NO_OPT    CPU=LOCAL; WAIT=361; PARAM1=Z; PARAM2=SMT
363  UPDSTD    IGSF_G    CPU=SHORT; WAIT=362
364  STDPRE    IGSF_G    CPU=SHORT; WAIT=363
