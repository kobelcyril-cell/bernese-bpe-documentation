121  RXOBV3_P  IGSF_A    CPU=QUICK; WAIT=120; PARALLEL=120
130  GOTO_REP  NO_OPT    CPU=LOCAL; WAIT=121; NEXTJOB=_ 140
131  MKCLUS    IGSF_GEN  CPU=SHORT; WAIT=130
# STOP HERE -> check DEL-List
#
# Preprocess code
140  WAIT_BPE  NO_OPT    CPU=LOCAL; WAIT=012 131; PARAM1=301
160  CODSPPAP  NO_OPT    CPU=LOCAL; WAIT=140
161  CODSPP_P  IGSF_A    CPU=QUICK; WAIT=160; PARALLEL=160
162  CODXTR    IGSF_A    CPU=LOCAL; WAIT=161
#
# 1st ITERATION: improve broadcast orbits (2 RPR par, no ERPs)
# SKIP if good (rapid) orbits are available
#
200  RAP_DONE  IGSF_A    CPU=LOCAL; WAIT=162
210  MGX_DONE  IGSF_A    CPU=LOCAL; WAIT=200
# 220 SNGDIF   IGSF_F            SHORT    1 210
# 240 MAUPRPAP IGSF_F            LOCAL    1 220
# 241 MAUPRP_P IGSF_F            SHORT    1 240
# 242 MPRXTR   IGSF_F            LOCAL    1 241
