#
# additional parameters required for PID's
#

VARIABLE   DEFAULT         PARAMETERS
#
# Solution IDs used in the BPE:
# ----------------------------
V_O      = B1;             DESCRIPTION=A priori orbit (broadcast/rapid)
V_A      = Z1;             DESCRIPTION=Ionosphere model ID
V_X      = A1;             DESCRIPTION=One-day orbit from 1. iteration
V_Z      = G1;             DESCRIPTION=One-day orbit from 2. iteration
V_U      = H1;             DESCRIPTION=One-day orbit from 3. iteration
V_V      = I1;             DESCRIPTION=A priori one-day orbit for NEQ-files
V_K      = F1;             DESCRIPTION=ID for final one-day solutions
V_B      = W1;             DESCRIPTION=WUEBB DCB results
V_E      = R1;             DESCRIPTION=Test NEQs
#
# Reference frame and station related files:
# -----------------------------------------
V_CRDINF = IGC20;          DESCRIPTION=CRD/VEL/FIX master file name
V_PSDINF = IGC20;          DESCRIPTION=PSD corrections
V_CRDEPO = 2020 01 01;     DESCRIPTION=CRD reference epoch
#
V_STAINF = CODE;           DESCRIPTION=Station information file
#
# General and model files:
# -----------------------
V_OBSSEL = OBSERV_COD;     DESCRIPTION=Observation selection file
V_SATINF = SATELLIT;       DESCRIPTION=Satellite information file
V_PCVINF = ANT_COD;        DESCRIPTION=PCV information file
V_PCV    = I20_2444;       DESCRIPTION=GNSS PCV model
V_ANTAZI = YES;            DESCRIPTION=Consider antenna rotations (YES|NO)
V_SATCRX = SAT;            DESCRIPTION=Satellite problem file
V_SYSCRX = SAT_GNSS;       DESCRIPTION=Satellite problem file for data import
#
V_MEANPL  = IERS2010_v1.2.0; DESCRIPTION=Mean pole model
V_SUBMOD  = DESAI2016;       DESCRIPTION=Subdaily pole model
V_NUTMOD  = IAU2000R06;      DESCRIPTION=Nutation model
V_GRAVMOD = COSTG_FSM_2603; DESCRIPTION=Gravity field model
#
V_TRPMOD = VMF31;          DESCRIPTION=Default troposphere model
#
V_LOADNG = GFZ;            DESCRIPTION=Loading models; CARDS=NONE VAPL GFZ
V_BLQINF = FES2014b;       DESCRIPTION=BLQ file name, CMC corrections
V_ATLINF = VAPL;           DESCRIPTION=ATL file name, CMC corrections
#
# Ambiguity resolution:
# --------------------
V_GNSSAR = GRE;            DESCRIPTION=GNSS for ambiguity resolution (RINEX system char.)
V_ARITER = 2;              DESCRIPTION=Number of iterations for WUEBB AR
V_BL_AMB = 6000;           DESCRIPTION=Max baseline length (km) for WUEBB AR
V_BL_QIF = 2000;           DESCRIPTION=Max baseline length (km) for QIF AR
V_BL_L53 = 200;            DESCRIPTION=Max baseline length (km) for L53 AR
V_BL_L12 = 20;             DESCRIPTION=Max baseline length (km) for L12 AR
#
# Processing options used in the BPE:
# ----------------------------------
V_GNSS   = GRE;            DESCRIPTION=GNSS selection (RINEX system char.)
#
V_BOXWNG = BOXWING_I20;    DESCRIPTION=Boxwing model file
V_SP3INT = 300;            DESCRIPTION=Sampling in archived precise files
V_ATTINT = 30;             DESCRIPTION=Sampling in attitude reporting files
V_DTSTC  = 05 59 00;       DESCRIPTION=Min. interval between pulse and maneuver
#
V_CLU    = 20;             DESCRIPTION=Maximum number of files per cluster
#
V_REQ_CAMP = IGSFINAL;     DESCRIPTION=Campaign to be used
V_RERUN  = 1;              DESCRIPTION=Number of reruns in case of failure
V_PLUS   = +0;             DESCRIPTION=Plus  days
V_MINUS  = -0;             DESCRIPTION=Minus days
#
V_SNXINF = SINEX_COF;      DESCRIPTION=SINEX information skeleton
V_BIAINF = SINEX_BIA_COD;  DESCRIPTION=BIAS SINEX information skeleton
#
# Variables related to reprocessing:
# ---------------------------------
V_REPERP = C04_$Y+0;       DESCRIPTION=A priori pole file for reprocessing
V_PRC    = F1_;            DESCRIPTION=Summary of BPE log files
#
# Other variables:
# ---------------
V_OBSTAR = FIN;            DESCRIPTION=Name of the archive with observation files
V_INI    = Y;              DESCRIPTION=BPE initalization mode (Y/N/Verified)
V_XTR    = Y;              DESCRIPTION=Automatic program extraction (GPSXTR)
