500  WAIT_BPE  NO_OPT    CPU=LOCAL; WAIT=400; PARAM1=710
510  GPSESTAP  NO_OPT    CPU=LOCAL; WAIT=500
511  GPSEST_P  IGSF_H    CPU=QUICK; WAIT=510; PARALLEL=510
