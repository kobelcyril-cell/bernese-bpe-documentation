# 261 GPSEST_P IGSF_F            SHORT    1 260
# 262 GPSXTR   IGSF_A            LOCAL    1 261
# 280 ADDNEQ2  IGSF_F            SHORT    1 262
# 281 UPDSTD   IGSF_F            SHORT    1 280
#
# 2nd ITERATION: data cleaning with RESRMS (5 RPR par)
#
300  WAIT_BPE  NO_OPT    CPU=LOCAL; WAIT=210; PARAM1=510
301  DEFSTD    IGSF_F0   CPU=SHORT; WAIT=300
310  SNGDIF    IGSF_G    CPU=MEGA;  WAIT=301
311  SNGDIFC   IGSF_A    CPU=MEGA;  WAIT=310
