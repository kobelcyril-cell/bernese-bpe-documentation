#
700  WAIT_BPE  NO_OPT    CPU=LOCAL; WAIT=601 602; PARAM1=810
710  DEFSTD    IGSF_Q0   CPU=SHORT; WAIT=700
711  ION_WAIT  NO_OPT    CPU=LOCAL; WAIT=710
712  INIT_VMF  NO_OPT    CPU=LOCAL; WAIT=711
713  INIT_APL  NO_OPT    CPU=LOCAL; WAIT=712
720  GPSCLUAP  NO_OPT    CPU=LOCAL; WAIT=713
721  GPSCLU_P  IGSF_Q    CPU=LOCAL; WAIT=720; PARALLEL=720
722  GPSXTR    IGSF_A    CPU=LOCAL; WAIT=721
#
# Generation of F1 final solution results
# ---------------------------------------
# A=Addition of 4 cluster NEQs
# R=Reduction of full NEQ (in terms of troposphere and orbit parameters)
# C=Coordinates computed using default FIX list
# P=Product generation (for coordinates, troposphere, orbit, ERP)
# S=SINEX generation
# G=GCC computation
# T=TRA computation
# FLA= 90 day long ADDNEQ
800  WAIT_BPE  NO_OPT    CPU=LOCAL; WAIT=722; PARAM1=910
801  WAIT_JOB  NO_OPT    CPU=LOCAL; WAIT=800; SKIP
810  ADDNEQ2   IGSF_F1A  CPU=BIG; WAIT=801
811  ADDNEQ2   IGSF_F1O  CPU=MEGA; WAIT=810
812  ADDNEQ2   IGSF_F1R  CPU=BIG; WAIT=811
# START POINT:
821  INIT_FIX  NO_OPT    CPU=LOCAL; WAIT=812; PARAM1=K
822  STA2STA   NO_OPT    CPU=LOCAL; WAIT=812; PARAM1=IGS_CRX
823  STA2STA   NO_OPT    CPU=LOCAL; WAIT=812; PARAM1=IGS_SNX; PARAM2=RNX_CRX
