# ============================================================================
# PPPTROPO.PCF
# ============================================================================
#
# Purpose:      PRECISE POINT POSITIONING (PPP)
#               based on FCLKGNSS.PCF products
#               - computes high-rate troposphere and slant delays
#
#               PPPFINAL BPE processing summary file name: PPPyyssss.PRC
#
# Author     :  R. Dach
# Created    :  01-Jan-2021
#
# Changes    :  05-May-2021 AV: Change from Compatibility to Macromodel
#               09-Sep-2021 ST/LP: Transform into the new PCF format
#               09-Sep-2021 ST/LP: Reorder BPE server variables for reporting
#               28-Nov-2021 LP: Remove V_MACMOD
#               28-Mar-2022 ST: Rename V_CAMP to V_REQ_CAMP.
#               29-Mar-2022 AV: Modified keywords
#               06-Dec-2022 LP: Switch from BOXWING.MAC to BOXWING_I20.MAC; fix SUBMOD; I20 change
#               28-Mar-2023 RD/EB: Put parallel jobs with CPU=SHORT to CPU=QUICK/FOX
#               02-Feb-2025 EB: Change from IGS20 to IGB20
#               15-Jan-2026 EB/SS: Changed from IGB20 to IGC20 and from I20_2388 to I20_2401=I20
#               13-Feb-2026 SS: Changed from from I20_2401 to I20_2405=I20
#
# ============================================================================

PID  SCRIPT    OPT_DIR   PARAMETERS
#
# Skip session in case of repeation
# ---------------------------------
000  SKIP_SES  NO_OPT    CPU=LOCAL; NEXTJOB=999
#
# Copy required files and create a priori CRD file
# ------------------------------------------------
001  FTRP_COP  FTRP_GEN  CPU=LOCAL; WAIT=000
002  FTRP_OBS  FTRP_GEN  CPU=LOCAL; WAIT=000
013  INIT_HOI  NO_OPT    CPU=LOCAL; WAIT=001
014  INIT_VMF  NO_OPT    CPU=LOCAL; WAIT=001
099  DUMMY     NO_OPT    CPU=LOCAL; WAIT=002 013 014
#
# Compute high-rate troposphere solution
# --------------------------------------
101  PPPESTXP  FCLK_TRP  CPU=LOCAL; WAIT=099
102  PPPEST_P  FCLK_TRP  CPU=FOX; WAIT=101; PARALLEL=101
111  GPSXTR    FCLK_TRP  CPU=SHORT; WAIT=102
112  TROTRO    FCLK_TRP  CPU=SHORT; WAIT=102
199  DUMMY     NO_OPT    CPU=LOCAL; WAIT=111 112
#
# End of BPE
# ----------
900  DUMMY     NO_OPT    CPU=LOCAL; WAIT=199
901  FTRP_PRC  FTRP_GEN  CPU=LOCAL; WAIT=900
910  FTRP_SAV  FTRP_GEN  CPU=LOCAL; WAIT=901
920  FTRP_DEL  FTRP_GEN  CPU=LOCAL; WAIT=910
998  BPE_CLN   NO_OPT    CPU=LOCAL; WAIT=920
999  DUMMY     NO_OPT    CPU=LOCAL; WAIT=998
#
#

VARIABLE   DEFAULT              PARAMETERS
#
# Solution IDs used in the BPE:
# ----------------------------
V_ORB    = PPP;                 DESCRIPTION=Orbit file identifier
V_CRD    = PPP;                 DESCRIPTION=Coordinate file identifier
V_PPP    = TRP;                 DESCRIPTION=Troposphere file identifier
#
# Reference frame and station related files:
# -----------------------------------------
V_CRDINF = IGC20;               DESCRIPTION=CRD/VEL/FIX master file name
V_PSDINF = IGC20;               DESCRIPTION=PSD corrections
#
V_STAINF = CODE;                DESCRIPTION=Station information file (for Tropo-SNX)
#
# General and model files:
# -----------------------
V_OBSSEL = OBSERV_COD;          DESCRIPTION=Observation selection file
V_SATINF = SATELLIT;            DESCRIPTION=Satellite information file
V_PCVINF = ANT_COD;             DESCRIPTION=PCV information file
V_PCV    = I20_2444;            DESCRIPTION=GNSS PCV model
#
V_SATCRX = SAT_REP20_$Y+0;      DESCRIPTION=Satellite problem file
V_SYSCRX = SAT_GNSS;            DESCRIPTION=Satellite problem file for data import
#
V_SUBMOD = DESAI2016;           DESCRIPTION=Subdaily pole model
V_NUTMOD = IAU2000R06;          DESCRIPTION=Nutation model
#
V_TRPMOD = VMF;                 DESCRIPTION=Troposphere model in GPSCLU (GMF/VMF)
# V_TRPMOD = VMF31;               DESCRIPTION=Troposphere model in GPSCLU (GMF/VMF)
#
V_BLQINF = FES2014b;            DESCRIPTION=BLQ file name, CMC corrections
#
# Processing options used in the BPE:
# ----------------------------------
V_GNSS   = GRE;                 DESCRIPTION=GNSS selection (RINEX system char.)
#
V_BOXWNG = BOXWING_I20;         DESCRIPTION=Boxwing model file
V_SAMPL  = 300;                 DESCRIPTION=Sampling rate of the GPSEST solution
#
V_REQ_CAMP = PPPTRP;            DESCRIPTION=Campaign to be used
V_RERUN  = 1;                   DESCRIPTION=Number of reruns in case of failure
V_PLUS   = +0;                  DESCRIPTION=Session range end
V_MINUS  = -0;                  DESCRIPTION=Session range begin
#
V_SINEX  = SINEX.R20_TRO;       DESCRIPTION=SINEX information skeleton
V_BIAINF = SINEX_BIA_COD;       DESCRIPTION=Bias-SINEX information skeleton
#
#   Tropo-specific options
V_TRPINT = 01 00 00;            DESCRIPTION=PPP: Tropo: ZPD parameter spacing
V_GRDINT = 24 00 00;            DESCRIPTION=PPP: Tropo: GRD parameter spacing
V_TRPSIG = 5.0;                 DESCRIPTION=PPP: Tropo: ZPD relative sigma (m)
V_GRDSIG = 5.0;                 DESCRIPTION=PPP: Tropo: GRD relative sigma (m)
#
# Other variables:
# ---------------
V_UPD    = Y;                   DESCRIPTION=Update general files?
V_SAV    = Y;                   DESCRIPTION=Save results?
V_PLT    = N;                   DESCRIPTION=Plot results?
V_DEL    = Y;                   DESCRIPTION=Delete results?
V_DIS    = Y;                   DESCRIPTION=Distribute results?
#
# TODO To be placed into corresponding sections
# ---------------------------------------------
#
# Copy of input information
V_OBSDIR = ${S}/REPCLK_R20/$Y+0/OBS;  DESCRIPTION=Dir. from where the obs file are taken
V_OBSTAR = FCLK$YSS+0.tar.gz;         DESCRIPTION=ID of the tar archive
#
V_CLKDIR = ${S}/REPCLK_R20/$Y+0/ORB;  DESCRIPTION=Dir. with results of the clock solution
V_SATCLK = F3H_$YSS+0.CLK;            DESCRIPTION=
V_OSBFIL = IAR$YSS+0.OSB;             DESCRIPTION=
V_CRDFIL = F3U_$YSS+0.CRD;            DESCRIPTION=
#
V_ORBDIR = ${S}/REPRO_R20/$Y+0/ORB;   DESCRIPTION=Dir. with results of the orbit solution
V_STDFIL = F3_$YD+0.STD;              DESCRIPTION=
V_ERPFIL = F3_$YD+0.ERP;              DESCRIPTION=
#
V_SAVDIR = ${S}/REPRO_TRP;            DESCRIPTION=Dir. for results from this BPE
#
V_SKIP   = ${S}/REPRO_TRP/$Y+0/ATM/TRP_$YSS+0.TRP;  DESCRIPTION=If this file exists, skip the session
