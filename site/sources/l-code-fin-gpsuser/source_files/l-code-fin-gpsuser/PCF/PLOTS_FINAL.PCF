#
#

VARIABLE     DEFAULT        PARAMETERS
#
# General and model files:
# -----------------------
V_SATCRX   = SAT;           DESCRIPTION=Satellite problem file
V_SATINF   = SATELLIT;      DESCRIPTION=SATELLITE INFORMATION FILE
V_PCV      = I20;           DESCRIPTION=GNSS PCV MODEL (ABS)
#
# General settings
# ----------------
V_REQ_CAMP = PLOTS_FIN;     DESCRIPTION=Campaign to be used
V_FIG = final_;             DESCRIPTION=Prepending ID for all output plots
V_SAV = Y;                  DESCRIPTION=Publish plots on PATH_WWW/code/plots
V_DATE = ;                  DESCRIPTION=blank process latest file or define date as yyddd or yysss as in the filename
V_NUMDAYS = 364;            DESCRIPTION=Length of the plots (positive integer value) if nothing script specific is defined
#
# Constellation plots
# -------------------
V_SATCONST = SATCONST;      DESCRIPTION=Name of the ELE file in the plot campaign/blank no plot
#
# Station map plot
# ----------------
V_MAPCRD = MAPCRD;          DESCRIPTION=Name of the CRD file in the plot campaign/blank no plot
#
# HELMERT residuals on a map
# --------------------------
V_MAPHLM = MAPHLM;          DESCRIPTION=Name of the file with map of HELMERT residuals/blank no plot
#
# Plot number of stations per system in FINAL solution
# ----------------------------------------------------
V_STANUM = STANUM;          DESCRIPTION=Name of the CRD file in the plot campaign/blank no plot
V_STANUMDAYS = 364;         DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot number of satellites per system in FINAL solution
# ------------------------------------------------------
V_SATNUM = SATNUM;          DESCRIPTION=Name of the PRE file in the plot campaign/blank no plot
V_SATNUMDAYS = 364;         DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot ambiguity resolution rate in FINAL solution
# ------------------------------------------------
V_AMBXTR = AMBXTR;          DESCRIPTION=Name of the summary file with OBSXTR for AMBRES/blank no plot
V_AMBXTRDAYS = 364;         DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot general solution statistics from GPSXTR in FINAL solutions
# ---------------------------------------------------------------
V_GPSXTR = GPSXTR;          DESCRIPTION=Name of the summary file with GPSXTR for rms,#par,#obs/blank no plot
V_GPSXTRDAYS = 364;         DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot general solution statistics from OBSXTR in FINAL solutions
# ---------------------------------------------------------------
V_OBSXTR = OBSXTR;          DESCRIPTION=Name of the summary file with OBSXTR for rms,#par,#obs/blank no plot
V_OBSXTRDAYS = 364;         DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot RMS of linear fit in FINAL clock solution (30s densification based on 3day orbits)
# ----------------------------------------------
V_CCRNXC = CCRNXC;          DESCRIPTION=Name of the summary file with CCRNXC for 'RMS lin fit'/blank no plot
V_CCRNXCDAYS = 364;         DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot Helmrt-transformation results in FINAL solution
# ----------------------------------------------------
V_HELMR1     = HELMR1;        DESCRIPTION=Name of the summary file with STDELE for orbit overlaps/blank no plot
V_HELMR1DAYS = 364;           DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot Orbit overlaps in FINAL solution (POS in 3day solutions)
# -------------------------------------
V_STDELE = STDELE;          DESCRIPTION=Name of the summary file with STDELE for orbit overlaps/blank no plot
V_STDELEDAYS = 364;         DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
#
# Plot pole time series in FINAL solution
# ---------------------------------------
V_POLE = POLE;              DESCRIPTION=Name of the cumulated long term pole series/blank no plot
#
# Plot Orbit overlaps in FINAL solution (POS in 3day solutions)
# -------------------------------------
V_GCC = GCC;                DESCRIPTION=Name of the GCC files to be plotted/blank no plot
V_GCCDAYS = 364;            DESCRIPTION=Length of the plot into the past (positive integer value) or use V_NUMDAYS
