#==============================================================
#
# Procedure Control File (PCF)
# All comment lines start with a #
#
#  CLKVER.PCF: Receiver clock verification for all GNSS
#
# Changes: 09-May-2017 SS: Created
#          16-Sep-2021 ST: Transform into the new PCF format
#                          Reorder BPE server variables for reporting
#          28-Mar-2022 ST: Rename V_CAMP to V_REQ_CAMP.
#          29-Mar-2022 AV: Modified keywords
#          28-Mar-2023 RD/EB: Put parallel jobs with CPU=SHORT to CPU=QUICK/FOX
#          14-Dec-2023 SS: V_PCV=I20
#
#==============================================================

PID  SCRIPT    OPT_DIR   PARAMETERS
101  CLKVERAP  CVER_GEN  CPU=LOCAL
102  CLKVER_P  CVER_GEN  CPU=FOX; WAIT=101; PARALLEL=101

VARIABLE   DEFAULT        PARAMETERS
#
# Solution IDs used in the BPE:
# ----------------------------
V_A      = BRD;           DESCRIPTION=Broadcast orbit
V_K1     = RQ;            DESCRIPTION=One-day orbit/ERP/CRD/tropo from MRAPID
V_K3     = RM;            DESCRIPTION=Three-day orbit/ERP/CRD/tropo from MRAPID
V_K5     = R5;            DESCRIPTION=Fife-day orbit/ERP/CRD/tropo from MRAPID
V_W      = C0;            DESCRIPTION=CODSPP a-priori solution
V_I      = CW;            DESCRIPTION=Weights for the code obervations
V_B      = CR;            DESCRIPTION=Code screening
V_C      = CB;            DESCRIPTION=Unify inter-system/frequency biases
V_E      = CC;            DESCRIPTION=CLKEST for starting MAUPRP
V_H      = T0;            DESCRIPTION=Code+phase screening in reg. clusters
V_U1     = T1;            DESCRIPTION=CLKs consistent to one-day orbits
V_U3     = T3;            DESCRIPTION=CLKs consistent to three-day orbits
V_U5     = T5;            DESCRIPTION=CLKs consistent to fife-day orbits
V_O1     = C1;            DESCRIPTION=Merged troposphere consistent to one-day orbits
V_O3     = C3;            DESCRIPTION=Merged troposphere consistent to three-day orbits
V_O5     = C5;            DESCRIPTION=Merged troposphere consistent to fife-day orbits
#
# Reference frame and station related files:
# -----------------------------------------
V_CRDINF = IGS14;         DESCRIPTION=CRD/VEL/FIX master file name
V_PSDINF = IGS14;         DESCRIPTION=PSD corrections for ITRF2014
#
V_STAINF = CODE;          DESCRIPTION=Station information file
#
# General and model files:
# -----------------------
V_OBSSEL = OBS_COD;       DESCRIPTION=Observation selection file
V_SATINF = SATELLIT;      DESCRIPTION=Satellite information file
V_PCVINF = ANT_COD;       DESCRIPTION=PCV information file
V_PCV    = I20;           DESCRIPTION=GNSS PCV model
#
V_SATCRX = SAT;           DESCRIPTION=Satellite problem file for MGEX
V_SYSCRX = SATM_GNSS;     DESCRIPTION=Satellite problem file for data import
V_MCCRX  = MCLK;          DESCRIPTION=Satellite problem file for MCLKGNSS
#
# Processing options used in the BPE:
# ----------------------------------
V_GNSS   = GRECJ;         DESCRIPTION=GNSS selection (RINEX system char.)
#
V_CLU    = 15;            DESCRIPTION=Maximum number of files per cluster
#
V_REQ_CAMP = FCLKGNSS;    DESCRIPTION=Campaign to be used
V_RERUN  = 1;             DESCRIPTION=Number of reruns in case of failure
V_PLUS   = +0;            DESCRIPTION=Plus  days
V_MINUS  = -0;            DESCRIPTION=Minus days
#
V_ORBCMP = MGEXORB;       DESCRIPTION=Corresponding orbit campaign
#
V_BIAINF = SINEX_BIA_COM;  DESCRIPTION=Bias-SINEX information skeleton
#
# Variables related to reprocessing:
# ---------------------------------
V_REPRO  = N;             DESCRIPTION=Reprocessing mode (Y/N)?
#
# Other variables:
# ---------------
V_RSRMS1 = 6;             DESCRIPTION=RESRMS screening level iteration 1 [mm]
V_MAXSTA = 140;           DESCRIPTION=Maximum number of stations
V_SAMPL  = 300;           DESCRIPTION=Sampling rate of the GPSEST solution
V_DCBMOD = CI;            DESCRIPTION=Types of DCBs (C:P1C1, I:ISB/IFB)
V_MGEX   = Y;             DESCRIPTION=Process MGEX data?
#V_SAVED  = NMGX_TEST;     DESCRIPTION=Specific sub-directory on savedsik?
V_SAVED  = ;              DESCRIPTION=Specific sub-directory on savedsik?
