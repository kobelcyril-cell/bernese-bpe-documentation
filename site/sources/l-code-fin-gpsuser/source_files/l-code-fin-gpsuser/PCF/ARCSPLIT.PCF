# ============================================================================
#
# Procedure Control File (PCF)
# All comment lines start with a
#
# Perform arc splitting for 3-day solution
# based on 1-day orbits
#
# Changes: 07-Feb-2012, PS: Added save script
#          18-Jul-2013/rd,hb: V_SATINF: SAT_1452->SAT_NONE
#          18-Jul-2013/rd,lp: V_OBSSEL added
#          02-Sep-2019/is   : ORBCMO added
#          05-May-2021 AV: Change from Compatibility to Macromodel
#          09-Sep-2021 ST/LP: Transform into the new PCF format
#          09-Sep-2021 ST/LP: Reorder BPE server variables for reporting
#          28-Mar-2022 ST: Rename V_CAMP to V_REQ_CAMP.
#          29-Mar-2022 AV: Modified keywords
#          04-Jul-2022 RD: V_ATTINT added (sampling in ATTXTR)
#          06-Jul-2022 RD: Increass sampling for V_ATTINT 900->30
#          06-Dec-2022 LP: Switch from BOXWING.MAC to BOXWING_I20.MAC
#          11-May-2023 LP: Add V_GRAVMOD
#          21-Sep-2023 SS: Updated V_GRAVMOD to COSTG_FSM_2303
#          12-Jan-2024 LP: Updated V_GRAVMOD to COSTG_FSM_2309
#          22-Oct-2024 MK: Updated V_GRAVMOD to COSTG_FSM_2406
#          03-Sep-2025 SS: Updated V_GRAVMOD to COSTG_FSM_2412
#          14-Jan-2026 SS: Updated V_GRAVMOD to COSTG_FSM_2503
#
# ============================================================================

PID  SCRIPT    OPT_DIR   PARAMETERS
001  ATTXTR    IGSF_ORQ
010  ARCSPLIT  IGSF_ORQ  WAIT=001
020  SPLT_SAV  IGSF_ORQ  WAIT=010
#
# Orbit overlaps
030  ORBPM     IGSF_ORQ  WAIT=020; SKIP
#
# additional parameters required for PID's
#

VARIABLE   DEFAULT           PARAMETERS
#
# Solution IDs used in the BPE:
# ----------------------------
V_K      = F1;               DESCRIPTION=One-day orbit solution equations
#
# General and model files:
# -----------------------
V_OBSSEL = OBSERV_COD;       DESCRIPTION=Observation selection file
V_SATINF = SATELLIT;         DESCRIPTION=Satellite information file
V_PCVINF = ANT_COD;          DESCRIPTION=PCV information file
V_PCV    = R20;              DESCRIPTION=GNSS PCV model
#
V_SATCRX = SAT_REP20;        DESCRIPTION=Satellite problem file
#
V_SUBMOD = DESAI2016;        DESCRIPTION=Subdaily pole model
V_NUTMOD = IAU2000R06;       DESCRIPTION=Nutation model
V_MEANPL = IERS2010_v1.2.0;  DESCRIPTION=Mean pole model
V_GRAVMOD = COSTG_FSM_2503;  DESCRIPTION=Gravity field model
#
V_BLQINF = FES2014b;         DESCRIPTION=BLQ file name, CMC corrections
V_ATLINF = ;                 DESCRIPTION=ATL file name, CMC corrections
#
# Processing options used in the BPE:
# ----------------------------------
V_MACMOD = Macromodel;       DESCRIPTION=Non-conservative forces modelling
V_BOXWNG = BOXWING_I20;      DESCRIPTION=Boxwing model file
V_ATTINT = 30;               DESCRIPTION=Sampling in attitude reporting files
V_REPERP = C04_$Y+0;         DESCRIPTION=A-priori pole file for reprocessing
#
V_REQ_CAMP = ARCSPLIT;       DESCRIPTION=Campaign to be used
V_RERUN  = 1;                DESCRIPTION=Number of reruns in case of failure
V_PLUS   = 1;                DESCRIPTION=Plus  days
V_MINUS  = 0;                DESCRIPTION=Minus days
#
V_SP3INT = 300;              DESCRIPTION=Sampling in archived precise files
#
# Other variables:
# ---------------
V_SAV    = Y;                DESCRIPTION=Save results?
