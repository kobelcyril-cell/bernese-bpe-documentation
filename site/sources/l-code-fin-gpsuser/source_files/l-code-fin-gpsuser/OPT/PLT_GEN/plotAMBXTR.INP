LEG_FONTSIZE 1  "large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_LEG_FONTSIZE 1  "Font size in the legend"


# BEGIN_PANEL NO_CONDITION #####################################################
# PLOT AMBIGUITY RESOLUTION SUCCESS RATE - plotAMBXTR 1: Input/output files    #
#                                                                              #
# GENERAL CONFIGURATION                                                        #
#   Show general configuration        > % <                                    # SHOWGEN
#                                                                              #
# RESULT FILE                                                                  #
#   Show figure on the screen         > % <                                    # FIGSHOW
#   Name of the output file           > %%%%%%%%%%%%%%%%%%%%%%%% <             # FIGOUT
#                                       (extension defines the format)         #
#   Resolution of the figure          > %%%% < dpi                             # FIGRES
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# plotAMBXTR 1.1: General Configuration                                        #
#                                                                              #
# FONT DEFITIONS                                                               #
#   Title                       > %%%%%%%%%%%% <                               # TIT_FONTSIZE
#   Labels                      > %%%%%%%%%%%% <                               # LABEL_FONTSIZE
#   Legend                      > %%%%%%%%%%%% <                               # LEG_FONTSIZE
#                                                                              #
# COLOR DEFITIONS                                                              #
#   Background color of the plot> %%%%%%%%%%%% <                               # BGCOLOR
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotAMBXTR 2: Plot layout                                                    #
#                                                                              #
# PLOT LAYOUT SPECIFICATION                                                    #
#   Size of the plot:   width   > %%%%%%%%%% <    height     > %%%%%%%%%% <    # SIZEX SIZEY
#                                                                              #
#   Boundaries: > % < auto or            epoch axis             data axis      # XYAUTO
#                          lower bound  > %%%%%%%%%% <        > %%%%%%%% <     # TMIN YMIN
#                          upper bound  > %%%%%%%%%% <        > %%%%%%%% <     # TMAX YMAX
#                                        (yyyy mm dd)                          #
#                                                                              #
#   Labels at  epoch axis  > %%%%%%%%%%%%%%%%%%%%% <                           # LABEL_X
#              data  axis  > %%%%%%%%%%%%%%%%%%%%% <                           # LABEL_Y
#                                                                              #
# CONTENT OF THE PLOT                                                          #
#   Title > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION ###############################################################################
# plotAMBXTR 3: Time series for plotting                                                                 #
#                                                                                                        #
#     Filename             key        sys        color         symbol        size      label             #
#   > %%%%%%%%%%%% <    (General files, used for all plots)                                              # XTRFIL_0
# 1.> %%%%%%%%%%%% <     > %%%%%% <  > %%%% <  > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# XTRFIL_1 KEY_1 SYS_1 COLOR_1 SYMBOL_1 SSIZE_1 LABEL_1
# 2.> %%%%%%%%%%%% <     > %%%%%% <  > %%%% <  > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# XTRFIL_2 KEY_2 SYS_2 COLOR_2 SYMBOL_2 SSIZE_2 LABEL_2
# 3.> %%%%%%%%%%%% <     > %%%%%% <  > %%%% <  > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# XTRFIL_3 KEY_3 SYS_3 COLOR_3 SYMBOL_3 SSIZE_3 LABEL_3
# 4.> %%%%%%%%%%%% <     > %%%%%% <  > %%%% <  > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# XTRFIL_4 KEY_4 SYS_4 COLOR_4 SYMBOL_4 SSIZE_4 LABEL_4
# 5.> %%%%%%%%%%%% <     > %%%%%% <  > %%%% <  > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# XTRFIL_5 KEY_5 SYS_5 COLOR_5 SYMBOL_5 SSIZE_5 LABEL_5
# 6.> %%%%%%%%%%%% <     > %%%%%% <  > %%%% <  > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# XTRFIL_6 KEY_6 SYS_6 COLOR_6 SYMBOL_6 SSIZE_6 LABEL_6
#                                                                                                        #
# END_PANEL ##############################################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotAMBXTR 4: Legend layout                                                  #
#                                                                              #
# LEGEND LAYOUT SPECIFICATION                                                  #
# > % <  Legend:                                                               # LEGEND
#        Position  > %%%%%%%%%%%% <  X-off > %%%%% <  Y-off > %%%%% <          # LEG_POS LEG_ANCHOR_X LEG_ANCHOR_Y
#        Frame     > % <             Num. Columns   > % <                      # LEG_FRAME LEG_NCOLS
#        Title     > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <          # LEG_TITLE
#                                                                              #
# END_PANEL ####################################################################
