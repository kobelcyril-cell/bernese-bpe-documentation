
! Environment Variables
! ---------------------
ENVIRONMENT 1  "" "${}"
  ## widget = initmenu; pointer = ENVIR_LIST

! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 1  "./DUMMY"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${PAN}/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "1980"
  ## widget = comment
  # $Y+0

SES_INFO 1  "0060"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show general configuration"

! Filename for resulting plots (output)
! -------------------------------------
FIGSHOW 1  "0"
  ## widget = checkbox

MSG_FIGSHOW 1  "Show resulting firgure on the screen"

FIGOUT 1  "./DUMMY/FIG/$(FIG)AMBXTR.eps"
  ## widget = lineedit; path = DIR_FIG; ext = NO_EXT; maxfiles = 1
  # $(FIG)AMBXTR.eps

DESCR_FIGOUT 1  "Output file for plot of number of epochs"

FIGRES 1  "600"
  ## widget = lineedit; check_type = integer; check_min = 50

DESCR_FIGRES 1  "Resolution of the figure"

! Input data: dataset 0
! ---------------------
XTRFIL_0 0
  ## widget = selwin; path = DIR_SUM; extList = EXT_SUM NO_EXT
  # $(AMBXTR)_[0-9]*

DESCR_XTRFIL_0 1  "List of ERP files in Bernese format (dataset 0)"

! Input data: dataset 1
! ---------------------
XTRFIL_1 0
  ## widget = selwin; path = DIR_SUM; extList = EXT_SUM NO_EXT
  ## activeif = XTRFIL_0 = _
  # 

DESCR_XTRFIL_1 1  "List of GPSXTR files (dataset 1)"

KEY_1 1  "OBSXTR"
  ## widget = combobox; cards = OBSXTR; editable = true
  ## activeif = XTRFIL_1 / _ OR XTRFIL_0 / _

MSG_KEY_1 1  "Line number for plotting (dataset 1)"

SYS_1 1  "GPS"
  ## widget = combobox; editable = false; activeif = KEY_1 / _
  ## cards = ALL GPS GLO GAL BDS QZS SBA

MSG_SYS_1 1  "GNSS selection for dataset 1"

COLOR_1 1  "blue"
  ## widget = combobox; editable = true; activeif = KEY_1 / _
  ## cards = red green blue yellow orange magenta cyan grey

MSG_COLOR_1 1  "Color for dataset 1"

SYMBOL_1 1  "circle"
  ## widget = combobox; editable = false; activeif = KEY_1 / _
  ## cards = circle triangle_down triangle_up triangle_left triangle_right tri_down tri_up tri_left tri_right octagon square pentagon plus(filled) star hexagon1 hexagon2 plus x(filled) diamond thin_diamond

MSG_SYMBOL_1 1  "Symbol for dataset 1"

SSIZE_1 1  "2"
  ## widget = spinbox; range = 1 30 1; activeif = KEY_1 / _

MSG_SSIZE_1 1  "Symbol size for dataset 1"

LABEL_1 1  "GPS"
  ## widget = lineedit; activeif = KEY_1 / _

MSG_LABEL_1 1  "Legend entry for dataset 1"

