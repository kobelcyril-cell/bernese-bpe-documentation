# BEGIN_PANEL NO_CONDITION #####################################################
# CONVERT OBSERVATION FILES (BINARY TO ASCII) - OBSFMT 1: Input/Output Files   #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files  > % <                                              # SHOWGEN
#                                                                              #
# INPUT FILES                                                                  #
#   Zero difference observations        Single difference observations         #
#     code  > %%%%%%%%%%%% <                  code  > %%%%%%%%%%%% <           # CZHFIL CSHFIL
#     phase > %%%%%%%%%%%% <                  phase > %%%%%%%%%%%% <           # PZHFIL PSHFIL
#     both  > % <                         both  > % <                          # BOTHZERO BOTHSING
#                                                                              #
#   Range observations                                                         #
#           > %%%%%%%%%%%% <                                                   # RZHFIL
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output      > % < use OBSFMT.Lnn            or    > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages      > % < merged to program output  or    > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# SORT SYSTEMS AND PRNS > % <                                                  # SORTSYSPRN
#                                                                              #
# TITLE > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# OBSFMT 1.1: General Files                                                    #
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################
