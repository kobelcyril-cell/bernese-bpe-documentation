
! Environment Variables
! ---------------------
ENVIRONMENT 7
  "P" "/aiub"
  "Q" "/aiub2"
  "K" "/aiub_u_camp"
  "X" "/aiub_sw/BERN/GPS"
  "U" "/u/aiub/igsfinal/GPSUSER"
  "S" "/aiub_savedisk"
  "USER" "igsfinal"
  ## widget = initmenu; pointer = ENVIR_LIST

! SOME KEYWORDS FOR AUTOMATIC OUTPUT
! ----------------------------------
CAMPAIGN 1  "${Q}/IGSFINAL"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${Q}/IGSFINAL/STA/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2003"
  ## widget = comment
  # $Y+0

SES_INFO 1  "2070"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! -------------------------------------------------------------------------
! Show general files
! ------------------
SHOWGEN 1  "0"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

! General Constants
! -----------------
CONST 1  "CONST"
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1

DESCR_CONST 1  "General Constants"

! Geodetic Datum
! --------------
DATUM 1  "DATUM"
  ## widget = selwin; path = PTH_DATUM; ext = EXT_DATUM; maxfiles = 1

DESCR_DATUM 1  "Geodetic datum"

! World Map
! ---------
WORLDMAP 1  "${X}/GEN/PLTNET.DAT"
  ## widget = selwin; path = PTH_GEN; ext = NO_EXT; maxfiles = 1
  # PLTNET.DAT

WORLD 1  "${X}/GEN/WORLDMAP."
  ## widget = selwin; path = PTH_GEN; ext = NO_EXT; maxfiles = 1
  # WORLDMAP.

DESCR_WORLD 1  "World map"

! Input options
! -------------
INPUT 1  "${U}/INP/PLTGENI.INP"
  ## widget = selwin

! Coordinate file to plot
! -----------------------
COORD 1  "${Q}/IGSFINAL/STA/CODE00P01.CRD"
  ## widget = selwin; path = DIR_CRD; ext = EXT_CRD; maxfiles = 1
  # CODE00P01

DESCR_COORD 1  "Coordinate file to plot"

! Single difference files
! -----------------------
PLTFLS 1  "${Q}/IGSFINAL/OUT/POLXTR_IERS.PLT"
  ## widget = selwin; path = DIR_OUT; ext = NO_EXT; maxfiles = 1
  # POLXTR_IERS.PLT

PLTFLS_TXT_COL_1 1  "Input file"

PLTFLS_PTH_COL_2 1  "${Q}/IGSFINAL/OUT/"
  ## widget = initmenu; pointer = DIR_OUT

PLTFLS_EXT_COL_2 0
  ## widget = initmenu; pointer = NO_EXT

PLTFLS_TXT_COL_2 1  "Input file"

DESCR_PLTFLS 1  "Single difference files"

! Coordinate displacements
! ------------------------
COORDES 1  "${Q}/IGSFINAL/STA/CODE00P01.CRD"
  ## widget = selwin; path = DIR_CRD; ext = EXT_CRD; maxfiles = 1
  # CODE00P01

DESCR_COORDES 1  "Coordinate displacements"

! Estimated velocities
! --------------------
VELREF 1  "${Q}/IGSFINAL/STA/CODE00P01.VEL"
  ## widget = selwin; path = DIR_VEL; ext = EXT_VEL; maxfiles = 1
  # CODE00P01

DESCR_VELREF 1  "Estimated velocities"

! Reference velocities
! --------------------
FIXVEL 1  "${Q}/IGSFINAL/STA/CODE00P01.VEL"
  ## widget = selwin; path = DIR_VEL; ext = EXT_VEL; maxfiles = 1
  # CODE00P01

DESCR_FIXVEL 1  "Reference velocities"

! Summary file
! ------------
SUMMAR 1  "${Q}/IGSFINAL/OUT/PLTGEN.SUM"
  ## widget = lineedit; path = DIR_SUM; ext = EXT_SUM; maxfiles = 1
  ## emptyallowed = true
  # PLTGEN

! Output device
! -------------
PLTFIL 1  "?"
  ## widget = lineedit

! Title
! -----
TITLE 1  "CODE - BULLETIN A EOPs: 19-06-1993 - 207-0703003"
  ## widget = lineedit
  # CODE - BULLETIN A EOPs: 19-06-1993 - $+0-$M-$Y+0

! Borders of map
! --------------
BEGLON 1  "180"
  ## widget = lineedit

BEGLAT 1  "-90"
  ## widget = lineedit

DLTLON 1  "360"
  ## widget = lineedit

DLTLAT 1  "180"
  ## widget = lineedit

! Symbol sizes
! ------------
PSIZE 1  "1.4"
  ## widget = lineedit

! Font size
! ---------
FSIZE 1  "0.5"
  ## widget = lineedit

! Scale size for displacements
! ----------------------------
DISSIZ 1  "50.0"
  ## widget = lineedit

! Scale size for error ellipses
! -----------------------------
ELLSIZ 1  "9.0"
  ## widget = lineedit

! Print baselines
! ---------------
BASLIN 1  "0"
  ## widget = checkbox

! Hide station names
! ------------------
HIDENAM 1  "0"
  ## widget = checkbox

! Program Output File
! -------------------
SYSODEF 1  "0"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "${Q}/IGSFINAL/OUT/PLTGEN.OUT"
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false
  # PLTGEN

DESCR_SYSOUT 1  "Program output"

! Error Message File
! ------------------
ERRMRG 1  "1"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 0
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false
  # ERROR

DESCR_SYSERR 1  "Error messages"

FORMAT 1  "10"
  ## widget = lineedit

UNITS2 1  "0"
  ## widget = lineedit

TSTART 1  "0"
  ## widget = lineedit

TSTAMP 1  "1993.0"
  ## widget = lineedit

OUTLIER 1  "0.0"
  ## widget = lineedit

PLOTID 1  "0"
  ## widget = checkbox


# BEGIN_PANEL NO_CONDITION #####################################################
# PLOT VELOCITIES - PLTVEL 1: Filenames                                        #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   Show all general files      > % <                                          # SHOWGEN
#                                                                              #
# INPUT FILES                                                                  #
#   File list                   > %%%%%%%%%%%% <                               # PLTFLS
#                                                                              #
# OUTPUT FILES                                                                 #
#   Output device               > %%%%%%%% <                                   # PLTFIL
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output              > % < use CODSPP.Lnn           or > %%%%%%%% < # SYSODEF SYSOUT
#   Error messages              > % < merged to program output or > %%%%%%%% < # ERRMRG SYSERR
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# PLTVEL 1.1: General Files                                                    #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants           > %%%%%%%%%%%% <                               # CONST
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <# CAMPAIGN
#   Selected session              year> %%%% <  session> %%%% <                # YR4_INFO SES_INFO
#   Session table               > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <# SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# PLTVEL 2: Options                                                            #
#                                                                              #
# TITLE   > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#                                                                              #
# FORMAT OF PLOT INPUT FILES                                      > %%%%% <    # FORMAT
#    0 = ADDNEQ PLOT FILE                                                      #
#    1 = ADDNEQ PLOT FILE WITH SIGMA'S                                         #
#    2 = COMPAR PLOT FILE (SPECIFY STARTING TIME)                              #
#   10 = POLXTR PLOT FILES                                                     #
#   11 = POLINT PLOT FILES                                                     #
#   12 = IGS COMBINATION POLE FILES                                            #
#   13 = ADDNEQ HELMERT OUTPUT FILES (HELMERT TRANSF PARAMETERS)               #
#   20 = ORBGEN PLOT FILES                                                     #
#   21 = ORBIMP BINARY RESIDUAL FILES                                          #
#   30 = OCMSTA OUTPUT FILES (IGS COMBO'S)                                     #
#   31 = ORBEXT OUTPUT FILES (ORBIT COMPARISONS)                               #
#   40 = STDELE OUTPUT FILES (96: ALL, 97: NOECL, 98: ECL)                     #
#   50 = SAT CLOCK OUTPUT FILES                                                #
#   51 = SAT CLOCK OUTPUT FILES DIFFERNECE        *** (2 COLUMNS IN F-FILE) ***#
#   60 = BERNESE TROPOSPHERE ESTIMATES                                         #
#   61 = BERNESE TROPOSPHERE ESTIMATE DIFFERENCES *** (2 COLUMNS IN F-FILE) ***#
#   70 = PRECISE ORBIT FILE                                                    #
#   71 = PRECISE ORBIT FILE DIFFERENCES           *** (2 COLUMNS IN F-FILE) ***#
#   80 = RINEX CLOCK FILE                                                      #
#   81 = RINEX CLOCK FILE DIFFERENCES             *** (2 COLUMNS IN F-FILE) ***#
#   99 = TEST/DUMMY FORMAT                                                     #
#                                                                              #
# UNITS FOR SECOND TIME-AXIS (X-AXIS)                             > %%%%% <    # UNITS2
#    0 = DEFAULT (FORMAT DEPENDENT)                                            #
#    1 = YEARS                                                                 #
#    2 = GPS WEEKS                                                             #
#    3 = DAY OF YEAR                                                           #
#    4 = MODIFIED JULIAN DAYS                                                  #
#                                                                              #
# SELECT START TIME FOR PLOT (LIMIT DATA SPAN)                    > %%%%% <    # TSTART
#  UNITS: GPSWEEKS                                                             #
#                                                                              #
# TIME STAMP FOR FIRST VALUE (FORMATS 2, 10 AND 20)            > %%%%%%%% <    # TSTAMP
#  FORMATS 2, 10 AND 20 DO NOT CONTAIN ABS. TIME INFORMATION                   #
#  UNITS: FORMAT  2: MJD  OF 1.FILE                                            #
#         FORMAT 10: YEAR OF 1.FILE                                            #
#         FORMAT 20: MJD  OF 1.FILE                                            #
#                                                                              #
# OUTLIER REJECTION. MAXIMUM VALUES TO BE PLOTTED              > %%%%%%%% <    # OUTLIER
# (0.0 : NO OUTLIER REJECTION)                                                 #
#                                                                              #
# PLOT ID IN BOTTOM RIGHT OF FIGURE                                   > % <    # PLOTID
#                                                                              #
# END_PANEL ####################################################################
