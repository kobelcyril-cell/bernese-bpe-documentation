!
! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 1  "${P}/EXAMPLE"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${P}/EXAMPLE/GEN/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2022"
  ## widget = comment
  # $Y+0

SES_INFO 1  "3010"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Environment variables
! ---------------------
ENVIRONMENT 12
  "P" "/storage/research/aiub_code"
  "Q" "/storage/research/aiub_code"
  "K" "/storage/research/aiub_u_camp"
  "X" "/storage/research/aiub_data/BSWsoftware/BERN/GPS"
  "U" "/storage/homefs/l_code/GPSUSER"
  "S" "/storage/research/aiub_data/PRODUCTS"
  "G" "/storage/research/aiub_u_camp"
  "USER" "l_code"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  ## widget = initmenu; pointer = ENVIR_LIST

!---------------------------------------------------------------------
! INPUTFILES                                                         |
!---------------------------------------------------------------------
! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

! General constants
! -----------------
CONST 1  "${MODEL}/CONST.BSW"
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1
  # CONST

DESCR_CONST 1  "General constants"

! Abbreviation table
! ------------------
ABBREV 1  "${P}/EXAMPLE/STA/CODE.ABB"
  ## widget = selwin; path = DIR_ABB; ext = EXT_ABB; maxfiles = 1
  # CODE

DESCR_ABBREV 1  "Abbreviation table"

! STAINFO with information requested in the RINEX files
! -----------------------------------------------------
RNXINFO 1  "${P}/EXAMPLE/STA/CODE.STA"
  ## widget = selwin; path = DIR_STA; ext = EXT_STA; maxfiles = 1
  # CODE

DESCR_RNXINFO 1  "Station information"

! Summary of a previous AR step
! -----------------------------
ARSUM 1  "${P}/EXAMPLE/OUT/AMB22301.SUM"
  ## widget = selwin; path = DIR_SUM; ext = EXT_SUM; maxfiles = 999
  ## emptyallowed = true
  # AMB$YD+0

ARSUM_TXT_COL_1 1  "AR Summaries"

MSG_ARSUM 1  "Ambiguity resolution summaries"

!---------------------------------------------------------------------
! OUTPUTFILES                                                        |
!---------------------------------------------------------------------
! Residuals
! ---------
RESID 0
  ## widget = lineedit; path = DIR_RES; ext = EXT_RES

DESCR_RESID 1  "Residuals"

! Program output file
! -------------------
SYSODEF 1  "0"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "${P}/EXAMPLE/OUT/RCVTST.OUT"
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false
  # RCVTST

DESCR_SYSOUT 1  "Program output"

! Error message file
! ------------------
ERRMRG 1  "0"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 1  "${U}/WORK/ERROR.MSG"
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false
  # ERROR

DESCR_SYSERR 1  "Error message"

! Subroutine/function debug output
! --------------------------------
DEBUG_STKLOG 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_STKLOG 1  "Subroutine/function debug stack log output"

DEBUG_SUMMARY 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_SUMMARY 1  "Subroutine/function debug summary output"

DEBUG_INTERVAL 1  "00 01 00"
  ## widget = lineedit; check_type = time

MSG_DEBUG_INTERVAL 1  "Interval for intermediate debug summary"

!---------------------------------------------------------------------
! OPTIONS                                                             |
!---------------------------------------------------------------------
! Title
! -----
TITLE 1  "IGSFINAL WL AR"
  ## widget = lineedit

MSG_TITLE 1  "Title line"

ORDER 1  "1"
  ## widget = checkbox

MSG_ORDER 1  "Order results"

NITER 1  "3"
  ## widget = spinbox; range = 0 25 1

MSG_NITER 1  "Number of iterations"


# BEGIN_PANEL NO_CONDITION #####################################################
# TEST OF RECEIVER PERFORMANCE - RCVTST 1: Filenames                           #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files            > % <                                    # SHOWGEN
#                                                                              #
# INPUT FILE                                                                   #
#   Ambiguity resolution summaries    > %%%%%%%%%%%% <                         # ARSUM
#                                                                              #
# OUTPUT FILE                                                                  #
#   Residuals                         > %%%%%%%%%%%% <                         # RESID
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output       > % < use RXOBV3.Lnn            or > %%%%%%%%%%%% <   # SYSODEF SYSOUT
#   Error messages       > % < merged to program output  or > %%%%%%%%%%%% <   # ERRMRG SYSERR
#                                                                              #
# END_PANEL ####################################################################


