
! Environment Variables
! ---------------------
ENVIRONMENT 12
  "P" "/storage/research/aiub_code"
  "Q" "/storage/research/aiub_code"
  "K" "/storage/research/aiub_u_camp"
  "X" "/storage/research/aiub_data/BSWsoftware/BERN/GPS"
  "U" "/storage/homefs/l_code/GPSUSER"
  "S" "/storage/research/aiub_data/PRODUCTS"
  "G" "/storage/research/aiub_u_camp"
  "USER" "l_code"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  ## widget = initmenu; pointer = ENVIR_LIST

CAMPAIGN 1  "${P}/EXAMPLE"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

USR_INFO 1  "${USER}"
  ## widget = comment

SESSION_TABLE 1  "${P}/EXAMPLE/GEN/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2022"
  ## widget = comment
  # $Y+0

SES_INFO 1  "3010"
  ## widget = comment
  # $S+0

TITLE 1  "IGSFIN3D_22301: REMOVAL OF IGS_SNX STATIONS FROM $Z_22301.TRO"
  ## widget = lineedit
  # IGSFIN3D_$YD+0: REMOVAL OF IGS_SNX STATIONS FROM $Z_$YD+0.TRO

MSG_TITLE 1  "Title line"

! -------------------------------------------------------------------
! General Files
! -------------------------------------------------------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

! General Constants
! -----------------
CONST 1  "${MODEL}/CONST.BSW"
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1
  # CONST

DESCR_CONST 1  "General constants"

STAINFO 1  "${P}/EXAMPLE/STA/IGS_SNX.STA"
  ## widget = selwin; path = DIR_STA; ext = EXT_STA; maxfiles = 1
  # IGS_SNX

DESCR_STAINFO 1  "Station information"

! -------------------------------------------------------------------
! Input/Output Files
! -------------------------------------------------------------------
! Input Troposphere Sinex
! -----------------------
SNXINP 1  "${P}/EXAMPLE/ATM/$Z_22301.TRO"
  ## widget = selwin; path = DIR_TRO; ext = EXT_TRO
  # $Z_$YD+0

MSG_SNXINP 1  "Input file: troposphere SINEX"

! Output Troposphere Sinex
! ------------------------
SNXOUT 1  "${P}/EXAMPLE/ATM/$ZN22301.TRO"
  ## widget = lineedit; path = DIR_TRO; ext = EXT_TRO; maxfiles = 1
  # $ZN$YD+0

DESCR_SNXOUT 1  "Result file: troposphere SINEX"

! Program Output File
! -------------------
SYSODEF 1  "1"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "${P}/EXAMPLE/OUT/TROTRO.L27"
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false
  # ${K}/TIMSIMUL/OUT/TROTRO

DESCR_SYSOUT 1  "Program output"

! Error Message File
! ------------------
ERRMRG 1  "0"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 1  "${U}/WORK/ERROR.MSG"
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false
  # ERROR

DESCR_SYSERR 1  "Error message"

! Subroutine/function debug output
! --------------------------------
DEBUG_STKLOG 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_STKLOG 1  "Debug stack log output"

DEBUG_SUMMARY 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_SUMMARY 1  "Debug summary output"

DEBUG_INTERVAL 1  "00 01 00"
  ## widget = lineedit; check_type = time

MSG_DEBUG_INTERVAL 1  "Interval for intermediate debug summary"


# BEGIN_PANEL NO_CONDITION #####################################################
# MANIPULATE TROPOSPHERE SINEX FILES - TROTRO 1: Filenames                     #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files  > % <                                              # SHOWGEN
#                                                                              #
# INPUT FILES                                                                  #
#   Troposphere SINEX       > %%%%%%%%%%%% <                                   # SNXINP
#   Station information     > %%%%%%%%%%%% <                                   # STAINFO
#                                                                              #
# RESULT FILE                                                                  #
#   Troposphere SINEX       > %%%%%%%%%%%% <                                   # SNXOUT
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output        > % < use TROTRO.Lnn            or  > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages        > % < merged to program output  or  > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# TITLE  > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <  # TITLE
# END_PANEL ####################################################################


