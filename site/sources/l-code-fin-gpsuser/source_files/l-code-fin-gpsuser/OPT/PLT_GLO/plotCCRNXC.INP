# BEGIN_PANEL NO_CONDITION #####################################################
# PLOT SAT-CLOCK STATISTICS FROM CCRNXC - plotCCRNXC 1: Input/output files     #
#                                                                              #
# GENERAL CONFIGURATION                                                        #
#   Show general configuration        > % <                                    # SHOWGEN
#                                                                              #
# DEFINE THE CONTENT OF THE PLOT      > %%%%%%%%%%%%%%%%%%%%%%%% <             # WHAT
#                                                                              #
# INPUT FILES                                                                  #
#   Input CCRNXC program output files > %%%%%%%% <                             # CCRNXC
#   Use the n-th sequence of CCRNXC   > %% <                                   # NCCRNXC
#                                                                              #
# REFERENCE FOR DIFFERENCES                                                    #
#   Input CCRNXC program output files > %%%%%%%% <                             # CCRNXC_REF
#   Use the n-th sequence of CCRNXC   > %% <                                   # NCCRNXC_REF
#                                                                              #
# RESULT FILE                                                                  #
#   Show figure on the screen         > % <                                    # FIGSHOW
#   Name of the output file           > %%%%%%%%%%%%%%%%%%%%%%%% <             # FIGOUT
#                                       (extension defines the format)         #
#   Resolution of the figure          > %%%% < dpi                             # FIGRES
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# plotCCRNXC 1.1: General Configuration                                        #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   Satellite information       > %%%%%%%%%%%% <                               # SATELL
#                                                                              #
# FONT DEFITIONS                                                               #
#   Title                       > %%%%%%%%%%%% <                               # TIT_FONTSIZE
#   Labels                      > %%%%%%%%%%%% <                               # LABEL_FONTSIZE
#   Legend                      > %%%%%%%%%%%% <                               # LEG_FONTSIZE
#   Font scale                  > %%%%%%%%%%%% <                               # FONTSCALE
#                                                                              #
# COLOR DEFITIONS                                                              #
#   Background color of the plot> %%%%%%%%%%%% <                               # BGCOLOR
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotCCNRXC 2: Plot layout                                                    #
#                                                                              #
# CONTENT OF THE PLOT                                                          #
#   Title > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#                                                                              #
#   Include satellite clocks                                                   #
#      > % <  GPS              > % <  GLONASS          > % <  Galileo          # USE_GPS USE_GLO USE_GAL
#      > % <  SBAS             > % <  BeiDou           > % <  QZSS             # USE_SBS USE_BDS USE_QZS
#   Sort satellites   > %%%%%% <                                               # SORT
#                                                                              #
# PLOT LAYOUT                                                                  #
#   Size of the plot:   width   > %%%%%%%%%% <    height     > %%%%%%%%%% <    # SIZEX SIZEY
#      > % < Axis boundaries are defined atuomatically                         # XYAUTO
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL WHAT = NUMEPO_matrix OR WHAT = LINFIT_matrix #####################
# plotCCNRXC 3: Plot layout                                                    #
#                                                                              #
# COLOR MAP LAYOUT                                                             #
#   Define color map         > %%%%%%%%%%%%%%%%%%% <   > % < reverse           # CMAP CREVERSE
#      Range of values   min > %%%%%% <        max > %%%%%% <                  # CMIN CMAX
#      Label for colormap    > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <        # CLABEL
#                                                                              #
# PLOT LAYOUT                                                                  #
#   Layout of the time axis     > %%%%%%%%%% <                                 # XLABEL
#      > % <  number of tickmarks/labels      > %%%% <                         # XTICK_N XTICK_NUM
#      > % <  delta between tickmarks/labels  > %%%% <  days                   # XTICK_D XTICK_DEL
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL WHAT = NUMEPO_matrix OR WHAT = LINFIT_matrix AND CMAP = MANUAL ###
# plotCCRNXC 3.1: User defined color map                                       #
#                                                                              #
# Create an user defined colormap                                              #
# > value__ color_______ <         define colors for 0.0 and 1.0               # CMAP_MANUAL
#                                  additional value/color combinations         #
#                                    may be added inbetween                    #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL WHAT = LINFIT_boxplot OR WHAT = NUMEPO_series ####################
# plotCCNRXC 4: Time series for plotting                                       #
#                                                                              #
# SELECT DATASET        n-th sequ.                                             #
#     Filename          of CCRNXC      GNSS        color           label       #
# 1.> %%%%%%%%%%%% <     > %%% <     > %%%% <    > %%%%%%%% <    > %%%%%%%% <  # CCRNXC_1 NCCRNXC_1 USESYS_1 COLOR_1 LABEL_1
# 2.> %%%%%%%%%%%% <     > %%% <     > %%%% <    > %%%%%%%% <    > %%%%%%%% <  # CCRNXC_2 NCCRNXC_2 USESYS_2 COLOR_2 LABEL_2
# 3.> %%%%%%%%%%%% <     > %%% <     > %%%% <    > %%%%%%%% <    > %%%%%%%% <  # CCRNXC_3 NCCRNXC_3 USESYS_3 COLOR_3 LABEL_3
# 4.> %%%%%%%%%%%% <     > %%% <     > %%%% <    > %%%%%%%% <    > %%%%%%%% <  # CCRNXC_4 NCCRNXC_4 USESYS_4 COLOR_4 LABEL_4
# 5.> %%%%%%%%%%%% <     > %%% <     > %%%% <    > %%%%%%%% <    > %%%%%%%% <  # CCRNXC_5 NCCRNXC_5 USESYS_5 COLOR_5 LABEL_5
# 6.> %%%%%%%%%%%% <     > %%% <     > %%%% <    > %%%%%%%% <    > %%%%%%%% <  # CCRNXC_6 NCCRNXC_6 USESYS_6 COLOR_6 LABEL_6
#                                                                              #
# PLOT AXIS SPECIFICATION                  Boundaries: > % < auto or           # XYAUTO
#     Labels at                                 Min         Max                #
#     X-axis      > %%%%%%%%%%%%%%%%%%%%% <   > %%%%%%%% <> %%%%%%%% <         # LABEL_X XMIN XMAX
#     Y-axis      > %%%%%%%%%%%%%%%%%%%%% <   > %%%%%%%% <> %%%%%%%% <         # LABEL_Y YMIN YMAX
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL WHAT = LINFIT_boxplot OR WHAT = NUMEPO_series ####################
# plotCCNRXC 5: Legend layout                                                  #
#                                                                              #
# LEGEND LAYOUT SPECIFICATION                                                  #
# > % <  Legend:                                                               # LEGEND
#        Position  > %%%%%%%%%%%% <  X-off > %%%%% <  Y-off > %%%%% <          # LEG_POS LEG_ANCHOR_X LEG_ANCHOR_Y
#        Frame     > % <             Num. Columns   > % <                      # LEG_FRAME LEG_NCOLS
#        Title     > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <          # LEG_TITLE
#                                                                              #
# END_PANEL ####################################################################
