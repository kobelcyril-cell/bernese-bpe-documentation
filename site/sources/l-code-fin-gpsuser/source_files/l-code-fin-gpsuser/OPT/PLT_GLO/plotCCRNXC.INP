
! Environment Variables
! ---------------------
ENVIRONMENT 1  "" "${}"
  ## widget = initmenu; pointer = ENVIR_LIST

! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 1  "./DUMMY"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${PAN}/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "1980"
  ## widget = comment
  # $Y+0

SES_INFO 1  "0060"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show general configuration"

! Satellite information
! ---------------------
SATELL 1  "${CONFIG}/$(SATINF)_$(PCV).SAT"
  ## widget = selwin; path = PTH_SATELL; ext = EXT_SATELL; maxfiles = 1
  ## emptyallowed = true
  # $(SATINF)_$(PCV)

DESCR_SATELL 1  "Satellite information"

! Select the content of the plot
! ------------------------------
WHAT 1  "LINFIT_matrix"
  ## widget = combobox; editable = false
  ## cards = NUMEPO_series NUMEPO_matrix LINFIT_matrix LINFIT_boxplot

MSG_WHAT 1  "Select the content of the plot"

! How to sort the satellites
! --------------------------
SORT 1  "PRN"
  ## widget = combobox; editable = false; cards = PRN SVN Plane
  ## activeif = WHAT == NUMEPO_matrix OR WHAT == LINFIT_matrix OR WHAT == LINFIT_boxplot

MSG_SORT 1  "Select the content of the plot"

! CCRNXC Program Output File Names (input)
! --------------------------------
CCRNXC 0
  ## widget = selwin; path = DIR_OUT; extList = EXT_OUT NO_EXT
  ## activeif = WHAT == NUMEPO_matrix OR WHAT == LINFIT_matrix
  # $(CCRNXC)_*

DESCR_CCRNXC 1  "List of CCRNXC output files"

NCCRNXC 1  "1"
  ## widget = spinbox; range = 1 10 1
  ## activeif = WHAT == NUMEPO_matrix OR WHAT == LINFIT_matrix

MSG_NCCRNXC 1  "Number of sequence in the file"

! CCRNXC Program Output File Names (reference)
! --------------------------------
CCRNXC_REF 0
  ## widget = selwin; path = DIR_OUT; extList = EXT_OUT NO_EXT
  ## emptyallowed = true
  ## activeif = WHAT == LINFIT_matrix OR WHAT == LINFIT_boxplot

DESCR_CCRNXC_REF 1  "List of CCRNXC output files"

NCCRNXC_REF 1  "$(NCCRNXC_REF)"
  ## widget = spinbox; range = 1 10 1
  ## activeif = WHAT == LINFIT_matrix OR WHAT == LINFIT_boxplot AND CCRNXC_REF / _

MSG_NCCRNXC_REF 1  "Number of sequence in the file"

! Filename for resulting plotz (output)
! -------------------------------------
FIGSHOW 1  "0"
  ## widget = checkbox

MSG_FIGSHOW 1  "Show resulting firgure on the screen"

FIGOUT 1  "./DUMMY/FIG/$(FIG)linRMS_30s_glo.eps"
  ## widget = lineedit; path = DIR_FIG; ext = NO_EXT; maxfiles = 1
  # $(FIG)linRMS_30s_glo.eps

DESCR_FIGOUT 1  "Output file for plot of number of epochs"

FIGRES 1  "600"
  ## widget = lineedit; check_type = integer; check_min = 50

DESCR_FIGRES 1  "Resolution of the figure"

! Title: new entry
! ----------------
TITLE 0
  ## widget = lineedit

MSG_TITLE 1  "Title line"

TIT_FONTSIZE 1  "large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_TIT_FONTSIZE 1  "Font size in the title"

! Size of the plot
! ----------------
SIZEX 1  "8"
  ## widget = lineedit; check_type = real

MSG_SIZEX 1  "Width of the plot"

SIZEY 1  "10"
  ## widget = lineedit; check_type = real

MSG_SIZEY 1  "Height of the plot"

! Define colormap
! ---------------
CMAP 1  "RdYlBu"
  ## widget = combobox; editable = false
  ## cards = MANUAL Accent Blues BrBG BuGn BuPu CMRmap Dark2 GnBu Greens Greys OrRd Oranges PRGn Paired Pastel1 Pastel2 PiYG PuBu PuBuGn PuOr PuRd Purples RdBu RdGy RdPu RdYlBu RdYlGn Reds Set1 Set2 Set3 Spectral Vega10 Vega20 Vega20b V

MSG_CMAP 1  "Select the colormap"

CMAP_MANUAL 1  "" ""
