
! Environment Variables
! ---------------------
ENVIRONMENT 1  "" "${}"
  ## widget = initmenu; pointer = ENVIR_LIST

! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 1  "./DUMMY"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${PAN}/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "1980"
  ## widget = comment
  # $Y+0

SES_INFO 1  "0060"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show general configuration"

! Filename for resulting plots (output)
! -------------------------------------
FIGSHOW 1  "0"
  ## widget = checkbox

MSG_FIGSHOW 1  "Show resulting firgure on the screen"

FIGOUT 1  "./DUMMY/FIG/$(FIG)GCCseries_rms.eps"
  ## widget = lineedit; path = DIR_FIG; ext = NO_EXT; maxfiles = 1
  # $(FIG)GCCseries_rms.eps

DESCR_FIGOUT 1  "Output file for plot of number of epochs"

FIGRES 1  "300"
  ## widget = lineedit; check_type = integer; check_min = 50

DESCR_FIGRES 1  "Resolution of the figure"

FIGTYPE 1  "time_series"
  ## widget = combobox
  ## cards = time_series amplitude_spectrum power_spectrum normPower_spectrum

DESCR_FIGTYPE 1  "Type of the figure"

PLOT_SIGMA 1  "sigmas"
  ## widget = combobox; cards = values sigmas

DESCR_PLOT_SIGMA 1  "Aspacts to plot"

! ADDNEQ2-output directly
! -----------------------
USE_GCCFIL 1  "1"
  ## widget = radiobutton; group = INPFIL

MSG_USE_GCCFIL 1  "Use values from Bernese formatted GCC files"

USE_OUTFIL 1  "0"
  ## widget = radiobutton; group = INPFIL

MSG_USE_OUTFIL 1  "Use values directly from ADDNEQ2 output"

OUTFIL_0 0
  ## widget = selwin; path = DIR_OUT; ext = EXT_OUT
  ## activeif = USE_OUTFIL = 1
  # 

DESCR_OUTFIL_0 1  "ADDNEQ program output files with several system-spec. estim."

! Input data: dataset 1
! ---------------------
GCCFIL_1 0
  ## widget = selwin; path = DIR_GCC; ext = EXT_GCC
  ## activeif = USE_OUTFIL = 0; emptyallowed = true
  # $(GCC)1d_*

DESCR_GCCFIL_1 1  "List of GCC files in Bernese format (dataset 1)"

OUTFIL_1 0
  ## widget = selwin; path = DIR_OUT; ext = EXT_OUT
  ## activeif = OUTFIL_0 = _ AND USE_OUTFIL = 1; emptyallowed = true
  # 

DESCR_OUTFIL_1 1  "ADDNEQ program output files (dataset 1)"

GCCSYS_1 0
  ## widget = combobox; cards = GPS GLO GAL SBS BDS QZS GEN
  ## activeif = OUTFIL_0 / _ OR OUTFIL_1 / _ AND USE_OUTFIL = 1

MSG_GCCSYS_1 1  "GNSS selection for system-spec. estimates"

COLOR_1 1  "green"
  ## widget = combobox; editable = true
  ## activeif = OUTFIL_0 / _ OR OUTFIL_1 / _ AND USE_OUTFIL = 1 OR GCCFIL_1 / _
  ## cards = red green blue yellow orange magenta cyan grey

MSG_COLOR_1 1  "Color for dataset 1"

SYMBOL_1 1  "circle"
  ## widget = combobox; editable = false
  ## activeif = OUTFIL_0 / _ OR OUTFIL_1 / _ AND USE_OUTFIL = 1 OR GCCFIL_1 / _
  ## cards = circle triangle_down triangle_up triangle_left triangle_right tri_down tri_up tri_left tri_right octagon square pentagon plus(filled) star hexagon1 hexagon2 plus x(filled) diamond thin_diamond

MSG_SYMBOL_1 1  "Symbol for dataset 1"

SSIZE_1 1  "3"
  ## widget = spinbox; range = 1 30 1
  ## activeif = OUTFIL_0 / _ OR OUTFIL_1 / _ AND USE_OUTFIL = 1 OR GCCFIL_1 / _

MSG_SSIZE_1 1  "Symbol size for dataset 1"

LABEL_1 1  "1day"
  ## widget = lineedit
  ## activeif = OUTFIL_0 / _ OR OUTFIL_1 / _ AND USE_OUTFIL = 1 OR GCCFIL_1 / _

MSG_LABEL_1 1  "Legend entry for dataset 1"

