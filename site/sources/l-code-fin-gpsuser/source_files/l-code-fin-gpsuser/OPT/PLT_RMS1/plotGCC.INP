# BEGIN_PANEL NO_CONDITION #####################################################
# PLOT AND ANALYSE GEOCENTER SERIES - plotGCC 1: Input/output files            #
#                                                                              #
# GENERAL CONFIGURATION                                                        #
#   Show general configuration        > % <                                    # SHOWGEN
#                                                                              #
# RESULT FILE                                                                  #
#   Show figure on the screen         > % <                                    # FIGSHOW
#   Name of the output file           > %%%%%%%%%%%%%%%%%%%%%%%% <             # FIGOUT
#                                       (extension defines the format)         #
#   Resolution of the figure          > %%%% < dpi                             # FIGRES
#                                                                              #
# TYPE OF PLOT:                       > %%%%%%%%%%%%%%%%%% <                   # FIGTYPE
#   Aspects to plot                   > %%%%%%%% <                             # PLOT_SIGMA
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# plotGCC 1.1: General Configuration                                           #
#                                                                              #
# FONT DEFITIONS                                                               #
#   Title                       > %%%%%%%%%%%% <                               # TIT_FONTSIZE
#   Labels                      > %%%%%%%%%%%% <                               # LABEL_FONTSIZE
#   Legend                      > %%%%%%%%%%%% <                               # LEG_FONTSIZE
#                                                                              #
# COLOR DEFITIONS                                                              #
#   Background color of the plot> %%%%%%%%%%%% <                               # BGCOLOR
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #########################################################
# PLOT GCC FILE CONTENT 2: Plot layout                                             #
#                                                                                  #
# PLOT LAYOUT SPECIFICATION                                                        #
#   Size of the plot:   width   > %%%%%%%%%% <    height     > %%%%%%%%%% <        # SIZEX SIZEY
#                                                                                  #
# PLOT AXIS SPECIFICATION                  Boundaries: > % < auto or               # XYAUTO
#              Labels at                                 Min           Max         #
#              epoch axis  > %%%%%%%%%%%%%%%%%%%%% <   > %%%%%%%%%% <> %%%%%%%%%% <# LABEL_X TMIN TMAX
#              frequency                               > %%%%%%%%%% <> %%%%%%%%%% <#         XMIN XMAX
#   Plot  > % <X-component > %%%%%%%%%%%%%%%%%%%%% <   > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_Y1 LABEL_Y1 Y1MIN Y1MAX
#         > % <Y-component > %%%%%%%%%%%%%%%%%%%%% <   > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_Y2 LABEL_Y2 Y2MIN Y2MAX
#         > % <Z-component > %%%%%%%%%%%%%%%%%%%%% <   > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_Y3 LABEL_Y3 Y3MIN Y3MAX
#                                                                                  #
# CONTENT OF THE PLOT                                                              #
#   Title > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # TITLE
#                                                                                  #
# END_PANEL ########################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotGCC 3: Time series for plotting                                          #
#                                                                              #
# > % < Use values from Bernese formatted GCC files                            # USE_GCCFIL
# > % < Use values directly from ADDNEQ2 output                                # USE_OUTFIL
#                                                                              #
#     Filename             color         symbol        size      label         #
# 1.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%% <    # GCCFIL_1 COLOR_1 SYMBOL_1 SSIZE_1 LABEL_1
# 2.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%% <    # GCCFIL_2 COLOR_2 SYMBOL_2 SSIZE_2 LABEL_2
# 3.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%% <    # GCCFIL_3 COLOR_3 SYMBOL_3 SSIZE_3 LABEL_3
# 4.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%% <    # GCCFIL_4 COLOR_4 SYMBOL_4 SSIZE_4 LABEL_4
# 5.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%% <    # GCCFIL_5 COLOR_5 SYMBOL_5 SSIZE_5 LABEL_5
# 6.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%% <    # GCCFIL_6 COLOR_6 SYMBOL_6 SSIZE_6 LABEL_6
#                                                                              #
#     Filename          GNSS-sepc.            Filename          GNSS-sepc.     #
#   > %%%%%%%%%%%% <     (one for several system-sep. estimates)               # OUTFIL_0
# 1.> %%%%%%%%%%%% <     > %%% <          4.> %%%%%%%%%%%% <     > %%% <       # OUTFIL_1 GCCSYS_1 OUTFIL_4 GCCSYS_4
# 2.> %%%%%%%%%%%% <     > %%% <          5.> %%%%%%%%%%%% <     > %%% <       # OUTFIL_2 GCCSYS_2 OUTFIL_5 GCCSYS_5
# 3.> %%%%%%%%%%%% <     > %%% <          6.> %%%%%%%%%%%% <     > %%% <       # OUTFIL_3 GCCSYS_3 OUTFIL_6 GCCSYS_6
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotGCC 4: Legend layout                                                     #
#                                                                              #
# LEGEND LAYOUT SPECIFICATION                                                  #
# > % <  Legend:                                                               # LEGEND
#        Position  > %%%%%%%%%%%% <  X-off > %%%%% <  Y-off > %%%%% <          # LEG_POS LEG_ANCHOR_X LEG_ANCHOR_Y
#                    with respect to plot  > %%%%% <  component                # LEG_PLOT
#        Frame     > % <             Num. Columns   > % <                      # LEG_FRAME LEG_NCOLS
#        Title     > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <          # LEG_TITLE
#                                                                              #
# END_PANEL ####################################################################
