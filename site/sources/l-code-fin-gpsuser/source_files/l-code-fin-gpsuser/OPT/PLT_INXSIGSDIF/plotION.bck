
! Environment Variables
! ---------------------
ENVIRONMENT 0
  ## widget = initmenu; pointer = ENVIR_LIST

! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 0
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 0
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "$Y+0"
  ## widget = comment

SES_INFO 1  "$S+0"
  ## widget = comment

USR_INFO 1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show general configuration"

! Ionosphere map file (input)
! ---------------------------
INXINP 1  "$(INXDIF)rap_?????"
  ## widget = selwin; path = DIR_INX; ext = EXT_INX

DESCR_INXINP 1  "Input IONEX file"

INXINP_REF 1  "$(INXDIF)fin_?????"
  ## widget = selwin; path = DIR_INX; ext = EXT_INX; emptyallowed = true

DESCR_INXINP_REF 1  "Reference IONEX file when plotting differences"

SELECTION 1  "ALL"
  ## widget = combobox; cards = ALL FIRST LAST MANUAL; editable = false

MSG_SELECTION 1  "What entries to use from the IONEX file (1 2 ... )"

MANUAL_SELECTION 1  ""
  ## widget = lineedit; activeif = SELECTION = MANUAL

MSG_MANUAL_SELECTION 1  "Manual selection of time stamps (list of integers)"

STATIS 1  "multiple_maps"
  ## widget = combobox; editable = false
  ## cards = multiple_maps mean median stddev iqr min max

MSG_STATIS 1  "Plot content if multiple maps are selected"

FIGTYPE 1  "sigmas"
  ## widget = combobox; cards = values sigmas

MSG_FIGTYPE 1  "Aspacts to plot"

! -------------------------------------
FIGSHOW 1  "0"
  ## widget = checkbox

MSG_FIGSHOW 1  "Show resulting figure on the screen"

FIGOUT 1  "inxSig_days_DiffRapFin_$(num).eps"
  ## widget = lineedit; path = DIR_FIG; ext = NO_EXT; keepvariables = true

MSG_FIGOUT 1  "Output file for figure"

MAKE_GIF 1  "1"
  ## widget = checkbox

MSG_MAKE_GIF 1  "Additionally create a GIF animation if multiple time steps are plotted"

GIF_FPS 1  "5"
  ## widget = lineedit; check_type = integer; check_min = 1

MSG_GIF_FPS 1  "Frames per second for GIF animation"

GIFOUT 1  "inxSig_days_DiffRapFin.gif"
  ## widget = lineedit; path = DIR_FIG; activeif = MAKE_GIF = 1

MSG_GIFOUT 1  "Output file for GIF animation"

FIGOUT_VAR 1  "num"
  ## widget = lineedit; keepvariables = true

MSG_FIGOUT_VAR 1  "Variable part in case of multiple output files"

FIGRES 1  "600"
  ## widget = lineedit; check_type = integer; check_min = 50

MSG_FIGRES 1  "Resolution of the figure"

! Title: new entry
! ----------------
TITLE 1  "Differences RMS for CODE Ionosphere map (rapid-final) for $(datime)"
  ## widget = lineedit

MSG_TITLE 1  "Title line"

TITLE_VAR 1  "datime"
  ## widget = lineedit; keepvariables = true; activeif = TITLE / _

MSG_TITLE_VAR 1  "Variable plotted in the title"

TITLE_REPL 1  "%Y-%m-%d %H:%M"
  ## widget = combobox; cards = %Y-%m-%d-%H:%M %m-%d-%H:%M %d-%H:%M %H:%M
  ## activeif = TITLE_VAR / _ AND TITLE / _

MSG_TITLE_REPL 1  "Replacement format for variable in title"

TIT_KEEP_DAY 1  "0"
  ## widget = checkbox; activeif = TITLE_VAR / _AND TITLE / _

MSG_TIT_KEEP_DAY 1  "Keep day part in title constant, hours > 24"

TIT_FONTSIZE 1  "large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_TIT_FONTSIZE 1  "Font size in the title"

BGCOLOR 1  "white"
  ## widget = combobox; editable = true
  ## cards = white red green blue yellow orange magenta cyan grey

MSG_BGCOLOR 1  "Plot background color"

! Size of the plot
! ----------------
SIZEX 1  "12"
  ## widget = lineedit; check_type = real

MSG_SIZEX 1  "Width of the plot"

SIZEY 1  "8"
  ## widget = lineedit; check_type = real

MSG_SIZEY 1  "Height of the plot"

! Get boundaries of the plot
! --------------------------
XYAUTO 1  "1"
  ## widget = checkbox

MSG_XYAUTO 1  "Auto scale to a global map"

XMIN 1  ""
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_XMIN 1  "Latitude of the lower left corner"

YMIN 1  ""
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_YMIN 1  "Longitude of the lower left corner"

XMAX 1  ""
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_XMAX 1  "Latitude of the upper right corner"

YMAX 1  ""
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_YMAX 1  "Longitude of the upper right corner"

! Layout of the map
! -----------------
MMAPSTYLE 1  "Relief"
  ## widget = combobox; cards = Simple Relief

MSG_MMAPSTYLE 1  "Style of the map"

MAPRESOL 1  "low"
  ## widget = combobox; cards = crude low intermediate high full

MSG_MAPRESOL 1  "Resolution of the map"

MAPCOCN 1  "#99ffff"
  ## widget = combobox; editable = true; activeif = MMAPSTYLE = Simple
  ## cards = aqua red green blue yellow orange magenta cyan grey

MSG_MAPCOCN 1  "Color of the ocean in the simple mode"

MAPCLAND 1  "#cc9966"
  ## widget = combobox; editable = true; activeif = MMAPSTYLE = Simple
  ## cards = coral red green blue yellow orange magenta cyan grey

MSG_MAPCLAND 1  "Color of the land in the simple mode"

! Map projection
! --------------
MAPPROJ 1  "Robinson"
  ## widget = combobox
  ## cards = PlateCarree AlbersEqualArea AzimuthalEquidistant LambertConformal Mercator Miller Mollweide Orthographic Robinson Sinusoidal Stereographic TransverseMercator InterruptedGoodeHomolosine NearsidePerspective LambertAzimuthalEqualArea NorthPolarStereo SouthPolarStereo Gnomonic

!  ## cards = Cylindrical_Equal_Area McBryde-Thomas_Flat-Polar_Quartic Azimuthal_Equidistant Sinusoidal Polyconic Gnomonic Mollweide Transverse_Mercator Gall_Stereographic_Cylindrical Miller_Cylindrical Rotated_Pole Cylindrical_Equidistant Hammer Geostatio
MSG_MAPPROJ 1  "Map projection"

MAPPLAT 1  "0.0"
  ## widget = lineedit; check_type = real

MSG_MAPPLAT 1  "Latitude for projection point"

MAPPLON 1  "0.0"
  ## widget = lineedit; check_type = real

MSG_MAPPLON 1  "Longitude for projection point"

! Define colormap
! ---------------
CMAP 1  "Reds"
  ## widget = combobox; editable = true
  ## cards = MANUAL Accent Blues BrBG BuGn BuPu CMRmap Dark2 GnBu Greens Greys OrRd Oranges PRGn Paired Pastel1 Pastel2 PiYG PuBu PuBuGn PuOr PuRd Purples RdBu RdGy RdPu RdYlBu RdYlGn Reds Set1 Set2 Set3 Spectral Vega10 Vega20 Vega20b Vega20c

MSG_CMAP 1  "Select the colormap"

CMAP_MANUAL 1  "" ""
  ## widget = uniline; activeif = CMAP = MANUAL; numlines = 5
  ## check_type.1 = real; check_min.1 = 0; check_max.1 = 1

MSG_CMAP_MANUAL 1  "Create an user defined color map"

CREVERSE 1  "0"
  ## widget = checkbox

MSG_CREVERSE 1  "Reverse the colormap"

CMIN 1  ""
  ## widget = lineedit; check_type = real

MSG_CMIN 1  "Minimum value for colormap"

CMAX 1  ""
  ## widget = lineedit; check_type = real

MSG_CMAX 1  "Maximum value for colormap"

GLOBAL_CBAR 1  "1"
  ## widget = checkbox

MSG_GLOBAL_CBAR 1  "Use a global colorbar for all time steps"

CLABEL 1  "dRMS in TECU"
  ## widget = lineedit

MSG_CLABEL 1  "Label for colormap"

LABEL_FONTSIZE 1  "large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_LABEL_FONTSIZE 1  "Font size in the labels"

! Specify the legend characteristics
! ----------------------------------
LEGEND 1  "0"
  ## widget = checkbox

MSG_LEGEND 1  "Plot a legend"

LEG_POS 1  "lower/center"
  ## widget = combobox; activeif = LEGEND = 1
  ## cards = right center/left upper/right lower/right best center lower/left center/right upper/left upper/center lower/center

MSG_LEG_POS 1  "Position of the legend"

LEG_ANCHOR_X 0
  ## widget = lineedit; activeif = LEGEND = 1; check_type = real

MSG_LEG_ANCHOR_X 1  "Anchor point for legend position"

LEG_ANCHOR_Y 0
  ## widget = lineedit; activeif = LEGEND = 1; check_type = real

MSG_LEG_ANCHOR_Y 1  "Anchor point for legend position"

LEG_NCOLS 1  "1"
  ## widget = spinbox; activeif = LEGEND = 1; range = 1 10 1

MSG_LEG_NCOLS 1  "Position of the legend"

LEG_FRAME 1  "1"
  ## widget = checkbox; activeif = LEGEND = 1

MSG_LEG_FRAME 1  "Plot a legend with a frame"

LEG_TITLE 0
  ## widget = lineedit; activeif = LEGEND = 1

MSG_LEG_TITLE 1  "Title of the legend"

LEG_FONTSIZE 1  "x-large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_LEG_FONTSIZE 1  "Font size in the legend"

KEY_WITH_VAR 2
  "TITLE"
  "FIGOUT"


# BEGIN_PANEL NO_CONDITION #####################################################
# PLOT IONOSPHERIC TEC MAP FROM INX FILES - plotION 1: Input/output files      #
#                                                                              #
# GENERAL CONFIGURATION                                                        #
#   Show general configuration          > % <                                  # SHOWGEN
#                                                                              #
# INPUT FILES                                                                  #
#   Ionosphere mpas files               > %%%%%%%% <                           # INXINP
#   Reference maps for plotting diff.   > %%%%%%%% <                           # INXINP_REF
#                                                                              #
# RESULT FILE                                                                  #
#   Show figure on the screen           > % <                                  # FIGSHOW
#   Name of the output file(s)          > %%%%%%%%%%%%%%%%%%%%%%%% <           # FIGOUT
#                                         (extension defines the format)       #
#   Variable in output file name        > %%%%% <  (replaced by model number)  # FIGOUT_VAR
#                                                                              #
#   Resolution of the figure            > %%%%% < dpi                          # FIGRES
#                                                                              #
#   > % <  Create GIF animation (when multiple plots are generated)            # MAKE_GIF
#          Frames per second for GIF    > %%%%% <                              # GIF_FPS
#          Name of the output GIF file  > %%%%%%%%%%%%%%%%%%%%%%%% <           # GIFOUT
#                                         (extension defines the format)       #
#                                                                              #
#  ASPECTS TO PLOT                      > %%%%%%%% <                           # FIGTYPE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# plotION 1.1: General Configuration                                           #
#                                                                              #
# FONT DEFINITIONS                                                             #
#   Title                       > %%%%%%%%%%%% <                               # TIT_FONTSIZE
#   Labels                      > %%%%%%%%%%%% <                               # LABEL_FONTSIZE
#   Legend                      > %%%%%%%%%%%% <                               # LEG_FONTSIZE
#                                                                              #
# COLOR DEFINITIONS                                                            #
#   Background color of the plot> %%%%%%%%%%%% <                               # BGCOLOR
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotION 2: Time stamps to be used                                            #
#                                                                              #
# SELECTION OF IONOSSPHERE MAPS TO BE EXTRACTED FROM IONEX                     #
#   What portion of the IONEX file to use      > %%%%%%% <                     # SELECTION
#   Manual selection of indices to use         > %%%%%%%%%%%%%% <              # MANUAL_SELECTION
#                                                                              #
#   If multiple maps are selected              > %%%%%%%%%%%%%% <              # STATIS
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotION 3: Plot Layout                                                       #
#                                                                              #
# CONTENT OF THE MAP                                                           #
#   Title > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#   Variable in title           > %%%%% <                                      # TITLE_VAR
#   Replacement format for      > %%%%%%%%%%%%% <                              # TITLE_REPL
#   Allow hours larger than 24  > % <                                          # TIT_KEEP_DAY
#                                                                              #
# COLOR MAP LAYOUT                                                             #
#   Define color map            > %%%%%%%%%%%%%%%%%%%% <   > % < reverse       # CMAP CREVERSE
#      Range of values      min > %%%%% <  max > %%%%% <                       # CMIN CMAX
#      Label for colormap       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <    # CLABEL
#      Global colorbar          > % <      (when multiple plots are generated) # GLOBAL_CBAR
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL CMAP = MANUAL ####################################################
# plotION 3.1: Manual setup of the color map                                   #
#                                                                              #
# Create an user defined colormap                                              #
# > value__ color_______ <         define colors for 0.0 and 1.0               # CMAP_MANUAL
#                                  additional value/color combinations         #
#                                    may be added inbetween                    #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotION 4: Map layout                                                        #
#                                                                              #
# MAP LAYOUT SPECIFICATION                                                     #
#   Size of the plot:      width   > %%%%%%%%%% < height     > %%%%%%%%%% <    # SIZEX SIZEY
#                                                                              #
#   Map resolution:                > %%%%%%% <                                 # MAPRESOL
#                                                                              #
#   Projection:                    > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # MAPPROJ
#        projection point     lat. > %%%%%%%%%% < longitude  > %%%%%%%%%% <    # MAPPLAT MAPPLON
#                                                                              #
#   Boundaries: > % < auto or        latitude                  longitude       # XYAUTO
#                     lower left   > %%%%%%%%%% <            > %%%%%%%%%% <    # XMIN YMIN
#                     upper right  > %%%%%%%%%% <            > %%%%%%%%%% <    # XMAX YMAX
#                                                                              #
# END_PANEL ####################################################################
