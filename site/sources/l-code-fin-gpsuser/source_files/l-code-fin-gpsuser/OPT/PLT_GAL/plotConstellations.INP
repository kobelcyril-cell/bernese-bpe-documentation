
! Environment Variables
! ---------------------
ENVIRONMENT 1  "" "${}"
  ## widget = initmenu; pointer = ENVIR_LIST

! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 1  "./DUMMY"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${PAN}/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "1980"
  ## widget = comment
  # $Y+0

SES_INFO 1  "0060"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show general configuration"

! Filename for resulting plots (output)
! -------------------------------------
FIGSHOW 1  "0"
  ## widget = checkbox

MSG_FIGSHOW 1  "Show resulting firgure on the screen"

FIGOUT 1  "./DUMMY/FIG/$(FIG)plane_GAL.eps"
  ## widget = lineedit; path = DIR_FIG; ext = NO_EXT; maxfiles = 1
  # $(FIG)plane_GAL.eps

DESCR_FIGOUT 1  "Output file for plot of number of epochs"

FIGRES 1  "600"
  ## widget = lineedit; check_type = integer; check_min = 50

DESCR_FIGRES 1  "Resolution of the figure"

! Satellite information
! ---------------------
SATELL 1  "${CONFIG}/$(SATINF)_$(PCV).SAT"
  ## widget = selwin; path = PTH_SATELL; ext = EXT_SATELL; maxfiles = 1
  ## emptyallowed = true
  # $(SATINF)_$(PCV)

DESCR_SATELL 1  "Satellite information"

! Coordinate File Names (input)
! -----------------------------
ELEFIL 1  "./DUMMY/ORB/$(SATCONST).ELE"
  ## widget = selwin; path = DIR_ELE; ext = EXT_ELE
  # $(SATCONST)

DESCR_CCRNXC 1  "List of CCRNXC output files"

! Plotting options for GPS
! ------------------------
USE_GPS 1  "0"
  ## widget = radiobutton; group = SYSTEM

MSG_USE_GPS 1  "Include stations tracked GPS"

! Plotting options for GLONASS
! ----------------------------
USE_GLO 1  "0"
  ## widget = radiobutton; group = SYSTEM

MSG_USE_GLO 1  "Include stations tracked GLONASS"

! Plotting options for Galileo
! ----------------------------
USE_GAL 1  "1"
  ## widget = radiobutton; group = SYSTEM

MSG_USE_GAL 1  "Include stations tracked Galileo"

! Plotting options for SBAS
! -------------------------
USE_SBS 1  "0"
  ## widget = radiobutton; group = SYSTEM

MSG_USE_SBS 1  "Include stations tracked SBAS"

! Plotting options for BeiDou
! ---------------------------
USE_BDS 1  "0"
  ## widget = radiobutton; group = SYSTEM

MSG_USE_BDS 1  "Include stations tracked BeiDou"

! Plotting options for QZSS
! -------------------------
USE_QZS 1  "0"
  ## widget = radiobutton; group = SYSTEM

MSG_USE_QZS 1  "Include stations tracked QZSS"

