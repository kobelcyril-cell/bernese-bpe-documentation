# BEGIN_PANEL NO_CONDITION #####################################################
# PLOT HELMERT-TRANSFORMATION RESULTS - plotHELMR1 1: Input/output files       #
#                                                                              #
# INPUT FILES                                                                  #
#   Input ELE files                   > %%%%%%%% <                             # ELEFIL
#                                                                              #
# RESULT FILE                                                                  #
#   Show figure on the screen         > % <                                    # FIGSHOW
#   Name of the output file           > %%%%%%%%%%%%%%%%%%%%%%%% <             # FIGOUT
#                                       (extension defines the format)         #
#   Resolution of the figure          > %%%% < dpi                             # FIGRES
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# plotHELMR1 1.1: General Configuration                                        #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   Satellite information        > %%%%%%%%%%%% <                              # SATELL
#                                                                              #
# FONT DEFITIONS                                                               #
#   Title                        > %%%%%%%%%%%% <                              # TIT_FONTSIZE
#   Labels                       > %%%%%%%%%%%% <                              # LABEL_FONTSIZE
#   Legend                       > %%%%%%%%%%%% <                              # LEG_FONTSIZE
#                                                                              #
# COLOR DEFITIONS                                                              #
#   Background color of the plot> %%%%%%%%%%%% <                               # BGCOLOR
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotSatnum 2: Plot layout                                                    #
#                                                                              #
# CONTENT OF THE PLOT                                                          #
#   Title > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#                                                                              #
#   Include satellite system                                                   #
#      > % <  GPS              > % <  GLONASS          > % <  Galileo          # USE_GPS USE_GLO USE_GAL
#      > % <  SBAS             > % <  BeiDou           > % <  QZSS             # USE_SBS USE_BDS USE_QZS
#                                                                              #
# PLOT LAYOUT SPECIFICATION                                                    #
#   Size of the plot:   width   > %%%%%%%%%% <    height     > %%%%%%%%%% <    # SIZEX SIZEY
#                                                                              #
#   Boundaries: > % < auto or            epoch axis             data axis      # XYAUTO
#                          lower bound  > %%%%%%%%%% <        > %%%%%%%% <     # XMIN YMIN
#                          upper bound  > %%%%%%%%%% <        > %%%%%%%% <     # XMAX YMAX
#                                        (yyyy mm dd)                          #
#                                                                              #
#   Labels at  epoch axis  > %%%%%%%%%%%%%%%%%%%%% <                           # LABEL_X
#              data  axis  > %%%%%%%%%%%%%%%%%%%%% <                           # LABEL_Y
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #########################################################
# plotHELMR1 3: Time series for plotting                                           #
#                                                                                  #
#     Satellite type       color         symbol        size      label             #
# 1.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_1  COLOR_1  SYMBOL_1  SSIZE_1  LABEL_1
# 2.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_2  COLOR_2  SYMBOL_2  SSIZE_2  LABEL_2
# 3.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_3  COLOR_3  SYMBOL_3  SSIZE_3  LABEL_3
# 4.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_4  COLOR_4  SYMBOL_4  SSIZE_4  LABEL_4
# 5.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_5  COLOR_5  SYMBOL_5  SSIZE_5  LABEL_5
# 6.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_6  COLOR_6  SYMBOL_6  SSIZE_6  LABEL_6
# 7.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_7  COLOR_7  SYMBOL_7  SSIZE_7  LABEL_7
# 8.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_8  COLOR_8  SYMBOL_8  SSIZE_8  LABEL_8
# 9.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_9  COLOR_9  SYMBOL_9  SSIZE_9  LABEL_9
#10.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_10 COLOR_10 SYMBOL_10 SSIZE_10 LABEL_10
#11.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_11 COLOR_11 SYMBOL_11 SSIZE_11 LABEL_11
#12.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# BLOCK_12 COLOR_12 SYMBOL_12 SSIZE_12 LABEL_12
#                                                                                  #
# END_PANEL ########################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotHELMR1 4: Legend layout                                                  #
#                                                                              #
# LEGEND LAYOUT SPECIFICATION                                                  #
# > % <  Legend:                                                               # LEGEND
#        Position  > %%%%%%%%%%%% <  X-off > %%%%% <  Y-off > %%%%% <          # LEG_POS LEG_ANCHOR_X LEG_ANCHOR_Y
#                    with respect to plot  > %%%%% <  component                # LEG_PLOT
#        Frame     > % <             Num. Columns   > % <                      # LEG_FRAME LEG_NCOLS
#        Title     > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <          # LEG_TITLE
#                                                                              #
# END_PANEL ####################################################################
