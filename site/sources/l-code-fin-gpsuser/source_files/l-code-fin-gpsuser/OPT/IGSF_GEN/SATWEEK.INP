
! -------------------------------------------------------------------------
! Bernese GPS Software Version 5.0
!
! Input Panel: Generate satellite summary
!
! Program: SATWEEK
!
! Created:
!
! Copyright: Astronomical Institute
! University of Berne
! Switzerland
! -------------------------------------------------------------------------
! Environment Variables
! ---------------------
ENVIRONMENT 13
  "P" "/storage/research/aiub_code"
  "Q" "/storage/research/aiub_code"
  "K" "/storage/research/aiub_u_camp"
  "X" "/storage/research/aiub_data/BSWsoftware/BERN/GPS"
  "U" "/storage/homefs/l_code/GPSUSER"
  "S" "/storage/research/aiub_data/PRODUCTS"
  "G" "/storage/research/aiub_u_camp"
  "R" "/storage/scratch/aiub/camp"
  "USER" "l_code"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  ## widget = initmenu; pointer = ENVIR_LIST

! SOME KEYWORDS FOR AUTOMATIC OUTPUT
! ----------------------------------
CAMPAIGN 1  "${P}/EPNFINAL"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${P}/EPNFINAL/GEN/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2023"
  ## widget = comment
  # $Y+0

SES_INFO 1  "3640"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! -------------------------------------------------------------------------
! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

! General Constants
! -----------------
CONST 1  "${MODEL}/CONST.BSW"
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1
  # CONST

DESCR_CONST 1  "General constants"

! Satellite Information
! ---------------------
SATELL 1  "${CONFIG}/SAT_1452_I05.SAT"
  ## widget = selwin; path = PTH_SATELL; ext = EXT_SATELL; maxfiles = 1
  # $(SATINF)_$(PCV)

DESCR_SATELL 1  "Satellite information"

! Satellite Problems
! ------------------
SATCRUX 1  "${CONFIG}/$(SATCRX)_2023.CRX"
  ## widget = selwin; path = PTH_SATCRUX; ext = EXT_SATCRUX; maxfiles = 1
  # $(SATCRX)_$Y+0

DESCR_SATCRUX 1  "Satellite problems"

! Repositioning list file
! -----------------------
REPOSITIONING 1  "${P}/EPNFINAL/OUT/REPOSITIONING.LST"
  ## widget = selwin; path = DIR_LST; ext = EXT_LST; maxfiles = 1
  ## emptyallowed = true
  # REPOSITIONING

DESCR_REPOSITIONING 1  "Repositioning list file"

! Summary file
! ------------
SUMMARY 1  "${P}/EPNFINAL/OUT/SATWEEK.SUM"
  ## widget = lineedit; path = DIR_SUM; ext = EXT_SUM; maxfiles = 1
  # SATWEEK

DESCR_SUMMARY 1  "Summary file"

! Program Output File
! -------------------
SYSODEF 1  "0"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "${P}/EPNFINAL/OUT/SATWEEK.OUT"
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false
  # SATWEEK

DESCR_SYSOUT 1  "Program output"

! Error Message File
! ------------------
ERRMRG 1  "1"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 0
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false
  # ERROR

DESCR_SYSERR 1  "Error messages"

! Title
! -----
TITLE 1  "IGSFIN3D_233640_2294: Checking SAT_2023.CRX maneuver epochs"
  ## widget = lineedit
  # IGSFIN3D_$YSS+0_$W+0: Checking SAT_$Y+0.CRX maneuver epochs

MSG_TITLE 1  "Specify a title"

! GPS Week
! --------
GPSWEEK 1  "2294"
  ## widget = lineedit; emptyallowed = false; check_type = integer
  # $W+0

MSG_GPSWEEK 1  "GPS week"

! GNSS selection
! --------------------------
! GPS
USE_G 1  "1"
  ## widget = checkbox

MSG_USE_G 1  "Use GPS"

! GLONASS
USE_R 1  "1"
  ## widget = checkbox

MSG_USE_R 1  "Use GLONASS"

! Galileo
USE_E 1  "1"
  ## widget = checkbox

MSG_USE_E 1  "Use Galileo"

! SBAS
USE_S 1  "0"
  ## widget = checkbox

MSG_USE_S 1  "Use SBAS"

! BeiDou
USE_C 1  "0"
  ## widget = checkbox

MSG_USE_C 1  "Use BeiDou"

! QZSS
USE_J 1  "0"
  ## widget = checkbox

MSG_USE_J 1  "Use QZSS"


# BEGIN_PANEL NO_CONDITION #####################################################
# WEEKLY SATELLITE SUMMARY - SATWEEK 1: Filenames                              #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files> % <                                                # SHOWGEN
#                                                                              #
# OPTIONS                                                                      #
#   Title  > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <# TITLE
#   GPS Week                    > %%%% < (0: checking of the entire SAT.CRX)   # GPSWEEK
#                                                                              #
# ADDITIONAL INFORMATION                                                       #
#   Repositioning list file     > %%%%%%%%%%%%%%%% <                           # REPOSITIONING
#                                                                              #
# OUTPUT FILE                                                                  #
#   Summary file                > %%%%%%%%%%%%%%%% <                           # SUMMARY
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output              > % < use SATWEEK.Lnn          or > %%%%%%%% < # SYSODEF SYSOUT
#   Error messages              > % < merged to program output or > %%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# SATWEEK 1.1: General Files                                                   #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants           > %%%%%%%%%%%% <                               # CONST
#   Satellite information       > %%%%%%%%%%%% <                               # SATELL
#   Satellite problems          > %%%%%%%% <                                   # SATCRUX
#                                                                              #
# GNSS SELECTION FOR COMPUTATION OF SYSTEM TIME DIFFERENCE                     #
#          > % < GPS            > % < GLONASS        > % < Galileo             # USE_G USE_R USE_E
#          > % < SBAS           > % < BeiDou         > % < QZSS                # USE_S USE_C USE_J
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <# CAMPAIGN
#   Selected session              year> %%%% <  session> %%%% <                # YR4_INFO SES_INFO
#   Session table               > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <# SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################
