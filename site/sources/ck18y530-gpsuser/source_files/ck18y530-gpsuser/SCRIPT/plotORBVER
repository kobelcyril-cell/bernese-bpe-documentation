package plotORBVER;
@ISA = ("RUNBPE");

use strict;

sub run {
  my $bpe = shift;
  my ($out,$fig,$figname,$vPre) = $bpe->getKeys('DIR_OUT','DIR_FIG','V_ORBVER','V_PRE');

  die "DIR_FIG is not configured\n"
    unless defined($fig) && length($fig);
  die "V_PRE is not defined\n" unless defined $vPre;

  my $python = 'python3';
  my $plotDir = "$ENV{HOME}/ZDGNSS_RUN/python/validation_plot";

  my @command = (
    "$plotDir/plot_orb_ver.py",
    '--out-dir', $out,
    "--prefix=$vPre",
    '--output', "$fig/orb_ver_$figname"
  );

  my $status = system($python, @command);

  die "Cannot start $python: $!\n" if $status == -1;
  die "Validation plot failed (status $status)\n" if $status != 0;
}
