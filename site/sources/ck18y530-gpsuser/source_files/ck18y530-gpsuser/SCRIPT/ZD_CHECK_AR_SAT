package CHECK_AR_SAT;
@ISA = ("RUNBPE");
#===========================================================
#
# Name    : CHECK_AR_SAT
#
# Purpose : Check whether ambiguity resolution failed for a
#           satellite or whether degraded satellites require
#           an AR exclusion in SATCRX.
#
# Author  : C. Kobel
# Created :
#
# Changes : 12-Aug-2026 CK: Check PHACOR_LOG for degraded
#                           satellites with insufficient
#                           observations
#
#           13-Aug-2026 CK: If multiple satellites are
#                           DEGRADED, additionally select
#                           the satellites with the largest
#                           MEDIAN and MAX values
#
#           13-Aug-2026 CK: Archive PHACOR_LOG as ITERx
#                           before processing AR exclusions
#
#           13-Aug-2026 CK: Maximum of 3 PHACOR iterations.
#                           After ITER3, further required
#                           exclusions result only in a
#                           warning. No SATCRX entry and no jump
#                           back are performed.
#
#===========================================================

use strict;
use warnings;

use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use File::Basename qw(basename);
use File::Spec;


sub _write_satcrx_ar_entry {

    my ($dirCrx, $satcrx, $extCrx, $date, $prn) = @_;

    die "SATCRX name is missing (getKeys V_SATCRX)\n"
        unless defined $satcrx && length $satcrx;
    die "SATCRX directory or extension is missing (getKeys DIR_CRX, EXT_CRX)\n"
        unless defined $dirCrx && length $dirCrx
            && defined $extCrx && length $extCrx;

    my ($year, $month, $day);
    if (defined $date && $date =~ /^\s*(\d{4})[-\s]?(\d\d)[-\s]?(\d\d)\s*$/) {
        ($year, $month, $day) = ($1, $2, $3);
    }
    die "Cannot parse current date for SATCRX 5 5 entry: '$date'\n"
        unless defined $year && defined $month && defined $day;

    my $name = basename($satcrx);
    my $extension = $extCrx;
    $extension =~ s/^\.//;
    $name =~ s/\.\Q$extension\E\z//i;
    $name .= "." . $extension;
    my $satcrx_file = File::Spec->catfile($dirCrx, $name);
    my $new_date = "$year$month$day";
    my $new_line = sprintf("%5d         5         5       %4d %02d %02d 00 00 00\n",
        $prn, $year, $month, $day);

    open my $in, '<', $satcrx_file
        or die "Cannot read SATCRX file $satcrx_file: $!\n";
    my @lines = <$in>;
    close $in or die "Cannot close SATCRX file $satcrx_file after reading: $!\n";

    for my $line (@lines) {
        if ($line =~ /^\s*\Q$prn\E\s+5\s+0\s+(\d{4})\s+(\d\d)\s+(\d\d)\b/) {
            return ($satcrx_file, 0)
                if "$1$2$3" eq $new_date;
        }
    }

    # Add 5 0 events in date order relative to the dated 4 0 / 5 0 entries.
    my ($insert_at, $first_event_at);
    for (my $i = $#lines; $i >= 0; --$i) {
        if ($lines[$i] =~ /^\s*-?\d+\s+[45]\s+0\s+(\d{4})\s+(\d\d)\s+(\d\d)\b/) {
            $first_event_at = $i;
            my $old_date = "$1$2$3";
            if ($old_date le $new_date) {
                $insert_at = $i + 1;
                last;
            }
        }
    }
    $insert_at = defined($first_event_at) ? $first_event_at : scalar @lines
        unless defined $insert_at;
    splice @lines, $insert_at, 0, $new_line;

    if (@lines && $lines[-1] !~ /[\r\n]\z/) {
        $lines[-1] .= "\n";
    }
    open my $out, '>', $satcrx_file
        or die "Cannot rewrite SATCRX file $satcrx_file: $!\n";
    print {$out} @lines or die "Cannot write SATCRX file $satcrx_file: $!\n";
    close $out or die "Cannot close SATCRX file $satcrx_file: $!\n";

    return ($satcrx_file, 1);
}


sub run {

    my $bpe = shift;

    # =========================================================
    # Get parameters
    # =========================================================

    my (
        $dirOut,
        $param2,
        $yyddd,
        $ssss,
	$yyssss,
        $satcrx,
        $dirCrx,
        $extCrx,
        $dateYmd
    ) = $bpe->getKeys(
        'DIR_OUT',
        'PARAM2',
        '$YD+0',
        '$S+0',
	'$YSS+0',
        'V_SATCRX',
        'PTH_SATCRUX',
        'EXT_SATCRUX',
        '$YMD_STR+0'
    );

    my $mscDir = "${dirOut}/../MSC/MSC_${yyddd}";

    # Maximum number of PHACOR iterations
    my $MAX_ITERATIONS = 3;


    # =========================================================
    # Ensure MSC directory exists
    # =========================================================

    unless (-d $mscDir) {

        mkdir $mscDir
            or die "Cannot create directory $mscDir: $!";
    }


    # =========================================================
    # Open PROCESSING log
    # =========================================================

    my $logfile = "$mscDir/PROCESSING_${yyddd}";

    open(my $LOG, '>>', $logfile)
        or die "Cannot open log file $logfile: $!";

    print $LOG "\n=== CHECK_AR_SAT started ===\n";


    # =========================================================
    # Check 1:
    #
    # affected_satellite_AR
    # =========================================================

    my $ar_file = "$mscDir/affected_satellite_AR";

    if (-e $ar_file) {

        open(my $AR, '<', $ar_file)
            or die "Cannot open $ar_file: $!";

        my $prn;

        while (my $line = <$AR>) {

            if ($line =~ /Affected satellite:\s*(\d+)/i) {

                $prn = $1;
                last;
            }
        }

        close($AR);


        if (defined $prn) {

            print $LOG
                "Problem with ambiguity resolution: "
                . "affected satellite detected: $prn\n";


            # -------------------------------------------------
            # Delete OUT files
            # -------------------------------------------------

            my @files = glob("$dirOut/*${ssss}_NLB.OUT");

            foreach my $f (@files) {

                unlink $f
                    or warn "Cannot delete $f: $!";
            }

            print $LOG
                "Deleted "
                . scalar(@files)
                . " OUT-files matching *${ssss}_NLB.OUT\n";


            # -------------------------------------------------
            # Exclude satellite from ambiguity resolution
            # -------------------------------------------------

            my ($satcrx_file, $added) = _write_satcrx_ar_entry(
                $dirCrx, $satcrx, $extCrx, $dateYmd, $prn);

            print $LOG
                "Satellite $prn excluded from AR ("
                . ($added ? "5 5 entry created" : "5 5 entry already present")
                . " in SATCRX file $satcrx_file)\n";


            # -------------------------------------------------
            # Cleanup marker file
            # -------------------------------------------------

            unlink $ar_file
                or warn "Cannot delete $ar_file: $!";

            print $LOG
                "Removed $ar_file\n";


            print $LOG
                "=== CHECK_AR_SAT finished ===\n";

            close($LOG);


            print
                "CHECK_AR_SAT: ambiguity resolution problem detected "
                . "for satellite $prn. "
                . ($added ? "SATCRX 5 5 entry written" : "SATCRX 5 5 entry already present")
                . ".\n";


            prtGoto($bpe, $param2);

            return;
        }
        else {

            print $LOG
                "No valid PRN found in affected_satellite_AR file.\n";
        }
    }


    # =========================================================
    # Check 2:
    #
    # PHACOR_LOG
    #
    # Find all DEGRADED satellites and store:
    #
    #   OBS
    #   MEDIAN
    #   MAX
    #
    # Rules:
    #
    #   1. DEGRADED + OBS < 100
    #      -> SATCRX 5 0 entry
    #
    #   2. If more than one satellite is DEGRADED:
    #
    #      largest MEDIAN
    #      -> SATCRX 5 5 entry
    #
    #      largest MAX
    #      -> SATCRX 5 5 entry
    #
    #      The same satellite may be selected twice, but
    #      will only be processed once.
    #
    #   3. Other DEGRADED satellites:
    #      -> log only
    #
    # =========================================================

#    my $phacor_log = "$mscDir/PHACOR_LOG_${yyddd}";
    my $phacor_log = "$dirOut/PHACOR${yyssss}.OUT";
    my %degraded_sat;


    if (-e $phacor_log) {

        open(my $PHA, '<', $phacor_log)
            or die "Cannot open $phacor_log: $!";

        my $in_sat_table = 0;


        while (my $line = <$PHA>) {

            chomp($line);


            # -------------------------------------------------
            # Start of SAT table
            # -------------------------------------------------

            if (
                $line =~
                /^\s*SAT\s+OBS#\s+FIXED#\s+RAT\s+\[%\]/
            ) {

                $in_sat_table = 1;
                next;
            }


            # -------------------------------------------------
            # End of SAT table
            # -------------------------------------------------

            if (
                $line =~
                /^\s*\*RMS values are given in cycles/
            ) {

                $in_sat_table = 0;
                last;
            }


            next unless $in_sat_table;


            # -------------------------------------------------
            # Parse SAT table
            #
            # Example:
            #
            # 27  69  68  98.551  0.818  0.001  4.177 DEGRADED
            #
            # Fields:
            #
            # PRN
            # OBS#
            # FIXED#
            # RAT
            # MEAN
            # MEDIAN
            # MAX
            # DEGRADED
            # -------------------------------------------------

            if (
                $line =~ /^\s*
                            (\d+)          # PRN
                            \s+
                            (\d+)          # OBS#
                            \s+
                            (\d+)          # FIXED#
                            \s+
                            ([\d.]+)       # RAT
                            \s+
                            ([\d.]+)       # MEAN
                            \s+
                            ([\d.]+)       # MEDIAN
                            \s+
                            ([\d.]+)       # MAX
                            (?:\s+(DEGRADED))?
                            \s*$/x
            ) {

                my $prn      = $1;
                my $obs      = $2;
                my $median   = $6;
                my $max      = $7;
                my $degraded = defined($8);


                if ($degraded) {

                    $degraded_sat{$prn} = {

                        obs    => $obs,
                        median => $median,
                        max    => $max
                    };
                }
            }
        }

        close($PHA);
    }
    else {

        print $LOG
            "PHACOR log not found: $phacor_log\n";
    }


    # =========================================================
    # Determine degraded satellites independently for each system
    # =========================================================

    my @degraded_prns = sort {
        $a <=> $b
    } keys %degraded_sat;

    my @problem_prns;
    my %system_satellites;

    foreach my $prn (@degraded_prns) {

        my $system = $prn < 100  ? 'GPS'
                   : $prn >= 200 && $prn < 300 ? 'Galileo'
                   : $prn >= 400 && $prn < 500 ? 'BeiDou'
                   : $prn >= 500 && $prn < 600 ? 'QZSS'
                   : 'Unknown';

        push @{ $system_satellites{$system} }, $prn;
    }


    if (@degraded_prns) {

        print $LOG
            "Found " . scalar(@degraded_prns) . " DEGRADED satellite(s): "
            . join(", ", @degraded_prns)
            . "\n";

        foreach my $system (qw(GPS Galileo BeiDou QZSS Unknown)) {

            my @system_prns = @{ $system_satellites{$system} || [] };
            next unless @system_prns;

            my $num_system_degraded = scalar(@system_prns);

            print $LOG
                "$system: found $num_system_degraded DEGRADED satellite(s): "
                . join(", ", @system_prns)
                . "\n";

            # Rule 1: degraded satellites with fewer than 100 observations.
            foreach my $prn (@system_prns) {

                my $obs = $degraded_sat{$prn}{obs};

                if ($obs < 100) {

                    print $LOG
                        "$system satellite $prn is DEGRADED and has only "
                        . "$obs observations (<100) -> AR exclusion required\n";

                    push @problem_prns, $prn;
                }
            }

            # Rules 2 and 3 apply within this system only.
            if ($num_system_degraded > 1) {

                my $max_median_prn = $system_prns[0];
                foreach my $prn (@system_prns) {
                    if ($degraded_sat{$prn}{median} >
                        $degraded_sat{$max_median_prn}{median}) {
                        $max_median_prn = $prn;
                    }
                }

                print $LOG
                    "$system DEGRADED satellite with largest MEDIAN: "
                    . "$max_median_prn (MEDIAN="
                    . $degraded_sat{$max_median_prn}{median}
                    . ") -> AR exclusion required\n";
                push @problem_prns, $max_median_prn;

                my $max_max_prn = $system_prns[0];
                foreach my $prn (@system_prns) {
                    if ($degraded_sat{$prn}{max} >
                        $degraded_sat{$max_max_prn}{max}) {
                        $max_max_prn = $prn;
                    }
                }

                print $LOG
                    "$system DEGRADED satellite with largest MAX: "
                    . "$max_max_prn (MAX="
                    . $degraded_sat{$max_max_prn}{max}
                    . ") -> AR exclusion required\n";
                push @problem_prns, $max_max_prn;
            }
        }


        # =====================================================
        # Remove duplicate satellites
        # =====================================================

        my %seen;

        @problem_prns = grep {
            !$seen{$_}++
        } @problem_prns;


        # =====================================================
        # Log satellites which do NOT require AR exclusion
        # =====================================================

        my %selected;

        foreach my $prn (@problem_prns) {

            $selected{$prn} = 1;
        }


        foreach my $prn (@degraded_prns) {

            next if $selected{$prn};

            my $obs    = $degraded_sat{$prn}{obs};
            my $median = $degraded_sat{$prn}{median};
            my $max    = $degraded_sat{$prn}{max};


            print $LOG
                "Satellite $prn is DEGRADED but has sufficient "
                . "$obs observations (>=100), "
                . "MEDIAN=$median, MAX=$max "
                . "-> no AR exclusion\n";
        }
    }


    # =========================================================
    # Process satellites requiring AR exclusion
    # =========================================================

    if (@problem_prns) {


        # =====================================================
        # Determine next iteration number
        #
        # Example:
        #
        # ITER1 exists
        # ITER2 exists
        # ITER3 exists
        #
        # -> next iteration = 4
        # -> no SATCRX entry
        # -> no prtGoto
        # =====================================================

        my $iteration = 1;
        my $iteration_log;

        while (1) {

            $iteration_log =
#                "${mscDir}/PHACOR_LOG_${yyddd}_ITER${iteration}";
		"${dirOut}/PHACOR${yyssss}_ITER${iteration}.OUT";
            last unless -e $iteration_log;

            $iteration++;
        }


        print $LOG
            "Next PHACOR iteration: ITER${iteration}\n";


        # =====================================================
        # Maximum number of iterations reached
        #
        # ITER1, ITER2 and ITER3 already exist.
        #
        # Therefore this would be a fourth attempt.
        #
        # IMPORTANT:
        #
        #   NO SATCRX entry
        #   NO prtGoto()
        #
        # Only warning is written.
        # =====================================================

        if ($iteration > $MAX_ITERATIONS) {

            print $LOG
                "WARNING: Maximum number of PHACOR iterations "
                . "($MAX_ITERATIONS) already reached.\n";

            print $LOG
                "WARNING: Further satellite exclusion would "
                . "be required for satellite(s): "
                . join(", ", @problem_prns)
                . "\n";

            print $LOG
                "WARNING: No SATCRX entry will be created.\n";

            print $LOG
                "WARNING: CHECK_AR_SAT will NOT jump back "
                . "for another iteration.\n";

            print $LOG
                "=== CHECK_AR_SAT finished with WARNING ===\n";

            close($LOG);


            print
                "CHECK_AR_SAT WARNING: maximum PHACOR iteration "
                . "$MAX_ITERATIONS reached. "
                . "Further degraded satellite(s) detected: "
                . join(", ", @problem_prns)
                . ". No SATCRX entry created and no further iteration "
                . "started.\n";

            return;
        }


        # =====================================================
        # Archive PHACOR_LOG
        #
        # Example:
        #
        # PHACOR_LOG_yyddd
        #       ->
        # PHACOR_LOG_yyddd_ITER1
        #
        # The rename removes the original PHACOR_LOG_yyddd.
        # =====================================================

        if (-e $phacor_log) {

            $iteration_log =
#                "${mscDir}/PHACOR_LOG_${yyddd}_ITER${iteration}";
		"${dirOut}/PHACOR${yyssss}_ITER${iteration}.OUT";

            if (rename($phacor_log, $iteration_log)) {

                print $LOG
                    "Archived PHACOR log:\n"
                    . "  $phacor_log\n"
                    . "  -> $iteration_log\n";
            }
            else {

                print $LOG
                    "WARNING: Could not archive PHACOR log "
                    . "$phacor_log to $iteration_log: $!\n";
            }
        }
        else {

            print $LOG
                "WARNING: PHACOR log $phacor_log does not exist "
                . "and therefore cannot be archived.\n";
        }


        # =====================================================
        # Process selected degraded satellites
        # =====================================================

        foreach my $prn (@problem_prns) {

            my $obs    = $degraded_sat{$prn}{obs};
            my $median = $degraded_sat{$prn}{median};
            my $max    = $degraded_sat{$prn}{max};


            print $LOG
                "Processing satellite $prn: "
                . "DEGRADED, "
                . "OBS=$obs, "
                . "MEDIAN=$median, "
                . "MAX=$max\n";


            # -------------------------------------------------
            # Delete OUT files
            # -------------------------------------------------

            my @files = glob("$dirOut/*${ssss}_NLB.OUT");

            foreach my $f (@files) {

                unlink $f
                    or warn "Cannot delete $f: $!";
            }


            print $LOG
                "Deleted "
                . scalar(@files)
                . " OUT-files matching *${ssss}_NLB.OUT\n";


            # -------------------------------------------------
            # Create SATCRX 5 5 entry
            # -------------------------------------------------

            my ($satcrx_file, $added) = _write_satcrx_ar_entry(
                $dirCrx, $satcrx, $extCrx, $dateYmd, $prn);

            print $LOG
                "Satellite $prn excluded from AR ("
                . ($added ? "5 5 entry created" : "5 5 entry already present")
                . " in SATCRX file $satcrx_file)\n";
        }


        # =====================================================
        # SATCRX summary
        # =====================================================

        print $LOG
            "SATCRX 5 5 entry processed for "
            . scalar(@problem_prns)
            . " satellite(s): "
            . join(", ", @problem_prns)
            . "\n";


        print $LOG
            "PHACOR iteration ITER${iteration} completed.\n";


        print $LOG
            "=== CHECK_AR_SAT finished ===\n";


        close($LOG);


        print
            "CHECK_AR_SAT: degraded satellite(s) requiring "
            . "AR exclusion detected. SATCRX 5 5 entries processed for: "
            . join(", ", @problem_prns)
            . "\n";


        # =====================================================
        # Jump back for another PHACOR iteration
        # =====================================================

        prtGoto($bpe, $param2);

        return;
    }


    # =========================================================
    # Nothing requiring AR exclusion
    # =========================================================

    print $LOG
        "Ambiguity resolution fine for all satellites.\n"
        . "No satellite requires an AR exclusion.\n";


    print $LOG
        "=== CHECK_AR_SAT finished ===\n";


    close($LOG);


    print
        "CHECK_AR_SAT done. Log appended to $logfile\n";
}
