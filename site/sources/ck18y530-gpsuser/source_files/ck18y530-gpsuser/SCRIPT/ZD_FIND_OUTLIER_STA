package ZD_FIND_OUTLIER_STA;
@ISA = ("RUNBPE");
#===========================================================
# Name    : ZD_FIND_OUTLIER_STA
#
# Purpose : Run HELMR1, then screen local NEU residuals for
#           outlier candidates using component medians/MAD.
#
# Author  : C. Kobel
# Created : 06-Nov-2026
#===========================================================
use strict;
use warnings;
use lib $ENV{BPE};
use bpe_util;
use File::Spec;
use JSON::PP;
use POSIX qw(isfinite);

# ---------- Analysis parameters ------------
# All residuals and absolute limits are expressed in millimetres.
# The threshold is a screening score, not a significance level.
# The scale floor prevents division by zero for very small MADs.
# Set max_n, max_e or max_u to a positive value to enable an
# additional absolute component limit; undef disables that limit.
my %opt = (
    threshold => 12,
    min_sigma => 1,
    max_n     => undef,
    max_e     => undef,
    max_u     => undef,
    all       => 0,       # Set to 1 to log every station.
);

sub run {
    my $bpe = shift;

    # ---------- Get BPE variables ------------
    my ($dirOut, $extOut, $yyddd, $yyssss, $V_CSCR, $goto, $dirPzh, $ssss) =
        $bpe->getKeys('DIR_OUT', 'EXT_OUT', '$YD+0', '$YSS+0',
                      'V_CSCR', 'PARAM2', 'DIR_PZH', '$S+0');
    my $ANALYSIS_FILENAME = "HELMR_${V_CSCR}_${yyssss}.${extOut}";

    # ---------- Initialize logging ------------
    my $mscDir = File::Spec->catdir($dirOut, '..', 'MSC', "MSC_${yyddd}");
    my $logfile = File::Spec->catfile($mscDir, "PROCESSING_${yyddd}");
    open(my $LOG, '>>', $logfile)
        or die "Cannot open log file $logfile: $!";
    print {$LOG} "\n=== FIND_OUTLIER_STA started ===\n";

    # ---------- Validate analysis settings ------------
    for my $key (qw(threshold min_sigma max_n max_e max_u)) {
        next unless defined $opt{$key};
        die "Analysis parameter $key must be finite and > 0.\n"
            unless isfinite($opt{$key}) && $opt{$key} > 0;
    }

    # ---------- Run HELMR1 before reading its output ------------
    print {$LOG} "Running HELMR1 before residual analysis.\n";
    my $PGMNAM = "HELMR1";
    $bpe->RUN_PGMS($PGMNAM);

    # ---------- Resolve the file to analyse ------------
    my $file = File::Spec->catfile($dirOut, $ANALYSIS_FILENAME);

    # ---------- Analyse and report ------------
    my $report = eval { analyse($file) };
    if (my $error = $@) {
        print {$LOG} "ERROR analysing $file: $error";
        print {$LOG} "=== FIND_OUTLIER_STA failed ===\n";
        close($LOG);
        die $error;
    }
    print_report($report, $LOG);

    # ---------- Remove outlier station files and repeat processing ------------
    # Process every detected station before jumping back. Only files
    # directly inside DIR_PZH with the exact station/session prefix match.
    if ($report->{outlier_count}) {
        die "PARAM2 jump target is missing.\n"
            unless defined $goto && length $goto;
        my $deleted = eval { delete_outlier_files($report, $dirPzh, $ssss, $LOG) };
        if (my $error = $@) {
            print {$LOG} "ERROR deleting outlier station files: $error";
            print {$LOG} "=== FIND_OUTLIER_STA failed ===\n";
            close($LOG);
            die $error;
        }
        print {$LOG} "Deleted $deleted outlier station file(s). Jumping to PID $goto.\n";
        print {$LOG} "=== FIND_OUTLIER_STA finished (repeat processing) ===\n";
        close($LOG) or die "Cannot close log file $logfile: $!";
        prtGoto($bpe, $goto);
        return;
    }
    print {$LOG} "=== FIND_OUTLIER_STA finished ===\n";
    close($LOG) or die "Cannot close log file $logfile: $!";
    print "ZD_FIND_OUTLIER_STA done. Log: $logfile\n";
}

#===========================================================
# Delete files named <station><session>.* directly in DIR_PZH.
# The first four-character station code is used for the filename prefix.
# Read directory entries literally so spaces and wildcard characters
# in directory paths cannot change which files are selected.
#===========================================================
sub delete_outlier_files {
    my ($report, $dirPzh, $ssss, $LOG) = @_;
    die "DIR_PZH is missing or is not a directory.\n"
        unless defined $dirPzh && length $dirPzh && -d $dirPzh;
    die "Session identifier (\$S+0) is missing or invalid.\n"
        unless defined $ssss && $ssss =~ /\A[0-9]+\z/;

    # Validate all station codes before deleting the first file.
    my %prefixes;
    for my $station (@{ $report->{stations} }) {
        next unless $station->{outlier};
        my ($code) = $station->{name} =~ /\A([A-Za-z0-9]{4})(?:\s|\z)/;
        die "Cannot extract station code from '$station->{name}'.\n"
            unless defined $code;
        $prefixes{"${code}${ssss}."} = $code;
    }
    opendir(my $DIR, $dirPzh) or die "Cannot read directory $dirPzh: $!\n";
    my @entries = readdir($DIR);
    closedir($DIR) or die "Cannot close directory $dirPzh: $!\n";

    my $deleted = 0;
    for my $prefix (sort keys %prefixes) {
        my $count = 0;
        for my $entry (@entries) {
            next unless index($entry, $prefix) == 0;
            my $file = File::Spec->catfile($dirPzh, $entry);
            next unless -f $file;
            # Stop on deletion failure instead of repeating processing
            # with only part of the selected files removed.
            unlink($file) or die "Cannot delete $file: $!\n";
            print {$LOG} "Deleted outlier station file: $file\n";
            ++$count;
            ++$deleted;
        }
        print {$LOG} "Station $prefixes{$prefix}: deleted $count file(s) matching ${prefix}*.\n";
    }
    return $deleted;
}

#===========================================================
# Return the middle value (or mean of the two middle values).
# Sorting a local copy leaves the caller's data unchanged.
#===========================================================
sub median {
    my @sorted = sort { $a <=> $b } @_;
    my $n = @sorted;
    die "Median without data.\n" unless $n;
    return $n % 2 ? $sorted[int($n/2)]
        : ($sorted[$n/2 - 1] + $sorted[$n/2]) / 2;
}

#===========================================================
# Read one complete HELMR1 local residual table in millimetres.
# Reject incomplete files, duplicate stations and inconsistent
# station counts before calculating any screening statistics.
#===========================================================
sub analyse {
    my ($file) = @_;
    open my $fh, '<', $file or die "File not readable: $!\n";
    my (@stations, %seen, $expected, $rms);
    my ($tables, $in_table, $finished, $units) = (0, 0, 0, 0);
    my $number = qr/[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[EeDd][+-]?\d+)?/;
    while (my $line = <$fh>) {
        if ($line =~ /RESIDUALS IN LOCAL SYSTEM \(NORTH, EAST, UP\)/) {
            ++$tables;
            die "Multiple residual tables.\n" if $tables > 1;
            $in_table = 1;
        }
        $units = 1 if $in_table && $line =~ /RESIDUALS IN MILLIMETERS/;
        if ($in_table && $line =~ /^\s*\|\s*\d+\s*\|/) {
            die "Invalid station row (row $.).\n"
                unless $line =~ /^\s*\|\s*(\d+)\s*\|\s*(\S.*?)\s*\|\s*([^|]*?)\s*\|\s*($number)\s+($number)\s+($number)\s*\|\s*([^|]*?)\s*\|\s*$/;
            my ($index, $name, $flags, @values) = ($1, $2, $3, $4, $5, $6);
            my $marker = $7;
            die "Station multiple times in file: '$name'.\n" if $seen{$name}++;
            for (@values) {
                tr/Dd/Ee/;
                $_ = 0 + $_;
                die "Infinite residual at '$name'.\n" unless isfinite($_);
            }
            push @stations, { index => 0+$index, name => $name,
                flags => $flags, marker => $marker,
                residual_mm => { N => $values[0], E => $values[1], U => $values[2] } };
        }
        $in_table = 0 if $line =~ /OVERALL RMS\/IQR\/MAX/;
        $expected = 0+$1 if $line =~ /^\s*NUMBER OF STATIONS\s*:\s*(\d+)/;
        $rms = 0+$1 if $line =~ /^\s*RMS OF TRANSFORMATION\s*:\s*($number)/;
        $finished = 1 if $line =~ /Program finished successfully/;
    }
    close $fh or die "Read error: $!\n";
    die "No NEU residual table in millimetres found.\n" unless $tables && $units;
    die "Program completion message missing; file may be incomplete.\n" unless $finished;
    die "NUMBER OF STATIONS is missing.\n" unless defined $expected;
    die "Station count mismatch: read ".scalar(@stations).", expected $expected.\n"
        unless @stations == $expected;
    die "At least 5 stations are required for robust analysis.\n" if @stations < 5;

    # Estimate location and spread independently for N, E and U.
    # MAD is the median absolute deviation from the component median.
    # The factor 1.4826 converts MAD to a normal-consistent scale.
    my %stats;
    for my $axis (qw(N E U)) {
        my @values = map { $_->{residual_mm}{$axis} } @stations;
        my $center = median(@values);
        my $mad = median(map { abs($_ - $center) } @values);
        my $sigma = 1.4826 * $mad;
        my $floored = $sigma < $opt{min_sigma};
        $sigma = $opt{min_sigma} if $floored;
        $stats{$axis} = { median_mm => $center, mad_mm => $mad,
            sigma_mm => $sigma, scale_floored => $floored ? JSON::PP::true : JSON::PP::false,
            deviation_limit_mm => $opt{threshold} * $sigma };
    }
    # A station is a candidate if any component exceeds the robust
    # score threshold or an enabled absolute residual limit.
    for my $station (@stations) {
        my (@reasons, %scores);
        my ($score, $sum_sq) = (0, 0);
        for my $axis (qw(N E U)) {
            my $value = $station->{residual_mm}{$axis};
            my $z = abs($value - $stats{$axis}{median_mm}) / $stats{$axis}{sigma_mm};
            $scores{$axis} = $z;
            $score = $z if $z > $score;
            $sum_sq += $value * $value;
            push @reasons, sprintf('%s: z=%.2f > %.2f', $axis, $z, $opt{threshold})
                if $z > $opt{threshold};
            my $limit = $opt{'max_'.lc($axis)};
            push @reasons, sprintf('%s: |r|=%.2f > %.2f mm', $axis, abs($value), $limit)
                if defined($limit) && abs($value) > $limit;
        }
        $station->{score} = $score;
        $station->{component_scores} = \%scores;
        $station->{norm_3d_mm} = sqrt($sum_sq);
        $station->{outlier} = @reasons ? JSON::PP::true : JSON::PP::false;
        $station->{reasons} = \@reasons;
    }
    @stations = sort { $b->{outlier} <=> $a->{outlier}
        || $b->{score} <=> $a->{score} || $a->{name} cmp $b->{name} } @stations;
    my $count = grep { $_->{outlier} } @stations;
    return { file => $file, station_count => scalar(@stations), outlier_count => $count,
        rms_transformation_mm => $rms, components => \%stats,
        absolute_limits_mm => { map { uc($_) => $opt{'max_'.$_} } qw(n e u) },
        stations => \@stations };
}

#===========================================================
# Append statistics and candidate details to the PROCESSING log.
#===========================================================
sub print_report {
    my ($r, $LOG) = @_;
    printf {$LOG} "\nFile: %s\nStations: %d | Outlier candidates: %d\n",
        $r->{file}, $r->{station_count}, $r->{outlier_count};
    printf {$LOG} "HELMR1 RMS: %.2f mm\n", $r->{rms_transformation_mm}
        if defined $r->{rms_transformation_mm};
    print {$LOG} "Component   Median [mm]     Robust scale [mm]  Limit |r-Median| [mm]\n";
    for my $axis (qw(N E U)) {
        my $s = $r->{components}{$axis};
        printf {$LOG} "%5s %14.3f %19.3f %24.3f%s\n", $axis, $s->{median_mm},
            $s->{sigma_mm}, $s->{deviation_limit_mm}, $s->{scale_floored} ? ' (scale floor)' : '';
    }
    printf {$LOG} "%-18s %8s %9s %9s %9s %8s  %s\n", 'Station', 'N [mm]', 'E [mm]', 'U [mm]', '3D [mm]', 'Score', 'Finding';
    for my $s (@{$r->{stations}}) {
        next unless $opt{all} || $s->{outlier};
        printf {$LOG} "%-18s %8.2f %9.2f %9.2f %9.2f %8.2f  %s\n", $s->{name},
            @{$s->{residual_mm}}{qw(N E U)}, $s->{norm_3d_mm}, $s->{score},
            $s->{outlier} ? join('; ', @{$s->{reasons}}) : 'OK';
    }
    print {$LOG} "No outlier candidates detected.\n" unless $r->{outlier_count};

}

