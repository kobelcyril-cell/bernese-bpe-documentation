package ADDNEQ2_LA_E;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  ADDNEQ2_LA_E
#
# Purpose :  Stack and solve 3-day NEQs to generate long-arc solution
#
# Author  :  C. Kobel
# Created :  22-Oct-2026
#
# Changes :  
#===========================================================

use strict;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# ---------- Get variables ------------
#
  my (
      $yyssssm1,
      $yyssssm2,
      $yyssss,
      $yyssssp1,
      $param1,
      $sol,
      $subPid,
      $dirNeq,
      $extNeq,
      $DAY,
      $GCC
  ) = $bpe->getKeys(
      '$YSS-1',
      '$YSS-2',
      '$YSS+0',
      '$YSS+1',
      'PARAM1',
      'PARAM2',
      'SUB_PID',
      'DIR_NEQ',
      'EXT_NEQ',
      'V_SOLDAY',
      'V_GCC'
  );

# ---------- Initialize variables ------------
  setUserVar($bpe,"D4",$subPid);

# ---------- Define Input NEQs ------------
  my @inNeq = ();
  my $largesolPattern = "${dirNeq}${sol}_${yyssss}.${extNeq}";
  my $islargesol = ($param1 eq $largesolPattern);

  if ($DAY eq 'last') {
     if ($islargesol) {
        push @inNeq,"${dirNeq}${sol}RED${yyssssm2}.${extNeq}";
     	push @inNeq,"${dirNeq}${sol}RED${yyssssm1}.${extNeq}";
    	push @inNeq, $param1;
      } else {
      	push @inNeq,"${dirNeq}${sol}99${yyssssm2}.${extNeq}";
    	push @inNeq,"${dirNeq}${sol}99${yyssssm1}.${extNeq}";
    	push @inNeq, $param1;
      }
  }
  elsif ($DAY eq 'middle') {
     if ($islargesol) {
        push @inNeq,"${dirNeq}${sol}RED${yyssssm1}.${extNeq}";
        push @inNeq, $param1;
        push @inNeq,"${dirNeq}${sol}RED${yyssssp1}.${extNeq}";
      } else {
        push @inNeq,"${dirNeq}${sol}99${yyssssm1}.${extNeq}";
        push @inNeq, $param1;
        push @inNeq,"${dirNeq}${sol}99${yyssssp1}.${extNeq}";
      }
  }
  else {
        die "Unexpected V_SOLDAY value: $DAY\n";
  }

  replaceSelLst($bpe,"ADDNEQ2","INPFILE",@inNeq);
  if($subPid=~/001/ || $islargesol){
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","COORDRS",'$(FIN)_$YSS+0');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","ELEFILE",'$(FIN)??????');
    $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","POLERS",'$(FIN)_$YSS+0');
  }

  # ---------- Setup geocenter coordinates? ------------
  if ($GCC eq 'YES') {
     $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SETUP_GCC",'1');
     }
  elsif ($GCC eq 'NO') {
     $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SETUP_GCC",'0');
     }

  # ---------- Run program ------------
  my $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);
}
