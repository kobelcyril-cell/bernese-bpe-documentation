package CHECK_SAT_GAPS;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  CHECK_SAT_GAPS
#
# Purpose :  Checks the SMC file (PHASE OBSERVATIONS) for satellite data gaps.
#
# Author  :  C. Kobel
# Created :  03-Feb-2026
#
# Changes :  
#===========================================================

use strict;
use warnings;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;
use File::Basename qw(basename);
use File::Spec;

sub _write_satcrx_entry {
  my ($dirCrx, $satcrx, $extCrx, $date, $prn, $type, $code) = @_;
  die "SATCRX name is missing (getKeys V_SATCRX)\n"
    unless defined $satcrx && length $satcrx;
  die "SATCRX directory or extension is missing (getKeys DIR_CRX, EXT_CRX)\n"
    unless defined $dirCrx && length $dirCrx && defined $extCrx && length $extCrx;

  my ($year, $month, $day);
  if (defined $date && $date =~ /^\s*(\d{4})[-\s]?(\d\d)[-\s]?(\d\d)\s*$/) {
    ($year, $month, $day) = ($1, $2, $3);
  }
  die "Cannot parse current date for SATCRX $type $code entry: '$date'\n"
    unless defined $year && defined $month && defined $day;

  my $name = basename($satcrx);
  (my $extension = $extCrx) =~ s/^\.//;
  $name =~ s/\.\Q$extension\E\z//i;
  $name .= ".$extension";
  my $satcrx_file = File::Spec->catfile($dirCrx, $name);
  my $new_date = "$year$month$day";
  my $new_line = sprintf("%5d         %d         %d       %4d %02d %02d 00 00 00\n",
    $prn, $type, $code, $year, $month, $day);

  open my $in, '<', $satcrx_file
    or die "Cannot read SATCRX file $satcrx_file: $!\n";
  my @lines = <$in>;
  close $in or die "Cannot close SATCRX file $satcrx_file after reading: $!\n";
  for my $line (@lines) {
    if ($line =~ /^\s*\Q$prn\E\s+\Q$type\E\s+\Q$code\E\s+(\d{4})\s+(\d\d)\s+(\d\d)\b/) {
      return ($satcrx_file, 0) if "$1$2$3" eq $new_date;
    }
  }

  my ($insert_at, $first_event_at);
  for (my $i = $#lines; $i >= 0; --$i) {
    if ($lines[$i] =~ /^\s*-?\d+\s+\Q$type\E\s+\Q$code\E\s+(\d{4})\s+(\d\d)\s+(\d\d)\b/) {
      $first_event_at = $i;
      if ("$1$2$3" le $new_date) {
        $insert_at = $i + 1;
        last;
      }
    }
  }
  $insert_at = defined($first_event_at) ? $first_event_at : scalar @lines
    unless defined $insert_at;
  splice @lines, $insert_at, 0, $new_line;
  $lines[-1] .= "\n" if @lines && $lines[-1] !~ /[\r\n]\z/;

  open my $out, '>', $satcrx_file
    or die "Cannot rewrite SATCRX file $satcrx_file: $!\n";
  print {$out} @lines or die "Cannot write SATCRX file $satcrx_file: $!\n";
  close $out or die "Cannot close SATCRX file $satcrx_file: $!\n";
  return ($satcrx_file, 1);
}

sub run {
  my $bpe = shift;
# ---------- Get parameters ------------
  my (
      $dirOut,
      $yyddd,
      $ssss,
      $yyyy,
      $satcrx,
      $dirCrx,
      $extCrx,
      $dateYmd
  ) = $bpe->getKeys(
      'DIR_OUT',
      '$YD+0',
      '$S+0',
      '$Y+0',
      'V_SATCRX',
      'PTH_SATCRUX',
      'EXT_SATCRUX',
      '$YMD_STR+0'
  );

  my $yy = substr($yyyy, -2);

  my $smc_file = "${dirOut}/SMT${yy}${ssss}.SMC";
  die "SMC file not found: $smc_file\n" unless -e $smc_file;

# ---------- Prepare common log file ------------

  my $mscDir = "${dirOut}/../MSC/MSC_${yyddd}";
  unless (-d $mscDir) {
    mkdir $mscDir or die "Cannot create directory $mscDir: $!";
  }

  my $logfile = "$mscDir/PROCESSING_${yyddd}";
  open(my $LOG, '>>', $logfile)
    or die "Cannot open log file $logfile: $!";

  print $LOG "\n=== CHECK_SAT_GAPS started ===\n";
  print $LOG "Checking file: SMT${yy}${ssss}.SMC\n";

# ---------- Read SMC file ------------
  open(my $SMC, '<', $smc_file)
    or die "Cannot open $smc_file: $!";

  my $in_phase_block = 0;
  my $gap_count      = 0;

  while (my $line = <$SMC>) {
    chomp $line;

    # ---------- Start of PHASE OBSERVATIONS block ------------
    if ($line =~ /^\s*PHASE OBSERVATIONS/i) {
      $in_phase_block = 1;
      next;
    }

    next unless $in_phase_block;

    # ---------- Stop at axis footer ------------
    last if $line =~ /^-+\+/;

    # ---------- Satellite line: PRN | timebar ------------
    if ($line =~ /^\s*(\d+)\s*\|\s*(.+)$/) {
      my $prn = $1;
      my $bar = $2;

      # ---------- Check data gaps ------------
      if ($bar =~ /[^*]/) {

        # Check if all non-* characters are digits 1-9
        my $few_obs_warning = 1;

        my $tmp_bar = $bar;
        $tmp_bar =~ s/\*//g;       # remove all '*'

        if ($tmp_bar =~ /[^1-9]/) {
          $few_obs_warning = 0;    # contains something other than 1-9
        }

        if ($few_obs_warning) {

          # Only warning, no exclusion
          print $LOG "Few observations for satellite $prn - Satellite not excluded\n";

        } else {

          # Real data gap -> add SATCRX 5 0 entry
          print $LOG "→ Data gap detected for satellite $prn\n";
          $gap_count++;

          my ($satcrx_file, $added) = _write_satcrx_entry(
            $dirCrx, $satcrx, $extCrx, $dateYmd, $prn, 5, 0);
          print $LOG "-> SATCRX 5 0 entry " . ($added ? "created" : "already present")
            . " for satellite $prn in $satcrx_file\n";
        }
      }
    }
  }

  close($SMC);

# ---------- Summary ------------
  if ($gap_count == 0) {
    print $LOG "No data gaps detected in PHASE OBSERVATIONS.\n";
  } else {
    print $LOG "Detected data gaps for $gap_count satellites.\n";
  }

  print $LOG "=== CHECK_SAT_GAPS finished ===\n";
  close($LOG);

  print "CHECK_SAT_GAPS done. Log appended to $logfile\n";
}
