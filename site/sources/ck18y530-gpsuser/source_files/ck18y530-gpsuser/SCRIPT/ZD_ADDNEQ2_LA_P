package ADDNEQ2_LA_P;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  ADDNEQ2_LA_P
#
# Purpose :  Prepare parallel ADDNEQ2
#
# Author  :  C. Kobel
# Created :  22-Oct-2026
#
# Changes :  
#===========================================================

use lib $ENV{BPE};
use bpe_util;
use File::Basename;

sub run {
  my $bpe = shift;

# ---------- Get variables ------------
  my (
      $yyssss,
      $sol,
      $dirNeq,
      $extNeq
  ) = $bpe->getKeys(
      '$YSS+0',
      'V_APR',
      'DIR_NEQ',
      'EXT_NEQ'
  );

# ---------- Get NEQ files ------------
  my @NEQfl = glob("${dirNeq}${sol}??${yyssss}???.${extNeq}");

# ---------- When only LAPACK solution was computed ------------
  if (!@NEQfl) {
    @NEQfl = glob("${dirNeq}${sol}_${yyssss}.${extNeq}");
    die "Expected exactly one NEQ file matching ${dirNeq}${sol}_${yyssss}.${extNeq}, found " . scalar(@NEQfl) . "\n"
      if @NEQfl != 1;
  }

# ---------- Populate options for parallel run ------------
  my @time;
  my $file = "";
  foreach(@NEQfl) {
    $file = $_;
    push @time, sprintf "%s %3s",$file, $sol;
  }

# ---------- Put the BPE cluster files into the list ------------
  initPar_Fl($bpe, @time);
}
