package HELMR1;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
# Name:      HELMR1
# Purpose:   Run HELMR1
#
# Authors:   C. Kobel
#
# Created:   10-Nov-2025
#
# Changes:   
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;


sub run
{
  my $bpe = shift;

  my ($CrdName1, $CrdName2, $yyssss) = $bpe->getKeys('V_CRDSOL1','V_CRDSOL2','$YSS+0');

  $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","COORD2","${CrdName1}");
  $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","SYSOUT","HLMR_${CrdName1}");


  my $PGMNAM = "HELMR1";
  $bpe->RUN_PGMS($PGMNAM);

  $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","COORD2","${CrdName2}");
  $bpe->putKey("$ENV{U}/PAN/HELMR1.INP","SYSOUT","HLMR_${CrdName2}");

  $bpe->RUN_PGMS($PGMNAM);

}
