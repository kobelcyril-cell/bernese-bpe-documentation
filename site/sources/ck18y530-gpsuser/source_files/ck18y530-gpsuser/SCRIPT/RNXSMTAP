package RNXSMTAP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RNXSMTAP
#
# Purpose :  Prepare parallel RNXSMT run
#
# PARAMs  :  PARAM2 - output file identifier (default: SMT)
#            PARAM3 - empty: stop if no RINEX files are found
#
# Author  :  M. Meindl
# Created :  23-Jul-2003
#
# Changes :  31-Jan-2005 MM: New initPar call (w/o tmpFil)
#            11-Aug-2011 RD: Updated for version 5.2
#
# ============================================================================
use strict;

use File::Basename;

use lib $ENV{BPE};
use bpe_util qw(prtErr initPar_Bl initPar_Cl cleanFiles);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ( $yyyyssss, $yyyyddd, $ssss,
       $param3, $clu,    $dirBpe,
       $dirOut, $dirRxo, $dirSmt,
       $extOut, $extRxo, $extSmt ) =
  $bpe->getKeys
     ( '$YYYSS+0', '$YYYD+0', '$S+0',
       'PARAM3', 'V_CLU', 'DIR_BPEPRT',
       'DIR_OUT','DIR_RBO', 'DIR_SMT',
       'EXT_OUT','EXT_RBO', 'EXT_SMT' );

# Delete old observation files
# ----------------------------
  unlink glob("${dirSmt}*${yyyyssss}.${extSmt}");

# Delete old output files
# -----------------------
  cleanFiles($bpe,"SMT",["OUT"],$clu);

# Delete collecting file for RINEX error/warning messages
# -------------------------------------------------------
  unlink "${dirOut}RNX_${yyyyssss}.ERR";

# Initialize parallel run
# -----------------------
  my $bpeFil = "${dirBpe}SMT_${yyyyssss}_";
  my @rxoFil = glob("${dirRxo}????${ssss}.26O");

  if ($clu ne "") {
    initPar_Cl($bpe,$bpeFil,@rxoFil,0,$clu,0, ($clu));
  } else {
    @rxoFil = map { substr(basename($_),0,9) } @rxoFil;
    initPar_Bl($bpe,@rxoFil)
  }

# Stop if no RINEX files found
# ----------------------------
  if (@rxoFil == 0 && $param3 eq "") {
    prtErr($bpe,"No RINEX files found") and
      die "No RINEX files found for session ${ssss}";
  }

}
