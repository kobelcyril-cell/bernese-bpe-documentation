package DEL_CMP;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  DEL_CMP
#
# Purpose :  Delete CMP- and related result files, only if V_DEL=Y.
#
# PARAMs  :  DEL
#
# Author  :  C. Kobel
# Created :  08-Dec-2025
# Updated :  
#
# ============================================================================

use lib "$ENV{AUTO}";
use gpsutil;
use strict;
use warnings;
use File::Basename;
use POSIX qw(strftime);

# ----------------------------------------------------------------------------
sub run {
  my $bpe = shift;

  # ---------------------- Parameter -----------------------------------------
  my (
    $dirOut, $yyyy, $ssss, $yyssss, $yyddd, $CLEAN, $pid
  ) = $bpe->getKeys('DIR_OUT', '$Y+0', '$S+0', '$YSS+0', '$YD+0', 'V_DEL','PID');

  unless (defined $CLEAN && $CLEAN eq 'Y') {
    print "CLEAN variable not set to 'Y'. Nothing will be deleted.\n";
    return;
  }


  # ---------------------- Directories ---------------------------------------
  my $dirOrb = "${dirOut}../ORB";
  my $dirSta = "${dirOut}../STA";
  
  print "------------------------------------------------------------\n";
  print "DEL_CMP started for $yyssss\n";
  print "------------------------------------------------------------\n";

  # ---------------------- Define files to delete ----------------------------
  my @out_patterns = (
    "COMPAR2.L??",
    "COMPAR2.J",
    "CLKDIFF_*${yyddd}",
    "CRDDIFF_*${yyddd}.PLT",
    "ERPDIFF_*${yyddd}",
    "HLMR_*${yyddd}*.OUT",
    "STDDIFF_*_${yyddd}.PLT",
    "STDDIF.L??",
    "STDDIF.J",
  );

  my @orb_patterns = (
    "*${yyddd}*.STD",
    "*${yyddd}*.CLK",
    "*${yyddd}*.ERP",
  );

  my @sta_patterns = (
    "*${yyddd}*.CRD",
  );

  # ---------------------- Delete Files --------------------------------------
  my $deleted = 0;

  foreach my $pattern (@out_patterns) {
    foreach my $file (glob("${dirOut}${pattern}")) {
      unlink $file and print "Deleted: $file\n" and $deleted++;
    }
  }


  foreach my $pattern (@orb_patterns) {
    foreach my $file (glob("${dirOrb}/${pattern}")) {
      unlink $file and print "Deleted: $file\n" and $deleted++;
    }
  }

  foreach my $pattern (@sta_patterns) {
    foreach my $file (glob("${dirSta}/${pattern}")) {
      unlink $file and print "Deleted: $file\n" and $deleted++;
    }
  }

  # ---------------------- Delete Files in BPE directory ----------------------
  my $dirBpe = "${dirOut}../BPE";
  my $bpe_pattern = "*${yyssss}*";

  foreach my $file (glob("${dirBpe}/${bpe_pattern}")) {
    next if $file =~ /_${pid}_000/;

    if (-e $file) {
      unlink $file and print "Deleted: $file\n" and $deleted++;
    }
  }

  # ---------------------- Summary -------------------------------------------
  if ($deleted == 0) {
    print "No files found for $yyssss.\n";
  } else {
    print "------------------------------------------------------------\n";
    print "Deleted $deleted files for $yyssss.\n";
    print "------------------------------------------------------------\n";
  }

  return;
}

1;
# ============================================================================
