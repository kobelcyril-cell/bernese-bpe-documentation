package CMP_SUM;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  CMP_SUM
#
# Purpose :  Make summary of comparison
#
#
# Author  :  C. Kobel
# Created :  17-Oct-2025
#
# ============================================================================

use lib "$ENV{AUTO}";
use gpsutil;
use strict;
use warnings;

# ----------------------------------------------------------------------------
sub extract_helmert_lines {
    my ($file) = @_;
    return [] unless -e $file;

    open my $fh, '<', $file or return [];
    my @H;

    while (<$fh>) {
        if (/TRANSLATION IN/i or /ROTATION AROUND/i or /SCALE FACTOR/i) {
            push @H, $_;
        }
    }

    close $fh;
    return \@H;
}

# ----------------------------------------------------------------------------
sub extract_helmert_rms {
    my ($file) = @_;
    return "" unless -e $file;

    open my $fh, '<', $file or return "";
    while (<$fh>) {
        if (/RMS OF TRANSFORMATION\s*:\s*([\d.Ee+-]+)/i) {
            close $fh;
            return $1;
        }
    }
    close $fh;
    return "";
}

# ----------------------------------------------------------------------------
sub extract_std_table {
    my ($file) = @_;
    return [] unless -e $file;

    open my $fh, '<', $file or return [];
    my @lines;
    my $in_table = 0;

    while (<$fh>) {
        chomp;


        if (!$in_table && /^\s*#\s*SVN\s+.*POSITION RMS/i) {
            $in_table = 1;
            push @lines, $_;
            next;
        }


        if ($in_table) {

            last if /^\s*#\s*TOTAL:/i;
            push @lines, $_;
        }
    }

    close $fh;
    return \@lines;
}


# ----------------------------------------------------------------------------
sub run {

my $debug = 0;
my $bpe = shift;

my ($yyddd, $dirOut,$crdInf,
   $Stdname1, $Erpname1, $Clkname1, $Crdname1, $labelsol1,
   $Stdname2, $Erpname2, $Clkname2, $Crdname2, $labelsol2) =
  $bpe->getKeys('$YD+0', 'DIR_OUT','V_CRDINF',
   'V_STDSOL1','V_ERPSOL1','V_CLKSOL1','V_CRDSOL1','V_NAMESOL1',
   'V_STDSOL2','V_ERPSOL2','V_CLKSOL2','V_CRDSOL2','V_NAMESOL2');

my $summary_file = "${dirOut}CMP_${labelsol1}_${labelsol2}_${yyddd}.DAT";

my @files = (
    { file => "${dirOut}ERPDIFF_${Erpname1}_${Erpname2}_${yyddd}",     type => "ERP"    },
    { file => "${dirOut}STDDIFF_${Stdname1}_${Stdname2}_${yyddd}.PLT", type => "STD"    },
    { file => "${dirOut}CLKDIFF_${Clkname1}_${Clkname2}_${yyddd}",     type => "CLOCK"  },
    { file => "${dirOut}CRDDIFF_${Crdname1}_${Crdname2}_${yyddd}.PLT", type => "COMPAR" },
);

my $hlmr_file1 = "${dirOut}HLMR_${Crdname1}.OUT";
my $hlmr_file2 = "${dirOut}HLMR_${Crdname2}.OUT";

open my $out, ">", $summary_file or die "Can not open $summary_file: $!";

foreach my $f (@files) {
    my $file = $f->{file};
    my $type = $f->{type};

# ------------------------------------------------------------------
    # Check: file exists?
    # ------------------------------------------------------------------
    if ( ! -e $file ) {
        print "WARNING: File not found: $file\n";
        print $out "WARNING: File not found: $file\n\n";
        next;   # skip this section
    }

    open my $fh, "<", $file or do {
        print "WARNING: Could not open $file: $!\n";
        print $out "WARNING: Could not open $file: $!\n\n";
        next;
    };

    open my $fh, "<", $file or die "Can not open $file: $!";

if ($type eq "ERP") {

    my ($diff_xp, $diff_yp, $diff_ut1) = ("") x 3;

    while (<$fh>) {
        chomp;

        if (/DIFF:\s*XP=\s*([-\d.Ee+]+)\s*YP=\s*([-\d.Ee+]+)\s*UT1=\s*([-\d.Ee+]+)/) {
            ($diff_xp, $diff_yp, $diff_ut1) = ($1,$2,$3);
        }
    }

    print $out "ERP Rate Differences:\n";
    printf $out "%-12s %-12s %-12s\n", "dXP[\"]","dYP[\"]","dUT1[s]";
    printf $out "%-12s %-12s %-12s\n\n\n",
        $diff_xp, $diff_yp, $diff_ut1;


    } elsif ($type eq "STD") {
        my $table = extract_std_table($file);
        my (@mean_pos, @rms_pos);
        while (<$fh>) {
            chomp;
            if (/MEAN ALL:\s*(\S+)\s*(\S+)\s*(\S+)/) {
                @mean_pos = ($1,$2,$3);
            }
            if (/RMS  ALL:\s*(\S+)\s*(\S+)\s*(\S+)/) {
                @rms_pos = ($1,$2,$3);
            }
        }
        print $out "STD Comparison:\n";
        printf $out "%-15s %-15s %-15s %-15s %-15s %-15s\n",
            "Mean_Pos_R[m]","Mean_Pos_A[m]","Mean_Pos_C[m]","RMS_Pos_R[m]","RMS_Pos_A[m]","RMS_Pos_C[m]";
        printf $out "%-15s %-15s %-15s %-15s %-15s %-15s\n\n\n",
            @mean_pos,@rms_pos;

    	print $out "Detailed Table (STDDIF):\n";
    	print $out "$_\n" for @$table;
    	print $out "\n\n";

} elsif ($type eq "CLOCK") {
    my %system;
    while (<$fh>) {
        chomp;
        if (/ALL\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)/) { $system{ALL} = [$1,$2,$3]; }
        if (/GLONASS\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)/) { $system{GLONASS} = [$1,$2,$3]; }
        if (/GPS\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)/) { $system{GPS} = [$1,$2,$3]; }
	if (/GALILEO\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)/) { $system{GALILEO} = [$1,$2,$3]; }
	if (/BEIDOU\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)/) { $system{BEIDOU} = [$1,$2,$3]; }
	if (/QZSS\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)\s+([\d.Ee+-]+)/) { $system{QZSS} = [$1,$2,$3]; }
    }

    print $out "CLK Comparison:\n";
    printf $out "%-14s %-12s %-12s %-12s\n", "System","Mean[ns]","RMS[ns]","STD[ns]";
    for my $s (qw/ALL GLONASS GPS GALILEO BEIDOU QZSS/) {
    	next unless exists $system{$s};
	my @values_ns = map { $_ * 1e9 } @{$system{$s}};
        printf $out "%-10s %12.3f %12.3f %12.3f\n", $s, @values_ns;
    }
    print $out "\n\n";


} elsif ($type eq "COMPAR") {
    my ($total_n, $total_e, $total_u);
    my (@vals_n, @vals_e, @vals_u);
    my $line_count = 0;

    while (<$fh>) {
        chomp;
        my @fields = split;
        next unless @fields >= 5;

        $line_count++;
        if ($line_count % 6 <= 3 && $line_count % 6 != 0) {  
            my $comp_index = $fields[3];   # 1/2/3 = N/E/U
            my $value = $fields[4]+0;

            if ($comp_index == 1) {
                push @vals_n, $value;
		
            } elsif ($comp_index == 2) {
                push @vals_e, $value;
		
            } elsif ($comp_index == 3) {
                push @vals_u, $value;
		
            }
        }
    }

sub rms {
    my @a = @_;
    my $sum_sq = 0;
    $sum_sq += $_**2 for @a;
    return sqrt($sum_sq / scalar(@a));
}


$total_n = rms(@vals_n) * 1000;   # in mm
$total_e = rms(@vals_e) * 1000;   # in mm
$total_u = rms(@vals_u) * 1000;   # in mm
print $out "CRD Comparison:\n";
printf $out "%-12s %-12s %-12s\n","Total_N[mm]","Total_E[mm]","Total_U[mm]";
printf $out "%-12.2f %-12.2f %-12.2f\n\n\n",$total_n,$total_e,$total_u;

}
    close $fh;
}


# --- HLMR / Helmert Parameter -------------------------------------

print $out "Helmert Parameters ${Crdname1}, comparison to ${crdInf}:\n";

my $H1  = extract_helmert_lines($hlmr_file1);
my $RMS1 = extract_helmert_rms($hlmr_file1);

if (@$H1) {
    print $out @$H1;
} else {
    print $out "No Helmert parameters found in $hlmr_file1\n";
}

print $out "RMS_OF_TRANSFORMATION = $RMS1\n\n";


print $out "Helmert Parameters ${Crdname2}, comparison to ${crdInf}:\n";

my $H2  = extract_helmert_lines($hlmr_file2);
my $RMS2 = extract_helmert_rms($hlmr_file2);

if (@$H2) {
    print $out @$H2;
} else {
    print $out "No Helmert parameters found in $hlmr_file2\n";
}

print $out "RMS_OF_TRANSFORMATION = $RMS2\n\n";

}