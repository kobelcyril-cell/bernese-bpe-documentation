package RNXSMT_P;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  RNXSMT_P
#
# Purpose :  Execute RNXSMT (parallel mode)
#
# PARAMs  :  PARAM1 - temporary file for parallel processing
#
# Author  :  M. Meindl
# Created :  23-Jul-2003
#
# Changes :  11-Aug-2011 RD: Updated for version 5.2
#            10-May-2022 LP: Include GPS in any case
#
# ============================================================================
use strict;

use lib $ENV{BPE};
use bpe_util qw(prtMess getWarn setClusterVar replaceSel prtBPEfile setHourly setGNSS);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyyyssss ,
      $param1, $clu, $satsys,
      $dirOut) =
   $bpe->getKeys
     ('$YYYSS+0',
      'PARAM1', 'PARAM2', 'V_SATSYS',
      'DIR_OUT');

# Set cluster number and input files
# ----------------------------------
  my $mess = setClusterVar($bpe, $clu);
  prtMess($bpe,"$mess");

# Selected files
# --------------
  if ($clu eq "") {
    $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","RNXFIL_BSW","${param1}_$yyyyssss");
  } else {
    replaceSel($bpe,"RNXSMT","RNXFIL_BSW",$param1);
  }

# Hourly processing
# -----------------
  setHourly($bpe);

# Set the GNSS to be used
# -----------------------
  if (! ($satsys =~ /G/) ) { $satsys = 'G'.$satsys; }
  setGNSS($bpe,"$ENV{U}/PAN/RNXSMT.INP","USE_",$satsys);

# Run program
# -----------
  my $PGMNAM = "RNXSMT";
  $bpe->RUN_PGMS($PGMNAM);

# Extract warning/error messages from protocol file
# -------------------------------------------------
  getWarn($bpe,"${dirOut}RNX_${yyyyssss}.ERR");

# Print processed stations BPE file
# ---------------------------------
  prtBPEfile($param1,0) if ($clu ne "");

}
