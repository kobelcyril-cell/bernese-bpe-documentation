package PHACOR;
@ISA = ("RUNBPE");
#===========================================================
# Name    :  PHACOR
#
# Purpose :  Execute PHACOR
#
# Author  :  C. Kobel
# Created :  27-Aug-2026
#
# Changes : 
#===========================================================

use strict;
use warnings;
use File::Spec;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

  # Select processed GNSS systems
  # -----------------------------
  my ($v_gnssar) = $bpe->getKeys('V_GNSSAR');
  &setGNSS($bpe,"$ENV{U}/PAN/PHACOR.INP","USE_",$v_gnssar);

  # ---------- Run program; retry without phase-jump parameters on error ----
  my $PGMNAM = "PHACOR";
  my $run_error;
  eval { $bpe->RUN_PGMS($PGMNAM); 1 } or $run_error = $@ || "PHACOR failed";
  return unless $run_error;

  # A failed PHACOR run may leave a useful report, but cannot produce the
  # corrected files. Retry once with phase-jump estimation disabled.
  $bpe->putKey("$ENV{U}/PAN/PHACOR.INP", "CHECK_PHASE_JUMPS", "0");

  my ($dirOut, $yyddd) = $bpe->getKeys('DIR_OUT', '$YD+0');
  my $processing_file = File::Spec->catfile(
    $dirOut, '..', 'MSC', "MSC_$yyddd", "PROCESSING_$yyddd");
  (my $logged_error = $run_error) =~ s/[\r\n]+/ /g;
  open my $processing, '>>', $processing_file
    or die "Cannot append to processing file $processing_file: $!\n";
  my $note = "PHACOR failed; retrying without check for phase jumps\n";
  print {$processing} $note
    or die "Cannot write processing file $processing_file: $!\n";
  close $processing
    or die "Cannot close processing file $processing_file: $!\n";
  print "[ZD_PHACOR] $note";

  my $retry_error;
  eval { $bpe->RUN_PGMS($PGMNAM); 1 } or $retry_error = $@ || "PHACOR retry failed";
  die $retry_error if $retry_error;

}
