package ORBGEN;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  ORBGEN
#
# Purpose :  Run ORBGEN
#
# Author  :  C. Kobel
# Created :  21-Apr-2026
#
# Changes :  26-May-2026 CK: Revised and formatted
#===========================================================

use strict;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

  # Select processed GNSS systems
  # -----------------------------
  my ($v_gnss) = $bpe->getKeys('V_GNSS');
  &setGNSS($bpe,"$ENV{U}/PAN/ORBGEN.INP","USE_",$v_gnss);

# ---------- Run program ------------
  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);
}