package ZD_ORBGEN_APR;
@ISA = ("RUNBPE");

#====================================================================
# Name    : ZD_ORBGEN_APR
#
# Purpose : Run ORBGEN, check for bad satellites, and add exclusions
#           to the SATCRX file.
#
# Author  : C. Kobel
# Created : 21-Apr-2026
#
# Changes : 26-May-2026 CK: Revised and formatted
#====================================================================

use strict;
use warnings;
use File::Basename qw(basename dirname);
use File::Spec;
use lib $ENV{BPE};
use bpe_util;  

sub run {
  my $bpe = shift;

  # Run ORBGEN and check for error.
  # Select processed GNSS systems
  # -----------------------------
  my ($v_gnss) = $bpe->getKeys('V_GNSS');
  &setGNSS($bpe,"$ENV{U}/PAN/ORBGEN.INP","USE_",$v_gnss);

  my $PGMNAM = "ORBGEN";
  my $run_error;
  eval { $bpe->RUN_PGMS($PGMNAM); 1 } or $run_error = $@ || "ORBGEN failed";
  return unless $run_error;

  # ORBGEN may leave useful output files even when RUN_PGMS reports an error.
  my (
    $dirOut,
    $ssss,
    $yyddd,
    $yyssss,
    $satcrx,
    $dirCrx,
    $extCrx,
    $dirBpe,
    $taskId,
    $pid,
    $extLog,
  ) = $bpe->getKeys(
    'DIR_OUT',
    '$S+0',
    '$YD+0',
    '$YSS+0',
    'V_SATCRX',
    'PTH_SATCRUX',
    'EXT_SATCRUX',
    'DIR_BPELOG',
    'TASKID',
    'PID',
    'EXT_BPELOG'
  );

  my $orb_file = "${dirOut}/ORBGEN_APR${ssss}.OUT";
  die "ORBGEN_APR file not found: $orb_file\n" unless -e $orb_file;

  my %bad_satellites;
  my %velocity_bad_satellites;
  my %ellipse_bad_satellites;
  my ($from, $to);
  open my $out, '<', $orb_file
    or die "Cannot read ORBGEN output $orb_file: $!\n";
  my $in_rms_table = 0;
  while (my $line = <$out>) {
    if ($line =~ /^
      \s*\d+\s+
      (\d{4}-\d\d-\d\d)\s+\d\d:\d\d:\d\d\s+
      (\d{4}-\d\d-\d\d)\s+\d\d:\d\d:\d\d\s+
      BOUNDARIES\s+OK
    /x) {
      ($from, $to) = ($1, $2);
    }
    if ($line =~ /RMS ERRORS AND MAX\. RESIDUALS/) {
      $in_rms_table = 1;
      next;
    }
    if ($in_rms_table && $line =~ /^\s*(\d{1,4})\s+\d+[^\r\n]*\*{3,}/) {
      $bad_satellites{$1} = 1;
    }
    $in_rms_table = 0 if $in_rms_table && $line =~ /PARAMETERS AND RMS ERRORS/;
  }
  close $out;

  # Read velocity diagnostics from the matching section in the BPE log.
  my $log_ext = $extLog;
  $log_ext =~ s/^\.//;
  my $task_log = File::Spec->catfile(
    $dirBpe, "${taskId}${yyssss}_${pid}_000.${log_ext}");
  die "ORBGEN task log not found: $task_log\n" unless -e $task_log;
  open my $task_log_fh, '<', $task_log
    or die "Cannot read ORBGEN BPE log $task_log: $!\n";
  my $task_log_text;
  {
    local $/;
    $task_log_text = <$task_log_fh>;
  }
  close $task_log_fh or die "Cannot close ORBGEN BPE log $task_log: $!\n";

  # RUN_PGMS may return the diagnostic in its exception instead of the log.
  $task_log_text .= "\n$run_error" if defined $run_error;

  # Match each velocity error with its satellite number in the same block.
  my $velocity_error_pattern = qr/
    It\s+does\s+not\s+look\s+like\s+a\s+satellite\s+velocity\.
    (?:(?!It\s+does\s+not\s+look\s+like\s+a\s+satellite\s+velocity\.).)*?
    Satellite\s+number:\s*(\d+)\b
  /isx;
  for my $sr_section (split /(?=^[ \t]*\*{3,}[ \t]+SR\b)/m, $task_log_text) {
    if ($sr_section =~ /^[ \t]*\*{3,}[ \t]+SR[ \t]+deqrhs,[ \t]*PG[ \t]+ORBGEN\b/im) {
      while ($sr_section =~ /$velocity_error_pattern/g) {
        my $sat = $1;
        $velocity_bad_satellites{$sat} = 1;
        $bad_satellites{$sat} = 1;
      }
    }

    if ($sr_section =~ /^[ \t]*\*{3,}[ \t]+SR[ \t]+xyzEle,[ \t]*PG[ \t]+ORBGEN\b/im
        && $sr_section =~ /Orbit\s+is\s+no\s+ellipse,\s*execution\s+stopped\b/i
        && $sr_section =~ /Satellite\s+number:\s*(\d+)\b/i) {
      my $sat = $1;
      $ellipse_bad_satellites{$sat} = 1;
      $bad_satellites{$sat} = 1;
      print "[ZD_ORBGEN_APR] Detected non-elliptic orbit for satellite $sat in BPE log $task_log\n";
    }
  }

  die "Cannot exclude satellite(s) with ORBGEN errors: date boundaries are missing\n"
    if (%velocity_bad_satellites || %ellipse_bad_satellites) && (!$from || !$to);

  print "[ZD_ORBGEN_APR] CRX write check: satellites=",
    (%bad_satellites ? join(',', sort { $a <=> $b } keys %bad_satellites) : '(none)'),
    ", from=", (defined $from ? $from : '(undefined)'),
    ", to=", (defined $to ? $to : '(undefined)'), "\n";

  if (%bad_satellites && $from && $to) {
    my $satcrx_name = basename($satcrx);
    my $crx_ext = $extCrx;
    $crx_ext =~ s/^\.//;
    $satcrx_name =~ s/\.\Q$crx_ext\E\z//i;
    $satcrx_name .= "." . $crx_ext;
    my $satcrx_file = File::Spec->catfile($dirCrx, $satcrx_name);
    print "[ZD_ORBGEN_APR] SATCRX write target: $satcrx_file\n";
    print "[ZD_ORBGEN_APR] SATCRX absolute target: ", File::Spec->rel2abs($satcrx_file), "\n";
    print "[ZD_ORBGEN_APR] SATCRX file size before: ", (-e $satcrx_file ? (-s $satcrx_file) : '(file missing)'), "\n";

    open my $crx_in, '<', $satcrx_file
      or die "Cannot read SATCRX file $satcrx_file: $!\n";
    my @crx_lines = <$crx_in>;
    close $crx_in or die "Cannot close SATCRX file $satcrx_file after reading: $!\n";
    print "[ZD_ORBGEN_APR] Read ", scalar(@crx_lines), " existing lines from $satcrx_file\n";
    my @new_crx_lines;
    for my $sat (sort { $a <=> $b } keys %bad_satellites) {
      my ($from_year, $from_month, $from_day) = $from =~ /^(\d{4})-(\d\d)-(\d\d)$/;
      my ($to_year, $to_month, $to_day) = $to =~ /^(\d{4})-(\d\d)-(\d\d)$/;
      die "Unexpected ORBGEN date format: '$from' through '$to'\n"
        unless defined $from_year && defined $from_month && defined $from_day
            && defined $to_year && defined $to_month && defined $to_day;
      my $crx_line = sprintf(
        "%5d         3         2       %4d %02d %02d 00 00 00  %4d %02d %02d 23 59 59\n",
        $sat, $from_year, $from_month, $from_day, $to_year, $to_month, $to_day);
      push @new_crx_lines, ["$from_year$from_month$from_day", $crx_line];
      print "[ZD_ORBGEN_APR] Prepared CRX record for satellite $sat: $crx_line";
    }

    # Search the 3 2 list from the bottom and insert after the last entry
    # whose start date is not later than the new entry's start date.
    for my $new_record (sort { $a->[0] cmp $b->[0] } @new_crx_lines) {
      my ($new_date, $new_line) = @$new_record;
      my $insert_at;
      for (my $i = $#crx_lines; $i >= 0; --$i) {
        if ($crx_lines[$i] =~ /^\s*\d+\s+3\s+2\s+(\d{4})\s+(\d\d)\s+(\d\d)\b/) {
          my $old_date = "$1$2$3";
          if ($old_date le $new_date) {
            $insert_at = $i + 1;
            last;
          }
        }
      }
      $insert_at = 0 unless defined $insert_at;
      splice @crx_lines, $insert_at, 0, $new_line;
      print "[ZD_ORBGEN_APR] Inserted record at CRX line ", $insert_at + 1, ": $new_line";
    }

    if (@crx_lines && $crx_lines[-1] !~ /[\r\n]\z/) {
      $crx_lines[-1] .= "\n";
    }
    open my $crx_out, '>', $satcrx_file
      or die "Cannot rewrite SATCRX file $satcrx_file: $!\n";
    print "[ZD_ORBGEN_APR] Writing ", scalar(@crx_lines), " total lines to $satcrx_file\n";
    print {$crx_out} @crx_lines or die "Cannot write SATCRX file $satcrx_file: $!\n";
    close $crx_out or die "Cannot close SATCRX file $satcrx_file: $!\n";
    print "[ZD_ORBGEN_APR] SATCRX write and close succeeded; file size after: ", (-s $satcrx_file), " bytes\n";
    open my $crx_verify, '<', $satcrx_file
      or die "Cannot verify SATCRX file $satcrx_file: $!\n";
    my @written_crx_lines = <$crx_verify>;
    close $crx_verify or die "Cannot close SATCRX verification read for $satcrx_file: $!\n";
    for my $new_record (@new_crx_lines) {
      my $expected_line = $new_record->[1];
      my $found = scalar grep { $_ eq $expected_line } @written_crx_lines;
      print "[ZD_ORBGEN_APR] Read-back verification for SATCRX record $expected_line",
        ($found ? 'FOUND' : 'NOT FOUND'), " in $satcrx_file\n";
      die "SATCRX verification failed for record: $expected_line"
        unless $found;
    }

    # Record each exclusion in the processing log.
    my $processing_file = File::Spec->catfile(
      dirname($orb_file), '..', 'MSC', "MSC_$yyddd", "PROCESSING_$yyddd");
    print "[ZD_ORBGEN_APR] Processing log target: $processing_file\n";
    print "[ZD_ORBGEN_APR] Processing log absolute target: ", File::Spec->rel2abs($processing_file), "\n";
    open my $processing, '>>', $processing_file
      or die "Cannot append to processing file $processing_file: $!\n";
    my $start_note = "=== CREATE FIRST A PRIORI ORBIT started ===\n";
    print "[ZD_ORBGEN_APR] Writing to processing log: $start_note";
    print {$processing} $start_note
      or die "Cannot write processing file $processing_file: $!\n";
    for my $sat (sort { $a <=> $b } keys %bad_satellites) {
      my $note = $velocity_bad_satellites{$sat}
        ? sprintf(
            "Satellite %d excluded because ORBGEN reported an invalid satellite velocity; entry in SAT-crx created\n",
            $sat
          )
        : sprintf(
            "Very bad a priori orbit for satellite %d -> Excluded; entry in SAT-crx created\n",
            $sat
          );
      print "[ZD_ORBGEN_APR] Writing to processing log: $note";
      print {$processing} $note
        or die "Cannot write processing file $processing_file: $!\n";
    }
    my $finish_note = "=== CREATE FIRST A PRIORI ORBIT finished ===\n";
    print "[ZD_ORBGEN_APR] Writing to processing log: $finish_note";
    print {$processing} $finish_note
      or die "Cannot write processing file $processing_file: $!\n";
    close $processing or die "Cannot close processing file $processing_file: $!\n";
    print "[ZD_ORBGEN_APR] Processing log write and close succeeded: $processing_file\n";

    # Re-run once with the problematic satellites excluded for this arc.
    my $retry_error;
    eval { $bpe->RUN_PGMS($PGMNAM); 1 } or $retry_error = $@ || "ORBGEN retry failed";
    return unless $retry_error;
    die $retry_error;
  }

  die $run_error;
}
