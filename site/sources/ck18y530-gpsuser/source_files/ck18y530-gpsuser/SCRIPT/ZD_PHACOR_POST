package PHACOR_POST;
@ISA = ("RUNBPE");
#===========================================================
# Name    :  PHACOR_POST
#
# Purpose :  Copy PHACOR-modified products and create the combined OSB file.
#
# Author  :  C. Kobel
# Created :  22-Oct-2026
#
# Changes : 
#===========================================================
use strict;
use warnings;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;
  my (
      $yyssss,
      $inposbh,
      $v_apr,
      $extOsb,
      $dirOsb,
      $dirOut,
      $dirPre
  ) = $bpe->getKeys(
      '$YSS+0',
      'V_CBIA',
      'V_APR',
      'EXT_OSB',
      'DIR_OSB',
      'DIR_OUT',
      'DIR_PRE'
  );

  my $inposb = "${inposbh}S";
  my $osbNL_fl   = "${dirOsb}/NL_${yyssss}.OSB";
  my $biaNL_fl   = "${dirOsb}/NL_${yyssss}.BIA";
  my $clk_fl     = "${dirOsb}/${v_apr}_${yyssss}.CLK";
  my $pre_fl     = "${dirPre}/${v_apr}_${yyssss}.PRE";
  
  my $osbNL_flm   = "${dirOsb}/NL_${yyssss}_mod.OSB";
  my $biaNL_flm   = "${dirOsb}/NL_${yyssss}_mod.BIA";
  my $clk_flm     = "${dirOsb}/${v_apr}_${yyssss}_mod.CLK";
  my $pre_flm     = "${dirPre}/${v_apr}_${yyssss}_mod.PRE";

  system("cp ${osbNL_flm} ${osbNL_fl}") == 0
    or die "PHACOR_POST: copying OSB failed (status=$?). Try to put CLOCK_COEFFCIENTS and ORBIT_COEFFICIENTSS to 5\n";
  system("cp ${biaNL_flm} ${biaNL_fl}") == 0
    or die "PHACOR_POST: copying BIA failed (status=$?). Try to put CLOCK_COEFFCIENTS and ORBIT_COEFFICIENTSS to 5\n";
  system("cp ${clk_flm} ${clk_fl}") == 0
    or die "PHACOR_POST: copying CLK failed (status=$?). Try to put CLOCK_COEFFCIENTS and ORBIT_COEFFICIENTSS to 5\n";
  system("cp ${pre_flm} ${pre_fl}") == 0
    or die "PHACOR_POST: copying PRE failed (status=$?). Try to put CLOCK_COEFFCIENTS and ORBIT_COEFFICIENTSS to 5\n";

# ---------- Create combined OSB file ------------
  if ($inposb ne '') {

    my $iOsbFil = "${dirOsb}/${inposb}${yyssss}.${extOsb}";
    my $oOsbFil = "${dirOsb}/NLB${yyssss}.${extOsb}";

    my $estOsb  = "";
    $estOsb = "${dirOsb}/NL_${yyssss}.${extOsb}";

    my %osb;

    $osb{G}{L1X}{L1W} = 1;
    $osb{G}{L1X}{L1C} = 1;
    $osb{G}{L2X}{L2W} = 1;
    $osb{G}{L2X}{L2C} = 1;
    $osb{G}{L2X}{L2X} = 1;

    $osb{R}{L1X}{L1P} = 1;
    $osb{R}{L1X}{L1C} = 1;
    $osb{R}{L2X}{L2P} = 1;
    $osb{R}{L2X}{L2C} = 1;

    $osb{E}{L1X}{L1C} = 1;
    $osb{E}{L1X}{L1X} = 1;
    $osb{E}{L5X}{L5Q} = 1;
    $osb{E}{L5X}{L5X} = 1;

    $osb{C}{L2X}{L2I} = 1;
    $osb{C}{L2X}{L2X} = 1;
    $osb{C}{L7X}{L7I} = 1;
    $osb{C}{L7X}{L7X} = 1;
    $osb{C}{L1X}{L1P} = 1;
    $osb{C}{L5X}{L5P} = 1;


    $osb{J}{L1X}{L1C} = 1;
    $osb{J}{L1X}{L1X} = 1;
    $osb{J}{L2X}{L2L} = 1;
    $osb{J}{L2X}{L2S} = 1;
    $osb{J}{L2X}{L2X} = 1;

    open my $OUT, ">", $oOsbFil;
    open my $INP, "<", $iOsbFil;

    print $OUT $_ for (<$INP>);
    close $INP;

    open $INP, "<", $estOsb;

    while (<$INP>) {
      if (/OSB  (\w)\d\d\d .* (L\d\w) /) {
        my $otyp = $2;
        chomp;

        foreach my $obstyp (sort keys %{$osb{$1}{$otyp}}) {
          my $line = $_;
          $line =~ s/$otyp/$obstyp/;
          print $OUT "$line\n";
        }
      }
    }

    while (<$INP>) {
      print $OUT $_ if / L\d\w /;
    }

    close $INP;
    close $OUT;
  }
}
