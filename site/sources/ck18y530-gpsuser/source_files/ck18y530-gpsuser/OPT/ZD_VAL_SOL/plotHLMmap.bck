# BEGIN_PANEL NO_CONDITION #####################################################
# MAP WITH STATIONS FROM A COORDINATE FILE - plotHLMmap 1: Input/output files  #
#                                                                              #
# GENERAL CONFIGURATION                                                        #
#   Show general configuration        > % <                                    # SHOWGEN
#                                                                              #
# INPUT FILES                                                                  #
#   HELMR1 program output file        > %%%%%%%%%%%% <                         # HLMINP
#   Input coordinate file             > %%%%%%%%%%%% <                         # CRDINP
#                                                                              #
# RESULT FILE                                                                  #
#   Show figure on the screen         > % <                                    # FIGSHOW
#   Name of the output file           > %%%%%%%%%%%%%%%%%%%%%%%% <             # FIGOUT
#                                       (extension defines the format)         #
#   Resolution of the figure          > %%%% < dpi                             # FIGRES
#                                                                              #
# CONTENT OF THE PLOT                                                          #
#   Title > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#   Component from HELMR1 output      > %%%%%%%%%%%% <                         # HLMTYP
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# plotHLMmap 1.1: General Configuration                                        #
#                                                                              #
# FONT DEFINITIONS                                                             #
#   Title                        > %%%%%%%%%%%% <                              # TIT_FONTSIZE
#   Labels                       > %%%%%%%%%%%% <                              # LABEL_FONTSIZE
#   Legend                       > %%%%%%%%%%%% <                              # LEG_FONTSIZE
#                                                                              #
# COLOR DEFINITIONS                                                            #
#   Background color of the plot > %%%%%%%%%%%% <                              # BGCOLOR
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotHLMmap 2: Map layout                                                     #
#                                                                              #
# MAP LAYOUT SPECIFICATION                                                     #
#   Size of the plot:      width   > %%%%%%%%%% < height     > %%%%%%%%%% <    # SIZEX SIZEY
#                                                                              #
#   Topography style:              > %%%%%%% <    resolution > %%%%%%% <       # MAPSTYLE MAPRESOL
#       colors for         ocean   > %%%%%%% <    land       > %%%%%%% <       # MAPCOCN MAPCLAND
#                                                                              #
#   Projection:                    > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # MAPPROJ
#        projection point  lat.    > %%%%%%%%%% < longitude  > %%%%%%%%%% <    # MAPPLAT MAPPLON
#                                                                              #
#   Boundaries: > % < auto or         latitude                  longitude      # XYAUTO
#                     lower left   > %%%%%%%%%% <            > %%%%%%%%%% <    # XMIN YMIN
#                     upper right  > %%%%%%%%%% <            > %%%%%%%%%% <    # XMAX YMAX
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION ####################################################################
# plotHLMmap 3: Symbol and color settings                                                     #
#                                                                                             #
# COLOR MAP LAYOUT                                                                            #
#   Define color map            > %%%%%%%%%%%%%%%%%%% <   > % < reverse                       # CMAP CREVERSE
#      Range of values      min > %%%%%% <        max > %%%%%% <                              # CMIN CMAX
#      Label for colormap       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <                   # CLABEL
#                                                                                             #
# Dataset definition                                                                          #
# > % < all values are displayed with symbol/size > %%%%%%%% <  > %%% <                       # RADIO_ALL SYMBOL SSIZE
# > % < Flag      Include          Exclude          Symbol        Size      Label             # RADIO_SPEC
#   1 > %%%% <  > %%%%%%%%%%%% < > %%%%%%%%%%%% < > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# FLAG_1 INCLUDE_1 EXCLUDE_1 SYMBOL_1 SSIZE_1 LABEL_1
#   2 > %%%% <  > %%%%%%%%%%%% < > %%%%%%%%%%%% < > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# FLAG_2 INCLUDE_2 EXCLUDE_2 SYMBOL_2 SSIZE_2 LABEL_2
#   3 > %%%% <  > %%%%%%%%%%%% < > %%%%%%%%%%%% < > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# FLAG_3 INCLUDE_3 EXCLUDE_3 SYMBOL_3 SSIZE_3 LABEL_3
#   4 > %%%% <  > %%%%%%%%%%%% < > %%%%%%%%%%%% < > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# FLAG_4 INCLUDE_4 EXCLUDE_4 SYMBOL_4 SSIZE_4 LABEL_4
#                                                                                             #
# END_PANEL ###################################################################################


# BEGIN_PANEL CMAP = MANUAL ####################################################
# plotHLMmap 3.1: User defined color map                                       #
#                                                                              #
# Create an user defined colormap                                              #
# > value__ color_______ <         define colors for 0.0 and 1.0               # CMAP_MANUAL
#                                  additional value/color combinations         #
#                                    may be added inbetween                    #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL RADIO_SPEC = 1 ###################################################
# plotHLMmap 4: Legend layout                                                  #
#                                                                              #
# LEGEND LAYOUT SPECIFICATION                                                  #
# > % <  Legend:                                                               # LEGEND
#        Position  > %%%%%%%%%%%% <  X-off > %%%%% <  Y-off > %%%%% <          # LEG_POS LEG_ANCHOR_X LEG_ANCHOR_Y
#        Frame     > % <                       Num. Columns  > % <             # LEG_FRAME LEG_NCOLS
#        Title     > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <       # LEG_TITLE
#                                                                              #
# END_PANEL ####################################################################
