  # $Y+0

SES_INFO 1  "1000"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Environment variables
! ---------------------
ENVIRONMENT 9
  "U" "/storage/homefs/ec20f882/GPSUSER_ZDM"
  "T" "/scratch/local/ec20f882"
  "X" "/storage/research/aiub_data/BSWsoftware/EC_BERN/GPS"
  "P" "/storage/research/aiub_code"
  "K" "/storage/research/aiub_u_camp"
  "R" "/storage/scratch/aiub/camp"
  "USER" "ec20f882"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/EC_BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/EC_BERN/GLOBAL/CONFIG"
  ## widget = initmenu; pointer = ENVIR_LIST

! --------------------------------------------------------------------
! INPUTFILES                                                         |
! --------------------------------------------------------------------
! Show general files
! ------------------
