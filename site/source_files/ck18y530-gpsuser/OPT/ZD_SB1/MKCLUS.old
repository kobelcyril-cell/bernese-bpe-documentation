RADIO_Z2 1  "1"
  ## widget = radiobutton; group = REGTYP; radiokeys = NUMCLU_ZR NSAMPL_ZR

MSG_RADIO_Z2 1  "Number of clusters"

NUMCLU_ZR 1  "4"
  ## widget = spinbox; range = 1 100 1

MSG_NUMCLU_ZR 1  "Number of clusters"

