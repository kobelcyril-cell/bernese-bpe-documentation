# BEGIN_PANEL NO_CONDITION #####################################################
# CONCATENATE RINEX OBSERVATION FILES - CCRNXO 1: Filenames                    #
#                                                                              #
# RINEX INPUT FILES                                                            #
#   > % < Concatenate files, IGS and Bernese internal naming                   # RADIO_C
#         Bernese internal naming  > %%%%%%%%%%%%%%%%%% <                      # CONCAT_BSW
#         RINEX-3-style naming     > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <      # CONCAT_LONG
#         RINEX-2-style naming     > %%%%%%%% <                                # CONCAT_SHORT
#         RINEX-style, any ending  > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <      # CONCAT
#         RINEX src priority list  > %%%%%%%%%%%%%%%%%%%%% <                   # RX_SRC_PRIO
#                                                                              #
#   > % < Concatenate files, any naming convention                             # RADIO_A
#         Any naming convention    > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <      # CONCAT_ANY
#         Bernese-style named out  > %%%%%%%%%%%%%%%%%%%% <                    # BSWOUT
#                                                                              #
#   > % < Merge files, Bernese internal naming                                 # RADIO_B
#         RINEX master file        > %%%%%%%%%%%%%%%%%% <                      # MERGE1_BSW
#         RINEX second file        > %%%%%%%%%%%%%%%%%% <                      # MERGE2_BSW
#                                                                              #
#   > % < Merge files, any naming convention                                   # RADIO_M
#         RINEX master file        > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <      # MERGE1
#         RINEX second file        > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <      # MERGE2
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files         > % <                                       # SHOWGEN
#   Observation selection          > %%%%%%%%%%%% <                            # OBSSEL
#   Print observation statistics   > % <                                       # PRTOSTAT
#                                                                              #
# OUTPUT RINEX FILES                                                           #
#   Others than default   > % < (RINEX 3 format, BSW-internal naming)          # SPEC_RNX_OUT
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output        > % < use CCRNXO.Lnn            or  > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages        > % < merged to program output  or  > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# TITLE > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# CCRNXO 1.1: General Files                                                    #
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SPEC_RNX_OUT = 1 #################################################
# CCRNXO 1.2: Output RINEX files                                               #
#                                                                              #
# OUTPUT RINEX FILE NAMES                                                      #
#   > % < BSW internal file naming                                             # RADIO_BSW_FN
#   > % < RINEX-2- or RINEX-3-style file name (depending on output version)    # RADIO_RNX_FN
#                                                                              #
#   > % < Normalize start epoch in RINEX-3-style output file name to midnight  # NRM_EPO_FN
#                                                                              #
# OUTPUT RINEX VERSIONS                                                        #
#   > % < Take highest input RINEX version as output RINEX version             # RADIO_MRH
#   > % < On mixed input RINEX main versions, choose lower one                 # RADIO_MRL
#         On same input RINEX main versions, choose higher sub-version         #
#   > % < Force output RINEX version to > %%%% <                               # RADIO_FR RNXOUTVERS
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXO 2: Options part I                                                     #
#                                                                              #
# SATELLITE SYSTEMS                                                            #
#   GPS          > % <      GLONASS     > % <     Galileo      > % <           # USE_G USE_R USE_E
#   SBAS         > % <      BeiDou      > % <     QZSS         > % <           # USE_S USE_C USE_J
#   IRNSS        > % <                                                         # USE_I
#                                                                              #
# STATION NAME TRANSLATION                                                     #
#   Gather station names from                  > %%%%%%%%%%%%% <               # STANAM
#   Station information                        > %%%%%%%%%%%% <                # STAINFO
#                                                                              #
# GENERAL RINEX OPTIONS                                                        #
#   Change hdr strings to upper case on read   > % <                           # RDRXHDUC
#   Only GPS/GLO and freq. 1 or 2 for RINEX 2  > % <                           # RX2_RESTR
#   Output errors from input headers           > % <                           # ERRFROMRXHDR
#   Write errors into output header            > % <                           # ERRTORXHDR
#   Write leading zeros to timestamp of recs   > % <                           # WRTRECLDZERO
#   Write GNSS in obs. recs in alph. order     > % <                           # WRTRXRECALPH
#   Use observation window                     > % <                           # USEWIN
#                                                                              #
# SAMPLING                                                                     #
#   Sampling interval           > %%%%%% < seconds   (0: use all observations) # SAMPLING
#   Offset to full minute       > %%%%%% < seconds                             # OFFSET
#   Sampling tolerance          > %%%%%% < seconds                             # SAMPLTOL
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL USEWIN = 1 #######################################################
# CCRNXO 2.1: Observation Window                                               #
#                                                                              #
# OBSERVATION WINDOW                                                           #
#                                                                              #
#   > % < Defined by Year and Session identifier                               # RADIO_1
#         Year  > %%%% <   Session > %%%% <                                    # SESSION_YEAR SESSION_STRG
#                                                                              #
#                                                                              #
#   > % < Defined by Start and End time                                        # RADIO_2
#                 yyyy mm dd     hh mm ss           yyyy mm dd     hh mm ss    #
#         Start > %%%%%%%%%% < > %%%%%%%% <   End > %%%%%%%%%% < > %%%%%%%% <  # STADAT STATIM ENDDAT ENDTIM
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXO 3: Options part II                                                    #
#                                                                              #
# RULE FOR APPLYING PHASE SHIFT CORRECTIONS FROM HDR ON READING OBS            #
#   Phase shift corrections appeared with RINEX version 2.12                   #
#   Rule                        > %%%%%%%%%%%% <                               # PHSCORRAPPL
#                                                                              #
# REJECTION OF FAKE OBSERVATIONS                                               #
#   Maximal freq. considered    > %%%%%% <           (0: no rejection)         # REJFAKEOBSMAXFRQ
#   Tolerance                   > %%%%%% <                                     # REJFAKEOBSTOL
#                                                                              #
# COMMENTS                                                                     #
#   Agency running program      > %%%%%%%%%%%%%%%%%%% <                        # AGENCY
#                                                                              #
# > Comments____________________________________________________      <        # COMMENTS
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
# > Digital_Object_Identifier_(DOI)_____________________________      <        # RX_DOI
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
# > License_of_use______________________________________________      <        # RX_LICENSE
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
# > Station_information_________________________________________      <        # RX_STAINF
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXO 4.1: Check Content of RINEX Header I                                  #
#                                                                              #
# Action if marker name doesn't match file name  > %%%%%%%%% <                 # AOF_ANT_MRK_NAM
#                                                                              #
# ACTIONS IN CASE OF MISSING MANDATORY HEADER RECORDS                          #
#   Missing record: GLONASS SLOT / FRQ # > %%%%%%%%% <  (RINEX vers ge 3.01)   # AOM_GLO_FRQ_NBR
#   Missing record: GLONASS COD/PHS/BIS  > %%%%%%%%% <  (RINEX vers ge 3.02)   # AOM_GLO_PHS_BIS
#   Missing record: SYS / PHASE SHIFT    > %%%%%%%%% <  (RINEX vers ge 2.12)   # AOM_SYS_PHS
#   Other missing mandatory records      > %%%%%%%%% <                         # AOM_GENERAL
#                                                                              #
#     NONE@@@@: Just continue                                                  #
#     WARNING@: Write warning and continue                                     #
#     SKIP@@@@: Skip file and continue with next file                          #
#     ERROR@@@: Write error message and stop processing                        #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXO 4.2: Check Content of RINEX Header II                                 #
#                                                                              #
# ACTIONS IN CASE OF INCONSISTENCIES BETWEEN HEADERS (1/3)                     #
# (also between multiple headers in the same RINEX file)                       #
#   Observer name                        > %%%%%%%%% <                         # AOI_OBS_NAME
#   Observing agency                     > %%%%%%%%% <                         # AOI_AGENCY
#   Marker name                          > %%%%%%%%% <                         # AOI_ANT_MRK_NAM
#   Marker number                        > %%%%%%%%% <                         # AOI_ANT_MRK_NBR
#   Marker type                          > %%%%%%%%% <  (RINEX vers ge 2.20)   # AOI_ANT_MRK_TYP
#   Geocentric approx. ant. marker pos.  > %%%%%%%%% <                         # AOI_APR_ANT_MRK_POS
#   Center of mass XYZ                   > %%%%%%%%% <  (RINEX vers ge 2.20)   # AOI_COM_XYZ
#   Interval                             > %%%%%%%%% <                         # AOI_INTERVAL
#   Leap seconds                         > %%%%%%%%% <                         # AOI_LEAP_SEC
#                                                                              #
#     NONE@@@@: No check is done            (keep contents of the first one)   #
#     WARNING@: Write warning and continue  (keep contents of the first one)   #
#     SKIP@@@@: Skip file and continue with next file                          #
#     ERROR@@@: Write error message and stop processing                        #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXO 4.3: Check Content of RINEX Header III                                #
#                                                                              #
# ACTIONS IN CASE OF INCONSISTENCIES BETWEEN HEADERS (2/3)                     #
# (also between multiple headers in the same RINEX file)                       #
#   Antenna number                       > %%%%%%%%% <                         # AOI_ANT_NBR
#   Antenna type                         > %%%%%%%%% <                         # AOI_ANT_TYP
#   Relative ARP height/eccentricity     > %%%%%%%%% <                         # AOI_REL_ARP_HEN
#   Antenna reference point XYZ          > %%%%%%%%% <  (RINEX vers ge 2.20)   # AOI_REL_ARP_XYZ
#   Antenna phase center                 > %%%%%%%%% <  (RINEX vers ge 3.00)   # AOI_ANT_PHA_CTR
#   Antenna sight                        > %%%%%%%%% <  (RINEX vers ge 2.20)   # AOI_ANT_BS_XYZ
#   Antenna zero-direction azimuth       > %%%%%%%%% <  (RINEX vers ge 3.00)   # AOI_ANT_ZD_AZI
#   Antenna zero-direction XYZ           > %%%%%%%%% <  (RINEX vers ge 3.00)   # AOI_ANT_ZD_XYZ
#                                                                              #
#     NONE@@@@: No check is done            (keep contents of the first one)   #
#     WARNING@: Write warning and continue  (keep contents of the first one)   #
#     SKIP@@@@: Skip file and continue with next file                          #
#     ERROR@@@: Write error message and stop processing                        #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXO 4.4: Check Content of RINEX Header IV                                 #
#                                                                              #
# ACTIONS IN CASE OF INCONSISTENCIES BETWEEN HEADERS (3/3)                     #
# (also between multiple headers in the same RINEX file)                       #
#   Receiver number                      > %%%%%%%%% <                         # AOI_RCV_NBR
#   Receiver type                        > %%%%%%%%% <                         # AOI_RCV_TYP
#   Receiver version                     > %%%%%%%%% <                         # AOI_RCV_VERS
#   Signal strength unit                 > %%%%%%%%% <  (RINEX vers ge 3.00)   # AOI_SNR_UNIT
#   GLONASS frequency number             > %%%%%%%%% <  (RINEX vers ge 3.01)   # AOI_GLO_FRQ_NBR
#   GLONASS phase bias correction        > %%%%%%%%% <  (RINEX vers ge 3.02)   # AOI_GLO_PHS_BIS
#   Default wavelength factors           > %%%%%%%%% <  (RINEX vers lt 3.00)   # AOI_DEF_WLFS
#   Wavelength factors of satellite      > %%%%%%%%% <  (RINEX vers lt 3.00)   # AOI_SAT_WLFS
#                                                                              #
#     NONE@@@@: No check is done            (keep contents of the first one)   #
#     WARNING@: Write warning and continue  (keep contents of the first one)   #
#     SKIP@@@@: Skip file and continue with next file                          #
#     ERROR@@@: Write error message and stop processing                        #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# CCRNXO 5: Check Content of RINEX Data Records                                #
#                                                                              #
# ACTIONS IN CASE OF EPOCH EVENTS                                              #
#   Flag 1: Power failure between epochs  > %%%%%%%%% <                        # AOE_POW_FAIL
#   Flag 2: Start moving antenna          > %%%%%%%%% <                        # AOE_MOV_ANT
#   Flag 3: New site occupation           > %%%%%%%%% <                        # AOE_NEW_SITE
#   Flag 5: External event                > %%%%%%%%% <                        # AOE_EXT_EVT
#   Flag 6: Cycle slip record             > %%%%%%%%% <                        # AOE_CYCL_SLIP
#   Flag 7                                > %%%%%%%%% <                        # AOE_FLAG_7
#   Flag 8                                > %%%%%%%%% <                        # AOE_FLAG_8
#   Flag 9                                > %%%%%%%%% <                        # AOE_FLAG_9
#                                                                              #
#     NONE@@@@: Just continue                                                  #
#     WARNING@: Write warning and continue                                     #
#     SKIP@@@@: Skip file and continue with next file                          #
#     ERROR@@@: Write error message and stop processing                        #
#                                                                              #
# END_PANEL ####################################################################
