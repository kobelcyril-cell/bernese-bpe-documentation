
! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 1  "${R}/EC_FZDMGNSS"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${R}/EC_FZDMGNSS/STA/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2021"
  ## widget = comment
  # $Y+0

SES_INFO 1  "0700"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! Environment variables
! ---------------------
ENVIRONMENT 7
  "U" "/gpfs/homefs/aiub/ec20f882/GPSUSER_ZDM"
  "T" "/scratch/local/ec20f882"
  "X" "/gpfs/homefs/aiub/aiub_datapool/software/BERN/GPS"
  "P" "/storage/research/aiub_code"
  "K" "/storage/research/aiub_u_camp"
  "R" "/storage/scratch/aiub/camp"
  "USER" "ec20f882"
  ## widget = initmenu; pointer = ENVIR_LIST

! --------------------------------------------------------------------
! INPUTFILES                                                         |
! --------------------------------------------------------------------
! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

! General constants
! -----------------
CONST 1  "${X}/GEN/CONST."
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1
  # CONST.

DESCR_CONST 1  "General constants"

! Geodetic datum
! --------------
DATUM 1  "${X}/GEN/DATUM."
  ## widget = selwin; path = PTH_DATUM; ext = EXT_DATUM; maxfiles = 1
  # DATUM.

DESCR_DATUM 1  "Geodetic datum"

! Satellite Information
! ---------------------
SATELL 1  "${X}/GEN/$(SATINF).$(PCV)"
  ## widget = selwin; path = PTH_SATELL; ext = EXT_SATELL; maxfiles = 1
  # $(SATINF).$(PCV)

DESCR_SATELL 1  "Satellite information"

! Satellite Problems
! ------------------
SATCRUX 1  "${X}/GEN/$(SATCRX)_2021.CRX"
  ## widget = selwin; path = PTH_SATCRUX; ext = EXT_SATCRUX; maxfiles = 1
  ## emptyallowed = true
  # $(SATCRX)_$Y+0

DESCR_SATCRUX 1  "Satellite problems"

! Observation type
! ----------------
RADIO_Z 1  "1"
