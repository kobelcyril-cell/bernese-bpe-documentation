
! Environment Variables
! ---------------------
ENVIRONMENT 0
  ## widget = initmenu; pointer = ENVIR_LIST

! SOME KEYWORDS FOR AUTOMATIC OUTPUT
! ----------------------------------
CAMPAIGN 0
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 0
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "$Y+0"
  ## widget = comment

SES_INFO 1  "$S+0"
  ## widget = comment

USR_INFO 1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

! General Constants
! -----------------
CONST 1  "CONST"
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1

DESCR_CONST 1  "General constants"

! Satellite Information File
! --------------------------
SATELL 1  "$(SATINF)"
  ## widget = selwin; path = PTH_SATELL; ext = EXT_SATELL; maxfiles = 1

DESCR_SATELL 1  "Satellite information"

! Summary File
! ------------
SUMFIL 1  "OBSXTR$Z$YSS+0"
  ## widget = lineedit; path = DIR_SUM; ext = EXT_SUM

DESCR_SUMFIL 1  "Summary file"

! Switch of observation type
! --------------------------
RADIO_Z 1  "1"
  ## widget = radiobutton; group = OBSTYP

MSG_RADIO_Z 1  "Selection of zero-difference files"

RADIO_S 1  "0"
  ## widget = radiobutton; group = OBSTYP

MSG_RADIO_S 1  "Selection of single-difference files"

! Zero diff., Phase
! -----------------
PZHFIL 1  "????$S+0"
  ## widget = selwin; path = DIR_PZH; ext = EXT_PZH; maxfiles = 999
  ## emptyallowed = true; activeif = RADIO_Z = 1

MSG_PZHFIL 1  "Phase zero difference observations"

PZHFIL_TXT_COL_1 1  "Phase zero difference observations"

PZHFIL_PTH_COL_2 0
  ## widget = initmenu; pointer = DIR_PZO

PZHFIL_EXT_COL_2 0
  ## widget = initmenu; pointer = EXT_PZO

PZHFIL_TXT_COL_2 1  ""

! Single diff., Phase
! -------------------
PSHFIL 0
  ## widget = selwin; path = DIR_PSH; ext = EXT_PSH; maxfiles = 999
  ## emptyallowed = true; activeif = RADIO_S = 1
  # 

MSG_PSHFIL 1  "Phase single difference observations"

PSHFIL_TXT_COL_1 1  "Phase single difference observations"

PSHFIL_PTH_COL_2 0
  ## widget = initmenu; pointer = DIR_PSO

PSHFIL_EXT_COL_2 0
  ## widget = initmenu; pointer = EXT_PSO

PSHFIL_TXT_COL_2 1  ""

! Program Output File
! -------------------
SYSODEF 1  "0"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "OBSXTR$Z$YSS+0"
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false

DESCR_SYSOUT 1  "Program output"

! Error Message File
! ------------------
ERRMRG 1  "1"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 0
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false
  # ERROR

DESCR_SYSERR 1  "Error message"

! Subroutine/function debug output
! --------------------------------
DEBUG_STKLOG 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

MSG_DEBUG_STKLOG 1  "Debug stack log output"

DEBUG_SUMMARY 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

MSG_DEBUG_SUMMARY 1  "Debug summary output"

DEBUG_INTERVAL 1  "00 01 00"
  ## widget = lineedit; check_type = time

MSG_DEBUG_INTERVAL 1  "Interval for intermediate debug summary"

! Title: new entry
! ----------------
TITLE 1  "Extract observation statistics for ZD-processing"
  ## widget = lineedit

MSG_TITLE 1  "Title line"

WHAT 1  "OBSERVATIONS"
  ## widget = combobox; editable = false; cards = OBSERVATIONS AMBIGUITIES

MSG_WHAT 1  "Define which information shall be extracted"

! GNSS to be included in the statistics
! -------------------------------------
! GPS
USE_G 1  "1"
  ## widget = checkbox

MSG_USE_G 1  "Include GPS in the statistics"

! GLONASS
USE_R 1  "1"
  ## widget = checkbox

MSG_USE_R 1  "Include GLONASS in the statistics"

! Galileo
USE_E 1  "1"
  ## widget = checkbox

MSG_USE_E 1  "Include Galileo in the statistics"

! SBAS
USE_S 1  "1"
  ## widget = checkbox

MSG_USE_S 1  "Include SBAS in the statistics"

! BeiDou
USE_C 1  "1"
  ## widget = checkbox

MSG_USE_C 1  "Include BeiDou in the statistics"

! QZSS
USE_J 1  "1"
  ## widget = checkbox

MSG_USE_J 1  "Include QZSS in the statistics"

SATLST 1  ""
  ## widget = lineedit; activeif = WHAT / AMBIGUITIES

MSG_SATLST 1  "Satellite list"

RECANT 1  "NOTHING"
  ## widget = combobox; editable = false
  ## cards = ANTENNA_TYPE RECEIVER_TYPE NOTHING

MSG_RECANT 1  "Add equipment information"

GREP 1  ""
  ## widget = lineedit

MSG_GREP 1  "ID string for extraction"

VALID_OBS 1  "70"
  ## widget = lineedit; check_min = 0; activeif = LSTFILE / _ OR DELFILE / _

MSG_VALID_OBS 1  "Percentage of valid observations requested"

MIN_OBS 1  "5000"
  ## widget = lineedit; check_min = 0; activeif = LSTFILE / _ OR DELFILE / _

MSG_MIN_OBS 1  "Minimum number of expected observations"

! Get a list of good files?
! -------------------------
LSTFILE 1  ""
  ## widget = lineedit; path = DIR_LST; ext = EXT_LST

DESCR_LSTFILE 1  "File with the list of selected RINEX files"

! Get a list of bad files?
! ------------------------
DELFILE 1  ""
  ## widget = lineedit; path = DIR_DEL; ext = EXT_DEL

DESCR_DELFILE 1  "File with the list of unselected RINEX files"


# BEGIN_PANEL NO_CONDITION #####################################################
# Extract observation file header - OBSXTR 1: Filenames                        #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files    > % <                                            # SHOWGEN
#                                                                              #
# OBSERVATION FILES                                                            #
#   > % < Zero diff.@@ phase files > %%%%%%%%%%%% <                            # RADIO_Z PZHFIL
#   > % < Single diff. phase files > %%%%%%%%%%%% <                            # RADIO_S PSHFIL
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output    > % < use OBSXTR.Lnn            or      > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages    > % < merged to program output  or      > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# RESULT FILES                                                                 #
#   Summary file                   > %%%%%%%%%%%% <                            # SUMFIL
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# OBSXTR 1.1: General Files                                                    #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants       > %%%%%%%%%%%% <                                   # CONST
#   Satellite information   > %%%%%%%%%%%% <                                   # SATELL
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# OBSXTR 2: Options for extractions                                            #
#                                                                              #
# TITLE  > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <  # TITLE
#                                                                              #
# OPTIONS TO DEFINE THE OUTPUT                                                 #
#    Which information shall be extracted > %%%%%%%%%%%%% <                    # WHAT
#                                                                              #
# SATELLITES TO BE INCLUDED IN THE STATISTICS                                  #
#          > % < GPS            > % < GLONASS        > % < Galileo             # USE_G USE_R USE_E
#          > % < SBAS           > % < BeiDou         > % < QZSS                # USE_S USE_C USE_J
#    List of satellites to be added       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # SATLST
#                                                                              #
# EXTENSIONS TO THE PROGRAM OUTPUT                                             #
#    Add equipment information            > %%%%%%%%%%%%% <                    # RECANT
#    ID string for extraction             > %%%%% <                            # GREP
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL WHAT = OBSERVATIONS ##############################################
# OBSXTR 3: Observation file selection                                         #
#                                                                              #
# FILENAMES                                                                    #
#   File with the list of selected@@ observation files   > %%%%%%%% <          # LSTFILE
#   File with the list of unselected observation files   > %%%%%%%% <          # DELFILE
#                                                                              #
# OBSERVATION FILE SELECTION                                                   #
#   Percentage of valid observations requested           > %%%% <              # VALID_OBS
#   Minimum number of expected observations              > %%%% <              # MIN_OBS
#                                                                              #
# END_PANEL ####################################################################
