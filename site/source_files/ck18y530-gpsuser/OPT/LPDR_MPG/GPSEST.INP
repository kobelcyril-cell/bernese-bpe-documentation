# BEGIN_PANEL NO_CONDITION #####################################################
# PARAMETER ESTIMATION - GPSEST 1.1: Input Files 1                             #
#                                                                              #
# GENERAL FILES AND PROCESSING MODE                                            #
#   Space geodetic technique       > %%%%%% <                                  # GEOTEC
#   Differencing level             > %%%%%% <                                  # DIFLVL
#   LEO data processing            > % <                                       # LEOPROC
#   Show all general files         > % <                                       # SHOWGEN
#                                                                              #
# OBSERVATION FILES                                                            #
#   Phase observations             > %%%%%%%%%%%% <      > %%%%%%%%%%%% <      # PSFILES PZFILES
#   Code@ observations             > %%%%%%%%%%%% <      > %%%%%%%%%%%% <      # CSFILES CZFILES
#   Range observations             > %%%%%%%%%%%% <                            # RZFILES
#                                                                              #
# MAIN INPUT FILES                                                             #
#   Station coordinates            > %%%%%%%%%%%% <                            # COORD
#   Standard orbits                > %%%%%%%%%%%% <     (new) > %%%%%%%%%%%% < # STDORB STDORB_NEW
#   Earth rotation parameters      > %%%%%%%%%%%% <                            # POLE
#   Satellite clock corrections    > %%%%%%%%%%%% <                            # SATCLK
#   Observable-specific biases     > %%%%%%%%%%%% < > % < NL phase biases from CLK # DCBINP NLBCLK
#   VMF grid file                  > %%%%%%%%%%%% <                            # VMF_FILES
#   Ionosphere models              > %%%%%%%%%%%% <                            # IONOS
#                                                                              #
# CORRECTIONS FOR LOADING EFFECTS AND CENTER OF MASS                           #
#   Ocean tidal loading            > %%%%%%%%%%%% <                            # OCNLOAD
#   Atmospheric tidal loading      > %%%%%%%%%%%% <                            # ATMLOAD
#     related error handling       > %%%%%%%%%%%% <                            # OPTLOAD
#   Geocenter coordinates          > %%%%%%%%%%%% <     (for CMC)              # GCCINP
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# GPSEST 1.2: Input Files 2                                                    #
#                                                                              #
# ADDITIONAL INPUT FILES                                                       #
#   Satellite orbit partials       > %%%%%%%%%%%% <                            # RPRCOE
#   Clock RINEX file               > %%%%%%%%%%%% <                            # RXCLKIN
#   Inter-system biases            > %%%%%%%%%%%% <                            # ISBINP
#   Estimated troposphere          > %%%%%%%%%%%% <                            # TROPEST
#   Meteorological data            > %%%%%%%%%%%% <                            # METFIL
#                                                                              #
# GRIDDED LOADING PARAMETERS                                                   #
#   Atmospheric pressure           > %%%%%%%%%%%% <                            # ALOAD_FILES
#   Ocean, non-tidal               > %%%%%%%%%%%% <                            # ONTLD_FILES
#   Hydrostatic pressure           > %%%%%%%%%%%% <                            # HLOAD_FILES
#                                                                              #
# AUXILIARY STATION FILES                                                      #
#   Station information            > %%%%%%%%%%%% <                            # STAINFO
#   Kinematic coordinates          > %%%%%%%%%%%% <                            # KININP
#   Observation sigma factors      > %%%%%%%%%%%% <                            # STAWGT
#   Directional obs. sigma factors > %%%%%%%%%%%% <                            # DIRWGT
#   Station eccentricities         > %%%%%%%%%%%% <                            # ECCENT
#   Clock collocation              > %%%%%%%%%%%% <                            # INCLKTIE
# END_PANEL ####################################################################


# BEGIN_PANEL LEOPROC = 1 OR GEOTEC = SLR ######################################
# GPSEST 1.3: LEO- and SLR-specific Input Files                                #
#                                                                              #
# LEO-SPECIFIC INPUT FILES                                                     #
#   Standard orbits                > %%%%%%%%%%%% <     (new) > %%%%%%%%%%%% < # LEOSTD LEOSTD_NEW
#   Orbit partial derivatives      > %%%%%%%%%%%% <                            # LEORPR
#   Attitude data                  > %%%%%%%%%%%% <                            # ATTIT
#   Kinematic velocities           > %%%%%%%%%%%% <                            # KINVEL
#                                                                              #
# SLR-SPECIFIC INPUT FILES                                                     #
#   Data handling (biases, CoM)    > %%%%%%%%%%%% <                            # RGBINP
#   LEO precise orbits             > %%%%%%%%%%%% <                            # LEOPRE
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# GPSEST 1.4: General Files                                                    #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants           > %%%%%%%%%%%% <                               # CONST
#   Geodetic datum              > %%%%%%%%%%%% <                               # DATUM
#   Antenna corrections         > %%%%%%%%%%%% < > % < Consider ant. rotations # PHASECC USE_ANTAZI
#   Observation selection       > %%%%%%%%%%%% <                               # OBSSEL
#   Satellite information       > %%%%%%%%%%%% <                               # SATELL
#   Satellite problems          > %%%%%%%%%%%% <                               # SATCRUX
#   Earth potential coefficients> %%%%%%%%%%%% <                               # POTCOE
#   Time-var. C20,C21,S21       > %%%%%%%%%%%% <                               # CS2021
#   Time-var. zonals            > %%%%%%%%%%%% <                               # ZONALS
#   Subdaily ERP model          > %%%%%%%%%%%% <                               # SUBMOD
#   Nutation model              > %%%%%%%%%%%% <                               # NUTMOD
#   SINEX header file           > %%%%%%%%%%%% <                               # SINEXIN
#   IONEX control file          > %%%%%%%%%%%% <                               # IONEXCF
#   GPS-UTC time difference     > %%%%%%%%%%%% <                               # GPSUTC
#   Frequency information       > %%%%%%%%%%%% <                               # FRQINFO
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <# CAMPAIGN
#   Selected session              Year> %%%% <  Session> %%%% <                # YR4_INFO SES_INFO
#   Session table               > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <# SESSION_TABLE
#                                                                              #
# TEMPORARY FILES                                                              #
#   Scratch files               > %%%%%%%% <    > %%%%%%%% <    > %%%%%%%% <   # AUXFIL AUXFIL1 KINSCR
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWMAX = 1 ######################################################
# GPSEST 1.5: Array Dimension Specification                                    #
#                                                                              #
# MAXIMUM ARRAY DIMENSIONS (OVERALL)                                           #
#   MAXLOC: Parameters                               > %%%%%% <                # MAXLOC
#   MAXFIL: Files                                    > %%%%%% <                # MAXFIL
#   MAXSTA: Stations                                 > %%%%%% <                # MAXSTA
#   MAXSAT: Satellites                               > %%%%%% <                # MAXSAT
#   MAXAMB: Ambiguities per observation file         > %%%%%% <                # MAXAMB
#                                                                              #
# MAXIMUM ARRAY DIMENSIONS (SIMULTANEOUSLY PROCESSED)                          #
