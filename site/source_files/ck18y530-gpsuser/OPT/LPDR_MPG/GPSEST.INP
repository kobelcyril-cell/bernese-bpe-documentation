  ## widget = checkbox

MSG_AZISAT_BAD 1  "Use faulty AZISAT for SAT_PCV"

! Min. Elevation
! --------------
MINEL 1  "3"
  ## widget = lineedit; emptyallowed = false; check_type = integer
  ## check_min = 0; check_max = 90

MSG_MINEL 1  "Elevation cutoff angle"

! Sampling interval
! -------------
SAMPLE 1  "30"
  ## widget = lineedit; check_type = integer; check_min = 0
  ## activeif = GEOTEC = GNSS

MSG_SAMPLE 1  "Sampling interval"

! Tolerance for simultaneity
! --------------------------
CORRINTV 1  "500"
  ## widget = lineedit; check_type = integer; check_min = 1
  ## activeif = GEOTEC = GNSS

MSG_CORRINTV 1  "Tolerance for simultaneity"

