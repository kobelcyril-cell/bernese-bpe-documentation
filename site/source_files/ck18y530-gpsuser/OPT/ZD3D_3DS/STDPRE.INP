# BEGIN_PANEL NO_CONDITION #####################################################
# CONVERT STANDARD TO PRECISE ORBITS - STDPRE 1: Filenames                     #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files      > % <                                          # SHOWGEN
#                                                                              #
# INPUT FILES                                                                  #
#   Standard orbits             > %%%%%%%%%%%% <   (new) > %%%%%%%%%%%% <      # STDORB STDORB_NEW
#   Orbital elements file       > %%%%%%%%%%%% <                               # IMPELE
#   Satellite clock corrections                                                #
#   > % < BERNESE format        > %%%%%%%%%%%% <                               # RADIO_CB SATCLK
#   > % < Clock RINEX file      > %%%%%%%%%%%% <                               # RADIO_CR RXCLKIN
#   Earth rotation parameters   > %%%%%%%%%%%% <                               # POLE
#   Ocean tidal loading         > %%%%%%%%%%%% <     (for CMC)                 # OCNLOAD
#   Atmospheric tidal loading   > %%%%%%%%%%%% <     (for CMC)                 # ATMLOAD
#   Coordinate file             > %%%%%%%%%%%% <     (for geodetic datum)      # CSYSTEM_CRD
#                                                                              #
# RESULT FILES                                                                 #
#   Precise orbits output file  > %%%%%%%%%%% <                                # PREOUT
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output         > % < use STDPRE.Lnn            or > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages         > % < merged to program output  or > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# TITLE > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# STDPRE 1.1: General Files                                                    #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants       > %%%%%%%%%%%% <                                   # CONST
#   Satellite information   > %%%%%%%%%%%% <                                   # SATELL
#   Subdaily ERP model      > %%%%%%%%%%%% <                                   # SUBMOD
#   Nutation model          > %%%%%%%%%%%% <                                   # NUTMOD
#   Satellite problems      > %%%%%%%%%%%% <                                   # SATCRUX
#   GPS-UTC time difference > %%%%%%%%%%%% <                                   # GPSUTC
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# STDPRE 2: Options                                                            #
#                                                                              #
# TYPE OF PRECISE EPHEMERIS FILE                                               #
#   Format type                                > %%%%%%% <                     # FORMAT
#   Write the velocities                       > % <                           # VELOCITIES
#                                                                              #
# SATELLITE SELECTION            >  %%%%%%%%%%%%%%%% <                         # SATSELECT
#          > % < GPS             > % < GLONASS         > % < Galileo           # USE_G USE_R USE_E
#          > % < SBAS            > % < BeiDou          > % < QZSS              # USE_S USE_C USE_J
#          > % < LEO                                                           # USE_L
#                                                                              #
#   The satellites in the following list will be     > %%%%%%%%%%%% <          # USESAT
#   Satellite list > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # SATLST
#                                                                              #
# TABULAR INTERVAL                             > %%%% < seconds                # TABINT
#   Specify a time window                      > % <                           # USEWIN
#                                                                              #
# LENGTH OF FIT INTERVAL                                                       #
#   For orbits                                 > %%%%%% < hours                # FITORB
#   For clocks                                 > %%%%%% < hours                # FITCLK
#   No prediction if observed for less than    > %%%%%% < hours                # NOPRED
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWILRS = 1 #####################################################
# STDPRE 2.01: ILRS-specific Output                                            #
#                                                                              #
# OPTIONS FOR ILRS BENCHMARK                   > % <                           # BENCH
#   Orbit output file                          > %%%%%%%%%%%% <                # ORBILRS
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL FORMAT = SP1 #####################################################
# STDPRE 2.1: Options for SP1 Formatted Precise Orbit File                     #
#                                                                              #
#                                                                              #
#   Agency             > %%% <                                                 # AGENCYO
#                                                                              #
#   Orbit type         > %% <         F: for "fit"                             # ORBTYPO
#                                     B: for "broadcast"                       #
#                                     E: for "extrapolated"                    #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL FORMAT = SP3C/D  OR  FORMAT = SP3C  OR  FORMAT = SP3 #############
# STDPRE 2.2: Options for New Formatted Precise Orbit File                     #
#                                                                              #
# > Comment_lines_for_precise_orbit_file_______________________________   <    # TITPRE
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#   Title 1    > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE1
#   Title 2    > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE2
#   Title 3    > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE3
#   Title 4    > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE4
#   Model identifiers in last title line > % < (IGS convention)                # TITOPT4
#   CLK info                             > %%% <                               # CLKINFO
#                                                                              #
#                                                                              #
#                                                                              #
#   Agency                               > %%%% <                              # AGENCYN
#                                                                              #
#   Orbit type                           > %%%% <                              # ORBTYPN
#   Time system                          > %%%% <                              # TIMESYS
#                                                                              #
#   Data description                     > %%%%%% <    > %%%%%%% <             # DATTYP DATDIF
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL USEWIN = 1 #######################################################
# STDPRE 2.3: Observation Window                                               #
#                                                                              #
# OBSERVATION WINDOW                                                           #
#                                                                              #
#   > % < Defined by Year and Session identifier                               # RADIO_1
#         Year > %%%% <    Session > %%%% <                                    # SESSION_YEAR SESSION_STRG
#                                                                              #
#                                                                              #
#   > % < Defined by Start and End times                                       # RADIO_2
#                 yyyy mm dd     hh mm ss           yyyy mm dd     hh mm ss    #
#         Start > %%%%%%%%%% < > %%%%%%%% <   End > %%%%%%%%%% < > %%%%%%%% <  # STADAT STATIM ENDDAT ENDTIM
#                                                                              #
# END_PANEL ####################################################################
