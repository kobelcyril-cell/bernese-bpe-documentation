# BEGIN_PANEL NO_CONDITION #####################################################
# CREATE/UPDATE STANDARD ORBITS - ORBGEN 1: Input Files                        #
#                                                                              #
# GENERAL FILES                                                                #
#   Show files for force modelling      > % <                                  # SHOWFRC
#   Show all general files              > % <                                  # SHOWGEN 
#                                                                              #
# INPUT FILES                                                                  #
# > % < Start with precise orbits       > %%%%%%%%%%%% <                       # RADIO_P PREFIL
#         Use with general ERP file     > % <                                  # GENPOLE
#         Check consistency of PCV model> % <                                  # CHKPCV
#                                                                              #
# > % < Update standard orbit                                                  # RADIO_E
#            Orbital elements           > %%%%%%%%%%%% <                       # IMPORB
#                                                                              #
#   Earth rotation parameters           > %%%%%%%%%%%% <                       # POLE
#   Ocean tidal loading                 > %%%%%%%%%%%% <     (for CMC)         # OCNLOAD
#   Atmospheric tidal loading           > %%%%%%%%%%%% <     (for CMC)         # ATMLOAD
#   Geocenter coordinates               > %%%%%%%%%%%% <     (for CMC)         # GCCINP
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWFRC = 1 ######################################################
# ORBGEN 1.1: Files for Force Modelling                                        #
#                                                                              #
# INPUT FILES FOR GRAVITATIONAL FORCE MODELLING                                #
#   Earth potential coefficients > %%%%%%%%%%%% <                              # POTCOE
#     apply linear trend         > % <                                         # POTCOEL
#     apply periodic terms       > % <                                         # POTCOEP
#   Time-variable C20,C21,S21    > %%%%%%%%%%%% <                              # CS2021
#   Time-variable zonals         > %%%%%%%%%%%% <                              # ZONALS
#   Solid Earth tides            > %%%%%%%%%%%% <                              # SETIDES
#   Ocean tides file             > %%%%%%%%%%%% <                              # OTIDES
#   Admittances file             > %%%%%%%%%%%% <                              # OTIDAD
#   Atmosphere tides files       > %%%%%%%%%%%% <      File type     > %%% <   # ATIDES ATIDTYP
#   A&O dealiasing               > %%%%%%%%%%%% <      apply > %%%%%%%%%%%% <  # AODL1B AODSEL
#   Ocean pole tide              > %%%%%%%%%%%% <                              # OCPLTD
#   Love numbers                 > %%%%%%%%%%%% <                              # LOVNUM
#   Planetary ephemeris          > %%%%%%%%%%%% <                              # JPLEPH
#                                                                              #
# INPUT FILES FOR NON-GRAVITATIONAL FORCE MODELLING                            #
#   Attitude for LEO satellites              > %%%%%%%%%%%% <                  # ATTIT
#   Satellite macro model                    > %%%%%%%%%%%% <                  # PLATDEF
#   Albedo reflectivity                      > %%%%%%%%%%%% <                  # ALBREFL
#   Albedo emissivity                        > %%%%%%%%%%%% <                  # ALBEMIS
#   F10.7 flux index and APP (MSIS, DTM2013) > %%%%%%%%%%%% <   defaults> % <  # FLXAPFIL FLXAPDEF
#   Explicit satellite maneuvers             > %%%%%%%%%%%% <                  # MANINFO
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# ORBGEN 1.2: General Files                                                    #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants        > %%%%%%%%%%%% <                                  # CONST
#   Satellite problems       > %%%%%%%%%%%% <                                  # SATCRUX
#   Geodetic datum           > %%%%%%%%%%%% <                                  # DATUM
#   Satellite information    > %%%%%%%%%%%% <                                  # SATELL
#                            > % < Error if not in satellite information file  # SATFILERR
#   Subdaily ERP model       > %%%%%%%%%%%% <                                  # SUBMOD
#   Nutation model           > %%%%%%%%%%%% <                                  # NUTMOD
#   GPS-UTC time difference  > %%%%%%%%%%%% <                                  # GPSUTC
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign        > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <  # CAMPAIGN
#   Selected session           year> %%%% <  session> %%%% <                   # YR4_INFO SES_INFO
#   Session table            > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <  # SESSION_TABLE
#                                                                              #
# TEMPORARY FILES                                                              #
#   Scratch files            > %%%%%%%%%%%% <            > %%%%%%%%%%%% <      # AUXFIL  TABAUX
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# ORBGEN 2: Result and Output Files                                            #
#                                                                              #
# RESULT FILES                                                                 #
#   Standard orbits          > %%%%%%%%%%%% <                                  # STDOUT
#   Radiation pressure coeff.> %%%%%%%%%%%% <                                  # RPROUT
#   Residual file            > %%%%%%%%%%%% <                                  # RESIDRS
#                                                                              #
# OUTPUT FILES                                                                 #
#   Summary file             > %%%%%%%%%%%% <                                  # SUMFIL
#   Summary file for IGS-ACC > %%%%%%%%%%%% <                                  # SUMACC
#   Plot file of residuals   > %%%%%%%%%%%% <                                  # RESPLOT
#   A priori gravity field   > %%%%%%%%%%%% <                                  # GRVAPR
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output         > % < use ORBGEN.Lnn            or > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages         > % < merged to program output  or > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# ORBGEN 3.1: General Options                                                  #
#                                                                              #
# TITLE > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE
#                                                                              #
# TIME FRAME, POTENTIAL AND TIDAL CORRECTIONS                                  #
#   Time frame                   > %%%% <                                      # TIMFRAME
#   Earth potential degree       > %%%% <                                      # MXPOTDEG
#   Ocean pole tides max degree  > %%%% <                                      # MXOPLT
#   Ocean tides max degree       > %%%% <                                      # MXOCTI
#   Atmosphere tides max degree  > %%%% <                                      # MXATTI
#   AO dealiasing max degree     > %%%% <                                      # MXAOD
#   Apply CMC correction   OTL:  > % <         ATL: > % <         GCC: > % <   # CMCYN_O CMCYN_A GCCYN
#   Apply antenna offset         > % <                                         # ANTOFF
#   Do not apply mean pole model > % <  (to allow for exact resubstitution)    # MEAPOL
#                                                                              #
# GENERAL RELATIVISTIC CORRECTIONS                                             #
#   Schwarzschild term           > % <                                         # REL1
#   Lense-Thirring               > % <  (not IGS standard)                     # REL2
#   De Sitter                    > % <  (not IGS standard)                     # REL3
#   C20 effect                   > % <  (not IGS standard)                     # REL4
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# ORBGEN 3.1.2: Options                                                        #
#                                                                              #
# SATELLITE SELECTION            >  %%%%%%%%%%%%%%%% <                         # SATSELECT
#          > % < GPS             > % < GLONASS         > % < Galileo           # USE_G USE_R USE_E
#          > % < SBAS            > % < BeiDou          > % < QZSS              # USE_S USE_C USE_J
#                                                                              #
#   The satellites in the following list will be     > %%%%%%%%%%%% <          # USESAT
#   Satellite list > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # SATLST
#                                                                              #
# EXPERIMENTAL OPTIONS                                                         #
#   True attitude modelling of satellites                > % <                 # TRUEATTI
#   Print beta angle and attitude switch info to STDOUT  > % <                 # BETAOUT
#   Print yaw angle to SYSOUT file                       > % <                 # PRINTYAW
#   Print osculating elements to program output (OUT)    > % <                 # PRINTOSC
#   Print RMS of the orbit fit (summary)                 > % <                 # PRTFITRMS
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# ORBGEN 3.2: A priori Radiation Pressure Model                                #
#                                                                              #
# NON-CONSERVATIVE FORCES                                                      #
#   Solar radiation pressure       > %%%%%%%%%% <                              # SRPMODFL
#                                  > % < GPS    > % < GLONASS   > % < Galileo  # SRP_G SRP_R SRP_E
#                                  > % < SBAS   > % < BeiDou    > % < QZSS     # SRP_S SRP_C SRP_J
#   Apply partial shadow for LEO   > % <                                       # PARSHAD
#   Earth Radiation Pressure       > %%%%%%%%%% <                              # ERPMODFL
#     Reflected radiation          > % <                                       # ALBREFFL
#     Emitted@@ radiation          > % <                                       # ALBEMIFL
#     Numerical interpolation      > % <                                       # ALBINTER
#   Navigation Antenna Thrust      > % <                                       # ANTTHRFL
#   Thermal radiation              > % <                                       # TRMRADFL
#     (defined by macromodel)                                                  #
#   Rotation of solar panel        > %%%%%%%%%%%% <          Only for Jason-2/3# SPROT
#   Atmospheric force for LEO/SLR  > % <                                       # AIRDRGFL
#                                                                              #
# SCALING FACTORS FOR MACRO MODEL                                              #
#  Scaling mode                    > %%%%%%%%%% <                              # NCSMOD
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL AIRDRGFL = 1 #####################################################
# ORBGEN 3.2.1: Atmospheric Force Model                                        #
#                                                                              #
#  Air density model               > %%%%%%%%%% <                              # AIRMODE
#  Horizontal wind model           > %%%%%%%%%% <                              # AIRWIND
#  Drag coefficient                > %%%%%%%%%% <                              # AIRFIXC
#  Accommodation coefficient       > %%%%%%%%%% <                              # AIRCOEF
#                                                                              #
#    JB2008: F10.7 flux index            > %%%%%%%%%%%% <                      # AIRSOLAR
#    JB2008: Geomagnetic storm dTc values> %%%%%%%%%%%% <                      # DTCVAL
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL MANINFO / _ ######################################################
# ORBGEN 3.2.2: Explicit maneuvers                                             #
#                                                                              #
#   Use a priori accelerations > % <                                           # MACCAPR
#                                                                              #
#   Estimate accelerations     > % <                                           # MACCEST
#     Frame                    > %%% <                                         # MACCFRM
#                                                                              #
#     Polynomial degree        > %%% <                                         # MPOLDEG
#                                                                              #
#     a priori sigmas for:                                                     #
#             A0 [m/s**2]    A1 [m/s**3]    A2 [m/s**4]                        #
#       X/R > %%%%%%%%% <  > %%%%%%%%% <  > %%%%%%%%% <                        # MACCSIG10 MACCSIG11 MACCSIG12
#       Y/S > %%%%%%%%% <  > %%%%%%%%% <  > %%%%%%%%% <                        # MACCSIG20 MACCSIG21 MACCSIG22 
#       Z/W > %%%%%%%%% <  > %%%%%%%%% <  > %%%%%%%%% <                        # MACCSIG30 MACCSIG31 MACCSIG32
#                                                                              #
#   Do not estimate acceleration for maneuvers shorter than> %%%%% <sec.       # MMINLEN
#                                                                              #
#                                                                              #
# > % < MANEUVER-SPECIFIC PARAMETER SETUP                                      # MANSPC
# > SAT EPOCH______________ DEG A0_XR A0_YS A0_ZW A1_XR A1_YS A1_ZW A2_XR A2_YS A2_ZW < # MANGROUP
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NCSMOD /= NONE AND PLATDEF /= _ ##################################
# ORBGEN 3.2.3: Scaling Factors Activated                                      #
#                                                                              #
# RADIATION SCALING FACTOR ESTIMATION                                          #
#   Scaling factor options                                > %%%%%%%%%% <       # NCSTYP
#     Solar direct@@@ radiation pressure (SRP)            > % <                # SCLSRP
#     Earth reflected radiation pressure (REF)            > % <                # SCLREF
#     Earth emitted@@ radiation pressure (EMI)            > % <                # SCLEMI
#                                                                              #
# ATMOSPHERIC FORCE SCALING FACTOR ESTIMATION FOR LEO                          #
#   Scaling factor options                                > % <                # SCLAIR
#                                                                              #
# SCALING FACTOR SETTINGS                                                      #
#   Initialize scaling factors to zero                    > % <                # SCLZER
#   Absolute sigma for satellite specific scaling factors > %%%%%%%%%% <       # SIGSCL
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# ORBGEN 3.3: Numerical Integration                                            #
#                                                                              #
# PRINT RESIDUALS                           > %%%%%% <                         # PRTRESID
#   In RSW Coordinates                      > % <                              # RESSYS
#                                                                              #
# NUMERICAL INTEGRATION                                                        #
#   Number of iterations                    > %%% <                            # NUMITER
#   Stop after RMS improvement is lower than> % < > %%%% <[%]                  # AUTOITER RMSIMPR
#                                                                              #
# EQUATION OF MOTION                                                           #
#   Polynomial degree                       > %%% <                            # POLDEGR
#   Length of interval                      > %%%%%%%% <  (hh mm ss)           # LENINTER
#                                                                              #
# VARIATIONAL EQUATIONS                                                        #
#   Polynomial degree                       > %%% <                            # VARPOLDG
#   Length of interval                      > %%%%%%%% <  (hh mm ss)           # VARLNINT
#   Additional sets                         > %%% < (only relevant for LEO)    # ADDVAR
#   Use extended RPR Format                 > % <   (only intended for LEO)    # RPRFRM
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL RADIO_E = 0 ######################################################
# ORBGEN 4: Parameter Selection                                                #
#                                                                              #
# DYNAMICAL ORBIT PARAMETERS                                                   #
#   Apart from six osculating elements, estimate the following parameters:     #
#                                                                              #
#   Default model                                > %%%%%%%%%% <                # DEFMODEL
#   Model-specific (default) setup of empirical parameters > % <               # DEFPAR
#                                                                              #
#   Manual selection of parameters and their scaling (for output only):        #
#   PAR1 > % < > %%%%%% <    PAR4 > % < > %%%%%% <    PAR7 > % < > %%%%%% <    # PAR1 SCL1 PAR4 SCL4 PAR7 SCL7
#   PAR2 > % < > %%%%%% <    PAR5 > % < > %%%%%% <    PAR8 > % < > %%%%%% <    # PAR2 SCL2 PAR5 SCL5 PAR8 SCL8
#   PAR3 > % < > %%%%%% <    PAR6 > % < > %%%%%% <    PAR9 > % < > %%%%%% <    # PAR3 SCL3 PAR6 SCL6 PAR9 SCL9
#                                                                              #
#  MODEL  ECOM   ECOM2  ECOM2-D1  ECOM2-YD1  ECOM-TB   ECOM-TBM  RSW    DRSW   #
#                                                                              #
#  PAR1   E30    E30    E30       E30        T30C1b    T30C1b    L30    E30    #
#  PAR2   E20    E20    E20       E20        T20S3b    T20S3b    L20    L20    #
#  PAR3   E10    E10    E10       E10        T1S2uC1b  T1S2uC1b  L10    L10    #
#  PAR4   E3C1u  E3C2u  E3C2u     E3C2u      T3C2uC1b  T3C2uC1b  L3C1u  L3C1u  #
#  PAR5   E2C1u  E3C4u  E3C1u     E3C1u      T3C4uC1b  T3C4uC1b  L2C1u  L2C1u  #
#  PAR6   E1C1u  E1C1u  E1C1u     E1C1u      T2C2uS2b  T2C2uS2b  L1C1u  L1C1u  #
#  PAR7   E3S1u  E3S2u  E3S2u     E3S2u      T3S2uC1b  T3S2uC1b  L3S1u  L3S1u  #
#  PAR8   E2S1u  E3S4u  E3S1u     E3S1u      T3S4uC1b  T3S4uC1b  L2S1u  L2S1u  #
#  PAR9   E1S1u  E1S1u  E1S1u     E1S1u      T2S2uS2b  T2S2uS2b  L1S1u  L1S1u  #
#                                                                              #
#  E3, E2, E1 axes correspond to D, Y, B, respectively                         #
#  L3, L2, L1 axes correspond to R, S, W, respectively                         #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL RADIO_E = 0 ######################################################
# ORBGEN 5: Stochastic Pulses and Satellite Accuracy Codes                     #
#                                                                              #
# STOCHASTIC PULSES IN (L3, L2, L1)-DIRECTIONS                                 #
#   Set up based on                             > %%%%%%%%%%%%%%%% <           # STOCH_NUMBER
#   List of satellites                          > %%%%%%%%%%%%%%%%%%% <        # STOCH_MANUAL
#   Parameter spacing                           > %%%%%%%% <(hh mm ss)         # STOCH_INTER
#                                                                              #
#   Orbital elements file                       > %%%%%%%%%%%%%%% <            # STOCH_FILE
#     (only used to provide epochs of stochastic pulses)                       #
#                                                                              #
# SATELLITE OPTIONS                                                            #
#   Exclude satellites with maneuvers           > % <                          # EXCLMAN
#   Use accuracy codes from SP3-file            > % <                          # USEAC
#   Exclude sat. with accuracy code 0           > % <                          # MINAC
#   Exclude sat. with acc. code exceeding       > %% <                         # MAXAC
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL RADIO_E = 0 ######################################################
# ORBGEN 6: Orbital Arc Definition                                             #
#                                                                              #
# ORBITAL ARC DEFINITION                                                       #
#   Number of arcs within the time window         > %%% <                      # NUMARCS
#                                                                              #
#   Time window to be covered by the standard orbits                           #
#                                                                              #
#   > % < Defined by Year and Session identifier                               # RADIO_1
#         Year > %%%% <     Session > %%%% <                                   # SESSION_YEAR SESSION_STRG
#                                                                              #
#                                                                              #
#   > % < Defined by Start and End times                                       # RADIO_2
#                 yyyy mm dd     hh mm ss           yyyy mm dd     hh mm ss    #
#         Start > %%%%%%%%%% < > %%%%%%%% <   End > %%%%%%%%%% < > %%%%%%%% <  # STADAT STATIM ENDDAT ENDTIM
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL RADIO_E = 1 ######################################################
# ORBGEN 7: Selection of Orbital Elements                                      #
#                                                                              #
# SELECTION OF ORBITAL ELEMENTS   > %%%% <                                     # NEWOLD
#                                                                              #
# LENGTH OF TIME INTERVAL         > %%%% < days                                # ARCINT
#                                                                              #
# END_PANEL ####################################################################
