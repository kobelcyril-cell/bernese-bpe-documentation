
! Environment Variables
! ---------------------
ENVIRONMENT 9
  "U" "/storage/homefs/eb23z835/GPSUSER"
  "T" "/scratch/local/eb23z835"
  "X" "/storage/research/aiub_data/BSWsoftware/BERN/GPS"
  "P" "/storage/research/aiub_code"
  "K" "/storage/research/aiub_u_camp"
  "R" "/storage/scratch/aiub/camp"
  "USER" "eb23z835"
  "MODEL" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/MODEL"
  "CONFIG" "/storage/research/aiub_data/BSWsoftware/BERN/GLOBAL/CONFIG"
  ## widget = initmenu; pointer = ENVIR_LIST

! SOME KEYWORDS FOR AUTOMATIC OUTPUT
! ----------------------------------
CAMPAIGN 1  "${R}/EB_FZDMGNSS"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${R}/EB_FZDMGNSS/STA/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "2022"
  ## widget = comment
  # $Y+0

SES_INFO 1  "2430"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! -------------------------------------------------------------------------
! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

! General Constants
! -----------------
CONST 1  "${MODEL}/CONST.BSW"
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1
  # CONST

DESCR_CONST 1  "General constants"

! Satellite Information
! ---------------------
SATELL 1  "${CONFIG}/$(SATINF)_$(PCV).SAT"
  ## widget = selwin; path = PTH_SATELL; ext = EXT_SATELL; maxfiles = 1
  # $(SATINF)_$(PCV)

DESCR_SATELL 1  "Satellite information"

! Observation selection by new RECEIVER file
! ------------------------------------------
OBSSEL 1  "${CONFIG}/$(OBSSEL).SEL"
  ## widget = selwin; path = PTH_OBSSEL; ext = EXT_OBSSEL; maxfiles = 1
  ## emptyallowed = true
  # $(OBSSEL)

DESCR_OBSSEL 1  "Observation selection"

! Print RINEX observation statistics and selection results
! --------------------------------------------------------
PRTOSTAT 1  "1"
  ## widget = checkbox; activeif = OBSSEL / _

MSG_PRTOSTAT 1  "Print observation statistics"

! Print extended OBSSEL warnings (debugging)
! ------------------------------------------
EXTOUT 1  "0"
  ## widget = checkbox; activeif = OBSSEL / _

MSG_EXTOUT 1  "Print extended OBSSEL warnings"

! Satellite Problems
! ------------------
SATCRUX 1  "${CONFIG}/$(SATCRX).CRX"
  ## widget = selwin; path = PTH_SATCRUX; ext = EXT_SATCRUX; maxfiles = 1
  ## emptyallowed = true
  # $(SATCRX)

DESCR_SATCRUX 1  "Satellite problems"

! Rinex input file
! ----------------
RNXFIL_BSW 0
  ## widget = selwin; path = DIR_RBO; ext = EXT_RBO; emptyallowed = true
  ## maxfiles = 999
  # *_$YYYSS+0

RNXFIL_BSW_TXT_COL_1 1  "RINEX input files"

RNXFIL_BSW_PTH_COL_2 1  "${R}/EB_FZDMGNSS/RAW/"
  ## widget = initmenu; pointer = DIR_SMT

RNXFIL_BSW_EXT_COL_2 1  "SMT"
  ## widget = initmenu; pointer = EXT_SMT

MSG_RNXFIL_BSW 1  "RINEX files, Bernese internal naming"

