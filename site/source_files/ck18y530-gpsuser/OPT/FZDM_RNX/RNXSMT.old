# BEGIN_PANEL NO_CONDITION #####################################################
# CLEAN/SMOOTH OBSERVATION FILES - RNXSMT 1: Filenames                         #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files          > % <                                      # SHOWGEN
#                                                                              #
# INPUT FILES                                                                  #
#   RINEX observation files                                                    #
#     Bernese internal naming       > %%%%%%%%%%%%%%%%%% <                     # RNXFIL_BSW
#     RINEX3-style naming           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # RNXFIL_LONG
#     RINEX2-style naming           > %%%%%%%% <                               # RNXFIL_SHORT
#     Any naming convention         > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # RNXFIL
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output          > % < use RNXSMT.Lnn           or > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages          > % < merged to program output or > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# RNXSMT 1.1: General Files                                                    #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants          > %%%%%%%%%%%% <                                # CONST
#   Satellite information      > %%%%%%%%%%%% <                                # SATELL
#   Satellite problems         > %%%%%%%%%%%% <                                # SATCRUX
#                                                                              #
# RECEIVER-SPECIFIC OBSERVATION TYPES PRIORITY                                 #
#   Observation selection      > %%%%%%%%%%%% <                                # OBSSEL
#   Print selection            > % <                                           # PRTOSTAT
#   Print extended warnings    > % <                                           # EXTOUT
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNXSMT 2: Options                                                            #
#                                                                              #
# TITLE > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # TITLE
#                                                                              #
# OBSERVATION ARC DEFINITION                                                   #
#   Maximum number of records in a RINEX file  > %%%%%% <                      # MAXREC
#   Use observation window                     > % <                           # USEWIN
#   Skip observations with S1 and S2=0.000     > % <                           # RMSTON
#   Use C2 if P2 unavailable                   > % <                           # USEC2
#   Maximum gap in data to start a new arc     > %%%%% <seconds                # GAPARC
#   Minimum number of observations per arc     > %%% <                         # MINOBS
#                                                                              #
# DETECT CLOCK EVENTS                                                          #
#   Minimum size of a clock event              > %%%%% <nanoseconds            # CLKEVT
#   Tolerance for ms-jump detection            > %%%%% <milliseconds           # CYCEVT
#   Maximum number of events with unknown size > %%%%% <                       # MAXEVT
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNXSMT 3: RINEX options part I                                               #
#                                                                              #
# SATELLITE SYSTEMS                                                            #
#   GPS          > % <      GLONASS     > % <     Galileo      > % <           # USE_G USE_R USE_E
#   SBAS         > % <      BeiDou      > % <     QZSS         > % <           # USE_S USE_C USE_J
#                                                                              #
# STATION NAME TRANSLATION                                                     #
#   Gather station names from                  > %%%%%%%%%%%%% <               # STANAM
#   Station information                        > %%%%%%%%%%%% <                # STAINFO
#                                                                              #
# GENERAL RINEX OPTIONS                                                        #
#   Change hdr strings to upper case on read   > % <                           # RDRXHDUC
#   Only GPS/GLO and freq. 1 or 2 for RINEX 2  > % <                           # RX2_RESTR
#   Output errors from input headers           > % <                           # ERRFROMRXHDR
#   Write errors into output header comments   > % <                           # ERRTORXHDR
#   Write comments in header in old order      > % <                           # OLDCMTORD
#   Write leading zeros to timestamp of recs   > % <                           # WRTRECLDZERO
#   Write GNSS in obs. recs in alph. order     > % <                           # WRTRXRECALPH
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL USEWIN = 1 #######################################################
# RNXSMT 3.1: Observation Window                                               #
#                                                                              #
# OBSERVATION WINDOW                                                           #
#                                                                              #
#   > % < Defined by Year and Session identifier                               # RADIO_1
#         Year  > %%%% <   Session > %%%% <                                    # SESSION_YEAR SESSION_STRG
#                                                                              #
#                                                                              #
#   > % < Defined by Start and End times                                       # RADIO_2
#                 yyyy mm dd     hh mm ss           yyyy mm dd     hh mm ss    #
#         Start > %%%%%%%%%% < > %%%%%%%% <   End > %%%%%%%%%% < > %%%%%%%% <  # STADAT STATIM ENDDAT ENDTIM
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNXSMT 4: RINEX options part II                                              #
#                                                                              #
# SAMPLING                                                                     #
#   Sampling interval           > %%%%%% < seconds   (0: use all observations) # SAMPL
#   Offset to full minute       > %%%%%% < seconds                             # OFFSET
#   Sampling tolerance          > %%%%%% < seconds                             # SAMPLTOL
#                                                                              #
# RULE FOR APPLYING PHASE SHIFT CORRECTIONS FROM HDR ON READING OBS            #
#   Phase shift corrections appeared with RINEX version 2.12                   #
#   Rule                        > %%%%%%%%%%%% <                               # PHSCORRAPPL
#                                                                              #
# REJECTION OF FAKE OBSERVATIONS                                               #
#   Maximal freq. considered    > %%%%%% <           (0: no rejection)         # REJFAKEOBSMAXFRQ
#   Tolerance                   > %%%%%% <                                     # REJFAKEOBSTOL
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNXSMT 5: Screening Options                                                  #
#                                                                              #
# MELBOURNE-WUEBBENA LINEAR COMBINATION: SCREENING, CYCLE SLIP DETECTION       #
#   RMS of a clean arc for Melbourne-Wuebbena  > %%%%% <L5 cycles              # RMSL5
#   Minimum size of detectable cycle slips     > %%%%% <L5 cycles              # SLPMIN
#   Minimum size of detectable outliers        > %%%%% <L5 cycles              # SLPOUT
#                                                                              #
# GEOMETRY-FREE LINEAR COMBINATION: CYCLE SLIP CORRECTION                      #
#   Maximum gap for cycle slip correction      > %%%%% <seconds                # GAPL4
#   Number of L4 observations for fit          > %%% <                         # MINL4
#   RMS of L4 for fit and cycle slip correction> %%%%% <meters                 # RMSL4
#   Fix cycle slips in code observations       > % <                           # FIXSLP
#                                                                              #
# IONOSPHERE-FREE LINEAR COMBINATION: OUTLIER DETECTION                        #
#   RMS of an arc in ionosphere-free LC (L3-P3)> %%%%% <meters                 # RMSL3
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNXSMT 6: Output Options                                                     #
#                                                                              #
# OUTPUT OPTIONS                                                               #
#   Preprocess phase observations              > % <                           # FLGPHS
#   Use smoothed instead of raw code           > % <                           # FLGCOD
#   Output detail                              > %%%% <                        # PRTFLG
#                                                                              #
# SPECIAL OPTION                                                               #
#   Verify GLONASS frequency number            > % <                           # GLOFRQ
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RNXSMT 7: Check Content of RINEX Header                                      #
#                                                                              #
# Action if marker name doesn't match file name  > %%%%%%%%% <                 # AOF_ANT_MRK_NAM
#                                                                              #
# ACTIONS IN CASE OF MISSING MANDATORY HEADER RECORDS                          #
#   Missing record: GLONASS SLOT / FRQ # > %%%%%%%%% <  (RINEX vers ge 3.01)   # AOM_GLO_FRQ_NBR
#   Missing record: GLONASS COD/PHS/BIS  > %%%%%%%%% <  (RINEX vers ge 3.02)   # AOM_GLO_PHS_BIS
#   Missing record: SYS / PHASE SHIFT    > %%%%%%%%% <  (RINEX vers ge 2.12)   # AOM_SYS_PHS
#   Other missing mandatory records      > %%%%%%%%% <                         # AOM_GENERAL
#                                                                              #
# ACTIONS IN SPECIAL SITUATIONS BETWEEN OBSERVATIONS                           #
#   On epoch events                      > %%%%%%%%% <                         # EPOFLAG
#   On inconsistent header modifications > %%%%%%%%% <                         # AOI_HDRMOD
#                                                                              #
#     NONE@@@@: Just continue                                                  #
#     WARNING@: Write warning and continue                                     #
#     SKIP@@@@: Skip file and continue with next file                          #
#     ERROR@@@: Write error message and stop processing                        #
#                                                                              #
# END_PANEL ####################################################################
