# BEGIN_PANEL NO_CONDITION #####################################################
# TRANSFER RINEX NAVIGATION FILES TO PRECISE ORBITS - RXN2PRE 1: Filenames     #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files     > % <                                           # SHOWGEN
#                                                                              #
# RINEX INPUT FILES                                                            #
#   RINEX navigation files                                                     #
#     Bernese internal naming       > %%%%%%%%%%%%%%%%%%%% <                   # FILELIST_BSW
#     RINEX3-style naming           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # FILELIST_LONG
#     RINEX2-style naming   GPS@@@@ > %%%%%%%% <                               # FILELIST_GPS
#     RINEX2-style naming   GLONASS > %%%%%%%% <                               # FILELIST_GLO
#     RINEX2-style naming   Galileo > %%%%%%%% <                               # FILELIST_GAL
#     Any naming convention         > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # FILELIST
#                                                                              #
# RESULT FILE                                                                  #
#   Precise orbit file              > %%%%%%%%%%%% <                           # PREFIL
#   Observation-type specific biases> %%%%%%%%%%%% <  (not mandatory)          # OSBFIL
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output         > % < use RXN2PRE.Lnn           or > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages         > % < merged to program output  or > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# RXN2PRE 1.1: General Files                                                   #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants       > %%%%%%%%%%%% <                                   # CONST
#   Geodetic datum          > %%%%%%%%%%%% <                                   # DATUM
#   GPS-UTC seconds         > %%%%%%%%%%%% <                                   # GPSUTC
#   Satellite information   > %%%%%%%%%%%% < (unregistered and wrong freq)     # SATELL
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 2.1: Input Options I                                                 #
#                                                                              #
# TITLE FOR OUTPUT                                                             #
#   > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <       # TITLE
#                                                                              #
# TITLE FOR OSB FILE                                                           #
#   > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <       # OSBTITLE
#                                                                              #
# RINEX INPUT                                                                  #
#   Change hdr strings to upper case on read   > % <                           # RDRXHDUC
#                                                                              #
# PRECISE ORBIT FILE                                                           #
#   Format type                       > %%%%% <    (SP3C/D: New format)        # FORMAT
#   Tabular interval                  > %%%%% <    seconds                     # TABINT
#   Accuracy exponent for GLONASS     > %%% <      = LOG_2(accuracy/mm)        # GLOACCEXP
#                                                                              #
# TIME WINDOW FOR PRECISE ORBIT AND/OR OSB FILE                                #
#                                                                              #
#   > % < Defined by Year and Session identifier                               # RADIO_1
#         Year  > %%%% <     Session > %%%% <                                  # SESSION_YEAR SESSION_STRG
#                                                                              #
#   > % < Defined by Start and End times                                       # RADIO_2
#                 yyyy mm dd     hh mm ss           yyyy mm dd     hh mm ss    #
#         Start > %%%%%%%%%% < > %%%%%%%% <   End > %%%%%%%%%% < > %%%%%%%% <  # STADAT STATIM ENDDAT ENDTIM
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 2.2: Input Options II                                                #
#                                                                              #
# SATELLITE SYSTEMS                                                            #
#             (1)       (2)         (3)          (4)          (5)              #
#   GPS      > % <    > %%% <    > %%%%% <    > %%%%% <    > %%%%% <           # USE_G MINMSG_G BE_G BED_G ININT_G
#   GLONASS  > % <    > %%% <    > %%%%% <    > %%%%% <    > %%%%% <           # USE_R MINMSG_R BE_R BED_R ININT_R
#   Galileo  > % <    > %%% <    > %%%%% <    > %%%%% <    > %%%%% <           # USE_E MINMSG_E BE_E BED_E ININT_E
#   SBAS     > % <    > %%% <    > %%%%% <    > %%%%% <    > %%%%% <           # USE_S MINMSG_S BE_S BED_S ININT_S
#   BeiDou   > % <    > %%% <    > %%%%% <    > %%%%% <    > %%%%% <           # USE_C MINMSG_C BE_C BED_C ININT_C
#   QZSS     > % <    > %%% <    > %%%%% <    > %%%%% <    > %%%%% <           # USE_J MINMSG_J BE_J BED_J ININT_J
#   IRNSS    > % <    > %%% <    > %%%%% <    > %%%%% <    > %%%%% <           # USE_I MINMSG_I BE_I BED_I ININT_I
#                                                                              #
#   (1) Use the GNSS                                                           #
#   (2) Minimal number of broadcast messages                                   #
#   (3) Betw. two good epos: Max nb of bad epos or epo diffs (-1: not tested)  #
#   (4) Betw. two good epos: Max nb of bad epo diffs         (-1: not tested)  #
#   (5) Expected input interval [s]                                            #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 2.3: Input Options III                                               #
#                                                                              #
# DATUM (e.g. WGS - 84, ITRFxx, PZ - 90.02, ...)                               #
#   For interpreting broadcast from GPS        > %%%%%%%%%%%%%%%% <            # DATUM_G
#   For interpreting broadcast from GLONASS    > %%%%%%%%%%%%%%%% <            # DATUM_R
#   For interpreting broadcast from Galileo    > %%%%%%%%%%%%%%%% <            # DATUM_E
#   For interpreting broadcast from SBAS       > %%%%%%%%%%%%%%%% <            # DATUM_S
#   For interpreting broadcast from BeiDou     > %%%%%%%%%%%%%%%% <            # DATUM_C
#   For interpreting broadcast from QZSS       > %%%%%%%%%%%%%%%% <            # DATUM_J
#   For interpreting broadcast from IRNSS      > %%%%%%%%%%%%%%%% <            # DATUM_I
#                                                                              #
#   For writing precise ephemeris file data    > %%%%%%%%%%%%%%%% <            # DATUM_OUT_D
#                                                                              #
# DATUM shortcut                                                               #
#   For writing precise ephemeris file header  > %%%%% <  (WGS84, ITRFxx, ...) # DATUM_OUT_H
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 2.4: Input Options IV                                                #
#                                                                              #
# COMMENT LINES for precise orbit file                                         #
#                                                                              #
# > Comment_lines_for_precise_orbit_file_______________________________   <    # TITPRE
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
#                                                                              #
# SATELLITE OPTIONS                                                            #
#   Remove epochs where satellite is unhealthy                    > % <        # RM_UNHEALTHY
#   Remove epochs where satellite is unregistered                 > % < (*)    # RM_UNREGISTERED
#   Remove epochs where GLONASS sat. has wrong frequency slot nbr > % < (*)    # RM_WRONG_FRQ_NBS
#                                                                              #
#   (*) Needs satellite information file                                       #
#                                                                              #
# AUXILIARY INFORMATION                                                        #
#   Agency                       > %%%% <                                      # AGENCY
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.1: Definition of valid epochs                                      #
#                                                                              #
# Definition of valid epochs                                                   #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Sampling interval [s], 0 means no sampling                       #
#   Column 4: List of offsets to full minute [s], empty list means offset 0    #
#   Column 5: Sampling tolerance [s]                                           #
# > GNSS Block___ interval offsets_______________ tolerance      <             # EPOCHS_DEF
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.2: Limits for the norm of the satellite velocity                   #
#                                                                              #
# Satellite velocity [m/s] (Meaningful for GLONASS and SBAS only)              #
#   Column 1: GNSS (1 character), use 'R' or 'S'                               #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal satellite velocity [m/s]                                 #
#   Column 4: Maximal satellite velocity [m/s]                                 #
# > GNSS Block___ from_____ to_______      <                                   # LIM_VEL_NORM
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.3: Limits for the semi major axis                                  #
#                                                                              #
# Semi major axis [m]                                                          #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal semi major axis [m]                                      #
#   Column 4: Maximal semi major axis [m]                                      #
#   Column 5: Maximal absolute change between two good epochs [m]              #
#   Column 6: Additional maximal absolute change per second [m/s]              #
# > GNSS Block___ from_____ to_______ maxChgEpo maxChg_s_      <               # LIM_SEMI_MAJ_AXIS
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.4: Limits for the node                                             #
#                                                                              #
# Inclination [deg]                                                            #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal node [deg]                                               #
#   Column 4: Maximal node [deg]                                               #
#   Column 5: Maximal absolute change between two good epochs [deg]            #
#   Column 6: Additional maximal absolute change per second [deg/s]            #
# > GNSS Block___ from_____ to_______ maxChgEpo maxChg_s_      <               # LIM_NODE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.5: Limits for the rate of the node                                 #
#                                                                              #
# Rate of node [deg/s] (Doesn't apply for GLONASS or SBAS)                     #
#   Column 1: GNSS (1 character)                                               #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal rate of node [deg/s]                                     #
#   Column 4: Maximal rate of node [deg/s]                                     #
# > GNSS Block___ from_____ to_______      <                                   # LIM_NODE_DOT
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.6: Limits for the mean anomaly                                     #
#                                                                              #
# Inclination [deg]                                                            #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal mean anomaly [deg]                                       #
#   Column 4: Maximal mean anomaly [deg]                                       #
#   Column 5: Maximal absolute change between two good epochs [deg]            #
#   Column 6: Additional maximal absolute change per second [deg/s]            #
# > GNSS Block___ from_____ to_______ maxChgEpo maxChg_s_      <               # LIM_MEAN_ANOMALY
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.7: Limits for the eccentricity                                     #
#                                                                              #
# Eccentricity                                                                 #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal eccentricity                                             #
#   Column 4: Maximal eccentricity                                             #
#   Column 5: Maximal absolute change between two good epochs                  #
#   Column 6: Additional maximal absolute change per hour [1/h]                #
# > GNSS Block___ from_____ to_______ maxChgEpo maxChg_s_      <               # LIM_ECCENTRICITY
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.8: Limits for the inclination                                      #
#                                                                              #
# Inclination [deg]                                                            #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal inclination [deg]                                        #
#   Column 4: Maximal inclination [deg]                                        #
#   Column 5: Maximal absolute change between two good epochs [deg]            #
#   Column 6: Additional maximal absolute change per second [deg/s]            #
# > GNSS Block___ from_____ to_______ maxChgEpo maxChg_s_      <               # LIM_INCLINATION
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.9: Limits for the perigee                                          #
#                                                                              #
# Perigee [deg] (Minimum and maximum meaningful for QZSS only)                 #
#   Column 1: GNSS (1 character), empty means all GNSS                         #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal perigee [deg]                                            #
#   Column 4: Maximal perigee [deg]                                            #
#   Column 5: Maximal absolute change between two good epochs [deg]            #
#   Column 6: Additional maximal absolute change per hour [deg/h]              #
# > GNSS Block___ from_____ to_______ maxChgEpo maxChg_s_      <               # LIM_PERIGEE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.10: Limits for the correction to the mean motion                   #
#                                                                              #
# Correction to mean motion [deg/s] (Doesn't apply for GLONASS or SBAS)        #
#   Column 1: GNSS (1 character)                                               #
#   Column 2: Block name for one GNSS (one of the names has to be empty)       #
#   Column 3: Minimal correction to mean motion [deg/s]                        #
#   Column 4: Maximal correction to mean motion [deg/s]                        #
# > GNSS Block___ from_____ to_______      <                                   # LIM_DELTA_N
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 3.11: Additional configurations to detect bad navigation messages    #
#                                                                              #
# Column 1: GNSS (1 character), empty means all GNSS                           #
# Column 2: Block name for one GNSS (one of the names has to be empty)         #
# Column 3: Restrict block to given list of PRNs, no restrictions on empty list#
# > GNSS Block___ Restr_to_PRNs______________      <                           # GEN_BLK_CONF
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXN2PRE 4: Galileo data source priority list                                 #
#                                                                              #
# Bit-wise priorization of GPS L2 broadcast data sources,                      #
#  empty means no priorization at all                                          #
#  > %%%%% <                                                                   # GPS_DAT_SRC_PRIO
#                                                                              #
# Bit-wise priorization of Galileo broadcast data sources,                     #
#  empty means no priorization at all,                                         #
#  e.g. '4 1 2' means I/NAV E5b-I (3) have highest prioriy,                    #
#  '1' corresponds to I/NAV E1-B navigation messages                           #
#  '2' corresponds to F/NAV E5a-I navigation messages                          #
#  '4' corresponds to I/NAV E5b-I navigation messages                          #
#  > %%%%% <                                                                   # GAL_DAT_SRC_PRIO
#                                                                              #
# END_PANEL ####################################################################
