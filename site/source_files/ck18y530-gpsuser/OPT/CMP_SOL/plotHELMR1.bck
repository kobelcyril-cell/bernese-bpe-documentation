# BEGIN_PANEL NO_CONDITION #####################################################
# PLOT HELMERT-TRANSFORMATION RESULTS - plotHELMR1 1: Input/output files       #
#                                                                              #
# GENERAL CONFIGURATION                                                        #
#   Show general configuration        > % <                                    # SHOWGEN
#                                                                              #
# RESULT FILE                                                                  #
#   Show figure on the screen         > % <                                    # FIGSHOW
#   Name of the output file           > %%%%%%%%%%%%%%%%%%%%%%%% <             # FIGOUT
#                                       (extension defines the format)         #
#   Resolution of the figure          > %%%% < dpi                             # FIGRES
#                                                                              #
# TYPE OF PLOT:                       > %%%%%%%%%%%%%%%%%% <                   # FIGTYPE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# plotHELMR1 1.1: General Configuration                                        #
#                                                                              #
# FONT DEFINITIONS                                                             #
#   Title                        > %%%%%%%%%%%% <                              # TIT_FONTSIZE
#   Labels                       > %%%%%%%%%%%% <                              # LABEL_FONTSIZE
#   Legend                       > %%%%%%%%%%%% <                              # LEG_FONTSIZE
#                                                                              #
# COLOR DEFINITIONS                                                            #
#   Background color of the plot > %%%%%%%%%%%% <                              # BGCOLOR
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #########################################################
# plotHELMR1 2: Plot layout                                                        #
#                                                                                  #
# PLOT LAYOUT SPECIFICATION                                                        #
#   Size of the plot:  width > %%%%%%%%%% <    height  > %%%%%%%%%% <              # SIZEX SIZEY
#                                                                                  #
# PLOT AXIS SPECIFICATION                  Boundaries: > % < auto or               # XYAUTO
#              Labels at                                 Min         Max           #
#              epoch axis    > %%%%%%%%%%%%%%%%%%%%% < > %%%%%%%%%% <> %%%%%%%%%% <# LABEL_X TMIN TMAX
#              frequency                               > %%%%%%%%%% <> %%%%%%%%%% <#         XMIN XMAX
#   Plot  > % <RMS of transf.> %%%%%%%%%%%%%%%%%%%%% < > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_RMS LABEL_Y1 Y1MIN Y1MAX
#         > % <X-translation > %%%%%%%%%%%%%%%%%%%%% < > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_TX LABEL_Y2 Y2MIN Y2MAX
#         > % <Y-translation > %%%%%%%%%%%%%%%%%%%%% < > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_TY LABEL_Y3 Y3MIN Y3MAX
#         > % <Z-translation > %%%%%%%%%%%%%%%%%%%%% < > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_TZ LABEL_Y4 Y4MIN Y4MAX
#         > % <X-rotation    > %%%%%%%%%%%%%%%%%%%%% < > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_RX LABEL_Y5 Y5MIN Y5MAX
#         > % <Y-rotation    > %%%%%%%%%%%%%%%%%%%%% < > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_RY LABEL_Y6 Y6MIN Y6MAX
#         > % <Z-rotation    > %%%%%%%%%%%%%%%%%%%%% < > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_RZ LABEL_Y7 Y7MIN Y7MAX
#         > % <scale         > %%%%%%%%%%%%%%%%%%%%% < > %%%%%%%%%% <> %%%%%%%%%% <# PLOT_SC LABEL_Y8 Y8MIN Y8MAX
#                                                                                  #
# CONTENT OF THE PLOT                                                              #
#   Title > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <     # TITLE
#                                                                                  #
# END_PANEL ########################################################################


# BEGIN_PANEL NO_CONDITION #########################################################
# plotHELMR1 3: Time series for plotting                                           #
#                                                                                  #
#     Filename             color         symbol        size      label             #
# 1.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# HLMFIL_1 COLOR_1 SYMBOL_1 SSIZE_1 LABEL_1
# 2.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# HLMFIL_2 COLOR_2 SYMBOL_2 SSIZE_2 LABEL_2
# 3.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# HLMFIL_3 COLOR_3 SYMBOL_3 SSIZE_3 LABEL_3
# 4.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# HLMFIL_4 COLOR_4 SYMBOL_4 SSIZE_4 LABEL_4
# 5.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# HLMFIL_5 COLOR_5 SYMBOL_5 SSIZE_5 LABEL_5
# 6.> %%%%%%%%%%%% <     > %%%%%%%% <  > %%%%%%%% <  > %%% <   > %%%%%%%%%%%%%%%% <# HLMFIL_6 COLOR_6 SYMBOL_6 SSIZE_6 LABEL_6
#                                                                                  #
# END_PANEL ########################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotHELMR1 4: Legend layout                                                  #
#                                                                              #
# LEGEND LAYOUT SPECIFICATION                                                  #
# > % <  Legend:                                                               # LEGEND
#        Position  > %%%%%%%%%%%% <  X-off > %%%%% <  Y-off > %%%%% <          # LEG_POS LEG_ANCHOR_X LEG_ANCHOR_Y
#                    with respect to plot  > %%%%% <  component                # LEG_PLOT
#        Frame     > % <                       Num. Columns  > % <             # LEG_FRAME LEG_NCOLS
#        Title     > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <       # LEG_TITLE
#                                                                              #
# END_PANEL ####################################################################
