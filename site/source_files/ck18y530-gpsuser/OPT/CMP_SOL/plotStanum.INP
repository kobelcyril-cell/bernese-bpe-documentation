! ------------------------------
NQZS 1  "0"
  ## widget = checkbox

MSG_NQZS 1  "Plot lines for stations with QZS"

CQZS 1  ""
  ## widget = combobox; editable = true; activeif = NQZS = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CQZS 1  "Color for lines for stations with QZS"

WQZS 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NQZS = 1

