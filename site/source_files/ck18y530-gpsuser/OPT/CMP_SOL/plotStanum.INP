LQZS 1  ""
  ## widget = lineedit; activeif = NQZS = 1

MSG_LQZS 1  "Legend entry for stations with QZS"

! Options for stations with datum definition
! ------------------------------------------
NWGT 1  "0"
  ## widget = checkbox

MSG_NWGT 1  "Plot lines for stations with datum definition"

CWGT 1  "blue"
  ## widget = combobox; editable = true; activeif = NWGT = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CWGT 1  "Color for lines for stations with datum definition"

WWGT 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NWGT = 1

