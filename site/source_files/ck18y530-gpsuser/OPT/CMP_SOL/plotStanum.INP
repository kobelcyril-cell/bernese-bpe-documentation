
! Environment Variables
! ---------------------
ENVIRONMENT 0
  ## widget = initmenu; pointer = ENVIR_LIST

! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 0
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 0
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "$Y+0"
  ## widget = comment

SES_INFO 1  "$S+0"
  ## widget = comment

USR_INFO 1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show general configuration"

! Filename for resulting plots (output)
! -------------------------------------
FIGSHOW 1  "1"
  ## widget = checkbox

MSG_FIGSHOW 1  "Show resulting figure on the screen"

FIGOUT 1  "Stanum.png"
  ## widget = lineedit; path = DIR_FIG; ext = NO_EXT; maxfiles = 1

DESCR_FIGOUT 1  "Output file for plot of number of epochs"

FIGRES 1  "300"
  ## widget = lineedit; check_type = integer; check_min = 50

MSG_FIGRES 1  "Resolution of the figure"

! Input data: list of coordinate files
! ------------------------------------
CRDFIL 1  "$(CRD)*.CRD"
  ## widget = selwin; path = DIR_CRD; extList = EXT_CRD

MSG_CRDFIL 1  "Coordinate files"

! Options for all stations
! ------------------------
NSTA 1  "0"
  ## widget = checkbox

MSG_NSTA 1  "Plot lines for all stations"

CSTA 1  "blue"
  ## widget = combobox; editable = true; activeif = NSTA = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CSTA 1  "Color for all station line"

WSTA 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NSTA = 1

MSG_WSTA 1  "Line width for all stations"

LSTA 1  "All"
  ## widget = lineedit; activeif = NSTA = 1

MSG_LSTA 1  "Legend entry for all stations"

! Options for stations with GPS
! -----------------------------
NGPS 1  "1"
  ## widget = checkbox

MSG_NGPS 1  "Plot lines for stations with GPS"

CGPS 1  "blue"
  ## widget = combobox; editable = true; activeif = NGPS = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CGPS 1  "Color for lines for stations with GPS"

WGPS 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NGPS = 1

MSG_WGPS 1  "Line width for stations with GPS"

LGPS 1  "GPS"
  ## widget = lineedit; activeif = NGPS = 1

MSG_LGPS 1  "Legend entry for stations with GPS"

