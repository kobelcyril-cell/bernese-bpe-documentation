! Options for estimated stations
! ------------------------------
NEST 1  "0"
  ## widget = checkbox

MSG_NEST 1  "Plot lines for estimated stations"

CEST 1  "magenta"
  ## widget = combobox; editable = true; activeif = NEST = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CEST 1  "Color for lines for estimated stations"

WEST 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NEST = 1

MSG_WEST 1  "Line width for estimated stations"

LEST 1  "Estimated"
  ## widget = lineedit; activeif = NEST = 1

MSG_LEST 1  "Legend entry for estimated stations"

! Title: new entry
! ----------------
TITLE 1  "Number of stations"
  ## widget = lineedit

MSG_TITLE 1  "Title line"

TIT_FONTSIZE 1  "large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_TIT_FONTSIZE 1  "Font size in the title"

! Size of the plot
! ----------------
SIZEX 1  "12"
  ## widget = lineedit; check_type = real

MSG_SIZEX 1  "Width of the plot"

SIZEY 1  "8"
  ## widget = lineedit; check_type = real

MSG_SIZEY 1  "Height of the plot"

! Get boundaries of the plot
! --------------------------
XYAUTO 1  "0"
  ## widget = checkbox

MSG_XYAUTO 1  "Auto scale to a global map"

TMIN 1  "$YMD_STR-(67)"
  ## widget = lineedit; check_type = date; activeif = XYAUTO / 1

MSG_TMIN 1  "Lower bound time axis"

YMIN 1  ""
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_YMIN 1  "Lower bound data axis"

TMAX 1  "$YMD_STR+1"
  ## widget = lineedit; check_type = date; activeif = XYAUTO / 1

MSG_TMAX 1  "Upper bound time axis"

YMAX 1  ""
  ## widget = lineedit; check_type = real; activeif = XYAUTO / 1

MSG_YMAX 1  "Upper bound data axis"

LABEL_X 1  "Epoch"
  ## widget = lineedit

MSG_LABEL_X 1  "Label for the time axis"

LABEL_Y 1  "#"
  ## widget = lineedit

MSG_LABEL_Y 1  "Label for the data axis"

LABEL_FONTSIZE 1  "large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_LABEL_FONTSIZE 1  "Font size in the labels"

BGCOLOR 1  "white"
  ## widget = combobox; editable = true
  ## cards = white red green blue yellow orange magenta cyan grey

MSG_BGCOLOR 1  "Plot background color"

! Specify the legend characteristics
! ----------------------------------
LEGEND 1  "1"
  ## widget = checkbox

MSG_LEGEND 1  "Plot a legend"

LEG_POS 1  "best"
  ## widget = combobox; activeif = LEGEND = 1
  ## cards = right center/left upper/right lower/right best center lower/left center/right upper/left upper/center lower/center

MSG_LEG_POS 1  "Position of the legend"

LEG_ANCHOR_X 1  ""
  ## widget = lineedit; activeif = LEGEND = 1; check_type = real

MSG_LEG_ANCHOR_X 1  "Anchor point for legend position"

LEG_ANCHOR_Y 1  ""
  ## widget = lineedit; activeif = LEGEND = 1; check_type = real

MSG_LEG_ANCHOR_Y 1  "Anchor point for legend position"

LEG_NCOLS 1  "1"
  ## widget = spinbox; activeif = LEGEND = 1; range = 1 10 1

MSG_LEG_NCOLS 1  "Number of columns for legend"

LEG_FRAME 1  "1"
  ## widget = checkbox; activeif = LEGEND = 1

MSG_LEG_FRAME 1  "Plot a legend with a frame"

LEG_TITLE 1  ""
  ## widget = lineedit; activeif = LEGEND = 1

MSG_LEG_TITLE 1  "Title of the legend"

LEG_FONTSIZE 1  "x-large"
  ## widget = combobox
  ## cards = xx-small x-small small medium large x-large xx-large

MSG_LEG_FONTSIZE 1  "Font size in the legend"


# BEGIN_PANEL NO_CONDITION #####################################################
# PLOT STATION STATISTICS FROM COORD. FILES - plotStanum 1: Input/output files #
#                                                                              #
# GENERAL CONFIGURATION                                                        #
#   Show general configuration        > % <                                    # SHOWGEN
#                                                                              #
# INPUT FILE                                                                   #
#   Coordinate files to be evaluated  > %%%%%%%%%%%% <                         # CRDFIL
#                                                                              #
# RESULT FILE                                                                  #
#   Show figure on the screen         > % <                                    # FIGSHOW
#   Name of the output file           > %%%%%%%%%%%%%%%%%%%%%%%% <             # FIGOUT
#                                       (extension defines the format)         #
#   Resolution of the figure          > %%%% < dpi                             # FIGRES
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# plotStanum 1.1: General Configuration                                        #
#                                                                              #
# FONT DEFINITIONS                                                             #
#   Title                        > %%%%%%%%%%%% <                              # TIT_FONTSIZE
#   Labels                       > %%%%%%%%%%%% <                              # LABEL_FONTSIZE
#   Legend                       > %%%%%%%%%%%% <                              # LEG_FONTSIZE
#                                                                              #
# COLOR DEFINITIONS                                                            #
#   Background color of the plot > %%%%%%%%%%%% <                              # BGCOLOR
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotStanum 2: Plot layout                                                    #
#                                                                              #
# PLOT LAYOUT SPECIFICATION                                                    #
#   Size of the plot:      width    > %%%%%%%%%% <  height  > %%%%%%%%%% <     # SIZEX SIZEY
#                                                                              #
#   Boundaries: > % < auto or         epoch axis              data axis        # XYAUTO
#                     lower bound   > %%%%%%%%%% <          > %%%%%%%%%% <     # TMIN YMIN
#                     upper bound   > %%%%%%%%%% <          > %%%%%%%%%% <     # TMAX YMAX
#                                     (yyyy mm dd)                             #
#                                                                              #
#   Labels at  epoch axis > %%%%%%%%%%%%%%%%%%%%% <                            # LABEL_X
#              data axis  > %%%%%%%%%%%%%%%%%%%%% <                            # LABEL_Y
#                                                                              #
# CONTENT OF THE PLOT                                                          #
#   Title > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotStanum 3: Time series for plotting                                       #
#                                                                              #
# Select what to plot        color           width     label                   #
#       all:     > % <     > %%%%%%%% <    > %%% <   > %%%%%%%%%%%%%%%% <      # NSTA CSTA WSTA LSTA
# GNSS:                                                                        #
#     G GPS:     > % <     > %%%%%%%% <    > %%% <   > %%%%%%%%%%%%%%%% <      # NGPS CGPS WGPS LGPS
#     R GLONASS: > % <     > %%%%%%%% <    > %%% <   > %%%%%%%%%%%%%%%% <      # NGLO CGLO WGLO LGLO
#     E Galileo: > % <     > %%%%%%%% <    > %%% <   > %%%%%%%%%%%%%%%% <      # NGAL CGAL WGAL LGAL
#     C BeiDou:  > % <     > %%%%%%%% <    > %%% <   > %%%%%%%%%%%%%%%% <      # NBDS CBDS WBDS LBDS
#     J QZSS:    > % <     > %%%%%%%% <    > %%% <   > %%%%%%%%%%%%%%%% <      # NQZS CQZS WQZS LQZS
#     S SBAS:    > % <     > %%%%%%%% <    > %%% <   > %%%%%%%%%%%%%%%% <      # NSBS CSBS WSBS LSBS
# Flag:                                                                        #
#     W Datum    > % <     > %%%%%%%% <    > %%% <   > %%%%%%%%%%%%%%%% <      # NWGT CWGT WWGT LWGT
#     A Estimated> % <     > %%%%%%%% <    > %%% <   > %%%%%%%%%%%%%%%% <      # NEST CEST WEST LEST
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# plotStanum 4: Legend layout                                                  #
#                                                                              #
# LEGEND LAYOUT SPECIFICATION                                                  #
# > % <  Legend:                                                               # LEGEND
#        Position  > %%%%%%%%%%%% <  X-off > %%%%% <  Y-off > %%%%% <          # LEG_POS LEG_ANCHOR_X LEG_ANCHOR_Y
#        Frame     > % <                       Num. Columns  > % <             # LEG_FRAME LEG_NCOLS
#        Title     > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <       # LEG_TITLE
#                                                                              #
# END_PANEL ####################################################################
