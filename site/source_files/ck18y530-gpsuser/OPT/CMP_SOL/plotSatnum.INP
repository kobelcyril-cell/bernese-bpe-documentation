
! Environment Variables
! ---------------------
ENVIRONMENT 0
  ## widget = initmenu; pointer = ENVIR_LIST

! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 0
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 0
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "$Y+0"
  ## widget = comment

SES_INFO 1  "$S+0"
  ## widget = comment

USR_INFO 1  "${USER}"
  ## widget = comment

! Show general files
! ------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show general configuration"

! Filename for resulting plots (output)
! -------------------------------------
FIGSHOW 1  "1"
  ## widget = checkbox

MSG_FIGSHOW 1  "Show resulting figure on the screen"

FIGOUT 1  "Satnum.png"
  ## widget = lineedit; path = DIR_FIG; ext = NO_EXT; maxfiles = 1

DESCR_FIGOUT 1  "Output file for plot of number of epochs"

FIGRES 1  "300"
  ## widget = lineedit; check_type = integer; check_min = 50

MSG_FIGRES 1  "Resolution of the figure"

! Input data: list of precise files
! ---------------------------------
PREFIL 1  "F1I_*PRE"
  ## widget = selwin; path = DIR_PRE; extList = EXT_PRE

MSG_PREFIL 1  "Precise orbit files"

! Options for all satellites
! --------------------------
NSAT 1  "0"
  ## widget = checkbox

MSG_NSAT 1  "Plot lines for all satellites"

CSAT 1  ""
  ## widget = combobox; editable = true; activeif = NSAT = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CSAT 1  "Color for all satellites line"

WSAT 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NSAT = 1

MSG_WSAT 1  "Line width for all satellites"

LSAT 1  ""
  ## widget = lineedit; activeif = NSAT = 1

MSG_LSAT 1  "Legend entry for all satellites"

! Options for GPS satellites
! --------------------------
NGPS 1  "1"
  ## widget = checkbox

MSG_NGPS 1  "Plot lines for GPS satellites"

CGPS 1  "blue"
  ## widget = combobox; editable = true; activeif = NGPS = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CGPS 1  "Color for GPS satellites line"

WGPS 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NGPS = 1

MSG_WGPS 1  "Line width for GPS satellites"

LGPS 1  "GPS"
  ## widget = lineedit; activeif = NGPS = 1

MSG_LGPS 1  "Legend entry for GPS satellites"

