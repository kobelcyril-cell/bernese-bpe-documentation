! --------------------------
NBDS 1  "0"
  ## widget = checkbox

MSG_NBDS 1  "Plot lines for BDS satellites"

CBDS 1  ""
  ## widget = combobox; editable = true; activeif = NBDS = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CBDS 1  "Color for BDS satellites line"

WBDS 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NBDS = 1

MSG_WBDS 1  "Line width for BDS satellites"

LBDS 1  ""
  ## widget = lineedit; activeif = NBDS = 1

MSG_LBDS 1  "Legend entry for BDS satellites"

