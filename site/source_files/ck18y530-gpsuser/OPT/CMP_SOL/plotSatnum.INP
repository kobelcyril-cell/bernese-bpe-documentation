! --------------------------
NGAL 1  "1"
  ## widget = checkbox

MSG_NGAL 1  "Plot lines for GAL satellites"

CGAL 1  "red"
  ## widget = combobox; editable = true; activeif = NGAL = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CGAL 1  "Color for GAL satellites line"

WGAL 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NGAL = 1

MSG_WGAL 1  "Line width for GAL satellites"

LGAL 1  "Galileo"
  ## widget = lineedit; activeif = NGAL = 1

MSG_LGAL 1  "Legend entry for GAL satellites"

