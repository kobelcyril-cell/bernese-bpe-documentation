! --------------------------
NSBS 1  "0"
  ## widget = checkbox

MSG_NSBS 1  "Plot lines for SBS satellites"

CSBS 1  ""
  ## widget = combobox; editable = true; activeif = NSBS = 1
  ## cards = red green blue yellow orange magenta cyan grey

