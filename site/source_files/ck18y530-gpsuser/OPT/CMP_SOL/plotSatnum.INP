! --------------------------
NLEO 1  "0"
  ## widget = checkbox

MSG_NLEO 1  "Plot lines for LEO satellites"

CLEO 1  ""
  ## widget = combobox; editable = true; activeif = NLEO = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CLEO 1  "Color for LEO satellites line"

WLEO 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NLEO = 1

