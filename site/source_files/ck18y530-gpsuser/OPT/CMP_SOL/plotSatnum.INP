! --------------------------
NGLO 1  "1"
  ## widget = checkbox

MSG_NGLO 1  "Plot lines for GLO satellites"

CGLO 1  "green"
  ## widget = combobox; editable = true; activeif = NGLO = 1
  ## cards = red green blue yellow orange magenta cyan grey

MSG_CGLO 1  "Color for GLO satellites line"

WGLO 1  "3"
  ## widget = spinbox; range = 1 20 1; activeif = NGLO = 1

MSG_WGLO 1  "Line width for GLO satellites"

LGLO 1  "GLONASS"
  ## widget = lineedit; activeif = NGLO = 1

MSG_LGLO 1  "Legend entry for GLO satellites"

