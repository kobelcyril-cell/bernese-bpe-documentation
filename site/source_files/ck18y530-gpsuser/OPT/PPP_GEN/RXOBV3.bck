  ## widget = combobox; editable = false; cards = NONE WARNING SKIP ERROR

MSG_EPOFLAG 1  "What to do in case of event flag"


# BEGIN_PANEL NO_CONDITION #####################################################
# TRANSFER RINEX OBSERVATION FILES TO BERNESE FORMAT - RXOBV3 1: Filenames     #
#                                                                              #
# INPUT FILES                                                                  #
#   > % < Original RINEX observation files                                     # RADIO_O
#         Bernese internal naming  > %%%%%%%%%%%%%%%%%% <                      # RXOFILE_BSW
#         RINEX3-style naming      > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <      # RXOFILE_LONG
#         RINEX2-style naming      > %%%%%%%% <                                # RXOFILE_SHORT
#         Any naming convention    > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <      # RXOFILE
#                                                                              #
#   > % < Smoothed RINEX observation files                                     # RADIO_S
#                                  > %%%%%%%%%%%%%%%%%% <                      # SMTFILE
#                                                                              #
#   Station information            > %%%%%%%%%%%% <                            # STAINFO
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files         > % <                                       # SHOWGEN
#   Observation selection          > %%%%%%%%%%%% <                            # OBSSEL
#   Print observation statistics   > % <                                       # PRTOSTAT
#                                                                              #
# RESULT FILES                                                                 #
#   Measurement types to save                                                  #
#   > % <  Code > % <  Phase > % <                 > % <  Range                # RADIO_G SAVCOD SAVPHS RADIO_R
#                                                                              #
#   Update coordinates    > %%%%%%%%%%%% <      (blank if not used)            # COORD
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output        > % < use RXOBV3.Lnn           or > %%%%%%%%%%%% <   # SYSODEF SYSOUT
#   Error messages        > % < merged to program output or > %%%%%%%%%%%% <   # ERRMRG SYSERR
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1 ######################################################
# RXOBV3 1.1: General Files                                                    #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants       > %%%%%%%%%%%% <                                   # CONST
#   Satellite information   > %%%%%%%%%%%% <                                   # SATELL
#   Satellite problems      > %%%%%%%%%%%% <                                   # SATCRUX
#   Antenna corrections     > %%%%%%%%%%%% <                                   # PHASECC
#   GPS-UTC time difference > %%%%%%%%%%%% <                                   # GPSUTC
#   Abbreviation table      > %%%%%%%%%%%% <                                   # ABBREV
#   Frequency information   > %%%%%%%%%%%% <                                   # FRQINFO
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# TEMPORARY FILES                                                              #
#   Scratch files       > %%%%%%%%%%%% <   > %%%%%%%%%%%% <   > %%%%%%%%%%%% < # AUXFIL  AUXCOD AUXPHS
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXOBV3 2: Input Options 1                                                    #
#                                                                              #
# TITLE   > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <            # TITLE
#                                                                              #
# GNSS SELECTION                                                               #
#          > % < GPS            > % < GLONASS        > % < Galileo             # USE_G USE_R USE_E
#          > % < SBAS           > % < BeiDou         > % < QZSS                # USE_S USE_C USE_J
#                                                                              #
# STATION NAMES                                                                #
#   Gather station names from                        > %%%%%%%%%%%%% <         # STANAM
#   Action if station not in abbreviation list       > %%%%%%%% <              # ABBUPD
#                                                                              #
# SESSION IDENTIFIER                                                           #
#   Session ID used for Bernese observation files    > %%%% < (blank: AUTO)    # SESSID
#                                                                              #
# GENERAL RINEX OPTIONS                                                        #
#   Use observation window                     > % <                           # USEWIN
#   Change hdr strings to upper case on read   > % <                           # RDRXHDUC
#   Only GPS/GLO and freq. 1 or 2 for RINEX 2  > % <                           # RX2_RESTR
#   Output errors from input headers           > % <                           # ERRFROMRXHDR
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL USEWIN = 1 #######################################################
# RXOBV3 2.1: Observation Window                                               #
#                                                                              #
# OBSERVATION WINDOW                                                           #
#                                                                              #
#   > % < Defined by Year and Session identifier                               # RADIO_1
#         Year  > %%%% <   Session > %%%% <                                    # SESSION_YEAR SESSION_STRG
#                                                                              #
#   > % < Defined by Start and End times                                       # RADIO_2
#                 yyyy mm dd     hh mm ss           yyyy mm dd     hh mm ss    #
#         Start > %%%%%%%%%% < > %%%%%%%% <   End > %%%%%%%%%% < > %%%%%%%% <  # STADAT STATIM ENDDAT ENDTIM
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXOBV3 3: Input Options 2                                                    #
#                                                                              #
# SAMPLING                                                                     #
#   Sampling interval             > %%%%%% < seconds  (0: use all observations)# SAMPL
#   Sampling offset to full minute> %%%%%% < seconds                           # OFFSET
#   Sampling tolerance            > %%%%%% < seconds                           # SAMPLTOL
#                                                                              #
# RULE FOR APPLYING PHASE SHIFT CORRECTIONS FROM HDR ON READING OBS            #
#   Phase shift corrections appeared with RINEX version 2.12                   #
#   Rule                          > %%%%%%%%%%%% <                             # PHSCORRAPPL
#                                                                              #
# REJECTION OF FAKE OBSERVATIONS                                               #
#   Maximal freq. considered      > %%%%%% <         (0: no rejection)         # REJFAKEOBSMAXFRQ
#   Tolerance                     > %%%%%% <                                   # REJFAKEOBSTOL
#                                                                              #
# REJECTION OF INCONSISTENT CODE OBSERVATIONS                                  #
#   Maximal difference between C1 and C2 (in meters)> %%%%%%% <                # REJINCONSCODTOL
#                                                                              #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXOBV3 4: Input Options 3                                                    #
#                                                                              #
# SIGNAL STRENGTH REQUIREMENTS                                                 #
#   Minimum signal strength                         > % <                      # MINSIG
#   Accept signal strength = 0                      > % <                      # ACCEPT0
#   Accept cycle slip flags from RINEX              > % <                      # ACCEPTCS
#                                                                              #
# REQUIREMENTS REGARDING THE CONTENT OF BERNESE OBSERVATION FILES              #
#   Define conditions to write a Bernese obs. file  > % <                      # IREQ
#                                                                              #
# OPTIONS CONCERNING ANTENNAS                                                  #
#   Consider radome code of the antennas            > % <                      # RADOME
#   Correct position of radome code                 > % <                      # CORRAD
#   Check antenna correction file for antenna type  > % < else> %%%%%%%%%%%% < # DOANTVER ANTVER
#   Ignore measurements with antenna calib. method  > %%%%%%%%%%%%%%%%%%%% <   # ANTMETH
#                                                                              #
# FREQUENCY CHECK FOR SLR                                                      #
#   Check frequency information file for frequency  > %%%%%%%%%%%% <           # FRQVER
#                                                                              #
# ROUNDING OF OBSERVATION EPOCH                                                #
#    Round fractional part of observation time      > %%%%%%%%%%%%%% <         # ROUNDOT
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL IREQ = 1 AND RADIO_G = 1 #########################################
# RXOBV3 4.1: Requirements to write a Bernese observation file                 #
#                                                                              #
# GENERAL REQUIREMENTS                                                         #
#   Minimum number of epochs required per file    > %%%%% <  epochs            # REQEPO
#   Maximum number of ambiguities per file        > %%%%% <                    # REQAMB
#   Skip files without GPS observations           > % <                        # REQGPS
#                                                                              #
# MINIMUM NUMBER OF SATELLITES/OBSERVATIONS PER FILE                           #
#   Exclude observations from the Bernese observation file                     #
#   if it contains less     satellites       phase      code     observations  #
#       for   all systems     > %%% <      > %%%%% <  > %%%%% <                # REQSATALL REQPHAALL REQCODALL
#       for   GPS             > %%% <      > %%%%% <  > %%%%% <                # REQSATGPS REQPHAGPS REQCODGPS
#       for   GLONASS         > %%% <      > %%%%% <  > %%%%% <                # REQSATGLO REQPHAGLO REQCODGLO
#       for   Galileo         > %%% <      > %%%%% <  > %%%%% <                # REQSATGAL REQPHAGAL REQCODGAL
#       for   SBAS            > %%% <      > %%%%% <  > %%%%% <                # REQSATGEO REQPHAGEO REQCODGEO
#       for   BeiDou          > %%% <      > %%%%% <  > %%%%% <                # REQSATBEI REQPHABEI REQCODBEI
#       for   QZSS            > %%% <      > %%%%% <  > %%%%% <                # REQSATQZS REQPHAQZS REQCODQZS
#                                                                              #
# REQUIREMENTS REGARDING OBSERVATION TYPES                                     #
#   Allow station with only phase data            > % <                        # REQPHAONLY
#   Allow station with only code@ data            > % <                        # REQCODONLY
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL STAFLG == 999 AND STAINFO / _ ####################################
# RXOBV3 4.2: Flags Concerning Station Information File                        #
#                                                                              #
# ATTENTION!!!!    THIS IS DUMMY AT THE MOMENT!!!!                             #
# To make the flag handling active, please modify SR GTSTAFLG.f90              #
#                                                                              #
# FLAGS CONCERNING STATION INFORMATION FILE                                    #
#   Consider flags                                    > % <                    # STAFLG
#                                                                              #
# FLAGS TO BE CONSIDERED                                                       #
#   Type 001: Renaming of stations  > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <    # FLG001
#   Type 002: Station information   > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <    # FLG002
#   Type 003: Station problems      > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <    # FLG003
#   Type 005: Marker type           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <    # FLG005
#                                                                              #
#   Flag 999: Any flag will be considered                                      #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL STAINFO / _ ######################################################
# RXOBV3 5.1: Check Content of RINEX Header 1                                  #
#                                                                              #
# ACTIONS IN CASE OF INCONSISTENCIES                                           #
#   Station name      > %%%%%%%%% <     Try also filename      > % <           # TSTANAM TRYFILE
#   Antenna type      > %%%%%%%%% <                                            # TANTTYP
#   Antenna number    > %%%%%%%%% <                                            # TANTNUM
#   Antenna position  > %%%%%%%%% <                                            # TANTPOS
#   Marker type       > %%%%%%%%% <                                            # TMRKTYP
#   Receiver type     > %%%%%%%%% <                                            # TRCVTYP
#   Receiver number   > %%%%%%%%% <                                            # TRCVNUM
#                                                                              #
#     NO_CHECK : No check is done                                              #
#     WARNING@ : Write warning and continue                                    #
#     SKIP@@@@ : Skip file and continue with next file                         #
#     ERROR@@@ : Write error message and stop processing                       #
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL STAINFO / _ ######################################################
# RXOBV3 5.2: Check Content of RINEX Header 2                                  #
#                                                                              #
# ADDITIONAL VERIFICATION                                                      #
#   Verify station name/number using                > % < > %%%%%%%%%%%%%% <   # DOSTAVER STAVER
#   Verify station name using RINEX filename        > % <                      # RNXVER
#                                                                              #
# HANDLING OF KNOWN INCONSISTENCIES                                            #
#   Accepted station information                    > %%%%%%%%% <              # RNXINFO
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL NO_CONDITION #####################################################
# RXOBV3 6: Check Content of RINEX Header 3                                    #
#                                                                              #
# Action if marker name doesn't match file name  > %%%%%%%%% <                 # AOF_ANT_MRK_NAM
#                                                                              #
# ACTIONS IN CASE OF MISSING MANDATORY HEADER RECORDS                          #
#   Missing record: GLONASS SLOT / FRQ # > %%%%%%%%% <  (RINEX vers ge 3.01)   # AOM_GLO_FRQ_NBR
#   Missing record: GLONASS COD/PHS/BIS  > %%%%%%%%% <  (RINEX vers ge 3.02)   # AOM_GLO_PHS_BIS
#   Missing record: SYS / PHASE SHIFT    > %%%%%%%%% <  (RINEX vers ge 2.12)   # AOM_SYS_PHS
#   Other missing mandatory records      > %%%%%%%%% <                         # AOM_GENERAL
#                                                                              #
# ACTIONS IN SPECIAL SITUATIONS BETWEEN OBSERVATIONS                           #
#   On epoch events                      > %%%%%%%%% <                         # EPOFLAG
#   On inconsistent header modifications > %%%%%%%%% <                         # AOI_HDRMOD
#                                                                              #
#     NONE@@@@: Just continue                                                  #
#     WARNING@: Write warning and continue                                     #
#     SKIP@@@@: Skip file and continue with next file                          #
#     ERROR@@@: Write error message and stop processing                        #
#                                                                              #
# END_PANEL ####################################################################
