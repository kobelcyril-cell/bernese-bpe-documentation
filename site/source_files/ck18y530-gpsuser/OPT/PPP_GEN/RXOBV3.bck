! RINEX options
! -------------
RDRXHDUC 1  "1"
  ## widget = checkbox

MSG_RDRXHDUC 1  "Change header strings to upper case on read"

RX2_RESTR 1  "1"
  ## widget = checkbox

MSG_RX2_RESTR 1  "Only GPS/GLO and freq. 1 or 2 for RINEX 2"

REJFAKEOBSMAXFRQ 1  "2"
  ## widget = spinbox; range = 0 9 1

MSG_REJFAKEOBSMAXFRQ 1  "Maximal frequency for fake observation rejection"

REJFAKEOBSTOL 1  "1d-4"
  ## widget = lineedit

MSG_REJFAKEOBSTOL 1  "Tolerance for fake observation rejection"

REJINCONSCODTOL 1  ""
  ## widget = lineedit; check_type = integer; check_min = 100

MSG_REJINCONSCODTOL 1  "Tol. for rejection of inconsistent code obs."

ERRFROMRXHDR 1  "0"
  ## widget = checkbox

MSG_ERRFROMRXHDR 1  "Write errs/warns from input RNX hdr comments"

USEHDRSTAT 1  "0"
  ## widget = checkbox

MSG_USEHDRSTAT 1  "Consider trusted statistics header comment line"

PHSCORRAPPL 1  "SUPPRESS"
  ## widget = combobox; editable = false; cards = SUPPRESS AS_NEEDED FORCE

MSG_PHSCORRAPPL 1  "Rule for applying phase shift corrections"

! Actions in case of inconsistencies in RINEX headers
! ---------------------------------------------------
AOF_ANT_MRK_NAM 1  "NONE"
  ## widget = combobox; editable = false; cards = NONE WARNING SKIP ERROR

MSG_AOF_ANT_MRK_NAM 1  "Antenna marker name doesn't match file name"

AOM_GLO_FRQ_NBR 1  "NONE"
  ## widget = combobox; editable = false; cards = NONE WARNING SKIP ERROR

MSG_AOM_GLO_FRQ_NBR 1  "Missing mand. record: GLONASS SLOT / FRQ #"

AOM_GLO_PHS_BIS 1  "NONE"
  ## widget = combobox; editable = false; cards = NONE WARNING SKIP ERROR

MSG_AOM_GLO_PHS_BIS 1  "Missing mand. record: GLONASS COD/PHS/BIS"

AOM_SYS_PHS 1  "NONE"
  ## widget = combobox; editable = false; cards = NONE WARNING SKIP ERROR

MSG_AOM_SYS_PHS 1  "Missing mand. record: SYS / PHASE SHIFT"

AOM_GENERAL 1  "NONE"
  ## widget = combobox; editable = false; cards = NONE WARNING SKIP ERROR

MSG_AOM_GENERAL 1  "Other missing mandatory records"

! Action in case of incons. hdr. modifications
! --------------------------------------------
AOI_HDRMOD 1  "NONE"
  ## widget = combobox; editable = false; cards = NONE WARNING SKIP ERROR

MSG_AOI_HDRMOD 1  "Action in case of incons. hdr. modifications"

