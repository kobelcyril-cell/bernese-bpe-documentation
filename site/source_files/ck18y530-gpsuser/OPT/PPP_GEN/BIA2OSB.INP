
! Some keywords for automatic output
! ----------------------------------
CAMPAIGN 1  "./DUMMY"
  ## widget = initmenu; pointer = ACTIVE_CAMPAIGN

SESSION_TABLE 1  "${PAN}/SESSIONS.SES"
  ## widget = initmenu; pointer = SESSION_TABLE

DESCR_SESSION_TABLE 1  "Session table"

YR4_INFO 1  "1980"
  ## widget = comment
  # $Y+0

SES_INFO 1  "0060"
  ## widget = comment
  # $S+0

USR_INFO 1  "${USER}"
  ## widget = comment

! -------------------------------------------------------------------------
! Environment Variables
! -------------------------------------------------------------------------
ENVIRONMENT 1  "" "${}"
  ## widget = initmenu; pointer = ENVIR_LIST

! -------------------------------------------------------------------------
! General Constants
! -------------------------------------------------------------------------
SHOWGEN 1  "1"
  ## widget = checkbox

MSG_SHOWGEN 1  "Show all general files"

CONST 1  "${MODEL}/CONST.BSW"
  ## widget = selwin; path = PTH_CONST; ext = EXT_CONST; maxfiles = 1
  # CONST

DESCR_CONST 1  "General constants"

! Satellite Information
! ---------------------
SATELL 1  "${CONFIG}/$(SATINF)_$(PCV).SAT"
  ## widget = selwin; path = PTH_SATELL; ext = EXT_SATELL; maxfiles = 1
  # $(SATINF)_$(PCV)

DESCR_SATELL 1  "Satellite information"

! ----------------------------------------------------------------------
! Input / Output
! ----------------------------------------------------------------------
! BIA SINEX File
! ---------------
BIASNX 1  "./DUMMY/ORB/SCRIPT.BIA"
  ## widget = selwin; path = DIR_BIA; ext = EXT_BIA; maxfiles = 1
  ## emptyallowed = false
  # SCRIPT

MSG_BIASNX 1  "BIAS-SINEX file"

! OSB output File
! ---------------
OSBOUT 1  "./DUMMY/ORB/SCRIPT.OSB"
  ## widget = lineedit; path = DIR_OSB; ext = EXT_OSB; emptyallowed = false
  # SCRIPT

MSG_OSBOUT 1  "OSB output file"

! Use station biases for conversion
! ---------------------------------
USESTA 1  "0"
  ## widget = checkbox

MSG_USESTA 1  "Use all station biases"

! Use satellite biases for conversion
! -----------------------------------
USESAT 1  "1"
  ## widget = checkbox

MSG_USESAT 1  "Use all satellite biases"

SUMFIL 1  "./DUMMY/OUT/BIA_19800060.SUM"
  ## widget = lineedit; path = DIR_SUM; ext = EXT_SUM; maxfiles = 1
  ## emptyallowed = true
  # BIA_$YYYSS+0

DESCR_SUMFIL 1  "Summary file"

! Satellite system selection
! --------------------------
! GPS
USE_G 1  "1"
  ## widget = checkbox; activeif = SUMFIL / _

MSG_USE_G 1  "Use GPS"

! GLONASS
USE_R 1  "0"
  ## widget = checkbox; activeif = SUMFIL / _

MSG_USE_R 1  "Use GLONASS"

! Galileo
USE_E 1  "1"
  ## widget = checkbox; activeif = SUMFIL / _

MSG_USE_E 1  "Use Galileo"

! SBAS
USE_S 1  "0"
  ## widget = checkbox; activeif = SUMFIL / _

MSG_USE_S 1  "Use SBAS"

! BeiDou
USE_C 1  "1"
  ## widget = checkbox; activeif = SUMFIL / _

MSG_USE_C 1  "Use BeiDou"

! QZSS
USE_J 1  "1"
  ## widget = checkbox; activeif = SUMFIL / _

MSG_USE_J 1  "Use QZSS"

! ----------------------------------------------------------------------
! Output window
! ----------------------------------------------------------------------
OUTPUT_TXT_COL_1 1  "BIA2OSB output files"

! Title
! -----
TITLE 1  "PPP_19800060: Extract bias information"
  ## widget = lineedit
  # PPP_$YYYSS+0: Extract bias information

MSG_TITLE 1  "Title line"

! Program Output File
! -------------------
SYSODEF 1  "0"
  ## widget = checkbox

MSG_SYSODEF 1  "Program output"

SYSOUT 1  "./DUMMY/OUT/BIA_19800060.OUT"
  ## widget = lineedit; path = DIR_OUT; ext = EXT_OUT
  ## activeif = SYSODEF == 0; emptyallowed = false
  # BIA_$YYYSS+0

DESCR_SYSOUT 1  "Program output"

! Error Message File
! ------------------
ERRMRG 1  "0"
  ## widget = checkbox

MSG_ERRMRG 1  "Error message"

SYSERR 1  "${U}/WORK/ERROR.MSG"
  ## widget = lineedit; path = PTH_ERR; ext = EXT_ERR
  ## activeif = ERRMRG == 0; emptyallowed = false
  # ERROR

DESCR_SYSERR 1  "Error message"

! Subroutine/function debug output
! --------------------------------
DEBUG_STKLOG 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_STKLOG 1  "Debug stack log output"

DEBUG_SUMMARY 0
  ## widget = lineedit; path = PTH_DBG; ext = EXT_DBG; maxfiles = 1
  ## emptyallowed = true

DESCR_DEBUG_SUMMARY 1  "Debug summary output"

DEBUG_INTERVAL 1  "00 01 00"
  ## widget = lineedit; check_type = time

MSG_DEBUG_INTERVAL 1  "Interval for intermediate debug summary"


# BEGIN_PANEL NO_CONDITION #####################################################
# BIAS SINEX to OSB format conversion - BIA2OSB 1: Input/Output Files          #
#                                                                              #
# GENERAL FILES                                                                #
#   Show all general files  > % <                                              # SHOWGEN
#                                                                              #
# Input:                                                                       #
#   BIAS-SINEX file         > %%%%%%%%%%%% <                                   # BIASNX
#                                                                              #
# Output:                                                                      #
#   OSB bias file           > %%%%%%%%%%%% <                                   # OSBOUT
#                                                                              #
#                                                                              #
# GENERAL OUTPUT FILES                                                         #
#   Program output       > % < use BIA2OSB.Lnn           or   > %%%%%%%%%%%% < # SYSODEF SYSOUT
#   Error messages       > % < merged to program output  or   > %%%%%%%%%%%% < # ERRMRG SYSERR
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL SHOWGEN = 1  #####################################################
# BIA2OSB 1.1: General Files                                                   #
#                                                                              #
# GENERAL INPUT FILES                                                          #
#   General constants       > %%%%%%%%%%%% <                                   # CONST
#   Satellite information   > %%%%%%%%%%%% <                                   # SATELL
#                                                                              #
# MENU SETTINGS                                                                #
#   Selected campaign       > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # CAMPAIGN
#   Selected session          year> %%%% <  session> %%%% <                    # YR4_INFO SES_INFO
#   Session table           > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% <   # SESSION_TABLE
#                                                                              #
# END_PANEL ####################################################################


# BEGIN_PANEL CMERGE / CONCATENATE #############################################
# BIA2OSB 2: Options for BIA-SINEX to OSB file format conversion               #
#                                                                              #
# TITLE   > %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% < # TITLE
#                                                                              #
# Bias conversion                                                              #
#   Use all station biases                             > % <                   # USESTA
#   Use all satellite biases                           > % <                   # USESAT
#                                                                              #
# Summary file                              > %%%%%%%%%%%% <                   # SUMFIL
#   Biases expected for:                                                       #
#          > % < GPS            > % < GLONASS        > % < Galileo             # USE_G USE_R USE_E
#          > % < SBAS           > % < BeiDou         > % < QZSS                # USE_S USE_C USE_J
#                                                                              #
# END_PANEL ####################################################################
