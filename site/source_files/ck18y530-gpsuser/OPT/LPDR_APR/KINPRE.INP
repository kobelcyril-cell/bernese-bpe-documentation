! ---------------
KINOUT 0
  ## widget = lineedit; path = DIR_PRE; ext = EXT_KIN; emptyallowed = true
  ## activeif = ICHKKIN = 1
  # 

DESCR_KINOUT 1  "Write edited KIN file"

! General Constants
! -----------------
CONST 1  "CONST"
  ## widget = selwin; path = PTH_CONST; ext =EXT_CONST; maxfiles = 1

DESCR_CONST 1  "General constants"

