120  ORBGENZD            FZDM_1DS  CPU=SHORT; WAIT=119; PARAM1=V_U
121  FZDM_UPD            NO_OPT    CPU=LOCAL; WAIT=120; PARAM1=V_U; PARAM2=V_Z
#
# Ambiguity fixing (based on WL and L1 ambiguities)
