086  TIMORB_P            FZDM_ORP  CPU=SHORT; WAIT=085; PARALLEL=085
087  ADDNEQOR            FZDM_ORP  CPU=SHORT; WAIT=086
088  ORBGENZD            FZDM_1DS  CPU=SHORT; WAIT=087; PARAM1=V_H
#
# Preprocessing: residual check
# -----------------------------
090  TIMESTAP            FZDM_EDT  CPU=SHORT; WAIT=088; PARAM2=V_H
091  TIMEST_P            FZDM_EDT  CPU=SHORT; WAIT=090; PARALLEL=090
092  GPSXTR              FZDM_EDT  CPU=SHORT; WAIT=091
093  FZDM_CH2            FZDM_EDT  CPU=SHORT; WAIT=092; NEXTJOB=094 085
094  RESRMSZD            FZDM_EDT  CPU=SHORT; WAIT=093
095  MRKOBSAP            FZDM_EDT  CPU=SHORT; WAIT=094; PARAM2=BOTH; PARAM3=SYNCHRO
096  MRKOBS_P            FZDM_EDT  CPU=SHORT; WAIT=095; PARALLEL=095
097  ITEPHASE            NO_OPT    CPU=SHORT; WAIT=096; NEXTJOB=097 085 093
098  SOSUPDAT            FZDM_GEN  CPU=SHORT; WAIT=097
099  CCRNXC              FZDM_EDT  CPU=SHORT; WAIT=098
100  FZDM_UPD            NO_OPT    CPU=LOCAL; WAIT=099; PARAM1=V_H
#
# Generate best FA solution
# -------------------------
110  TIMZDMAP            FZDM_1DP  CPU=LOCAL; WAIT=100; PARAM2=V_U
111  TIMZDM_P            FZDM_1DP  CPU=MEGA; WAIT=110; PARALLEL=110
112  ADDNEQZD            FZDM_1DU  CPU=MEGA; WAIT=111; PARAM1=V_U
113  PRECLKAP            NO_OPT    CPU=LOCAL; WAIT=112; PARAM2=V_U
995  WAIT_ZD             NO_OPT    CPU=SHORT; WAIT=113
114  PRECLK_P            FZDM_1DS  CPU=HUGE; WAIT=995; PARALLEL=113
115  ITEPRECL            NO_OPT    CPU=LOCAL; WAIT=114; NEXTJOB=116 113
116  SOLCLKAP            NO_OPT    CPU=LOCAL; WAIT=115; PARAM2=V_U
