180  TIMESTAP            FCLK_COD  CPU=SHORT; WAIT=075; PARAM2=V_B
181  TIMCLK              FCLK_COD  CPU=BIG; WAIT=180; PARALLEL=180
182  CCRNXC              FCLK_COD  CPU=SHORT; WAIT=181
#
# Preprocessing: phase + geometry improvement
# -------------------------------------------
080  MKCLUS              FZDM_GEN  CPU=SHORT; WAIT=182
