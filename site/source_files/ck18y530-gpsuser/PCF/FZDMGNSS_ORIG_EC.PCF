913  CHECK_SAT_GAPS      FZDM_RNX  CPU=SHORT; WAIT=013
914  CHECK_SAT_RMS       FZDM_RNX  CPU=SHORT; WAIT=913
014  SATMRK              FZDM_RNX  CPU=SHORT; WAIT=914
