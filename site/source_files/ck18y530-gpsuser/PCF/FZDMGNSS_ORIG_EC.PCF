017  CHECK_VAPL_ENTRIES  NO_OPT    CPU=SHORT; WAIT=016
#
# Start preprocessing
# -------------------
020  INIT_HOI            NO_OPT    CPU=LOCAL; WAIT=016
021  INIT_VMF            NO_OPT    CPU=LOCAL; WAIT=020
022  CODSPPAP            FZDM_GEN  CPU=SHORT; WAIT=021
023  CODSPP_P            FZDM_GEN  CPU=SHORT; WAIT=022; PARALLEL=022
024  CODXTR              FZDM_GEN  CPU=SHORT; WAIT=023; NEXTJOB=022
996  DEL_LOBS            NO_OPT    CPU=SHORT; WAIT=024
025  CCRNXC              FZDM_GEN  CPU=SHORT; WAIT=996
#
# Compute weights for the code
# ----------------------------
030  TIMESTAP            FZDM_WGT  CPU=SHORT; WAIT=025; PARAM2=V_I
031  TIMEST_C            FZDM_WGT  CPU=BIG; WAIT=030; PARALLEL=030
032  GPSXTR              FZDM_WGT  CPU=SHORT; WAIT=031
033  FZDM_CH1            FZDM_WGT  CPU=SHORT; WAIT=032; NEXTJOB=040 030
#
# Special code preprocessing (check satclk station-wise)
# ------------------------------------------------------
040  FILESTAP            FZDM_MON  CPU=SHORT; WAIT=033
041  FILEST_P            FZDM_MON  CPU=SHORT; WAIT=040; PARALLEL=040
042  SATMONAP            FZDM_MON  CPU=MEGA; WAIT=041; PARAM3=RCLK; PARAM4=30
043  SATMON_P            FZDM_MON  CPU=SHORT; WAIT=042; PARALLEL=042
#
# Generate orbits based on code observations
# ------------------------------------------
050  TIMESTAP            FZDM_ORC  CPU=SHORT; WAIT=043; PARAM2=V_B
051  TIMEST_O            FZDM_ORC  CPU=BIG; WAIT=050; PARALLEL=050
052  ADDNEQOR            FZDM_ORC  CPU=SHORT; WAIT=051
053  ORBGENZD            FZDM_1DS  CPU=SHORT; WAIT=052; PARAM1=V_B
#
# Clean code residuals
# --------------------
060  TIMESTAP            FZDM_COD  CPU=SHORT; WAIT=053; PARAM2=V_B
061  TIMEST_A            FZDM_COD  CPU=BIG; WAIT=060; PARALLEL=060
062  GPSXTR              FZDM_COD  CPU=SHORT; WAIT=061
063  FZDM_CH1            FZDM_COD  CPU=SHORT; WAIT=062; NEXTJOB=064 050
064  RESRMS              FZDM_COD  CPU=SHORT; WAIT=063
065  MRKOB_AP            FZDM_COD  CPU=SHORT; WAIT=064
066  MRKOB__P            FZDM_COD  CPU=SHORT; WAIT=065; PARALLEL=065
