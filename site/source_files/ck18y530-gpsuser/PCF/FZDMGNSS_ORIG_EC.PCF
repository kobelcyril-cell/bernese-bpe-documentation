VARIABLE   DEFAULT        PARAMETERS
V_A      = BRD;           DESCRIPTION=A priori information (brd, and bull. A)
V_W      = C0;            DESCRIPTION=CODSPP apriori solution
V_I      = CW;            DESCRIPTION=Weights for the code observations
V_B      = CR;            DESCRIPTION=Code screening
V_C      = CB;            DESCRIPTION=Unify inter-system/frequency biases
V_E      = CC;            DESCRIPTION=CLKEST for starting the MAUPRP
V_H      = T0;            DESCRIPTION=Code+phase screening in reg. clusters
V_K      = T1;            DESCRIPTION=A priori inf. for final computation
V_U      = F1F;           DESCRIPTION=FA Final results, 1d
V_Z      = F1I;           DESCRIPTION=IA Final results, 1d
V_L      = LARGE;         DESCRIPTION=IA Final results, full solution (one ADDNEQ2)
V_PSDINF = IGC20;         DESCRIPTION=PSD corrections
V_CRDINF = IGC20;         DESCRIPTION=CRD/VEL/FIX master file name
V_BLQINF = FES2014b;      DESCRIPTION=BLQ file name, CMC corrections
V_SATCRX = ZD_SAT_$Y+0;   DESCRIPTION=Satellite problem file for data import
V_SATINF = SATELLIT;      DESCRIPTION=Satellite information
V_PCV    = I20;           DESCRIPTION=GNSS PCV model (absolute)
V_SUBMOD = DESAI2016;     DESCRIPTION=Subdaily pole model
V_NUTMOD = IAU2000R06;    DESCRIPTION=Nutation model
V_POTCOE = COSTG_FSM_2603;DESCRIPTION=Gravity field model
V_NCLU   = 14;            DESCRIPTION=Number of clusters to be used
V_OBSSEL = OBSERV_COD;    DESCRIPTION=Observation selection file
V_STAINF = CODE;          DESCRIPTION=Station information
V_PCVINF = ANT_COD;       DESCRIPTION=PCV information
V_SAMPL  = 300;           DESCRIPTION=Sampling rate of the GPSEST solution
V_BIAINF = SINEX_BIA_COD;  DESCRIPTION=Bias-SINEX information file
V_NITEAR = 0;             DESCRIPTION=Number of iterations for AR
V_SAVE   = YES;           DESCRIPTION=Save results
V_REPINI = NO;            DESCRIPTION=Initialize (screened observations) from REPRO
V_MGEINI = NO;            DESCRIPTION=Initialize orbit/clock information with MGEX
V_MEANPL = IERS2010_v1.2.0;  DESCRIPTION=Mean pole model
V_CLEAN  = YES;           DESCRIPTION=Delete specific files from campaign
V_MODE   = FINAL;         DESCRIPTION=Define whether FINAL, RAPID or ULTRA
V_USEHOI = YES;           DESCRIPTION=Use HOI-file
V_TRPMOD = VMF;           DESCRIPTION=Troposphere model
V_NSTA   = FINAL;         DESCRIPTION=Number of stations used in the processing

