# ============================================================================
# ZDGNSS_CODESCREENING.PCF
# ============================================================================
#
# Description:  Screening of code observations
#
# Comments   :
#
# Variables  :
#
# Flags (MSC):
#
# Author     :  C. Kobel
# Created    :  31-Mar-2026
#
# Changes    :
#
# ============================================================================
#
#

PID  SCRIPT    OPT_DIR   PARAMETERS
# Wait for status flag
# --------------------
001  ZD_STATUS                 NO_OPT      CPU=ANY; PARAM1=PREPROCESSING; PARAM2=CHECK
#
# Extend validity of a priori OSB's
# ---------------------------------
050  ZD_MOD_OSBFIL             NO_OPT      CPU=ANY; WAIT=001
#
# Generate orbits based on code observations
# ------------------------------------------
100  ZD_GPSEST_DELOLD_P        ZD_ORC      CPU=ANY; WAIT=050; PARAM2=V_CSCR
101  ZD_GPSEST_ADDNEQ2_E       ZD_ORC      CPU=BIG; WAIT=100; PARALLEL=100
102  ZD_ADDNEQ2                ZD_ORC      CPU=ANY; WAIT=101
103  ZD_ORBGENA                ZD_1DS      CPU=ANY; WAIT=102; PARAM1=V_CSCR
#
# Compute code residuals
# --------------------
110  ZD_GPSEST_DELOLD_P        ZD_COD      CPU=ANY; WAIT=103; PARAM2=V_CSCR
111  ZD_GP_AD_GP_E             ZD_COD      CPU=BIG; WAIT=110; PARALLEL=110
112  ZD_GPSXTR                 ZD_COD      CPU=ANY; WAIT=111
#
# Check for bad stations
# ----------------------
113  ZD_RES_CHK                ZD_COD      CPU=ANY; WAIT=112; NEXTJOB=114 100; PARAM9=CODE
114  ZD_RESRMS                 ZD_COD      CPU=ANY; WAIT=113
#
# Mark bad observations
# ---------------------
115  ZD_MRKOB__P               ZD_COD      CPU=ANY; WAIT=114
116  ZD_MRKOB__E               ZD_COD      CPU=ANY; WAIT=115; PARALLEL=115
#
# OSB-Extraction
# --------------
120  ZD_GPSEST_DELOLD_P  ZD_SB1            CPU=ANY; WAIT=116; PARAM2=V_CBIA
121  ZD_GPSEST_ADDNEQ2_OSBR_E  ZD_SB1      CPU=BIG; WAIT=120; PARALLEL=120
122  ZD_ADDNEQ2                ZD_SB2      CPU=BIG; WAIT=121
123  ZD_ADDNEQ2_P              ZD_SB3      CPU=ANY; WAIT=122; PARAM2=V_CBIA
124  ZD_ADDNEQ2_E              ZD_SB3      CPU=BIG; WAIT=123; PARALLEL=123
125  ZD_OSBMERGE               NO_OPT      CPU=ANY; WAIT=124
#
# Compute code-only clocks
# ------------------------
130  ZD_GPSEST_DELOLD_P        ZD_COC      CPU=ANY; WAIT=125; PARAM2=V_CSCR
131  ZD_GPSESTC_E              ZD_COC      CPU=BIG; WAIT=130; PARALLEL=130
#
# Combine clocks
# --------------
132  ZD_CCRNXC                 ZD_COC      CPU=ANY; WAIT=131
#
# Checks (nothing yet)
# -------------------------------------
#
# Create status flag
# ------------------
999  ZD_STATUS                 NO_OPT      CPU=ANY; WAIT=132; PARAM1=CODESCREENING; PARAM2=CREATE

VARIABLE   DEFAULT        PARAMETERS
V_BRD    = *;               DESCRIPTION=A priori information (brd, and bull. A)
V_CWGT   = *;               DESCRIPTION=Weights for the code observations
V_CSCR   = *;               DESCRIPTION=Code screening
V_CBIA   = *;               DESCRIPTION=Unify inter-system/frequency biases
V_CRDINF = IG?20;           DESCRIPTION=CRD/VEL/FIX master file name
V_BLQINF = FES20*;          DESCRIPTION=BLQ file name, CMC corrections
V_SATCRX = *;               DESCRIPTION=Satellite problem file for data import
V_SATINF = *;               DESCRIPTION=Satellite information
V_MAC    = *;               DESCRIPTION=Satellite Macromodel
V_PCV    = I??;             DESCRIPTION=GNSS PCV model (absolute)
V_PCVM   = ????;            DESCRIPTION=GNSS PCV model version
V_SUBMOD = *;               DESCRIPTION=Subdaily pole model
V_NUTMOD = *;               DESCRIPTION=Nutation model
V_SETID  = *;               DESCRIPTION=Solid Earth Tides
V_OTID   = *;               DESCRIPTION=Ocean Tides
V_PEPH   = *;               DESCRIPTION=Planetary ephemeris
V_AREF   = *;               DESCRIPTION=Albedo reflectivity
V_AEMI   = *;               DESCRIPTION=Albedo emissivity
V_FLUX   = *;               DESCRIPTION=Flux index
V_POTCOE = *;               DESCRIPTION=Gravity field model
V_NCLU   = *;               DESCRIPTION=Number of clusters to be used;           CHECK_TYPE=integer
V_OBSSEL = *;               DESCRIPTION=Observation selection file
V_STAINF = *;               DESCRIPTION=Station information
V_PCVINF = *;               DESCRIPTION=PCV information
V_SAMPL  = *;               DESCRIPTION=Sampling rate of the GPSEST solution;    CHECK_TYPE=integer
V_USEHOI = *;               DESCRIPTION=Use HOI-file;                            CARDS=YES NO
V_TRPMOD = GMF;             DESCRIPTION=Troposphere model
V_BIAINF = *;               DESCRIPTION=Bias-SINEX information file
# Configuration
V_PCFCONFIG = MODEL SETUP_ZDGNSS;    DESCRIPTION=Configuration files

