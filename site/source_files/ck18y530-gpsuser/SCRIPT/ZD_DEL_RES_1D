package DEL_RES_1D;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  DEL_RES_1D
#
# Purpose :  Delete specific files, only if V_CLEAN=Y.
#
# Author  :  C. Kobel
# Created :  30-Oct-2025
#
# Changes :  
#===========================================================

use lib "$ENV{AUTO}";
use gpsutil;
use strict;
use warnings;
use File::Basename;
use POSIX qw(strftime);

sub run {
  my $bpe = shift;

  # ---------- Parameter ------------
  my (
      $dirOut,
      $yyddd,
      $ssss,
      $yyyy,
      $yyssss,
      $ddd,
      $CLEAN,
      $V_BRD,
      $V_APSP,
      $V_CWGT,
      $V_CSCR,
      $V_CBIA,
      $V_CLKA,
      $V_CPSC,
      $V_APR,
      $V_FIN,
      $V_LARGE
  ) = $bpe->getKeys(
      'DIR_OUT',
      '$YD+0',
      '$S+0',
      '$Y+0',
      '$YSS+0',
      '$D+0',
      'V_CLEAN',
      'V_BRD',
      'V_APSP',
      'V_CWGT',
      'V_CSCR',
      'V_CBIA',
      'V_CLKA',
      'V_CPSC',
      'V_APR',
      'V_FIN',
      'V_LARGE'
  );
    
  unless (defined $CLEAN && $CLEAN eq 'YES') {
    print "CLEAN variable not set to 'Y'. Nothing to delete.\n";
    return;
  }

  my $yy = substr($yyyy, -2);
  my $yysss = "${yy}${ssss}";

   # ---------- PROCESSING file ------------
  my $mscDir  = "${dirOut}../MSC/MSC_${yyddd}";
  unless (-d $mscDir) {
    die "Cannot find directory $mscDir: $!";
  }
  my $outfile = "$mscDir/PROCESSING_$yyddd";

  # ---------- Directories ------------
  my $dirBpe = "${dirOut}../BPE";
  my $dirOrb = "${dirOut}../ORB";
  my $dirAtm = "${dirOut}../ATM";
  my $dirObs = "${dirOut}../OBS";
  my $dirRaw = "${dirOut}../RAW";
  my $dirSol = "${dirOut}../SOL";
  my $dirSta = "${dirOut}../STA";
  my $dirMsc = "${dirOut}../MSC/MSC_${yyddd}";

print "------------------------------------------------------------\n";
print "DEL_RES_1D started for $yysss\n";
print "------------------------------------------------------------\n";

# ---------- List of files to be deleted ------------
my @delete_list = (
  { dir => $dirBpe, pattern => qr/\Q${yyssss}\E.*\.(LOG|PRT)$/ },

# ---------- ATM ------------
  { dir => $dirAtm, pattern => qr/^${V_CPSC}_${yyssss}\.TRP$/ },
  { dir => $dirAtm, pattern => qr/^${V_APR}_${yyssss}\.TRP$/ },

  # ---------- MSC ------------
  { dir => $dirMsc, pattern => qr/^TIMINT_03$/ },

  # ---------- OBS ------------

  # ---------- ORB ------------
  { dir => $dirOrb, pattern => qr/^APR${yyssss}\.OSB$/ },
  { dir => $dirOrb, pattern => qr/^REF${yyssss}\.OSB$/ },
  { dir => $dirOrb, pattern => qr/^REF${yyssss}\.OSB.bak$/ },
  { dir => $dirOrb, pattern => qr/^CLK${yyddd}\.SUM$/ },
  { dir => $dirOrb, pattern => qr/^SAT${yyddd}\.OUT$/ },
  { dir => $dirOrb, pattern => qr/^SAT${yyddd}\.LST$/ },
  { dir => $dirOrb, pattern => qr/^${V_BRD}_${yyssss}\.(ERP|PRE|CLK|STD|RPR)$/ },
  { dir => $dirOrb, pattern => qr/^TMP_${yyssss}\.(ERP|PRE|CLK|STD|RPR)$/ },
  { dir => $dirOrb, pattern => qr/^${V_CSCR}_${yyssss}\.(ELE|ERP|STD|RPR|CLK)$/ },
  { dir => $dirOrb, pattern => qr/^${V_CSCR}C${ssss}00.\.CLK$/ },
  { dir => $dirOrb, pattern => qr/^${V_CSCR}${ssss}00.\.OSB$/ },
  { dir => $dirOrb, pattern => qr/^${V_CBIA}S${yyssss}00.\.OSB$/ },
  { dir => $dirOrb, pattern => qr/^${V_CBIA}_${yyssss}\.(BIA|CLK|OSB)$/ },
  { dir => $dirOrb, pattern => qr/^${V_CBIA}S${yyssss}\.OSB$/ },
  { dir => $dirOrb, pattern => qr/^${V_CLKA}_${yyssss}\.CLK$/ },
  { dir => $dirOrb, pattern => qr/^${V_APR}08${ssss}00.\.CLK$/ },
  { dir => $dirOrb, pattern => qr/^${V_APR}${ssss}00.\.CLK$/ },
  { dir => $dirOrb, pattern => qr/^${V_FIN}${ssss}00.\.CLK$/ },
  { dir => $dirOrb, pattern => qr/^${V_APR}_APR_${yyssss}\.(RPR|STD)$/ },
  { dir => $dirOrb, pattern => qr/^${V_FIN}_${yyssss}\.OBX$/ },
  { dir => $dirOrb, pattern => qr/^NL_${yyssss}\.(BIA|OSB)$/ },
  { dir => $dirOrb, pattern => qr/^NL_${yyssss}_mod\.(BIA|OSB)$/ },
  { dir => $dirOrb, pattern => qr/^${V_APR}_${yyssss}_mod\.(PRE|CLK)$/ },
  { dir => $dirOrb, pattern => qr/^NLB${yyssss}\.OSB$/ },

  
  # ---------- T0_ ------------
  { dir => $dirOrb, pattern => qr/^${V_CPSC}_${yyssss}\.(CLK|ELE|ERP|RPR|STD)$/ },

  # ---------- WL / WLB ------------
  { dir => $dirOrb, pattern => qr/^WL_${yyssss}\.(BIA|OSB)$/ },
  { dir => $dirOrb, pattern => qr/^WLB${yyssss}\.OSB$/ },

  # ---------- OUT ------------
  { dir => $dirOut, pattern => qr/^....${ssss}_NLB\.OUT$/ },
  { dir => $dirOut, pattern => qr/^AMB${yyssss}\.SUM$/ },
  { dir => $dirOut, pattern => qr/^....${ssss}_WLB\.OUT$/ },
  { dir => $dirOut, pattern => qr/^....${ssss}_WLI\.OUT$/ },
  { dir => $dirOut, pattern => qr/^....${ssss}_NLI\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_APSP}_${yyssss}\.(CLK|OUT)$/ },
  { dir => $dirOut, pattern => qr/^${V_CBIA}${ssss}00.\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_CBIA}${ssss}00._\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_CBIA}_${yyssss}\.(CLK|OUT)$/ },
  { dir => $dirOut, pattern => qr/^${V_CBIA}_${yyssss}_.SUM$/ },
  { dir => $dirOut, pattern => qr/^${V_CBIA}S${yyssss}00.\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_CLKA}_${yyssss}\.(CLK|DIF|IFO|OUT|PRC)$/ },
  { dir => $dirOut, pattern => qr/^CLK${yyddd}\.SUM$/ },
  { dir => $dirOut, pattern => qr/^CODXTR\.${yy}_${ssss}$/ },
  { dir => $dirOut, pattern => qr/^${V_CWGT}_${yyddd}\.(LST|SUM)$/ },
  { dir => $dirOut, pattern => qr/^${V_CWGT}_${yyssss}\.(LST|SUM)$/ },
  { dir => $dirOut, pattern => qr/^${V_CSCR}_${ssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_CSCR}_${yyssss}\.(CLK|EDT|LST|OUT|SUM)$/ },
  { dir => $dirOut, pattern => qr/^${V_CSCR}C${ssss}00.\.(CLK|OUT)$/ },
  { dir => $dirOut, pattern => qr/^${V_CSCR}G${yyssss}\.SUM$/ },
  { dir => $dirOut, pattern => qr/^${V_CSCR}R${yyssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_CWGT}${ssss}00.\.(OUT|RES)$/ },
  { dir => $dirOut, pattern => qr/^${V_CWGT}G${yyssss}\.SUM$/ },
  { dir => $dirOut, pattern => qr/^${V_CWGT}R${yyssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_APR}_${ssss}....\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_APR}0[1-8]${ssss}00.\.(OUT|CLK)$/ },
  { dir => $dirOut, pattern => qr/^${V_APR}A${ssss}....\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_APR}U${yyssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}_${ssss}....\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}0[1-8]${ssss}00.\.(OUT|CLK)$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}A${ssss}....\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}99${ssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}S${yyssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_APR}${ssss}00.\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_APR}${ssss}00.\.CLK$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}${ssss}00.\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}${ssss}00.\.CLK$/ },
  { dir => $dirOut, pattern => qr/^FIL${ddd}....\.OUT$/ },
  { dir => $dirOut, pattern => qr/^HELMERT_.....${V_FIN}${yyssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^CCPREORB\.L..$/ },
  { dir => $dirOut, pattern => qr/^COMPAR2\.L..$/ },
  { dir => $dirOut, pattern => qr/^COMPAR2_${V_FIN}${V_LARGE}${yyssss}\.PLT$/ },
  { dir => $dirOut, pattern => qr/^STDDIF_${V_FIN}${V_LARGE}${yyssss}\.PLT$/ },
  { dir => $dirOut, pattern => qr/^GPSCMP\.${yy}_${ssss}$/ },
  { dir => $dirOut, pattern => qr/^GPSWKS\.${yy}_${ssss}$/ },
  { dir => $dirOut, pattern => qr/^GPSXTR\.${yy}_${ssss}$/ },
  { dir => $dirOut, pattern => qr/^GPSXTR\.L..$/ },
  { dir => $dirOut, pattern => qr/^MPR${yyssss}..\.OUT$/ },
  { dir => $dirOut, pattern => qr/^MPR${yyssss}\.(EDT|SUM)$/ },
  { dir => $dirOut, pattern => qr/^MPXTR\.${yy}\_${ssss}$/ },
  { dir => $dirOut, pattern => qr/^MPRXTR\.${yy}\_${ssss}$/ },
  { dir => $dirOut, pattern => qr/^MPXTR\.L..$/ },
  { dir => $dirOut, pattern => qr/^MPRXTR\.L..$/ },
  { dir => $dirOut, pattern => qr/^MPS${yyssss}\.SUM$/ },
  { dir => $dirOut, pattern => qr/^RESCHK\.${yy}_${ssss}$/ },
  { dir => $dirOut, pattern => qr/^RESCHK\.L..$/ },
  { dir => $dirOut, pattern => qr/^RESRMS\.L..$/ },
  { dir => $dirOut, pattern => qr/^RNXCLK\.L..$/ },
  { dir => $dirOut, pattern => qr/^RNXPRE\.L..$/ },
  { dir => $dirOut, pattern => qr/^RXOBV3\.L..$/ },
  { dir => $dirOut, pattern => qr/^SATCLK\.L..$/ },
  { dir => $dirOut, pattern => qr/^SATMRK\.L..$/ },
  { dir => $dirOut, pattern => qr/^RXN2PRE\.L..$/ },
  { dir => $dirOut, pattern => qr/^SATCLK2\.L..$/ },
  { dir => $dirOut, pattern => qr/^SATMRK...\.OUT$/ },
  { dir => $dirOut, pattern => qr/^SATMRK\.OUT$/ },
  { dir => $dirOut, pattern => qr/^STDDIF\.L..$/ },
  { dir => $dirOut, pattern => qr/^RNX${yyssss}\.EDT$/ },
  { dir => $dirOut, pattern => qr/^RNXERR\.${yy}_${ssss}$/ },
  { dir => $dirOut, pattern => qr/^RNXGRA\.L..$/ },
  { dir => $dirOut, pattern => qr/^RNXSTAT\.${yy}_${ssss}$/ },
  { dir => $dirOut, pattern => qr/^SAT${yyddd}\.(LST|OUT)$/ },
  { dir => $dirOut, pattern => qr/^SATMRK${ddd}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^SMT${ssss}0..\.OUT$/ },
  { dir => $dirOut, pattern => qr/^SPP${ssss}0..\.(CLK|OUT)$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}_STDPRE\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_CPSC}${ssss}0..\.(CLK|OUT|RES)$/ },
  { dir => $dirOut, pattern => qr/^${V_CPSC}_${ssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_CPSC}_${yyssss}\.(CLK|EDT|LST|OUT|SUM)$/ },
  { dir => $dirOut, pattern => qr/^${V_CPSC}G${yyssss}\.SUM$/ },
  { dir => $dirOut, pattern => qr/^${V_CPSC}R${yyssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^WLB${yyssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^XTR${yyssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^OBSXTR${V_FIN}${yyssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^OBSXTR${V_FIN}${yyssss}\.SUM$/ },
  { dir => $dirOut, pattern => qr/^ATTXTR\.L..$/ },
  { dir => $dirOut, pattern => qr/^CODXTR\.L..$/ },
  { dir => $dirOut, pattern => qr/^MKCLUS\.L..$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}C${yyddd}\.LST$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}${V_LARGE}XTR${yyssss}\.SUM$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}U${yyssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^${V_FIN}C${ssss}\.OUT$/ },
  { dir => $dirOut, pattern => qr/^NLBORBGEN\.OUT$/ },
  { dir => $dirOut, pattern => qr/^NLBSTDPRE\.OUT$/ },

  # ---------- RAW ------------
  { dir => $dirRaw, pattern => qr/^....${ssss}\.(SMT|${yy}O)$/ },
  { dir => $dirRaw, pattern => qr/^CODE${ssss}\.${yy}N$/ },
  { dir => $dirRaw, pattern => qr/^RNXFIL${yyddd}\.lst$/ },

  # ---------- SOL ------------
  { dir => $dirSol, pattern => qr/^${V_CBIA}${ssss}00.\.NQ0$/ },
  { dir => $dirSol, pattern => qr/^${V_CBIA}${ssss}00._\.NQ0$/ },
  { dir => $dirSol, pattern => qr/^${V_CBIA}_${yyssss}\.NQ0$/ },
  { dir => $dirSol, pattern => qr/^${V_APR}07${yyssss}00.\.NQ0$/ },
  { dir => $dirSol, pattern => qr/^${V_APR}_${yyssss}\.NQ0$/ },
  { dir => $dirSol, pattern => qr/^${V_FIN}07${yyssss}00.\.NQ0$/ },
  { dir => $dirSol, pattern => qr/^${V_FIN}_${yyssss}\.NQ0$/ },

  # ---------- STA ------------
  { dir => $dirSta, pattern => qr/^....${ssss}_NLB\.CRD$/ },
  { dir => $dirSta, pattern => qr/^....${ssss}_NLI\.CRD$/ },
  { dir => $dirSta, pattern => qr/^${V_CPSC}_${yyssss}\.CRD$/ },
  { dir => $dirSta, pattern => qr/^${V_APSP}_${yyssss}\.SIG$/ },
  { dir => $dirSta, pattern => qr/^${V_CBIA}${ssss}0.\.CLB$/ },
  { dir => $dirSta, pattern => qr/^${V_CLKA}${ssss}01\.CLB$/ },
  { dir => $dirSta, pattern => qr/^${V_CSCR}${ssss}0.\.CLB$/ },
  { dir => $dirSta, pattern => qr/^${V_CSCR}_${yyssss}\.CRD$/ },
  { dir => $dirSta, pattern => qr/^${V_CWGT}${ssss}0.\.CLB$/ },
  { dir => $dirSta, pattern => qr/^${V_CWGT}0${yyssss}\.SOS$/ },
  { dir => $dirSta, pattern => qr/^${V_CPSC}${ssss}..\.CLB$/ },
);

  my $total_deleted = 0;
  # ---------- Delete files ------------
  foreach my $entry (@delete_list) {
    my $dir     = $entry->{dir};
    my $pattern = $entry->{pattern};

    unless (-d $dir) {
      print "Directory $dir not found, skipping.\n";
      next;
    }

    opendir(my $dh, $dir) or die "Cannot open $dir: $!";
    my @files = grep { /$pattern/ && -f "$dir/$_" } readdir($dh);
    closedir($dh);

    foreach my $file (@files) {

      # ---------- Do not delete BPE-files for PID 171 ------------
      if ($dir eq $dirBpe && $file =~ /_171_/) {
        print "Skipping (protected) file: $file\n";
        next;
      }

      my $path = "$dir/$file";
      unlink $path or warn "Could not delete $path: $!";
      print "Deleted: $path\n";
      $total_deleted++;
    }

    print "Cleanup in $dir done (" . scalar(@files) . " files removed)\n";
  }

  print "------------------------------------------------------------\n";
  print "DEL_RES_1D finished successfully.\n";
  print "------------------------------------------------------------\n";

  # ---------- Write to PROCESSING-File ------------
  open(my $fh, ">>", $outfile) or die "Cannot open $outfile: $!";
  my $timestamp = strftime("%a %b %d %H:%M:%S %Y", localtime);

  print $fh "=========================\n";
  print $fh "==== DELETED PROCESSING FILES ====\n";
  print $fh "Timestamp  : $timestamp\n";
  print $fh "Total removed files: $total_deleted\n";
  print $fh "=========================\n";

  close($fh);

}

