package CODXTR;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  CODXTR
#
# Purpose :  Execute CODXTR; delete, if wished, rejected binary observation
#            files
#
# Programs:
#
# Author  :  H. Bock
# Created :  06-Dec-2007               Last modified: 26-May-2009
#
# Changes :  26-May-2009 rd: CODXTR: YY_DDD -> YY_SSSS
#            23-Apr-2020 ST: Stop copy of $A_$YSS+0 to $A0$YSS+0.
#
# ----------------------------------------------------------------------------

use strict;
use File::Basename;
use lib "$ENV{BPE}";
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;

use lib "$ENV{U}/SCRIPT";
use JumpLogger qw(logJump);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss,  $yy,  $ddd, $ssss,
      $v_camp,  $param1,  $param2,
      $dirOut,   $dirDel,   $dirDcb,   $dirClk,
      $extOut,   $extDel,   $extDcb,   $extClk) =
    $bpe->getKeys(
      '$YSS+0', '$Y', '$+0', '$S+0',
      'V_CAMP', 'PARAM1', 'PARAM2',
      'DIR_OUT', 'DIR_DEL', 'DIR_DCB', 'DIR_CLK',
      'EXT_OUT', 'EXT_DEL', 'EXT_DCB', 'EXT_CLK');

# Delete old DEL file
# -------------------
  my $delFil = "${dirDel}SPP${yyssss}.${extDel}";
  $bpe->putKey("$ENV{U}/PAN/CODXTR.INP","FILBAD",basename($delFil));
  unlink ($delFil);


# Run program
# -----------
  my $PGMNAM = "CODXTR";
  $bpe->RUN_PGMS($PGMNAM);


# Summary of program run for Protocol
# -----------------------------------
  my $sumFil = "${dirOut}CODXTR.${yy}_${ssss}";
  appFile ("CODSPP: " . timstr(localtime(time)),
           0,"$$bpe{SYSOUT}","${sumFil}",1);

  my $satDel = 0;
  open (SYS,"< $$bpe{SYSOUT}");
  while (<SYS>) {
    $satDel = $satDel || (/SATELLITE\(S\) REMOVED FROM BROADCAST CLOCK FILE/);
  }
  close(SYS);


# Send SMS if indicated
# ---------------------
  if ($v_camp eq "IGSRAPID") {
      system("$ENV{AUTO}/pos_epoch.com $yy $ddd $$bpe{SYSOUT}");}


# Check for and delete files with RMS larger than 999 m
# -----------------------------------------------------
  my $iDel=0;
  if (-s $delFil) {
    open (DEL,$delFil);
    while (<DEL>) {
      $iDel++;
      chomp;
      while ( /^ / ) { s/^ // }  # Remove leading blanks
      unlink ($_);
      prtMess($bpe,"$_ deleted") }
    close DEL;
    appFile ("Files excluded from processing:",0,"$delFil","$sumFil",1);
    unlink $delFil;
  }


# Update the Observation File Table
# ---------------------------------
  if ($iDel > 0) {
      system("echo $iDel FILES DELETED >> $sumFil");  }


# GLONASS-GPS time offsets
# ------------------------
  my $outFil="$dirDcb/OFF$yy$ddd.$extDcb";
  unlink("$outFil");

  foreach my $inpFil (glob "$dirDcb/OFF0??.$extDcb") {
    if (-e $outFil){
      system("$ENV{AUTO}/filmerge.pl $outFil $inpFil ${outFil}_TMP 7");
      rename("${outFil}_TMP","$outFil");
    } else {
      copyfile("$inpFil","$outFil");}
  }

# Repeat CODSPP without the removed satellites
# --------------------------------------------
  if ($satDel && $param1 eq "NEXTJOB") {

    my $PGMNAM = "SATMRK";
    $bpe->RUN_PGMS($PGMNAM);

    logJump($bpe, $param2);
    prtGoto($bpe,$param2) ;

  }

}
