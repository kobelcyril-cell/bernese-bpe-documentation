package ORBAPF;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  ORBAPF
#
# Purpose :  Execute ORBGEN with a special ERP file
#
# PARAMs  :
#
# Authors :  H. Bock
# Created :  02-Feb-2012
#
# Changes :  04-Sep-2018 DA: Set max. pot. deg. via V_POTDEG
#            17-Jan-2023 DA: Corrected setting of max. pot. deg.
#
# ----------------------------------------------------------------------------
use strict;

use lib $ENV{BPE};
use bpe_util qw(setUserVar);

use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss,
      $A, $B,
      $dirErp,
      $extErp,
      $V_POTDEG) =
  $bpe->getKeys(
      '$YSS+0',
      'V_A','V_B',
      'DIR_ERP',
      'EXT_ERP',
      'V_POTDEG');

  my $NAM="COP";
  copy("${dirErp}$B${yyssss}.${extErp}","${dirErp}$A$NAM${yyssss}.${extErp}");

  # Set max. degree for Earth potential (if V_POTDEG set)
  # -----------------------------------------------------
  if ($V_POTDEG) {
      print "Set max. potential degree to $V_POTDEG\n";
      $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP","MXPOTDEG",$V_POTDEG);
  }

# Execute ORBGEN
# --------------
  my $PGMNAM="ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);

  unlink("${dirErp}$A$NAM${yyssss}.${dirErp}");

}
