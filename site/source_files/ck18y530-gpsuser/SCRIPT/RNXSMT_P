package RNXSMT_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  RNXSMT_P
#
# Purpose :  Parallel RNXSMT run
#
# Programs:  RNXSMT
#
# Author  :  M. Meindl
# Created :  30-Jul-2003               Last modified: 26-May-2009
#
# Changes :  10-Feb-2005 mm: Old date variables removed
#            19-May-2009 rd: Session dependent parallelization filenames
#            26-May-2009 rd: RNXERR: YY_DDD -> YY_SSSS
#            10-Dec-2020/st: RNXSMT: RNXFIL -> RNXFIL_SHORT
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yy, $ssss , $ddd , $yyssss ,
      $param1 , $subPid  , $numFil, $numClu,
      $dirOut) =
   $bpe->getKeys
     ('$Y', '$S+0', '$+0', '$YSS+0',
      'PARAM1', 'SUB_PID', 'V_CLU', 'V_NCLU',
      'DIR_OUT');

# Set cluster number and input files
# ----------------------------------
  my $cluster = $numFil eq "" && $numClu eq "" ? "$ddd$param1" : "$ssss$subPid";
  my $ffff    = $numFil eq "" && $numClu eq "" ? $param1       : "____";

  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$ffff,"CCC",$subPid);

  if ($numFil eq "" && $numClu eq "") {
    $bpe->putKey("$ENV{U}/PAN/RNXSMT.INP","RNXFIL_SHORT","$param1$ssss") }
  else {
    replaceSel($bpe,"RNXSMT","RNXFIL_SHORT",$param1) }

# Run program
# -----------
  my $PGMNAM = "RNXSMT";
  $bpe->RUN_PGMS($PGMNAM);

# Extract warning/error messages from protocol file
# -------------------------------------------------
  getWarn($bpe,"${dirOut}/RNXERR.${yy}_${ssss}");


# Delete BPE file
# ---------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;
  unlink($param1);

}
