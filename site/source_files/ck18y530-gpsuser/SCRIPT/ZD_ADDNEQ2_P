package ADDNEQ2_P;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  ADDNEQ2_P
#
# Purpose :  Initialize parallel execution of ADDNEQ2
#
# Author  :  C. Kobel
# Created :  02-Jul-2026
#
# Changes :
#===========================================================

use strict;
use File::Basename;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

  # ---------- Get variables ------------
  my (
      $ssss,
      $sol,
      $dirNeq,
      $extNeq
  ) = $bpe->getKeys(
      '$S+0',
      "$$bpe{PARAM2}",
      'DIR_NEQ',
      'EXT_NEQ'
  );

  # ---------- Initialize parallel ADDNEQ2 processing ------------
  initPar_Fl(
    $bpe,
    glob("${dirNeq}${sol}${ssss}[0-9][0-9][0-9]_.${extNeq}")
  );
}