package ADDNEQZD;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  ADDNEQZD
#
# Purpose :  Execute ADDNEQ2 according to the input argument
#
# PARAMs  :  PARAM1: Value of user variable $(SOL)
#
# Author  :  E. Calero
# Created :  25-Feb-2020
#
# Changes :  
#
# ============================================================================

use strict;
use lib "$ENV{BPE}";
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($sol,$ssss,
      $dirNeq,   $extNeq) = 
      $bpe->getKeys(
      "$$bpe{PARAM1}",'$S+0',
      'DIR_NEQ','EXT_NEQ');

# Initialize $SOL variable
  setUserVar($bpe,"SOL",$sol);

# Run program
# -----------
  my $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

# Clean station-wise NEQs
# -----------------------
  unlink glob("${dirNeq}${sol}A${ssss}????.${extNeq}");
  unlink glob("${dirNeq}${sol}_${ssss}????.${extNeq}");

}
