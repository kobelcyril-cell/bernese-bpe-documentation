package MKCLUS;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name:      MKCLUS
#
# Purpose:   Run MKCLUS
#
# Programs:  MKCLUS
#
# Authors:   R. Dach
#
# Created:   03-July-2009
#
# Changes:   07-Jun-2016 RD: Add version with compatible attitude modelling
#
# ----------------------------------------------------------------------------

use strict;
use File::Copy;
use File::Basename;
use lib $ENV{BPE};
use bpe_util;


sub run
{
  my $bpe = shift;


# Get variables
# -------------
  my $fixFil = "";
  my ($param1,$u,$ssss,$yyssss,
      $dirClb,$extClb,$dirOut,$extOut,$dirFix,$extFix) =
      $bpe->getKeys(
      $$bpe{PARAM1},'U','$S+0','$YSS+0',
      'DIR_CLB','EXT_CLB','DIR_OUT','EXT_OUT','DIR_FIX','EXT_FIX');

  # Are cluster files specified as parameters?
  # ------------------------------------------
  my  @clbList = glob("${dirClb}${param1}${ssss}??.${extClb}");

  if ("${param1}" ne "" && scalar @clbList) {

    # Merge all observation files in these cluster files
    # --------------------------------------------------
    my %obsLst = ();

    foreach my $clbFil ( @clbList ) {
      unless (-s $clbFil) { next }

      open (CLB,"< $clbFil");
      while (my $obsFil = <CLB> ) {
        chomp($obsLst{ substr(basename($obsFil),0,8) } = $obsFil);
      }
      close(CLB);
    }

    # Use the merged list of observation files
    # ----------------------------------------
    my $scrFil = "$u/WORK/OBSFIL.SEL";
    open (OBS,"> $scrFil");
    map { print OBS "$obsLst{$_}\n"; } sort keys %obsLst;
    close OBS;

    replaceSel($bpe,"MKCLUS","PZHFILES",$scrFil);

    # Do not remove the reference clock
    # ---------------------------------
    my $outFil = "${dirOut}${param1}_${yyssss}.${extOut}";
    if (-e $outFil) {
      open (INP,"< $outFil");
      while (<INP>){
        next unless ($_=~ /^ Selected reference station:/);
        $fixFil = "${dirFix}${param1}_${yyssss}.${extFix}";
        open(FIX,"> $fixFil");
        print FIX substr($_,33);
        close FIX;
        system("$ENV{EXE}/NPUTFIL",$fixFil,"FIX","REPLACE",$fixFil);
        $bpe->putKey("$ENV{U}/PAN/MKCLUS.INP","CORESITE",$fixFil);
        last;
      }
      close INP;

    }

  }

# Run program CLKEST
# --------------------
  my $PGMNAM = "MKCLUS";
  $bpe->RUN_PGMS($PGMNAM);

# Remove stations if requested
# ----------------------------
  my $del = $bpe->getKey("$ENV{U}/INP/MKCLUS.INP","NOTUSE");
  if ($del ne "") {

    my ($yyssss,$dirSmc,$extSmc)=$bpe->getKeys('$YSS+0','DIR_SMC','EXT_SMC');
    my $sum = "${dirSmc}SMT${yyssss}.${extSmc}";
    appFile("Files excluded from processing (too many stations):",0,$del,$sum,0);

    open (DEL,"< $del");
    while (<DEL>) { chomp(); unlink $_ }
    close (DEL);
  }

# Remove a "private" fix file
# ---------------------------
  unlink $fixFil if ("$fixFil" ne "");
}
