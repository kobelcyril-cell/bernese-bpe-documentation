package CLKEST;
@ISA = ("RUNBPE");

#===========================================================
# Name:      CLKEST
#
# Purpose:   CLKEST
#
# Authors:   H. Bock
#
# Created:   07-July-2003
#
# Changes:   10-Feb-2005 mm: $s replaced by $bpe
# Changes :  26-May-2026 CK: Revised and formatted
#===========================================================


use strict;
use File::Basename;
use lib "$ENV{BPE}";
use bpe_util;


sub run
{
  my $bpe = shift;


# Get variables
# -------------
  my ($param1,$u,$ssss,
      $dirClb,$extClb) =
      $bpe->getKeys(
      $$bpe{PARAM1},'U','$S+0',
      'DIR_CLB','EXT_CLB');

  # Are cluster files specified as parameters?
  # ------------------------------------------
  my  @clbList = glob("${dirClb}${param1}${ssss}??.${extClb}");

  if (scalar @clbList) {

    # Merge all observation files in these cluster files
    # --------------------------------------------------
    my %obsLst = ();

    foreach my $clbFil ( @clbList ) {
      unless (-s $clbFil) { next }

      open (CLB,"< $clbFil");
      while (my $obsFil = <CLB> ) {
        chomp($obsLst{ substr(basename($obsFil),0,8) } = $obsFil);
      }
      close(CLB);
    }

    # Use the merged list of observation files
    # ----------------------------------------
    my $scrFil = "$u/WORK/OBSFIL.SEL";
    open (OBS,"> $scrFil");
    map { print OBS "$obsLst{$_}\n"; } sort keys %obsLst;
    close OBS;

    replaceSel($bpe,"CLKEST","OBSFIL",$scrFil);
  }

# Run program CLKEST
# --------------------
  my $PGMNAM = "CLKEST";
  $bpe->RUN_PGMS($PGMNAM);

}
