package ORBGENF;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  ORBGENF
#
# Purpose :  Execute ORBGEN according to the input argument
#
# Author  :  E. Calero
# Created :  
#
# Changes :  12-Dec-2025 CK: Added LARGE solution
#===========================================================

use strict;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;

  # ---------- Get variables ------------
  my (
      $yyssss,
      $sol,
      $olap,
      $V_large,
      $pul
  ) = $bpe->getKeys(
      '$YSS+0',
      'V_FIN',
      'V_OLAP',
      'V_LARGE',
      'V_PUL'
  );

 if ($olap eq "NO") {
  # ---------- No RPR file written when pulses were estimated ------------
    if ($pul eq "YES") {
       $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP", "RPROUT", "");
       prtMess($bpe, "ORBIT MIDNIGHT PULSES ENABLED, NO RPR FILE GENERATED");
    }

    # Select processed GNSS systems
    # -----------------------------
    my ($v_gnss) = $bpe->getKeys('V_GNSS');
    &setGNSS($bpe,"$ENV{U}/PAN/ORBGEN.INP","USE_",$v_gnss);
  
    # ---------- Run program ------------
    my $PGMNAM = "ORBGEN";
    $bpe->RUN_PGMS($PGMNAM);
  }
  # ---------- Generate Orbit for LARGE solution ------------
  if ($pul eq "YES") {
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP", "RPROUT", "");
    prtMess($bpe, "ORBIT MIDNIGHT PULSES ENABLED, NO RPR FILE GENERATED");
  }
  else {
    $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP", "RPROUT", "${sol}${V_large}${yyssss}");
  }
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP", "IMPORB", "${sol}${V_large}${yyssss}");
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP", "POLE",   "${sol}${V_large}${yyssss}");
  $bpe->putKey("$ENV{U}/PAN/ORBGEN.INP", "STDOUT", "${sol}${V_large}${yyssss}");

  # Select processed GNSS systems
  # -----------------------------
  my ($v_gnss) = $bpe->getKeys('V_GNSS');
  &setGNSS($bpe,"$ENV{U}/PAN/ORBGEN.INP","USE_",$v_gnss);

  # ---------- Run program ------------
  my $PGMNAM = "ORBGEN";
  $bpe->RUN_PGMS($PGMNAM);
}