use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

  my ($satcrx  ,$yyyy,  $ymdstr,    $extCrx,  $dirSta,  $yyddd, $useMGEX) =
     $bpe->getKeys(
     'V_SATCRX','$Y+0','$YMD_STR+0','EXT_CRX','DIR_STA','$YD+0','V_MGEINI');

#  Locally copy CRX file
   my $localCrx = "${dirSta}${satcrx}.${extCrx}";
   copyfile("$ENV{CONFIG}/${satcrx}.${extCrx}","$localCrx");
   
