#    Check for satellites in manoeuvre
     my $exception = "";
     my $sat       = "";
     my $msg       = "";
     my $count     = 0;
     open(FH, '<', $localCrx) or die $!;
     while(<FH>){
       $count = $count + 1;
       if ( $count < 7 ) {
         next
       }
       if ( $_ == "" ) {
         last
       }
       $exception = substr($_,14,11);
       $sat       = substr($_,0,5);
       $sat       =~ s/^\s+|\s+$//g;
       $sat = abs($sat);   # ← Remove minus sign (if present)
       $date      = substr($_,32,10);
       if ( $exception eq "0         0" and $date eq $ymdstr) {
         my $msg = "EXCLUDED SATELLITE $sat DUE TO MANOEUVRE";
         prtMess($bpe,$msg);

#        Run program
#        -----------
         $bpe->putKey("$ENV{U}/PAN/SATMRK.INP","STADAT",'$YMD_STR+0');
         $bpe->putKey("$ENV{U}/PAN/SATMRK.INP","ENDDAT",'$YMD_STR+0');
         $bpe->putKey("$ENV{U}/PAN/SATMRK.INP","SATNUM","$sat");
         $bpe->RUN_PGMS($PGMNAM);

       }
     }
     close(FH);
   }

#  Manual removal of satellites
