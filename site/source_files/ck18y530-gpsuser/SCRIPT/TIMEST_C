package TIMEST_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  TIMEST_P
#
# Purpose :  Parallel run of GPSEST using code and phase data
#
# Programs:  GPSEST
#
# Author  :  R. Dach
# Created :  17-Nov-2005               Last modified: 04-Mar-2010
#
# Changes :  04-Mar-2010/ss: Deactivate HOI setup if indicated
#
# ----------------------------------------------------------------------------

use strict;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($param1, $subPid, $yyddd, $trpModel, $dirIon, $extIon) =
    $bpe->getKeys('PARAM1', 'SUB_PID', '$YD+0', 'V_TRPMOD', 'DIR_ION', 'EXT_ION');


# Initialize $D4 variable with subpid
# -----------------------------------
  setUserVar($bpe,"CCC",$subPid);


# Replace selected with station list
# ----------------------------------
  replaceSel($bpe,"GPSEST","CZFILES",$param1);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PZFILES","");


# Deactivate HOI setup if indicated
# ---------------------------------
  my $hoiFil = "${dirIon}HOI${yyddd}.${extIon}";
  print "HOIFIL: $hoiFil\n";
  unless (-s $hoiFil) {
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","IONOS"," ");
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SCALHOI","0");
    prtMess($bpe,"HOI SETUP: DEACTIVATED");
  } else {
    prtMess($bpe,"HOI SETUP: UNCHANGED");
  }

# --------------------------------------------------
# Explicit TRPMOD switch via V_TRPMOD
# --------------------------------------------------
if ($trpModel eq "GMF") {
   $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","VMF_FILES",' ');
   $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","TROPOS","DRY_GMF");
   $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MAPPNG","WET_GMF");
   prtMess($bpe,"Troposphere model SETUP: $trpModel");
}


# Print the selected files to the log file
# ----------------------------------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;


# Run program
# -----------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);


}

