package RXOBV3_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  RXOBV3_P
#
# Purpose :  Parallel RXOBV3 run
#
# Programs:  RXOBV3
#
# Author  :  M. Meindl
# Created :  30-Jul-2003
#
# Changes :  10-Feb-2005 mm: Old date variables removed
#            19-May-2009 rd: Session dependent parallelization filenames
#            26-May-2009 rd: RNXERR: YY_DDD -> YY_SSSS
#            30-Sep-2014 lp: New GNSS selection using setGNSS
#            10-Dec-2020 st: RXOBV3: RXOFILE -> RXOFILE_SHORT
#
# ----------------------------------------------------------------------------
use strict;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yy, $ssss, $ddd, $yyssss,
      $param1, $subPid, $numFil, $numClu, $v_gnss, $dirOut) =
  $bpe->getKeys('$Y', '$S+0', '$+0', '$YSS+0',
      'PARAM1', 'SUB_PID', 'V_CLU', 'V_NCLU', 'V_GNSS', 'DIR_OUT');

# Select GNSS
# -----------
  &setGNSS($bpe,"$ENV{U}/PAN/RXOBV3.INP","USE_",$v_gnss);


# Set cluster number and input files
# ----------------------------------
  my $cluster = $numFil eq "" && $numClu eq "" ? "$ddd$param1" : "$yyssss" . substr($subPid,1);
  my $ffff    = $numFil eq "" && $numClu eq "" ? $param1       : "____";

  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$ffff,"CCC",$subPid);

  if ($numClu eq "" && $numFil eq "") {
    $bpe->putKey("$ENV{U}/PAN/RXOBV3.INP","RXOFILE_SHORT","$param1$ssss");
    $bpe->putKey("$ENV{U}/PAN/RXOBV3.INP","SMTFILE","$param1$ssss") }
  else {
    replaceSel($bpe,"RXOBV3","RXOFILE_SHORT",$param1);
    replaceSel($bpe,"RXOBV3","SMTFILE",$param1) }


# Run program
# -----------
  my $PGMNAM = "RXOBV3";
  $bpe->RUN_PGMS($PGMNAM);


# Extract warnings from protocol files
# ------------------------------------
  getWarn($bpe,"${dirOut}/RNXERR.${yy}_${ssss}");


# Delete BPE file
# ---------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;
  unlink($param1);

}
