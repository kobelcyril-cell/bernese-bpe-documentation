package PPPIAR_P;
@ISA = ("RUNBPE");

# ============================================================================
# Name    :  PPPIAR_P
#
# Purpose :  PPP WL/NL AR and verification
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  21-Jun-2018
#
# Changes :  21-Jun-2018 SS: Derived from FILEST_P
#            10-Aug-2018 SS: Changed observation data sampling for NL AR
#            07-Dec-2020 RD: Add PCF variable V_TRPMOD
#            12-Nov-2021 LP: Set USEAR_ using $satsysAR
# ============================================================================

use strict;

use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my (
      $ssss, 
      $yyyyssss,
      $param1, 
      $param2, 
      $satsysAR, 
      $orb, 
      $fin
    ) = $bpe->getKeys(
      '$S+0', 
      '$YYYSS+0',
      'PARAM1', 
      'PARAM2', 
      'V_GNSSAR', 
      'V_ORB', 
      'V_FIN'
    );


# Set cluster number and input files
# ----------------------------------
  my $fix = "$fin";
  if ( $param2 ne "" ) {
    $fix = defined $$bpe{$param2} ? $$bpe{$param2} : $param2;
  }

  my $cluster = "${yyyyssss}_${param1}";
  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$param1,"FIN",$fix);

# Set the GNSS to be used
# -----------------------
  $satsysAR =~ s/R//;  # Remove GLONASS
  setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USE_"  ,$satsysAR);
  setGNSS($bpe,"$ENV{U}/PAN/GPSEST.INP","USEAR_",$satsysAR);

# Compute the observation file name
# ---------------------------------
  my $obsfil = "$param1$ssss";
  prtMess($bpe,"PROCESSING FILE $obsfil");

# WL AR
# -----
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","TITLE",'$YYYSS+0_$(FFFF): WIDELANE PHASE INTEGER FIXING');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PZFILES",$obsfil);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","CZFILES",$obsfil);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT",'WLI_$(CLUSTER)');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","COORDRS",'');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SATCLK",'');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","IONOS",'');

  my $PGMNAM = "GPSEST";

  eval {
    $bpe->RUN_PGMS($PGMNAM);
  };
  if ($@) {
    prtMess($bpe, "WARNING: $PGMNAM (WL AR) failed: $@");
    return;
  }

# NL AR
# -----
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","TITLE",'$YSS+0_$(FFFF): NARROWLANE PHASE INTEGER FIXING');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SYSOUT",'NLI_$(CLUSTER)');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","COORDRS",'NLI_$(CLUSTER)');
#ck
# $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","OSBOUT",'TEST_$(CLUSTER)');
#ck
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SATCLK",'$(ORB)_$YYYSS+0');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","IONOS",'$(HOIFIL)');
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","FREQUENCY","L3");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","CORREL","CORRECT");
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","APRWIDE","1");
# Changed observation data sampling for NL AR
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","SAMPLE","300");

  eval {
    $bpe->RUN_PGMS($PGMNAM);
  };
  if ($@) {
    prtMess($bpe, "WARNING: $PGMNAM (NL AR) failed: $@");
    return;
  }
}
