use strict;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyddd, $yyssss, $CRD, $SOL) = $bpe->getKeys('$YD+0','$YSS+0','V_CRD', 'V_SOL');

# Set precise orbit files
# -----------------------
  my $tmpFil = "$ENV{U}/WORK/CRDCMP.lst";

  open OUT, '>', $tmpFil;
  print OUT "$CRD${yyssss}\n";
  print OUT "F${SOL}_${yyddd}\n";
  close OUT;
  $bpe->putKey("$ENV{U}/PAN/COMPAR2.INP","COOFIL","SELECTED","REPLACE",$tmpFil);

  system("rm $ENV{U}/WORK/CRDCMP.lst");

# Run program COMPAR2
# --------------------
  my $PGMNAM = "COMPAR2";
  $bpe->RUN_PGMS($PGMNAM);

}
