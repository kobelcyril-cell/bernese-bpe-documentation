package SAVECLKDE;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  SAVECLKDE
#
# Purpose :  Save results from clock densification
#
# PARAMs  :  PARAM1 - Troposphere solution
#            PARAM2 - High rate solution
#
# Author  :  E. Calero
# Created :  xx-xxx-20xx
#
# Changes :  
#
# ============================================================================

use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss, $yyddd, $ssss,
      $trp, $hrc,$save,
      $dirRxc,  $dirTrp,  $dirStd,  $dirClk,  $dirErp,  $dirRpr,  $dirPre,
      $dirFix,  $dirNeq,  $dirSos,  $dirOsb,  $dirPzh,  $dirBpe,
      $extRxc,  $extTrp,  $extStd,  $extClk,  $extErp,  $extRpr,
      $extFix,  $extNeq,  $extSos,  $extOsb,  $extPre
      ) =
    $bpe->getKeys(
      '$YSS+0','$YD+0','$S+0',
      $$bpe{PARAM1},$$bpe{PARAM2},'$(SAVE)',
      'DIR_RXC','DIR_TRP','DIR_STD','DIR_CLK','DIR_ERP','DIR_RPR','DIR_PRE',
      'DIR_FIX','DIR_NEQ','DIR_SOS','DIR_OSB','DIR_PZH','DIR_BPEOUT',
      'EXT_RXC','EXT_TRP','EXT_STD','EXT_CLK','EXT_ERP','EXT_RPR',
      'EXT_FIX','EXT_NEQ','EXT_SOS','EXT_OSB','EXT_PRE'
      );

  if ( $save eq "YES" ) {

#   Create results folders
#   ----------------------
    my $resFol = "$ENV{K}/CK_ZDGNSS_ARCHIVE/${yyddd}/";
    my $resOrb = "$resFol/ORB/";
    my $resSta = "$resFol/STA/";
    my $resOut = "$resFol/OUT/";
    system("cd $ENV{K}/CK_ZDGNSS_ARCHIVE/; tar xvfz ${yyddd}.tgz");


#   Copy files
#   ----------
    copyfile("${dirTrp}${trp}_$yyssss.${extTrp}","${resSta}");
    copyfile("${dirClk}${hrc}_$yyssss.${extClk}","${resOrb}");
    copyfile("${dirRxc}${hrc}_$yyssss.${extRxc}","${resOut}");

    system("cd $resFol/..; tar cvfz ${yyddd}_tmp.tgz ${yyddd}; rm -r ${yyddd}; mv ${yyddd}.tgz ${yyddd}_rmv.tgz; mv ${yyddd}_tmp.tgz ${yyddd}.tgz; rm ${yyddd}_rmv.tgz");
    system("cd $ENV{K}/CK_ZDGNSS_ARCHIVE/; touch ${yyddd}_CLK.SAVE");
  }

}
