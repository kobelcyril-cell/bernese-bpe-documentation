package TIMCLK;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  TIMCLK
#
# Purpose :  Parallel run of GPSEST to generate code-only clocks
#
# Programs:  GPSEST
#
# Author  :  E. Calero
# Created :  xx-???-20??
#
# Changes : 
#
# ----------------------------------------------------------------------------

use strict;
use lib $ENV{BPE};
use bpe_util;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($param1, $subPid, $yyddd, $ssss, $usehoi, $trpModel, $dirIon, $extIon) =
    $bpe->getKeys('PARAM1', 'SUB_PID', '$YD+0', '$S+0' ,'V_USEHOI', 'V_TRPMOD', 'DIR_ION', 'EXT_ION');


# Initialize $D4 variable with subpid
# -----------------------------------
  setUserVar($bpe,"CCC",$subPid);

# ------------------------------------------------------------
# Explicit HOI switch via V_USEHOI
# ------------------------------------------------------------
if ($usehoi eq "NO") {
    $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","IONOS","");
    prtMess($bpe,"HOI SETUP: DISABLED by V_USEHOI=NO");
}

# --------------------------------------------------
# Explicit TRPMOD switch via V_TRPMOD
# --------------------------------------------------
if ($trpModel eq "GMF") {
   $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","VMF_FILES",' ');
   $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","TROPOS","DRY_GMF");
   $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","MAPPNG","WET_GMF");
   prtMess($bpe,"Troposphere model SETUP: $trpModel");
}


# Replace selected with station list
# ----------------------------------
  replaceSel($bpe,"GPSEST","CZFILES",$param1);
  $bpe->putKey("$ENV{U}/PAN/GPSEST.INP","PZFILES","");


# Print the selected files to the log file
# ----------------------------------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;


# Run program: GPSEST
# ----------------------
  my $PGMNAM = "GPSEST";
  $bpe->RUN_PGMS($PGMNAM);

  }

