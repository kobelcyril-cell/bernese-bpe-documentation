package DEL_RES_PPP;
@ISA = ("RUNBPE");

# ============================================================================
# Name    :  DEL_RES_PPP
#
# Purpose :  Clean up campaign of PPP processing,
#            default for -5 sessions
#
# PARAMs  :  PARAM1: may specify the delay in sessions to delete the files
#                    generated by the PPP BPE
#                    Examples:
#                    "-5"   : delete with five sessions
#                    "-(24)": delete with 24 sessions delay
#                             (note that the value from PARAM1 is used to
#                             extent the BPE time variables in a getKeys-call
#                             below)
#                    "TODAY": delete the files of the current session
#
# Author  :  R. Dach
# Created :  11-Aug-2011
#
# Changes :  22-Apr-2022 LP: Remove outdated $dirTab, $extTab, 'DIR_TAB', 'EXT_TAB'
#            25-Apr-2022 LP: Add printing of basic settings
# ============================================================================

use strict;

use lib "$ENV{BPE}";
use bpe_util qw(prtMess);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($thisSess, $yyyyssss, $ssss, $yyyyddd,
      $apr, $orb, $ppp, $fin, $ref, $red, $gcc, $kin, $trp,
      $del, $hoiFil, $osbFil, $param1,
      $dirOut, $dirSum, $dirLst, $dirSmc, $dirEdt, $dirRes,
      $extOut, $extSum, $extLst, $extSmc, $extEdt, $extRes,
      $dirRxc, $dirCrd, $dirVel, $dirGcc, $dirKin, $dirNeq,
      $extRxc, $extCrd, $extVel, $extGcc, $extKin, $extNeq,
      $dirSnx, $dirPre, $dirStd, $dirErp, $dirClk,
      $extSnx, $extPre, $extStd, $extErp, $extClk,
      $dirDcb, $dirTrp, $dirTro, $dirSmt, $dirRnx, $dirOrx,
      $extDcb, $extTrp, $extTro, $extSmt, $extRnx, $extOrx,
      $dirPzh, $dirPzo, $dirCzh, $dirCzo, $dirIep, $dirBia,
      $extPzh, $extPzo, $extCzh, $extCzo, $extIep, $extBia,
      $dirIon, $dirOsb,
      $extIon, $extOsb) =
    $bpe->getKeys(
      '$YYYSS+0', '$YYYSS-5', '$S-5', '$YYYD-5',
      'V_APR', 'V_ORB', 'V_PPP', 'V_FIN', 'V_REF', 'V_RED', 'V_GCC', 'V_KIN', 'V_TRP',
      'V_DEL','V_HOIFIL', 'V_OSBFIL', 'PARAM1',
      'DIR_OUT','DIR_SUM','DIR_LST','DIR_SMC','DIR_EDT','DIR_RES',
      'EXT_OUT','EXT_SUM','EXT_LST','EXT_SMC','EXT_EDT','EXT_RES',
      'DIR_RXC','DIR_CRD','DIR_VEL','DIR_GCC','DIR_KIN','DIR_NEQ',
      'EXT_RXC','EXT_CRD','EXT_VEL','EXT_GCC','EXT_KIN','EXT_NEQ',
      'DIR_SNX','DIR_PRE','DIR_STD','DIR_ERP','DIR_CLK',
      'EXT_SNX','EXT_PRE','EXT_STD','EXT_ERP','EXT_CLK',
      'DIR_DCB','DIR_TRP','DIR_TRO','DIR_SMT','DIR_RBO','DIR_OBO',
      'EXT_DCB','EXT_TRP','EXT_TRO','EXT_SMT','EXT_RBO','EXT_RBO',
      'DIR_PZH','DIR_PZO','DIR_CZH','DIR_CZO','DIR_IEP','DIR_BIA',
      'EXT_PZH','EXT_PZO','EXT_CZH','EXT_CZO','EXT_IEP','EXT_BIA',
      'DIR_ION','DIR_OSB',
      'EXT_ION','EXT_OSB');


# Redefine the date if necessary
    if ( uc $param1 eq "TODAY" ) {
      ($yyyyssss, $ssss, $yyyyddd) =
      $bpe->getKeys('$YYYSS+0','$S+0','$YYYD+0')
    } elsif ( $param1 ne "" ) {
      $param1 = "-" . $param1 unless $param1 =~ /^[\-+]/;
      ($yyyyssss, $ssss, $yyyyddd) =
      $bpe->getKeys('$YYYSS'.$param1, '$S'.$param1, '$YYYD'.$param1)
    }

# Delete BSW model files with the same scheme as the other files
    if ( $thisSess ne $yyyyssss ) {
      $hoiFil =~ s/_$thisSess/_$yyyyssss/;
      $osbFil =~ s/_$thisSess/_$yyyyssss/;
    }

# Delete Files if requested
# -------------------------
    print "### PPP_DEL: Delete files after processing?: ${del} for session ${yyyyssss}\n";

    if ( ${del} ne "Y" ) {
        prtMess($bpe,"FILES NOT DELETED");

# Delete Files from Previous Run
# ------------------------------
    } else {
        prtMess($bpe,"DELETE FILES");
#
        unlink glob "$dirOut*.J_lk";

# Observation files
        unlink glob("${dirOrx}*${yyyyssss}.${extOrx}");
        unlink glob("${dirRnx}*${yyyyssss}.${extRnx}");
        unlink glob("${dirSmt}*${yyyyssss}.${extSmt}");

#       unlink glob("${dirPzh}????${ssss}.${extPzh}");
#       unlink glob("${dirPzo}????${ssss}.${extPzo}");
#       unlink glob("${dirCzh}????${ssss}.${extCzh}");
#       unlink glob("${dirCzo}????${ssss}.${extCzo}");


# Troposphere and Ionosphere
        unlink glob("${dirIon}${hoiFil}.${extIon}");
        unlink glob("${dirTrp}${ppp}_${yyyyssss}.${extTrp}");
        unlink glob("${dirTro}${ppp}_${yyyyssss}.${extTro}");
        unlink glob("${dirTrp}${fin}_${yyyyssss}.${extTrp}");
        unlink glob("${dirTro}${fin}_${yyyyssss}.${extTro}");
        unlink glob("${dirTrp}${trp}_${yyyyssss}.${extTrp}") if "$trp" ne "";
        unlink glob("${dirTro}${trp}_${yyyyssss}.${extTro}") if "$trp" ne "";
        unlink glob("${dirTrp}${ppp}_${yyyyssss}_????.${extTrp}");
        unlink glob("${dirTro}${ppp}_${yyyyssss}_????.${extTro}");
        unlink glob("${dirTrp}${fin}_${yyyyssss}_????.${extTrp}");
        unlink glob("${dirTro}${fin}_${yyyyssss}_????.${extTro}");
        unlink glob("${dirTrp}${trp}_${yyyyssss}_????.${extTrp}") if "$trp" ne "";
        unlink glob("${dirTro}${trp}_${yyyyssss}_????.${extTro}") if "$trp" ne "";


# Orbit, ERP, satellite clocks
#        unlink glob("${dirOsb}${osbFil}.${extOsb}");
        unlink glob("${dirPre}${orb}_${yyyyddd}.${extPre}");
        unlink glob("${dirIep}${orb}_${yyyyddd}.${extIep}");
        unlink glob("${dirBia}${orb}_${yyyyddd}.${extBia}");
        unlink glob("${dirClk}${orb}_${yyyyssss}.${extClk}");
        unlink glob("${dirErp}${orb}_${yyyyssss}.${extErp}");
        unlink glob("${dirPre}${orb}_${yyyyssss}.${extPre}");
        unlink glob("${dirStd}${orb}_${yyyyssss}.${extStd}");
        unlink glob("${dirGcc}${gcc}_${yyyyssss}.${extGcc}") if "$gcc" ne "";


# Normal equations, SINEX
        unlink glob("${dirNeq}${red}_${yyyyssss}.${extNeq}");
        unlink glob("${dirSnx}${red}_${yyyyssss}.${extSnx}");
        unlink glob("${dirNeq}${ppp}_${yyyyssss}.${extNeq}");

        unlink glob("${dirNeq}${ppp}_${yyyyssss}_????.${extNeq}");
        unlink glob("${dirSnx}${ppp}_${yyyyssss}_????.${extSnx}");

        unlink glob("${dirNeq}${trp}_${yyyyssss}_????.${extNeq}") if "$trp" ne "";



# Coordinate and other station related files
        unlink glob("${dirCrd}${apr}_${yyyyssss}.${extCrd}");
        unlink glob("${dirVel}${apr}_${yyyyssss}.${extVel}");
        unlink glob("${dirCrd}${ppp}_${yyyyssss}.${extCrd}");
#        unlink glob("${dirCrd}${fin}_${yyyyssss}.${extCrd}");
        unlink glob("${dirCrd}${gcc}_${yyyyssss}.${extCrd}") if "$gcc" ne "";

        unlink glob("${dirCrd}${apr}_${yyyyssss}_????.${extCrd}");
        unlink glob("${dirCrd}${ppp}_${yyyyssss}_????.${extCrd}");
        unlink glob("${dirKin}${kin}_${yyyyssss}_????.${extKin}") if "$kin" ne "";
        unlink glob("${dirCrd}${trp}_${yyyyssss}_????.${extCrd}") if "$trp" ne "";


# Program output and summary files
#        unlink glob("${dirOut}PPP_${yyyyssss}.PRC");
        unlink glob("${dirOut}CRD_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}VEL_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}NUV_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}HLM_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}RES_${yyyyssss}.PRC");
        unlink glob("${dirOut}CHK_${yyyyssss}.${extOut}");
        unlink glob("${dirSum}CHK_${yyyyssss}.${extSum}");
        unlink glob("${dirSum}MPR_${yyyyssss}.${extSum}");
        unlink glob("${dirSum}MPS_${yyyyssss}.${extSum}");
        unlink glob("${dirSum}RES_${yyyyssss}.${extSum}");
        unlink glob("${dirOut}EDL_${yyyyssss}.${extOut}");
        unlink glob("${dirSum}EDL_${yyyyssss}.${extSum}");
        unlink glob("${dirOut}EDF_${yyyyssss}.${extOut}");
        unlink glob("${dirSum}EDF_${yyyyssss}.${extSum}");
        unlink glob("${dirSum}${ppp}_${yyyyssss}_CRD.${extSum}");
        unlink glob("${dirSum}${ppp}_${yyyyssss}_OUT.${extSum}");
        unlink glob("${dirSum}${trp}_${yyyyssss}_OUT.${extSum}") if "$trp" ne "";
        unlink glob("${dirOut}BIA_${yyyyssss}.${extOut}");
        unlink glob("${dirSum}BIA_${yyyyssss}.${extSum}");
        unlink glob("${dirOut}XTR_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}SPP_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}OBS_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}GRA_${yyyyssss}.${extOut}");
        unlink glob("${dirSmc}GRA_${yyyyssss}.${extSmc}");
        unlink glob("${dirOut}ORB_${yyyyssss}.${extOut}");
        unlink glob("${dirLst}ORB_${yyyyssss}.${extLst}");
        unlink glob("${dirOut}CLK_${yyyyssss}.${extOut}");
        unlink glob("${dirRxc}${orb}_${yyyyddd}.${extRxc}");
        unlink glob("${dirRxc}${orb}_${yyyyssss}.${extRxc}");
        unlink glob("${dirRxc}${ppp}_${yyyyssss}.${extRxc}");
        unlink glob("${dirOut}${ppp}_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}${ref}_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}${red}_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}${gcc}_${yyyyssss}.${extOut}") if "$gcc" ne "";
        unlink glob("${dirSum}${gcc}_${yyyyssss}.${extSum}") if "$gcc" ne "";
        unlink glob("${dirOut}${kin}_${yyyyssss}.${extOut}") if "$kin" ne "";
        unlink glob("${dirSum}${kin}_${yyyyssss}.${extSum}") if "$kin" ne "";
        unlink glob("${dirOut}${trp}_${yyyyssss}.${extOut}") if "$trp" ne "";
        unlink glob("${dirSum}${trp}_${yyyyssss}.${extSum}") if "$trp" ne "";
        unlink glob("${dirOut}POL_${yyyyssss}.${extOut}");
        unlink glob("${dirOut}RNX_${yyyyssss}.ERR");
        unlink glob("${dirOut}MRG_${yyyyssss}_???.${extOut}");
        unlink glob("${dirOut}EDF_${yyyyssss}_????.${extOut}");
        unlink glob("${dirRes}EDF_${yyyyssss}_????.${extRes}");
        unlink glob("${dirEdt}EDF_${yyyyssss}_????.${extEdt}");
        unlink glob("${dirOut}EDL_${yyyyssss}_????.${extOut}");
        unlink glob("${dirRes}EDL_${yyyyssss}_????.${extRes}");
        unlink glob("${dirEdt}EDL_${yyyyssss}_????.${extEdt}");
        unlink glob("${dirOut}MRK_${yyyyssss}_????.${extOut}");
        unlink glob("${dirOut}${ppp}_${yyyyssss}_????.${extOut}");
        unlink glob("${dirRxc}${ppp}_${yyyyssss}_????.${extRxc}");
        unlink glob("${dirRes}${ppp}_${yyyyssss}_????.${extRes}");
        unlink glob("${dirOut}${kin}_${yyyyssss}_????.${extOut}") if "$kin" ne "";
        unlink glob("${dirSum}${kin}_${yyyyssss}_????.${extSum}") if "$kin" ne "";
        unlink glob("${dirOut}${trp}_${yyyyssss}_????.${extOut}") if "$trp" ne "";
        unlink glob("${dirOut}RES_${yyyyssss}_????.${extOut}");
        unlink glob("${dirEdt}RES_${yyyyssss}_????.${extEdt}");
        unlink glob("${dirOut}SPP_${yyyyssss}_????.${extOut}");
        unlink glob("${dirOut}MPR_${yyyyssss}_????.${extOut}");
        unlink glob("${dirOut}SMT_${yyyyssss}_?????????.${extOut}");
        unlink glob("${dirOut}COO_${yyyyssss}.${extOut}");
        unlink glob("${dirSum}WRN_${yyyyssss}_????.${extSum}");


    }
}
