package DEL_RES_PPP;
@ISA = ("RUNBPE");

# ============================================================================
# Name    :  DEL_RES_PPP
#
# Purpose :  Clean up campaign of PPP processing,
#            default for -5 sessions
#            File patterns reduced to the supplied session 20263120 log.
#
# PARAMs  :  PARAM1: may specify the delay in sessions to delete the files
#                    generated by the PPP BPE
#                    Examples:
#                    "-5"   : delete with five sessions
#                    "-(24)": delete with 24 sessions delay
#                             (note that the value from PARAM1 is used to
#                             extent the BPE time variables in a getKeys-call
#                             below)
#                    "TODAY": delete the files of the current session
#
# Author  :  R. Dach
# Created :  11-Aug-2011
#
# Changes :  22-Apr-2022 LP: Remove outdated $dirTab, $extTab, 'DIR_TAB', 'EXT_TAB'
#            25-Apr-2022 LP: Add printing of basic settings
# ============================================================================

use strict;

use File::Glob qw(bsd_glob GLOB_NOSORT);

use lib "$ENV{BPE}";
use bpe_util qw(prtMess);

# Delete matching files and report each result in the BPE job output.
# For wildcard patterns without matches, report the pattern itself.
sub deleteFiles {
  my ($pattern) = @_;
  my @files = bsd_glob($pattern, GLOB_NOSORT);

  unless (@files) {
    print "### PPP_DEL: NOT FOUND (no matching files): $pattern\n";
    return;
  }

  foreach my $file (@files) {
    if (!-e $file && !-l $file) {
      print "### PPP_DEL: NOT FOUND: $file\n";
    } elsif (unlink $file) {
      print "### PPP_DEL: DELETED: $file\n";
    } else {
      print "### PPP_DEL: DELETE FAILED: $file ($!)\n";
    }
  }
}

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyyyssss, $ssss, $ddd, $apr, $ppp, $fin, $del, $param1,
      $dirOut, $dirSum, $dirEdt, $dirRes,
      $extOut, $extSum, $extEdt, $extRes,
      $dirRxc, $dirCrd, $dirNeq, $extRxc, $extCrd, $extNeq,
      $dirTrp, $dirTro, $extTrp, $extTro) =
    $bpe->getKeys(
      '$YYYSS-5', '$S-5', '$+0', 'V_APR', 'V_PPP', 'V_FIN', 'V_DEL', 'PARAM1',
      'DIR_OUT', 'DIR_SUM', 'DIR_EDT', 'DIR_RES',
      'EXT_OUT', 'EXT_SUM', 'EXT_EDT', 'EXT_RES',
      'DIR_RXC', 'DIR_CRD', 'DIR_NEQ', 'EXT_RXC', 'EXT_CRD', 'EXT_NEQ',
      'DIR_TRP', 'DIR_TRO', 'EXT_TRP', 'EXT_TRO');

# Redefine the date if necessary
    if ( uc $param1 eq "TODAY" ) {
      ($yyyyssss, $ssss) =
      $bpe->getKeys('$YYYSS+0','$S+0')
    } elsif ( $param1 ne "" ) {
      $param1 = "-" . $param1 unless $param1 =~ /^[\-+]/;
      ($yyyyssss, $ssss) =
      $bpe->getKeys('$YYYSS'.$param1, '$S'.$param1)
    }

# Delete Files if requested
# -------------------------
    print "### PPP_DEL: Delete files after processing?: ${del} for session ${yyyyssss}\n";

    if ( ${del} ne "Y" ) {
        prtMess($bpe,"FILES NOT DELETED");

# Delete Files from Previous Run
# ------------------------------
    } else {
        prtMess($bpe,"DELETE FILES");

# Troposphere
        deleteFiles("${dirTrp}${ppp}_${yyyyssss}_????.${extTrp}");
        deleteFiles("${dirTro}${ppp}_${yyyyssss}_????.${extTro}");
        deleteFiles("${dirTrp}${fin}_${yyyyssss}_????.${extTrp}");
        deleteFiles("${dirTro}${fin}_${yyyyssss}_????.${extTro}");

# Normal equations
        deleteFiles("${dirNeq}${ppp}_${yyyyssss}_????.${extNeq}");

# Coordinate and other station related files
        deleteFiles("${dirCrd}${apr}_${yyyyssss}.${extCrd}");
        deleteFiles("${dirCrd}${fin}_${yyyyssss}.${extCrd}");

        deleteFiles("${dirCrd}${ppp}_${yyyyssss}_????.${extCrd}");
        deleteFiles("${dirCrd}${fin}_${yyyyssss}_????.${extCrd}");
        deleteFiles("${dirCrd}NLI_${yyyyssss}_????.${extCrd}");
        deleteFiles("${dirCrd}SPP_${ddd}????.${extCrd}");

# Program output and summary files
        deleteFiles("${dirOut}RES_${yyyyssss}.${extOut}");
        deleteFiles("${dirOut}RES_${yyyyssss}.PRC");
        deleteFiles("${dirOut}${fin}_${yyyyssss}_OUT.${extSum}");
        deleteFiles("${dirOut}${fin}_${yyyyssss}_CRD.${extSum}");
        deleteFiles("${dirOut}${fin}${ssss}RES.${extSum}");
        deleteFiles("${dirOut}CHK_${yyyyssss}.${extOut}");
        deleteFiles("${dirSum}CHK_${yyyyssss}.${extSum}");
        deleteFiles("${dirSum}RES_${yyyyssss}.${extSum}");
        deleteFiles("${dirOut}EDL_${yyyyssss}.${extOut}");
        deleteFiles("${dirSum}EDL_${yyyyssss}.${extSum}");
        deleteFiles("${dirOut}EDF_${yyyyssss}.${extOut}");
        deleteFiles("${dirSum}EDF_${yyyyssss}.${extSum}");
        deleteFiles("${dirSum}${ppp}_${yyyyssss}_CRD.${extSum}");
        deleteFiles("${dirSum}${ppp}_${yyyyssss}_OUT.${extSum}");
        deleteFiles("${dirOut}XTR_${yyyyssss}.${extOut}");
        deleteFiles("${dirOut}SPP_${yyyyssss}.${extOut}");
        deleteFiles("${dirOut}OBS_${yyyyssss}.${extOut}");
        deleteFiles("${dirOut}RNX_${yyyyssss}.ERR");
        deleteFiles("${dirOut}CRDMERGE.L??");
        deleteFiles("${dirOut}GPSXTR.L??");
        deleteFiles("${dirOut}TMP_${yyyyssss}.${extOut}");
        deleteFiles("${dirOut}EDF_${yyyyssss}_????.${extOut}");
        deleteFiles("${dirRes}EDF_${yyyyssss}_????.${extRes}");
        deleteFiles("${dirOut}EDL_${yyyyssss}_????.${extOut}");
        deleteFiles("${dirRes}EDL_${yyyyssss}_????.${extRes}");
        deleteFiles("${dirOut}${ppp}_${yyyyssss}_????.${extOut}");
        deleteFiles("${dirRxc}${ppp}_${yyyyssss}_????.${extRxc}");
        deleteFiles("${dirOut}${fin}_${yyyyssss}_????.${extOut}");
        deleteFiles("${dirRxc}${fin}_${yyyyssss}_????.${extRxc}");
        deleteFiles("${dirRes}${fin}_${yyyyssss}_????.${extRes}");
#        deleteFiles("${dirOut}NLI_${yyyyssss}_????.${extOut}");
#        deleteFiles("${dirOut}WLI_${yyyyssss}_????.${extOut}");
	deleteFiles("${dirOut}NLI_?_${yyyyssss}_????.${extOut}");
        deleteFiles("${dirOut}WLI_?_${yyyyssss}_????.${extOut}");
        deleteFiles("${dirOut}RES_${yyyyssss}_????.${extOut}");
        deleteFiles("${dirEdt}RES_${yyyyssss}_????.${extEdt}");
        deleteFiles("${dirOut}MPR_${yyyyssss}_????.${extOut}");
        deleteFiles("${dirOut}SMT_${ddd}????.${extOut}");
        deleteFiles("${dirOut}SPP_${ddd}????.${extOut}");
        deleteFiles("${dirSum}WRN_${yyyyssss}_????.${extSum}");

    }
}
