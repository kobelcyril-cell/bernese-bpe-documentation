package PPPEDTAP;
@ISA = ("RUNBPE");

# ============================================================================
# Name    :  PPPEDTAP
#
# Purpose :  Prepare parallel precise-point-positioning (PPP) analysis
#
# PARAMs  :  PARAM2 - output file identifier (default: V_C)
#            PARAM3 - empty: stop if no PZH files are found
#
# Author  :  M. Meindl
# Created :  23-Jul-2003
#
# Changes :  31-Jan-2005 MM: New initPar call (w/o tmpFil)
#            11-Aug-2011 RD: Updated for version 5.2
# ============================================================================

use strict;

use File::Basename;

use lib $ENV{BPE};
use bpe_util qw(prtErr initPar_Bl initPar_Cl cleanFiles);

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my (
      $yyyyssss, 
      $ssss,
      $clu, 
      $dirBpe, 
      $ppp, 
      $param3,
      $dirPzh, 
      $extPzh 
    ) = $bpe->getKeys(
      '$YYYSS+0', 
      '$S+0',
      'V_CLU', 
      'DIR_BPEPRT', 
      'V_PPP', 
      'PARAM3',
      'DIR_PZH', 
      'EXT_PZH' 
    );

# Delete old output files
# -----------------------
  cleanFiles($bpe,"EDF",["OUT","RES"], "");
  cleanFiles($bpe,"EDL",["OUT","RES"], "");
  cleanFiles($bpe,"RES",["OUT","EDT"], "");
  cleanFiles($bpe,"WRN",["SUM"], "");
  cleanFiles($bpe, $ppp,  ["OUT","RXC","TRP","TRO","NEQ","CRD"], "");

# Initialize parallel run
# -----------------------
  my $bpeFil = "${dirBpe}EDT_${yyyyssss}_";
  my @pzhFil = glob("${dirPzh}????${ssss}.${extPzh}");

  if ($clu ne "") {
    initPar_Cl($bpe,$bpeFil,@pzhFil,0,$clu,0, ($clu));
  } else {
    @pzhFil = map { substr(basename($_),0,4) } @pzhFil;
    initPar_Bl($bpe,@pzhFil);
  }

# Stop if no PZH files found
# --------------------------
  if (@pzhFil == 0 && $param3 eq "") {
    prtErr($bpe,"No PZH files found") and
      die "No PZH files found for session ${ssss}";
  }

}
