package PHACMB;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  PHACMB
#
# Purpose :  Execute PHACMB
#
# Author  :  S. Schaer
# Created :  
#
# Changes :  29-Apr-2026 CK: Revised and formatted
#===========================================================

use strict;
use File::Copy;

sub run {
  my $bpe = shift;

  # ---------- Get variables ------------
  my (
      $yyssss,
      $yyddd,
      $isbh,
      $wlb,
      $nlb,
      $izd,
      $dirOut,
      $dirOsb,
      $extOsb
  ) = $bpe->getKeys(
      '$YSS+0',
      '$YD+0',
      'V_CBIA',
      'PARAM2',
      'PARAM3',
      'PARAM4',
      'DIR_OUT',
      'DIR_OSB',
      'EXT_OSB'
  );

  my $isb    = "${isbh}S";
  my $mscDir = "${dirOut}/../MSC/MSC_${yyddd}";

  # ---------- Create combined OSB file ------------
  my $isbfile = "${dirOsb}/${isb}${yyssss}.${extOsb}";
  my $wl_file = "${dirOsb}/${wlb}${yyssss}.${extOsb}";
  my $nl_file = "${dirOsb}/${nlb}${yyssss}.${extOsb}";
  my $iz_file = "${dirOsb}/" . substr(${izd}, 0, 2) . "_${yyssss}.${extOsb}";
  my $izdfile = "${dirOsb}/${izd}${yyssss}.${extOsb}";
  my $phafile = "${dirOsb}/PHA${yyssss}.${extOsb}";

  if (-s $wl_file && -s $nl_file) {

    system("perl $ENV{AUTO}/cmb_phabia.com $wl_file $nl_file $iz_file");

    if (-s $iz_file) {

      my %osb;

      $osb{G}{L1X}{L1W} = 1;
      $osb{G}{L1X}{L1C} = 1;
      $osb{G}{L2X}{L2W} = 1;
      $osb{G}{L2X}{L2C} = 1;
      $osb{G}{L2X}{L2X} = 1;

      $osb{R}{L1X}{L1P} = 1;
      $osb{R}{L1X}{L1C} = 1;
      $osb{R}{L2X}{L2P} = 1;
      $osb{R}{L2X}{L2C} = 1;

      $osb{E}{L1X}{L1C} = 1;
      $osb{E}{L1X}{L1X} = 1;
      $osb{E}{L5X}{L5Q} = 1;
      $osb{E}{L5X}{L5X} = 1;

      $osb{C}{L2X}{L2I} = 1;
      $osb{C}{L2X}{L2X} = 1;
      $osb{C}{L7X}{L7I} = 1;
      $osb{C}{L7X}{L7X} = 1;

      $osb{J}{L1X}{L1C} = 1;
      $osb{J}{L1X}{L1X} = 1;
      $osb{J}{L2X}{L2L} = 1;
      $osb{J}{L2X}{L2S} = 1;
      $osb{J}{L2X}{L2X} = 1;

      open my $OUT, ">", $izdfile;
      open my $INP, "<", $isbfile;

      print $OUT $_ for (<$INP>);
      close $INP;

      open $INP, "<", $iz_file;

      foreach (<$INP>) {
        if (/OSB  (\w)\d\d\d .* (L\d\w) /) {
          my $otyp = $2;
          chomp;

          foreach my $obstyp (sort keys %{$osb{$1}{$otyp}}) {
            my $line = $_;
            $line =~ s/$otyp/$obstyp/;
            print $OUT "$line\n";
          }
        }
      }

      while (<$INP>) {
        print $OUT $_ if / L\d\w /;
      }

      close $INP;
      close $OUT;
    }

    unlink($iz_file);

    `grep -v '  C[1-9][A-Z]   ' $izdfile > $phafile`;
    die "$phafile not found\n" unless -s $phafile;
  }
}
