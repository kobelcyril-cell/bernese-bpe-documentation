package PHACOR;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  PHACOR
#
# Purpose :  Execute PHACOR, special case for ZD-processing NL
#
# Author  :  C. Kobel
# Created :  27-Aug-2026
#
# Changes : 
#===========================================================

use strict;

sub run {
  my $bpe = shift;

  # ---------- Get variables ------------
  my (
      $yyssss,
      $yyddd,
      $ssss,
      $inposbh,
      $outosb,
      $v_apr,
      $extOsb,
      $dirOsb,
      $dirOut,
      $extBia,
      $extClk,
      $extCrd,
      $dirCrd,
      $extPre,
      $dirPre
  ) = $bpe->getKeys(
      '$YSS+0',
      '$YD+0',
      '$S+0',
      'V_CBIA',
      'PARAM2',
      'V_APR',
      'EXT_OSB',
      'DIR_OSB',
      'DIR_OUT',
      'EXT_BIA',
      'EXT_CLK',
      'EXT_CRD',
      'DIR_CRD',
      'EXT_PRE',
      'DIR_PRE'
  );

  my $inposb = "${inposbh}S";
  my $mscDir = "${dirOut}/../MSC/MSC_${yyddd}";

  # ---------- Run program ------------
  my $PGMNAM = "PHACOR";
  $bpe->RUN_PGMS($PGMNAM);
  my $osbNL_fl   = "${dirOsb}/NL_${yyssss}.OSB";
  my $biaNL_fl   = "${dirOsb}/NL_${yyssss}.BIA";
  my $clk_fl     = "${dirOsb}/${v_apr}_${yyssss}.CLK";
  my $pre_fl     = "${dirPre}/${v_apr}_${yyssss}.PRE";
  
  my $osbNL_flm   = "${dirOsb}/NL_${yyssss}_mod.OSB";
  my $biaNL_flm   = "${dirOsb}/NL_${yyssss}_mod.BIA";
  my $clk_flm     = "${dirOsb}/${v_apr}_${yyssss}_mod.CLK";
  my $pre_flm     = "${dirPre}/${v_apr}_${yyssss}_mod.PRE";
#  system("cp ${osbNL_fl} ${osbNL_flm}");
#  system("cp ${biaNL_fl} ${biaNL_flm}");
#  system("cp ${clk_fl} ${clk_flm}");
#  system("cp ${pre_fl} ${pre_flm}");

  system("cp ${osbNL_flm} ${osbNL_fl}");
  system("cp ${biaNL_flm} ${biaNL_fl}");
  system("cp ${clk_flm} ${clk_fl}");
  system("cp ${pre_flm} ${pre_fl}");

  # ---------- Create combined OSB file ------------
  if ($inposb ne '') {

    my $iOsbFil = "${dirOsb}/${inposb}${yyssss}.${extOsb}";
    my $oOsbFil = "${dirOsb}/NLB${yyssss}.${extOsb}";

    my $estOsb  = "";
    $estOsb = "${dirOsb}/NL_${yyssss}.${extOsb}";

    my %osb;

    $osb{G}{L1X}{L1W} = 1;
    $osb{G}{L1X}{L1C} = 1;
    $osb{G}{L2X}{L2W} = 1;
    $osb{G}{L2X}{L2C} = 1;
    $osb{G}{L2X}{L2X} = 1;

    $osb{R}{L1X}{L1P} = 1;
    $osb{R}{L1X}{L1C} = 1;
    $osb{R}{L2X}{L2P} = 1;
    $osb{R}{L2X}{L2C} = 1;

    $osb{E}{L1X}{L1C} = 1;
    $osb{E}{L1X}{L1X} = 1;
    $osb{E}{L5X}{L5Q} = 1;
    $osb{E}{L5X}{L5X} = 1;

    $osb{C}{L2X}{L2I} = 1;
    $osb{C}{L2X}{L2X} = 1;
    $osb{C}{L7X}{L7I} = 1;
    $osb{C}{L7X}{L7X} = 1;

    $osb{J}{L1X}{L1C} = 1;
    $osb{J}{L1X}{L1X} = 1;
    $osb{J}{L2X}{L2L} = 1;
    $osb{J}{L2X}{L2S} = 1;
    $osb{J}{L2X}{L2X} = 1;

    open my $OUT, ">", $oOsbFil;
    open my $INP, "<", $iOsbFil;

    print $OUT $_ for (<$INP>);
    close $INP;

    open $INP, "<", $estOsb;

    while (<$INP>) {
      if (/OSB  (\w)\d\d\d .* (L\d\w) /) {
        my $otyp = $2;
        chomp;

        foreach my $obstyp (sort keys %{$osb{$1}{$otyp}}) {
          my $line = $_;
          $line =~ s/$otyp/$obstyp/;
          print $OUT "$line\n";
        }
      }
    }

    while (<$INP>) {
      print $OUT $_ if / L\d\w /;
    }

    close $INP;
    close $OUT;
  }
}