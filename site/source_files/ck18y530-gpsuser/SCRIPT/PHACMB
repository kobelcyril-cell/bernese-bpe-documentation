package PHACMB;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  PHACMB
#
# Purpose :  Execute PHACMB
#
# PARAMs  :
#
# Author  :  S. Schaer
# Created :  26-Jul-2017
#
# Changes :  19-Sep-2017 AV: Modified OSB generation(replace L.X)
#            26-Sep-2017 SS: Corrections concerning $iz_file and $izdfile
#            22-May-2018 SS: Translation of PARAMs
#            05-Jun-2018 SS: Created PHA OSB file
#            20-Jun-2018 SS: Added ECJ
#            19-Sep-2018 SS: Considered NO_NLB.FLG
#
# ============================================================================
use File::Copy;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my   ($yyssss,$yyddd,
        $isb,$wlb,$nlb,$izd,
        $dirOut,$dirOsb,$extOsb) =
 $bpe->getKeys(
      '$YSS+0','$YD+0',
      'PARAM1','PARAM2','PARAM3','PARAM4',
      'DIR_OUT','DIR_OSB','EXT_OSB'
      );
  
  my $mscDir = "${dirOut}/../MSC/MSC_${yyddd}";
  $isb = $$bpe{"V_$isb"} if length($isb) == 1;
  $wlb = $$bpe{"V_$wlb"} if length($wlb) == 1;
  $nlb = $$bpe{"V_$nlb"} if length($nlb) == 1;
  $izd = $$bpe{"V_$izd"} if length($izd) == 1;

# Create combined OSB file
# ------------------------
  my $isbfile = "${dirOsb}/${isb}${yyssss}.${extOsb}";
  my $wl_file = "${dirOsb}/${wlb}${yyssss}.${extOsb}";
  my $nl_file = "${dirOsb}/${nlb}${yyssss}.${extOsb}";
  my $iz_file = "${dirOsb}/".substr(${izd},0,2)."_${yyssss}.${extOsb}";
  my $izdfile = "${dirOsb}/${izd}${yyssss}.${extOsb}";
  my $phafile = "${dirOsb}/PHA${yyssss}.${extOsb}";

  if(-s $wl_file && -s $nl_file){
    system("perl $ENV{AUTO}/cmb_phabia.com $wl_file $nl_file $iz_file");
    if(-s $iz_file){

      my %osb;
      $osb{G}{L1X}{L1W} = 1;
      $osb{G}{L1X}{L1C} = 1;
      $osb{G}{L2X}{L2W} = 1;
      $osb{G}{L2X}{L2C} = 1;
      $osb{G}{L2X}{L2X} = 1;
      $osb{R}{L1X}{L1P} = 1;
      $osb{R}{L1X}{L1C} = 1;
      $osb{R}{L2X}{L2P} = 1;
      $osb{R}{L2X}{L2C} = 1;
      $osb{E}{L1X}{L1C} = 1;
      $osb{E}{L1X}{L1X} = 1;
      $osb{E}{L5X}{L5Q} = 1;
      $osb{E}{L5X}{L5X} = 1;
      $osb{C}{L2X}{L2I} = 1;
      $osb{C}{L2X}{L2X} = 1;
      $osb{C}{L7X}{L7I} = 1;
      $osb{C}{L7X}{L7X} = 1;
      $osb{J}{L1X}{L1C} = 1;
      $osb{J}{L1X}{L1X} = 1;
      $osb{J}{L2X}{L2L} = 1;
      $osb{J}{L2X}{L2S} = 1;
      $osb{J}{L2X}{L2X} = 1;

      open OUT, "> $izdfile";
      open INP, "< $isbfile";
      map {print OUT $_} (<INP>);
      close INP;
      open INP, "< $iz_file";
      foreach (<INP>){
        if(/OSB  (\w)\d\d\d .* (L\d\w) /){
          my $otyp = $2;
          chomp;
          foreach my $obstyp (sort keys %{$osb{$1}{$otyp}}){
            my $line = $_;
            $line =~ s/$otyp/$obstyp/;
            print OUT "$line\n";
          }
        }
      }
      map {print OUT $_ if / L\d\w /} (<INP>);
      close INP;
      close OUT;
    }
    unlink($iz_file);

    my $nlbFlg = "${mscDir}/NO_NLB.FLG";
    if (-e $nlbFlg) {
      `grep -v '  L[1-9][A-Z]   ' $izdfile > ${izdfile}_`;
      move("${izdfile}_",$izdfile);
      print "PHA OSB removed from IAR${yyssss}.OSB due to NO_NLB.FLG\n";
    }

    `grep -v '  C[1-9][A-Z]   ' $izdfile > $phafile`;
    die "$phafile not found\n" unless -s $phafile;
  }
}
