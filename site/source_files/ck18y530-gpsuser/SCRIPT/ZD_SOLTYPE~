package ZD_SOLTYPE;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  ZD_SOLTYPE
#
# Purpose :  Depending on the solution type, either do
# 	     nothing or copy the LAPACK solution files
#	     to the final solution id-names
#
# Author  :  C. Kobel
# Created :  22-Oct-2026
#
# Changes :  
#===========================================================

use strict;
use lib $ENV{BPE};
use bpe_util;
use warnings;
use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

  # ---------- Get variables ------------
  my (
      $yyssss,
      $fin,
      $olap,
      $v_large,
      $dirOut,
      $extOut,
      $dirCrd,
      $extCrd,
      $dirEle,
      $extEle,
      $dirErp,
      $extErp,
      $dirOsb,
      $extOsb,
      $dirClk,
      $extClk,
      $dirRxc,
      $extRxc,
      $dirStd,
      $extStd,
      $dirRpr,
      $extRpr
  ) = $bpe->getKeys(
      '$YSS+0',
      'V_FIN',
      'V_OLAP',
      'V_LARGE',
      'DIR_OUT',
      'EXT_OUT',
      'DIR_CRD',
      'EXT_CRD',
      'DIR_ELE',
      'EXT_ELE',
      'DIR_ERP',
      'EXT_ERP',
      'DIR_OSB',
      'EXT_OSB',
      'DIR_CLK',
      'EXT_CLK',
      'DIR_RXC',
      'EXT_RXC',
      'DIR_STD',
      'EXT_STD',
      'DIR_RPR',
      'EXT_RPR'
  );

 if ($olap eq "YES") {
    copyfile("${dirOut}${fin}${v_large}${yyssss}.${extOut}","${dirOut}${fin}_${yyssss}.${extOut}");
    copyfile("${dirCrd}${fin}${v_large}${yyssss}.${extCrd}","${dirCrd}${fin}_${yyssss}.${extCrd}");
    copyfile("${dirEle}${fin}${v_large}${yyssss}.${extEle}","${dirEle}${fin}_${yyssss}.${extEle}");
    copyfile("${dirErp}${fin}${v_large}${yyssss}.${extErp}","${dirErp}${fin}_${yyssss}.${extErp}");
    copyfile("${dirOsb}${fin}${v_large}${yyssss}.${extOsb}","${dirOsb}${fin}_${yyssss}.${extOsb}");
    copyfile("${dirClk}${fin}${v_large}${yyssss}.${extClk}","${dirClk}${fin}_${yyssss}.${extClk}");
    copyfile("${dirRxc}${fin}${v_large}${yyssss}.${extRxc}","${dirOut}${fin}_${yyssss}.${extRxc}");
    copyfile("${dirStd}${fin}${v_large}${yyssss}.${extStd}","${dirStd}${fin}_${yyssss}.${extStd}");
    copyfile("${dirRpr}${fin}${v_large}${yyssss}.${extRpr}","${dirRpr}${fin}_${yyssss}.${extRpr}");
 }
}