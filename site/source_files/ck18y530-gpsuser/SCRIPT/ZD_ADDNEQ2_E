package ADDNEQ2_E;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  ADDNEQ2_E
#
# Purpose :  Execute parallel ADDNEQ2
#
# Author  :  C. Kobel
# Created :  02-Jul-2026
#
# Changes :
#===========================================================

use strict;
use lib $ENV{BPE};
use bpe_util;

sub run {
  my $bpe = shift;

  # ---------- Get variables ------------
  my (
      $param1,
      $subPid,
      $V_CBIA
  ) = $bpe->getKeys(
      'PARAM1',
      'SUB_PID',
      'V_CBIA'
  );

  # ---------- Set run identifier ------------
  setUserVar($bpe,"CCC",$subPid);

  # ---------- Log current NEQ file ------------
  print "Current NEQ file: $param1\n";

  # ---------- Run ADDNEQ2 ------------
  my $PGMNAM = "ADDNEQ2";
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","INPFILE","${V_CBIA}\$S+0\$(CCC)_");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","DCBOUT","${V_CBIA}S\$YSS+0\$(CCC)");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT","${V_CBIA}S\$YSS+0\$(CCC)");

  $bpe->RUN_PGMS($PGMNAM);
}