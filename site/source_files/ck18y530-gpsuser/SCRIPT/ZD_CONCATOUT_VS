package CONCATOUT_VS;
@ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  CONCATOUT_VS
#
# Purpose :  Concatenate validation output files
#
# PARAMs  :
#
# Author  :  C. Kobel
# Created :  16-Mar-2026
#
# ============================================================================
use strict;
use lib "$ENV{AUTO}";
use gpsutil;

sub run {
  my $bpe = shift;

# Get variables
# -------------
  my ($yyssss,$dirOut,$CRD,$STD,$outputPrefix,$vPre) =
    $bpe->getKeys('$YSS+0','DIR_OUT','V_CRD','V_STD','V_OUT','V_PRE');
  die "V_PRE is not defined\n" unless defined $vPre;

# Set input/output files
# ----------------------
  my @files = (
      "$dirOut/COMPAR2${CRD}${yyssss}.OUT",
      "$dirOut/HELMR1${CRD}${yyssss}.OUT",
      "$dirOut/STDELE${STD}${yyssss}.OUT",
      "$dirOut/$vPre.LST"
  );

  my $outFile = "$dirOut/$outputPrefix.VAL";

# Concatenate files
# -----------------
  my @inputs;
  foreach my $file (@files) {
      open my $IN, '<', $file or die "Cannot open $file: $!";
      push @inputs, $IN;
  }

  open my $outHandle, '>', $outFile or die "Cannot open $outFile: $!";

  foreach my $IN (@inputs) {
      while (my $line = <$IN>) {
          print {$outHandle} $line or die "Cannot write $outFile: $!";
      }
      close $IN;
  }

  close $outHandle or die "Cannot close $outFile: $!";

}

1;
