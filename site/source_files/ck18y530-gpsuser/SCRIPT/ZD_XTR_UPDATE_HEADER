package ZD_XTR_UPDATE_HEADER;
@ISA = ("RUNBPE");

#====================================================================
# Name    : ZD_XTR_UPDATE_HEADER
# Purpose : Replace the session identifier in the XTR summary header
#           with the processing date (YYDDD).
#====================================================================

use strict;
use warnings;
use File::Basename qw(dirname);
use File::Spec;
use File::Temp;

sub run {
  my $bpe = shift;
  my ($yyddd, $yyssss, $xtrOut, $extSum, $dirOut) = $bpe->getKeys(
    '$YD+0',
    '$YSS+0',
    'V_XTROUT',
    'EXT_SUM',
    'DIR_OUT'
  );

  die "Invalid processing date (expected YYDDD)\n"
    unless defined $yyddd && $yyddd =~ /\A[0-9]{5}\z/;

  $extSum =~ s/^\.//;
  my $file = "${xtrOut}XTR${yyssss}.${extSum}";
  $file = File::Spec->catfile($dirOut, $file)
    unless File::Spec->file_name_is_absolute($file);

  open my $in, '<:raw', $file or die "Cannot read $file: $!\n";
  my $mode = (stat($in))[2] // die "Cannot stat $file: $!\n";
  my $content = do { local $/; <$in> } // '';
  close $in or die "Cannot close $file after reading: $!\n";

  return if $content =~ /\A[ \t]*R1I\Q$yyddd\E\.OUT[ \t]+Rms:/;
  $content =~ s/\A([ \t]*R1I)[0-9]{7}(?=\.OUT[ \t]+Rms:)/${1}${yyddd}/
    or die "Unexpected XTR summary header in $file\n";

  my $out = File::Temp->new(DIR => dirname($file));
  my $temporary = $out->filename;
  binmode $out, ':raw' or die "Cannot set binary mode on $temporary: $!\n";
  print {$out} $content or die "Cannot write $temporary: $!\n";
  close $out or die "Cannot close $temporary: $!\n";
  chmod($mode & 0777, $temporary) or die "Cannot set permissions on $temporary: $!\n";
  rename $temporary, $file or die "Cannot replace $file: $!\n";
}
