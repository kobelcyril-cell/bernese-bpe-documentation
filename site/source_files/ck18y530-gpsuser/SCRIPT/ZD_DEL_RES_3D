package DEL_RES_3D;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  DEL_RES_3D
#
# Purpose :  Delete result files, only if V_DEL=Y.
#
# Author  :  C. Kobel
# Created :  08-Dec-2025
#
# Changes :  
#===========================================================

use lib "$ENV{AUTO}";
use gpsutil;
use strict;
use warnings;
use File::Basename;
use POSIX qw(strftime);

sub run {
  my $bpe = shift;

  # ---------- Parameter ------------
  my (
      $dirOut,
      $yyyy,
      $ssss,
      $yyssss,
      $yyssssm1,
      $yyssssp1,
      $yyddd,
      $CLEAN,
      $V_FIN,
      $V_APR,
      $V_ORBAPR
  ) = $bpe->getKeys(
      'DIR_OUT',
      '$Y+0',
      '$S+0',
      '$YSS+0',
      '$YSS-1',
      '$YSS+1',
      '$YD+0',
      'V_DEL',
      'V_FIN',
      'V_APR',
      'V_ORBAPR'
  );

  unless (defined $CLEAN && $CLEAN eq 'Y') {
    print "CLEAN variable not set to 'Y'. Nothing will be deleted.\n";
    return;
  }

  # ---------- Directories ------------
  my $dirSta = "${dirOut}../STA";
  my $dirOrb = "${dirOut}../ORB";
  my $dirSol = "${dirOut}../SOL";
  my $day    = $yyssss;

  print "------------------------------------------------------------\n";
  print "DEL_RES_3D started for $day\n";
  print "------------------------------------------------------------\n";

  # ---------- Define files to delete ------------

  my @out_patterns = (
     "COOVEL.L??",
     "${V_FIN}${ssss}00?.CLK",
     "${V_FIN}_${yyssss}00?.OUT",
#     "${V_FIN}S${yyssss}.OUT",
     "ORBGEN.L??",
     "POLUPD.L??",
     "${V_FIN}_STDPRE.OUT",
  );

  my @sta_patterns = (
    "FIN${yyddd}.CRD",
    "FIN${yyddd}.FIX",
    "FIN${yyddd}.VEL",
  );

  my @orb_patterns = (
#    "${V_ORBAPR}_${yyssssm1}.STD",
#    "${V_ORBAPR}_${yyssssp1}.STD",
#    "${V_ORBAPR}_${yyssss}.STD",
#    "${V_ORBAPR}_${yyssssm1}.RPR",
#    "${V_ORBAPR}_${yyssssp1}.RPR",
#    "${V_ORBAPR}_${yyssss}.RPR",
    "002${day}.ELE",
    "003${day}.ELE",
    "004${day}.ELE",
    "005${day}.ELE",
    "006${day}.ELE",
    "007${day}.ELE",
    "008${day}.ELE",
    "002${yyssssm1}.ELE",
    "003${yyssssm1}.ELE",
    "004${yyssssm1}.ELE",
    "005${yyssssm1}.ELE",
    "006${yyssssm1}.ELE",
    "007${yyssssm1}.ELE",
    "008${yyssssm1}.ELE",
    "002${yyssssp1}.ELE",
    "003${yyssssp1}.ELE",
    "004${yyssssp1}.ELE",
    "005${yyssssp1}.ELE",
    "006${yyssssp1}.ELE",
    "007${yyssssp1}.ELE",
    "008${yyssssp1}.ELE",
    "FIN${yyddd}.CLK",
    "FIN${yyddd}.ERP",
    "${V_FIN}${ssss}???.CLK",
  );

  my @sol_patterns = (
#    "${V_APR}0?${yyssss}00?.NQ0",
#    "${V_APR}99${yyssssm1}.NQ0",
#    "${V_APR}99${yyssssp1}.NQ0",
  );


  # ---------- Delete Files ------------
  my $deleted = 0;

  foreach my $pattern (@out_patterns) {
    foreach my $file (glob("${dirOut}${pattern}")) {
      unlink $file and print "Deleted: $file\n" and $deleted++;
    }
  }

  foreach my $pattern (@sta_patterns) {
    foreach my $file (glob("${dirSta}/${pattern}")) {
      unlink $file and print "Deleted: $file\n" and $deleted++;
    }
  }

  foreach my $pattern (@orb_patterns) {
    foreach my $file (glob("${dirOrb}/${pattern}")) {
      unlink $file and print "Deleted: $file\n" and $deleted++;
    }
  }

  foreach my $pattern (@sol_patterns) {
    foreach my $file (glob("${dirSol}/${pattern}")) {
      unlink $file and print "Deleted: $file\n" and $deleted++;
    }
  }

  # ---------- Delete Files in BPE directory ------------
  my $dirBpe = "${dirOut}../BPE";
  my $bpe_pattern = "*${day}*";

  foreach my $file (glob("${dirBpe}/${bpe_pattern}")) {

    	  # ---------- Only delete LOG and PRT files ------------
    	  next unless ($file =~ /\.(LOG|PRT)$/);

    	  # ---------- Skip files containing _700_000 ------------
    	  next if ($file =~ /_700_000/);

    	  if (-e $file) {
             unlink $file and print "Deleted: $file\n" and $deleted++;
    	     }
	  }

  # ---------- Summary ------------
  if ($deleted == 0) {
    print "No files found for $day.\n";
  } else {
    print "------------------------------------------------------------\n";
    print "Deleted $deleted files for $day.\n";
    print "------------------------------------------------------------\n";
  }

  return;
}


