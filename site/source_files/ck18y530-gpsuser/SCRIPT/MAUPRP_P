package MAUPRP_P;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  MAUPRP_P
#
# Purpose :  Parallel run for automatic cleaning of double difference
#            phase observations
#
# Programs:  MAUPRP
#
# Author  :  M. Meindl
# Created :  30-Jul-2003               Last modified: 19-May-2009
#
# Changes :  19-May-2009 rd: Session dependent parallelization filenames
#
# ----------------------------------------------------------------------------
use lib $ENV{BPE};
use bpe_util;
use File::Copy;


sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($yyssss, $ssss , $ddd , $param1 , $subPid ,  $numFil, $numClu ) =
  $bpe->getKeys
     ('$YSS+0', '$S+0', '$+0', 'PARAM1', 'SUB_PID', 'V_CLU', 'V_NCLU');

# Set cluster number and input files
# ----------------------------------
  my $cluster = $numFil eq "" && $numClu eq ""? "$ddd$param1" : "$yyssss" .substr($subPid,1);
  my $ffff    = $numFil eq "" && $numClu eq ""? $param1       : "____";

  setUserVar($bpe,"CLUSTER",$cluster,"FFFF",$ffff,"CCC",$subPid);

  if ($numClu eq "" && $numFil eq "") {
    $bpe->putKey("$ENV{U}/PAN/MAUPRP.INP","PZFILES","$param1$ssss");
    $bpe->putKey("$ENV{U}/PAN/MAUPRP.INP","OBSFIL", "$param1$ssss") }
  else {
    replaceSel($bpe,"MAUPRP","PZFILES",$param1);
    replaceSel($bpe,"MAUPRP","OBSFIL", $param1) }

# Run program
# -----------
  my $PGMNAM = "MAUPRP";
  $bpe->RUN_PGMS($PGMNAM);

# Delete BPE file
# ---------------
  open (BPE,$param1);
  print "\n\n","-"x75,"\n";
  print "Contents of BPE file $param1\n";
  print "-"x75,"\n";
  print <BPE>;
  print "-"x75,"\n";
  close BPE;
  unlink($param1);

}
