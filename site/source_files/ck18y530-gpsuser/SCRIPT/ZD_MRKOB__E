package MRKOB__E;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  MRKOB__E
#
# Purpose :  Apply observation editing instructions using SATMRK.
#
# Author  :  R. Dach
# Created :  17-Nov-2005
#
# Changes :  26-Jan-2021 ec: Renamed to avoid naming conflict
#===========================================================

use strict;
use lib $ENV{BPE};
use bpe_util;
use lib "$ENV{HOME}/ZDGNSS_RUN/perl";
use RetryHelper qw(run_with_retry);


sub run {
  my $bpe = shift;

  # ---------- Get variables ------------
  my (
      $file,
      $param2,
      $param3,
      $param4,
      $param5,
      $param6,
      $subPid
  ) = $bpe->getKeys(
      'PARAM1',
      'PARAM1',
      'PARAM3',
      'PARAM4',
      'PARAM5',
      'PARAM6',
      'SUB_PID'
  );

  # ---------- Set processing identifier ------------
  setUserVar($bpe,"D4",$subPid);

  # ---------- Build task list ------------
  my @todo;
  push @todo,$param2 if $param2 ne "";
  push @todo,$param3 if $param3 ne "";
  push @todo,$param4 if $param4 ne "";
  push @todo,$param5 if $param5 ne "";
  push @todo,$param6 if $param6 ne "";

  # ---------- Execute tasks ------------
  foreach my $task (@todo) {

    print "Selected task: $task\n";

    # ---------- Define processing mode ------------
    if ($task eq "SYNCHRO") {
      $bpe->putKey("$ENV{U}/PAN/SATMRK.INP","WHATTODO","SYNCHRONIZE");
    } else {
      $bpe->putKey("$ENV{U}/PAN/SATMRK.INP","WHATTODO","EDIT_FILE");
    }

    # ---------- Observation type handling ------------
    if ($task eq "CODE" || $task eq "PHASE") {
      $bpe->putKey("$ENV{U}/PAN/SATMRK.INP","BOTHZERO","0");
    }

    if ($task eq "PHASE") {
      $bpe->putKey("$ENV{U}/PAN/SATMRK.INP","CZHFIL","");
    } else {
      replaceSel($bpe,"SATMRK","CZHFIL",$file);
    }

    if ($task eq "CODE") {
      $bpe->putKey("$ENV{U}/PAN/SATMRK.INP","PZHFIL","");
    } else {
      replaceSel($bpe,"SATMRK","PZHFIL",$file);
    }

    # ---------- Run SATMRK ------------
    my $PGMNAM = "SATMRK";
    run_with_retry($bpe, $PGMNAM,10);
  }

  # ---------- Cleanup input BPE file ------------
  open my $fh, "<", $file;
  print "\n","-"x75,"\n";
  print "Contents of BPE file $file\n";
  print "-"x75,"\n";
  print <$fh>;
  print "-"x75,"\n";
  close $fh;

  unlink($file);
}