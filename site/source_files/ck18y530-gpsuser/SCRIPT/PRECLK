package PRECLK;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  PRECLK
#
# Purpose :  Pre-eliminate last set of clocks
#
# Programs:  ADDNEQ2
#
# Author  :  E. Calero
# Created :  25-Apr-2021
#
# Changes :
#
# ----------------------------------------------------------------------------

use strict;
use lib $ENV{BPE};
use bpe_util;
use File::Basename;

sub run {
  my $bpe = shift;


# Get variables
# -------------
  my ($sol,
      $dirNeq,$extNeq,
      $yyssss) =
    $bpe->getKeys(
      "$$bpe{PARAM1}",
      'DIR_NEQ','EXT_NEQ',
      '$YSS+0');

# Get NEQ files
# -------------
  my @NEQfl = glob("${dirNeq}${sol}??${yyssss}???.${extNeq}");
  my $input = "";
  ($input = basename($NEQfl[0])) =~ s/\.[^.]+$//;

# Initialize user variables
# -------------------------
  $sol = "${sol}99";
  setUserVar($bpe,"D4",'000',"SOL",$sol);

# Run program
# -----------
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","INPFILE",$input);
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NEQOUT",'$(SOL)$YSS+0');
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","SYSOUT",'$(SOL)$S+0');
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","NOINV","1");
  $bpe->putKey("$ENV{U}/PAN/ADDNEQ2.INP","CLKS_ELIM","BEFORE_STACKING");

  my $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);

}
