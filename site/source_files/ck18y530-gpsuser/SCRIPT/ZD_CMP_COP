package ZD_CMP_COP;
@ISA = ("RUNBPE");

# ============================================================================
#
# Name    :  ZD_CMP_COP
#
# Purpose :  Copy files required by ZDGNSS_CMPSOL.PCF
#
# PARAMs  :
#
# Author  :  C. Kobel
# Created :  28-Oct-2026
#
# Changes :
#
# ============================================================================

use lib "$ENV{AUTO}";
use gpsutil;
use File::Copy qw(copy);
use File::Spec;

sub run {
  my $bpe = shift;

  # Get variables
  # -------------
  my (
    $yyssss,  $yyddd,
    $V_DIRSOL1, $V_ERPSOL1, $V_STDSOL1, $V_CLKSOL1, $V_CRDSOL1,
    $V_DIRSOL2, $V_ERPSOL2, $V_STDSOL2, $V_CLKSOL2, $V_CRDSOL2,
    $dirCrd, $dirErp, $dirClk, $dirStd,
    $extCrd, $extErp, $extClk, $extStd,
    $crdInf
  ) = $bpe->getKeys(
    '$YSS+0', '$YD+0',
    'V_DIRSOL1', 'V_ERPSOL1', 'V_STDSOL1', 'V_CLKSOL1', 'V_CRDSOL1',
    'V_DIRSOL2', 'V_ERPSOL2', 'V_STDSOL2', 'V_CLKSOL2', 'V_CRDSOL2',
    'DIR_CRD', 'DIR_ERP', 'DIR_CLK', 'DIR_STD',
    'EXT_CRD', 'EXT_ERP', 'EXT_CLK', 'EXT_STD',
    'V_CRDINF'
  );

  # Copy reference files
  # --------------------
  my $ret = system("$ENV{AUTO}/copyRef.pl ${dirCrd}.. $crdInf $crdInf.PSD");

  if ($ret == -1) {
    die "Failed to start copyRef.pl: $!";
  }
  elsif ($ret & 127) {
    die "copyRef.pl was terminated by signal " . ($ret & 127) . ".";
  }
  elsif ($ret >> 8) {
    die "copyRef.pl failed with exit status " . ($ret >> 8) . ".";
  }

  # Build source and destination paths
  # ----------------------------------
  my @files = (
    # Solution 1
    {
      type       => 'ERP1',
      source     => File::Spec->catfile($V_DIRSOL1, 'ORB', "$V_ERPSOL1.$extErp"),
      target_dir => $dirErp,
    },
    {
      type       => 'STD1',
      source     => File::Spec->catfile($V_DIRSOL1, 'ORB', "$V_STDSOL1.$extStd"),
      target_dir => $dirStd,
    },
    {
      type       => 'CLK1',
      source     => File::Spec->catfile($V_DIRSOL1, 'ORB', "$V_CLKSOL1.$extClk"),
      target_dir => $dirClk,
    },
    {
      type       => 'CRD1',
      source     => File::Spec->catfile($V_DIRSOL1, 'STA', "$V_CRDSOL1.$extCrd"),
      target_dir => $dirCrd,
    },

    # Solution 2
    {
      type       => 'ERP2',
      source     => File::Spec->catfile($V_DIRSOL2, 'ORB', "$V_ERPSOL2.$extErp"),
      target_dir => $dirErp,
    },
    {
      type       => 'STD2',
      source     => File::Spec->catfile($V_DIRSOL2, 'ORB', "$V_STDSOL2.$extStd"),
      target_dir => $dirStd,
    },
    {
      type       => 'CLK2',
      source     => File::Spec->catfile($V_DIRSOL2, 'ORB', "$V_CLKSOL2.$extClk"),
      target_dir => $dirClk,
    },
    {
      type       => 'CRD2',
      source     => File::Spec->catfile($V_DIRSOL2, 'STA', "$V_CRDSOL2.$extCrd"),
      target_dir => $dirCrd,
    },
  );

  # Copy all files; stop at the first error
  # ---------------------------------------
  for my $file (@files) {
    my $source = $file->{source};
    my $source_is_zipped = 0;

    # Use the compressed source if the uncompressed source does not exist.
    if (!-e $source && -e "$source.Z") {
      $source .= '.Z';
      $source_is_zipped = 1;
    }

    my $filename = (File::Spec->splitpath($file->{source}))[2];
    my $destination = File::Spec->catfile($file->{target_dir}, $filename);

    if ($source_is_zipped) {
      my $zipped_destination = "$destination.Z";

      copy($source, $zipped_destination)
        or die "Failed to copy $file->{type} from '$source' "
             . "to '$zipped_destination': $!";

      my $status = system { 'uncompress' }
        'uncompress', '-f', $zipped_destination;

      if ($status == -1) {
        die "Copied $file->{type}, but failed to start 'uncompress': $!";
      }
      elsif ($status & 127) {
        die "'uncompress' for $file->{type} was terminated by signal "
          . ($status & 127) . ".";
      }
      elsif ($status >> 8) {
        die "'uncompress' for $file->{type} failed with exit status "
          . ($status >> 8) . ": '$zipped_destination'";
      }
    }
    else {
      copy($source, $destination)
        or die "Failed to copy $file->{type} from '$source' "
             . "to '$destination': $!";
    }
  }

  return 1;
}