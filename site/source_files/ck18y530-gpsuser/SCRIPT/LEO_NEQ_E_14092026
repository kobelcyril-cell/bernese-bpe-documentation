package LEO_NEQ_E;
our @ISA = ("RUNBPE");
# ============================================================================
#
# Name    :  LEO_NEQ_P
#
# Purpose :  Execute GPSEST for one LEO.
#
# Author  :  C. Kobel
# Created :  10-Sep-2026
#
# Changes :
#
# ============================================================================
use strict;
use warnings;
use lib $ENV{BPE};
use bpe_util qw(setUserVar);

sub run {
    my ($bpe) = @_;
    print "\n[LEO_NEQ_E] ==================================================\n";
    print "[LEO_NEQ_E] START: execute one parallel LEO job\n";
    print "[LEO_NEQ_E] Read PARAM1 and PARAM2 using getKeys\n";
    my ($rnx, $att) = $bpe->getKeys('PARAM1', 'PARAM2');
    print "[LEO_NEQ_E] PARAM1 = '$rnx' (RNX from preparation script)\n";
    print "[LEO_NEQ_E] PARAM2 = '" . (defined $att ? $att : '<undefined>') . "' (ATT from preparation script)\n";
    print "[LEO_NEQ_E] These are the values returned by getKeys in this worker\n";
    if ($rnx eq 'NO_LEO') {
        print "[LEO_NEQ_E] NO_LEO: no active LEO for this day; GPSEST will not be called\n";
        print "[LEO_NEQ_E] END: no-op job finished\n";
        print "[LEO_NEQ_E] ==================================================\n\n";
        return;
    }

    print "[LEO_NEQ_E][$rnx] Set LEO = '$rnx': POD options use the four-character receiver code\n";
    setUserVar($bpe, 'LEO', $rnx);
    print "[LEO_NEQ_E][$rnx] setUserVar(LEO) returned\n";
    print "[LEO_NEQ_E][$rnx] Set RNX = '$rnx': observation file prefix from PARAM1\n";
    setUserVar($bpe, 'RNX', $rnx);
    print "[LEO_NEQ_E][$rnx] setUserVar(RNX) returned\n";
    print "[LEO_NEQ_E][$rnx] Set ATT = '$att': attitude file basename from PARAM2\n";
    setUserVar($bpe, 'ATT', $att);
    print "[LEO_NEQ_E][$rnx] setUserVar(ATT) returned\n";

    print "[LEO_NEQ_E][$rnx] Variables passed to setUserVar: LEO='$rnx', RNX='$rnx', ATT='$att'\n";
    print "[LEO_NEQ_E][$rnx] GPSEST uses the option directory selected in the PCF\n";
    print "[LEO_NEQ_E][$rnx] Call RUN_PGMS('GPSEST')\n";
    my $PGMNAM = "GPSEST";
    $bpe->RUN_PGMS($PGMNAM);
    print "[LEO_NEQ_E][$rnx] RUN_PGMS('GPSEST') returned; see GPSEST output for processing details\n";
    print "[LEO_NEQ_E][$rnx] END: execution script finished\n";
    print "[LEO_NEQ_E] ==================================================\n\n";
}