package ADDNEQ2_DATFIL;
@ISA = ("RUNBPE");

#===========================================================
# Name    :  ADDNEQ2_DATFIL
#
# Purpose :  Run ADDNEQ2 and create datum file if not existing
#
# Author  :  C. Kobel
# Created :  26-Jun-2026
#
# Changes :  
#===========================================================

use strict;
use warnings;
use lib "$ENV{BPE}";
use bpe_util;

sub run {
  my $bpe = shift;
# ---------- Get variables ------------
  my (
      $yyddd,
      $sol,
      $crdInf,
      $dirFix,
      $extFix
  ) = $bpe->getKeys(
      '$YD+0',
      'V_FIN',
      'V_CRDINF',
      'DIR_FIX',
      'EXT_FIX'
  );
# ---------- Initialize FIX file ------------
  my $fixFl = "${dirFix}${sol}_${yyddd}.${extFix}";
  unless (-e $fixFl) {
    my $refFl = "${dirFix}${crdInf}.${extFix}";
    system("cp $refFl $fixFl");
    prtMess($bpe, "Create initial FIX file");
  }
# ---------- Run program ------------
  my $PGMNAM = "ADDNEQ2";
  $bpe->RUN_PGMS($PGMNAM);
}