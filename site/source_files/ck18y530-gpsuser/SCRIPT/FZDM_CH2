package FZDM_CHK;
@ISA = ("RUNBPE");
# ----------------------------------------------------------------------------
#
# Name    :  FZDM_CHK
#
# Purpose :  Checks residuals from final clock estimation for bad stations
#            (based on FCLK_CHK)
#
# Programs:  RESRMS, RESCHK
#
# Author  :  E. Calero
# Created :  xx-xxx-20xx            
#
# Changes :  
#
# ----------------------------------------------------------------------------

use strict;
use lib $ENV{BPE};
use bpe_util;
use File::Basename;

use lib "$ENV{U}/SCRIPT";
use JumpLogger qw(logJump);

sub run {
  my $bpe = shift;


# Maximum number of iterations
# ----------------------------
  my $maxRun = 50;


# Get variables
# -------------
  my ($yy, $ddd, $ssss, $yyddd, $iRun,       $param3, $u,$v_h,
      $dirDel,  $extDel,  $dirOut) =
      $bpe->getKeys(
      '$Y','$+0','$S+0','$YD+0','STARTCOUNT','PARAM3','U','V_H',
      'DIR_DEL','EXT_DEL','DIR_OUT');


  prtMess($bpe,"Iteration $iRun of $maxRun");


# Generate the residual table
# ---------------------------
  $bpe->putKey("$u/PAN/RESRMS.INP","DOBIGRES", "0");
  $bpe->putKey("$u/PAN/RESRMS.INP","DOBIGRES2","0");
  $bpe->putKey("$u/PAN/RESRMS.INP","DOBIGRES3","0");

  my $PGMNAM = "RESRMS";
  $bpe->RUN_PGMS($PGMNAM);



# Define a delFil for the result of the check
# -------------------------------------------
  my $delFil = "${dirDel}${yyddd}.${extDel}";
  unlink ($delFil);

  $bpe->putKey("$u/PAN/RESCHK.INP","DELSTA",$delFil);

# Configure maximum allowed RMS per station
  my @rmsFil = glob("${dirOut}../MSC/${v_h}${yyddd}_????.FLG");
  my $rmsFlg = $rmsFil[0];
  my $maxRMS = '';
  if (-e $rmsFlg) {
    ($rmsFlg  = basename($rmsFlg)) =~ s/\.[^.]+$//;
    $maxRMS   = substr($rmsFlg, -4);
    $maxRMS   = sprintf("%d","$maxRMS");
  } else {
    $maxRMS = '1000';
  }
  $bpe->putKey("$u/PAN/RESCHK.INP","MAXRMS","$maxRMS");
  $bpe->putKey("$u/PAN/RESCHK.INP","BADSOL","${maxRMS}0");
  prtMess($bpe,"Max. RMS: $maxRMS mm");

# Run program
# -----------
  $PGMNAM = "RESCHK";
  $bpe->RUN_PGMS($PGMNAM);


# Add SYSOUT to the summary list
# ------------------------------
  my $xtrsum = "${dirOut}RESCHK.${yy}_${ssss}";
  appFile("",0,$$bpe{SYSOUT},$xtrsum);


# Delete bad stations
# -------------------
  my $iDel = 0;
  if (-e $delFil) {
    open (DEL,"< $delFil");
    while (<DEL>) {
      chomp;
      while ( /^ / ) { s/^ // }  # Remove leading blanks
      unlink ($_);
      prtMess($bpe,"$_ deleted");

      appFile("",0,$bpe->getKey("$u/INP/RESCHK.INP","RESRMS"),$xtrsum) unless $iDel;
      $iDel++;
    }
    close(DEL);
    unlink($delFil);
  }


# Check for BAD SATELLITE message in the program output
# -----------------------------------------------------
  open(OUT,"< $$bpe{SYSOUT}");
  while(<OUT>){
    $iDel++ if ( /^BAD SATELLITE/ );
  }
  close OUT;

# Check where to go
# -----------------
  logJump($bpe, $param3) if ($iDel > 0 && $iRun <= $maxRun);
  prtGoto($bpe,$param3) if ($iDel > 0 && $iRun <= $maxRun);
}
